}
void bunkerbombloop()
{
for(int i=int(bunkerbombs.length())-1;i>=0;i--)
{
bunkerbomb@ bb=bunkerbombs[i];if(bb.bombtimer.elapsed<14000)continue;
for(uint bunker_index=0;bunker_index<bunkers.length();bunker_index++)if(bunkers[bunker_index].map==bb.map and get_3d_distance(bb.x,bb.y,bb.z,bunkers[bunker_index].x,bunkers[bunker_index].y,bunkers[bunker_index].z)<=3)
{
string former_owner=bunkers[bunker_index].owner;bunkers[bunker_index].integrity=0;bunkers[bunker_index].owner="";bunkers[bunker_index].power=0;bunkers[bunker_index].medical_charges=0;bunkers[bunker_index].capturing_player="";bunkers[bunker_index].capture_progress=0;
send_reliable(0,bunkers[bunker_index].name+" has been disabled by "+bb.owner+". Its control system is neutral and may be captured again.",2);int former_index=get_player_index_from(former_owner);if(former_index>=0)refresh_bunker_owner_count(former_index);
}
// A bunker buster is a very large charge, but it is still a charge: it no
// longer kills everyone within 150 tiles through every wall.
blast_profile@ b=blast_profile_for("bunker_bomb",bb.owner,bb.owner+"'s bunker bomb");
if(item_prop("bunker_bomb","blast_damage")==""){b.damage=2000;b.radius=30;b.fragments=3000;b.fragment_damage=90;b.fragment_range=40;}
b.explode_sound="bunkerbombexplode";b.distant_sound="bunkerbombdist.ogg";b.hit_sound="bunkerbombhit";b.structure_mult=4;
bunkerbombs.remove_at(i);
detonate(bb.x,bb.y,bb.z+.3,bb.map,b);
}
}
