class moderation_record{string type,account,computer,issuer,reason;bool active=true;moderation_record(string t="",string a="",string c="",string i="",string r=""){type=t;account=a;computer=c;issuer=i;reason=r;}}
moderation_record@[] moderation_records;
string moderation_safe(string value){value=string_replace(value,"|","/",true);return string_replace(value,"\n"," ",true);}
void save_moderation(){file f;if(!f.open("administration/moderation.svr","wb"))return;for(uint i=0;i<moderation_records.length();i++)f.write(moderation_records[i].type+"|"+moderation_safe(moderation_records[i].account)+"|"+moderation_safe(moderation_records[i].computer)+"|"+moderation_safe(moderation_records[i].issuer)+"|"+(moderation_records[i].active?"1":"0")+"|"+moderation_safe(moderation_records[i].reason)+"\n");f.close();}
void load_moderation(){moderation_records.resize(0);if(!file_exists("administration/moderation.svr"))return;string[] lines=string_split(file_get_contents("administration/moderation.svr"),"\n",false);for(uint i=0;i<lines.length();i++){string[] p=string_split(lines[i],"|",false);if(p.length()<6)continue;moderation_record r(p[0],p[1],p[2],p[3],p[5]);r.active=p[4]=="1";moderation_records.insert_last(r);}}
int active_ban_for(string account,string computer){for(int i=int(moderation_records.length())-1;i>=0;i--)if(moderation_records[i].type=="ban" and moderation_records[i].active and (string_to_lower_case(moderation_records[i].account)==string_to_lower_case(account) or (computer!="" and moderation_records[i].computer==computer)))return i;return -1;}
string moderation_ban_reason(string account,string computer){int i=active_ban_for(account,computer);return i>=0?moderation_records[i].reason:"";}
string moderation_account_list(){string[] files=find_files("accounts/*.dat");string result="";for(uint i=0;i<files.length();i++){savedata account("accounts/"+files[i],ACCOUNT_SECRET);account.load();string username=account.read("username");if(username=="")username=files[i];if(result!="")result+=", ";result+=username+(active_ban_for(username,"")>=0?" (banned)":"");}return result==""?"No accounts exist.":files.length()+" accounts: "+result;}
string moderation_account_names()
{
string[] files=find_files("accounts/*.dat");string result="";for(uint i=0;i<files.length();i++){savedata account("accounts/"+files[i],ACCOUNT_SECRET);account.load();string username=account.read("username");if(username=="")username=string_replace(files[i],".dat","",true);if(result!="")result+="|";result+=username;}return result;
}
string moderation_account_detail(string requested)
{
string path="accounts/"+string_to_lower_case(requested)+".dat";if(!file_exists(path))return "Account not found.";savedata account(path,ACCOUNT_SECRET);account.load();string username=account.read("username");if(username=="")username=requested;string email=account.read("email");bool authenticated=!account.d.exists("authenticated") or account.readn("authenticated")>=1;int credits=int(account.readn("credits"));string status="Offline",role="Player";
for(uint i=0;i<lobby_clients.length();i++)if(string_to_lower_case(lobby_clients[i].name)==string_to_lower_case(username)){status="Online in lobby";role=lobby_clients[i].dev?"Developer":(lobby_clients[i].admin?"Administrator":"Player");break;}
for(uint i=0;i<players.length();i++)if(string_to_lower_case(players[i].name)==string_to_lower_case(username)){status="Playing "+string_replace(players[i].map,"_"," ",true);role=players[i].dev?"Developer":(players[i].admin?"Administrator":"Player");break;}
int warnings=0;for(uint i=0;i<moderation_records.length();i++)if(moderation_records[i].type=="warning" and string_to_lower_case(moderation_records[i].account)==string_to_lower_case(username))warnings++;
int ban=active_ban_for(username,"");string detail="Username: "+username+"<<NL>>Email: "+(email==""?"Not recorded":email)+"<<NL>>Authorization: "+(authenticated?"Authorized":"Pending authorization")+"<<NL>>Role: "+role+"<<NL>>Status: "+status+"<<NL>>Credits: "+credits+"<<NL>>Warnings: "+warnings+"<<NL>>Ban status: "+(ban>=0?"Banned":"Not banned");if(ban>=0)detail+="<<NL>>Ban issuer: "+moderation_records[ban].issuer+"<<NL>>Ban reason: "+moderation_records[ban].reason;return detail;
}
void send_moderation_account_list(uint peer){if(!service_requester_staff(peer)){send_reliable(peer,"accounts_error Developer or administrator access is required.",0);return;}send_reliable(peer,"accounts_list_response "+moderation_account_names(),0);}
void send_moderation_account_detail(uint peer,string username){if(!service_requester_staff(peer)){send_reliable(peer,"accounts_error Developer or administrator access is required.",0);return;}send_reliable(peer,"account_detail_response "+moderation_account_detail(username),0);}
bool handle_moderation_command(int actor_index,string raw){if(actor_index<0)return false;string[] p=string_split(raw," ",true);if(p.length()==0)return false;string command=string_to_lower_case(p[0]);if(command!="/accounts" and command!="/warn" and command!="/warnings" and command!="/ban" and command!="/unban" and command!="/bans")return false;bool dev=players[actor_index].dev;bool staff=dev or players[actor_index].admin;if(!staff){send_reliable(players[actor_index].peer_id,"Developer or administrator access is required.",2);return true;}if(command=="/accounts"){send_moderation_account_list(players[actor_index].peer_id);return true;}if(command=="/bans"){string result="Active bans: ";int count=0;for(uint i=0;i<moderation_records.length();i++)if(moderation_records[i].type=="ban" and moderation_records[i].active){if(count++>0)result+=", ";result+=moderation_records[i].account+" by "+moderation_records[i].issuer+"; "+moderation_records[i].reason;}send_reliable(players[actor_index].peer_id,count==0?"There are no active bans.":result,2);return true;}if(p.length()<2){send_reliable(players[actor_index].peer_id,"A target account is required.",2);return true;}string target=p[1];if(command=="/warnings"){string result="Warnings for "+target+": ";int count=0;for(uint i=0;i<moderation_records.length();i++)if(moderation_records[i].type=="warning" and string_to_lower_case(moderation_records[i].account)==string_to_lower_case(target)){if(count++>0)result+="; ";result+=moderation_records[i].issuer+": "+moderation_records[i].reason;}send_reliable(players[actor_index].peer_id,count==0?target+" has no warnings.":result,2);return true;}if(command=="/unban"){int changed=0;for(uint i=0;i<moderation_records.length();i++)if(moderation_records[i].type=="ban" and moderation_records[i].active and string_to_lower_case(moderation_records[i].account)==string_to_lower_case(target)){moderation_records[i].active=false;changed++;}save_moderation();send_reliable(players[actor_index].peer_id,changed>0?target+" was unbanned.":"No active ban was found for "+target+".",2);return true;}string prefix=command+" "+target+" ";string reason=string_replace(raw,prefix,"",false).trim_whitespace();if(reason=="")reason=command=="/warn"?"No reason supplied":"Banned by staff";int ti=get_player_index_from(target);string computer=ti>=0?players[ti].comp:"";if(command=="/warn"){moderation_records.insert_last(moderation_record("warning",target,computer,players[actor_index].name,reason));save_moderation();if(ti>=0)send_reliable(players[ti].peer_id,"Official warning from "+players[actor_index].name+": "+reason,2);send_reliable(players[actor_index].peer_id,"Warning recorded for "+target+".",2);return true;}if(ti>=0 and players[ti].dev and ti!=actor_index){send_reliable(players[actor_index].peer_id,"Developers cannot be banned by another player.",2);return true;}moderation_records.insert_last(moderation_record("ban",target,computer,players[actor_index].name,reason));save_moderation();if(ti>=0){send_reliable(players[ti].peer_id,"banned "+reason,0);send_reliable(0,"offline "+players[ti].x+" "+players[ti].y+" "+players[ti].z+" "+players[ti].name+" "+players[ti].map,0);players.remove_at(ti);}send_reliable(0,"play_s ban.ogg",0);send_reliable(players[actor_index].peer_id,target+" was banned. Reason: "+reason,2);return true;}
