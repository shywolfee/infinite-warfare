{
players[i2].hitby=mortarbombs[i].owner+"'s 120mm_mortar";
apply_player_damage(players[i2],mortarbombs[i].blast_damage);
if(string_contains(mortarbombs[i].payload,"incendiary",1)>=0){players[i2].burning=true;players[i2].burning_owner=mortarbombs[i].owner;players[i2].burning_duration_timer.restart();players[i2].burning_tick_timer.restart();}
play("120mm_mortarhit",players[i2].x,players[i2].y,players[i2].z,players[i2].map);
}
}
for (uint i2=0; i2<planes.length(); i2++)
{
if (get_3d_distance(mortarbombs[i].x,mortarbombs[i].y,mortarbombs[i].z,planes[i2].x,planes[i2].y,planes[i2].z)<=20 and planes[i2].map==mortarbombs[i].map)
{
planes[i2].health-=500;
play("duoplanebombhit",planes[i2].x,planes[i2].y,planes[i2].z,planes[i2].map);
}
}
for(uint vi=0;vi<authoritative_vehicles.length();vi++){authoritative_vehicle@ vehicle=authoritative_vehicles[vi];if(vehicle.map!=mortarbombs[i].map or vehicle.health<=0)continue;double vd=get_3d_distance(mortarbombs[i].x,mortarbombs[i].y,mortarbombs[i].z,vehicle.model_x,vehicle.model_y,vehicle.model_z);if(vd>mortarbombs[i].blast_radius)continue;int vehicle_damage=int(double(mortarbombs[i].blast_damage)*(1.0-vd/double(mortarbombs[i].blast_radius)*.55));if(string_contains(mortarbombs[i].payload,"_ap",1)>=0)vehicle_damage=int(vehicle_damage*1.65);vehicle.armor-=vehicle_damage;if(vehicle.armor<0){vehicle.health+=vehicle.armor/2;vehicle.armor=0;}vehicle.health-=vehicle_damage/3;if(vehicle.health<0)vehicle.health=0;send_reliable(0,"veh_damage "+vehicle.id+" "+vehicle_damage+" "+vehicle.map+" "+vehicle.health+" "+vehicle.armor,0);}

