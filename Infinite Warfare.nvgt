// ---------------------------------------------------------------------------
// Translocator system — battery level in cells, teleport to POIs.
// ---------------------------------------------------------------------------
int translocator_cells=0;
int translocator_max_cells=10;

int get_translocator_percentage()
{
if (translocator_max_cells==0) return 0;
return (translocator_cells*100)/translocator_max_cells;
}

// Returns the number of cells required to translocate to a POI at given distance.
int cells_for_distance(double dist)
{
int tiles=int(dist);
if (tiles<1) tiles=1;
int needed=tiles/50;
if (tiles%50>0) needed++;
return needed;
}

// Sort POIs by distance from player and return sorted indices.
int[] get_sorted_poi_indices()
{
int[] indices;
double[] distances;
for (uint i=0; i<pois.length(); i++)
{
indices.insert_last(int(i));
distances.insert_last(get_poi_distance(pois[i].x, pois[i].y, pois[i].z));
}
// Simple insertion sort by distance.
for (uint i=1; i<indices.length(); i++)
{
int ki=indices[i];
double kd=distances[i];
int j=int(i)-1;
while (j>=0 and distances[j]>kd)
{
indices[j+1]=indices[j];
distances[j+1]=distances[j];
j--;
}
indices[j+1]=ki;
distances[j+1]=kd;
}
return indices;
}

// Nearest first, each with where it is from you. Enter guides you there.
void show_poi_list()
{
if (pois.length()==0)
{
speak("No points of interest on this map.");
return;
}
int[] sorted=get_sorted_poi_indices();
string[] labels;
for (uint i=0; i<sorted.length(); i++)
{
poi@ o=pois[sorted[i]];
labels.insert_last(string_replace(o.name, "_", " ", true)+", "+describe_offset(o.x,o.y,o.z));
}
bool guiding=(waypoint_name!="");
if (is_android())
{
string[] opts;
if(guiding)opts.insert_last("Stop guiding me to "+waypoint_name);
for(uint i=0;i<labels.length();i++)opts.insert_last(labels[i]);
int sel=android_select("Points of Interest", opts);
if(sel<0)return;
if(guiding){if(sel==0){waypoint_clear();return;}sel--;}
if(sel<int(sorted.length())){poi@ o=pois[sorted[sel]];waypoint_set(string_replace(o.name,"_"," ",true),o.x,o.y,o.z);}
return;
}
nv_form f;
f.create_window("Points of Interest", false, true);
nv_form_list_box@ list=f.add_list("Points of interest, nearest first. Enter guides you there.","pois");
if(guiding)list.add("Stop guiding me to "+waypoint_name,"stop");
for(uint i=0;i<labels.length();i++)list.add(labels[i],""+sorted[i]);
nv_form_button@ go=f.add_button("Guide me there","go",true);
nv_form_button@ close=f.add_button("Close","close",false,true);
f.focus_control(list);
while(true)
{
wait(5);
f.monitor();
if (connected==true)
netloop();
if (f.is_pressed(close))
return;
if (f.is_pressed(go) and @list.focused_item!=null)
{
string id=list.focused_item.id;
if(id=="stop")waypoint_clear();
else
{
poi@ o=pois[int(string_to_number(id))];
waypoint_set(string_replace(o.name,"_"," ",true),o.x,o.y,o.z);
}
return;
}
}
}

// ---------------------------------------------------------------------------
// Turbolifts. Stand in a turbolift's control panel zone and press Shift+P to
// choose a level. The lift announces every served level it passes on the way
// to the one you chose, then announces its arrival.
// ---------------------------------------------------------------------------
bool turbolift_at_player()
{
for (uint i=0; i<turbolifts.length(); i++)if (turbolifts[i].contains(int(mr.x), int(mr.y), int(me.z)))return true;
return false;
}
void try_use_turbolift()
{
if (in_vehicle or in_plane)
{
speak("You can't use a turbolift right now.");
return;
}
turbolift@ t=null;
for (uint i=0; i<turbolifts.length(); i++)
{
if (turbolifts[i].contains(int(mr.x), int(mr.y), int(me.z)))
{
@t=@turbolifts[i];
break;
}
}
if (@t==null)
{
speak("There is no turbolift control panel here.");
return;
}
open_turbolift_menu(t);
}
void open_turbolift_menu(turbolift@ t)
{
iw_form f;
f.create_window(t.name, false, true);
int f_list=f.create_list("Select a level. Press Enter to travel.", 0, false);
for (uint i=0; i<t.level_names.length(); i++)
{
string lbl=t.level_names[i];
if (int(me.z)==t.level_z[i]) lbl+=" (current level)";
f.add_list_item(f_list, lbl);
}
int f_go=f.create_button("&Go", true);
int f_close=f.create_button("&Close", false, true);
f.focus(f_list);
while(true)
{
wait(5);
f.monitor();
if (connected==true) netloop();
if (f.is_pressed(f_go))
{
int sel=f.get_list_position(f_list);
if (sel>=0 and sel<int(t.level_names.length()))
{
turbolift_go(t, sel);
break;
}
}
if (f.is_pressed(f_close)) break;
}
}
void turbolift_go(turbolift@ t, int target)
{
int dest=t.level_z[target];
int cur=int(me.z);
if (dest==cur)
{
speak("You are already at "+t.level_names[target]+".");
return;
}
int n=int(t.level_names.length());
bool up=dest>cur;
// A lift that travels in total silence is a lift you cannot tell you are in.
// Doors, a run, and doors again: the run is what tells you it is still moving
// while the levels are being called, and the second door is what tells you to
// walk out.
p.play_stationary("executioners_rage/doors/vault/close.wav",false);
int lift_run=p.play_stationary("executioners_rage/doors/vault/loop.wav",true);
speak("Turbolift departing for "+t.level_names[target]+".");
// Announce each served level strictly between the current and destination
// levels, in the order the lift passes them.
int last=cur;
while(true)
{
int besti=-1;
int bestz=dest;
if (up)
{
for (int i=0; i<n; i++)
if (t.level_z[i]>last and t.level_z[i]<dest and t.level_z[i]<bestz)
{ bestz=t.level_z[i]; besti=i; }
}
else
{
for (int i=0; i<n; i++)
if (t.level_z[i]<last and t.level_z[i]>dest and t.level_z[i]>bestz)
{ bestz=t.level_z[i]; besti=i; }
}
if (besti<0) break;
last=bestz;
wait(650);
speak(t.level_names[besti]+".");
if (connected==true) netloop();
}
wait(650);
me.z=dest;
mr.x=round(me.x, 0);
mr.y=round(me.y, 0);
p.destroy_sound(lift_run);
p.play_stationary("executioners_rage/doors/vault/open.wav",false);
send_reliable(1, "move_to "+mr.x+" "+mr.y+" "+me.z, 0);
checkzone();
speak("Arrived at "+t.level_names[target]+".");
}
// ---------------------------------------------------------------------------
// Transitions. Interaction points (like a ship's airlock) that move you to a
// fixed destination elsewhere on the map when you press Shift+L inside them.
// ---------------------------------------------------------------------------
void try_use_transition()
{
if (in_vehicle or in_plane)
{
speak("You can't do that right now.");
return;
}
transition@ t=null;
for (uint i=0; i<transitions.length(); i++)
{
if (transitions[i].contains(int(mr.x), int(mr.y), int(me.z)))
{
@t=@transitions[i];
break;
}
}
if (@t==null)
{
speak("There's nothing to step through here.");
return;
}
me.x=t.dx;
me.y=t.dy;
me.z=t.dz;
mr.x=round(me.x, 0);
mr.y=round(me.y, 0);
send_reliable(1, "move_to "+mr.x+" "+mr.y+" "+me.z, 0);
checkzone();
speak(t.label);
}
void show_translocator_interface()
{
team_translocator_received=false;send_team_command("translocator state");timer team_wait;while(!team_translocator_received and team_wait.elapsed<1500){wait(5);netloop();}
if (pois.length()==0 and team_translocator_names.length()==0){speak("No points of interest or available team mates to translocate to.");return;}
int[] sorted=get_sorted_poi_indices();
iw_form f;
f.create_window("Translocator", false, true);
// Battery level display.
string battery_text="Battery: "+translocator_cells+" cells ("+get_translocator_percentage()+"%). Team pool: "+team_translocator_points+" points.";
f.create_input_box("Status", battery_text, "", 0, false, true, false);
int f_list=f.create_list("Destinations", 0, false);
for (uint i=0; i<sorted.length(); i++)
{
int idx=sorted[i];
double dist=get_poi_distance(pois[idx].x, pois[idx].y, pois[idx].z);
int needed=cells_for_distance(dist);
string label=string_replace(pois[idx].name, "_", " ", true)+" - "+int(dist)+" tiles ("+needed+" cells)";
f.add_list_item(f_list, label);
}
for(uint i=0;i<team_translocator_names.length();i++)f.add_list_item(f_list,"Team mate: "+team_translocator_names[i]+" ("+team_translocator_cell_cost[i]+" cells or "+team_translocator_point_cost[i]+" team points)");
int f_go=f.create_button("&Translocate", true);
int f_close=f.create_button("&Close", false, true);
f.focus(f_list);
while(true)
{
wait(5);
f.monitor();
if (connected==true)
netloop();
if (f.is_pressed(f_go))
{
int sel=f.get_list_position(f_list);
if(sel>=int(sorted.length()) and sel<int(sorted.length()+team_translocator_names.length()))
{
int teammate=sel-int(sorted.length());string[] methods={"Use "+team_translocator_cell_cost[teammate]+" translocator cells","Use "+team_translocator_point_cost[teammate]+" shared team points"};int payment=android_select("Payment method",methods);if(payment<0)continue;
if(payment==0 and team_translocator_cell_cost[teammate]>translocator_cells){speak("Not enough cells.");continue;}
team_translocator_go_received=false;team_translocator_go_success=false;send_team_command("translocator go "+team_translocator_names[teammate]+" "+(payment==0?"cells":"points"));timer go_wait;while(!team_translocator_go_received and go_wait.elapsed<2500){wait(5);netloop();}if(!team_translocator_go_success){speak("The team translocation could not be completed.");continue;}if(payment==0)translocator_cells-=team_translocator_go_cells;
p.play_stationary("translocatoruse.ogg",false);speak("Powering up translocator.");for(int t=5;t>=1;t--){speak(t+".");wait(1000);netloop();}me.x=team_translocator_go_x;me.y=team_translocator_go_y;me.z=team_translocator_go_z;mr.x=round(me.x,0);mr.y=round(me.y,0);send_reliable(1,"move_to "+mr.x+" "+mr.y+" "+me.z,0);checkzone();speak("Translocated to team mate "+team_translocator_go_name+".");break;
}
else if (sel>=0 and sel<int(sorted.length()))
{
int idx=sorted[sel];
double dist=get_poi_distance(pois[idx].x, pois[idx].y, pois[idx].z);
int needed=cells_for_distance(dist);
if (needed>translocator_cells)
{
speak("Not enough cells. Need "+needed+", have "+translocator_cells+".");
continue;
}
translocator_cells-=needed;
p.play_stationary("translocatoruse.ogg",false);
speak("Powering up translocator.");
// Five second power up sequence.
for (int t=5; t>=1; t--)
{
speak(t+".");
wait(1000);
}
me.x=pois[idx].x;
me.y=pois[idx].y;
me.z=pois[idx].z;
mr.x=round(me.x, 0);
mr.y=round(me.y, 0);
send_reliable(1, "move_to "+mr.x+" "+mr.y+" "+me.z, 0);
checkzone();
speak("Translocated to "+string_replace(pois[idx].name, "_", " ", true)+".");
break;
}
}
else if (f.is_pressed(f_close))
{
break;
}
}
}

void use_translocator_cell()
{
if (get_item_count("translocator")<=0)
{
speak("You don't have a translocator to insert cells into.");
return;
}
int available=get_item_count("translocator_cell");
if (available<=0)
{
speak("You don't have any translocator cells.");
return;
}
int space=translocator_max_cells-translocator_cells;
if (space<=0)
{
speak("Translocator is fully charged.");
return;
}
string input_str=af_input("How many cells to insert? (have "+available+", space for "+space+")", "", true);
if (input_str=="") return;
int amount=string_to_number(input_str);
if (amount<=0) return;
if (amount>available) amount=available;
if (amount>space) amount=space;
give("translocator_cell", -amount);
translocator_cells+=amount;
p.play_stationary("translocator_celluse.ogg",false);
speak("Inserted "+amount+" cells. Battery: "+translocator_cells+" cells ("+get_translocator_percentage()+"%).");
}

// ---------------------------------------------------------------------------
// Weapon durability system — energy weapons can be damaged and repaired.
// ---------------------------------------------------------------------------
string get_weapon_class(string wname)
{
for (uint i=0; i<wpn_cache.length(); i++)
{
if (wpn_cache[i].id==wname) return wpn_cache[i].wclass;
}
return "";
}
void apply_weapon_recoil(string wname)
{
string c=get_weapon_class(wname);double pitch=0,yaw=0;
if(c=="pistol"){pitch=1.4;yaw=.7;}else if(c=="revolver"){pitch=3.8;yaw=1.4;}else if(c=="submachine_gun"){pitch=1.15;yaw=1.1;}else if(c=="assault_rifle"){pitch=1.8;yaw=.9;}else if(c=="battle_rifle"){pitch=3.1;yaw=1.25;}else if(c=="sniper_rifle"){pitch=4.8;yaw=1.0;}else if(c=="light_machine_gun"){pitch=2.4;yaw=1.35;}else if(c=="shotgun"){pitch=4.3;yaw=1.2;}else if(c=="explosive"){pitch=6.5;yaw=1.6;}else return;
if(sitting){pitch*=.68;yaw*=.7;}if(weapon_has_attachment(wname,"muzzle_brake")){pitch*=.72;yaw*=.8;}if(weapon_has_attachment(wname,"compensator")){pitch*=.62;yaw*=.65;}if(weapon_has_attachment(wname,"flash_hider")){pitch*=.96;yaw*=.96;}if(weapon_is_suppressed(wname)){pitch*=.9;yaw*=.92;}if(weapon_has_attachment(wname,"vertical_grip"))pitch*=.78;if(weapon_has_attachment(wname,"angled_grip"))yaw*=.72;if(weapon_has_attachment(wname,"bipod") and sitting){pitch*=.45;yaw*=.4;}if(weapon_has_attachment(wname,"lightweight_stock")){pitch*=1.12;yaw*=1.18;}if(weapon_has_attachment(wname,"precision_stock")){pitch*=.84;yaw*=.82;}if(weapon_has_attachment(wname,"recoil_buffer_stock")){pitch*=.72;yaw*=.76;}if(stamina<25){pitch*=1.2;yaw*=1.3;}
double handling_mult=handling_recoil_multiplier(wname);pitch*=handling_mult;yaw*=handling_mult;
if(weapon_sway_timer.elapsed<weapon_sway_duration){pitch*=1.25;yaw*=1.7;}
int rise=int(round(pitch,0));if(rise<1)rise=1;turn+=rise;int recoil_vertical_max=weapon_vertical_aim_max(wname);if(turn>recoil_vertical_max)turn=recoil_vertical_max;int drift=int(round((double(random(-1000,1000))/1000.0)*yaw,0));facing+=drift;while(facing<0)facing+=360;while(facing>=360)facing-=360;
p.play_stationary("recoil_"+c+random(1,3)+".ogg",false);send_reliable(0,"turn "+facing,0);send_reliable(0,"turn2 "+turn,0);
}

bool is_energy_weapon(string wname)
{
return (get_weapon_class(wname)=="energy");
}

int get_durability(string wname)
{
int dur=100;
if (weapon_durability.exists(wname))
weapon_durability.get(wname, dur);
else
{
weapon_durability.set(wname, 100);
}
return dur;
}

void set_durability(string wname, int val)
{
if (val<0) val=0;
if (val>100) val=100;
weapon_durability.set(wname, val);
}

void on_weapon_break(string wname)
{
p.play_stationary("itembreak.ogg",false);
int components=random(1, 5);
int broken_gun=find_gun(wname);
if(broken_gun>=0)
{
gun_ammos[broken_gun].reloading=false;
gun_ammos[broken_gun].reload_audio_manual=false;
gun_ammos[broken_gun].reload_cycle_pending=false;
}
give(wname, -1);
weapon_durability.delete(wname);
give("nanomatic_components", components);
for (uint i=0; i<weapons.length(); i++)
{
if (weapons[i]==wname)
{
weapons[i]="empty";
break;
}
}
speak(get_weapon_display_name(wname)+" has broken! Salvaged "+components+" nanomatic component"+(components>1 ? "s" : "")+".");
}

void apply_focused_durability_damage(string wname)
{
if (!is_energy_weapon(wname)) return;
if (random(1, 100)<=20)
{
int dmg_pct=random(1, 10);
int cur=get_durability(wname);
cur-=dmg_pct;
if (cur<=0)
{
set_durability(wname, 0);
on_weapon_break(wname);
return;
}
set_durability(wname, cur);
p.play_stationary("alarm2.ogg",false);
speak("Warning: weapon durability at "+cur+"%.");
}
}

// ---------------------------------------------------------------------------
// Nanomatic Multitool — repairs energy weapon durability.
// ---------------------------------------------------------------------------
void use_nanomatic_multitool()
{
string[] damaged;
for (uint i=0; i<weapons.length(); i++)
{
if (weapons[i]!="empty" and is_energy_weapon(weapons[i]) and get_durability(weapons[i])<100)
damaged.insert_last(weapons[i]);
}
if (damaged.length()==0)
{
speak("No energy weapons need repair.");
return;
}
if (multitool_uses<=0) multitool_uses=5;
iw_form f;
f.create_window("Nanomatic Multitool", false, true);
int f_list=f.create_list("Select a weapon to repair ("+multitool_uses+" uses remaining)", 0, false);
for (uint i=0; i<damaged.length(); i++)
{
int dur=get_durability(damaged[i]);
f.add_list_item(f_list, get_weapon_display_name(damaged[i])+" ("+dur+"% durability)");
}
int f_repair=f.create_button("&Repair", true);
int f_close=f.create_button("&Close", false, true);
f.focus(f_list);
while(true)
{
wait(5);
f.monitor();
if (connected==true)
netloop();
if (f.is_pressed(f_repair))
{
int sel=f.get_list_position(f_list);
if (sel>=0 and sel<int(damaged.length()))
{
int repair_amount=random(5, 15);
int cur=get_durability(damaged[sel]);
int new_dur=cur+repair_amount;
if (new_dur>100) new_dur=100;
set_durability(damaged[sel], new_dur);
multitool_uses--;
p.play_stationary("nanomatic_multitooluse.ogg",false);
speak("Repaired "+get_weapon_display_name(damaged[sel])+" to "+new_dur+"% durability. "+multitool_uses+" uses remaining.");
if (multitool_uses<=0)
{
give("nanomatic_multitool", -1);
p.play_stationary("itembreak.ogg",false);
speak("Multitool spent.");
multitool_uses=0;
}
}
break;
}
else if (f.is_pressed(f_close))
break;
}
}

// ---------------------------------------------------------------------------
// Nanomatic Components — add a use to a multitool.
// ---------------------------------------------------------------------------
void use_nanomatic_components()
{
int comp_count=get_item_count("nanomatic_components");
if (comp_count<5)
{
speak("You need 5 nanomatic components. You have "+comp_count+".");
return;
}
int tool_count=get_item_count("nanomatic_multitool");
if (tool_count<=0)
{
speak("You need a nanomatic multitool to add uses to.");
return;
}
if (multitool_uses<=0) multitool_uses=5;
give("nanomatic_components", -5);
multitool_uses++;
p.play_stationary("nanomatic_multitooluse.ogg",false);
speak("Added 1 use to multitool. Now has "+multitool_uses+" uses.");
}

// ---------------------------------------------------------------------------
// Waypoint Marker — save a position, then track back to it.
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// Binoculars — reusable scouting tool, shows POIs and zone info.
// ---------------------------------------------------------------------------
// Set fire rate, walk speed, and melee flag for the given weapon.
// Called once on weapon draw / server weapon_set, not every frame.
void apply_weapon_stats(string wname)
{
melee=false;
firetime=500;
walktime=200;
for (uint i=0; i<wpn_cache.length(); i++)
{
if (wpn_cache[i].id==wname)
{
firetime=wpn_cache[i].firetime;
walktime=wpn_cache[i].walktime;
melee=wpn_cache[i].melee;
break;
}
}
firetime=int(firetime*get_attachment_firetime_mult(wname));
walktime=int(walktime*get_attachment_walktime_mult(wname));
synchronize_weapon_feed(wname);
}

bool weapon_allows_sprint(string wname)
{
for(uint i=0;i<wpn_cache.length();i++) if(wpn_cache[i].id==wname)
return wpn_cache[i].walktime<300 and wpn_cache[i].wclass!="explosive" and wpn_cache[i].wclass!="light_machine_gun" and wpn_cache[i].wclass!="sniper_rifle" and wpn_cache[i].wclass!="tool";
return true;
}

void draw_weapon(string wname)
{
if (drawtimer.elapsed<=1500) return;
int requested_walktime=200;
for (uint i=0; i<wpn_cache.length(); i++) if (wpn_cache[i].id==wname) { requested_walktime=wpn_cache[i].walktime; break; }
if (sitting and requested_walktime>=300)
{
speak("You cannot wield that heavy weapon while sitting.");
return;
}
drawtimer.restart();
weapons[w]=wname;
apply_weapon_stats(wname);
int draw_vertical_max=weapon_vertical_aim_max(wname);if(turn>draw_vertical_max){turn=draw_vertical_max;send_reliable(0,"turn2 "+turn,0);speak("The weight of this weapon lowers your aim to its "+turn+" degree unsupported elevation limit.");}
speak(get_weapon_display_name(wname));
send_reliable(1, "draw "+wname, 0);
}
void use_quickbar_slot(int slot)
{
if (quickbar[slot]=="") { speak("Empty slot."); return; }
string item=quickbar[slot];
if(is_equipment_ability(item)){activate_equipment_ability(item);return;}
if (get_item_count(item)<=0)
{
speak("You don't have "+string_replace(item, "_", " ", true)+".");
return;
}
if (is_weapon(item))
{
draw_weapon(item);
}
else
{
if (usetimer.elapsed<=n.get_peer_average_round_trip_time(1)+100) return;
usetimer.restart();
on_item_used(item);
// Client-owned utility items and attachments are handled locally; others go to server.
if (!executioners_handles_item(item) and item != "bomb_vest" and item != "translocator" and item != "translocator_cell" and item != "adrenaline_syringe" and item != "biomonitor_bracelet" and item != "wirenet" and item != "nanomatic_multitool" and item != "nanomatic_components" and !is_attachment_item(item) and !is_holster_item(item) and !is_ammo_reserve_item(item))
send_reliable(0,item_use_command(item),0);
}
}
void anticheat_scan()
{
// The old implementation synchronously launched cmd.exe and tasklist on the
// gameplay thread every 30 seconds. Slow process enumeration froze the entire
// client, and executable-name matching was trivial to evade. Movement, firing,
// ammunition, and state validation are authoritative on the server, so no
// blocking client process scan is performed here.
}
void toggle_afk()
{
if (afk_transitioning) return;
if (!afk_mode and afk_cooldown_active and afk_cooldown_timer.elapsed<300000)
{
int remaining=(300000-afk_cooldown_timer.elapsed)/1000;
speak("You must wait "+remaining+" seconds before going AFK again.");
return;
}
afk_transitioning=true;
string action=afk_mode ? "Returning" : "Going AFK";
for (int i=10; i>0; i--)
{
speak(action+" in "+i);
timer t;
while (t.elapsed<1000)
{
wait(5);
netloop();
mainloop();
}
}
afk_mode=!afk_mode;
afk_transitioning=false;
if (afk_mode)
{
p.play_stationary("modeenter.ogg",false);
speak("You are now AFK. Type /afk to return.");
send_reliable(0, "afk_set 1", 0);
}
else
{
p.play_stationary("modeleave.ogg",false);
speak("You are no longer AFK.");
send_reliable(0, "afk_set 0", 0);
afk_cooldown_active=true;
afk_cooldown_timer.restart();
}
}
void game(int first)
{
voice_room="";voice_room_pending="";voice_toggle_active=false;voice_was_transmitting=false;voice_streams.resize(0);
p.play_stationary("modeenter.ogg",false);
plane.stop();
translocator_cells=0;
jumping=false;
falling=false;
can_move=true;
in_vehicle=false;
afk_mode=false;
afk_transitioning=false;
if (map_vehicles.length() == 0)
{
init_vehicle_types();
spawn_vehicles_on_map();
}
register_vehicles_with_server();
give_starting_loadout();
weapons[w]=starting_loadout_weapon;
apply_weapon_stats(weapons[w]);
pending_spawn_position=true;send_reliable(1, "spawn_player "+me.x+" "+me.y+" "+me.z+" "+mapname+" "+name, 0);timer spawn_ack_timer;while(pending_spawn_position and connected and spawn_ack_timer.elapsed<2500){wait(5);netloop();}
// Vehicle registration requires a live server player. The former pre-spawn
// registration was discarded by server validation, leaving the client and
// projectile authority with different ideas of which vehicles existed.
register_vehicles_with_server();
send_reliable(1, "draw "+weapons[w], 0);
send_reliable(0, "send_comp "+comp, 0);
send_reliable(0, "admin", 0);
if(SCRIPT_COMPILED==false)
{
send_reliable(1, "is_dev" , 0);
}
if(first==1)
{
send_reliable(0, "welcome", 0);
}
while(true)
{
wait(5);
netloop();
if (connected and last_server_msg.elapsed>8000)
{
speak("Connection to the server timed out.");
connected=false;
prevconnected=false;
staff_panel_available=false;
voice_room="";voice_room_pending="";voice_toggle_active=false;voice_was_transmitting=false;voice_streams.resize(0);
pinging=false;
inv.delete_all();invalidate_inventory_keys();
destroy_all_sources();
distpool.destroy_all();ambpool.destroy_all();
p.destroy_all();
sources.resize(0);
can_move=true;
jumping=false;
falling=false;
in_vehicle=false;
dlg("Connection to the server was lost. Press Enter to return to the main menu.");
mainmenu();
return;
}
mainloop();
wirenet_check();
anticheat_scan();
if (afk_mode and !afk_transitioning)
{
if(kb_action_pressed("chat"))
{
string chat=af_input("Enter your message","",true);
if (chat=="/afk")
toggle_afk();
else if (chat!="")
speak("You are AFK. Type /afk to return.");
}
continue;
}
mouse_update();
helper_mouse_turn_accumulator+=double(MOUSE_X)*double(helper_mouse_turn_sensitivity)/100.0;
helper_mouse_aim_accumulator+=double(MOUSE_Y)*double(helper_mouse_aim_sensitivity)/100.0;
mousex=int(helper_mouse_turn_accumulator/8.0);if(mousex!=0)helper_mouse_turn_accumulator-=double(mousex)*8.0;
mousey=int(helper_mouse_aim_accumulator/3.0);if(mousey!=0)helper_mouse_aim_accumulator-=double(mousey)*3.0;
if(helper_mouse_invert_vertical)mousey=-mousey;
mousez=helper_mouse_wheel_inventory?MOUSE_Z/6:0;
nvgt_helpers_loop();
// Translate Android touch gestures into game actions. On non-touch builds
// this returns immediately. Runs before the key handlers below so the
// virtual-key flags it sets (gk_fire, gk_use, ...) are read this same frame.
process_touch_gestures();
if(pingtimer.elapsed > 20000 and pinging==true)
{
p.play_stationary("pingstop.ogg", false);
speak("Ping lost");
pinging=false;
}
if (key_down(KEY_G))
{
if (key_pressed(KEY_T))
{
playcamera();
}
if (kpgdn.pressing)
{
camera.z-=1;
playcamera();
} 
if (kpgup.pressing)
{
camera.z+=1;
playcamera();
}
if (kleft.pressing)
{
camera=move(camera.x, camera.y, camera.z, facing, west);
playcamera();
}
if (kright.pressing)
{
camera=move(camera.x, camera.y, camera.z, facing, east);
playcamera();
}
if (kdown.pressing)
{
camera=move(camera.x, camera.y, camera.z, facing, south);
playcamera();
}
if (kup.pressing)
{
camera=move(camera.x, camera.y, camera.z, facing, north);
playcamera();
}
}
if (key_up(KEY_G))
{
camera.x=mr.x;
camera.y=mr.y;
camera.z=me.z;
}
handle_volume();
if (action_pressed("next_item") and key_up(KEY_LMENU) and key_up(KEY_RMENU))
{
if (shift_is_down())
cycle_inv(0);
else
cycle_inv(1);
p.play_stationary("invmove.ogg", false);
}
if ((key_down(KEY_LMENU) or key_down(KEY_RMENU)) and (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT)) and action_pressed("dev_poi_teleport"))
{
dev_teleport_to_poi();
}
else if (action_pressed("points_of_interest") and key_up(KEY_LMENU) and key_up(KEY_RMENU))
{
show_poi_list();
}
// NVGT key_pressed consumes the edge. Modified item actions must be sampled
// before the plain K/M actions that share their physical default keys.
bool item_shortcut_alt=(key_down(KEY_LMENU) or key_down(KEY_RMENU));
bool item_shortcut_shift=(key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT));
bool item_configuration_pressed=false,item_inspect_pressed=false;
if(item_shortcut_alt and item_shortcut_shift)
{
item_configuration_pressed=action_pressed("item_configuration");
item_inspect_pressed=action_pressed("item_inspect");
if(item_configuration_pressed)cycle_selected_item_configuration();
if(item_inspect_pressed){string inspect_item=get_selected_item();if(inspect_item=="" or is_weapon(inspect_item))speak("Select an inventory item first.");else speak(item_mechanic_description(inspect_item));}
if(action_pressed("extract_pill")){string pill_item=get_selected_item();if(!item_is_pill_bottle(pill_item))speak("Select a pill bottle first.");else send_reliable(0,"extract_pill "+pill_item,0);}
}
if (!item_shortcut_alt and !item_configuration_pressed and !item_inspect_pressed and action_pressed("next_category"))
{
if (shift_is_down())
cycle_category(0);
else
cycle_category(1);
p.play_stationary("invmove.ogg", false);
}
if (!item_shortcut_alt and !item_configuration_pressed and !item_inspect_pressed and action_pressed("nearby_items"))
{
p.play_stationary("executioners_rage/ui/nearby.wav",false);
pending_vehicle_nearby=get_nearby_vehicles_string(int(mr.x), int(mr.y), int(me.z));
string fixture_nearby=nearby_executioners_fixtures(mr.x,mr.y,me.z);if(fixture_nearby!=""){if(pending_vehicle_nearby!="")pending_vehicle_nearby+=" ";pending_vehicle_nearby+=fixture_nearby;}
send_reliable(0,"whatnear",0);
}
if (action_pressed("nearby_players"))
{
if (shift_is_down())
try_use_turbolift();
else
{
p.play_stationary("executioners_rage/playerping.wav",false);
send_reliable(0,"nearplayers",0);
}
}
if (shift_is_down() and action_pressed("transition"))
{
try_use_transition();
}
// Fire mode determines if hold-fire is possible.
if((key_down(KEY_LMENU) or key_down(KEY_RMENU)) and action_pressed("target_region_next")){target_region_index++;if(target_region_index>=int(target_regions.length()))target_region_index=0;p.play_stationary("executioners_rage/ui/bf.wav",false);speak("Targeting "+target_regions[target_region_index]+".");}
if((key_down(KEY_LMENU) or key_down(KEY_RMENU)) and action_pressed("target_region_previous")){target_region_index--;if(target_region_index<0)target_region_index=target_regions.length()-1;p.play_stationary("executioners_rage/ui/bf.wav",false);speak("Targeting "+target_regions[target_region_index]+".");}
if((key_down(KEY_LMENU) or key_down(KEY_RMENU)) and action_pressed("target_region_reset")){target_region_index=0;p.play_stationary("executioners_rage/ui/bfn.wav",false);speak("Target reset to whole body.");}
can_fire = can_hold_fire(weapons[w]);
// key_pressed is consuming in NVGT. Capture the trigger edge exactly once so
// crossbow setup, burst setup, vehicle warnings, and semi-auto firing all see
// the same event instead of pistols and shotguns losing it to an earlier read.
bool physical_fire_pressed=action_pressed("fire") or (key_pressed(KEY_RCONTROL) and rctrl==1);
bool physical_fire_down=action_down("fire") or (key_down(KEY_RCONTROL) and rctrl==1);
// Start a new burst on press in burst mode.
int cur_fm = get_fire_mode(weapons[w]);
if (cur_fm == FIREMODE_BURST and physical_fire_pressed)
{
burst_rounds_remaining = 3;
burst_firing = true;
}
// Reset burst state when fire key is released.
if (key_up(kb("fire")) and (key_up(KEY_RCONTROL) or rctrl==0))
{
burst_firing = false;
burst_rounds_remaining = 0;
}
// Movement locks are used for knockback, menus, stuns, and server corrections.
// They must not silently turn into a permanent weapon lock if a corresponding
// movement-start packet is delayed or lost. Reload state is the weapon gate.
if(!is_reloading(weapons[w]))
{
// Vehicle fire restrictions: no melee, must have window down.
if (in_vehicle and !vehicle_can_fire())
{
if (physical_fire_pressed)
{
if (melee)
speak("You can't use melee weapons from a vehicle.");
else
speak("Roll your window down first.");
}
}
if (in_vehicle and melee and physical_fire_pressed)
{
speak("You can't use melee weapons from a vehicle.");
}
bool fire_now = false;
bool tension_weapon=(weapons[w]=="crossbow");
if(crossbow_charging and !tension_weapon){if(crossbow_charge_sound>=0)p.destroy_sound(crossbow_charge_sound);crossbow_charging=false;crossbow_charge_sound=-1;}
if(tension_weapon and physical_fire_pressed and !crossbow_charging and ammo_check(weapons[w])>0 and firetimer.elapsed>=handling_fire_interval(weapons[w],firetime))
{
crossbow_charging=true;crossbow_full_tension_reported=false;crossbow_charge_timer.restart();crossbow_release_strength=.25;crossbow_charge_sound=p.play_stationary("crossbow_charge_loop.ogg",true);
}
if(crossbow_charging and !crossbow_full_tension_reported and crossbow_charge_timer.elapsed>=1800){crossbow_full_tension_reported=true;p.play_stationary("crossbow_full_tension.ogg",false);}
if (sitting and walktime>=300 and (physical_fire_pressed or gk_fire))
speak("Stand before using this heavy weapon.");
if (firetimer.elapsed>=handling_fire_interval(weapons[w],firetime) and (!in_vehicle or (vehicle_can_fire() and !melee)) and (!sitting or walktime<300))
{
if(tension_weapon and crossbow_charging and !physical_fire_down)
{
crossbow_release_strength=double(crossbow_charge_timer.elapsed)/1800.0;if(crossbow_release_strength<.25)crossbow_release_strength=.25;if(crossbow_release_strength>1)crossbow_release_strength=1;if(crossbow_charge_sound>=0)p.destroy_sound(crossbow_charge_sound);crossbow_charge_sound=-1;crossbow_charging=false;fire_now=true;
}
else if (!tension_weapon and cur_fm == FIREMODE_BURST and burst_firing and burst_rounds_remaining > 0 and (action_down("fire") or (key_down(KEY_RCONTROL) and rctrl==1)))
fire_now = true;
else if (!tension_weapon and ((physical_fire_down and can_fire) or physical_fire_pressed or gk_fire))
fire_now = true;
else if(tension_weapon and gk_fire){crossbow_release_strength=.65;fire_now=true;}
}
if (fire_now)
{
if(!manual_weapon_can_fire(weapons[w],true))fire_now=false;
if(fire_now and !weapon_handling_can_fire(weapons[w],true))fire_now=false;
if(fire_now and melee and !stamina_can_melee(weapons[w],true))fire_now=false;
}
if (fire_now)
{
int weapon_ammo=ammo_check(weapons[w]);
int ammo_cost=1;
if (cur_fm==FIREMODE_FOCUSED) ammo_cost=3;
if(weapons[w]=="double_barrel_shotgun" and cur_fm==FIREMODE_SCATTERSHOT)ammo_cost=2;
// A negative value means this registered weapon intentionally has no magazine
// profile (melee, mounted, or ammo-free content). It must not be treated as an
// empty firearm and silently blocked.
if((weapon_ammo<0 or weapon_ammo>=ammo_cost or melee==true))
{
if(weapon_ammo>=0) ammo_give(weapons[w], -ammo_cost);
manual_weapon_after_fire(weapons[w]);
weapon_handling_after_fire(weapons[w]);
firetimer.restart();
string fire_cmd="fire "+weapons[w];
string sound_mode="normal";
if (cur_fm==FIREMODE_SCATTERSHOT) sound_mode="scattershot";
else if (cur_fm==FIREMODE_FOCUSED) sound_mode="focused";
if(tension_weapon){if(crossbow_release_strength<.45)sound_mode="lowtension";else if(crossbow_release_strength>=.9)sound_mode="maxtension";else sound_mode="normaltension";}
int fire_gun_index=find_gun(weapons[w]);string fired_ammunition=fire_gun_index>=0?gun_ammos[fire_gun_index].loaded_ammunition:"standard_ammunition";
fire_cmd+=" "+sound_mode+" "+choose_fire_sound_index(weapons[w],sound_mode)+" "+string_replace(target_regions[target_region_index],"whole body","body",false)+" "+crossbow_release_strength+" "+fired_ammunition;
fire_cmd+=" "+handling_state(weapons[w]).configuration+" "+handling_state(weapons[w]).mechanical_condition+" "+handling_state(weapons[w]).alignment+" "+handling_state(weapons[w]).permanent_damage;
send_reliable(0,fire_cmd,0);
apply_weapon_recoil(weapons[w]);
if (cur_fm==FIREMODE_FOCUSED) apply_focused_durability_damage(weapons[w]);
if (melee) stamina_on_melee(weapons[w]);
if (cur_fm == FIREMODE_BURST and burst_firing)
{
burst_rounds_remaining--;
if (burst_rounds_remaining <= 0) burst_firing = false;
}
}
else if(weapon_ammo<ammo_cost and firetimer.elapsed>=handling_fire_interval(weapons[w],firetime))
{
firetimer.restart();
p.play_stationary(weapons[w]+"empty.ogg",false);
can_fire=false;
burst_firing = false;
int empty_gi=find_gun(weapons[w]);
if(weapon_ammo>0 and ammo_cost>1)
speak("This firing mode requires "+ammo_cost+" charge, but only "+weapon_ammo+" remains. Press R to reload or switch firing mode.");
else
{
if (empty_gi>=0 and gun_ammos[empty_gi].ammo_display=="charge")
speak(gun_ammos[empty_gi].reserve_label+" depleted. Press R to reload.");
else if (empty_gi>=0 and gun_ammos[empty_gi].ammo_display=="fuel")
speak("Fuel tank empty. Press R to refuel.");
else
speak("Magazine empty. Press R to reload.");
}
}
}
}
bool inspect_modifiers=(key_down(KEY_LMENU) or key_down(KEY_RMENU)) and (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT));
bool handling_inspect_pressed=inspect_modifiers and action_pressed("weapon_inspect");
if(handling_inspect_pressed)speak(weapon_handling_status(weapons[w]));
bool ammo_check_pressed=!handling_inspect_pressed and action_pressed("ammo_check");
if(ammo_check_pressed)
{
if(MENU_is_down())show_weapon_info_form(weapons[w]);
else if (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT))
cycle_fire_mode(weapons[w]);
else
announce_ammo(weapons[w]);
}
bool manual_alt=key_down(KEY_LMENU) or key_down(KEY_RMENU),manual_shift=key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT);
if(manual_alt and !manual_shift and action_pressed("manual_action"))manual_toggle_action(weapons[w]);
if(manual_alt and !manual_shift and action_pressed("manual_insert"))manual_insert_round(weapons[w]);
if(manual_alt and manual_shift and action_pressed("manual_cycle"))manual_cycle_weapon(weapons[w]);
if(manual_alt and manual_shift and action_pressed("manual_eject"))manual_eject_ammunition(weapons[w]);
if(manual_alt and !manual_shift and action_pressed("weapon_operation"))operate_weapon(weapons[w]);
if(manual_alt and manual_shift and action_pressed("weapon_maintenance"))maintain_weapon(weapons[w]);
if(manual_alt and manual_shift and action_pressed("vehicle_service")){int service_vehicle=in_vehicle?player_vehicle_index:find_nearest_vehicle(int(mr.x),int(mr.y),int(me.z),5);if(service_vehicle<0)speak("No vehicle is close enough to inspect.");else map_vehicles[service_vehicle].vehicle_service_panel(int(mr.x),int(mr.y),int(me.z));}
bool reload_pressed=action_pressed("reload");
if(reload_pressed or gk_reload)
{
if(MENU_is_down() and reload_pressed)cycle_weapon_ammunition(weapons[w]);
else if (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT))
unload_mag(weapons[w]);
else if (needs_reload_menu(weapons[w]))
{
// Show menu to choose between full and partial ammo items.
int gi=find_gun(weapons[w]);
gun_ammo@ rg=gun_ammos[gi];
setupmenu();
string selected_load=selected_ammunition_for_weapon(weapons[w]);
string selected_reserve=ammunition_reserve_item(weapons[w],selected_load);
int full_count=get_item_count(selected_reserve);
if (full_count>0)
{
if(selected_load!="standard_ammunition")
m.add_item_tts(ammunition_display_name(selected_load)+" ("+full_count+" rounds available)","full");
else if (rg.ammo_display=="charge")
m.add_item_tts("Full "+rg.reserve_label+" ("+full_count+" available)","full");
else if (rg.ammo_display=="fuel")
m.add_item_tts("Full fuel canister ("+full_count+" available)","full");
else
m.add_item_tts("Full "+rg.reserve_label+" ("+full_count+" available)","full");
}
int[] pindices=get_partial_indices_for(rg.reserve_item);
for (uint pi=0; pi<pindices.length(); pi++)
{
string amt=partial_amount_label(rg.reserve_item, partial_items[pindices[pi]].remaining, partial_items[pindices[pi]].max_capacity);
m.add_item_tts("Partial "+rg.reserve_label+" ("+amt+", "+ammunition_display_name(partial_items[pindices[pi]].ammunition)+")", "partial_"+pindices[pi]);
}
int mres=m.run("Select ammunition to load",true);
string choice=m.get_item_name(mres);
if (choice=="full")
start_reload(weapons[w]);
else if (string_contains(choice, "partial_", 1)==0)
{
int pidx=string_to_number(string_replace(choice, "partial_", "", false));
start_reload_partial(weapons[w], pidx);
}
}
else
start_reload(weapons[w]);
}
if(kb_action_pressed("chat") or gk_chat)
{
string chat=af_input("Enter your message","",true);
if (chat=="/afk")
toggle_afk();
else if (string_contains(string_to_lower_case(chat), "/t ", 1)==0)
send_team_command("chat "+string_mid(chat,3,chat.length()-3));
else if (chat!="")
send_global_chat_or_command(chat);
}
if(kb_action_pressed("help"))
{
show_help_list();
}
else if(kb_action_pressed("health"))
{
send_reliable(0,"health",0);
pending_health_report=true;
}
if ((key_down(KEY_LCONTROL) or key_down(KEY_RCONTROL)) and (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT)) and action_pressed("stamina_check"))
{
speak(get_stamina_string() + " " + get_effects_string());
}
if ((key_down(KEY_LMENU) or key_down(KEY_RMENU)) and action_pressed("effects_read"))
{
speak(get_effects_string());
}
if ((key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT)) and action_pressed("packet_monitor") and (SCRIPT_COMPILED==false or dev_unlocked))
{
packet_monitor_enabled=!packet_monitor_enabled;p.play_stationary(packet_monitor_enabled?"modeenter.ogg":"modeleave.ogg",false);speak(packet_monitor_enabled?"Live packet reporting enabled.":"Live packet reporting disabled.");
}
if ((key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT)) and action_pressed("packet_viewer") and (SCRIPT_COMPILED==false or dev_unlocked))
{
packet_diagnostics_viewer();
}
if (action_pressed("options_menu") and key_up(KEY_LSHIFT) and key_up(KEY_RSHIFT))
{
optionsmenu();
}
// Quickbar view (Shift + key) and inventory menu (plain key) share the same
// default key, so the press is read once and dispatched by modifier. key_pressed
// consumes the press, so reading it twice for the same key would drop the second.
bool quickbar_key_pressed = action_pressed("quickbar_view");
if (quickbar_key_pressed and (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT)))
{
show_quickbar_weapons();
}
bool inventory_key_pressed;
if (kb("inventory") == kb("quickbar_view"))
inventory_key_pressed = quickbar_key_pressed;
else
inventory_key_pressed = action_pressed("inventory");
if (inventory_key_pressed and key_up(KEY_LSHIFT) and key_up(KEY_RSHIFT) and key_up(KEY_LMENU) and key_up(KEY_RMENU) and can_move==true)
{
inventory_menu();
}
if (SCRIPT_COMPILED==false and (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT)) and key_pressed(KEY_D))
{
dev_suite();
}
// Builder menu is dev-only: available when running from source (which the
// server restricts to developer accounts) or when a developer has unlocked
// dev features with a valid key on a compiled build.
// The builder has its own rebindable action (Alt+Shift+P by default). It
// used to be Shift+B, which is why the zone key refused to work while Shift
// was held -- and so never worked while sprinting.
if ((SCRIPT_COMPILED==false or dev_unlocked) and kb_action_pressed("builder_menu"))
{
builder_menu();
}
else if (action_pressed("zone") and key_up(KEY_LMENU) and key_up(KEY_RMENU))
{
if (get_zone_at(mr.x,mr.y,me.z)!="")
{
string locate=get_zone_at(mr.x,mr.y,me.z);
speak("Current zone: "+locate+" of "+map_display_name(mapname));
}
else
{
speak("Current zone: unknown area of "+map_display_name(mapname));
}
}
if(kb_action_pressed("key_practice"))key_practice_mode();
if (action_pressed("player_list") and key_up(KEY_LSHIFT) and key_up(KEY_RSHIFT))
{
speak("Fetching player list, please wait.");
string[] plist=fetch_player_list();
show_player_list_form("Players Online", plist);
}
if(action_pressed("ping") and pinging==false)
{
send_reliable(1, "ping", 0);
p.play_stationary("pingstart.ogg", false);
pingtimer.restart();
pinging=true;
}
if(action_pressed("motd"))
{
send_reliable(0, "motd", 0);
}
// Grave accent removed; escape menu replaces it.
tracker_tick();
waypoint_tick();
if(action_pressed("track_info") and tracking!="" and key_up(KEY_LMENU) and key_up(KEY_RMENU))
{
send_reliable(1, "trackinfo "+tracking, 0);
}
if(action_pressed("track_player"))
{
speak("Fetching player list, please wait.");
string[] plist=fetch_player_list();
show_player_list_form("Track Player", plist, true);
}
if (action_pressed("buffer_left"))
{
if (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT))
{
firstbuffer();
}
else
{
bufferleft();
}
}
if (action_pressed("buffer_right"))
{
if (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT))
{
lastbuffer();
}
else
{
bufferright();
}
}
if(kb_action_pressed("buffer_manager"))
{
buffer_manage_menu();
}
if ((key_down(KEY_LMENU) or key_down(KEY_RMENU)) and (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT)) and key_pressed(KEY_C))
{
review_buffer_item();
}
else if (MENU_is_down() and key_pressed(KEY_C))
{
command_menu();
}
chat_channel_shortcuts();
if (key_pressed(KEY_DELETE))
{
buffer_item_action_menu();
}
// Shift+Enter: show weapon info for the currently selected inventory weapon.
if ((key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT)) and key_up(KEY_LMENU) and key_up(KEY_RMENU) and key_pressed(KEY_RETURN))
{
string sel_item = get_selected_item();
if (sel_item != "" and is_weapon(sel_item))
show_weapon_info(sel_item);
else if (sel_item != "")
speak("Not a weapon.");
else
speak("No item selected.");
}
// Shift+Backspace: holster or draw weapon.
if ((key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT)) and key_up(KEY_LMENU) and key_up(KEY_RMENU) and key_pressed(KEY_BACK))
{
holster_current_weapon();
}
// Alt+S: open support menu.
if (MENU_is_down() and key_pressed(KEY_S))
{
support_menu();
}
if (MENU_is_down() and key_pressed(KEY_F))
{
feedback_menu();
}
// Alt+E: open equipment menu.
if (MENU_is_down() and key_pressed(KEY_E))
{
equipment_menu();
}
// Alt+Backspace: unequip holsters.
if (MENU_is_down() and key_pressed(KEY_BACK))
{
if(equip_holster1!="" or equip_holster2!="")
{
if(equip_holster1!="" and equip_holster2!="")
{
iw_form uf;
uf.create_window("Unequip Holster", false, true);
int ul=uf.create_list("Which holster?", 0, false);
uf.add_list_item(ul, "Holster 1: "+get_holster_slot_label(1));
uf.add_list_item(ul, "Holster 2: "+get_holster_slot_label(2));
uf.add_list_item(ul, "Both");
int uok=uf.create_button("OK", true);
int ucancel=uf.create_button("Cancel", false, true);
uf.focus(ul);
while(true)
{
wait(5);
uf.monitor();
if(uf.is_pressed(ucancel)) break;
if(uf.is_pressed(uok))
{
int s=uf.get_list_position(ul);
if(s==0) unequip_holster(1);
else if(s==1) unequip_holster(2);
else if(s==2){unequip_holster(1);unequip_holster(2);}
break;
}
}
}
else if(equip_holster1!="") unequip_holster(1);
else unequip_holster(2);
}
else
speak("No holsters equipped.");
}
// Alt+Enter: show help for the currently selected inventory item.
if (MENU_is_down() and key_pressed(KEY_RETURN))
{
string sel_item = get_selected_item();
if (sel_item != "")
show_item_help(sel_item);
else
speak("No item selected.");
}
if (key_up(KEY_LSHIFT) and key_up(KEY_RSHIFT) and key_up(KEY_LMENU) and key_up(KEY_RMENU))
{
if((action_pressed("use_item") or mouse_pressed(2) or gk_use) and usetimer.elapsed>n.get_peer_average_round_trip_time(1)+100 and can_move==true)
{
usetimer.restart();
string sel_item = get_selected_item();
if (sel_item == "")
speak("Your inventory is empty.");
else if (string_contains(sel_item, "__partial__", 1) == 0)
use_ammo_item(inv_menu_item_id(sel_item));
else if (is_weapon(sel_item))
draw_weapon(sel_item);
else
{
on_item_used(sel_item);
if (!executioners_handles_item(sel_item) and sel_item != "bomb_vest" and sel_item != "translocator" and sel_item != "translocator_cell" and sel_item != "adrenaline_syringe" and sel_item != "biomonitor_bracelet" and sel_item != "wirenet" and sel_item != "c4" and sel_item != "hypercomp" and sel_item != "nanomatic_multitool" and sel_item != "nanomatic_components" and !is_attachment_item(sel_item) and !is_holster_item(sel_item) and !is_ammo_reserve_item(sel_item))
send_reliable(0,item_use_command(sel_item),0);
}
}
bool vehicle_key_alt=key_down(KEY_LMENU) or key_down(KEY_RMENU),vehicle_key_shift=key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT);
if(((action_pressed("vehicle_door") and !vehicle_key_alt and !vehicle_key_shift) or gk_interact) and can_move==true)
{
if (in_vehicle)
vehicle_toggle_door(int(mr.x), int(mr.y), int(me.z));
else
{
// Check for nearby vehicle door first; otherwise check chest.
int nv = find_nearest_vehicle(int(mr.x), int(mr.y), int(me.z), 5);
if (nv >= 0)
vehicle_toggle_door(int(mr.x), int(mr.y), int(me.z));
else if(interact_nearest_executioners_fixture()){}
else
send_reliable(0, "check_chest", 0);
}
}
if(((action_pressed("vehicle_enter") and !vehicle_key_alt and !vehicle_key_shift) or gk_vehicle) and can_move==true)
{
if (in_vehicle)
vehicle_exit(name);
else
vehicle_enter(name, int(mr.x), int(mr.y), int(me.z));
}
if (kCOMMA.pressing)
{
prevbufferitem();
}
if (kPERIOD.pressing)
{
nextbufferitem();
}
}
if (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT))
{
if (key_pressed(KEY_COMMA))
{
topbufferitem();
}
if (key_pressed(KEY_PERIOD))
{
bottombufferitem();
}
}
if(action_pressed("menu") and x==false)
{
escape_menu();
}
if(kb_action_pressed("staff_panel") and can_move)
{
if(staff_panel_available or dev_unlocked or !SCRIPT_COMPILED)ingame_adminpanel();
else speak("The staff and administrator panel is unavailable for this account.");
}
if(xtimer.elapsed>10 and x==true)
{
x=false;
exitgame();
}
if(action_pressed("coordinates"))
{
// Three numbers on their own answer almost nothing. What a player actually
// wants from this key is where they are and what they are standing on: the
// surface name is how you tell a pavement from a road without stepping off
// the kerb, and the drop below is how you tell a rooftop from a street.
string underfoot=get_tile_at(mr.x,mr.y,me.z);
string report=mr.x+", "+mr.y+", "+me.z;
if(surface_is_air(underfoot))report+=", nothing underfoot";
else report+=", "+underfoot;
if(!surface_is_air(underfoot))
{
int drop=0;
for(int dz=1;dz<=12;dz++){if(!surface_is_air(get_tile_at(mr.x,mr.y,me.z-dz)))break;drop=dz;}
if(drop>=12)report+=", a long way above anything";
else if(drop>0)report+=", "+drop+" above the surface below";
}
// The zone is not repeated here; B reports it, and this reads faster without.
speak(report);
}
if (((key_down(KEY_LMENU) or key_down(KEY_RMENU)) and key_pressed(KEY_W) or action_pressed("vehicle_window")) and in_vehicle and can_move==true)
{
vehicle_toggle_window();
}
if(action_pressed("vehicle_horn") and in_vehicle and can_move==true)vehicle_horn();
if (MENU_is_down() and key_pressed(KEY_Z) and !in_vehicle)
{
sitting=!sitting;
if (sitting)
{
p.play_stationary("modeenter.ogg",false);
speak("Sitting. Movement is reduced, melee stamina recovers faster, and heavy weapons cannot be used.");
if (walktime>=300) speak("Your current heavy weapon is lowered until you stand.");
}
else {p.play_stationary("modeleave.ogg",false);speak("Standing.");}
send_reliable(0, sitting ? "posture sitting" : "posture standing", 0);
}
if((action_pressed("jump") or gk_jump) and jumping==false and falling==false and can_move==true and !in_vehicle and (!sitting or seated_jump_timer.elapsed>=7000))
{
p.play_stationary("executioners_rage/jump.wav", false);
send_reliable(0, "jump", 0);
jumping=true;
jumptimer.restart();
jumpup=1;
jumplandz=me.z;
jump_vertical_position=me.z;
jump_vertical_velocity=9.7-total_equipment_weight()*.055-double(walktime>200?walktime-200:0)*.004;
if(sitting)jump_vertical_velocity=4.8;
if(jump_vertical_velocity<5.2)jump_vertical_velocity=5.2;
if (sitting)
{
seated_jump_timer.restart();
}
}
if(mousez<0) 
{
cycle_inv(0);
p.play_stationary("inv"+random(1, 7)+".ogg", false);
}
if(mousez>0) 
{
cycle_inv(1);
p.play_stationary("inv"+random(1, 7)+".ogg", false);
}
bool qp=action_pressed("turn_left");
if(!in_vehicle)
{
if(shift_is_down() and kQ.pressing)
{
turntimer.restart();
facing=turnleft(facing, 1);
speak(facing+" degrees");
p.play_stationary("turn.ogg", false);
send_reliable(0, "turn "+facing, 0);
}
else if(qp and key_up(KEY_LSHIFT) and key_up(KEY_RSHIFT) or mousex<0 and key_up(KEY_LMENU) and key_up(KEY_RMENU) and turntimer.elapsed >200)
{
turntimer.restart();
facing=snapleft(facing, getdir(facing));
speak(dir_to_string(getdir(facing)));
p.play_stationary("turn.ogg", false);
send_reliable(0, "turn "+facing, 0);
mouse_update();
}
}
if(w>=0 and w<int(weapons.length()))update_weapon_wall_brace(weapons[w],true);
bool xp=action_pressed("aim_down");
string vertical_weapon=(w>=0 and w<int(weapons.length()))?weapons[w]:"empty";
if(mousey>0 and vertical_aim_timer.elapsed>=15){vertical_aim_timer.restart();int mouse_step=mousey>8?8:mousey;set_weapon_vertical_aim(turn-mouse_step,true);}
else if(mousey<0 and vertical_aim_timer.elapsed>=15){vertical_aim_timer.restart();int mouse_step=(-mousey)>8?8:-mousey;set_weapon_vertical_aim(turn+mouse_step,true);}
else if(shift_is_down() and kX.pressing and turn>0 and vertical_aim_timer.elapsed>=weapon_vertical_aim_interval(vertical_weapon)){vertical_aim_timer.restart();set_weapon_vertical_aim(turn-1,true);}
else if(xp and key_up(KEY_LSHIFT) and key_up(KEY_RSHIFT) and turn>0)set_weapon_vertical_aim(turn>90?90:0,false);
bool sp=action_pressed("aim_up");
if(shift_is_down() and kS.pressing and vertical_aim_timer.elapsed>=weapon_vertical_aim_interval(vertical_weapon)){vertical_aim_timer.restart();set_weapon_vertical_aim(turn+1,true);}
else if(sp and key_up(KEY_LSHIFT) and key_up(KEY_RSHIFT))set_weapon_vertical_aim(turn<90?90:180,false);
bool ep=action_pressed("turn_right");
if(!in_vehicle)
{
if(shift_is_down() and kE.pressing)
{
turntimer.restart();
facing=turnright(facing, 1);
speak(facing+" degrees");
p.play_stationary("turn.ogg", false);
send_reliable(0, "turn "+facing, 0);
}
else if(ep and key_up(KEY_LSHIFT) and key_up(KEY_RSHIFT) or mousex>0 and key_up(KEY_LMENU) and key_up(KEY_RMENU) and turntimer.elapsed >200)
{
turntimer.restart();
facing=snapright(facing, getdir(facing));
speak(dir_to_string(getdir(facing)));
p.play_stationary("turn.ogg", false);
send_reliable(0, "turn "+facing, 0);
mouse_update();
}
}
if(action_pressed("facing"))
{
string vert_info="";
if(turn==90) vert_info=", aiming straight forward";
else if(turn==0) vert_info=", aiming straight down";
else if(turn==180) vert_info=", aiming straight up";
else if(turn<90) vert_info=", aiming "+turn+" degrees vertical";
else vert_info=", aiming "+turn+" degrees vertical";
speak("You are facing "+dir_to_string(getdir(facing))+" at "+facing+" degrees"+vert_info+".");
}
if(MENU_is_down() and !in_vehicle)
{
if(action_down("move_left"))
{
facing=turnleft(facing, 1);
}
if(action_down("move_right"))
{
facing=turnright(facing, 1);
}
}
if(!MENU_is_down() and key_up(KEY_G) and can_move==true)
{
if (in_vehicle)
{
// Vehicle controls: arrows control vehicle, not player movement.
if (current_vehicle_can_fly() and key_pressed(KEY_PAGEUP)) vehicle_change_altitude(1);
if (current_vehicle_can_fly() and key_pressed(KEY_PAGEDOWN)) vehicle_change_altitude(-1);
if (action_pressed("move_forward"))
vehicle_speed_up();
else if (action_pressed("move_backward"))
{
if (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT))
vehicle_decelerate_gradual();
else
vehicle_speed_down();
}
if (action_pressed("move_left"))
{
if (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT))
vehicle_turn_fine(-1);
else
vehicle_turn(-1);
}
else if (action_pressed("move_right"))
{
if (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT))
vehicle_turn_fine(1);
else
vehicle_turn(1);
}
}
else
{
// Normal on-foot movement.
bool wants_sprint=(shift_is_down() or touch_sprint) and !sitting and (action_down("move_forward") or action_down("move_backward") or action_down("move_left") or action_down("move_right"));
bool sprinting=wants_sprint and weapon_allows_sprint(weapons[w]);
if(wants_sprint and !sprinting and sprint_heavy_warning_timer.elapsed>2500){sprint_heavy_warning_timer.restart();speak("This weapon is too heavy to sprint with.");}
if(action_down("move_up") and walktimer.elapsed>movetime)
{
walktimer.restart();
move(Up);
}
else if(action_down("move_down") and walktimer.elapsed>movetime)
{
walktimer.restart();
move(Down);
}
string desired_move="";
if(action_down("move_forward"))desired_move=Forward;else if(action_down("move_backward"))desired_move=Backward;else if(action_down("move_left"))desired_move=Left;else if(action_down("move_right"))desired_move=Right;
double weight_factor=(1.0+total_equipment_weight()/80.0+double(walktime>200?walktime-200:0)/900.0)*handling_movement_penalty(weapons[w]);
if(desired_move!="")
{
if(momentum_direction!="" and momentum_direction!=desired_move)movement_momentum*=.45;
momentum_direction=desired_move;
int momentum_interval=int(double(movetime)*(1.18-.34*movement_momentum)*weight_factor);
int minimum_safe_interval=walktime*3/4+5;if(momentum_interval<minimum_safe_interval)momentum_interval=minimum_safe_interval;
if(walktimer.elapsed>momentum_interval){walktimer.restart();move(desired_move);movement_momentum+=.16/weight_factor;if(movement_momentum>1)movement_momentum=1;}
momentum_timer.restart();
}
else
{
// Releasing a movement key stops issuing navigation steps immediately. The
// simulated momentum now affects cadence only while the player is actively
// holding a direction; it never invents a second grid step after a tap.
movement_momentum*=.55;
if(movement_momentum<.08){movement_momentum=0;momentum_direction="";}
}
}
}
if(can_move==true)
{
// Alt+Left/Right: switch vehicle seats.
if(MENU_is_down() and in_vehicle)
{
if(action_pressed("move_left")) vehicle_switch_seat(name, -1);
if(action_pressed("move_right")) vehicle_switch_seat(name, 1);
}
// Alt+number: bind current inventory item to that quickbar slot.
if(MENU_is_down())
{
if(key_pressed(KEY_1)) bind_quickbar(0);
if(key_pressed(KEY_2)) bind_quickbar(1);
if(key_pressed(KEY_3)) bind_quickbar(2);
if(key_pressed(KEY_4)) bind_quickbar(3);
if(key_pressed(KEY_5)) bind_quickbar(4);
if(key_pressed(KEY_6)) bind_quickbar(5);
if(key_pressed(KEY_7)) bind_quickbar(6);
if(key_pressed(KEY_8)) bind_quickbar(7);
if(key_pressed(KEY_9)) bind_quickbar(8);
if(key_pressed(KEY_0)) bind_quickbar(9);
}
// Number key without modifiers: activate quickbar slot.
if(!MENU_is_down() and key_up(KEY_LSHIFT) and key_up(KEY_RSHIFT))
{
if(key_pressed(KEY_1)) use_quickbar_slot(0);
if(key_pressed(KEY_2)) use_quickbar_slot(1);
if(key_pressed(KEY_3)) use_quickbar_slot(2);
if(key_pressed(KEY_4)) use_quickbar_slot(3);
if(key_pressed(KEY_5)) use_quickbar_slot(4);
if(key_pressed(KEY_6)) use_quickbar_slot(5);
if(key_pressed(KEY_7)) use_quickbar_slot(6);
if(key_pressed(KEY_8)) use_quickbar_slot(7);
if(key_pressed(KEY_9)) use_quickbar_slot(8);
if(key_pressed(KEY_0)) use_quickbar_slot(9);
}
// Grave accent: give all (only when running from source) — legacy shortcut.
}
}
}
void buffer_item_action_menu()
{
if (buffers[bufferpos].items.length()==0)
{
speak("No items in this buffer.");
return;
}
string bname=buffers[bufferpos].name;
bool can_quote=(bname=="chats");
bool can_report=(bname=="chats" or bname=="all");
if (!can_quote and !can_report)
{
speak("There are no actions available for this buffer item.");
return;
}
string item=buffers[bufferpos].items[buffers[bufferpos].pos];
iw_form f;
f.create_window("Buffer Item Actions", false, true);
int f_list=f.create_list("Choose an action", 0, false);
int quote_index=-1;
int report_index=-1;
int idx=0;
if (can_quote)
{
f.add_list_item(f_list, "Quote message");
quote_index=idx;
idx++;
}
if (can_report)
{
f.add_list_item(f_list, "Report");
report_index=idx;
idx++;
}
int f_ok=f.create_button("&OK", true);
int f_cancel=f.create_button("&Cancel", false, true);
f.focus(f_list);
while(true)
{
wait(5);
f.monitor();
if (f.is_pressed(f_cancel))
return;
if (f.is_pressed(f_ok))
{
int sel=f.get_list_position(f_list);
if (sel==quote_index)
{
int quote_count=0;
string scan=item;
while(string_contains(scan, ", quoted: ", 1)>=0)
{
quote_count++;
int qp=string_contains(scan, ", quoted: ", 1);
scan=string_mid(scan, qp+10, scan.length()-qp-9);
}
if (quote_count>=3)
{
speak("This message already has the maximum of 3 quotes.");
return;
}
int colon=string_contains(item, ": ", 1);
if (colon<0)
{
speak("Could not parse this chat message.");
return;
}
string author=string_left(item, colon);
string msg=string_mid(item, colon+2, item.length()-colon-1);
string reply=af_input("Enter your message","",true);
if (reply=="") return;
send_reliable(0, reply+", quoted: "+author+": "+msg, 1);
}
else if (sel==report_index)
{
int qp=string_contains(item, ", quoted: ", 1);
if (qp>=0)
{
int colon=string_contains(item, ": ", 1);
string reporter_msg_author="unknown";
string reporter_msg=item;
string quoted_part="";
if (colon>=0 and colon<qp)
{
reporter_msg_author=string_left(item, colon);
reporter_msg=string_mid(item, colon+2, qp-colon-1);
quoted_part=string_mid(item, qp+10, item.length()-qp-9);
}
else
{
quoted_part=string_mid(item, qp+10, item.length()-qp-9);
}
send_reliable(0, "report_quoted "+reporter_msg_author+"\t"+reporter_msg+"\t"+quoted_part, 0);
}
else
{
send_reliable(0, "report_message "+item, 0);
}
p.play_stationary("ticket_open.ogg",false);
speak("Message reported.");
}
return;
}
}
}
bool shift_is_down()
{
if(key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT))
{
return true;
}
return false;
}
bool MENU_is_down()
{
if(key_down(KEY_LMENU) or key_down(KEY_RMENU))
{
return true;
}
return false;
}
bool control_is_down()
{
if(key_down(KEY_LCONTROL) or key_down(KEY_RCONTROL))
{
return true;
}
return false;
}
