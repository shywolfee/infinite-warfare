string af_input(string title, string text="", bool online=false)
{
// NV_form now owns text entry on every platform, including Android. This keeps
// gesture navigation and the network/game pump alive while the field is open.
iw_form af;
af.create_window(title, false, true);
int af_n=af.create_input_box(title, text, "", 0, false, false, false);
int af_ok=af.create_button("&OK", true);
int af_cancel=af.create_button("&Cancel", false, true);
af.focus(af_n);
while(true)
{
wait(5);
af.monitor();
if(online==true)
{
mainloop();
netloop();
p.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
}
if(af.is_pressed(af_cancel))
return "";
if(af.is_pressed(af_ok))
return af.get_text(af_n);
}
return "";
}
string webdir;
string gamename="Infinite Warfare";
string game_window_title(){return gamename+"!, version "+version+", build "+build_number+" ("+build_date+")";}
bool set_fullscreen_mode(bool enabled,bool announce=true)
{
uint flags=enabled?WINDOW_FLAG_FULLSCREEN:0;
game_window@ changed_window=show_window(game_window_title(),flags);
if(@changed_window==null){if(announce)speak("Unable to change the game window mode.");return false;}
fullscreen_enabled=enabled;focus_window();
if(@iw_mouse!=null)iw_mouse.full_screen(fullscreen_enabled or helper_mouse_confined);
if(announce)speak(fullscreen_enabled?"Full screen enabled.":"Full screen disabled. Windowed mode enabled.");
return true;
}
void toggle_fullscreen_mode(){if(set_fullscreen_mode(!fullscreen_enabled,true))writeprefs();}
void process_fullscreen_shortcut()
{
bool ctrl=key_down(KEY_LCONTROL) or key_down(KEY_RCONTROL),shift=key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT);
if(ctrl and shift and key_up(KEY_LMENU) and key_up(KEY_RMENU) and key_pressed(kb("fullscreen_toggle")))toggle_fullscreen_mode();
}
