#pragma plugin nvgt_app_volume
void handle_volume()
{
if(key_pressed(KEY_HOME))
{
sys_audio_set_app_volume(sys_audio_get_app_volume()+0.1);
speak("volume up");
}
if(key_pressed(KEY_END))
{
sys_audio_set_app_volume(sys_audio_get_app_volume()-0.1);
speak("volume down");
}
}
double app_volume_percent(){return sys_audio_get_app_volume()*100.0;}
void set_app_volume_percent(double percent){if(percent<0)percent=0;if(percent>100)percent=100;sys_audio_set_app_volume(percent/100.0);}
