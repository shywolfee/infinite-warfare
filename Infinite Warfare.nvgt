sd.save();
}
void send_reliable(uint peer, string mess, uint channel)
{
record_diagnostic_packet("sent","reliable",peer,channel,mess);
mess=string_encrypt(mess, "_';'_clickclick!");
n.send_reliable(peer, mess, channel);
}
void send_unreliable(uint peer, string mess, uint channel)
{
record_diagnostic_packet("sent","unreliable",peer,channel,mess);
mess=string_encrypt(mess, "_';'_clickclick!");
n.send_unreliable(peer, mess, channel);
}
string get_event_message()
{
string r=e.message;
if(r=="")
{
return "";
}
r=string_decrypt(r, "masonandsamare2bitches");
return r;
}
void netloop(bool service_periodic=true)
{
if(service_periodic)voice_chat_loop();
e=n.request();
if (e.type==event_disconnect)
{
speak("You have lost connection to the server.");
helper_show_notification("Infinite Warfare disconnected","The connection to the game server was lost.");
connected=false;
prevconnected=false;
pinging=false;
inv.delete_all();
destroy_all_sources();
distpool.destroy_all();
p.destroy_all();
sources.resize(0);
can_move=true;
jumping=false;
falling=false;
in_vehicle=false;
dlg("Connection to the server was lost. Press Enter to return to the main menu.");
mainmenu();
return;
}
if (e.type==event_receive)
{
record_diagnostic_packet("received","network",e.peer_id,e.channel,get_event_message());
last_server_msg.restart();
if (e.channel==0)
{
string full_msg=get_event_message();
string[] parsed=string_split(full_msg," ",true);
if(parsed[0]=="motd_response")
{
show_readonly_audio_form("Message of the Day",string_replace(full_msg,"motd_response ","",false));
}
else if(parsed[0]=="reset_ammo")
{
reset_ammo();
}
else if(parsed[0]=="revive")
{
send_reliable(0, "player_remove", 0);
game(2);
}
else if(parsed[0]=="src"and parsed.length()>8)
{
spawn_source(string_to_number(parsed[1]), string_to_number(parsed[2]), string_to_number(parsed[3]), string_to_number(parsed[4]), string_to_number(parsed[5]), string_to_number(parsed[6]), parsed[7],1, false, string_to_number(parsed[8]));
}
else if(parsed[0]=="dist_src"and parsed.length()>8)
{
spawn_source(string_to_number(parsed[1]), string_to_number(parsed[2]), string_to_number(parsed[3]), string_to_number(parsed[4]), string_to_number(parsed[5]), string_to_number(parsed[6]), parsed[7],2, false, string_to_number(parsed[8]));
}
else if(parsed[0]=="sc")
{
can_stop=!can_stop;
}
else if(parsed[0]=="remove_src" and parsed.length()>1)
{
destroy_source(string_to_number(parsed[1])); 
}
else if(parsed[0]=="resetinv")
{
inv.delete_all();
}
else if(parsed[0]=="move_source" and parsed.length()>7)
{
int id=string_to_number(parsed[1]);
int lx=string_to_number(parsed[2]);
int rx=string_to_number(parsed[3]);
int miny=string_to_number(parsed[4]);
int maxy=string_to_number(parsed[5]);
int minz=string_to_number(parsed[6]);
int maxz=string_to_number(parsed[7]);
move_src(id,lx,rx,miny,maxy,minz,maxz);
}
else if(parsed[0]=="projectile_audio_start" and parsed.length()>6)
{
int audio_id=string_to_number(parsed[1]);bool own=parsed.length()>7 and parsed[7]==name;if(parsed[6]==mapname and (!own or hear_own_projectile_audio))spawn_source(string_to_number(parsed[3]),string_to_number(parsed[3]),string_to_number(parsed[4]),string_to_number(parsed[4]),string_to_number(parsed[5]),string_to_number(parsed[5]),parsed[2],1,false,audio_id);
}
else if(parsed[0]=="projectile_audio_move" and parsed.length()>5)
{
if(parsed[5]==mapname){int audio_id=string_to_number(parsed[1]),ax=string_to_number(parsed[2]),ay=string_to_number(parsed[3]),az=string_to_number(parsed[4]);move_src(audio_id,ax,ax,ay,ay,az,az);}
}
else if(parsed[0]=="projectile_audio_batch" and parsed.length()>1)
{
for(uint bi=1;bi<parsed.length();bi++){string[] position=string_split(parsed[bi],",",false);if(position.length()!=4)continue;int audio_id=string_to_number(position[0]),ax=string_to_number(position[1]),ay=string_to_number(position[2]),az=string_to_number(position[3]);move_src(audio_id,ax,ax,ay,ay,az,az);}
}
else if(parsed[0]=="projectile_audio_stop" and parsed.length()>1)
destroy_source(string_to_number(parsed[1]));
else if(parsed[0]=="projectile_whiz" and parsed.length()>6)
{
bool own=parsed[6]==name;
if(parsed[5]==mapname and (!own or hear_own_projectile_audio))p.play_3d(parsed[1],me.x,me.y,me.z,string_to_number(parsed[2]),string_to_number(parsed[3]),string_to_number(parsed[4]),calculate_theta(facing),false);
}
else if(parsed[0]=="plane_crash")
{
in_plane=false;
go_out=true;
}
else if(parsed[0]=="start_the_plane")
{
pause_all_sources();
splaneloop();
}
else if(parsed[0]=="start_plane")
{
pause_all_sources();
planeloop();
}
else if(parsed[0]=="step")
{
int x=string_to_number(parsed[1]);
int y=string_to_number(parsed[2]);
int z=string_to_number(parsed[3]);
string map=parsed[4];
if(parsed[5]!=name and mapname==map)
{
p.play_3d(get_tile_at(x, y, z)+"step"+random(1, 5)+".ogg", me.x, me.y, me.z, x, y, z, calculate_theta(facing), false);
}
}
else if(parsed[0]=="mapdata")
{
load_map(string_replace(get_event_message(), "mapdata ", "", true));
spawn_vehicles_on_map();
register_vehicles_with_server();
}
else if(parsed[0]=="wallremove" and parsed.length()>3)
{
for (uint i=0; i<walls.length(); i++)
{
int x=string_to_number(parsed[1]);
int y=string_to_number(parsed[2]);
int z=string_to_number(parsed[3]);
if(walls[i].x==x and walls[i].y==y and walls[i].miniz==z)
{
walls.remove_at(i);
return;
}
}
}
else if(parsed[0]=="ladderremove" and parsed.length()>3)
{
for (uint i=0; i<ladders.length(); i++)
{
int x=string_to_number(parsed[1]);
int y=string_to_number(parsed[2]);
int z=string_to_number(parsed[3]);
if(ladders[i].x==x and ladders[i].y==y and ladders[i].miniz==z)
{
ladders.remove_at(i);
return;
}
}
}
else if(parsed[0]=="wall_spawned" and parsed.length()>4)
 {
int x=string_to_number(parsed[1]);
int y=string_to_number(parsed[2]);
int z=string_to_number(parsed[3]);
string map=parsed[4];
spawn_wall(x,y,z,z+10,map,"wallwood");
}
else if(parsed[0]=="ladder_spawned" and parsed.length()>4)
 {
int x=string_to_number(parsed[1]);
int y=string_to_number(parsed[2]);
int z=string_to_number(parsed[3]);
string map=parsed[4];
spawn_ladder(x,y,z,z+10,map,"wallwood");
}
else if(parsed[0]=="veh_damage" and parsed.length()>2)
{
int vi=string_to_number(parsed[1]);
int dmg=string_to_number(parsed[2]);
if (vi>=0 and vi<int(map_vehicles.length()) and (parsed.length()<4 or parsed[3]==mapname))
{
bool destroyed=false;
if(parsed.length()>5){map_vehicles[vi].health=string_to_number(parsed[4]);map_vehicles[vi].armor=string_to_number(parsed[5]);destroyed=map_vehicles[vi].health<=0;map_vehicles[vi].destroyed=destroyed;}
else destroyed=vehicle_take_damage(vi,dmg);
if (player_vehicle_index==vi)
{
speak("Vehicle hit! " + map_vehicles[vi].health + " health remaining.");
if (destroyed) vehicle_on_destroy(vi);
}
}
else if(parsed[0]=="veh_sync_move" and parsed.length()>6)
{
int vi=string_to_number(parsed[1]);
if(parsed[6]==mapname and vi>=0 and vi<int(map_vehicles.length()))
{
map_vehicles[vi].x=string_to_number(parsed[2]);map_vehicles[vi].y=string_to_number(parsed[3]);map_vehicles[vi].z=string_to_number(parsed[4]);map_vehicles[vi].observed_velocity=string_to_number(parsed[5]);
}
}
else if(parsed[0]=="veh_authority" and parsed.length()>8)
{
int vi=string_to_number(parsed[1]);
if(parsed[8]==mapname and vi>=0)
{
int type_index=-1;for(uint vt=0;vt<vehicle_types.length();vt++)if(vehicle_audio_id_from_name(vehicle_types[vt].name)==parsed[2]){type_index=int(vt);break;}
if(type_index>=0)
{
while(int(map_vehicles.length())<=vi)map_vehicles.insert_last(vehicle(type_index,string_to_number(parsed[3]),string_to_number(parsed[4]),string_to_number(parsed[5])));
vehicle@ v=map_vehicles[vi];if(v.type_index!=type_index){v.type_index=type_index;v.passengers.resize(vehicle_types[type_index].max_passengers);v.window_down.resize(vehicle_types[type_index].max_passengers);for(int seat=0;seat<vehicle_types[type_index].max_passengers;seat++){v.passengers[seat]="";v.window_down[seat]=false;}}v.x=string_to_number(parsed[3]);v.y=string_to_number(parsed[4]);v.z=string_to_number(parsed[5]);v.health=string_to_number(parsed[6]);v.armor=string_to_number(parsed[7]);v.destroyed=v.health<=0;
}
}
}
}
else if(parsed[0]=="veh_destroyed" and parsed.length()>1)
{
int vi=string_to_number(parsed[1]);
if (vi>=0 and vi<int(map_vehicles.length()) and !map_vehicles[vi].destroyed)
{
map_vehicles[vi].destroyed=true;
map_vehicles[vi].health=0;
if (player_vehicle_index==vi) vehicle_on_destroy(vi);
}
}
else if(parsed[0]=="team_plane_spawn" and parsed.length()>3)
{
spawn_team_plane_vehicle(string_to_number(parsed[1]), string_to_number(parsed[2]), string_to_number(parsed[3]));
}
else if(parsed[0]=="team_vehicle_spawn" and parsed.length()>4)
{
spawn_team_vehicle(parsed[1],string_to_number(parsed[2]),string_to_number(parsed[3]),string_to_number(parsed[4]));
}
else if(parsed[0]=="ping" and pinging==true)
{
p.play_stationary("pingstop.ogg", false);
int sample=int(pingtimer.elapsed);
ping_samples.insert_last(sample);
int lowest=ping_samples[0];
int highest=ping_samples[0];
int total=0;
for (uint ps=0; ps<ping_samples.length(); ps++)
{
if (ping_samples[ps]<lowest) lowest=ping_samples[ps];
if (ping_samples[ps]>highest) highest=ping_samples[ps];
total+=ping_samples[ps];
}
int average=total/int(ping_samples.length());
speak("Ping "+sample+" milliseconds. Lowest "+lowest+", highest "+highest+", average "+average+" across "+ping_samples.length()+" samples.");
pinging=false;
}
else if(parsed[0]=="ammogive" and parsed.length()>2)
{
safe_server_ammo_grant(parsed[1],parsed[2]);
}
else if(parsed[0]=="weapon_set" and parsed.length()>1)
{
weapons[w]=parsed[1];
apply_weapon_stats(parsed[1]);
speak(get_weapon_display_name(parsed[1]));
send_reliable(1, "draw "+parsed[1], 0);
}
else if(parsed[0]=="setcoords")
{
me.x=string_to_number(parsed[1]);
me.y=string_to_number(parsed[2]);
me.z=string_to_number(parsed[3]);
}
else if(parsed[0]=="playermenu")
{
string text=string_replace(get_event_message(), "playermenu ", "Stop Tracking\r\n", false);
string[] players=string_split(text, "\r\n", false);
playertrackmenu(players);
}
else if(parsed[0]=="distsound" and parsed.length()>5)
{
string soundname=parsed[1];
int x=string_to_number(parsed[2]);
int y=string_to_number(parsed[3]);
int z=string_to_number(parsed[4]);
string soundmap=parsed[5];
if(soundmap==mapname)
distpool.play_3d(soundname, me.x, me.y, me.z, x, y, z,facing, false);
}
else if (parsed[0]=="play_s" and parsed.length()>=2)
{
p.play_stationary(parsed[1],false);
}
else if(parsed[0]=="armor_weight" and parsed.length()>1)
{
equipped_armor_weight=string_to_number(parsed[1]);
}
else if(parsed[0]=="medication_remaining" and parsed.length()>2)
{
double medication_amount=string_to_number(parsed[2]);if(medication_amount<=0)client_medication_remaining.delete(parsed[1]);else client_medication_remaining.set(parsed[1],medication_amount);
}
else if(parsed[0]=="armor_state" and parsed.length()>9)
{
equipped_armor_head=parsed[1]=="none"?"":parsed[1]; equipped_armor_head_durability=string_to_number(parsed[2]);
equipped_armor_torso=parsed[3]=="none"?"":parsed[3]; equipped_armor_torso_durability=string_to_number(parsed[4]);
equipped_armor_arms=parsed[5]=="none"?"":parsed[5]; equipped_armor_arms_durability=string_to_number(parsed[6]);
equipped_armor_legs=parsed[7]=="none"?"":parsed[7]; equipped_armor_legs_durability=string_to_number(parsed[8]);
equipped_armor_weight=string_to_number(parsed[9]);
}
else if(parsed[0]=="combat_slow" and parsed.length()>1)
{
combat_slow_duration=string_to_number(parsed[1]);combat_slow_timer.restart();speak("Movement impaired.");
}
else if(parsed[0]=="stamina_restore" and parsed.length()>1)
{
restore_stamina(string_to_number(parsed[1]));
}
else if(parsed[0]=="weapon_sway" and parsed.length()>1)
{
weapon_sway_duration=string_to_number(parsed[1]);weapon_sway_timer.restart();p.play_stationary("arm_hit_sway.ogg",false);speak("Weapon stability impaired.");
}
else if (parsed[0]=="target_hp" and parsed.length()>=2)
{
string hp_msg="";
bool was_headshot=(parsed.length()>=4 and (parsed[3]=="headshot" or parsed[3]=="head"));
if (was_headshot)
{
p.play_stationary("headshot_indicator.ogg", false);
hp_msg+="Headshot! ";
}
if (show_damage_readout and parsed.length()>=3)
hp_msg+="Damage: "+parsed[2]+". ";
if (show_target_hp)
hp_msg+="Target HP: "+parsed[1];
if (hp_msg!="") speak(hp_msg);
}
else if(parsed[0]=="target_vehicle" and parsed.length()>=3)
{
string vehicle_hit_msg="";
if(show_damage_readout) vehicle_hit_msg+="Vehicle damage: "+parsed[2]+". ";
if(show_target_hp) vehicle_hit_msg+="Vehicle HP: "+parsed[1]+(parsed.length()>3?", armor "+parsed[3]:"")+".";
if(vehicle_hit_msg!="")speak(vehicle_hit_msg);
}
else if (parsed[0]=="give" and parsed.length()>2)
{
safe_server_item_grant(parsed[1],parsed[2]);
}
else if(parsed[0]=="updating")
{
dlg("The server is updating, please connect again in about 20 seconds. ");
exit();
}
else if(parsed[0]=="hitwall")
{
int x=string_to_number(parsed[2]);
int y=string_to_number(parsed[3]);
int z=string_to_number(parsed[4]);
string map=parsed[5];
if(parsed[1]!=name and map==mapname)
{
p.play_3d("wall"+string_replace(get_tile_at(x, y, z), "wall", "", true)+".ogg", me.x, me.y, me.z, x, y, z, calculate_theta(facing), false);
}
}
else if(parsed[0]=="jump")
{
int x=string_to_number(parsed[2]);
int y=string_to_number(parsed[3]);
int z=string_to_number(parsed[4]);
string map=parsed[5];
if(parsed[1]!=name and map==mapname)
{
p.play_3d("jump.ogg", me.x, me.y, me.z, x, y, z, calculate_theta(facing), false);
}
}
else if(parsed[0]=="turn")
{
int x=string_to_number(parsed[2]);
int y=string_to_number(parsed[3]);
int z=string_to_number(parsed[4]);
string map=parsed[5];
if(parsed[1]!=name and map==mapname)
{
p.play_3d("turn.ogg", me.x, me.y, me.z, x, y, z, calculate_theta(facing), false);
}
}
else if(parsed[0]=="hardland")
{
int x=string_to_number(parsed[2]);
int y=string_to_number(parsed[3]);
int z=string_to_number(parsed[4]);
string map=parsed[5];
if(parsed[1]!=name and map==mapname)
{
p.play_3d(get_tile_at(x, y, z)+"fall.ogg", me.x, me.y, me.z, x, y, z, calculate_theta(facing), false);
}
}
else if(parsed[0]=="land")
{
int x=string_to_number(parsed[2]);
int y=string_to_number(parsed[3]);
int z=string_to_number(parsed[4]);
string map=parsed[5];
if(parsed[1]!=name and map==mapname)
{
p.play_3d(get_tile_at(x, y, z)+"land.ogg", me.x, me.y, me.z, x, y, z, calculate_theta(facing), false);
}
}
else if(parsed[0]=="fall")
{
int x=string_to_number(parsed[2]);
int y=string_to_number(parsed[3]);
int z=string_to_number(parsed[4]);
string map=parsed[5];
if(parsed[1]!=name and map==mapname and in_plane==false)
{
p.play_3d("fall.ogg", me.x, me.y, me.z, x, y, z, calculate_theta(facing), false);
}
}
else if(parsed[0]=="death")
{
death();
}
else if(parsed[0]=="offline" and parsed.length()>1)
{
if(parsed[4]==name)
{
x=false;
exitgame();
}
int x=string_to_number(parsed[1]);
int y=string_to_number(parsed[2]);
int z=string_to_number(parsed[3]);
if(me.x > x-20 and me.x < x+20 and me.y > y-20 and me.y < y+20 and me.z>z-20 and me.z<z+20 and parsed[4]!=name and mapname==parsed[5])
{
p.play_3d("offline.ogg", me.x, me.y, me.z, x, y, z, calculate_theta(facing), false);
add_buffer_item("misc",parsed[4]+" just went offline");
}
else if(parsed[4]!=name)
{
p.play_stationary("offline.ogg", false);
add_buffer_item("misc",parsed[4]+" just went offline");
}
}
else if(parsed[0]=="movestop")
{
can_move=false;
}
else if(parsed[0]=="movestart")
{
can_move=true;
}
else if(parsed[0]=="online")
{
int x=string_to_number(parsed[1]);
int y=string_to_number(parsed[2]);
int z=string_to_number(parsed[3]);
if(me.x > x-20 and me.x < x+20 and me.y > y-20 and me.y < y+20 and me.z>z-20 and me.z<z+20 and parsed[4]!=name and parsed[5]==mapname)
{
p.play_3d("online.ogg", me.x, me.y, me.z, x, y, z, calculate_theta(facing), false);
add_buffer_item("misc",parsed[4]+" just came online");
}
else if(parsed[4]!=name)
{
p.play_stationary("online.ogg", false);
add_buffer_item("misc",parsed[4]+" just came online");
}
}
else if(parsed.length()>=5 and is_sound_number(parsed[1]) and is_sound_number(parsed[2]) and is_sound_number(parsed[3]))
{
if(parsed[4]==mapname)
p.play_3d(parsed[0]+".ogg", me.x, me.y, me.z, string_to_number(parsed[1]), string_to_number(parsed[2]), string_to_number(parsed[3]), calculate_theta(facing), false);
}
else if(parsed[0]=="whatnear_result")
{
string items_str=string_replace(full_msg, "whatnear_result ", "", false);
string combined="";
if(pending_vehicle_nearby!="")
combined+=pending_vehicle_nearby;
if(items_str!="" and items_str!="whatnear_result")
{
if(combined!="") combined+=" ";
combined+=items_str;
}
if(combined=="")
combined="Nothing near you";
add_buffer_item("misc", combined);
pending_vehicle_nearby="";
}
else if(parsed[0]=="wirenet_healed" and parsed.length()>1)
{
wirenet_charges--;
speak("WireNet activated! Health restored to " + parsed[1] + "%. " + wirenet_charges + " charges remaining.");
if (wirenet_charges <= 0)
{
speak("WireNet depleted.");
equip_medical = "";
}
}
else
{
speak(full_msg);
if (pending_health_report and string_contains(full_msg, "health", 1) >= 0)
{
pending_health_report = false;
}
}
}
if(e.channel==5)
{
string[] parsed=string_split(get_event_message()," ",true);
if(parsed.length()>=5 and is_sound_number(parsed[1]) and is_sound_number(parsed[2]) and is_sound_number(parsed[3]))
{
if(parsed[4]==mapname)
{
int sx=string_to_number(parsed[1]);
int sy=string_to_number(parsed[2]);
int sz=string_to_number(parsed[3]);
p.play_3d(parsed[0]+".ogg", me.x, me.y, me.z, sx, sy, sz, calculate_theta(facing), false);
string snd=parsed[0];
if(snd=="fraggrenadeexplode")
check_vehicle_damage_from_explosion(sx, sy, sz, 16, 500, 500);
else if(snd=="semtexexplode")
check_vehicle_damage_from_explosion(sx, sy, sz, 30, 650, 650);
else if(snd=="planebombexplode")
check_vehicle_damage_from_explosion(sx, sy, sz, 20, 650, 650);
else if(snd=="120mm_mortarexplode")
check_vehicle_damage_from_explosion(sx, sy, sz, 20, 500, 500);
else if(snd=="bunkerbombexplode")
check_vehicle_damage_from_explosion(sx, sy, sz, 150, 2000, 2000);
else if(snd=="bombvestexplode")
check_vehicle_damage_from_explosion(sx, sy, sz, 25, 1500, 1500);
else if(snd=="torpedoexplode")
check_vehicle_damage_from_explosion(sx, sy, sz, 10, 700, 700);
else if(string_contains(snd, "hit", 1) >= 0 and snd != "fraggrenadehit" and snd != "semtexhit" and snd != "planebombhit" and snd != "bunkerbombhit" and snd != "bombvesthit" and snd != "smokebombhit")
check_vehicle_damage_from_bullet(sx, sy, sz, 3, 100, 150);
}
}
else if(parsed[0]=="distsound" and parsed.length()>5)
{
string soundname=parsed[1];
int x=string_to_number(parsed[2]);
int y=string_to_number(parsed[3]);
int z=string_to_number(parsed[4]);
string soundmap=parsed[5];
if(soundmap==mapname)
distpool.play_3d(soundname, me.x, me.y, me.z, x, y, z, facing,false);
}
}
if (e.channel==1)
{
p.play_stationary("chat.ogg", false);
add_buffer_item("chats",get_event_message());
}
if(e.channel==6)
{
p.play_stationary("mapchat.ogg",false);add_buffer_item("chats",get_event_message());
}
if(e.channel==4)
{
string[] parsed=string_split(get_event_message(), " ", true);
if(parsed[0]=="csh" and parsed.length()>1)
{
int client_side=n.get_peer_average_round_trip_time(1);
int server_side=string_to_number(parsed[1]);
if(gametracktimer.elapsed>10000)
{
if(sph_timer.elapsed>2400+server_side)
{
sph_tries++;
if(sph_tries>4)
kill_speedhack();
}
else
{
sph_tries=0;
}
sph_timer.restart();
}
}
}
if (e.channel==2)
{
string ch2msg=get_event_message();
remember_pm_sender(ch2msg);
if(string_contains(ch2msg,"Team: ",1)==0)p.play_stationary("teamchat.ogg",false);
if(string_contains(ch2msg,"team_translocator_state|",1)==0)receive_team_translocator_state(ch2msg);
else if(string_contains(ch2msg,"team_translocator_go|",1)==0)receive_team_translocator_go(ch2msg);
else if (string_contains(ch2msg,"team_state|",1)==0)
receive_team_state(ch2msg);
else if (string_contains(ch2msg, "New support ticket", 1)>=0 or string_contains(ch2msg, "ticket", 1)>=0)
add_buffer_item("tickets",ch2msg);
else
add_buffer_item("misc",ch2msg);
}
if(e.channel==7)
{
string voice_packet=get_event_message();
if(string_contains(voice_packet,"voice_data ",1)==0) voice_receive_frame(voice_packet);
}
}
// Bound the amount of queued traffic handled per call. Recursive calls skip
// periodic audio service so packet bursts cannot multiply unrelated work.
if(e.type==event_receive and client_network_drain_depth<31)
{
client_network_drain_depth++;
netloop(false);
client_network_drain_depth--;
}
}
void exitgame()
{
p.play_stationary("modeleave.ogg",false);
if (auto_log_buffers)
auto_export_buffers();
plane.stop();
pinging=false;
destroy_all_sources();
distpool.destroy_all();
p.destroy_all();
sources.resize(0);
inv.delete_all();
can_move=true;
jumping=false;
falling=false;
in_vehicle=false;
afk_mode=false;
afk_transitioning=false;
lobby();
}
bool is_sound_number(string t)
{
t=string_replace(t, ".", "", true);
t=string_replace(t, "-", "", true);
if(string_is_digits(t))
return true;
return false;
}
void fallloop()
{
if(jumptimer.elapsed > 8 and jumping==true)
{
double dt=double(jumptimer.elapsed)/1000.0;jumptimer.restart();if(dt>.05)dt=.05;
double gravity=9.81*(1.0+total_equipment_weight()/300.0);jump_vertical_velocity-=gravity*dt;jump_vertical_position+=jump_vertical_velocity*dt;jumpup=jump_vertical_velocity>0?1:0;
int target_z=int(floor(jump_vertical_position));bool changed=false;
while(target_z>me.z)
{
string above=get_tile_at(mr.x,mr.y,me.z+1);if(above!="" and above!="blank"){jump_vertical_velocity=-absolute(jump_vertical_velocity)*.2;jump_vertical_position=me.z;break;}
me.z++;changed=true;checkzone();
}
while(target_z<me.z)
{
me.z--;changed=true;checkzone();string tile=get_tile_at(mr.x,mr.y,me.z);
if(tile!="" and tile!="blank"){jump_vertical_position=me.z;jump_vertical_velocity=0;p.play_stationary(tile+"land.ogg",false);send_reliable(1,"land",0);jumping=false;break;}
}
if(changed)send_reliable(1,"move_to_a "+me.x+" "+me.y+" "+me.z,0);
if(jumping and jump_vertical_velocity<0 and me.z<=jumplandz)
{
string tile=get_tile_at(mr.x,mr.y,me.z);if(tile=="" or tile=="blank"){falling=true;falldistance=0;falltimer.restart();jumping=false;}else{p.play_stationary(tile+"land.ogg",false);send_reliable(0,"land",0);jumping=false;}
}
}
}
void fallcheck()
{
string fall_tile=get_tile_at(mr.x, mr.y, me.z);
if(in_plane==false and falling==false and jumping==false and (fall_tile=="" or fall_tile=="blank"))
{
falling=true;
falldistance=0;
falltimer.restart();
p.play_stationary("fall.ogg", false);
send_reliable(1, "fall", 0);
}
}
void fallingloop()
{
if(falling==true and falltimer.elapsed > falltime and in_plane==false)
{
if(get_tile_at(mr.x, mr.y, me.z)!="" and get_tile_at(mr.x, mr.y, me.z)!="blank")
{
falling=false;
if(falldistance < 10)
{
p.play_stationary(get_tile_at(mr.x, mr.y, me.z)+"land.ogg", false);
send_reliable(1, "land", 0);
}
else
{
p.play_stationary(get_tile_at(mr.x, mr.y, me.z)+"fall.ogg", false);
p.play_stationary("playerhit"+random(1, 6)+".ogg", false);
send_reliable(1, "hardland "+falldistance, 0);
}
return;
}
falltimer.restart();
falldistance++;
me.z--;
checkzone();
send_reliable(1, "move_to_a "+me.x+" "+me.y+" "+me.z, 0);
}
}
void mainloop()
{
process_fullscreen_shortcut();
ammocheatloop();
reload_loop_all();
sourcecheckloop();
stamina_loop();
vehicle_loop();
grenade_cook_loop();
int heal_tick = effects_loop();
if (heal_tick > 0)
send_reliable(0, "heal " + heal_tick, 0);
p.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
distpool.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
acoustics_loop();
mr.x=round(me.x,0);
mr.y=round(me.y,0);
movetime=walktime;
// Adrenaline Rush halves movement time.
if (has_effect("Adrenaline Rush")) movetime = walktime / 2;
// Stamina affects movement speed gradually when low.
if (stamina < 40) movetime = movetime + (40 - stamina) * 3;
if (sitting) movetime=int(movetime*3.6);
else if(combat_slow_timer.elapsed<combat_slow_duration)movetime=int(double(movetime)*1.75);
else if (shift_is_down() and stamina>0 and weapon_allows_sprint(weapons[w]))
{
// Full stamina reaches a 25 percent speed boost; exhaustion tapers it away.
double sprint_factor=1.0-(double(stamina)/400.0);
movetime=int(double(movetime)*sprint_factor);
}
fallloop();
fallcheck();
fallingloop();
}
string get_location()
{
if (get_zone_at(mr.x,mr.y,me.z)!="")
{
string locate=get_zone_at(mr.x,mr.y,me.z);
return locate+" of "+map_display_name(mapname);
}
else
{
return "uncharted area on "+map_display_name(mapname);
}
}
void playcamera()
{
string dynamic_camera_description=dynamic_map_description_at(camera.x,camera.y,camera.z);
if(dynamic_camera_description!=currentcameratile){currentcameratile=dynamic_camera_description;if(dynamic_camera_description!="")speak(dynamic_camera_description+".");}
if (gct()=="" or gct()=="blank")
{
p.play_3d("cameraair.ogg",me.x,me.y,me.z,camera.x,camera.y,camera.z,calculate_theta(facing), false);
}
for (uint i=0; i<walls.length(); i++)
{
if(camera.x==walls[i].x and camera.y==walls[i].y and camera.z>=walls[i].miniz and camera.z<=walls[i].maxz)
{
p.play_3d("wallwood.ogg",me.x,me.y,me.z,camera.x,camera.y,camera.z,calculate_theta(facing), false);
}
}
for (uint i=0; i<ladders.length(); i++)
{
if(camera.x==ladders[i].x and camera.y==ladders[i].y and camera.z>=ladders[i].miniz and camera.z<=ladders[i].maxz)
{
p.play_3d("ladderstep"+random(1,5)+".ogg",me.x,me.y,me.z,camera.x,camera.y,camera.z,calculate_theta(facing), false);
}
}
if (gct()=="hazard")
{
p.play_3d("camerahazard.ogg",me.x,me.y,me.z,camera.x,camera.y,camera.z,calculate_theta(facing), false);
}
else if (string_contains(gct(),"wall",1)>-1)
{
p.play_extended_3d(gct()+".ogg", me.x, me.y, me.z, camera.x, camera.y, camera.z, calculate_theta(facing), 0, 0, 0, 0, 0,0,false, 0.0, 0.0, 0.0, 200.0);
}
else
{
p.play_extended_3d(gct()+"step"+random(1, 5)+".ogg", me.x, me.y, me.z, camera.x, camera.y, camera.z, calculate_theta(facing), 0, 0, 0, 0, 0,0,false, 0.0, 0.0, 0.0, 200.0);
}
}
void kill_speedhack()
{
send_reliable(1, "speedhacked", 0);
exit();
}
void death()
{
turn=90;
plane.stop();
timer dietimer;
timer respawntimer;
bool can_respawn=false;
respawntimer.restart();
dietimer.restart();
while(true)
{
wait(5);
netloop();
mainloop();
if(respawntimer.elapsed>=2000 and can_respawn==false)
{
can_respawn=true;
respawntimer.restart();
speak("You have been killed. Press enter to return to the lobby.");
}
if(can_respawn==true)
{
if(key_pressed(kb("move_left")) or key_pressed(kb("move_right")) or key_pressed(kb("move_forward")) or key_pressed(kb("move_backward")))
{
speak("Press enter to return to the lobby.");
}
if(key_pressed(kb("use_item")) or dietimer.elapsed>=45000)
{
p.play_stationary("death_return_to_lobby.ogg",false);
send_reliable(0, "player_remove", 0);
mapname="main";
inv.delete_all();
destroy_all_sources();
distpool.destroy_all();
p.destroy_all();
sources.resize(0);
can_move=true;
jumping=false;
falling=false;
in_vehicle=false;
lobby();
return;
}
 }
}
}
void playertrackmenu(string[] players)
{
iw_form f;
f.create_window("Tracking", false, true);
int f_list=f.create_list("Select a player to track", 0, false);
f.add_list_item(f_list, "Stop tracking");
for(uint i=1; i<players.length(); i++)
f.add_list_item(f_list, players[i]);
int f_track=f.create_button("&Track", true);
int f_cancel=f.create_button("&Cancel", false, true);
f.focus(f_list);
while(true)
{
wait(5);
f.monitor();
netloop();
fallloop();
if (f.is_pressed(f_track))
{
int sel=f.get_list_position(f_list);
if(sel==0)
{
p.play_stationary("modeleave.ogg", false);
speak("stopped tracking");
tracking="";
return;
}
else if(sel>0 and sel<int(players.length()))
{
p.play_stationary("trackingnew.ogg", false);
speak("You are now tracking "+players[sel]);
tracking=players[sel];
return;
}
}
if (f.is_pressed(f_cancel))
{
speak("canceled");
tracking="";
return;
}
}
}
void planeloop()
{
send_reliable(0, "i_am_in_plane", 0);
send_reliable(0, "plane_turn "+facing, 0);
in_plane=true;
plane.load("duoplaneinside.ogg");
plane.play_looped();
while(true)
{
mainloop();
netloop();
if((key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT)) and key_pressed(KEY_F1))key_practice_mode();
if (key_pressed(kb("player_list")) and key_up(KEY_LSHIFT) and key_up(KEY_RSHIFT))
{
speak("Fetching player list, please wait.");
string[] plist=fetch_player_list();
show_player_list_form("Players Online", plist);
}
if(key_pressed(kb("ping")) and pinging==false)
{
send_reliable(1, "ping", 0);
p.play_stationary("pingstart.ogg", false);
pingtimer.restart();
pinging=true;
}
if(key_pressed(kb("motd")))
{
send_reliable(0, "motd", 0);
}
if(key_pressed(kb("track_info")) and tracking!="")
{
send_reliable(1, "trackinfo "+tracking, 0);
}
if(key_pressed(kb("menu")) and can_stop==true and get_tile_at(me.x, me.y, me.z)!="" and get_tile_at(me.x, me.y, me.z)!="blank" or go_out==true)
{
go_out=false;
send_reliable(0, "plane_stop", 0);
in_plane=false;
plane.stop();
resume_all_sources();
break;
}
if (key_pressed(kb("health")) and key_up(KEY_LSHIFT))
{
send_reliable(0,"health",0);
}
if(key_pressed(kb("move_backward")) and me.z>=1)
{
send_reliable(0, "go_down", 0);
}
if(key_pressed(kb("move_forward")) and me.z<=74)
{
send_reliable(0, "go_up", 0);
}
if (key_pressed(kb("chat")))
{
string chat=af_input("Enter your message","",true);
if (chat!="")
send_reliable(0,chat,1);
}
if(key_pressed(kb("track_player")))
{
speak("Fetching player list, please wait.");
string[] plist=fetch_player_list();
show_player_list_form("Track Player", plist, true);
}
if(key_pressed(kb("move_left")) or mousex<0 and key_up(KEY_LMENU) and key_up(KEY_RMENU) and turntimer.elapsed >200)
{
turntimer.restart();
facing=snapleft(facing, getdir(facing));
speak(dir_to_string(getdir(facing)));
send_reliable(0, "plane_turn "+facing, 0);
mouse_update();
}
if(key_pressed(kb("move_right")) or mousex>0 and key_up(KEY_LMENU) and key_up(KEY_RMENU) and turntimer.elapsed >200)
{
turntimer.restart();
facing=snapright(facing, getdir(facing));
speak(dir_to_string(getdir(facing)));
send_reliable(0, "plane_turn "+facing, 0);
mouse_update();
}
if(key_pressed(kb("jump")) and get_tile_at(me.x, me.y, me.z)!="" and get_tile_at(me.x, me.y, me.z)!="blank")
{
send_reliable(0, "plane_rem", 0);
p.play_stationary("duoplanerem.ogg",false);
}
if (key_pressed(kb("buffer_left")))
{
if (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT))
{
firstbuffer();
}
else
{
bufferleft();
}
}
if (key_pressed(kb("buffer_right")))
{
if (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT))
{
lastbuffer();
}
else
{
bufferright();
}
}
if (key_pressed(KEY_COMMA))
{
prevbufferitem();
}
if (key_pressed(KEY_PERIOD))
{
nextbufferitem();
}
if ((key_down(KEY_LMENU) or key_down(KEY_RMENU)) and (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT)) and key_pressed(KEY_B))
{
buffer_manage_menu();
}
if ((key_down(KEY_LMENU) or key_down(KEY_RMENU)) and (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT)) and key_pressed(KEY_C))
{
review_buffer_item();
}
chat_channel_shortcuts();
if (key_pressed(KEY_DELETE))
{
buffer_item_action_menu();
}
}
}
