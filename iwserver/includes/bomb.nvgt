void planebombloop()
{
for(int i=int(planebombs.length())-1;i>=0;i--)
{
planebomb@ pb=planebombs[i];
if(pb.bombtimer.elapsed>=80 and get_tile_at(pb.x,pb.y,pb.z,pb.map)==""){pb.bombtimer.restart();pb.z-=1;}
if(get_tile_at(pb.x,pb.y,pb.z,pb.map)=="" and pb.z>0)continue;
// An aircraft bomb: a heavy blast and a steel case that shatters.
blast_profile@ b=blast_profile_simple(pb.owner,pb.owner+"'s aircraft bomb",950,20,2600,"planebombexplode","planebombdist.ogg","planebombhit");
planebombs.remove_at(i);
detonate(pb.x,pb.y,pb.z+.3,pb.map,b);
}
}
