// Dynamic objects: everything placed in a map that is not part of its walls
// and floors -- furniture, vending machines, doors, parked cars, trees, fuel
// barrels, charging stations. Shared by the client and the server.
//
// What an object is comes from its type file, content/objects/*/<id>.object
// (key=value lines; see content/objects/README.txt): its name and
// description, its shape and material, whether and how it can be destroyed,
// what it becomes or sets off when it is, and what using it does. A map
// places objects with
//
//   dobject:<type>:<x>:<y>:<z>:<facing>:<label>
//
// and authored furniture with its own geometry with object:/objectpart:
// lines. The older fixture:<type>:<x>:<y>:<z>:<label> lines still load.
//
// Both the client and the server build the same objects, with the same ids,
// from the same map file, so only state changes (damage, a door opening,
// stock, destruction) travel over the network.
//
// 0.6 replaced two systems with this one: "world objects", destructible
// furniture that could not be used for anything, and the Executioner's Rage
// "fixtures", usable things whose every behaviour was a hard-coded branch
// keyed on a type name, with no geometry of their own beyond a fixed box.

class dobject_part
{
double x1,x2,y1,y2,z1,z2;
string material;
bool solid;
dobject_part(){}
dobject_part(double a,double b,double c,double d,double e,double f,string m,bool s){x1=a;x2=b;y1=c;y2=d;z1=e;z2=f;material=m;solid=s;}
bool contains(double x,double y,double z){return x>=x1 and x<=x2 and y>=y1 and y<=y2 and z>=z1 and z<=z2;}
}
class dobject_offer
{
string item,sound;int price;
dobject_offer(string i,int p,string s){item=i;price=p;sound=s;}
}
class dobject_type
{
string id,name,description,category,material="wallmetal",interaction="",sound="",contact_sound="collide",destroy_sound="dest",debris="",item="";
string[] loot;
double length=1,width=1,height=1.8,bullet_factor=1,blast_factor=1;
bool solid=true,loot_on_destroy=false;
int health=0,impact_sounds=0,respawn_ms=900000,stock=0,restock_ms=0,cooldown_ms=1000,heal=0,heal_ceiling=0,stamina=0,burn_ms=0,charge_rate=0;
dobject_part@[] parts;
dobject_offer@[] offers;
// An explosion when it is destroyed (fuel barrels, cars).
int explode_damage=0,explode_fragments=0,explode_cloud_ms=0;double explode_radius=0,explode_cloud_radius=0;string explode_payload="",explode_sound="",explode_distant="";
bool destructible(){return health>0;}
}
dictionary dobject_types;
dobject_type@ dobject_type_of(const string &in id){dobject_type@ t=null;dobject_types.get(id,@t);return t;}

double dobject_number(const string &in v,double fallback){return v==""?fallback:string_to_number(v);}
dobject_type@ parse_dobject_type(const string &in id,const string &in text)
{
dobject_type t;t.id=id;t.name=string_replace(id,"_"," ",true);
string[] lines=string_split(string_replace(text,"\r","",true),"\n",false);
for(uint i=0;i<lines.length();i++)
{
string line=lines[i].trim_whitespace();if(line=="" or line.substr(0,1)=="#")continue;
int eq=line.find("=");if(eq<=0)continue;
string k=line.substr(0,eq).trim_whitespace(),v=line.substr(eq+1).trim_whitespace();
if(k=="name")t.name=v;else if(k=="description")t.description=v;else if(k=="category")t.category=v;
else if(k=="material")t.material=v;else if(k=="interaction")t.interaction=v;else if(k=="sound")t.sound=v;
else if(k=="contact_sound")t.contact_sound=v;else if(k=="destroy_sound")t.destroy_sound=v;else if(k=="debris")t.debris=v;else if(k=="item")t.item=v;
else if(k=="loot")t.loot=string_split(v,",",false);
else if(k=="length")t.length=dobject_number(v,1);else if(k=="width")t.width=dobject_number(v,1);else if(k=="height")t.height=dobject_number(v,1.8);
else if(k=="bullet_factor")t.bullet_factor=dobject_number(v,1);else if(k=="blast_factor")t.blast_factor=dobject_number(v,1);
else if(k=="solid")t.solid=v=="true";else if(k=="loot_on_destroy")t.loot_on_destroy=v=="true";
else if(k=="health")t.health=int(dobject_number(v,0));else if(k=="impact_sounds")t.impact_sounds=int(dobject_number(v,0));
else if(k=="respawn_ms")t.respawn_ms=int(dobject_number(v,900000));else if(k=="stock")t.stock=int(dobject_number(v,0));
else if(k=="restock_ms")t.restock_ms=int(dobject_number(v,0));else if(k=="cooldown_ms")t.cooldown_ms=int(dobject_number(v,1000));
else if(k=="heal")t.heal=int(dobject_number(v,0));else if(k=="heal_ceiling")t.heal_ceiling=int(dobject_number(v,0));
else if(k=="stamina")t.stamina=int(dobject_number(v,0));else if(k=="burn_ms")t.burn_ms=int(dobject_number(v,0));else if(k=="charge_rate")t.charge_rate=int(dobject_number(v,0));
else if(k=="explode_damage")t.explode_damage=int(dobject_number(v,0));else if(k=="explode_radius")t.explode_radius=dobject_number(v,0);
else if(k=="explode_fragments")t.explode_fragments=int(dobject_number(v,0));else if(k=="explode_payload")t.explode_payload=v;
else if(k=="explode_cloud_ms")t.explode_cloud_ms=int(dobject_number(v,0));else if(k=="explode_cloud_radius")t.explode_cloud_radius=dobject_number(v,0);
else if(k=="explode_sound")t.explode_sound=v;else if(k=="explode_distant")t.explode_distant=v;
else if(k=="offer")
{
// offer=item:price:sound
string[] f=string_split(v,":",false);if(f.length()>=2)t.offers.insert_last(dobject_offer(f[0].trim_whitespace(),int(string_to_number(f[1])),f.length()>2?f[2].trim_whitespace():""));
}
else if(k=="part")
{
// part=x1,x2,y1,y2,z1,z2,material,solid -- relative to the object's centre
// on the ground, before turning it to face its placement.
string[] f=string_split(v,",",false);if(f.length()<8)continue;
t.parts.insert_last(dobject_part(string_to_number(f[0]),string_to_number(f[1]),string_to_number(f[2]),string_to_number(f[3]),string_to_number(f[4]),string_to_number(f[5]),f[6].trim_whitespace(),f[7].trim_whitespace()=="1" or f[7].trim_whitespace()=="true"));
}
}
if(t.parts.length()==0)t.parts.insert_last(dobject_part(-t.length*.5,t.length*.5,-t.width*.5,t.width*.5,0,t.height,t.material,t.solid));
return t;
}
// The object type folder: beside the server, or inside the client's copy.
string dobject_data_directory()
{
if(directory_exists("iwserver/content/objects"))return "iwserver/content/objects";
if(directory_exists("content/objects"))return "content/objects";
return "";
}
// Loads every type under a folder (and its subfolders). Returns how many.
int load_dobject_types(const string &in folder)
{
if(folder=="")return 0;
int loaded=0;
string[] files=find_files(folder+"/*.object");
for(uint i=0;i<files.length();i++)
{
file f;if(!f.open(folder+"/"+files[i],"rb"))continue;string text=f.read();f.close();
string id=files[i].substr(0,files[i].length()-7);
dobject_types.set(id,@parse_dobject_type(id,text));loaded++;
}
string[] dirs=find_directories(folder+"/*");
for(uint i=0;i<dirs.length();i++)loaded+=load_dobject_types(folder+"/"+dirs[i]);
return loaded;
}
// The authored furniture type: shape and sounds come from the map itself.
dobject_type@ dobject_furniture_type()
{
dobject_type@ t=dobject_type_of("furniture");if(t !is null)return t;
dobject_type f;f.id="furniture";f.name="furniture";f.category="furniture";f.respawn_ms=0;dobject_types.set("furniture",@f);return f;
}

class dobject
{
int id;
string type_id,origin_type,map,label,name;
dobject_type@ type;
double x,y,z;
int facing=0;
int health,max_health,stock,max_stock;
bool active=true,open=false,on=true,burning=false;
double bullet_factor=1,blast_factor=1;
string hit_sound,break_sound; // authored furniture's own sounds
dobject_part@[] parts;        // world-space geometry
double bx1=1e9,bx2=-1e9,by1=1e9,by2=-1e9,bz1=1e9,bz2=-1e9;
int element=-1;               // the client's dynamic map element
timer use_timer,restock_timer,respawn_timer,burn_timer,impact_timer;
string describe(){return name!=""?name:(label!=""?label:type.name);}
// Turns this object into another type in place (a car into a burnt-out
// shell, and back again when it is replaced).
void become(const string &in id)
{
dobject_type@ t=dobject_type_of(id);if(t is null)return;
type_id=id;@type=t;health=t.health;max_health=t.health;stock=t.stock;max_stock=t.stock;bullet_factor=t.bullet_factor;blast_factor=t.blast_factor;open=false;burning=false;on=true;
if(id!="furniture")build_from_type();
}
// State that is not the map's default, packed for the network:
// id,health,flags,stock,type. Flags: 1 active, 2 open, 4 on, 8 burning.
int flags(){return (active?1:0)+(open?2:0)+(on?4:0)+(burning?8:0);}
string state(){return id+","+health+","+flags()+","+stock+","+type_id;}
bool is_default(){return active and !open and !burning and on and health==max_health and stock==max_stock and type_id==origin_type;}
void apply_state(int h,int f,int s,const string &in t)
{
if(t!=type_id)become(t);
health=h;active=(f&1)!=0;open=(f&2)!=0;on=(f&4)!=0;burning=(f&8)!=0;stock=s;
}
void add_part(dobject_part@ p)
{
parts.insert_last(p);
if(p.x1<bx1)bx1=p.x1;if(p.x2>bx2)bx2=p.x2;if(p.y1<by1)by1=p.y1;if(p.y2>by2)by2=p.y2;if(p.z1<bz1)bz1=p.z1;if(p.z2>bz2)bz2=p.z2;
}
// Places the type's parts in the world at this object's position, turned to
// its facing (a multiple of 90 degrees).
void build_from_type()
{
parts.resize(0);bx1=1e9;bx2=-1e9;by1=1e9;by2=-1e9;bz1=1e9;bz2=-1e9;
int turn=((facing%360)+360)%360/90;
for(uint i=0;i<type.parts.length();i++)
{
dobject_part@ s=type.parts[i];double a=s.x1,b=s.x2,c=s.y1,d=s.y2;
if(turn==1){a=s.y1;b=s.y2;c=-s.x2;d=-s.x1;}
else if(turn==2){a=-s.x2;b=-s.x1;c=-s.y2;d=-s.y1;}
else if(turn==3){a=-s.y2;b=-s.y1;c=s.x1;d=s.x2;}
add_part(dobject_part(x+a,x+b,y+c,y+d,z+s.z1,z+s.z2,s.material,s.solid));
}
}
bool solid_now(dobject_part@ p){return p.solid and !open;}
bool near_bounds(double px,double py,double pz,double margin=0){return px>=bx1-margin and px<=bx2+margin and py>=by1-margin and py<=by2+margin and pz>=bz1-margin and pz<=bz2+margin;}
// The material at a point: solid parts first, then anything walkable on top.
string tile_at(double px,double py,double pz)
{
if(!active or !near_bounds(px,py,pz))return "";
// Solid parts win; a walkable part (a seat, a tabletop) comes next. An open
// door's leaf is neither: the doorway is simply passable.
for(int i=int(parts.length())-1;i>=0;i--)if(solid_now(parts[i]) and parts[i].contains(px,py,pz))return parts[i].material;
for(int i=int(parts.length())-1;i>=0;i--)if(!parts[i].solid and parts[i].contains(px,py,pz))return parts[i].material;
return "";
}
bool solid_at(double px,double py,double pz)
{
if(!active or !near_bounds(px,py,pz))return false;
for(uint i=0;i<parts.length();i++)if(solid_now(parts[i]) and parts[i].contains(px,py,pz))return true;return false;
}
// Distance from a point to the nearest edge of the object, on the ground plane.
double distance_to(double px,double py)
{
double dx=px<bx1?bx1-px:(px>bx2?px-bx2:0),dy=py<by1?by1-py:(py>by2?py-by2:0);return sqrt(dx*dx+dy*dy);
}
double centre_x(){return (bx1+bx2)*.5;}
double centre_y(){return (by1+by2)*.5;}
}

dobject@ new_dobject(int id,const string &in type_id,double x,double y,double z,int facing,const string &in map,const string &in label)
{
dobject_type@ t=dobject_type_of(type_id);if(t is null)return null;
dobject o;o.id=id;o.type_id=type_id;o.origin_type=type_id;@o.type=t;o.x=x;o.y=y;o.z=z;o.facing=facing;o.map=map;o.label=label;
o.health=t.health;o.max_health=t.health;o.max_stock=t.stock;o.stock=t.stock;o.bullet_factor=t.bullet_factor;o.blast_factor=t.blast_factor;
o.on=true;o.build_from_type();return o;
}

// Every object a map file places, with stable ids: authored furniture keeps
// the id its object: line gives it; placed objects are numbered from 100000
// in the order they appear.
dobject@[] parse_map_dobjects(const string &in raw,const string &in map)
{
dobject@[] result;dictionary furniture;
string[] lines=string_split(string_replace(raw,"\r","",true),"\n",false);
int placed=100000;
for(uint i=0;i<lines.length();i++)
{
string[] p=string_split(lines[i],":",false);if(p.length()<2)continue;
if(p[0]=="object" and p.length()==8)
{
int id=int(string_to_number(p[1])),health=int(string_to_number(p[2]));if(id<1 or health<1 or furniture.exists(""+id))continue;
dobject o;o.id=id;o.type_id="furniture";o.origin_type="furniture";@o.type=dobject_furniture_type();o.map=map;o.health=health;o.max_health=health;
o.bullet_factor=string_to_number(p[3]);o.blast_factor=string_to_number(p[4]);if(o.bullet_factor<=0 or o.blast_factor<=0)continue;
o.hit_sound=p[5];o.break_sound=p[6];o.name=p[7];
furniture.set(""+id,int(result.length()));result.insert_last(o);
}
else if(p[0]=="objectpart" and p.length()==10)
{
int at;if(!furniture.get(""+int(string_to_number(p[1])),at))continue;dobject@ o=result[at];
dobject_part part(string_to_number(p[2]),string_to_number(p[3]),string_to_number(p[4]),string_to_number(p[5]),string_to_number(p[6]),string_to_number(p[7]),p[8],p[9]=="1");
if(part.x1>part.x2 or part.y1>part.y2 or part.z1>part.z2)continue;
o.add_part(part);o.x=o.centre_x();o.y=o.centre_y();if(o.bz1<1e8)o.z=o.bz1;
}
else if(p[0]=="dobject" and p.length()>=7)
{
dobject@ o=new_dobject(placed++,p[1],string_to_number(p[2]),string_to_number(p[3]),string_to_number(p[4]),int(string_to_number(p[5])),map,p[6]);if(o !is null)result.insert_last(o);
}
else if(p[0]=="fixture" and p.length()>=6)
{
dobject@ o=new_dobject(placed++,p[1],string_to_number(p[2]),string_to_number(p[3]),string_to_number(p[4]),0,map,p[5]);if(o !is null)result.insert_last(o);
}
}
// Furniture with no geometry is dropped, as before.
for(int i=int(result.length())-1;i>=0;i--)if(result[i].parts.length()==0)result.remove_at(i);
return result;
}

// A set of objects on one map, bucketed on an 8-tile grid so a point lookup
// only tests the few objects near it.
class dobject_set
{
string map;
dobject@[] list;
dictionary grid;
dictionary by_id;
void index()
{
grid.delete_all();by_id.delete_all();
for(uint i=0;i<list.length();i++)
{
dobject@ o=list[i];by_id.set(""+o.id,int(i));
for(int cx=int(floor(o.bx1/8));cx<=int(floor(o.bx2/8));cx++)for(int cy=int(floor(o.by1/8));cy<=int(floor(o.by2/8));cy++)
{
string key=cx+","+cy;int[]@ bucket=null;if(!grid.get(key,@bucket)){int[] fresh;@bucket=fresh;grid.set(key,@bucket);}bucket.insert_last(int(i));
}
}
}
dobject@ find(int id){int at;if(!by_id.get(""+id,at))return null;return list[at];}
int[]@ near(double x,double y){int[]@ bucket=null;grid.get(int(floor(x/8))+","+int(floor(y/8)),@bucket);return bucket;}
string tile_at(double x,double y,double z)
{
int[]@ b=near(x,y);if(b is null)return "";
for(int i=int(b.length())-1;i>=0;i--){string t=list[b[i]].tile_at(x,y,z);if(t!="")return t;}
return "";
}
bool solid_at(double x,double y,double z)
{
int[]@ b=near(x,y);if(b is null)return false;
for(uint i=0;i<b.length();i++)if(list[b[i]].solid_at(x,y,z))return true;return false;
}
// The object at a point, solid or not; null if none.
dobject@ at(double x,double y,double z)
{
int[]@ b=near(x,y);if(b is null)return null;
for(int i=int(b.length())-1;i>=0;i--){dobject@ o=list[b[i]];if(o.active and o.tile_at(x,y,z)!="")return o;}
return null;
}
}
