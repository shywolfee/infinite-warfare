for (uint i2=0; i2<planes.length() and destructive; i2++)
{
double plane_scale=blast_falloff(get_3d_distance(fraggrenades[i].x,fraggrenades[i].y,fraggrenades[i].z,planes[i2].x,planes[i2].y,planes[i2].z),fraggrenades[i].radius);
if (plane_scale>0 and planes[i2].map==fraggrenades[i].map)
{
if(owner_index>-1)send_reliable(players[owner_index].peer_id, "play_s weaponping.ogg", 0);
planes[i2].health-=int(double(fraggrenades[i].damage)*plane_scale);
play("duoplanebombhit",planes[i2].x,planes[i2].y,planes[i2].z,planes[i2].map);
}
}
for(uint vi=0;vi<authoritative_vehicles.length() and destructive;vi++)
{
authoritative_vehicle@ vehicle=authoritative_vehicles[vi];if(vehicle.map!=fraggrenades[i].map or vehicle.health<=0)continue;double vehicle_distance=get_3d_distance(fraggrenades[i].x,fraggrenades[i].y,fraggrenades[i].z,vehicle.model_x,vehicle.model_y,vehicle.model_z);if(vehicle_distance>fraggrenades[i].radius)continue;int vehicle_damage=int(double(fraggrenades[i].damage)*(1.0-vehicle_distance/double(fraggrenades[i].radius)*.6));if(fraggrenades[i].kind=="carrier_missile")vehicle_damage=int(vehicle_damage*1.65);else if(fraggrenades[i].kind=="conventional_guided_missile")vehicle_damage=int(vehicle_damage*1.3);if(vehicle.id==fraggrenades[i].inside_vehicle)vehicle_damage=fraggrenades[i].damage*2;damage_authoritative_vehicle(vehicle,vehicle_damage,-1,vehicle.id==fraggrenades[i].inside_vehicle?"blown apart from inside":"caught in a grenade blast");
}
