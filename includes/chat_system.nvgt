string[] client_chat_language_ids={"english","spanish","french","german","italian","portuguese","dutch","polish","russian","ukrainian","czech","slovak","hungarian","romanian","bulgarian","greek","turkish","arabic","hebrew","persian","hindi","bengali","punjabi","urdu","tamil","telugu","marathi","gujarati","chinese","japanese","korean","vietnamese","thai","indonesian","malay","filipino","swahili","afrikaans","danish","swedish","unfiltered"};
string[] client_chat_language_names={"English","Spanish","French","German","Italian","Portuguese","Dutch","Polish","Russian","Ukrainian","Czech","Slovak","Hungarian","Romanian","Bulgarian","Greek","Turkish","Arabic","Hebrew","Persian","Hindi","Bengali","Punjabi","Urdu","Tamil","Telugu","Marathi","Gujarati","Chinese","Japanese","Korean","Vietnamese","Thai","Indonesian","Malay","Filipino","Swahili","Afrikaans","Danish","Swedish","Unfiltered"};
uint64[] client_chat_ids;string[] client_chat_buffers;string[] client_chat_rendered;
string chat_unescape(string value){value=string_replace(value,"%0A","\n",true);value=string_replace(value,"%0D","\r",true);value=string_replace(value,"%7C","|",true);return string_replace(value,"%25","%",true);}
void remove_chat_rendered(string buffer_name,string rendered){for(uint b=0;b<buffers.length();b++)if(buffers[b].name==buffer_name or buffers[b].name=="all")for(int i=int(buffers[b].items.length())-1;i>=0;i--)if(buffers[b].items[i]==rendered){buffers[b].items.remove_at(i);if(buffers[b].pos>=int(buffers[b].items.length()))buffers[b].pos=int(buffers[b].items.length())-1;break;}}
bool handle_chat_protocol(string message)
{
if(string_contains(message,"chat_event|",1)==0){string[] fields=string_split(message,"|",false);if(fields.length()<6)return true;uint64 id=string_to_number(fields[1]);string scope=chat_unescape(fields[2]),sender=chat_unescape(fields[3]),body=chat_unescape(fields[4]),stamp=chat_unescape(fields[5]);string buffer_name="chats",sound_file="chat.ogg";if(string_contains(scope,"language:",1)==0){string language=string_replace(scope,"language:","",false);buffer_name="language: "+string_replace(language,"_"," ",true);}else if(string_contains(scope,"group:",1)==0){buffer_name="group: "+string_replace(scope,"group:","",false);sound_file="teamchat.ogg";}else if(string_contains(scope,"map:",1)==0){buffer_name="map chat";sound_file="mapchat.ogg";}else if(string_contains(scope,"pm:",1)==0){buffer_name="private: "+sender;sound_file="pm.ogg";remember_pm_sender("pm from "+sender+": "+body);}if(!buffer_exist(buffer_name))create_buffer(buffer_name,sound_file);string rendered=sender+": "+body+(show_chat_timestamps?" ["+stamp+"]":"");add_buffer_item(buffer_name,rendered,sound_file);client_chat_ids.insert_last(id);client_chat_buffers.insert_last(buffer_name);client_chat_rendered.insert_last(rendered);if(client_chat_ids.length()>500){client_chat_ids.remove_at(0);client_chat_buffers.remove_at(0);client_chat_rendered.remove_at(0);}return true;}if(string_contains(message,"chat_withdraw|",1)==0){string[] fields=string_split(message,"|",false);if(fields.length()>1){uint64 id=string_to_number(fields[1]);for(int i=int(client_chat_ids.length())-1;i>=0;i--)if(client_chat_ids[i]==id){remove_chat_rendered(client_chat_buffers[i],client_chat_rendered[i]);add_buffer_item(client_chat_buffers[i],"A message was withdrawn.");client_chat_ids.remove_at(i);client_chat_buffers.remove_at(i);client_chat_rendered.remove_at(i);break;}}return true;}return false;
}
void language_channel_form(){nv_form f;f.create_window("Language channel",false,true);nv_form_list_box@ list=f.add_list("Forty language channels and unfiltered","channels");for(uint i=0;i<client_chat_language_names.length();i++)list.add(client_chat_language_names[i],client_chat_language_ids[i]);nv_form_button@ choose=f.add_button("Switch channel","choose",true);nv_form_button@ cancel=f.add_button("Cancel","cancel",false,true);f.focus_control(list);while(true){wait(5);f.monitor();if(connected)netloop();if(f.is_pressed(cancel))return;if(f.is_pressed(choose)){int pos=list.list_position;if(pos>=0 and pos<int(client_chat_language_ids.length()))send_reliable(0,"/channel "+client_chat_language_ids[pos],1);return;}}}
void player_report_form(){string target=af_input("Player to report","",true).trim_whitespace();if(target=="")return;string reason=af_input("Reason for reporting "+target,"",true).trim_whitespace();if(reason==""){speak("A report needs a reason.");return;}send_reliable(0,"/report "+target+" "+reason,1);}
bool handle_local_chat_form_command(string text){string lower=string_to_lower_case(text.trim_whitespace());if(lower=="/channel"){language_channel_form();return true;}if(lower=="/report"){player_report_form();return true;}return false;}
