class nv_form_slider: nv_form_control {
	double min_value, max_value, step, page, value;
	dictionary text;
	nv_form_slider(nv_form@parent, const string &in caption, const string &in id = "", double min_value = 0, double max_value = 100, double step = 1, double initial_value = 0, double page = 0) {
		super(caption, id, nv_form_ct_slider, @parent);
		this.min_value = min_value;
		this.max_value = max_value;
		this.step = step;
		this.page = page;
		value = initial_value;
		if (this.page <= 0) this.page = this.step * 10;
		clamp_value();
	}
	void clamp_value() {
		value = clamp(value, min_value, max_value);
	}
	string get_text(double value, const string &in def = "") const {
		string v;
		if (!text.get(value, v)) return def;
		if (v == "" && def != "") v = def;
		return v;
	}
	void set_text(double value, const string &in text) {
		this.text.set(value, text);
	}
	string get_text_value() const property {
		return get_text(value, value);
	}
	// Up and Right raise the value, Down and Left lower it, Page Up and Page
	// Down move a page, Home and End go to the ends. The old binding had Down
	// raising it, left over from sliders being used to pick maps from a list,
	// which made every volume control in the game work upside down.
	private bool nudge(double delta) {
		double previous = value;
		value += delta;
		clamp_value();
		nv_form_cue(value != previous ? "slider" : "edge");
		speak(text_value);
		return true;
	}
	bool handle_input() {
		if (key_repeating(KEY_UP) || key_repeating(KEY_RIGHT)) return nudge(step);
		if (key_repeating(KEY_DOWN) || key_repeating(KEY_LEFT)) return nudge(-step);
		if (key_repeating(KEY_PAGEUP)) return nudge(page);
		if (key_repeating(KEY_PAGEDOWN)) return nudge(-page);
		if (key_repeating(KEY_HOME)) return nudge(min_value - value);
		if (key_repeating(KEY_END)) return nudge(max_value - value);
		return false;
	}
	string get_control_info() {
		return text_value;
	}
}
