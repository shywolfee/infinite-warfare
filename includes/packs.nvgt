void fill_empty_pack()
{
if(get_item_count("empty_pack")<=0){speak("Carry an empty pack first.");return;}
string[] labels,ids;string[] keys=inv.get_keys();
for(uint i=0;i<keys.length();i++){
string item=keys[i];if(item=="empty_pack" or get_item_count(item)<=0 or is_weapon(item))continue;
if(!item_flag(item,"disposable") and item_prop(item,"device_profile")=="" and item.find("shipment_")!=0 and item.find("pack_containing_")!=0)continue;
labels.insert_last(physical_item_name(item)+", "+get_item_count(item)+" carried");ids.insert_last(item);
}
if(ids.length()==0){speak("You have no physical item to put in the pack.");return;}
string item=pick_from_list("Fill an empty pack",labels,ids);if(item=="")return;
string input=af_input("How many "+physical_item_name(item)+"? A pack holds 20 items at most.","1",true);if(input=="")return;
send_reliable(0,"pack fill "+item+" "+input,0);
}
