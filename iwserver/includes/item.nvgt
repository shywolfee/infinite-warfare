item@[] items(0);
class item
{
int x;
string bowner;
int y;
int z;
string owner;
string name;
string map;
timer deltimer;
timer soundtimer;
item(int px, int py, int pz, string imap, string pname,string iowner)
{
bowner=iowner;
map=imap;
x=px;
y=py;
z=pz;
name=pname;
}
}
void itemloop()
{
for(uint i=0; i<items.length(); i++)
{
for(uint x=0; x<players.length(); x++)
{
if(items[i].soundtimer.elapsed>1000)
{
items[i].soundtimer.restart();
play("item", items[i].x, items[i].y, items[i].z, items[i].map, -1, true, false, 5);
}
if(items[i].deltimer.elapsed>180000)
{
items.remove_at(i);
continue;
}
if (get_3d_distance(items[i].x,items[i].y,items[i].z,players[x].x,players[x].y,players[x].z)<=2 and players[x].map==items[i].map and players[x].death==false and items[i].bowner!=players[x].name)
{
play("itemget"+random(1,3), items[i].x, items[i].y, items[i].z, items[i].map, x);
if(items[i].name=="fake.item")
{
apply_player_damage(players[x],5000,"a fake item on the ground");
play("fakeitem",players[x].x,players[x].y,players[x].z,players[x].map,x);
send_reliable(0,"distsound fakeitemdist "+items[i].x+" "+items[i].y+" "+items[i].z+" "+items[i].map,0);
players[x].hitby="a fake item on the ground";
}
else if(string_contains(items[i].name, "ammo_", 1)>-1)
{
string work=string_replace(items[i].name, "ammo_", "", false);
string[] worksplit=string_split(work, "_", false);
string final_weapon=string_replace(worksplit[0], ".", "_", true);
int final_amount=random(string_to_number(worksplit[1]), string_to_number(worksplit[2]));
send_unreliable(players[x].peer_id, "ammogive "+final_weapon+" "+final_amount, 0);
send_reliable(players[x].peer_id, final_amount+" "+final_weapon+" ammunition!", 2);
play("ammoget", items[i].x, items[i].y, items[i].z, items[i].map, -1, true, false, 5);
}
else
{
send_unreliable(players[x].peer_id,"give "+items[i].name+" 1",0);
send_reliable(players[x].peer_id, string_replace(items[i].name,"_"," ",true), 2);
}
items.remove_at(i);
return;
}
}
}
}
void spawn_item(int x, int y, int z, string map, string name,string bowner)
{
item i1(x,y,z,map, name,bowner);
items.insert_last(i1);
}
void move_items_to(int x, int y, int z, string map, int itemcount)
{
int itemgrabs=0;
for(uint i=0; i<items.length(); i++)
{
if(items[i].map==map and items[i].name!="item_grabber")
{
items[i].x=x;
items[i].y=y;
items[i].z=z;
itemgrabs++;
}
if(itemgrabs>itemcount) break;
}
}

void give_random_weapon_maintenance_bundle(int player_index)
{
if(player_index<0 or player_index>=int(players.length()))return;int kind=random(0,8);string[] grants;
if(kind==0)grants={"handgun_cleaning_kit 1","chamber_brush 3","action_lubricant 3"};
else if(kind==1)grants={"rifle_field_tool 1","carbon_scraper 3","action_lubricant 3"};
else if(kind==2)grants={"precision_bore_guide 1","copper_fouling_solvent 3","precision_cleaning_patches 5"};
else if(kind==3)grants={"shotgun_cleaning_rod 1","shotgun_bore_swab 4","action_lubricant 3"};
else if(kind==4)grants={"barrel_wrench 1","heat_resistant_gloves 1","spare_machine_gun_barrel 2"};
else if(kind==5)grants={"emitter_service_key 1","thermal_vent_cartridge 3","dielectric_coolant 3"};
else if(kind==6)grants={"fuel_system_wrench 1","burner_nozzle_cleaner 3","pressure_seal_kit 3"};
else if(kind==7)grants={"drive_service_tool 1","chain_lubricant 3","motor_coolant 3"};
else grants={"field_honing_stone 1","blade_oil 3","rust_remover 3","weapon_inspection_gauge 1","grip_repair_wrap 3","fastener_compound 3"};
for(uint i=0;i<grants.length();i++)send_reliable(players[player_index].peer_id,"give "+grants[i],0);
send_reliable(players[player_index].peer_id,"The container included a "+(kind==0?"handgun":kind==1?"rifle":kind==2?"precision rifle":kind==3?"shotgun":kind==4?"machine gun":kind==5?"energy weapon":kind==6?"fuel weapon":kind==7?"powered tool":"melee weapon")+" maintenance bundle.",2);
}

void give_random_equipment_service_bundle(int player_index)
{
if(player_index<0 or player_index>=int(players.length()))return;int kind=random(0,7);string[] grants;
if(kind==0)grants={"soft_armor_patch 2","kevlar_weave_patch 2","aramid_repair_tape 2"};else if(kind==1)grants={"plate_carrier_patch 2","ballistic_helmet_patch 1","ceramic_plate_epoxy 2"};else if(kind==2)grants={"heavy_plate_patch 1","heavy_arm_patch 1","armor_rivet_pack 2"};
else if(kind==3)grants={"gasoline_can 2","empty_fuel_can 1","vehicle_siphon_hose 1"};else if(kind==4)grants={"diesel_can 2","engine_oil 2","vehicle_oil_filter 1"};else if(kind==5)grants={"aviation_fuel_can 2","engine_coolant 2","cooling_system_tester 1"};else if(kind==6)grants={"vehicle_jack 1","tire_patch_kit 2","transmission_fluid 2"};else grants={"fuel_drain_pan 1","fuel_system_flush 2","vehicle_engine_service_kit 1"};
for(uint i=0;i<grants.length();i++)send_reliable(players[player_index].peer_id,"give "+grants[i],0);send_reliable(players[player_index].peer_id,"The container included "+(kind<3?"armour patching supplies.":"vehicle workshop supplies."),2);
}
