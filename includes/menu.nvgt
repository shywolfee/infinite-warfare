dynamic_menu_pro m;
void classic_mainmenu()
{
setupmenu(true,true);
iw_form f; f.create_window("Main Menu",false,true);
int connect_btn=f.create_button("Connect to the server and enter the lobby",true);
int register_btn=-1;
if(name=="" or !account_exists(name)) register_btn=f.create_button("Register a new account");
int account_btn=f.create_button("Account management");
int options_btn=f.create_button("Options");
int update_btn=f.create_button("Check for updates");
int changes_btn=f.create_button("Changelog");
int sounds_btn=f.create_button("Learn game sounds");
int gestures_btn=f.create_button("Android touch gestures");
int practice_btn=f.create_button("Practice Android touch gestures");
int key_practice_btn=f.create_button("Practice keyboard controls");
int readme_btn=f.create_button("Readme");
int admin_btn=-1;
if(SCRIPT_COMPILED==false or dev_unlocked) admin_btn=f.create_button("Administrator panel");
int release_btn=-1;if(!SCRIPT_COMPILED)release_btn=f.create_button("Compress a release build");
int exit_btn=f.create_button("Exit the game",false,true); f.focus(connect_btn);
while(true)
{
wait(5); f.monitor();
if(f.is_pressed(connect_btn)) { m.fade_music(20); connect(); return; }
if(register_btn>=0 and f.is_pressed(register_btn)) { m.fade_music(20); registermenu(); return; }
if(f.is_pressed(account_btn)) { m.fade_music(20); accountmenu(); return; }
if(f.is_pressed(options_btn)) { optionsmenu(); mainmenu(); return; }
if(f.is_pressed(update_btn)) { cfu("iw","iw.zip"); mainmenu(); return; }
if(f.is_pressed(changes_btn)) { changelogmenu(); return; }
if(f.is_pressed(sounds_btn)) { learn_game_sounds(); mainmenu(); return; }
if(f.is_pressed(gestures_btn)) { show_android_gestures(); mainmenu(); return; }
if(f.is_pressed(practice_btn)) { practice_android_gestures(); mainmenu(); return; }
if(f.is_pressed(key_practice_btn)) { key_practice_mode(); mainmenu(); return; }
if(f.is_pressed(readme_btn)) { show_readme(); mainmenu(); return; }
if(admin_btn>=0 and f.is_pressed(admin_btn)) { adminpanel(); return; }
if(release_btn>=0 and f.is_pressed(release_btn)){compress_release_build();mainmenu();return;}
if(f.is_pressed(exit_btn)) { exit(); return; }
}
}

void mainmenu()
{
if(classic_main_menu) { classic_mainmenu(); return; }
setupmenu(true, true);
nv_form f;
f.create_window("Main Menu", false, true);
nv_form_tab_control@ tabs=nv_form_tab_control(@f, "Sections", "main_sections", true);
f.add_control(tabs);
nv_form_tab_page@ play=tabs.add_tab_page("Play");
nv_form_tab_page@ account_page=tabs.add_tab_page("Account");
nv_form_tab_page@ settings=tabs.add_tab_page("Settings");
nv_form_tab_page@ information=tabs.add_tab_page("Information");
nv_form_tab_page@ admin_page=null;
bool show_admin=(SCRIPT_COMPILED==false or dev_unlocked);
if (show_admin) @admin_page=tabs.add_tab_page("Administrator");
nv_form_button@[] buttons;
string[] ids;
buttons.insert_last(play.add_button("Connect to the server and enter the lobby", "connect", true)); ids.insert_last("connect");
if (name=="" or !account_exists(name)) { buttons.insert_last(account_page.add_button("Register a new account", "register")); ids.insert_last("register"); }
buttons.insert_last(account_page.add_button("Account management", "account")); ids.insert_last("account");
buttons.insert_last(settings.add_button("Options", "options")); ids.insert_last("options");
buttons.insert_last(settings.add_button("Check for updates", "cfu")); ids.insert_last("cfu");
buttons.insert_last(information.add_button("Changelog", "changelog")); ids.insert_last("changelog");
buttons.insert_last(information.add_button("Learn game sounds", "learnsounds")); ids.insert_last("learnsounds");
buttons.insert_last(information.add_button("Android touch gestures", "gestures")); ids.insert_last("gestures");
buttons.insert_last(information.add_button("Practice Android touch gestures", "gesturepractice")); ids.insert_last("gesturepractice");
buttons.insert_last(information.add_button("Practice keyboard controls", "keypractice")); ids.insert_last("keypractice");
buttons.insert_last(information.add_button("Readme", "readme")); ids.insert_last("readme");
if (show_admin) { buttons.insert_last(admin_page.add_button("Administrator panel", "adminpanel")); ids.insert_last("adminpanel");if(!SCRIPT_COMPILED){buttons.insert_last(admin_page.add_button("Compress a release build", "releasebuild"));ids.insert_last("releasebuild");} }
buttons.insert_last(settings.add_button("Exit the game", "exit")); ids.insert_last("exit");
tabs.focus();
string selected="";
while (selected=="")
{
wait(5);
nv_form_tab_page@ page=tabs.current_page;
bool section_left=key_pressed(KEY_LEFT);
bool section_right=key_pressed(KEY_RIGHT);
if (section_left or section_right)
{
if (@page!=null) page.control_index=-1;
int next=tabs.pos+(section_right ? 1 : -1);
if (next<0) next=tabs.page_count-1;
if (next>=tabs.page_count) next=0;
tabs.set_pos(next);
@page=tabs.current_page;
speak(tabs.speak_tab_item(page));
}
if (@page!=null and key_pressed(KEY_DOWN)) page.navigate_form(true);
else if (@page!=null and key_pressed(KEY_UP)) page.navigate_form(false);
f.monitor();
for (uint i=0; i<buttons.length(); i++)
if (buttons[i].pressed) { buttons[i].pressed=false; selected=ids[i]; break; }
}
m.fade_music(20);
if (selected=="connect")
connect();
else if (selected=="register")
registermenu();
else if (selected=="account")
accountmenu();
else if (selected=="changelog")
changelogmenu();
else if (selected=="cfu")
{
cfu("iw","iw.zip");
mainmenu();
}
else if (selected=="options")
{
optionsmenu();
mainmenu();
}
else if (selected=="adminpanel")
adminpanel();
else if(selected=="releasebuild")
{compress_release_build();mainmenu();}
else if (selected=="learnsounds")
{
learn_game_sounds();
mainmenu();
}
else if (selected=="gestures")
{
show_android_gestures();
mainmenu();
}
else if (selected=="gesturepractice")
{
practice_android_gestures();
mainmenu();
}
else if(selected=="keypractice")
{
key_practice_mode();
mainmenu();
}
else if (selected=="readme")
{
show_readme();
mainmenu();
}
else
exit();
}
// Check authorization mode from the server.
bool check_auth_mode_from_server()
{
bool auth_required=false;
network probe;
probe.setup_client(1, 100);
probe.connect(netaddress, netport);
timer ct;
while(ct.elapsed<5000)
{
wait(5);
network_event ev=probe.request();
if(ev.type==event_connect)
{
string msg=string_encrypt("check_authmode", "_';'_clickclick!");
probe.send_reliable(0, msg, 0);
timer rt;
while(rt.elapsed<3000)
{
wait(5);
ev=probe.request();
if(ev.type==event_receive)
{
string r=ev.message;
if(r!="") r=string_decrypt(r, "masonandsamare2bitches");
if(string_contains(r, "authmode_status ", 1)==0)
{
auth_required=(string_replace(r, "authmode_status ", "", false)=="1");
break;
}
}
}
break;
}
if(ev.type==event_disconnect)
break;
}
return auth_required;
}

void registermenu()
{
if(lockout_active and lockout_timer.elapsed<900000)
{
int remaining=(900000-lockout_timer.elapsed)/1000;
dlg("You are locked out due to too many failed login attempts. Please wait "+remaining+" seconds before trying again.");
mainmenu();
return;
}
if(lockout_active and lockout_timer.elapsed>=900000)
{
lockout_active=false;
failed_login_attempts=0;
}
// Require the server to be reachable before accepting registrations.
speak("Checking server status, please wait.");
if (!server_online())
{
dlg("The server is currently offline. You cannot register a new account while the server is down. Please try again later.");
mainmenu();
return;
}
bool auth_required = check_auth_mode_from_server();
// Load rules text.
file rf;
string rules_text="";
if (rf.open("rules.txt","rb"))
{
rules_text=rf.read();
rf.close();
}
else
rules_text="Rules file not found. Please check the game folder.";
// Single registration form.
iw_form f;
f.create_window("Register a New Account", false, true);
int f_user = f.create_input_box("Username (max 20 characters)", "", "", 0, false, false, false);
int f_pass = f.create_input_box("Password (at least 12 characters, must include uppercase, lowercase, and a number)", "", "*", 0, false, false, false);
int f_confirm = f.create_input_box("Confirm password", "", "*", 0, false, false, false);
int f_email = f.create_input_box("Email address", "", "", 0, false, false, false);
f.create_input_box("Rules", rules_text, "", 0, false, true, true);
int f_agree = f.create_checkbox("I agree to the rules", false);
int f_remember = f.create_checkbox("Remember me", true);
int f_register = f.create_button("&Register", true);
int f_back = f.create_button("Go &back", false, true);
f.focus(f_user);
while(true)
{
wait(5);
f.monitor();
if (connected==true)
netloop();
if (f.is_pressed(f_register))
{
string reg_user = f.get_text(f_user);
string reg_pass = f.get_text(f_pass);
string reg_confirm = f.get_text(f_confirm);
string reg_email = f.get_text(f_email);
if (!f.is_checked(f_agree))
{
dlg("You must agree to the rules to register an account.");
continue;
}
if (reg_user == "" or string_contains(reg_user, " ", 1) >= 0)
{
dlg("Username must not be empty or contain spaces.");
continue;
}
if (reg_user.length() > 20)
{
dlg("Username must be 20 characters or fewer.");
continue;
}
if (reg_pass.length() < 12)
{
dlg("Password must be at least 12 characters.");
continue;
}
bool has_upper=false, has_lower=false, has_digit=false;
for (uint ci=0; ci<reg_pass.length(); ci++)
{
string ch=string_mid(reg_pass, ci, 1);
if (ch>="A" and ch<="Z") has_upper=true;
if (ch>="a" and ch<="z") has_lower=true;
if (ch>="0" and ch<="9") has_digit=true;
}
if (!has_upper or !has_lower or !has_digit)
{
dlg("Password must contain at least one uppercase letter, one lowercase letter, and one number.");
continue;
}
string lp=string_to_lower_case(reg_pass);
string[] common_passwords={"1234", "12345", "123456", "1234567", "12345678", "123456789", "1234567890", "abcde", "abcdef", "abcdefg", "abcdefgh", "1111", "11111", "111111", "0000", "00000", "000000", "aaaa", "aaaaa", "aaaaaa", "password", "password1", "password12", "password123", "qwerty", "qwerty1", "qwerty12", "qwerty123", "letmein", "welcome", "monkey", "dragon", "master", "abc123", "login", "princess", "admin", "passw0rd"};
bool is_common=false;
for (uint ci=0; ci<common_passwords.length(); ci++)
{
if (lp==common_passwords[ci]){is_common=true; break;}
}
if (is_common)
{
dlg("That password is too common. Please choose a more secure password.");
continue;
}
if (reg_pass != reg_confirm)
{
dlg("Passwords do not match.");
continue;
}
if (reg_email == "" or !is_valid_email(reg_email))
{
dlg("Please enter a valid email address.");
continue;
}
string reg_error = register_account(reg_user, reg_pass, reg_confirm, reg_email, auth_required);
if (reg_error != "")
{
dlg(reg_error);
continue;
}
// Success.
name = reg_user;
remember_me = f.is_checked(f_remember);
writeprefs();
if (auth_required)
dlg("Account created successfully! Your username is " + reg_user + ". However, authorization mode is enabled. You will not be able to log in until an administrator provides you with your authorization code. Please contact an administrator.");
else
dlg("Account created successfully! Your username is " + reg_user + ". You can now connect to the server.");
break;
}
else if (f.is_pressed(f_back))
break;
}
mainmenu();
}
// ---------------------------------------------------------------------------
// Changelog viewer — standard audio form with read-only text field.
// ---------------------------------------------------------------------------
void show_changelog_form_text(string cl)
{
iw_form f;
f.create_window("Changelog", false, true);
f.create_input_box("Changes", cl, "", 0, true, true, false);
int f_close=f.create_button("&Close", true, true);
f.focus(0);
while(true)
{
wait(5);
f.monitor();
if (f.is_pressed(f_close))
break;
}
}
void show_changelog_form()
{
file cf;
string cl="Changelog not found.";
if (cf.open("changes.txt","rb"))
{
cl=cf.read();
cf.close();
}
show_changelog_form_text(cl);
}
void changelogmenu()
{
show_changelog_form();
mainmenu();
}
// ---------------------------------------------------------------------------
// Account menu — requires server to be online.
// Hub menu that leads to Login, Authorize, and Password Reset sub-menus.
// ---------------------------------------------------------------------------
void accountmenu()
{
speak("Checking server status, please wait.");
if (!server_online())
{
dlg("The server is currently offline. Account management is not available while the server is down. Please try again later.");
mainmenu();
return;
}
setupmenu();
if (name == "" or !account_exists(name))
{
m.add_item_tts("Add an existing account.","login");
m.add_item_tts("Register a new account.","register");
}
else
{
m.add_item_tts("Logged in as "+name+".","info");
if (!is_account_authenticated(name))
m.add_item_tts("Authorize your account with a code.","authorize");
m.add_item_tts("Reset your password.","resetpass");
m.add_item_tts("Log out.","logout");
}
m.add_item_tts("Go back.","back");
int mres=m.run("Account Management",true);
if (m.get_item_name(mres)=="login")
account_login_menu();
else if (m.get_item_name(mres)=="register")
{
registermenu();
return;
}
else if (m.get_item_name(mres)=="authorize")
account_authorize_menu();
else if (m.get_item_name(mres)=="resetpass")
account_reset_menu();
else if (m.get_item_name(mres)=="logout")
{
name="";
writeprefs();
speak("Logged out.");
accountmenu();
}
else if (m.get_item_name(mres)=="info")
accountmenu();
else
mainmenu();
}
// ---------------------------------------------------------------------------
// Account sub-menu: Login
// ---------------------------------------------------------------------------
void account_login_menu()
{
if(lockout_active and lockout_timer.elapsed<900000)
{
int remaining=(900000-lockout_timer.elapsed)/1000;
dlg("You are locked out due to too many failed login attempts. Please wait "+remaining+" seconds before trying again.");
accountmenu();
return;
}
if(lockout_active and lockout_timer.elapsed>=900000)
{
lockout_active=false;
failed_login_attempts=0;
}
iw_form f;
f.create_window("Login", false, true);
int f_user=f.create_input_box("Username", "", "", 0, false, false, false);
int f_pass=f.create_input_box("Password", "", "*", 0, false, false, false);
int f_remember=f.create_checkbox("Remember me", true);
int f_login=f.create_button("&Login", true);
int f_back=f.create_button("Go &back", false, true);
f.focus(f_user);
while(true)
{
wait(5);
f.monitor();
if (connected==true)
netloop();
if (f.is_pressed(f_login))
{
string acc_user=f.get_text(f_user);
string acc_pass=f.get_text(f_pass);
if (acc_user=="" or acc_pass=="")
{
dlg("Please enter both a username and password.");
continue;
}
if (!account_exists(acc_user))
{
// Account doesn't exist — offer to register.
int reg_choice = yesno("No account found with that username. Would you like to register a new account?");
if (reg_choice == 1)
{
registermenu();
return;
}
continue;
}
if (!verify_account(acc_user, acc_pass))
{
failed_login_attempts++;
if(failed_login_attempts>=5)
{
lockout_active=true;
lockout_timer.restart();
dlg("Too many failed login attempts. You are locked out for 15 minutes.");
accountmenu();
return;
}
dlg("Incorrect password. "+(5-failed_login_attempts)+" attempts remaining.");
continue;
}
if (!is_account_authenticated(acc_user))
{
dlg("Your account has not been authenticated yet. Please enter the authorization code provided by an administrator, or contact an administrator to receive your code.");
continue;
}
name=get_account_username(acc_user);
remember_me=f.is_checked(f_remember);
writeprefs();
speak("Logged in as "+name+".");
break;
}
else if (f.is_pressed(f_back))
{
break;
}
}
accountmenu();
}
// ---------------------------------------------------------------------------
// Account sub-menu: Authorize
// ---------------------------------------------------------------------------
void account_authorize_menu()
{
iw_form f;
f.create_window("Authorize Account", false, true);
int f_user=f.create_input_box("Username", "", "", 0, false, false, false);
int f_authcode=f.create_input_box("Authorization code", "", "", 0, false, false, false);
int f_submit=f.create_button("&Authorize account", true);
int f_back=f.create_button("Go &back", false, true);
f.focus(f_user);
while(true)
{
wait(5);
f.monitor();
if (connected==true)
netloop();
if (f.is_pressed(f_submit))
{
string acc_user=f.get_text(f_user);
string code=f.get_text(f_authcode);
if (acc_user=="")
{
dlg("Please enter your account username.");
continue;
}
if (code=="")
{
dlg("Please enter an authorization code.");
continue;
}
if (!account_exists(acc_user))
{
dlg("No account found with that username.");
continue;
}
if (is_account_authenticated(acc_user))
{
dlg("This account is already authenticated.");
continue;
}
if (authenticate_account(acc_user, code))
{
dlg("Account authenticated successfully! You can now log in.");
break;
}
else
{
dlg("Invalid authorization code. Please check the code and try again.");
}
}
else if (f.is_pressed(f_back))
{
break;
}
}
accountmenu();
}
// ---------------------------------------------------------------------------
// Account sub-menu: Password Reset
// ---------------------------------------------------------------------------
void account_reset_menu()
{
iw_form f;
f.create_window("Password Reset", false, true);
int f_user=f.create_input_box("Username", "", "", 0, false, false, false);
int f_resetreq=f.create_button("Request &password reset", true);
int f_resetcode=f.create_input_box("Reset code", "", "", 0, false, false, false);
int f_resetsubmit=f.create_button("&Submit reset code");
int f_back=f.create_button("Go &back", false, true);
f.focus(f_user);
while(true)
{
wait(5);
f.monitor();
if (connected==true)
netloop();
if (f.is_pressed(f_resetreq))
{
string acc_user=f.get_text(f_user);
if (acc_user=="")
{
dlg("Please enter your username before requesting a password reset.");
continue;
}
// Send the request to the server via a temporary connection.
network rn;
rn.setup_client(1, 100);
rn.connect(netaddress, netport);
timer rct;
bool got_response=false;
string rresult="";
while(rct.elapsed<5000)
{
wait(5);
network_event rev=rn.request();
if(rev.type==event_connect)
{
string rmsg=string_encrypt("request_password_reset "+acc_user, "_';'_clickclick!");
rn.send_reliable(0, rmsg, 0);
timer rrt;
while(rrt.elapsed<3000)
{
wait(5);
rev=rn.request();
if(rev.type==event_receive)
{
string rr=rev.message;
if(rr!="") rr=string_decrypt(rr, "masonandsamare2bitches");
rresult=rr;
got_response=true;
break;
}
}
break;
}
if(rev.type==event_disconnect)
break;
}
if(rresult=="reset_requested")
dlg("Password reset requested. Please contact an administrator to receive your reset code.");
else if(rresult=="reset_no_account")
dlg("No account found with that username.");
else
dlg("Could not send the reset request. The server may not have responded.");
}
else if (f.is_pressed(f_resetsubmit))
{
string acc_user=f.get_text(f_user);
string rcode=f.get_text(f_resetcode);
if (acc_user=="")
{
dlg("Please enter your username before submitting a reset code.");
continue;
}
if (rcode=="")
{
dlg("Please enter a reset code.");
continue;
}
// Verify the reset code with the server.
network rn;
rn.setup_client(1, 100);
rn.connect(netaddress, netport);
timer rct;
string rresult="";
while(rct.elapsed<5000)
{
wait(5);
network_event rev=rn.request();
if(rev.type==event_connect)
{
string rmsg=string_encrypt("submit_reset_code "+acc_user+" "+rcode, "_';'_clickclick!");
rn.send_reliable(0, rmsg, 0);
timer rrt;
while(rrt.elapsed<3000)
{
wait(5);
rev=rn.request();
if(rev.type==event_receive)
{
string rr=rev.message;
if(rr!="") rr=string_decrypt(rr, "masonandsamare2bitches");
rresult=rr;
break;
}
}
break;
}
if(rev.type==event_disconnect)
break;
}
if(rresult!="reset_code_ok")
{
dlg("Invalid reset code. Please check the code and try again.");
continue;
}
// Code is valid — prompt for new password.
password_reset_form(acc_user);
break;
}
else if (f.is_pressed(f_back))
{
break;
}
}
accountmenu();
}
// ---------------------------------------------------------------------------
// Password reset form — lets the player enter and confirm a new password.
// Called after the reset code has been verified.
// ---------------------------------------------------------------------------
void password_reset_form(string username)
{
iw_form f;
f.create_window("Reset Password", false, true);
int f_newpass=f.create_input_box("New password", "", "*", 0, false, false, false);
int f_confirm=f.create_input_box("Confirm new password", "", "*", 0, false, false, false);
int f_submit=f.create_button("&Reset password", true);
int f_cancel=f.create_button("&Cancel", false, true);
f.focus(f_newpass);
while(true)
{
wait(5);
f.monitor();
if (f.is_pressed(f_submit))
{
string newpass=f.get_text(f_newpass);
string confirm=f.get_text(f_confirm);
if (newpass.length()<12)
{
dlg("Password must be at least 12 characters.");
continue;
}
bool has_upper=false, has_lower=false, has_digit=false;
for (uint ci=0; ci<newpass.length(); ci++)
{
string ch=string_mid(newpass, ci, 1);
if (ch>="A" and ch<="Z") has_upper=true;
if (ch>="a" and ch<="z") has_lower=true;
if (ch>="0" and ch<="9") has_digit=true;
}
if (!has_upper or !has_lower or !has_digit)
{
dlg("Password must contain at least one uppercase letter, one lowercase letter, and one number.");
continue;
}
string lp=string_to_lower_case(newpass);
string[] common_passwords={"1234", "12345", "123456", "1234567", "12345678", "123456789", "1234567890", "abcde", "abcdef", "abcdefg", "abcdefgh", "1111", "11111", "111111", "0000", "00000", "000000", "aaaa", "aaaaa", "aaaaaa", "password", "password1", "password12", "password123", "qwerty", "qwerty1", "qwerty12", "qwerty123", "letmein", "welcome", "monkey", "dragon", "master", "abc123", "login", "princess", "admin", "passw0rd"};
bool is_common=false;
for (uint ci=0; ci<common_passwords.length(); ci++)
{
if (lp==common_passwords[ci]){is_common=true; break;}
}
if (is_common)
{
dlg("That password is too common. Please choose a more secure password.");
continue;
}
if (newpass!=confirm)
{
dlg("Passwords do not match.");
continue;
}
// Send the new password to the server.
network rn;
rn.setup_client(1, 100);
rn.connect(netaddress, netport);
timer rct;
string rresult="";
while(rct.elapsed<5000)
{
wait(5);
network_event rev=rn.request();
if(rev.type==event_connect)
{
string rmsg=string_encrypt("reset_password "+username+" "+newpass, "_';'_clickclick!");
rn.send_reliable(0, rmsg, 0);
timer rrt;
while(rrt.elapsed<3000)
{
wait(5);
rev=rn.request();
if(rev.type==event_receive)
{
string rr=rev.message;
if(rr!="") rr=string_decrypt(rr, "masonandsamare2bitches");
rresult=rr;
break;
}
}
break;
}
if(rev.type==event_disconnect)
break;
}
if(rresult=="reset_done")
{
dlg("Your password has been reset successfully. You can now log in with your new password.");
return;
}
else
{
dlg("Failed to reset password. The server may not have responded.");
return;
}
}
else if (f.is_pressed(f_cancel))
{
return;
}
}
}
// ---------------------------------------------------------------------------
// Escape menu — replaces the old grave-accent game menu.
// Contains game info, equipment, statistics, and exit.
// ---------------------------------------------------------------------------
void send_team_command(string command)
{
send_reliable(0, "/team "+command, 1);
}

bool team_translocator_received=false,team_translocator_go_received=false,team_translocator_go_success=false;
int team_translocator_points=0,team_translocator_go_cells=0;
string[] team_translocator_names;double[] team_translocator_x,team_translocator_y,team_translocator_z;int[] team_translocator_cell_cost,team_translocator_point_cost;
string team_translocator_go_name="";double team_translocator_go_x=0,team_translocator_go_y=0,team_translocator_go_z=0;
void receive_team_translocator_state(string message){team_translocator_names.resize(0);team_translocator_x.resize(0);team_translocator_y.resize(0);team_translocator_z.resize(0);team_translocator_cell_cost.resize(0);team_translocator_point_cost.resize(0);string[] fields=string_split(message,"|",false);if(fields.length()<3)return;team_translocator_points=string_to_number(fields[1]);if(fields[2]!="-"){string[] entries=string_split(fields[2],",",false);for(uint i=0;i<entries.length();i++){string[] v=string_split(entries[i],"~",false);if(v.length()<6)continue;team_translocator_names.insert_last(v[0]);team_translocator_x.insert_last(string_to_number(v[1]));team_translocator_y.insert_last(string_to_number(v[2]));team_translocator_z.insert_last(string_to_number(v[3]));team_translocator_cell_cost.insert_last(string_to_number(v[4]));team_translocator_point_cost.insert_last(string_to_number(v[5]));}}team_translocator_received=true;}
void receive_team_translocator_go(string message){string[] f=string_split(message,"|",false);team_translocator_go_received=true;team_translocator_go_success=f.length()>=7;if(!team_translocator_go_success)return;team_translocator_go_name=f[1];team_translocator_go_x=string_to_number(f[2]);team_translocator_go_y=string_to_number(f[3]);team_translocator_go_z=string_to_number(f[4]);team_translocator_go_cells=string_to_number(f[5]);}

bool team_state_received=false;
bool team_state_member=false;
bool team_state_invite=false;
bool team_state_can_invite=false;
bool team_state_can_remove=false;
bool team_state_can_shop=false;
string team_state_name="";
string team_state_role="";
string team_state_members="";
int team_state_points=0;
int team_state_member_count=0;

void receive_team_state(string message)
{
string[] fields=string_split(message,"|",false);
if(fields.length()<11 or fields[0]!="team_state") return;
team_state_member=fields[1]=="1";
team_state_name=fields[2]=="-" ? "" : fields[2];
team_state_points=string_to_number(fields[3]);
team_state_role=fields[4]=="-" ? "" : fields[4];
team_state_can_invite=fields[5]=="1";
team_state_can_remove=fields[6]=="1";
team_state_can_shop=fields[7]=="1";
team_state_invite=fields[8]=="1";
team_state_member_count=string_to_number(fields[9]);
team_state_members=fields[10]=="-" ? "" : fields[10];
team_state_received=true;
}

bool refresh_team_state()
{
team_state_received=false;
send_team_command("state");
timer timeout;
while(!team_state_received and timeout.elapsed<2500) { wait(5); netloop(); }
if(!team_state_received) speak("Team information could not be refreshed.");
return team_state_received;
}

void team_shop_menu()
{
iw_form shop;
shop.create_window("Team Shop", false, true);
int items=shop.create_list("Items", 0, false);
shop.add_list_item(items, "Duo Plane Kit - 500 team points");
shop.add_list_item(items, "Humvee Kit - 450 team points; independent 5 minute timer");
shop.add_list_item(items, "APC Kit - 700 team points; independent 5 minute timer");
shop.add_list_item(items, "Tank Kit - 900 team points; independent 5 minute timer");
shop.add_list_item(items, "Team Supply Beacon - 150 team points");
shop.add_list_item(items, "Team Armor Crate - 250 team points");
shop.add_list_item(items, "Team Revive Kit - 300 team points");
shop.add_list_item(items, "Team Recon Scanner - 200 team points");
int buy=shop.create_button("Purchase", true);
int close=shop.create_button("Close", false, true);
shop.focus(items);
while (true)
{
wait(5); shop.monitor(); if (connected) netloop();
if (shop.is_pressed(close)) return;
if (shop.is_pressed(buy))
{
string[] keys={"plane", "humvee", "apc", "tank", "supply", "armor", "revive", "recon"};
int selected=shop.get_list_position(items);
if (selected>=0 and selected<int(keys.length())) send_team_command("buy "+keys[selected]);
return;
}
}
}

void team_menu()
{
if(!refresh_team_state()) return;
nv_form f; f.create_window("Team",false,true);
nv_form_tab_control@ tabs=nv_form_tab_control(@f,"Categories","team_categories",true); f.add_control(tabs);
nv_form_tab_page@ overview=tabs.add_tab_page("Overview");
nv_form_tab_page@ membership=null;
nv_form_tab_page@ management=null;
nv_form_tab_page@ resources=null;
nv_form_button@ info=null, chat=null, create=null, accept=null, invite=null, remove=null, manager=null, permission=null, shop=null, leave=null;
if(team_state_member)
{
@info=overview.add_button("Team information: "+team_state_name+", "+team_state_points+" points, role "+team_state_role,"info",true);
@chat=overview.add_button("Send team chat message, or use slash T from chat","chat");
@membership=tabs.add_tab_page("Membership");
if(!(team_state_role=="owner" and team_state_member_count>1)) @leave=membership.add_button("Leave team","leave");
if(team_state_can_invite or team_state_can_remove or team_state_role=="owner")
{
@management=tabs.add_tab_page("Management");
if(team_state_can_invite) @invite=management.add_button("Invite a player","invite");
if(team_state_can_remove and team_state_member_count>1) @remove=management.add_button("Remove a member","remove");
if(team_state_role=="owner" and team_state_member_count>1)
{
@manager=management.add_button("Appoint or demote a manager","manager");
@permission=management.add_button("Assign a member permission","permission");
}
}
if(team_state_can_shop) { @resources=tabs.add_tab_page("Resources"); @shop=resources.add_button("Open team shop; pool "+team_state_points+" points","shop"); }
}
else
{
@create=overview.add_button("Create a team","create",true);
if(team_state_invite) @accept=overview.add_button("Accept pending team invitation","accept");
}
nv_form_button@ close=f.add_button("Close","close",false,true); tabs.focus();
while (true)
{
wait(5); f.monitor(); if (connected) netloop();
if (f.is_pressed(close)) return;
if (@info!=null and overview.is_pressed(info)) { send_team_command("info"); return; }
if (@chat!=null and overview.is_pressed(chat))
{
string message=af_input("Team message", "", true).trim_whitespace();
if (message!="") send_team_command("chat "+message);
return;
}
if (@create!=null and overview.is_pressed(create))
{
string value=af_input("Team name", "", true).trim_whitespace();
if (value!="") send_team_command("create "+value);
return;
}
if (@accept!=null and overview.is_pressed(accept)) { send_team_command("accept"); return; }
bool invite_pressed=@invite!=null and management.is_pressed(invite);
bool remove_pressed=@remove!=null and management.is_pressed(remove);
bool manager_pressed=@manager!=null and management.is_pressed(manager);
if (invite_pressed or remove_pressed or manager_pressed)
{
string value=af_input("Player name", "", true).trim_whitespace();
if (value!="")
{
if (invite_pressed) send_team_command("invite "+value);
else if (remove_pressed) send_team_command("remove "+value);
else send_team_command("manager "+value);
}
return;
}
if (@permission!=null and management.is_pressed(permission))
{
string player_name=af_input("Player name", "", true).trim_whitespace();
string permission_name=af_input("Permission: invite, remove, or shop", "", true).trim_whitespace();
if (player_name!="" and permission_name!="") send_team_command("permission "+player_name+" "+permission_name);
return;
}
if (@shop!=null and resources.is_pressed(shop)) { team_shop_menu(); return; }
if (@leave!=null and membership.is_pressed(leave)) { send_team_command("leave"); return; }
}
}

void escape_menu()
{
// Android keeps its purpose-built touch menu; desktop uses NV_form.
if(is_android())
{
android_escape_menu();
return;
}
iw_form f;
f.create_window("Game Menu", false, true);
int f_stats = f.create_button("&Stats");
int f_equip = f.create_button("&Equipment");
int f_team = f.create_button("&Team");
int f_changes = f.create_button("View &changes");
int f_rules = f.create_button("View &rules");
int f_account = f.create_button("&Account info");
int f_devs = f.create_button("View &developers");
int f_admin=-1;
if(SCRIPT_COMPILED==false)
f_admin = f.create_button("Ad&min panel");
int f_exit = f.create_button("E&xit game");
int f_close = f.create_button("Cl&ose", true, true);
f.focus(f_stats);
while(true)
{
wait(5);
f.monitor();
if (connected==true)
netloop();
if (f.is_pressed(f_stats))
{
string stats_text="Weapon: "+string_replace(weapons[w], "_", " ", true)+"\n";
stats_text+="Location: "+get_location()+"\n";
stats_text+="Stamina: "+get_stamina_string()+"\n";
stats_text+="Effects: "+get_effects_string()+"\n";
stats_text+="Items: "+count_total_items()+" in inventory\n";
stats_text+="Map: "+map_display_name(mapname)+"\n";
stats_text+="Player: "+name+"\n";
stats_text+="Version: "+version+", build "+build_number+" ("+build_date+")";
iw_form sf;
sf.create_window("Stats", false, true);
sf.create_input_box("Stats", stats_text, "", 0, false, true, true);
int sf_close=sf.create_button("&Close", true, true);
sf.focus(0);
while(true)
{
wait(5);
sf.monitor();
if (connected==true) netloop();
if (sf.is_pressed(sf_close)) break;
}
}
else if (f.is_pressed(f_equip))
{
equipment_menu();
escape_menu();
return;
}
else if (f.is_pressed(f_team))
{
team_menu();
escape_menu();
return;
}
else if (f.is_pressed(f_changes))
{
show_changelog_form();
}
else if (f.is_pressed(f_rules))
{
file rf;
string rl="Rules file not found.";
if (rf.open("rules.txt","rb"))
{
rl=rf.read();
rf.close();
}
dlg(rl);
}
else if (f.is_pressed(f_account))
{
iw_form ai;
ai.create_window("Account Info", false, true);
ai.create_input_box("Username", name, "", 0, false, true, false);
if (account_exists(name))
{
savedata acct(get_account_path(name), ACCOUNT_SECRET);
acct.load();
string em=acct.read("email");
if (em!="")
ai.create_input_box("Email", em, "", 0, false, true, false);
}
else
ai.create_input_box("Account", "No registered account found for this username.", "", 0, false, true, false);
int ai_close = ai.create_button("&Close", true, true);
ai.focus(0);
while(true)
{
wait(5);
ai.monitor();
if (connected==true) netloop();
if (ai.is_pressed(ai_close)) break;
}
}
else if (f.is_pressed(f_devs))
{
file df;
string dv="Developers file not found.";
if (df.open("developers.txt","rb"))
{
dv=df.read();
df.close();
}
dlg(dv);
}
else if (f_admin>-1 and f.is_pressed(f_admin))
{
ingame_adminpanel();
escape_menu();
return;
}
else if (f.is_pressed(f_exit))
{
int q = yesno("Are you sure you wish to exit the game?");
if (q == 1)
{
speak("Exiting the game");
send_reliable(0, "close", 0);
x = true;
xtimer.restart();
return;
}
}
else if (f.is_pressed(f_close))
{
return;
}
}
}

// ---------------------------------------------------------------------------
// Equipment menu — view and manage equipped items.
// ---------------------------------------------------------------------------
void equipment_menu()
{
iw_form f;
f.create_window("Equipment", false, true);
int f_list = f.create_list("Equipment slots", 0, false);
f.add_list_item(f_list,"Armour, head: "+(equipped_armor_head==""?"empty":string_replace(equipped_armor_head,"_"," ",true)+", "+equipped_armor_head_durability+" durability"));
f.add_list_item(f_list,"Armour, torso: "+(equipped_armor_torso==""?"empty":string_replace(equipped_armor_torso,"_"," ",true)+", "+equipped_armor_torso_durability+" durability"));
f.add_list_item(f_list,"Armour, arms: "+(equipped_armor_arms==""?"empty":string_replace(equipped_armor_arms,"_"," ",true)+", "+equipped_armor_arms_durability+" durability"));
f.add_list_item(f_list,"Armour, legs: "+(equipped_armor_legs==""?"empty":string_replace(equipped_armor_legs,"_"," ",true)+", "+equipped_armor_legs_durability+" durability"));
string body_label = "Body: ";
if (equip_body != "")
body_label += string_replace(equip_body, "_", " ", true)+", "+round(equipped_item_weight(equip_body),1)+" weight";
else
body_label += "empty";
f.add_list_item(f_list, body_label);
f.add_list_item(f_list, "Holster 1: "+get_holster_slot_label(1)+(equip_holster1==""?"":", "+round(equipped_item_weight(equip_holster1),1)+" weight"));
f.add_list_item(f_list, "Holster 2: "+get_holster_slot_label(2)+(equip_holster2==""?"":", "+round(equipped_item_weight(equip_holster2),1)+" weight"));
string bracelet_label = "Bracelet: ";
if (equip_bracelet != "")
bracelet_label += string_replace(equip_bracelet, "_", " ", true)+", "+round(equipped_item_weight(equip_bracelet),1)+" weight";
else
bracelet_label += "empty";
f.add_list_item(f_list, bracelet_label);
string medical_label = "Medical: ";
if (equip_medical != "")
{
medical_label += string_replace(equip_medical, "_", " ", true);
if (equip_medical == "wirenet")
medical_label += " (" + wirenet_charges + " charges, " + (wirenet_active ? "active" : "inactive") + ")";
medical_label += ", "+round(equipped_item_weight(equip_medical),1)+" weight";
}
else
medical_label += "empty";
f.add_list_item(f_list, medical_label);
f.add_list_item(f_list,"Total equipped weight: "+total_equipment_weight());
bool has_equipment=(equipped_armor_head!="" or equipped_armor_torso!="" or equipped_armor_arms!="" or equipped_armor_legs!="" or equip_body!="" or equip_holster1!="" or equip_holster2!="" or equip_bracelet!="" or equip_medical!="");
int f_remove=-1;
if(has_equipment)
f_remove=f.create_button("&Remove selected");
int f_close = f.create_button("&Close", true, true);
f.focus(f_list);
while(true)
{
wait(5);
f.monitor();
if (connected==true)
netloop();
if (f_remove>-1 and f.is_pressed(f_remove))
{
int sel = f.get_list_position(f_list);
if(sel>=0 and sel<=3)
{
string[] regions={"head","torso","arm","leg"};string[] equipped={equipped_armor_head,equipped_armor_torso,equipped_armor_arms,equipped_armor_legs};
if(equipped[sel]=="")speak("Nothing equipped in this armour slot.");else{send_reliable(0,"armor_unequip "+regions[sel],0);speak("Removing "+string_replace(equipped[sel],"_"," ",true)+".");return;}
}
else if (sel == 4 and equip_body != "")
{
unequip_item("body");
equipment_menu();
return;
}
else if (sel == 5 and equip_holster1 != "")
{
unequip_holster(1);
equipment_menu();
return;
}
else if (sel == 6 and equip_holster2 != "")
{
unequip_holster(2);
equipment_menu();
return;
}
else if (sel == 7 and equip_bracelet != "")
{
unequip_item("bracelet");
equipment_menu();
return;
}
else if (sel == 8 and equip_medical != "")
{
unequip_item("medical");
equipment_menu();
return;
}
else
{
speak("Nothing equipped in this slot.");
}
}
else if (f.is_pressed(f_close))
{
return;
}
}
}
void show_readme()
{
file rf;
string readme_text="";
if (rf.open("readme.txt", "rb"))
{
readme_text=rf.read();
rf.close();
}
else if (rf.open("readme.md", "rb"))
{
readme_text=rf.read();
rf.close();
}
else
readme_text="Readme file not found. Please check the game folder.";
iw_form f;
f.create_window("Readme", false, true);
f.create_input_box("Readme", readme_text, "", 0, false, true, true);
int f_close=f.create_button("&Close", false, true);
f.focus(0);
while(true)
{
wait(5);
f.monitor();
if (f.is_pressed(f_close)) return;
}
}
void learn_game_sounds()
{
string[] cat_names = {"Navigation", "Combat warnings", "Important alerts", "Vehicle awareness"};
string[][] sound_names;
string[][] sound_files;
// Only sounds a player benefits from identifying before play are included.
// Ordinary footsteps, menu navigation, weapon handling, and routine ambience
// are learned naturally and no longer bury safety-critical cues.
string[] mv_names = {"Falling", "Ladder", "Map edge or blocked movement", "Camera hazard"};
string[] mv_files = {"fall.ogg", "ladderstep1.ogg", "menuedge.ogg", "camerahazard.ogg"};
sound_names.insert_last(mv_names);
sound_files.insert_last(mv_files);
string[] cb_names = {"You took damage", "Confirmed weapon hit", "Confirmed headshot", "Kill confirmed", "Bunker bomb warning", "Incoming plane bomb", "Torpedo launch"};
string[] cb_files = {"playerhit1.ogg", "weaponping.ogg", "headshot_indicator.ogg", "killachievement.ogg", "bunkerbombwarndist.ogg", "planebomblounchdist.ogg", "torpedolounchdist.ogg"};
sound_names.insert_last(cb_names);
sound_files.insert_last(cb_files);
string[] ui_names = {"Chat message", "Private message", "System notification", "Disconnected", "Player online", "Player offline", "Ping started", "Ping lost"};
string[] ui_files = {"chat.ogg", "pm.ogg", "notify.ogg", "dc.ogg", "online.ogg", "offline.ogg", "pingstart.ogg", "pingstop.ogg"};
sound_names.insert_last(ui_names);
sound_files.insert_last(ui_files);
string[] vh_names = {"Nearby aircraft", "Aircraft crash", "Vehicle collision", "Tracking acquired"};
string[] vh_files = {"duoplanedist.ogg", "duoplanecrashdist.ogg", "vehicle_jeep_crash.ogg", "trackingnew.ogg"};
sound_names.insert_last(vh_names);
sound_files.insert_last(vh_files);
iw_form f;
f.create_window("Learn Game Sounds", false, true);
int f_cats=f.create_list("Category", 0, false);
for (uint i=0; i<cat_names.length(); i++)
f.add_list_item(f_cats, cat_names[i]);
int f_sounds=f.create_list("Sounds", 0, false);
int f_play=f.create_button("&Play", true);
int f_close=f.create_button("&Close", false, true);
int last_cat=-1;
f.focus(f_cats);
sound@ preview;
while(true)
{
wait(5);
f.monitor();
int cur_cat=f.get_list_position(f_cats);
if (cur_cat!=last_cat and cur_cat>=0 and cur_cat<int(cat_names.length()))
{
last_cat=cur_cat;
f.clear_list(f_sounds);
for (uint j=0; j<sound_names[cur_cat].length(); j++)
f.add_list_item(f_sounds, sound_names[cur_cat][j]);
}
if (f.is_pressed(f_play))
{
int sel=f.get_list_position(f_sounds);
if (cur_cat>=0 and cur_cat<int(cat_names.length()) and sel>=0 and sel<int(sound_files[cur_cat].length()))
{
if (@preview!=null)
{
preview.close();
@preview=null;
}
sound s;
s.load(sound_files[cur_cat][sel]);
s.play();
@preview=s;
}
}
else if (f.is_pressed(f_close))
{
if (@preview!=null) preview.close();
break;
}
}
}
void setupmenu(bool music=false, bool main=false)
{
m.reset(true);
if (music==true)
m.add_music("menumus.ogg");
if(main==true)
m.set_callback(main_events, "");
else
m.set_callback(cme, "");
m.click_sound="menumove.ogg";
m.enter_sound="menuenter.ogg";
m.wrap=menu_wrap_enabled;
m.enable_home_and_end=true;
m.enable_up_and_down=true;
m.enable_first_letter_navigation=true;
m.open_sound="menuopen.ogg";
m.wrap_sound="menuwrap.ogg";
m.edge_sound="menuedge.ogg";
m.enable_side_scrolling=false;
m.enable_left_and_right=false;
}
// ---------------------------------------------------------------------------
// Options use NV_form property pages. The focused tab strip is deliberately
// first: Left and Right select a category, then Tab enters that page.
// ---------------------------------------------------------------------------
void optionsmenu()
{
nv_form f;
f.create_window("Options", false, true);
nv_form_tab_control@ tabs=nv_form_tab_control(@f, "Categories", "categories", true);
f.add_control(tabs);
nv_form_tab_page@ gameplay=tabs.add_tab_page("Gameplay");
nv_form_tab_page@ interface_page=tabs.add_tab_page("Interface");
nv_form_tab_page@ controls_page=tabs.add_tab_page("Controls");
nv_form_tab_page@ display_page=tabs.add_tab_page("Display");
nv_form_tab_page@ network_page=tabs.add_tab_page("Network");
nv_form_tab_page@ audio_page=tabs.add_tab_page("Audio");

nv_form_checkbox@ f_target_hp=gameplay.add_checkbox("Show target HP on hit", "target_hp", show_target_hp);
nv_form_checkbox@ f_damage_readout=gameplay.add_checkbox("Show damage readout on hit", "damage", show_damage_readout);
nv_form_checkbox@ f_auto_quickbar=gameplay.add_checkbox("Automatically bind starting weapons and items to the quickbar", "auto_quickbar", auto_bind_starting_loadout);
nv_form_checkbox@ f_replace_attachments=gameplay.add_checkbox("Replace an attachment when its slot is already occupied", "replace_attachments", replace_occupied_attachments);
nv_form_checkbox@ f_remember=interface_page.add_checkbox("Remember me; save account on exit", "remember", remember_me);
nv_form_checkbox@ f_wrap=interface_page.add_checkbox("Wrap around at menu edges", "wrap", menu_wrap_enabled);
nv_form_checkbox@ f_autolog=interface_page.add_checkbox("Automatically export message buffers on exit", "autolog", auto_log_buffers);
nv_form_checkbox@ f_classic_menu=interface_page.add_checkbox("Use classic single-list main menu", "classic_menu", classic_main_menu);
nv_form_checkbox@ f_helper_notifications=interface_page.add_checkbox("Show Windows notifications for private messages, tickets, and server events", "helper_notifications", helper_desktop_notifications);
nv_form_checkbox@ f_helper_tray=interface_page.add_checkbox("Add Windows tray controls for show, hide, and mute", "helper_tray", helper_tray_controls);
nv_form_button@ f_test_notification=interface_page.add_button("Test Windows desktop notifications", "test_notification");
nv_form_checkbox@ f_rctrl=controls_page.add_checkbox("Right Control detection", "rctrl", rctrl==1);
nv_form_checkbox@ f_touch=controls_page.add_checkbox("Simulate Android touch mode for gesture testing", "touch", touch_force_enabled);
nv_form_checkbox@ f_practice_band=controls_page.add_checkbox("Announce screen band in gesture practice mode", "practice_band", gesture_practice_speak_band);
nv_form_checkbox@ f_helper_voice=controls_page.add_checkbox("Enable Windows voice commands", "helper_voice", helper_voice_commands);
nv_form_input@ f_voice_wake=controls_page.add_input("Voice-command wake phrase", "voice_wake", helper_voice_wake_phrase);
nv_form_checkbox@ f_helper_mouse=controls_page.add_checkbox("Use mouse back and forward buttons to change message buffers", "helper_mouse", helper_mouse_shortcuts);
nv_form_button@ f_keybinds=controls_page.add_button("Open key binding editor", "keybinds");
nv_form_button@ f_gestures=controls_page.add_button("View Android touch gestures", "gestures");
nv_form_button@ f_gesture_bindings=controls_page.add_button("Configure and reset Android gesture bindings", "gesture_bindings");
nv_form_checkbox@ f_fullscreen=display_page.add_checkbox("Full-screen low-vision landscape presentation; occupies the focused display", "fullscreen", fullscreen_enabled);
nv_form_checkbox@ f_helper_hud=display_page.add_checkbox("Enable large, high-contrast contextual icons and text", "helper_hud", helper_visual_hud);
nv_form_button@ f_helper_status=display_page.add_button("Open textual game and connection status", "helper_status");
nv_form_checkbox@ f_helper_confine=display_page.add_checkbox("Confine the mouse pointer while the game is focused", "helper_confine", helper_mouse_confined);
nv_form_checkbox@ f_touch_keyboard=display_page.add_checkbox("Use the Infinite Warfare touch keyboard instead of the system keyboard", "touch_keyboard", touch_keyboard_enabled);
nv_form_checkbox@ f_analogue_keyboard=display_page.add_checkbox("Use analogue grid typing instead of explore-by-touch typing", "analogue_keyboard", touch_keyboard_analogue);
nv_form_checkbox@ f_pc_touch_bands=display_page.add_checkbox("Expand all touch bands across the full laptop screen; enables touch mode and full screen", "pc_touch_bands", touch_pc_fullscreen_bands);
nv_form_checkbox@ f_touch_explore=display_page.add_checkbox("Explore menu and audio-form controls by holding, then dragging", "touch_explore", touch_menu_explore_enabled);
nv_form_input@ f_server_address=network_page.add_input("Server address", "server_address", netaddress);
nv_form_input@ f_server_port=network_page.add_input("Server port", "server_port", ""+netport);
nv_form_button@ f_server_manager=null;if(!SCRIPT_COMPILED or dev_unlocked)@f_server_manager=network_page.add_button("Developer server list and manager", "server_manager");
nv_form_button@ f_voice=audio_page.add_button("Voice chat settings and microphone test", "voice_settings");
nv_form_checkbox@ f_own_projectiles=audio_page.add_checkbox("Hear your own projectile flight loops and near-miss sounds", "own_projectiles", hear_own_projectile_audio);
nv_form_checkbox@ f_form_sounds=audio_page.add_checkbox("Play menu navigation and activation sounds in audio forms", "form_sounds", audio_form_sound_feedback);
nv_form_checkbox@ f_reverb=audio_page.add_checkbox("Enable environmental reverb", "reverb", acoustic_reverb_enabled);
nv_form_checkbox@ f_occlusion=audio_page.add_checkbox("Enable wall and doorway sound occlusion", "occlusion", acoustic_occlusion_enabled);
nv_form_input@ f_vol=audio_page.add_input("Master volume, minus 60 to 0", "volume", ""+mastervol);
nv_form_input@ f_gameplay_vol=audio_page.add_input("Weapons, items, and player effects volume, minus 60 to 0", "gameplay_volume", ""+gameplay_volume);
nv_form_input@ f_world_vol=audio_page.add_input("World and positional ambience volume, minus 60 to 0", "world_volume", ""+world_volume);
nv_form_input@ f_interface_vol=audio_page.add_input("Menus and interface volume, minus 60 to 0", "interface_volume", ""+interface_volume);
nv_form_input@ f_notification_vol=audio_page.add_input("Messages and notifications volume, minus 60 to 0", "notification_volume", ""+notification_volume);
nv_form_input@ f_system_volume=audio_page.add_input("Windows application volume, 0 to 100", "system_volume", ""+round(app_volume_percent(),0));
nv_form_button@ f_toggle_system_mute=audio_page.add_button("Mute or restore game audio at the Windows level", "system_mute");
nv_form_button@ f_rerun_setup=interface_page.add_button("Run the first-boot setup wizard again", "rerun_setup");
nv_form_button@ f_save=f.add_button("Save", "save", true);
nv_form_button@ f_close=f.add_button("Cancel", "cancel", false, true);
tabs.focus();
while (true)
{
wait(5);
f.monitor();
if (connected==true)
netloop();
if (controls_page.is_pressed(f_keybinds))
{
options_keybinds();
optionsmenu();
return;
}
if (controls_page.is_pressed(f_gestures))
{
show_android_gestures();
continue;
}
if (controls_page.is_pressed(f_gesture_bindings))
{
gesture_bindings_menu();
continue;
}
if (audio_page.is_pressed(f_voice))
{
voice_settings_menu();
continue;
}
if(@f_server_manager!=null and network_page.is_pressed(f_server_manager)){server_manager();continue;}
if(interface_page.is_pressed(f_test_notification)){helper_test_notification();continue;}
if(display_page.is_pressed(f_helper_status)){helper_visual_status_panel();continue;}
if(audio_page.is_pressed(f_toggle_system_mute)){helper_toggle_app_mute();continue;}
if(interface_page.is_pressed(f_rerun_setup)){first_boot_setup_wizard();reconfigure_nvgt_helpers();optionsmenu();return;}
if (f.is_pressed(f_save))
{
remember_me=f_remember.state;
show_target_hp=f_target_hp.state;
show_damage_readout=f_damage_readout.state;
auto_bind_starting_loadout=f_auto_quickbar.state;
replace_occupied_attachments=f_replace_attachments.state;
hear_own_projectile_audio=f_own_projectiles.state;
audio_form_sound_feedback=f_form_sounds.state;
acoustic_reverb_enabled=f_reverb.state;
acoustic_occlusion_enabled=f_occlusion.state;
rctrl=(f_rctrl.state ? 1 : 0);
menu_wrap_enabled=f_wrap.state;
auto_log_buffers=f_autolog.state;
classic_main_menu=f_classic_menu.state;
touch_force_enabled=f_touch.state;
gesture_practice_speak_band=f_practice_band.state;
bool requested_fullscreen=f_fullscreen.state;
if(requested_fullscreen!=fullscreen_enabled)set_fullscreen_mode(requested_fullscreen,true);
touch_keyboard_enabled=f_touch_keyboard.state;
touch_keyboard_analogue=f_analogue_keyboard.state;
touch_pc_fullscreen_bands=f_pc_touch_bands.state;
touch_menu_explore_enabled=f_touch_explore.state;
helper_visual_hud=f_helper_hud.state;helper_desktop_notifications=f_helper_notifications.state;helper_tray_controls=f_helper_tray.state;helper_voice_commands=f_helper_voice.state;helper_voice_wake_phrase=f_voice_wake.text.trim_whitespace();if(helper_voice_wake_phrase=="")helper_voice_wake_phrase="infinite warfare";helper_mouse_shortcuts=f_helper_mouse.state;helper_mouse_confined=f_helper_confine.state;set_app_volume_percent(string_to_number(f_system_volume.text));
if(helper_visual_hud and !fullscreen_enabled)set_fullscreen_mode(true,true);
if(touch_pc_fullscreen_bands and !system_is_mobile){touch_force_enabled=true;if(!fullscreen_enabled)set_fullscreen_mode(true,true);}
string requested_address=f_server_address.text.trim_whitespace();int requested_port=string_to_number(f_server_port.text);if(requested_address!="")netaddress=requested_address;if(requested_port>0 and requested_port<=65535)netport=requested_port;else speak("Invalid server port; keeping port "+netport+".");
string vol_str=f_vol.text;
int newvol=string_to_number(vol_str);
if (newvol<-60) newvol=-60;
if (newvol>0) newvol=0;
mastervol=newvol;
set_sound_master_volume(mastervol);
gameplay_volume=string_to_number(f_gameplay_vol.text); if(gameplay_volume<-60) gameplay_volume=-60; if(gameplay_volume>0) gameplay_volume=0;
world_volume=string_to_number(f_world_vol.text); if(world_volume<-60) world_volume=-60; if(world_volume>0) world_volume=0;
interface_volume=string_to_number(f_interface_vol.text); if(interface_volume<-60) interface_volume=-60; if(interface_volume>0) interface_volume=0;
notification_volume=string_to_number(f_notification_vol.text); if(notification_volume<-60) notification_volume=-60; if(notification_volume>0) notification_volume=0;
gameplay_mixer.volume=gameplay_volume;
world_mixer.volume=world_volume;
interface_mixer.volume=interface_volume;
notification_mixer.volume=notification_volume;
reconfigure_nvgt_helpers();
writeprefs();
p.play_stationary("savedoptions.ogg",false);
speak("Options saved.");
break;
}
else if (f.is_pressed(f_close))
break;
}
}
// ---------------------------------------------------------------------------
// Administrator Panel (only available when running from source)
// Connects to the server to verify admin/dev status, then provides
// authorization mode toggle, unauthenticated player list, and
// password reset request viewer.
// ---------------------------------------------------------------------------
void adminpanel()
{
if(name=="" or !account_exists(name))
{
dlg("You must be logged into an account to access the admin panel.");
mainmenu();
return;
}
speak("Connecting to server to verify administrator access, please wait.");
network an;
an.setup_client(1, 100);
an.connect(netaddress, netport);
bool verified=false;
bool current_authmode=false;
timer ct;
while(ct.elapsed<5000)
{
wait(5);
network_event ev=an.request();
if(ev.type==event_connect)
{
string msg_str="admin_panel "+comp+" "+name;
string msg=string_encrypt(msg_str, "_';'_clickclick!");
an.send_reliable(0, msg, 0);
timer rt;
while(rt.elapsed<3000)
{
wait(5);
ev=an.request();
if(ev.type==event_receive)
{
string r=ev.message;
if(r!="") r=string_decrypt(r, "masonandsamare2bitches");
if(string_contains(r, "admin_panel_ok ", 1)==0)
{
verified=true;
current_authmode=(string_replace(r, "admin_panel_ok ", "", false)=="1");
break;
}
else if(r=="admin_panel_denied")
{
dlg("Access denied. You are not an administrator.");
mainmenu();
return;
}
}
}
break;
}
if(ev.type==event_disconnect)
break;
}
if(!verified)
{
dlg("Could not verify administrator access. The server may be offline.");
mainmenu();
return;
}
// Categorized NV_form property sheet.
nv_form f;
f.create_window("Administrator Panel", false, true);
nv_form_tab_control@ tabs=nv_form_tab_control(@f, "Categories", "admin_categories", true);
f.add_control(tabs);
nv_form_tab_page@ accounts=tabs.add_tab_page("Accounts and authorization");
nv_form_tab_page@ services=tabs.add_tab_page("Player services");
nv_form_tab_page@ developer=tabs.add_tab_page("Developer access");
nv_form_checkbox@ f_authmode=accounts.add_checkbox("Authorization mode; new accounts require approval", "authmode", current_authmode);
nv_form_button@ f_save_auth=accounts.add_button("Save authorization mode", "save_auth");
nv_form_button@ f_viewunauth=accounts.add_button("View unauthenticated players", "unauth");
nv_form_button@ f_viewresets=accounts.add_button("View password reset requests", "resets");
nv_form_button@ f_tickets=services.add_button("Manage support tickets", "tickets");
nv_form_button@ f_devkey=developer.add_button("Enter developer unlock key", "devkey");
nv_form_button@ f_release=null;
if(!SCRIPT_COMPILED)@f_release=developer.add_button("Compress a release build", "release_build");
nv_form_button@ f_close=f.add_button("Close", "close", false, true);
tabs.focus();
while(true)
{
wait(5);
f.monitor();
if(@f_release!=null and developer.is_pressed(f_release)){compress_release_build();return;}
if (accounts.is_pressed(f_save_auth))
{
string val=(f_authmode.state ? "1" : "0");
string msg_str="admin_set_authmode "+val+" "+comp+" "+name;
string msg=string_encrypt(msg_str, "_';'_clickclick!");
an.send_reliable(0, msg, 0);
timer rt;
bool saved=false;
while(rt.elapsed<3000)
{
wait(5);
network_event ev=an.request();
if(ev.type==event_receive)
{
string r=ev.message;
if(r!="") r=string_decrypt(r, "masonandsamare2bitches");
if(r=="admin_authmode_saved")
{
saved=true;
break;
}
}
}
if(saved)
speak("Authorization mode "+(f_authmode.state ? "enabled" : "disabled")+" and saved.");
else
dlg("Failed to save setting. Server may not have responded.");
}
else if (accounts.is_pressed(f_viewunauth))
{
string msg_str="admin_get_unauth "+comp+" "+name;
string msg=string_encrypt(msg_str, "_';'_clickclick!");
an.send_reliable(0, msg, 0);
string data="";
timer rt;
while(rt.elapsed<3000)
{
wait(5);
network_event ev=an.request();
if(ev.type==event_receive)
{
string r=ev.message;
if(r!="") r=string_decrypt(r, "masonandsamare2bitches");
if(string_contains(r, "admin_unauth_list ", 1)==0)
{
data=string_replace(r, "admin_unauth_list ", "", false);
break;
}
}
}
// Show unauthenticated players in a sub-form
iw_form uf;
uf.create_window("Unauthenticated Players", false, true);
if(data=="")
{
uf.create_input_box("Info", "No unauthenticated players found.", "", 0, false, true, false);
}
else
{
string[] entries=string_split(data, ",", false);
for(uint i=0; i<entries.length(); i++)
{
string[] parts=string_split(entries[i], "|", false);
if(parts.length()<2) continue;
uf.create_input_box(parts[0], "Code: "+parts[1], "", 0, false, true, false);
}
}
int uf_close=uf.create_button("&Close", true, true);
uf.focus(0);
while(true)
{
wait(5);
uf.monitor();
if(uf.is_pressed(uf_close))
break;
}
}
else if (accounts.is_pressed(f_viewresets))
{
string msg_str="admin_get_resets "+comp+" "+name;
string msg=string_encrypt(msg_str, "_';'_clickclick!");
an.send_reliable(0, msg, 0);
string data="";
timer rt;
while(rt.elapsed<3000)
{
wait(5);
network_event ev=an.request();
if(ev.type==event_receive)
{
string r=ev.message;
if(r!="") r=string_decrypt(r, "masonandsamare2bitches");
if(string_contains(r, "admin_reset_list ", 1)==0)
{
data=string_replace(r, "admin_reset_list ", "", false);
break;
}
}
}
// Show password reset requests in a sub-form
iw_form rf;
rf.create_window("Password Reset Requests", false, true);
if(data=="")
{
rf.create_input_box("Info", "No pending password reset requests.", "", 0, false, true, false);
}
else
{
string[] entries=string_split(data, ",", false);
for(uint i=0; i<entries.length(); i++)
{
string[] parts=string_split(entries[i], "|", false);
if(parts.length()<2) continue;
rf.create_input_box(parts[0], "Reset code: "+parts[1], "", 0, false, true, false);
}
}
int rf_close=rf.create_button("&Close", true, true);
rf.focus(0);
while(true)
{
wait(5);
rf.monitor();
if(rf.is_pressed(rf_close))
break;
}
}
else if (services.is_pressed(f_tickets))
{
admin_support_tickets(an, comp);
}
else if(developer.is_pressed(f_devkey))
{
string key=af_input("Enter developer unlock key");
if(key!="")
{
if(key!=CLIENT_DEV_KEY)
{
dlg("Incorrect key.");
}
else
{
string msg_str="dev_validate_key "+key+" "+name;
string msg=string_encrypt(msg_str, "_';'_clickclick!");
an.send_reliable(0, msg, 0);
timer kt;
bool got_response=false;
while(kt.elapsed<3000)
{
wait(5);
network_event ev=an.request();
if(ev.type==event_receive)
{
string r=ev.message;
if(r!="") r=string_decrypt(r, "masonandsamare2bitches");
if(r=="dev_key_ok")
{
dev_unlocked=true;
dlg("Developer access unlocked. You may now connect with any account.");
got_response=true;
break;
}
else if(r=="dev_key_denied")
{
dlg("Key validation failed.");
got_response=true;
break;
}
}
}
if(!got_response)
dlg("Server did not respond to key validation.");
}
}
}
else if (f.is_pressed(f_close))
{
break;
}
}
mainmenu();
}
void ingame_adminpanel()
{
speak("Verifying administrator access, please wait.");
send_reliable(0, "admin_panel "+comp+" "+name, 0);
bool verified=false;
bool current_authmode=false;
timer ct;
while(ct.elapsed<3000)
{
wait(5);
e=n.request();
if(e.type==event_receive)
{
string msg=get_event_message();
if(string_contains(msg, "admin_panel_ok ", 1)==0)
{
verified=true;
current_authmode=(string_replace(msg, "admin_panel_ok ", "", false)=="1");
break;
}
else if(msg=="admin_panel_denied")
{
dlg("Access denied. You are not an administrator.");
return;
}
}
if(e.type==event_disconnect)
{
speak("Disconnected from server.");
return;
}
}
if(!verified)
{
dlg("Could not verify administrator access. The server may not have responded.");
return;
}
nv_form f;
f.create_window("Administrator Panel", false, true);
nv_form_tab_control@ tabs=nv_form_tab_control(@f, "Categories", "admin_categories", true);
f.add_control(tabs);
nv_form_tab_page@ accounts=tabs.add_tab_page("Accounts and authorization");
nv_form_tab_page@ services=tabs.add_tab_page("Player services");
nv_form_tab_page@ developer=tabs.add_tab_page("Developer access");
nv_form_checkbox@ f_authmode=accounts.add_checkbox("Authorization mode; new accounts require approval", "authmode", current_authmode);
nv_form_button@ f_save_auth=accounts.add_button("Save authorization mode", "save_auth");
nv_form_button@ f_viewunauth=accounts.add_button("View unauthenticated players", "unauth");
nv_form_button@ f_viewresets=accounts.add_button("View password reset requests", "resets");
nv_form_button@ f_tickets=services.add_button("Manage support tickets", "tickets");
nv_form_button@ f_devkey=developer.add_button("Enter developer unlock key", "devkey");
nv_form_button@ f_close=f.add_button("Close", "close", false, true);
tabs.focus();
while(true)
{
wait(5);
f.monitor();
if(connected==true) netloop();
if(accounts.is_pressed(f_save_auth))
{
string val=(f_authmode.state ? "1" : "0");
send_reliable(0, "admin_set_authmode "+val+" "+comp+" "+name, 0);
timer rt;
bool saved=false;
while(rt.elapsed<3000)
{
wait(5);
e=n.request();
if(e.type==event_receive)
{
string msg=get_event_message();
if(msg=="admin_authmode_saved")
{
saved=true;
break;
}
}
}
if(saved)
speak("Authorization mode "+(f_authmode.state ? "enabled" : "disabled")+" and saved.");
else
dlg("Failed to save setting. Server may not have responded.");
}
else if(accounts.is_pressed(f_viewunauth))
{
send_reliable(0, "admin_get_unauth "+comp+" "+name, 0);
string data="";
timer rt;
while(rt.elapsed<3000)
{
wait(5);
e=n.request();
if(e.type==event_receive)
{
string msg=get_event_message();
if(string_contains(msg, "admin_unauth_list ", 1)==0)
{
data=string_replace(msg, "admin_unauth_list ", "", false);
break;
}
}
}
iw_form uf;
uf.create_window("Unauthenticated Players", false, true);
if(data=="")
{
uf.create_input_box("Info", "No unauthenticated players found.", "", 0, false, true, false);
}
else
{
string[] entries=string_split(data, ",", false);
for(uint i=0; i<entries.length(); i++)
{
string[] parts=string_split(entries[i], "|", false);
if(parts.length()<2) continue;
uf.create_input_box(parts[0], "Code: "+parts[1], "", 0, false, true, false);
}
}
int uf_close=uf.create_button("&Close", true, true);
uf.focus(0);
while(true)
{
wait(5);
uf.monitor();
if(connected==true) netloop();
if(uf.is_pressed(uf_close))
break;
}
}
else if(accounts.is_pressed(f_viewresets))
{
send_reliable(0, "admin_get_resets "+comp+" "+name, 0);
string data="";
timer rt;
while(rt.elapsed<3000)
{
wait(5);
e=n.request();
if(e.type==event_receive)
{
string msg=get_event_message();
if(string_contains(msg, "admin_reset_list ", 1)==0)
{
data=string_replace(msg, "admin_reset_list ", "", false);
break;
}
}
}
iw_form rf;
rf.create_window("Password Reset Requests", false, true);
if(data=="")
{
rf.create_input_box("Info", "No pending password reset requests.", "", 0, false, true, false);
}
else
{
string[] entries=string_split(data, ",", false);
for(uint i=0; i<entries.length(); i++)
{
string[] parts=string_split(entries[i], "|", false);
if(parts.length()<2) continue;
rf.create_input_box(parts[0], "Reset code: "+parts[1], "", 0, false, true, false);
}
}
int rf_close=rf.create_button("&Close", true, true);
rf.focus(0);
while(true)
{
wait(5);
rf.monitor();
if(connected==true) netloop();
if(rf.is_pressed(rf_close))
break;
}
}
else if(services.is_pressed(f_tickets))
{
support_view_all_tickets();
return;
}
else if(developer.is_pressed(f_devkey))
{
string key=af_input("Enter developer unlock key", "", true);
if(key!="")
{
if(key!=CLIENT_DEV_KEY)
{
dlg("Incorrect key.");
}
else
{
send_reliable(0, "dev_validate_key "+key+" "+name, 0);
timer kt;
bool got_response=false;
while(kt.elapsed<3000)
{
wait(5);
e=n.request();
if(e.type==event_receive)
{
string msg=get_event_message();
if(msg=="dev_key_ok")
{
dev_unlocked=true;
dlg("Developer access unlocked. You may now connect with any account.");
got_response=true;
break;
}
else if(msg=="dev_key_denied")
{
dlg("Key validation failed.");
got_response=true;
break;
}
}
}
if(!got_response)
dlg("Server did not respond to key validation.");
}
}
}
else if(f.is_pressed(f_close))
return;
}
}
int yesno(string question)
{
setupmenu();
m.add_item_tts("Yes","yes");
m.add_item_tts("No","no");
int mres=m.run(question,true);
if (m.get_item_name(mres)=="yes")
return 1;
else
return 2;
}
int cme(dynamic_menu_pro@ test, string data)
{
if (connected==true)
netloop();
