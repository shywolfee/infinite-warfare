// Lobby system for Infinite Warfare
// After a successful login the player lands here before entering any game mode.
// The lobby has tabs: Modes, Account Info, Players, Rewards.
// Pressing Enter on "Battlegrounds" in the Modes tab enters the game world.
//
// Network notes:
//   - The player is NOT yet in players[] on the server at this point.
//     spawn_player is only sent when entering Battlegrounds (via game()).
//   - lobby_form_netcheck() keeps the connection alive during form event loops.

// ---------------------------------------------------------------------------
// Network check used during all lobby forms.
// Keeps the connection alive and handles abnormal server events.
// ---------------------------------------------------------------------------
timer lobby_keepalive_timer;
bool lobby_typing_chat=false;
bool player_profile_received=false;
string player_profile_text="";
bool server_accounts_list_received=false;
bool server_account_detail_received=false;
string[] server_account_names;
string server_account_detail_text="";
string server_accounts_error="";

string player_name_from_list_label(string label)
{int dash=string_contains(label," - ",1);if(dash>0)label=string_left(label,dash);int flags=string_contains(label," (",1);if(flags>0)label=string_left(label,flags);return label.trim_whitespace();}

void receive_player_profile(string message)
{player_profile_text=string_replace(string_replace(message,"player_profile_response ","",false),"<<NL>>","\n",true);player_profile_received=true;}

void receive_server_accounts(string message)
{
if(string_contains(message,"accounts_error ",1)==0){server_accounts_error=string_replace(message,"accounts_error ","",false);server_accounts_list_received=true;server_account_detail_received=true;return;}
if(string_contains(message,"accounts_list_response",1)==0){server_account_names.resize(0);string data=string_replace(message,"accounts_list_response","",false).trim_whitespace();if(data!="")server_account_names=string_split(data,"|",true);server_accounts_list_received=true;return;}
if(string_contains(message,"account_detail_response ",1)==0){server_account_detail_text=string_replace(string_replace(message,"account_detail_response ","",false),"<<NL>>","\n",true);server_account_detail_received=true;}
}

void server_accounts_network_pump(){if(mapname=="main")lobby_form_netcheck();else netloop(false);}

void show_server_accounts()
{
server_accounts_list_received=false;server_accounts_error="";server_account_names.resize(0);send_reliable(0,"accounts_list",0);timer request;
while(connected and !server_accounts_list_received and request.elapsed<4000){wait(5);server_accounts_network_pump();}
if(server_accounts_error!=""){speak(server_accounts_error);return;}if(!server_accounts_list_received){speak("The account list request timed out.");return;}if(server_account_names.length()==0){speak("There are no registered accounts.");return;}
nv_form f;f.create_window("Server accounts",false,true);nv_form_list_box@ accounts=f.add_list("Registered accounts","accounts");for(uint i=0;i<server_account_names.length();i++)accounts.add(server_account_names[i],server_account_names[i]);nv_form_button@ view=f.add_button("View selected account","view",true);nv_form_button@ close=f.add_button("Close","close",false,true);f.focus_control(accounts);
while(true){wait(5);f.monitor();if(connected)server_accounts_network_pump();if(f.is_pressed(close))return;if(f.is_pressed(view)){int selected=accounts.list_position;if(selected<0 or selected>=int(server_account_names.length())){speak("Select an account first.");continue;}server_account_detail_received=false;server_account_detail_text="";server_accounts_error="";send_reliable(0,"account_detail "+server_account_names[selected],0);timer detail_request;while(connected and !server_account_detail_received and detail_request.elapsed<4000){wait(5);server_accounts_network_pump();}if(server_accounts_error!="")speak(server_accounts_error);else if(!server_account_detail_received)speak("The account detail request timed out.");else show_readonly_audio_form(server_account_names[selected]+" account",server_account_detail_text);}}
}

void send_global_chat_or_command(string text)
{
text=text.trim_whitespace();if(text=="")return;if(handle_local_chat_form_command(text))return;if(string_to_lower_case(text)=="/changes")show_changelog_form();else if(string_to_lower_case(text)=="/accounts")show_server_accounts();else if(string_to_lower_case(text)=="/credits")send_reliable(0,"account_balance",0);else send_reliable(0,text,1);
}

void show_player_profile(string selected_name)
{
if(selected_name=="")return;player_profile_received=false;player_profile_text="";send_reliable(0,"player_profile "+selected_name,0);timer timeout;
while(!player_profile_received and timeout.elapsed<3500){wait(5);if(mapname=="main")lobby_form_netcheck();else netloop(false);}
if(!player_profile_received){speak("The player profile request timed out.");return;}
show_readonly_audio_form(selected_name+" profile",player_profile_text);
}

void lobby_chat_prompt()
{
nv_form chat_form;
lobby_typing_chat=true;
chat_form.create_window("Lobby chat", false, true);
nv_form_input@ message=chat_form.add_input("Message", "message");
nv_form_button@ send=chat_form.add_button("Send", "send", true);
nv_form_button@ cancel=chat_form.add_button("Cancel", "cancel", false, true);
message.focus();
while (true)
{
wait(5);
chat_form.monitor();
lobby_form_netcheck();
if (chat_form.is_pressed(cancel))
{
lobby_typing_chat=false;
return;
}
if (chat_form.is_pressed(send))
{
string text=message.text.trim_whitespace();
if (text!="") send_global_chat_or_command(text);
lobby_typing_chat=false;
return;
}
}
}

void lobby_buffer_controls()
{
if(kb_action_pressed("chat")) lobby_chat_prompt();
chat_channel_shortcuts();
if (key_pressed(kb("buffer_left")))
{
if (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT)) firstbuffer();
else bufferleft();
}
if (key_pressed(kb("buffer_right")))
{
if (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT)) lastbuffer();
else bufferright();
}
if (key_pressed(KEY_COMMA))
{
if (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT)) topbufferitem();
else prevbufferitem();
}
if (key_pressed(KEY_PERIOD))
{
if (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT)) bottombufferitem();
else nextbufferitem();
}
if(kb_action_pressed("buffer_manager"))buffer_manage_menu();
if ((key_down(KEY_LMENU) or key_down(KEY_RMENU)) and (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT)) and key_pressed(KEY_C)) review_buffer_item();
if (key_pressed(KEY_DELETE)) buffer_item_action_menu();
}

void lobby_form_netcheck()
{
if (lobby_keepalive_timer.elapsed>3000)
{
lobby_keepalive_timer.restart();
// Channel 19 is reserved for silent transport health checks.  Keeping this
// traffic away from gameplay/chat channels prevents it surfacing as a user
// packet while still allowing forms to detect a dead connection.
send_reliable(0, "transport_ping", 19);
}
e=n.request();
if (e.type==event_disconnect or (connected and last_server_msg.elapsed>8000))
{
speak("You have been disconnected from the server.");
connected=false;
prevconnected=false;
pinging=false;
distpool.destroy_all();ambpool.destroy_all();
p.destroy_all();
sources.resize(0);
can_move=true;
dlg("Connection to the server was lost. Press Enter to return to the main menu.");
mainmenu();
}
if (e.type==event_receive)
{
last_server_msg.restart();
string msg=get_event_message();
if (e.channel==19)
{
// Transport acknowledgements deliberately have no UI or buffer presence.
}
else if (e.channel==1)
{
p.play_stationary("chat.ogg", false);
add_buffer_item("chats", msg);
}
else if (e.channel==2)
{remember_pm_sender(msg);if(string_contains(msg,"Team: ",1)==0)p.play_stationary("teamchat.ogg",false);add_buffer_item("misc", msg);}
else if (msg=="updating")
{
dlg("The server is restarting for an update. Please reconnect shortly.");
connected=false;
prevconnected=false;
pinging=false;
distpool.destroy_all();ambpool.destroy_all();
p.destroy_all();
sources.resize(0);
can_move=true;
mainmenu();
}
else if (string_contains(msg, "lobby_credits ", 1)==0)
lobby_credits_reply=msg.substr(14);
else if (string_contains(msg, "server_status ", 1)==0)
speak(string_replace(msg, "server_status ", "", false));
else if(string_contains(msg,"player_profile_response ",1)==0)
receive_player_profile(msg);
else if(string_contains(msg,"accounts_list_response",1)==0 or string_contains(msg,"account_detail_response ",1)==0 or string_contains(msg,"accounts_error ",1)==0)
receive_server_accounts(msg);
else if (msg=="ping" and pinging)
{
p.play_stationary("pingstop.ogg", false);
int sample=int(pingtimer.elapsed);
ping_samples.insert_last(sample);
int lowest=ping_samples[0], highest=ping_samples[0], total=0;
for (uint i=0; i<ping_samples.length(); i++) { if (ping_samples[i]<lowest) lowest=ping_samples[i]; if (ping_samples[i]>highest) highest=ping_samples[i]; total+=ping_samples[i]; }
speak("Ping "+sample+" milliseconds. Lowest "+lowest+", highest "+highest+", average "+(total/int(ping_samples.length()))+" across "+ping_samples.length()+" samples.");
pinging=false;
}
else if (string_contains(msg, "server message:", 1)==0 or string_contains(msg, "no message of the day", 1)==0)
speak(msg);
}
if (!lobby_typing_chat) lobby_buffer_controls();
}

// ---------------------------------------------------------------------------
// Wait for the server to send map data after entering a mode.
// Processes incoming mapdata and coordinate messages before game() starts.
// ---------------------------------------------------------------------------
void lobby_wait_for_map()
{
bool got_map=false;
bool got_x=false;
bool got_y=false;
bool got_z=false;
timer mwait;
while(mwait.elapsed < 3000)
{
wait(5);
e=n.request();
if(e.type==event_disconnect)
{
speak("You have been disconnected from the server.");
connected=false;
prevconnected=false;
pinging=false;
distpool.destroy_all();ambpool.destroy_all();
p.destroy_all();
sources.resize(0);
can_move=true;
mainmenu();
return;
}
if(e.type==event_receive)
{
string msg=get_event_message();
string[] parsed=string_split(msg, " ", false);
if (e.channel==1)
{
p.play_stationary("chat.ogg", false);
add_buffer_item("chats", msg);
continue;
}
if (e.channel==2)
{
remember_pm_sender(msg);
if(string_contains(msg,"Team: ",1)==0)p.play_stationary("teamchat.ogg",false);
add_buffer_item("misc", msg);
continue;
}
if(parsed[0]=="mapdata")
{
load_map(string_replace(msg, "mapdata ", "", false));
spawn_vehicles_on_map();
register_vehicles_with_server();
got_map=true;
}
else if(parsed[0]=="x")
{
me.x=string_to_number(parsed[1]);
mr.x=me.x;
got_x=true;
}
else if(parsed[0]=="y")
{
me.y=string_to_number(parsed[1]);
mr.y=me.y;
got_y=true;
}
else if(parsed[0]=="z")
{
me.z=string_to_number(parsed[1]);
got_z=true;
}
}
if(got_map and got_x and got_y and got_z) break;
}
}

// ---------------------------------------------------------------------------
// Deploy into a mode: request the map, wait for it, and enter the world.
// ---------------------------------------------------------------------------
void deploy_to_mode(string mode_id, string announce)
{
send_reliable(0, "enter_mode "+mode_id, 0);
speak(announce);
lobby_wait_for_map();
game(1);
}

// ---------------------------------------------------------------------------
// Free for All map picker.
// Every map is a free for all map; this submenu chooses which one to play.
// Returns true if the player deployed (the caller should close), false if the
// player backed out.
// ---------------------------------------------------------------------------
// The four maps, with what each one is, in one place so the lobby list and
// the older picker say the same thing.
class lobby_map
{
string id,title,summary,announce;
lobby_map(const string &in i,const string &in t,const string &in s,const string &in a){id=i;title=t;summary=s;announce=a;}
}
lobby_map@[] lobby_maps()
{
lobby_map@[] m;
m.insert_last(lobby_map("freeforall","Ghost Town","an abandoned modern city: six avenues by six streets, a river, a viaduct, a cathedral and a foundry","Deploying to Ghost Town."));
m.insert_last(lobby_map("battlegrounds","Shattersea","nine islands in a tidal sea, joined by twelve bridges, with the old city under water","Deploying to Shattersea."));
m.insert_last(lobby_map("freyas_ascent","Freya's Ascent","a city climbing a mountain on six terraces, with an orbital ring above it","Deploying to Freya's Ascent."));
m.insert_last(lobby_map("habitat_alpha","Coruscant","six levels of the Galactic City, from Level 1313 up to the Senate and the Jedi Temple","Deploying to Coruscant."));
return m;
}

bool freeforall_map_select()
{
nv_form f;
f.create_window("Choose a map",false,true);
nv_form_list_box@ list=f.add_list("Maps","maps");
lobby_map@[] maps=lobby_maps();
for(uint i=0;i<maps.length();i++)list.add(maps[i].title+": "+maps[i].summary,maps[i].id);
nv_form_button@ go=f.add_button("Deploy","deploy",true);
nv_form_button@ back=f.add_button("Back","back",false,true);
f.focus_control(list);
while(true)
{
wait(5);
f.monitor();
lobby_form_netcheck();
if(f.is_pressed(back))return false;
if(f.is_pressed(go) and @list.focused_item!=null)
{
for(uint i=0;i<maps.length();i++)if(maps[i].id==list.focused_item.id){deploy_to_mode(maps[i].id,maps[i].announce);return true;}
}
}
return false;
}

// ---------------------------------------------------------------------------
// Tab: Modes
// Free for All is the only mode; picking it opens the map selection submenu.
// ---------------------------------------------------------------------------
void modes_tab()
{
iw_form f;
f.create_window("Modes", false, true);
int f_ffa=f.create_button("&Free for All - Battle everyone across a choice of maps", true);
int f_back=f.create_button("Go &back", false, true);
f.focus(f_ffa);
while(true)
{
wait(5);
f.monitor();
lobby_form_netcheck();
if (f.is_pressed(f_ffa))
{
if (freeforall_map_select())
return;
}
else if (f.is_pressed(f_back))
{
return;
}
}
}

// A screen of facts: one line per fact in a list, so arrows read them one at
// a time and Escape or Enter closes. These screens used to be stacks of
// read-only edit boxes, which a screen reader announces as editable, which
// Tab had to be pressed through one at a time, and which cut long lines off.
void show_info_list(const string &in title,string[]@ lines)
{
nv_form f;
f.create_window(title,false,true);
nv_form_list_box@ list=f.add_list(title,"info");
for(uint i=0;i<lines.length();i++)list.add(lines[i],"line"+i);
nv_form_button@ close=f.add_button("Close","close",true,true);
f.focus_control(list);
while(true)
{
wait(5);
f.monitor();
if(mapname=="main")lobby_form_netcheck();else netloop(false);
if(f.is_pressed(close))return;
}
}

string lobby_credits_reply="";
void account_tab()
{
lobby_credits_reply="";
send_reliable(0,"lobby_credits",0);
timer ct;
while(lobby_credits_reply=="" and ct.elapsed<3000)
{
wait(5);
lobby_form_netcheck();
}
string[] lines;
lines.insert_last("Name: "+name);
if(account_exists(name))
{
savedata acct(get_account_path(name),ACCOUNT_SECRET);
acct.load();
string em=acct.read("email");
lines.insert_last("Registered account"+(em!=""?", email "+em:", no email on file"));
}
else lines.insert_last("No registered account. Create one from the main menu to keep your credits and items.");
lines.insert_last(lobby_credits_reply==""?"Credits: the server did not answer in time.":"Credits: "+lobby_credits_reply);
show_info_list("Your account",lines);
}

// ---------------------------------------------------------------------------
// Fetch structured player data from the server.
// Returns an array of "name - status" strings parsed from lobby_plist.
// ---------------------------------------------------------------------------
string[] fetch_player_list()
{
string[] result;
send_reliable(0, "lobby_playerlist", 0);
string data="";
timer pt;
while (pt.elapsed<3000)
{
wait(5);
e=n.request();
if (e.type==event_disconnect)
{
speak("Disconnected from server.");
connected=false;
prevconnected=false;
pinging=false;
distpool.destroy_all();ambpool.destroy_all();
p.destroy_all();
sources.resize(0);
can_move=true;
mainmenu();
return result;
}
if (e.type==event_receive)
{
string msg=get_event_message();
if (e.channel==1)
{
p.play_stationary("chat.ogg", false);
add_buffer_item("chats", msg);
continue;
}
if (e.channel==2)
{
remember_pm_sender(msg);
if(string_contains(msg,"Team: ",1)==0)p.play_stationary("teamchat.ogg",false);
add_buffer_item("misc", msg);
continue;
}
if (string_contains(msg, "lobby_plist ", 1)==0)
{
data=string_replace(msg, "lobby_plist ", "", false);
break;
}
}
}
if (data=="")
return result;
string[] entries=string_split(data, ",", false);
for(uint i=0; i<entries.length(); i++)
{
string[] parts=string_split(entries[i], "|", false);
if(parts.length()<3) continue;
string label=parts[0];
if(string_contains(parts[1], "d", 1)>-1)
label+=" (dev)";
if(string_contains(parts[1], "a", 1)>-1)
label+=" (admin)";
label+=" - "+map_display_name(parts[2]);
result.insert_last(label);
}
return result;
}
// ---------------------------------------------------------------------------
// Display a player list in a standard audio-form list.
// Used by Players tab, F1 player list, and T tracking menu.
// If allow_tracking is true, adds Track and Stop Tracking buttons.
// ---------------------------------------------------------------------------
void show_player_list_form(string title, string[] plist, bool allow_tracking=false)
{
// Failsafe: never let players track themselves. The tracking menu shares its
// player list with the plain player list, so when tracking is enabled we
// drop the local player's own entry before displaying the list.
string[] shown;
for(uint i=0; i<plist.length(); i++)
{
if (allow_tracking)
{
string pn=plist[i];
int dash=string_contains(pn, " - ", 1);
if(dash>0) pn=string_left(pn, dash);
int sp=string_contains(pn, " (", 1);
if(sp>0) pn=string_left(pn, sp);
if(string_to_lower_case(pn)==string_to_lower_case(name)) continue;
}
shown.insert_last(plist[i]);
}
// Android keeps its purpose-built touch list; desktop uses NV_form.
if (is_android())
{
if (shown.length()==0)
{
android_message(title, "No players are currently online.");
return;
}
string[] opts=shown;
if (allow_tracking)
{
opts.insert_last("Stop tracking");
}
int sel=android_select(title, opts);
if (sel<0) return;
if (allow_tracking and sel==int(shown.length()))
{
speak("Stopped tracking.");
tracking="";
return;
}
if (allow_tracking and sel>=0 and sel<int(shown.length()))
{
string sel_name=shown[sel];
int dash=string_contains(sel_name, " - ", 1);
if(dash>0) sel_name=string_left(sel_name, dash);
int space=string_contains(sel_name, " (", 1);
if(space>0) sel_name=string_left(sel_name, space);
p.play_stationary("executioners_rage/track.wav", false);
speak("You are now tracking "+sel_name);
tracking=sel_name;
}
else if(!allow_tracking and sel>=0 and sel<int(shown.length()))
show_player_profile(player_name_from_list_label(shown[sel]));
return;
}
iw_form f;
f.create_window(title, false, true);
int f_list=f.create_list("Players", 0, false);
if (shown.length()==0)
f.add_list_item(f_list, "No players are currently online.");
else
{
for(uint i=0; i<shown.length(); i++)
f.add_list_item(f_list, shown[i]);
}
int f_track=-1;
int f_stop=-1;
int f_profile=-1;
int f_report=-1;
if(shown.length()>0)f_profile=f.create_button("&View Profile");
if(shown.length()>0)f_report=f.create_button("&Report Player");
if (allow_tracking and shown.length()>0)
{
f_track=f.create_button("&Track");
f_stop=f.create_button("&Stop Tracking");
}
int f_close=f.create_button("&Close", true, true);
f.focus(f_list);
while(true)
{
wait(5);
f.monitor();
if (connected)
{
if (allow_tracking)
{
netloop();
fallloop();
}
else lobby_form_netcheck();
}
if (f_track>-1 and f.is_pressed(f_track))
{
int sel=f.get_list_position(f_list);
if(sel>=0 and sel<int(shown.length()))
{
string sel_name=shown[sel];
int dash=string_contains(sel_name, " - ", 1);
if(dash>0)
sel_name=string_left(sel_name, dash);
int space=string_contains(sel_name, " (", 1);
if(space>0)
sel_name=string_left(sel_name, space);
p.play_stationary("executioners_rage/track.wav", false);
speak("You are now tracking "+sel_name);
tracking=sel_name;
return;
}
}
if(f_profile>-1 and f.is_pressed(f_profile))
{
int sel=f.get_list_position(f_list);if(sel>=0 and sel<int(shown.length()))show_player_profile(player_name_from_list_label(shown[sel]));
}
if(f_report>-1 and f.is_pressed(f_report))
{
int sel=f.get_list_position(f_list);if(sel>=0 and sel<int(shown.length())){string target=player_name_from_list_label(shown[sel]);string reason=af_input("Reason for reporting "+target,"",true).trim_whitespace();if(reason!="")send_reliable(0,"/report "+target+" "+reason,1);}
}
if (f_stop>-1 and f.is_pressed(f_stop))
{
speak("Stopped tracking.");
tracking="";
return;
}
if (f.is_pressed(f_close))
return;
}
}
// ---------------------------------------------------------------------------
// Tab: Players
// Requests the structured player list from the server.
// ---------------------------------------------------------------------------
void players_tab()
{
speak("Fetching player list, please wait.");
string[] plist=fetch_player_list();
show_player_list_form("Players", plist);
}

void rewards_tab()
{
string[] lines={
"3 kills in one life: 5 frag grenades.",
"5 kills in one life: a bottle of Trauma Repair Serum and 40 credits.",
"10 kills in one life: 75 credits.",
"Every kill also earns 10 to 20 credits, which count towards your team's points.",
"Each reward comes once per life. Dying and redeploying starts the count again; being revived does not."
};
show_info_list("Killstreak rewards",lines);
}

// ---------------------------------------------------------------------------
// F1 Player List
// Uses the shared fetch and display functions for consistency.
// ---------------------------------------------------------------------------
void lobby_player_list()
{
speak("Fetching player list, please wait.");
string[] plist=fetch_player_list();
show_player_list_form("Players Online", plist);
}

// ---------------------------------------------------------------------------
// Leave the lobby cleanly without having entered the game.
// Sets prevconnected=false so the next connect() starts fresh.
// ---------------------------------------------------------------------------
void leave_lobby()
{
if (auto_log_buffers)
auto_export_buffers();
send_reliable(0, "leave_lobby", 0);
pinging=false;
distpool.destroy_all();ambpool.destroy_all();
p.destroy_all();
sources.resize(0);
can_move=true;
connected=false;
prevconnected=false;
mainmenu();
}

// ---------------------------------------------------------------------------
// Main lobby entry point — called right after loggedin123 is received.
// ---------------------------------------------------------------------------
// The lobby, like the main menu, exists once. Dying, being kicked back from a
// match and a match ending all return to the lobby by calling lobby() from
// deep inside the match, and every one of those used to start a new lobby on
// top of the match that had just ended -- which deployed a new match on top of
// that, so each death added another match's worth of stack that never
// unwound. Now the first lobby is the only one: a later call unwinds back to
// it and it opens again.
const string IW_RETURN_TO_LOBBY="iw:return-to-lobby";
bool lobby_running=false;
void lobby()
{
if(lobby_running)throw(IW_RETURN_TO_LOBBY);
lobby_running=true;
while(true)
{
try{lobby_once();}
catch
{
string why=get_exception_info();
if(why==IW_RETURN_TO_LOBBY){reset_service_guards();continue;}
lobby_running=false;
if(why==IW_RETURN_TO_MENU)throw(IW_RETURN_TO_MENU);
write_client_exception_log();
exit();
}
}
}
void lobby_once()
{
ping_samples.resize(0);
send_reliable(0, "enter_lobby "+name+" "+comp, 0);
if(SCRIPT_COMPILED==false)
send_reliable(0, "lobby_is_dev", 0);
lobby_keepalive_timer.restart();
last_server_msg.restart();
play_ui_cue("open");
speak("Lobby. Welcome, "+name+". Choose a map to deploy, or press F1 for who is online. Chat works from here.");
string last="";
// One list: the maps first, because deploying is what the lobby is for, and
// then everything else. It used to be a Modes button that opened a screen
// offering one mode, which opened a screen offering the maps.
while(true)
{
nv_form f;
f.create_window("Lobby",false,false);
nv_form_list_box@ list=f.add_list("Lobby","lobby");
lobby_map@[] maps=lobby_maps();
for(uint i=0;i<maps.length();i++)list.add("Deploy to "+maps[i].title+": "+maps[i].summary,"map:"+maps[i].id);
list.add("Players online","players");
list.add("Your account","account");
list.add("Killstreak rewards","rewards");
list.add("Armoury","armoury");
list.add("Leave the lobby","leave");
for(uint i=0;i<list.items.length();i++)if(list.items[i].id==last)list.set_pos(i);
nv_form_button@ open=f.add_button("Open","open",true);
open.hidden=true;
f.focus_control(list);
string chosen="";
while(chosen=="")
{
wait(5);
f.monitor();
lobby_form_netcheck();
if(key_pressed(KEY_ESCAPE)){list.set_pos(list.items.length()-1,true,true);speak("Leave the lobby");}
else if(key_pressed(kb("player_list")))chosen="players";
else if(key_pressed(kb("motd")))send_reliable(0,"motd",0);
else if(key_pressed(kb("server_uptime")))send_reliable(0,"uptime",0);
else if(key_pressed(kb("ping")) and !pinging)
{
pinging=true;
pingtimer.restart();
p.play_stationary("pingstart.ogg", false);
send_reliable(0, "ping", 0);
}
if(f.is_pressed(open) and @list.focused_item!=null)chosen=list.focused_item.id;
}
last=chosen;
if(chosen.substr(0,4)=="map:")
{
string id=chosen.substr(4);
for(uint i=0;i<maps.length();i++)if(maps[i].id==id){deploy_to_mode(maps[i].id,maps[i].announce);return;}
}
else if(chosen=="players")lobby_player_list();
else if(chosen=="account")account_tab();
else if(chosen=="rewards")rewards_tab();
else if(chosen=="armoury")armoury_database();
else if(chosen=="leave"){leave_lobby();return;}
}
}
