// Sets off every Semtex charge its owner has placed. The controller used to
// detonate whichever charge anyone had placed first.
int detonate_semtex(string owner)
{
int count=0;
for(int i=int(samtexs.length())-1;i>=0;i--)
{
if(samtexs[i].owner!=owner)continue;samtex@ s=samtexs[i];samtexs.remove_at(i);count++;
blast_profile@ b=blast_profile_for("semtex",owner,owner+"'s Semtex");
if(item_prop("semtex","blast_damage")==""){b.damage=850;b.radius=11;b.fragments=0;}
b.explode_sound="semtexexplode";b.distant_sound="semtexdist.ogg";b.hit_sound="semtexhit";b.structure_mult=3;
detonate(s.x,s.y,s.z+.2,s.map,b);
}
return count;
}
