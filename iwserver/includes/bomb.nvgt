bunker@[] bunkers(0);
class bunker
{
string name;
int x;
int y;
int z;
timer healtimer;
string map;
string  owner;
int integrity=1000;
int power=25;
int medical_charges=3;
string capturing_player="";
int capture_progress=0;
timer simulation_timer;
timer power_timer;
timer medical_timer;
timer capture_report_timer;
bunker(int bx,int by,int bz,string bmap,string bowner,string bname)
{
name=bname;
x=bx;
y=by;
z=bz;
map=bmap;
owner=bowner;
}
}
void refresh_bunker_owner_count(int player_index)
{
if(player_index<0 or player_index>=int(players.length()))return;int owned=0;
for(uint b=0;b<bunkers.length();b++)if(bunkers[b].owner==players[player_index].name)owned++;
players[player_index].bunkers_owned=owned;
if(owned>=2 and !players[player_index].has_hypercomp){players[player_index].has_hypercomp=true;send_reliable(players[player_index].peer_id,"give hypercomp 1",0);send_reliable(players[player_index].peer_id,"play_s executioners_rage/ui/achievement.wav",0);send_reliable(players[player_index].peer_id,"You've secured your second bunker and earned a HyperComp structure-management device.",2);}
}
void begin_bunker_capture(int bunker_index,int player_index)
{
if(bunker_index<0 or bunker_index>=int(bunkers.length()) or player_index<0 or player_index>=int(players.length()))return;
bunker@ b=bunkers[bunker_index];
if(b.owner==players[player_index].name){send_reliable(players[player_index].peer_id,"You already own this bunker.",2);return;}
if(b.owner!=""){send_reliable(players[player_index].peer_id,"This bunker is controlled by "+b.owner+". Disable it with a bunker bomb before attempting a capture.",2);return;}
if(b.capturing_player!="" and b.capturing_player!=players[player_index].name){send_reliable(players[player_index].peer_id,b.capturing_player+" is already interfacing with this bunker.",2);return;}
send_reliable(players[player_index].peer_id,"give bunker_key -1",0);b.capturing_player=players[player_index].name;b.capture_progress=0;b.capture_report_timer.restart();play("bunkerbombwarn",b.x,b.y,b.z,b.map);send_reliable(players[player_index].peer_id,"Capture started. Hold the control room for twelve seconds; leaving it or being contested interrupts the handshake.",2);
}
void complete_bunker_capture(bunker@ b,int player_index)
{
b.owner=players[player_index].name;b.capturing_player="";b.capture_progress=0;b.power=25;b.medical_charges=3;b.integrity=1000;
send_reliable(0,"play_s notify.ogg",0);send_reliable(0,b.name+" has been secured by "+players[player_index].name+". Its medical station, sensor grid and reserve power are online.",2);refresh_bunker_owner_count(player_index);
}
ballista@[] ballistas(0);
class ballista
{
int x;
int y;
int z;
string map;
ballista(int bx,int by,int bz,string bmap)
{
x=bx;
y=by;
z=bz;
map=bmap;
}
}
void bunkerloop()
{
for (uint i=0; i<bunkers.length(); i++)
{
bunker@ b=bunkers[i];if(b.simulation_timer.elapsed<1000)continue;b.simulation_timer.restart();
if(b.power_timer.elapsed>=5000){b.power_timer.restart();if(b.owner!="" and b.power<100)b.power++;}
if(b.medical_timer.elapsed>=90000){b.medical_timer.restart();if(b.owner!="" and b.medical_charges<3)b.medical_charges++;}
if(b.capturing_player!="")
{
int capturer=get_player_index_from(b.capturing_player);bool valid=capturer>=0 and !players[capturer].death and players[capturer].map==b.map and get_3d_distance(players[capturer].x,players[capturer].y,players[capturer].z,b.x,b.y,b.z)<=6;bool contested=false;
if(valid)for(uint opponent=0;opponent<players.length();opponent++)if(int(opponent)!=capturer and !players[opponent].death and players[opponent].map==b.map and get_3d_distance(players[opponent].x,players[opponent].y,players[opponent].z,b.x,b.y,b.z)<=8){contested=true;break;}
if(!valid){if(capturer>=0)send_reliable(players[capturer].peer_id,"Bunker capture aborted because you left the control room.",2);b.capturing_player="";b.capture_progress=0;}
else if(contested){if(b.capture_report_timer.elapsed>=3000){b.capture_report_timer.restart();send_reliable(players[capturer].peer_id,"Bunker capture contested. Clear the control room to continue.",2);}}
else {b.capture_progress++;if(b.capture_progress>=12)complete_bunker_capture(b,capturer);else if(b.capture_progress%3==0)send_reliable(players[capturer].peer_id,"Bunker handshake "+int(double(b.capture_progress)/12.0*100.0)+" percent.",2);}
}
if(b.owner=="")continue;
for(uint e=0;e<players.length();e++)
{
if(players[e].death or players[e].map!=b.map or get_3d_distance(players[e].x,players[e].y,players[e].z,b.x,b.y,b.z)>8)continue;
if((players[e].name==b.owner or same_team(players[e].name,b.owner)) and players[e].health<1000 and b.medical_charges>0 and b.power>=5 and b.healtimer.elapsed>=3000){int treatment=random(55,75);players[e].health+=treatment;if(players[e].health>1000)players[e].health=1000;b.medical_charges--;b.power-=5;b.healtimer.restart();play("healing",b.x,b.y,b.z,b.map);send_reliable(players[e].peer_id,"Bunker medical station restored "+treatment+" health. "+b.medical_charges+" treatments remain.",2);break;}
}
}
}
