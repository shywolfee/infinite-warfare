+// Infinite Warfare modification: contact data is a value snapshot, not a
+// borrowed pointer to RP3D's temporary ContactPoint return value.
+struct script_contact_point {
+	Vector3 world_normal, local_point_on_collider1, local_point_on_collider2;
+	float penetration_depth = 0;
+};
+
+void contact_pair_get_contact_point(asIScriptGeneric* call) {
+	const auto& pair = *static_cast<const CollisionCallback::ContactPair*>(call->GetObject());
+	uint32 index = call->GetArgDWord(0);
+	if (index >= pair.getNbContactPoints()) {
+		asGetActiveContext()->SetException("Contact point index out of bounds");
+		return;
+	}
+	auto point = pair.getContactPoint(index);
+	auto* snapshot = new (call->GetAddressOfReturnLocation()) script_contact_point();
+	snapshot->world_normal = point.getWorldNormal();
+	snapshot->local_point_on_collider1 = point.getLocalPointOnCollider1();
+	snapshot->local_point_on_collider2 = point.getLocalPointOnCollider2();
+	snapshot->penetration_depth = point.getPenetrationDepth();
 }
 
