string find_map_path(string mapname)
{
string[] mode_dirs={"battlegrounds", "habitat_alpha", "freeforall", "freyas_ascent"};
for(uint i=0; i<mode_dirs.length(); i++)
{
string path="content/maps/"+mode_dirs[i]+"/"+mapname+".map";
if(file_exists(path)) return path;
}
return "";
}
// A bunker control panel declared on a map. These are the source of truth for
// bunker locations; /bunkers reads from the spawned bunkers array.
class bunkerdef
{
int x;
int y;
int z;
string name;
}
class poidef
{
int x;
int y;
int z;
string name;
}
mapdata@[] maps(0);
class mapdata
{
string name;
maptile@[] maptiles;
mapispawn@[] mapispawns;
bunkerdef@[] bunkerdefs;
poidef@[] poidefs;
int[] spawn_points;
world_object_set objects;
string rawdata;
mapdata(string loadname)
{
internal_load(loadname);
}
bool tile_exists(double x, double y, double z)
{
for(uint i=0; i<maptiles.length(); i++)
{
if(maptiles[i].is_on_tile(x, y, z))
return true;
}
return false;
}
string return_tile(double x, double y, double z)
{
string outval;
for(uint i=0; i<maptiles.length(); i++)
{
if(maptiles[i].is_on_tile(x, y, z))
{
outval=maptiles[i].type;
}
}
return outval;
}
void internal_load(string loadname)
{
file f;
string fpath=find_map_path(loadname);
f.open(fpath, "rb");
rawdata=f.read();
objects.load(rawdata);
string[] map=delinear(rawdata);
f.close();
for(uint i=0; i<map.length(); i++)
{
string[] parsed=string_split(map[i], ":", false);
if(parsed.length()==4 and parsed[0]=="spawn")
{
spawn_points.insert_last(int(string_to_number(parsed[1])));spawn_points.insert_last(int(string_to_number(parsed[2])));spawn_points.insert_last(int(string_to_number(parsed[3])));
}
else if(parsed[0]=="mapname")
{
name=parsed[1];
}
else if(parsed[0]=="tile" and parsed.length()>7)
{
int minx=string_to_number(parsed[1]);
int maxx=string_to_number(parsed[2]);
int miny=string_to_number(parsed[3]);
int maxy=string_to_number(parsed[4]);
int minz=string_to_number(parsed[5]);
int maxz=string_to_number(parsed[6]);
string type=parsed[7];
maptile temp;
temp.minx=minx;
temp.maxx=maxx;
temp.miny=miny;
temp.maxy=maxy;
temp.minz=minz;
temp.maxz=maxz;
temp.type=type;
maptiles.insert_last(temp);
}
if(parsed[0]=="wall"){
int minx=string_to_number(parsed[1]);
int maxx=string_to_number(parsed[2]);
int miny=string_to_number(parsed[3]);
int maxy=string_to_number(parsed[4]);
int minz=string_to_number(parsed[5]);
int maxz=string_to_number(parsed[6]);
}
else if(parsed[0]=="ispawn" and parsed.length()>9)
{
int minx=string_to_number(parsed[1]);
int maxx=string_to_number(parsed[2]);
int miny=string_to_number(parsed[3]);
int maxy=string_to_number(parsed[4]);
int minz=string_to_number(parsed[5]);
int maxz=string_to_number(parsed[6]);
int mapispawntime=string_to_number(parsed[7]);
int maxitems=string_to_number(parsed[8]);
mapispawn temp;
temp.minx=minx;
temp.maxx=maxx;
temp.miny=miny;
temp.maxy=maxy;
temp.minz=minz;
temp.maxz=maxz;
temp.mapispawntime=mapispawntime;
temp.maxitems=maxitems;
for(uint x=9; x<parsed.length(); x++)
{
temp.mapitems.insert_last(parsed[x]);
}
temp.imap=name;
mapispawns.insert_last(temp);
}
else if(parsed[0]=="bunker" and parsed.length()>4)
{
bunkerdef bd;
bd.x=string_to_number(parsed[1]);
bd.y=string_to_number(parsed[2]);
bd.z=string_to_number(parsed[3]);
// Join any remaining fields so bunker names may contain spaces.
string bname=parsed[4];
for(uint p=5; p<parsed.length(); p++)
bname+=":"+parsed[p];
bd.name=bname;
bunkerdefs.insert_last(bd);
}
else if(parsed[0]=="poi" and parsed.length()>4)
{
poidef pd;
pd.x=string_to_number(parsed[1]);
pd.y=string_to_number(parsed[2]);
pd.z=string_to_number(parsed[3]);
string pname=parsed[4];
for(uint p=5; p<parsed.length(); p++)
pname+=":"+parsed[p];
pd.name=pname;
poidefs.insert_last(pd);
}
}
}
void loop()
{
for(uint i=0; i<mapispawns.length(); i++)
{
mapispawns[i].loop();
}
}
}
class maptile
{
int minx;
int maxx;
int miny;
int maxy;
int minz;
int maxz;
string type;
bool is_on_tile(double x, double y, double z)
{
if(minx>x)
{
return false;
}
if(minx<=x and maxx>=x and miny<=y and maxy>=y and minz<=z and maxz>=z)
{
return true;
}
return false;
}
}
class mapispawn
{
int minx;
int maxx;
int miny;
int maxy;
int minz;
int maxz;
string[] mapitems;
timer mapispawntimer;
int mapispawntime;
int maxitems;
string imap;
bool is_in_area(double x, double y, double z, string map)
{
if(minx<=x and maxx>=x and miny<=y and maxy>=y and minz<=z and maxz>=z)
{
if(map==imap)
{
return true;
}
}
return false;
}
item@[] get_items_in_area()
{
item@[] tempitems;
for(uint i=0; i<items.length(); i++)
{
if(is_in_area(items[i].x, items[i].y, items[i].z, items[i].map))
{
tempitems.insert_last(items[i]);
}
}
return tempitems;
}
int get_items_in_area_length()
{
int tempitems=0;
for(uint i=0; i<items.length(); i++)
{
if(is_in_area(items[i].x, items[i].y, items[i].z, items[i].map))
{
tempitems++;
}
}
return tempitems;
}
void loop()
{
if(mapispawntimer.elapsed>=mapispawntime)
{
mapispawntimer.restart();
int tempitems=get_items_in_area_length();
if(tempitems>maxitems)
{
return;
}
else
{
spawn_item(random(minx, maxx), random(miny, maxy), random(minz, maxz), imap, mapitems[random(0, mapitems.length()-1)],"");
}
}
}
}
string get_tile_at(int x, int y, int z, string mapname, bool includeglobal=true)
{
string outval;
if(includeglobal==true)
{
int index=get_map_index(mapname);
if(index<0)
{
return "";
}
else
{
outval=maps[index].objects.tile_at(x,y,z);
if(outval=="")outval=maps[index].return_tile(x, y, z);
}
}
return outval;
}
bool spawn_tile_blocked(int x,int y,int z,string mapname)
{
string tile=get_tile_at(x,y,z,mapname);
if(tile=="" or tile=="blank" or string_contains(tile,"wall",1)>=0 or tile=="tree" or tile=="glass")return true;
for(int dz=1;dz<=2;dz++){string above=get_tile_at(x,y,z+dz,mapname);if(above!="" and above!="blank")return true;}
return false;
}
int[] nearest_safe_player_spawn(string mapname,int x,int y,int z)
{
if(!spawn_tile_blocked(x,y,z,mapname)){int[] original={x,y,z};return original;}
// Authored safe points avoid an expensive whole-world scan when an old save
// or an outdated client requests coordinates from a retired layout.
int mi=get_map_index(mapname),best=-1;double best_distance=1e30;
if(mi>=0)for(uint i=0;i+2<maps[mi].spawn_points.length();i+=3)
{
int nx=maps[mi].spawn_points[i],ny=maps[mi].spawn_points[i+1],nz=maps[mi].spawn_points[i+2];
double distance=get_3d_distance(x,y,z,nx,ny,nz);
if(distance<best_distance and !spawn_tile_blocked(nx,ny,nz,mapname)){best=int(i);best_distance=distance;}
}
if(best>=0){int[] safe={maps[mi].spawn_points[best],maps[mi].spawn_points[best+1],maps[mi].spawn_points[best+2]};return safe;}
for(int radius=0;radius<=80;radius++)for(int dz=0;dz<=12;dz++)for(int side=0;side<4;side++){int nx=x,ny=y,nz=z+dz;if(side==0){nx=x-radius;ny=y-radius;}else if(side==1){nx=x+radius;ny=y-radius;}else if(side==2){nx=x+radius;ny=y+radius;}else{nx=x-radius;ny=y+radius;}if(!spawn_tile_blocked(nx,ny,nz,mapname)){int[] result={nx,ny,nz};return result;}}
for(int nz=0;nz<=140;nz++)for(int nx=0;nx<=1400;nx+=10)for(int ny=0;ny<=1400;ny+=10)if(!spawn_tile_blocked(nx,ny,nz,mapname)){int[] fallback={nx,ny,nz};return fallback;}int[] unavailable={0,0,0};return unavailable;
}
int[] choose_safe_player_spawn(string mapname,int requested_x,int requested_y,int requested_z)
{
int mi=get_map_index(mapname);int[] points;if(mi>=0)points=maps[mi].spawn_points;
if(points.length()>=3){int start=random(0,int(points.length()/3)-1);for(uint attempt=0;attempt<points.length()/3;attempt++){int base=((start+int(attempt))%int(points.length()/3))*3;if(!spawn_tile_blocked(points[base],points[base+1],points[base+2],mapname)){int[] safe={points[base],points[base+1],points[base+2]};return safe;}}}
return nearest_safe_player_spawn(mapname,requested_x,requested_y,requested_z);
}
string linear(string[] a)
{
string final;
for(uint i=0; i<a.length(); i++)
{
final+=(a[i]+"\r\n");
}
return final;
}
string[] delinear(string a)
{
a=string_replace(a,"\r\n","\n",false);
return string_split(a, "\n", false);
}
string get_map_data(string map, string data)
{
string mpath=find_map_path(map);
if(mpath=="")
{
return "";
}
file f;
f.open(mpath, "rb");
string[] mdata=delinear(f.read());
f.close();
for(uint i=0; i<mdata.length(); i++)
{
string[] p=string_split(mdata[i], ":", true);
if(p[0]==data)
{
return string_replace(mdata[i], data+":", "", false);
}
}
return "";
}
bool tile_exists(double x, double y, double z, string mapname)
{
int index=get_map_index(mapname);
if(index<0)
{
return false;
}
else
{
return maps[index].tile_exists(x, y, z);
}
}
void init_mapsystem()
{
maps.resize(0);
string[] mode_dirs={"battlegrounds", "habitat_alpha", "freeforall", "freyas_ascent"};
for(uint d=0; d<mode_dirs.length(); d++)
{
string dir="content/maps/"+mode_dirs[d];
string[] mapfiles=find_files(dir+"/*.map");
for(uint i=0; i<mapfiles.length(); i++)
{
string workingname=string_replace(mapfiles[i], ".map", "", true);
mapdata temp(workingname);
maps.insert_last(temp);
}
}
}
// Remove all bunkers belonging to a given map from the global bunkers array.
void clear_bunkers_for_map(string mapname)
{
for(int i=int(bunkers.length())-1; i>=0; i--)
{
if(bunkers[i].map==mapname)
bunkers.remove_at(i);
}
}
// Spawn the bunkers declared on a single loaded map, replacing any existing
// bunkers for that map so reloads do not create duplicates.
void spawn_bunkers_for_map(int mi)
{
if(mi<0 or mi>=int(maps.length())) return;
clear_bunkers_for_map(maps[mi].name);
for(uint i=0; i<maps[mi].bunkerdefs.length(); i++)
{
bunkerdef@ bd=maps[mi].bunkerdefs[i];
spawn_bunker(bd.x, bd.y, bd.z, maps[mi].name, "", bd.name);
}
}
// Spawn bunkers for every loaded map. Called once at startup after the map
// system is initialized.
void spawn_all_map_bunkers()
{
for(uint i=0; i<maps.length(); i++)
spawn_bunkers_for_map(i);
}
int get_map_index(string name)
{
for(uint i=0; i<maps.length(); i++)
{
if(maps[i].name==name)
{
return i;
}
}
return -1;
}
void maploop()
{
for(uint i=0; i<maps.length(); i++)
{
maps[i].loop();
}
}
void reload_map(string mname)
{
string path=find_map_path(mname);
if(path=="") return;
mapdata temp(mname);
int mi=get_map_index(temp.name);
if(mi>=0)
{
maps.remove_at(mi);
}
maps.insert_last(temp);
spawn_bunkers_for_map(int(maps.length())-1);
file mf;
mf.open(path, "rb");
string mdata=mf.read();
mf.close();
for(uint i=0; i<players.length(); i++)
{
if(players[i].map==temp.name)
send_reliable(players[i].peer_id, "mapdata "+mdata, 0);
}
// Send replacement infrastructure only after mapdata. Loading mapdata clears
// stale dynamic objects client-side, so this ordering prevents fresh fixtures
// from being created and immediately erased during a live builder reload.
spawn_fixtures_for_map(temp.name);
for(uint i=0;i<players.length();i++)if(players[i].map==temp.name)er_sync_fixtures_to(players[i].peer_id,temp.name);
}
