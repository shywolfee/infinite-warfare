// Persistent in-match dashboard.  Unlike modal game menus, this form stays
// alive for the match and lets Tab move naturally between play and chat.
nv_form game_dashboard_form;
nv_form_keyboard_area@ game_dashboard_keyboard;
nv_form_list_box@ game_dashboard_options;
nv_form_list_box@ game_dashboard_conversations;
nv_form_input@ game_dashboard_message;
nv_form_button@ game_dashboard_send;
bool game_dashboard_ready=false;
timer game_dashboard_refresh_timer;

void game_dashboard_add_conversation(const string &in label,const string &in id)
{
for(uint i=0;i<game_dashboard_conversations.items.length();i++)if(game_dashboard_conversations.items[i].id==id)return;
game_dashboard_conversations.add(label,id);
}

void game_dashboard_refresh_conversations()
{
if(!game_dashboard_ready)return;
string selected=@game_dashboard_conversations.focused_item!=null?game_dashboard_conversations.focused_item.id:"global";
game_dashboard_conversations.items.resize(0);
game_dashboard_add_conversation("Global chat","global");
if(mapname!="main")game_dashboard_add_conversation("Current map chat","map");
game_dashboard_add_conversation("Team chat","team");
for(uint i=0;i<my_groups.length();i++)game_dashboard_add_conversation("Group: "+my_groups[i].name,"group:"+my_groups[i].name);
for(uint i=0;i<buffers.length();i++)
{
string n=buffers[i].name;
if(string_contains(n,"private: ",1)==0)game_dashboard_add_conversation("Private: "+n.substr(9),"private:"+n.substr(9));
else if(string_contains(n,"language: ",1)==0)game_dashboard_add_conversation(string_replace(n,"language: ","Language: ",false),"global");
}
for(uint i=0;i<game_dashboard_conversations.items.length();i++)if(game_dashboard_conversations.items[i].id==selected){game_dashboard_conversations.set_pos(i,false);return;}
if(game_dashboard_conversations.items.length()>0)game_dashboard_conversations.set_pos(0,false);
}

void game_dashboard_init()
{
game_dashboard_form.reset();
game_dashboard_form.create_window("Game dashboard",false,false);
@game_dashboard_keyboard=game_dashboard_form.add_keyboard_area("Game keyboard area","game");
@game_dashboard_options=game_dashboard_form.add_list("Options and actions","options");
game_dashboard_options.add("Status","stats");
game_dashboard_options.add("Equipment","equipment");
game_dashboard_options.add("Team","team");
game_dashboard_options.add("Inventory","inventory");
game_dashboard_options.add("Groups","groups");
game_dashboard_options.add("Companion command remote","companions");
game_dashboard_options.add("Options","options");
game_dashboard_options.add("Help topics","help");
game_dashboard_options.add("What's new","changes");
game_dashboard_options.add("Rules","rules");
game_dashboard_options.add("Your account","account");
game_dashboard_options.add("Developers","developers");
if(staff_panel_available or dev_unlocked or !SCRIPT_COMPILED)game_dashboard_options.add("Staff panel","staff");
game_dashboard_options.set_pos(0,false);
@game_dashboard_conversations=game_dashboard_form.add_list("Conversations","conversations");
@game_dashboard_message=game_dashboard_form.add_input("Message to selected conversation","message","","",1024);
@game_dashboard_send=game_dashboard_form.add_button("Send message","send");
game_dashboard_ready=true;
game_dashboard_refresh_conversations();
game_dashboard_form.focus_control(game_dashboard_keyboard,true,false);
game_dashboard_refresh_timer.restart();
}

bool game_dashboard_keyboard_active()
{
return !game_dashboard_ready or @game_dashboard_form.current_control==@game_dashboard_keyboard;
}

void game_dashboard_focus_game()
{
if(game_dashboard_ready)game_dashboard_form.focus_control(game_dashboard_keyboard);
}

void game_dashboard_show_account()
{
string[] lines;
lines.insert_last("Name: "+name);
if(account_exists(name))
{
savedata acct(get_account_path(name),ACCOUNT_SECRET);acct.load();
string em=acct.read("email");
lines.insert_last("Registered account"+(em!=""?", email "+em:", no email on file"));
}
else lines.insert_last("No registered account for this name.");
show_info_list("Your account",lines);
}

void game_dashboard_open_action()
{
if(@game_dashboard_options.focused_item==null)return;
string chosen=game_dashboard_options.focused_item.id;
if(chosen=="stats")show_info_list("Status",ingame_stats_lines());
else if(chosen=="equipment")equipment_menu();
else if(chosen=="team")team_menu();
else if(chosen=="inventory")inventory_menu();
else if(chosen=="groups")groups_menu();
else if(chosen=="companions")companion_remote_menu();
else if(chosen=="options")optionsmenu();
else if(chosen=="help")show_help_list();
else if(chosen=="changes")show_changelog_form();
else if(chosen=="rules")dlg(read_text_file_or("rules.txt","The rules file is missing."));
else if(chosen=="account")game_dashboard_show_account();
else if(chosen=="developers")dlg(read_text_file_or("developers.txt","The developers file is missing."));
else if(chosen=="staff")ingame_adminpanel();
}

void game_dashboard_send_message()
{
string text=game_dashboard_message.text.trim_whitespace();
if(text==""){speak("Enter a message first.");return;}
if(@game_dashboard_conversations.focused_item==null){speak("Select a conversation first.");return;}
string target=game_dashboard_conversations.focused_item.id;
if(target=="global")send_reliable(0,text,1);
else if(target=="map")send_reliable(0,text,6);
else if(target=="team")send_team_command("chat "+text);
else if(string_contains(target,"group:",1)==0){group_request("say",target.substr(6),text);p.play_stationary("group/send.ogg",false);}
else if(string_contains(target,"private:",1)==0)send_reliable(0,"/pm "+target.substr(8)+" "+text,1);
game_dashboard_message.text="";
game_dashboard_form.focus_control(game_dashboard_message);
}

void game_dashboard_tick()
{
if(!game_dashboard_ready)return;
if((key_down(KEY_LMENU) or key_down(KEY_RMENU)) and key_pressed(KEY_G)){game_dashboard_focus_game();return;}
if(!game_dashboard_keyboard_active() and key_pressed(KEY_ESCAPE)){game_dashboard_focus_game();return;}
if(game_dashboard_refresh_timer.elapsed>1000){game_dashboard_refresh_conversations();game_dashboard_refresh_timer.restart();}
bool activate=key_pressed(KEY_RETURN);
if(activate and @game_dashboard_form.current_control==@game_dashboard_options){game_dashboard_open_action();return;}
if((activate and @game_dashboard_form.current_control==@game_dashboard_message) or game_dashboard_form.is_pressed(game_dashboard_send)){game_dashboard_send_message();return;}
form_net_depth++;
game_dashboard_form.monitor();
form_net_depth--;
if(game_dashboard_form.is_pressed(game_dashboard_send))game_dashboard_send_message();
}
