// The map's own ambience beds. Their own pool, on the world mixer, with an
// earshot that suits a bed you walk through rather than a shot you hear
// across the map.
sound_pool ambpool(96);
// Every positional pool follows the player together. Updating only one of
// them, as the text prompts used to, left ambience and distant fire
// frozen wherever you were when you started typing.
// The tracker beacon. While you are tracking someone, a beep sounds from
// where they are every couple of seconds: the high one when they are above
// you, the low one below, the plain one on your level. Tracking used to be a
// name and a key that read out coordinates; the server was already sending a
// position for a beacon that the client never played.
timer tracker_pulse_timer;
string tracker_lost_reason="";
timer tracker_quiet_timer;
void tracker_tick()
{
if(tracking=="")return;
if(tracker_pulse_timer.elapsed<2200)return;
tracker_pulse_timer.restart();
send_reliable(0,"trackping "+tracking,0);
}
void tracker_beacon(double x,double y,double z,const string &in map)
{
if(map!=mapname)return;
// Someone who stops and starts would otherwise be announced every few
// seconds; coming back from going quiet is heard as the beacon itself.
if(tracker_lost_reason!="" and tracker_lost_reason!="hidden")speak("Tracking "+tracking+" again.");
tracker_lost_reason="";
double rise=z-me.z;
string cue=rise>2?"trackingabove.ogg":(rise<-2?"trackingbelow.ogg":"trackingbeep.ogg");
distpool.play_3d(cue,me.x,me.y,me.z,x,y,z,calculate_theta(facing),false);
}
void tracker_lost(const string &in reason)
{
if(reason==tracker_lost_reason)return;
tracker_lost_reason=reason;
if(reason=="gone"){speak(tracking+" has left the game. Stopped tracking.");tracking="";tracker_lost_reason="";}
else if(reason=="dead")speak(tracking+" is down. The beacon will come back when they respawn.");
else if(reason=="elsewhere")speak(tracking+" is on another map.");
else if(tracker_quiet_timer.elapsed>20000){tracker_quiet_timer.restart();speak(tracking+" has gone quiet: out of range, keeping still or hidden.");}
}
void update_all_listeners()
{
double t=calculate_theta(facing);
p.update_listener_3d(me.x,me.y,me.z,t);
distpool.update_listener_3d(me.x,me.y,me.z,t);
ambpool.update_listener_3d(me.x,me.y,me.z,t);
}
