else if(services.is_pressed(f_tickets))
{
support_view_all_tickets();
return;
}
else if(services.is_pressed(f_accounts)){show_server_accounts();return;}
else if(staff.is_pressed(f_staff_list))send_reliable(0,"/staff",1);
else if(staff.is_pressed(f_staff_assign))
{
string target=af_input("Account to assign a staff role","",true).trim_whitespace();if(target!=""){string[] roles={"Administrator","Moderator","Support","Builder"};int selected=android_select("Choose the persistent staff role",roles);if(selected>=0)send_reliable(0,"/staffrole "+target+" "+string_to_lower_case(roles[selected]),1);}
}
else if(staff.is_pressed(f_staff_remove)){string target=af_input("Account whose staff role should be removed","",true).trim_whitespace();if(target!="")send_reliable(0,"/unstaff "+target,1);}
else if(moderation.is_pressed(f_warn)){string target=af_input("Account to warn","",true).trim_whitespace();string reason=af_input("Warning reason","",true).trim_whitespace();if(target!="" and reason!="")send_reliable(0,"/warn "+target+" "+reason,1);}
else if(moderation.is_pressed(f_warnings)){string target=af_input("Account whose warnings should be reviewed","",true).trim_whitespace();if(target!="")send_reliable(0,"/warnings "+target,1);}
else if(moderation.is_pressed(f_kick)){string target=af_input("Online player to kick","",true).trim_whitespace();if(target!="")send_reliable(0,"/kick "+target,1);}
else if(moderation.is_pressed(f_ban)){string target=af_input("Account to ban","",true).trim_whitespace();string reason=af_input("Ban reason","",true).trim_whitespace();if(target!="" and reason!="")send_reliable(0,"/ban "+target+" "+reason,1);}
else if(moderation.is_pressed(f_unban)){string target=af_input("Account to unban","",true).trim_whitespace();if(target!="")send_reliable(0,"/unban "+target,1);}
else if(moderation.is_pressed(f_bans))send_reliable(0,"/bans",1);
else if(moderation.is_pressed(f_player_report))player_report_form();
else if(moderation.is_pressed(f_player_reports))send_reliable(0,"/reports",1);
else if(moderation.is_pressed(f_admin_log))send_reliable(0,"/adminlog 50",1);
else if(communication.is_pressed(f_notify)){string message=af_input("Server notification","",true).trim_whitespace();if(message!="")send_reliable(0,"/notify "+message,1);}
else if(communication.is_pressed(f_motd)){string message=af_input("New message of the day","",true).trim_whitespace();if(message!="")send_reliable(0,"/motd "+message,1);}
else if(world.is_pressed(f_builder)){builder_menu();return;}
else if(world.is_pressed(f_teleport)){string coordinates=af_input("Coordinates as X Y Z","",true).trim_whitespace();if(coordinates!="")send_reliable(0,"/go "+coordinates,1);}
else if(world.is_pressed(f_give)){string request=af_input("Player, item ID, and quantity","",true).trim_whitespace();if(request!="")send_reliable(0,"/give "+request,1);}
else if(server.is_pressed(f_physics))send_reliable(0,"/physicsstatus",1);
else if(server.is_pressed(f_reboot)){string seconds=af_input("Seconds before reboot, from 5 to 3600","",true).trim_whitespace();string reason=af_input("Reboot reason","",true).trim_whitespace();if(seconds!="" and reason!="")send_reliable(0,"/reboot "+seconds+" "+reason,1);}
else if(server.is_pressed(f_cancel_reboot))send_reliable(0,"/reboot cancel",1);
else if(server.is_pressed(f_server_gc))send_reliable(0,"/gc",1);
else if(developer.is_pressed(f_devkey))
{
string key=af_input("Enter developer unlock key", "", true);
if(key!="")
{
if(key!=CLIENT_DEV_KEY)
{
dlg("Incorrect key.");
}
else
{
send_reliable(0, "dev_validate_key "+key+" "+name, 0);
timer kt;
bool got_response=false;
while(kt.elapsed<3000)
{
wait(5);
e=n.request();
if(e.type==event_receive)
{
string msg=get_event_message();
if(msg=="dev_key_ok")
{
dev_unlocked=true;
dlg("Developer access unlocked. You may now connect with any account.");
got_response=true;
break;
}
else if(msg=="dev_key_denied")
{
dlg("Key validation failed.");
got_response=true;
break;
}
}
}
if(!got_response)
dlg("Server did not respond to key validation.");
}
}
}
else if(f.is_pressed(f_close))
return;
}
}
int yesno(string question)
{
setupmenu();
m.add_item_tts("Yes","yes");
m.add_item_tts("No","no");
int mres=m.run(question,true);
if (m.get_item_name(mres)=="yes")
return 1;
else
return 2;
}
