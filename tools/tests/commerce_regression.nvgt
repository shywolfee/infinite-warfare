// Exercise production services with temporary ledgers and no live connection.
string commerce_results;int commerce_failures=0;
void commerce_check(bool ok,string label){commerce_results+=(ok?"PASS ":"FAIL ")+label+"\n";if(!ok)commerce_failures++;}
void run_commerce_regression(){
try{
wallet_accounts_directory=DIRECTORY_LOCAL_APPDATA+"/Temp/IW-commerce-regression-"+random(100000,999999999);directory_create(wallet_accounts_directory);
load_item_catalogue();load_dobject_types(dobject_data_directory());init_mapsystem();init_terminal_apps();
savedata account(wallet_accounts_directory+"/commerce_tester.dat",ACCOUNT_SECRET);account.add("credits",double(1000));account.save();
player tester(40,40,0,"freeforall","commerce_tester",1);tester.credits=load_player_credits(tester.name);players.insert_last(tester);player@ p=players[players.length()-1];
send_reliable(1,"give hypercomp 1",0);p.terminal_apps.insert_last("bank");
commerce_check(terminal_apps_catalogue.length()==30 and terminal_has_app(p,"market") and terminal_has_app(p,"bank"),"loads all data-defined apps and built-in/installed state");
string[] create={"bank_create","1234"};bank_handle(p,create);savedata bank(bank_path(p.name),ACCOUNT_SECRET+"_bank");load_bank(bank);
commerce_check(bank_record_valid(bank) and bank.read("number").length()==12,"creates a numbered bank account in verified records");
string number=bank.read("number");bank_handle(p,create);bank.d.delete_all();load_bank(bank);commerce_check(bank.read("number")==number,"creating an existing bank account does not replace it");
string[] status={"bank_status","1234"};bank_handle(p,status);commerce_check(physical_bank_authenticated(p),"PIN sign-in authorizes bank credsticks");
string[] deposit={"bank_deposit","1234","400"};bank_handle(p,deposit);bank.d.delete_all();load_bank(bank);commerce_check(p.credits==600 and bank.readn("checking")==400,"wallet deposit debits wallet and credits checking exactly once");
send_reliable(1,"give credit_chip_small 1",0);commerce_check(p.er_small_chips==1,"renamed chip grants establish server ownership");
commerce_check(physical_payment(p,8,"chips") and p.er_small_chips==0 and physical_count(p,"credit_chip_1")==7,"physical chips pay with exact change");
commerce_check(!physical_payment(p,8,"chips") and physical_count(p,"credit_chip_1")==7,"insufficient chips are not partially consumed");
send_reliable(1,"give credit_chip_100 1",0);string[] chip={"physical_deposit","credit_chip_100"};physical_handle(1,chip);bank.d.delete_all();load_bank(bank);commerce_check(physical_count(p,"credit_chip_100")==0 and bank.readn("checking")==500,"physical chip deposits into the same checking account");physical_handle(1,chip);bank.d.delete_all();load_bank(bank);commerce_check(bank.readn("checking")==500,"consumed chip cannot be deposited twice");
send_reliable(1,"give credstick_refillable 1",0);commerce_check(physical_payment(p,30,"credstick_refillable") and physical_count(p,"credstick_refillable")==0 and physical_count(p,"credstick_refillable__value__70")==1,"stored-value payment retains the balance on the physical stick");
commerce_check(!physical_payment(p,30,"credstick_refillable"),"spent stick identifier cannot be replayed");commerce_check(physical_payment(p,70,"credstick_refillable__value__70") and physical_count(p,"empty_refillable_credstick")==1,"exhausted reloadable stick becomes an empty reloadable stick");
string[] refill={"physical_refill","empty_refillable_credstick","100"};physical_handle(1,refill);bank.d.delete_all();load_bank(bank);commerce_check(bank.readn("checking")==395 and physical_count(p,"credstick_refillable__value__100")==1 and physical_count(p,"empty_refillable_credstick")==0,"refill deducts amount plus five percent and replaces the empty stick");
send_reliable(1,"give credstick_bank 1",0);commerce_check(physical_payment(p,100,"credstick_bank"),"bank-linked credstick pays from authenticated checking");bank.d.delete_all();load_bank(bank);commerce_check(bank.readn("checking")==292 and physical_count(p,"credstick_bank")==1,"bank-linked stick charges its percentage without consuming the stick");
p.bank_authorized_until=0;commerce_check(!physical_payment(p,1,"credstick_bank"),"signed-out bank credsticks cannot spend");bank_handle(p,status);
commerce_check(item_info("credstick_refillable__value__9999") is null and item_info("credstick_refillable__value__12x") is null and item_info("hypercomp__value__30") is null,"rejects forged or malformed stored-value item identifiers");
string[] cash={"bank_cash","1234","credit_chip_25","2"};bank_handle(p,cash);bank.d.delete_all();load_bank(bank);commerce_check(physical_count(p,"credit_chip_25")==2 and bank.readn("checking")==242,"cash withdrawal produces selected-denomination chips");
dobject dumpster;dumpster.id=90000;dumpster.x=40;dumpster.y=40;dumpster.z=0;dumpster.map=p.map;dumpster.origin_type="dumpster";dumpster.become("dumpster");dumpster.stock=0;dobject_set@ set=dobjects_on(p.map);set.list.insert_last(dumpster);set.index();
send_reliable(1,"give empty_medicine_bottle 1",0);string[] discard={"physical_dispose","90000","empty_medicine_bottle"};physical_handle(1,discard);int rubbish=0;dumpster.salvage.get("empty_medicine_bottle",rubbish);commerce_check(rubbish==1 and physical_count(p,"empty_medicine_bottle")==0,"discard moves actual owned item into a specific dumpster");physical_handle(1,discard);dumpster.salvage.get("empty_medicine_bottle",rubbish);commerce_check(rubbish==1,"discard cannot duplicate salvage");commerce_check(nearby_things(get_player_index(1)).find("Empty medicine bottle")>=0,"nearby-things reports deposited dumpster contents");wait(650);dobject_use(1,90000);commerce_check(dumpster.salvage.get_size()==0 and physical_count(p,"empty_medicine_bottle")==1 and dumpster.stock==0,"search recovers deposited salvage even with no generated stock");
send_reliable(1,"give nanocyte_solution_bottle 1",0);double capacity=server_medication_capacity("nanocyte_solution_bottle"),dose=server_medication_recommended("nanocyte_solution_bottle");for(int i=0;i<int(ceil(capacity/dose));i++)use_server_medication(p,"nanocyte_solution_bottle");commerce_check(physical_count(p,"nanocyte_solution_bottle")==0 and physical_count(p,"empty_medicine_bottle")==2,"finishing a medicine bottle yields exactly one empty bottle");use_server_medication(p,"nanocyte_solution_bottle");commerce_check(physical_count(p,"empty_medicine_bottle")==2,"missing medication cannot mint empty containers");
p.health=1000;p.medication_toxicity=0;
// Simulate a crash after the wallet committed, before checking committed.
bank.d.delete_all();load_bank(bank);double checking_before=bank.readn("checking");savedata journal(bank.fn+".transfer",bank.key);journal.add("checking_before",checking_before);journal.add("checking_after",checking_before+10);journal.add("wallet_before",double(p.credits));journal.add("wallet_after",double(p.credits-10));journal.add("pending",double(1));journal.save();save_player_credits(p.name,p.credits-10);
commerce_check(recover_bank_transfer(p),"interrupted wallet-to-bank transfer recovers");bank.d.delete_all();load_bank(bank);commerce_check(bank.readn("checking")==checking_before+10 and p.credits==590 and recover_bank_transfer(p),"recovery commits exactly once");
// A failed next-record write must preserve the committed bank balance.
savedata a(bank.fn+"0",bank.key),b(bank.fn+"1",bank.key);a.load();b.load();int next=a.readn("revision")>=b.readn("revision")?1:0;file_delete(bank.fn+next);directory_create(bank.fn+next);bank.add("checking",bank.readn("checking")+20);commerce_check(!save_bank(bank),"bank detects failed inactive-slot write");bank.d.delete_all();load_bank(bank);commerce_check(bank.readn("checking")==checking_before+10,"failed bank save preserves prior committed balance");directory_delete(bank.fn+next);
string[] card={"bank_card","1234","credit"};bank_handle(p,card);bank.d.delete_all();load_bank(bank);double issued_balance=bank.readn("checking");commerce_check(physical_count(p,"credstick_credit")==1 and bank.readn("debt")==0,"credit card issuance delivers a usable physical credit-line stick");
commerce_check(physical_payment(p,100,"credstick_credit"),"credit-line stick authorizes a financed purchase");bank.d.delete_all();load_bank(bank);commerce_check(bank.readn("debt")==105 and bank.readn("checking")==issued_balance,"credit-line purchase records debt and five percent fee rather than debiting checking");commerce_check(!physical_payment(p,2000,"credstick_credit"),"credit-line limit prevents excess borrowing");
string[] repay={"bank_repay","1234","50"};bank_handle(p,repay);bank.d.delete_all();load_bank(bank);commerce_check(bank.readn("debt")==55 and bank.readn("checking")==issued_balance-50,"repayment moves checking credit into debt reduction");
int software_balance=p.credits;int storage_before=terminal_used(p);string[] install={"terminal_install","notes"};terminal_handle(1,"terminal_install notes",install);commerce_check(p.terminal_apps.find("notes")>=0 and p.credits==software_balance-5 and terminal_used(p)==storage_before+4,"app installation charges once and occupies real storage");terminal_handle(1,"terminal_install notes",install);commerce_check(p.credits==software_balance-5,"installing an existing app does not charge twice");
string[] note={"terminal_notes","Keep","this","note"};terminal_handle(1,"terminal_notes Keep this note",note);commerce_check(p.terminal_notes=="Keep this note","notes app stores the actual edited session text");
string[] os={"terminal_os","minimal_recovery"};terminal_handle(1,"terminal_os minimal_recovery",os);commerce_check(!terminal_has_app(p,"bank") and p.terminal_apps.find("bank")>=0 and p.bank_authorized_until==0,"OS change blocks incompatible apps without deleting them and clears bank sign-in");p.terminal_os="frontier_os";send_reliable(1,"give hypercomp -1",0);commerce_check(!p.has_hypercomp and p.terminal_apps.length()==0 and p.terminal_notes=="" and p.bank_authorized_until==0,"losing the terminal clears software, notes and bank authorization");
commerce_check(dobject_type_of("hospital_defibolator").service=="resuscitate" and dobject_type_of("hospital_coagulator").service=="coagulate" and dobject_type_of("hospital_ventilator").service=="ventilate","medical fixtures have distinct configured services");
commerce_check(!terminal_app_text_valid("name=Bad app\nhandler=missing_service\nsize=4\nprice=10\nsystems=all") and !terminal_app_text_valid("name=Bad app\nhandler=notes\nsize=0\nprice=10\nsystems=all"),"content validation rejects unsupported apps and invalid storage sizes");
p.pending_corpse=spawn_corpse(p);int ci=find_corpse(p.pending_corpse);fill_corpse(p,"credstick_credit:5000|empty_medicine_bottle:2000");int sticks=0,bottles=0;corpses[ci].inv.get("credstick_credit",sticks);corpses[ci].inv.get("empty_medicine_bottle",bottles);commerce_check(sticks==1 and bottles==2,"corpse inventory uses authoritative physical items and ignores forged client additions");withdraw_corpse(p);
player patient(40,40,0,p.map,"commerce_patient",2);players.insert_last(patient);player@ downed=players[players.length()-1];send_reliable(2,"give hypercomp 1",0);downed.death=true;downed.health=0;downed.has_hypercomp=false;downed.pending_corpse=spawn_corpse(downed);
dobject defibrillator;defibrillator.id=90001;defibrillator.x=40;defibrillator.y=40;defibrillator.z=0;defibrillator.map=p.map;defibrillator.origin_type="hospital_defibolator";defibrillator.become("hospital_defibolator");set.list.insert_last(defibrillator);set.index();wait(650);dobject_use(1,90001);commerce_check(!downed.death and downed.health==300 and downed.has_hypercomp and downed.pending_corpse=="" and defibrillator.stock==3,"defibrillator revives a nearby player, consumes supplies and restores their existing terminal");
// Purpose-built devices and correlated transactions use production handlers.
send_reliable(1,"give bank_link_pda 1",0);send_reliable(1,"give supply_link 1",0);send_reliable(1,"give field_tablet 1",0);load_device_modules();load_wpn_stats();load_market_offers();
commerce_check(device_bank_access(p) and device_market_access(p) and !device_action_allowed(p,"field_tablet","market"),"hardware capabilities authorize banking and ordering, not arbitrary apps");
commerce_check(market_offers.length()>350 and market_find("AK47")!is null,"explicit marketplace loads items and firearms");
int before=p.credits;string[] module={"device_install","field_tablet","ballistics"};device_handle(1,"device_install field_tablet ballistics",module);
commerce_check(device_installed(p,"field_tablet","ballistics") and device_used(p,"field_tablet")==6 and p.credits==before-140,"compatible module installation consumes storage and charges once");
device_handle(1,"device_install field_tablet ballistics",module);commerce_check(p.credits==before-140,"installed module cannot charge a second time");
send_reliable(1,"give flashdrive_32 1",0);string[] expand={"device_expand","field_tablet","flashdrive_32"};device_handle(1,"device_expand field_tablet flashdrive_32",expand);
commerce_check(device_capacity(p,"field_tablet")==64 and physical_count(p,"flashdrive_32")==0,"storage upgrades consume the actual owned module");
send_reliable(1,"give field_tablet -1",0);commerce_check(!device_installed(p,"field_tablet","ballistics") and device_capacity(p,"field_tablet")==32,"losing the last device clears modules and storage upgrades");
send_reliable(1,"give credit_chip_25 3",0);int owned_chips=physical_count(p,"credit_chip_25");p.bank_authorized_until=double(uptimer.elapsed)+300000;bank.d.delete_all();load_bank(bank);double chip_before=bank.readn("checking");
handle_service_request(1,"service_request 7001 physical_deposit credit_chip_25 2");bank.d.delete_all();load_bank(bank);
commerce_results+="  deposit receipt: "+service_receipts[service_receipts.length()-1].reply+"; balance "+bank.readn("checking")+"; chips "+physical_count(p,"credit_chip_25")+"\n";
commerce_check(bank.readn("checking")==chip_before+50 and physical_count(p,"credit_chip_25")==owned_chips-2,"chip-stack request deposits the selected quantity and consumes exactly that quantity");
handle_service_request(1,"service_request 7001 physical_deposit credit_chip_25 2");bank.d.delete_all();load_bank(bank);commerce_check(bank.readn("checking")==chip_before+50 and physical_count(p,"credit_chip_25")==owned_chips-2,"replayed deposit returns a receipt without repeating the deposit");
handle_service_request(1,"service_request 7001 physical_deposit credit_chip_25 1");commerce_check(physical_count(p,"credit_chip_25")==owned_chips-2,"reusing a receipt id for another operation cannot spend");
market_offer@ offer=market_find("nanocyte_solution_bottle");before=p.credits;int medicine=physical_count(p,offer.item);
handle_service_request(1,"service_request 7002 market_checkout wallet "+offer.id+",2;missing_offer,1");
commerce_check(p.credits==before and physical_count(p,offer.item)==medicine,"invalid cart validates every row before taking payment");
handle_service_request(1,"service_request 7003 market_checkout wallet "+offer.id+",2");commerce_check(p.credits==before-offer.price*2 and physical_count(p,offer.item)==medicine+offer.quantity*2,"cart checkout charges its explicit total and delivers every pack");
handle_service_request(1,"service_request 7003 market_checkout wallet "+offer.id+",2");commerce_check(p.credits==before-offer.price*2 and physical_count(p,offer.item)==medicine+offer.quantity*2,"replayed checkout cannot charge or deliver twice");
handle_service_request(1,"service_request 7004 market_checkout wallet "+offer.id+",1;"+offer.id+",1");commerce_check(p.credits==before-offer.price*2,"duplicate listings are rejected before payment");
}catch{commerce_check(false,"Exception: "+get_exception_info()+" at "+get_exception_file()+":"+get_exception_line());}
commerce_results+="Failures: "+commerce_failures+"\n";file report;report.open(wallet_accounts_directory+"/results.txt","wb");report.write(commerce_results);report.close();exit(commerce_failures);
}
