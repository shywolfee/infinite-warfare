else if(parsed[0]=="combat_slow" and parsed.length()>1)
{
combat_slow_duration=string_to_number(parsed[1]);combat_slow_timer.restart();speak("Movement impaired.");
}
else if(parsed[0]=="stamina_restore" and parsed.length()>1)
{
restore_stamina(string_to_number(parsed[1]));
}
else if(parsed[0]=="energy_crash" and parsed.length()>1)
{
int loss=string_to_number(parsed[1]);degrade_stamina(loss);apply_effect("Energy Crash","debuff",20000,0,0);p.play_stationary(ui_sound("notify"),false);speak("Energy crash. Lost "+loss+" stamina. "+get_stamina_string());
}
else if(parsed[0]=="weapon_sway" and parsed.length()>1)
{
weapon_sway_duration=string_to_number(parsed[1]);weapon_sway_timer.restart();p.play_stationary("arm_hit_sway.ogg",false);speak("Weapon stability impaired.");
}
else if (parsed[0]=="target_hp" and parsed.length()>=2)
{
string hp_msg="";
