dynamic_menu_pro m;
void classic_mainmenu(){mainmenu();}

// The main menu.
//
// There is exactly one of it. Everything that finishes -- options, the
// changelog, a failed connection, leaving the lobby, a dropped match -- asks
// for the main menu by calling mainmenu(), and used to get a brand new one
// stacked on top of everything that led there; a long session piled up one
// abandoned menu per visit. Now the first call runs the menu, and any later
// call unwinds straight back to it, dropping whatever was in between.
const string IW_RETURN_TO_MENU="iw:return-to-main-menu";
bool main_menu_running=false;

void mainmenu()
{
if(main_menu_running)throw(IW_RETURN_TO_MENU);
main_menu_running=true;
while(true)
{
try{main_menu_once();}
catch
{
if(get_exception_info()==IW_RETURN_TO_MENU){reset_service_guards();continue;}
// A real failure: log it as the top level would, then stop.
write_client_exception_log();
exit();
}
}
}

class main_menu_entry
{
string id,label;
main_menu_entry(const string &in i,const string &in l){id=i;label=l;}
}
main_menu_entry@[] main_menu_entries()
{
main_menu_entry@[] e;
bool no_account=(name=="" or !account_exists(name));
e.insert_last(main_menu_entry("connect","Play online"));
if(no_account)e.insert_last(main_menu_entry("register","Create an account"));
e.insert_last(main_menu_entry("account","Your account"));
e.insert_last(main_menu_entry("options","Options"));
e.insert_last(main_menu_entry("keypractice","Practise the controls"));
e.insert_last(main_menu_entry("learnsounds","Learn the game's sounds"));
e.insert_last(main_menu_entry("gestures","Touch gestures"));
e.insert_last(main_menu_entry("gesturepractice","Practise touch gestures"));
e.insert_last(main_menu_entry("changelog","What's new"));
e.insert_last(main_menu_entry("readme","Manual"));
e.insert_last(main_menu_entry("cfu","Check for updates"));
if(SCRIPT_COMPILED==false or dev_unlocked)e.insert_last(main_menu_entry("adminpanel","Staff panel"));
if(!SCRIPT_COMPILED)e.insert_last(main_menu_entry("releasebuild","Build a release"));
e.insert_last(main_menu_entry("exit","Exit"));
return e;
}

// One list, not tabs of buttons: arrows move, Home and End go to the ends,
// typing a letter jumps to it, Enter opens, Escape goes to Exit. The old
// version was five tabs with the exit under Settings, and handled the arrow
// keys itself on top of the form handling them too.
string main_menu_last="connect";
void main_menu_once()
{
setupmenu(true,true);
m.play_music();
main_menu_entry@[] entries=main_menu_entries();
string selected="";
if(classic_main_menu)selected=main_menu_buttons(entries);
else
{
nv_form f;
f.create_window("Main menu",false,false);
nv_form_list_box@ list=f.add_list("Main menu","entries");
list.multinav=true;
for(uint i=0;i<entries.length();i++)
{
list.add(entries[i].label,entries[i].id);
if(entries[i].id==main_menu_last)list.set_pos(i);
}
nv_form_button@ open=f.add_button("Open","open",true);
open.hidden=true;
f.focus_control(list);
while(selected=="")
{
wait(5);
f.monitor();
if(key_pressed(KEY_ESCAPE))
{
for(uint i=0;i<entries.length();i++)if(entries[i].id=="exit"){list.set_pos(i,true,true);speak(entries[i].label);}
}
if(f.is_pressed(open) and @list.focused_item!=null)selected=list.focused_item.id;
}
}
main_menu_last=selected;
main_menu_run(selected);
}

// The column-of-buttons layout, for anyone who prefers Tab to arrows.
string main_menu_buttons(main_menu_entry@[]@ entries)
{
nv_form f;
f.create_window("Main menu",false,false);
nv_form_button@[] buttons;
for(uint i=0;i<entries.length();i++)buttons.insert_last(f.add_button(entries[i].label,entries[i].id,i==0,entries[i].id=="exit"));
f.focus_control(buttons[0]);
while(true)
{
wait(5);
f.monitor();
for(uint i=0;i<buttons.length();i++)if(f.is_pressed(buttons[i]))return entries[i].id;
}
return "exit";
}

void main_menu_run(const string &in selected)
{
if(selected=="connect"){m.fade_music(20);connect();}
else if(selected=="register")registermenu();
else if(selected=="account")accountmenu();
else if(selected=="options")optionsmenu();
else if(selected=="keypractice")key_practice_mode();
else if(selected=="learnsounds")learn_game_sounds();
else if(selected=="gestures")show_android_gestures();
else if(selected=="gesturepractice")practice_android_gestures();
else if(selected=="changelog")changelogmenu();
else if(selected=="readme")show_readme();
else if(selected=="cfu")cfu("iw","iw.zip");
else if(selected=="adminpanel")adminpanel();
else if(selected=="releasebuild")compress_release_build();
else if(selected=="exit"){m.fade_music(10);exit();}
}

// Check authorization mode from the server.
bool check_auth_mode_from_server()
{
bool auth_required=false;
network probe;
probe.setup_client(1, 100);
probe.connect(netaddress, netport);
timer ct;
while(ct.elapsed<5000)
{
wait(5);
network_event ev=probe.request();
if(ev.type==event_connect)
{
string msg=string_encrypt("check_authmode", "_';'_clickclick!");
probe.send_reliable(0, msg, 0);
timer rt;
while(rt.elapsed<3000)
{
wait(5);
ev=probe.request();
if(ev.type==event_receive)
{
string r=ev.message;
if(r!="") r=string_decrypt(r, "masonandsamare2bitches");
if(string_contains(r, "authmode_status ", 1)==0)
{
auth_required=(string_replace(r, "authmode_status ", "", false)=="1");
break;
}
}
}
break;
}
if(ev.type==event_disconnect)
break;
}
return auth_required;
}

void registermenu()
{
if(lockout_active and lockout_timer.elapsed<900000)
{
int remaining=(900000-lockout_timer.elapsed)/1000;
dlg("You are locked out due to too many failed login attempts. Please wait "+remaining+" seconds before trying again.");
mainmenu();
return;
}
if(lockout_active and lockout_timer.elapsed>=900000)
{
lockout_active=false;
failed_login_attempts=0;
}
// Require the server to be reachable before accepting registrations.
speak("Checking server status, please wait.");
if (!server_online())
{
dlg("The server is currently offline. You cannot register a new account while the server is down. Please try again later.");
mainmenu();
return;
}
bool auth_required = check_auth_mode_from_server();
// Load rules text.
file rf;
string rules_text="";
if (rf.open("rules.txt","rb"))
{
rules_text=rf.read();
rf.close();
}
else
rules_text="Rules file not found. Please check the game folder.";
// Single registration form.
iw_form f;
f.create_window("Register a New Account", false, true);
int f_user = f.create_input_box("Username (max 20 characters)", "", "", 0, false, false, false);
int f_pass = f.create_input_box("Password (at least 12 characters, must include uppercase, lowercase, and a number)", "", "*", 0, false, false, false);
int f_confirm = f.create_input_box("Confirm password", "", "*", 0, false, false, false);
int f_email = f.create_input_box("Email address", "", "", 0, false, false, false);
f.create_input_box("Rules", rules_text, "", 0, false, true, true);
int f_agree = f.create_checkbox("I agree to the rules", false);
int f_remember = f.create_checkbox("Remember me", true);
int f_register = f.create_button("&Register", true);
int f_back = f.create_button("Go &back", false, true);
f.focus(f_user);
while(true)
{
wait(5);
f.monitor();
if (connected==true)
netloop();
if (f.is_pressed(f_register))
{
string reg_user = f.get_text(f_user);
string reg_pass = f.get_text(f_pass);
string reg_confirm = f.get_text(f_confirm);
string reg_email = f.get_text(f_email);
if (!f.is_checked(f_agree))
{
dlg("You must agree to the rules to register an account.");
continue;
}
if (reg_user == "" or string_contains(reg_user, " ", 1) >= 0)
{
dlg("Username must not be empty or contain spaces.");
continue;
}
if (reg_user.length() > 20)
{
dlg("Username must be 20 characters or fewer.");
continue;
}
if (reg_pass.length() < 12)
{
dlg("Password must be at least 12 characters.");
continue;
}
bool has_upper=false, has_lower=false, has_digit=false;
for (uint ci=0; ci<reg_pass.length(); ci++)
{
string ch=string_mid(reg_pass, ci, 1);
if (ch>="A" and ch<="Z") has_upper=true;
if (ch>="a" and ch<="z") has_lower=true;
if (ch>="0" and ch<="9") has_digit=true;
}
if (!has_upper or !has_lower or !has_digit)
{
dlg("Password must contain at least one uppercase letter, one lowercase letter, and one number.");
continue;
}
string lp=string_to_lower_case(reg_pass);
string[] common_passwords={"1234", "12345", "123456", "1234567", "12345678", "123456789", "1234567890", "abcde", "abcdef", "abcdefg", "abcdefgh", "1111", "11111", "111111", "0000", "00000", "000000", "aaaa", "aaaaa", "aaaaaa", "password", "password1", "password12", "password123", "qwerty", "qwerty1", "qwerty12", "qwerty123", "letmein", "welcome", "monkey", "dragon", "master", "abc123", "login", "princess", "admin", "passw0rd"};
bool is_common=false;
for (uint ci=0; ci<common_passwords.length(); ci++)
{
if (lp==common_passwords[ci]){is_common=true; break;}
}
if (is_common)
{
dlg("That password is too common. Please choose a more secure password.");
continue;
}
if (reg_pass != reg_confirm)
{
dlg("Passwords do not match.");
continue;
}
if (reg_email == "" or !is_valid_email(reg_email))
{
dlg("Please enter a valid email address.");
continue;
}
string reg_error = register_account(reg_user, reg_pass, reg_confirm, reg_email, auth_required);
if (reg_error != "")
{
dlg(reg_error);
continue;
}
// Success.
name = reg_user;
remember_me = f.is_checked(f_remember);
writeprefs();
if (auth_required)
dlg("Account created successfully! Your username is " + reg_user + ". However, authorization mode is enabled. You will not be able to log in until an administrator provides you with your authorization code. Please contact an administrator.");
else
dlg("Account created successfully! Your username is " + reg_user + ". You can now connect to the server.");
break;
}
else if (f.is_pressed(f_back))
break;
}
mainmenu();
}
// The changelog, one release at a time: a list of releases, newest first, and
// Enter opens that release as a list with one change per item. It was the
// whole file -- more than a thousand lines -- in a single text box.
class changelog_release
{
string heading;
string[] entries;
}
// "0.5.2, 45 changes, build 86 (2026-09-22)": the version and how much is in
// it come first, and the build number, which few players need, comes last
// where it can be skipped.
string changelog_release_label(changelog_release@ r)
{
string count=r.entries.length()+(r.entries.length()==1?" change":" changes");
int b=r.heading.find(", build ");
if(b<0)return r.heading+", "+count;
return r.heading.substr(0,b)+", "+count+", "+r.heading.substr(b+2);
}
changelog_release@[] parse_changelog(const string &in text)
{
changelog_release@[] releases;
string[] lines=string_split(string_replace(text,"\r","",true),"\n",false);
changelog_release@ current=null;
for(uint i=0;i<lines.length();i++)
{
string l=lines[i].trim_whitespace();
if(l=="")continue;
if(l.substr(0,7)=="New in "){changelog_release r;r.heading=l.substr(7);releases.insert_last(r);@current=r;continue;}
if(current is null){changelog_release r;r.heading="Earlier changes";releases.insert_last(r);@current=r;}
current.entries.insert_last(l);
}
return releases;
}
void show_changelog_form()
{
file cf;
string cl="";
if (cf.open("changes.txt","rb"))
{
cl=cf.read();
cf.close();
}
changelog_release@[] releases=parse_changelog(cl);
if(releases.length()==0){dlg("The changelog, changes.txt, is missing from the game folder.");return;}
nv_form f;
f.create_window("What's new", false, true);
nv_form_list_box@ list=f.add_list("Releases, newest first","releases");
for(uint i=0;i<releases.length();i++)list.add(changelog_release_label(releases[i]),""+i);
nv_form_button@ open=f.add_button("Read","read",true);
nv_form_button@ close=f.add_button("Close","close",false,true);
f.focus_control(list);
while(true)
{
wait(5);
f.monitor();
if(connected)netloop();
if(f.is_pressed(close))return;
if(f.is_pressed(open) and list.list_position>=0)
{
changelog_release@ r=releases[list.list_position];
show_info_list("Version "+r.heading,r.entries);
f.focus_control(list);
}
}
}
void changelogmenu()
{
show_changelog_form();
mainmenu();
}
// ---------------------------------------------------------------------------
// Account menu — requires server to be online.
// Hub menu that leads to Login, Authorize, and Password Reset sub-menus.
// ---------------------------------------------------------------------------
void accountmenu()
{
speak("Checking server status, please wait.");
if (!server_online())
{
dlg("The server is currently offline. Account management is not available while the server is down. Please try again later.");
mainmenu();
return;
}
setupmenu();
if (name == "" or !account_exists(name))
{
m.add_item_tts("Add an existing account.","login");
m.add_item_tts("Register a new account.","register");
}
else
{
m.add_item_tts("Logged in as "+name+".","info");
if (!is_account_authenticated(name))
m.add_item_tts("Authorize your account with a code.","authorize");
m.add_item_tts("Reset your password.","resetpass");
m.add_item_tts("Log out.","logout");
}
m.add_item_tts("Go back.","back");
int mres=m.run("Account Management",true);
if (m.get_item_name(mres)=="login")
account_login_menu();
else if (m.get_item_name(mres)=="register")
{
registermenu();
return;
}
else if (m.get_item_name(mres)=="authorize")
account_authorize_menu();
else if (m.get_item_name(mres)=="resetpass")
account_reset_menu();
else if (m.get_item_name(mres)=="logout")
{
name="";
writeprefs();
speak("Logged out.");
accountmenu();
}
else if (m.get_item_name(mres)=="info")
accountmenu();
else
mainmenu();
}
// ---------------------------------------------------------------------------
// Account sub-menu: Login
// ---------------------------------------------------------------------------
void account_login_menu()
{
if(lockout_active and lockout_timer.elapsed<900000)
{
int remaining=(900000-lockout_timer.elapsed)/1000;
dlg("You are locked out due to too many failed login attempts. Please wait "+remaining+" seconds before trying again.");
accountmenu();
return;
}
if(lockout_active and lockout_timer.elapsed>=900000)
{
lockout_active=false;
failed_login_attempts=0;
}
iw_form f;
f.create_window("Login", false, true);
int f_user=f.create_input_box("Username", "", "", 0, false, false, false);
int f_pass=f.create_input_box("Password", "", "*", 0, false, false, false);
int f_remember=f.create_checkbox("Remember me", true);
int f_login=f.create_button("&Login", true);
int f_back=f.create_button("Go &back", false, true);
f.focus(f_user);
while(true)
{
wait(5);
f.monitor();
if (connected==true)
netloop();
if (f.is_pressed(f_login))
{
string acc_user=f.get_text(f_user);
string acc_pass=f.get_text(f_pass);
if (acc_user=="" or acc_pass=="")
{
dlg("Please enter both a username and password.");
continue;
}
if (!account_exists(acc_user))
{
// Account doesn't exist — offer to register.
int reg_choice = yesno("No account found with that username. Would you like to register a new account?");
if (reg_choice == 1)
{
registermenu();
return;
}
continue;
}
if (!verify_account(acc_user, acc_pass))
{
failed_login_attempts++;
if(failed_login_attempts>=5)
{
lockout_active=true;
lockout_timer.restart();
dlg("Too many failed login attempts. You are locked out for 15 minutes.");
accountmenu();
return;
}
dlg("Incorrect password. "+(5-failed_login_attempts)+" attempts remaining.");
continue;
}
if (!is_account_authenticated(acc_user))
{
dlg("Your account has not been authenticated yet. Please enter the authorization code provided by an administrator, or contact an administrator to receive your code.");
continue;
}
name=get_account_username(acc_user);
remember_me=f.is_checked(f_remember);
writeprefs();
speak("Logged in as "+name+".");
break;
}
else if (f.is_pressed(f_back))
{
break;
}
}
accountmenu();
}
// ---------------------------------------------------------------------------
// Account sub-menu: Authorize
// ---------------------------------------------------------------------------
void account_authorize_menu()
{
iw_form f;
f.create_window("Authorize Account", false, true);
int f_user=f.create_input_box("Username", "", "", 0, false, false, false);
int f_authcode=f.create_input_box("Authorization code", "", "", 0, false, false, false);
int f_submit=f.create_button("&Authorize account", true);
int f_back=f.create_button("Go &back", false, true);
f.focus(f_user);
while(true)
{
wait(5);
f.monitor();
if (connected==true)
netloop();
if (f.is_pressed(f_submit))
{
string acc_user=f.get_text(f_user);
string code=f.get_text(f_authcode);
if (acc_user=="")
{
dlg("Please enter your account username.");
continue;
}
if (code=="")
{
dlg("Please enter an authorization code.");
continue;
}
if (!account_exists(acc_user))
{
dlg("No account found with that username.");
continue;
}
if (is_account_authenticated(acc_user))
{
dlg("This account is already authenticated.");
continue;
}
if (authenticate_account(acc_user, code))
{
dlg("Account authenticated successfully! You can now log in.");
break;
}
else
{
dlg("Invalid authorization code. Please check the code and try again.");
}
}
else if (f.is_pressed(f_back))
{
break;
}
}
accountmenu();
}
// ---------------------------------------------------------------------------
// Account sub-menu: Password Reset
// ---------------------------------------------------------------------------
void account_reset_menu()
{
iw_form f;
f.create_window("Password Reset", false, true);
int f_user=f.create_input_box("Username", "", "", 0, false, false, false);
int f_resetreq=f.create_button("Request &password reset", true);
int f_resetcode=f.create_input_box("Reset code", "", "", 0, false, false, false);
int f_resetsubmit=f.create_button("&Submit reset code");
int f_back=f.create_button("Go &back", false, true);
f.focus(f_user);
while(true)
{
wait(5);
f.monitor();
if (connected==true)
netloop();
if (f.is_pressed(f_resetreq))
{
string acc_user=f.get_text(f_user);
if (acc_user=="")
{
dlg("Please enter your username before requesting a password reset.");
continue;
}
// Send the request to the server via a temporary connection.
network rn;
rn.setup_client(1, 100);
rn.connect(netaddress, netport);
timer rct;
bool got_response=false;
string rresult="";
while(rct.elapsed<5000)
{
wait(5);
network_event rev=rn.request();
if(rev.type==event_connect)
{
string rmsg=string_encrypt("request_password_reset "+acc_user, "_';'_clickclick!");
rn.send_reliable(0, rmsg, 0);
timer rrt;
while(rrt.elapsed<3000)
{
wait(5);
rev=rn.request();
if(rev.type==event_receive)
{
string rr=rev.message;
if(rr!="") rr=string_decrypt(rr, "masonandsamare2bitches");
rresult=rr;
got_response=true;
break;
}
}
break;
}
if(rev.type==event_disconnect)
break;
}
if(rresult=="reset_requested")
dlg("Password reset requested. Please contact an administrator to receive your reset code.");
else if(rresult=="reset_no_account")
dlg("No account found with that username.");
else
dlg("Could not send the reset request. The server may not have responded.");
}
else if (f.is_pressed(f_resetsubmit))
{
string acc_user=f.get_text(f_user);
string rcode=f.get_text(f_resetcode);
if (acc_user=="")
{
dlg("Please enter your username before submitting a reset code.");
continue;
}
if (rcode=="")
{
dlg("Please enter a reset code.");
continue;
}
// Verify the reset code with the server.
network rn;
rn.setup_client(1, 100);
rn.connect(netaddress, netport);
timer rct;
string rresult="";
while(rct.elapsed<5000)
{
wait(5);
network_event rev=rn.request();
if(rev.type==event_connect)
{
string rmsg=string_encrypt("submit_reset_code "+acc_user+" "+rcode, "_';'_clickclick!");
rn.send_reliable(0, rmsg, 0);
timer rrt;
while(rrt.elapsed<3000)
{
wait(5);
rev=rn.request();
if(rev.type==event_receive)
{
string rr=rev.message;
if(rr!="") rr=string_decrypt(rr, "masonandsamare2bitches");
rresult=rr;
break;
}
}
break;
}
if(rev.type==event_disconnect)
break;
}
if(rresult!="reset_code_ok")
{
dlg("Invalid reset code. Please check the code and try again.");
continue;
}
// Code is valid — prompt for new password.
password_reset_form(acc_user);
break;
}
else if (f.is_pressed(f_back))
{
break;
}
}
accountmenu();
}
// ---------------------------------------------------------------------------
// Password reset form — lets the player enter and confirm a new password.
// Called after the reset code has been verified.
// ---------------------------------------------------------------------------
void password_reset_form(string username)
{
iw_form f;
f.create_window("Reset Password", false, true);
int f_newpass=f.create_input_box("New password", "", "*", 0, false, false, false);
int f_confirm=f.create_input_box("Confirm new password", "", "*", 0, false, false, false);
int f_submit=f.create_button("&Reset password", true);
int f_cancel=f.create_button("&Cancel", false, true);
f.focus(f_newpass);
while(true)
{
wait(5);
f.monitor();
if (f.is_pressed(f_submit))
{
string newpass=f.get_text(f_newpass);
string confirm=f.get_text(f_confirm);
if (newpass.length()<12)
{
dlg("Password must be at least 12 characters.");
continue;
}
bool has_upper=false, has_lower=false, has_digit=false;
for (uint ci=0; ci<newpass.length(); ci++)
{
string ch=string_mid(newpass, ci, 1);
if (ch>="A" and ch<="Z") has_upper=true;
if (ch>="a" and ch<="z") has_lower=true;
if (ch>="0" and ch<="9") has_digit=true;
}
if (!has_upper or !has_lower or !has_digit)
{
dlg("Password must contain at least one uppercase letter, one lowercase letter, and one number.");
continue;
}
string lp=string_to_lower_case(newpass);
string[] common_passwords={"1234", "12345", "123456", "1234567", "12345678", "123456789", "1234567890", "abcde", "abcdef", "abcdefg", "abcdefgh", "1111", "11111", "111111", "0000", "00000", "000000", "aaaa", "aaaaa", "aaaaaa", "password", "password1", "password12", "password123", "qwerty", "qwerty1", "qwerty12", "qwerty123", "letmein", "welcome", "monkey", "dragon", "master", "abc123", "login", "princess", "admin", "passw0rd"};
bool is_common=false;
for (uint ci=0; ci<common_passwords.length(); ci++)
{
if (lp==common_passwords[ci]){is_common=true; break;}
}
if (is_common)
{
dlg("That password is too common. Please choose a more secure password.");
continue;
}
if (newpass!=confirm)
{
dlg("Passwords do not match.");
continue;
}
// Send the new password to the server.
network rn;
rn.setup_client(1, 100);
rn.connect(netaddress, netport);
timer rct;
string rresult="";
while(rct.elapsed<5000)
{
wait(5);
network_event rev=rn.request();
if(rev.type==event_connect)
{
string rmsg=string_encrypt("reset_password "+username+" "+newpass, "_';'_clickclick!");
rn.send_reliable(0, rmsg, 0);
timer rrt;
while(rrt.elapsed<3000)
{
wait(5);
rev=rn.request();
if(rev.type==event_receive)
{
string rr=rev.message;
if(rr!="") rr=string_decrypt(rr, "masonandsamare2bitches");
rresult=rr;
break;
}
}
break;
}
if(rev.type==event_disconnect)
break;
}
if(rresult=="reset_done")
{
dlg("Your password has been reset successfully. You can now log in with your new password.");
return;
}
else
{
dlg("Failed to reset password. The server may not have responded.");
return;
}
}
else if (f.is_pressed(f_cancel))
{
return;
}
}
}
// ---------------------------------------------------------------------------
// Escape menu — replaces the old grave-accent game menu.
// Contains game info, equipment, statistics, and exit.
// ---------------------------------------------------------------------------
void send_team_command(string command)
{
send_reliable(0, "/team "+command, 1);
}

bool team_translocator_received=false,team_translocator_go_received=false,team_translocator_go_success=false;
int team_translocator_points=0,team_translocator_go_cells=0;
string[] team_translocator_names;double[] team_translocator_x,team_translocator_y,team_translocator_z;int[] team_translocator_cell_cost,team_translocator_point_cost;
string team_translocator_go_name="";double team_translocator_go_x=0,team_translocator_go_y=0,team_translocator_go_z=0;
void receive_team_translocator_state(string message){team_translocator_names.resize(0);team_translocator_x.resize(0);team_translocator_y.resize(0);team_translocator_z.resize(0);team_translocator_cell_cost.resize(0);team_translocator_point_cost.resize(0);string[] fields=string_split(message,"|",false);if(fields.length()<3)return;team_translocator_points=string_to_number(fields[1]);if(fields[2]!="-"){string[] entries=string_split(fields[2],",",false);for(uint i=0;i<entries.length();i++){string[] v=string_split(entries[i],"~",false);if(v.length()<6)continue;team_translocator_names.insert_last(v[0]);team_translocator_x.insert_last(string_to_number(v[1]));team_translocator_y.insert_last(string_to_number(v[2]));team_translocator_z.insert_last(string_to_number(v[3]));team_translocator_cell_cost.insert_last(string_to_number(v[4]));team_translocator_point_cost.insert_last(string_to_number(v[5]));}}team_translocator_received=true;}
void receive_team_translocator_go(string message){string[] f=string_split(message,"|",false);team_translocator_go_received=true;team_translocator_go_success=f.length()>=7;if(!team_translocator_go_success)return;team_translocator_go_name=f[1];team_translocator_go_x=string_to_number(f[2]);team_translocator_go_y=string_to_number(f[3]);team_translocator_go_z=string_to_number(f[4]);team_translocator_go_cells=string_to_number(f[5]);}

bool team_state_received=false;
bool team_state_member=false;
bool team_state_invite=false;
bool team_state_can_invite=false;
bool team_state_can_remove=false;
bool team_state_can_shop=false;
string team_state_name="";
string team_state_role="";
string team_state_members="";
int team_state_points=0;
int team_state_member_count=0;

void receive_team_state(string message)
{
string[] fields=string_split(message,"|",false);
if(fields.length()<11 or fields[0]!="team_state") return;
team_state_member=fields[1]=="1";
team_state_name=fields[2]=="-" ? "" : fields[2];
team_state_points=string_to_number(fields[3]);
team_state_role=fields[4]=="-" ? "" : fields[4];
team_state_can_invite=fields[5]=="1";
team_state_can_remove=fields[6]=="1";
team_state_can_shop=fields[7]=="1";
team_state_invite=fields[8]=="1";
team_state_member_count=string_to_number(fields[9]);
team_state_members=fields[10]=="-" ? "" : fields[10];
team_state_received=true;
}

bool refresh_team_state()
{
team_state_received=false;
send_team_command("state");
timer timeout;
while(!team_state_received and timeout.elapsed<2500) { wait(5); netloop(); }
if(!team_state_received) speak("Team information could not be refreshed.");
return team_state_received;
}

// Each item says whether the pool can pay for it, and buying asks first:
// team points are everyone's.
void team_shop_menu()
{
string[] keys={"plane","humvee","apc","tank","supply","armor","revive","recon"};
string[] names={"Duo Plane Kit","Humvee Kit","APC Kit","Tank Kit","Team Supply Beacon","Team Armour Crate","Team Revive Kit","Team Recon Scanner"};
int[] costs={500,450,700,900,150,250,300,200};
string[] notes={"","; the kit has its own five-minute timer","; the kit has its own five-minute timer","; the kit has its own five-minute timer","","","",""};
string[] labels;
for(uint i=0;i<keys.length();i++)
{
int shortfall=costs[i]-team_state_points;
labels.insert_last(names[i]+", "+costs[i]+" points"+notes[i]+(shortfall>0?". The pool is "+shortfall+" short.":"."));
}
string key=pick_from_list("Team shop: "+team_state_points+" points in the pool",labels,keys);
if(key=="")return;
int i=keys.find(key);
if(costs[i]>team_state_points){speak("The pool has "+team_state_points+" points; "+names[i]+" costs "+costs[i]+".");return;}
if(yesno("Spend "+costs[i]+" of the team's "+team_state_points+" points on a "+names[i]+"?")==1)send_team_command("buy "+key);
}

// Choose one thing from a list. Returns its id, or "" if cancelled.
string pick_from_list(const string &in title,string[]@ labels,string[]@ ids)
{
if(labels.length()==0)return "";
if(is_android())
{
int sel=android_select(title,labels);
return (sel>=0 and sel<int(ids.length()))?ids[sel]:"";
}
nv_form f;
f.create_window(title,false,true);
nv_form_list_box@ list=f.add_list(title,"choices");
for(uint i=0;i<labels.length();i++)list.add(labels[i],ids[i]);
nv_form_button@ ok=f.add_button("Choose","choose",true);
ok.hidden=true;
nv_form_button@ cancel=f.add_button("Cancel","cancel",false,true);
f.focus_control(list);
while(true)
{
wait(5);
f.monitor();
if(connected)netloop();
if(f.is_pressed(cancel))return "";
if(f.is_pressed(ok) and @list.focused_item!=null)return list.focused_item.id;
}
return "";
}

// Team members as the server lists them: "name (role), name (role)".
void team_member_list(string[]@ names,string[]@ roles)
{
names.resize(0);roles.resize(0);
if(team_state_members=="")return;
string[] parts=string_split(team_state_members,", ",true);
for(uint i=0;i<parts.length();i++)
{
string entry=parts[i];
int open=string_contains(entry," (",1);
if(open>0 and entry.substr(entry.length()-1)==")")
{
names.insert_last(entry.substr(0,open));
roles.insert_last(entry.substr(open+2,entry.length()-open-3));
}
else{names.insert_last(entry);roles.insert_last("member");}
}
}

// The team screen: one list of what you can do. Members are listed by name,
// and Enter on one offers what you are allowed to do to them. Invitations
// choose from the players online. It was four tabs holding a button or two
// each, and every action asked you to type a player's name -- and for
// permissions, to type the permission's name too.
void team_menu()
{
if(!refresh_team_state()) return;
string[] labels,ids;
string[] names,roles;
team_member_list(names,roles);
if(team_state_member)
{
labels.insert_last("Team "+team_state_name+", "+team_state_points+" points. You are the "+team_state_role+". Enter for the full report.");ids.insert_last("info");
for(uint i=0;i<names.length();i++)
{
bool self=string_to_lower_case(names[i])==string_to_lower_case(name);
labels.insert_last(names[i]+(self?" (you)":"")+", "+roles[i]);ids.insert_last("member:"+i);
}
labels.insert_last("Send a message to the team");ids.insert_last("chat");
if(team_state_can_invite){labels.insert_last("Invite a player");ids.insert_last("invite");}
if(team_state_can_shop){labels.insert_last("Team shop, "+team_state_points+" points to spend");ids.insert_last("shop");}
if(!(team_state_role=="owner" and team_state_member_count>1)){labels.insert_last("Leave the team");ids.insert_last("leave");}
}
else
{
if(team_state_invite){labels.insert_last("Accept your team invitation");ids.insert_last("accept");}
labels.insert_last("Create a team");ids.insert_last("create");
}
string chosen=pick_from_list("Team",labels,ids);
if(chosen=="")return;
if(chosen=="info")send_team_command("info");
else if(chosen=="chat")
{
string message=af_input("Team message", "", true).trim_whitespace();
if(message!="")send_team_command("chat "+message);
}
else if(chosen=="create")
{
string value=af_input("Team name", "", true).trim_whitespace();
if(value!="")send_team_command("create "+value);
}
else if(chosen=="accept")send_team_command("accept");
else if(chosen=="shop")team_shop_menu();
else if(chosen=="leave")
{
if(yesno("Leave "+team_state_name+"?")==1)send_team_command("leave");
}
else if(chosen=="invite")
{
speak("Fetching the players online.");
string[] online=fetch_player_list();
string[] pl,pi;
for(uint i=0;i<online.length();i++)
{
string who=player_name_from_list_label(online[i]);
if(who=="" or string_to_lower_case(who)==string_to_lower_case(name))continue;
bool already=false;
for(uint m=0;m<names.length();m++)if(string_to_lower_case(names[m])==string_to_lower_case(who))already=true;
if(already)continue;
pl.insert_last(online[i]);pi.insert_last(who);
}
if(pl.length()==0){speak("Nobody online who is not already on your team.");return;}
string who=pick_from_list("Invite a player",pl,pi);
if(who!="")send_team_command("invite "+who);
}
else if(chosen.substr(0,7)=="member:")
{
int m=int(string_to_number(chosen.substr(7)));
if(m<0 or m>=int(names.length()))return;
string who=names[m];
string[] al,ai;
bool self=string_to_lower_case(who)==string_to_lower_case(name);
if(!self and team_state_can_remove){al.insert_last("Remove "+who+" from the team");ai.insert_last("remove");}
if(!self and team_state_role=="owner")
{
al.insert_last(roles[m]=="manager"?"Demote "+who+" from manager":"Make "+who+" a manager");ai.insert_last("manager");
al.insert_last("Give or take away "+who+"'s permission to invite players");ai.insert_last("permission invite");
al.insert_last("Give or take away "+who+"'s permission to remove members");ai.insert_last("permission remove");
al.insert_last("Give or take away "+who+"'s permission to spend team points");ai.insert_last("permission shop");
}
if(al.length()==0){speak(self?"That is you.":"You are not able to change "+who+"'s place on the team.");return;}
string act=pick_from_list(who,al,ai);
if(act=="")return;
if(act=="remove"){if(yesno("Remove "+who+" from the team?")==1)send_team_command("remove "+who);}
else if(act=="manager")send_team_command("manager "+who);
else send_team_command("permission "+who+" "+act.substr(11));
}
}

// The game menu: one list, like the main menu and the lobby. Escape closes it
// and puts you back in the match. It was a column of ten buttons, and three of
// them -- equipment, team and the staff panel -- opened a new game menu on
// top of the old one when they finished.
string[] ingame_stats_lines()
{
string[] l;
l.insert_last("Weapon: "+string_replace(weapons[w], "_", " ", true));
l.insert_last("Location: "+get_location());
l.insert_last("Stamina: "+get_stamina_string());
l.insert_last("Effects: "+get_effects_string());
l.insert_last("Items: "+count_total_items()+" in inventory");
l.insert_last("Map: "+map_display_name(mapname));
l.insert_last("Player: "+name);
l.insert_last("Version: "+version_name+", build "+build_number+" ("+build_date+")");
return l;
}
string read_text_file_or(const string &in path,const string &in missing)
{
file tf;
if(!tf.open(path,"rb"))return missing;
string t=tf.read();
tf.close();
return t;
}
string escape_menu_last="resume";
void escape_menu()
{
// Android keeps its purpose-built touch menu; desktop uses NV_form.
if(is_android())
{
android_escape_menu();
return;
}
play_ui_cue("open");
while(true)
{
nv_form f;
f.create_window("Game menu", false, false);
nv_form_list_box@ list=f.add_list("Game menu","entries");
list.add("Back to the match","resume");
list.add("Status","stats");
list.add("Equipment","equipment");
list.add("Team","team");
list.add("Options","options");
list.add("Help topics","help");
list.add("What's new","changes");
list.add("Rules","rules");
list.add("Your account","account");
list.add("Developers","developers");
if(staff_panel_available or dev_unlocked or !SCRIPT_COMPILED)list.add("Staff panel","staff");
list.add("Leave the match","leave");
for(uint i=0;i<list.items.length();i++)if(list.items[i].id==escape_menu_last)list.set_pos(i);
nv_form_button@ open=f.add_button("Open","open",true);
open.hidden=true;
f.focus_control(list);
string chosen="";
while(chosen=="")
{
wait(5);
f.monitor();
if (connected==true)
netloop();
if(key_pressed(KEY_ESCAPE))chosen="resume";
else if(f.is_pressed(open) and @list.focused_item!=null)chosen=list.focused_item.id;
}
escape_menu_last=chosen;
if(chosen=="resume"){play_ui_cue("close");escape_menu_last="resume";return;}
else if(chosen=="stats")show_info_list("Status",ingame_stats_lines());
else if(chosen=="equipment")equipment_menu();
else if(chosen=="team")team_menu();
else if(chosen=="options")optionsmenu();
else if(chosen=="help")show_help_list();
else if(chosen=="changes")show_changelog_form();
else if(chosen=="rules")dlg(read_text_file_or("rules.txt","The rules file is missing."));
else if(chosen=="developers")dlg(read_text_file_or("developers.txt","The developers file is missing."));
else if(chosen=="staff")ingame_adminpanel();
else if(chosen=="account")
{
string[] lines;
lines.insert_last("Name: "+name);
if (account_exists(name))
{
savedata acct(get_account_path(name), ACCOUNT_SECRET);
acct.load();
string em=acct.read("email");
lines.insert_last("Registered account"+(em!=""?", email "+em:", no email on file"));
}
else lines.insert_last("No registered account for this name.");
show_info_list("Your account",lines);
}
else if(chosen=="leave")
{
if(yesno("Leave the match and return to the lobby?")==1)
{
escape_menu_last="resume";
speak("Leaving the match.");
send_reliable(0, "close", 0);
return;
}
}
}
}

// ---------------------------------------------------------------------------
// Equipment menu — view and manage equipped items.
// ---------------------------------------------------------------------------
// What you are wearing and carrying, slot by slot. Enter on a filled slot
// offers to take it off; the list then shows the change and stays where it
// was. It used to open a whole new Equipment screen on top of itself after
// every removal, and armour removal closed it altogether.
string equipment_slot_label(const string &in slot,const string &in item,const string &in detail)
{
if(item=="")return slot+": empty";
return slot+": "+string_replace(item,"_"," ",true)+(detail==""?"":", "+detail);
}
void equipment_menu()
{
int keep=0;
while(true)
{
string[] items={equipped_armor_head,equipped_armor_torso,equipped_armor_arms,equipped_armor_legs,equip_body,equip_holster1,equip_holster2,equip_bracelet,equip_medical};
nv_form f;
f.create_window("Equipment", false, true);
nv_form_list_box@ list=f.add_list("Equipment. Enter on a slot takes it off.","slots");
list.add(equipment_slot_label("Armour, head",equipped_armor_head,equipped_armor_head_durability+" durability"),"0");
list.add(equipment_slot_label("Armour, torso",equipped_armor_torso,equipped_armor_torso_durability+" durability"),"1");
list.add(equipment_slot_label("Armour, arms",equipped_armor_arms,equipped_armor_arms_durability+" durability"),"2");
list.add(equipment_slot_label("Armour, legs",equipped_armor_legs,equipped_armor_legs_durability+" durability"),"3");
list.add(equipment_slot_label("Body",equip_body,equip_body==""?"":round(equipped_item_weight(equip_body),1)+" weight"),"4");
list.add("Holster 1: "+get_holster_slot_label(1)+(equip_holster1==""?"":", "+round(equipped_item_weight(equip_holster1),1)+" weight"),"5");
list.add("Holster 2: "+get_holster_slot_label(2)+(equip_holster2==""?"":", "+round(equipped_item_weight(equip_holster2),1)+" weight"),"6");
list.add(equipment_slot_label("Bracelet",equip_bracelet,equip_bracelet==""?"":round(equipped_item_weight(equip_bracelet),1)+" weight"),"7");
string medical_detail="";
if(equip_medical!="")
{
if(equip_medical=="wirenet")medical_detail=wirenet_charges+" charges, "+(wirenet_active?"active":"inactive")+", ";
medical_detail+=round(equipped_item_weight(equip_medical),1)+" weight";
}
list.add(equipment_slot_label("Medical",equip_medical,medical_detail),"8");
list.add("Total equipped weight: "+total_equipment_weight(),"total");
list.set_pos(keep);
nv_form_button@ remove=f.add_button("Take off","remove",true);
remove.hidden=true;
nv_form_button@ close=f.add_button("Close","close",false,true);
f.focus_control(list);
int sel=-1;
while(sel<0)
{
wait(5);
f.monitor();
if (connected==true)
netloop();
if(f.is_pressed(close))return;
if(f.is_pressed(remove) and list.list_position>=0)
{
if(list.list_position>=9)continue;
sel=list.list_position;
}
}
keep=sel;
if(items[sel]==""){speak("Nothing in this slot.");continue;}
string what=string_replace(items[sel],"_"," ",true);
if(sel>=5 and sel<=6)what=get_holster_slot_label(sel-4);
if(yesno("Take off "+what+"?")!=1)continue;
if(sel<=3)
{
string[] regions={"head","torso","arm","leg"};
send_reliable(0,"armor_unequip "+regions[sel],0);
speak("Taking off "+what+".");
timer settle;
while(settle.elapsed<400){wait(5);if(connected)netloop();}
}
else if(sel==4)unequip_item("body");
else if(sel==5)unequip_holster(1);
else if(sel==6)unequip_holster(2);
else if(sel==7)unequip_item("bracelet");
else if(sel==8)unequip_item("medical");
}
}
// The manual is readme.html. This looked for readme.txt and readme.md, which
// the game does not ship, so it only ever said the file was missing. On
// Windows the manual opens in your web browser, where its headings and tables
// work with a screen reader; elsewhere it is shown here as plain text.
string html_to_text(const string &in html)
{
string res;
bool in_tag=false;
string tag;
for(uint i=0;i<html.length();i++)
{
string c=html.substr(i,1);
if(in_tag)
{
if(c==">")
{
in_tag=false;
string t=tag.lower();
if(t=="p" or t.substr(0,2)=="p " or t=="br" or t=="li" or t=="tr" or t=="/table" or t=="/h1" or t=="/h2" or t=="/h3" or t=="h1" or t=="h2" or t=="h3")res+="\n";
else if(t=="td" or t=="th")res+="  ";
tag="";
}
else tag+=c;
continue;
}
if(c=="<")
{
// A stylesheet or script is not part of the text.
string rest=html.substr(i,8).lower();
if(rest.substr(0,6)=="<style" or rest.substr(0,7)=="<script")
{
string closer=rest.substr(0,6)=="<style"?"</style>":"</script>";
int end=html.lower().find(closer,i);
if(end>=0){i=end+closer.length()-1;continue;}
}
in_tag=true;tag="";continue;
}
if(c=="\r")continue;
res+=c;
}
res=string_replace(res,"&amp;","&",true);
res=string_replace(res,"&lt;","<",true);
res=string_replace(res,"&gt;",">",true);
res=string_replace(res,"&nbsp;"," ",true);
res=string_replace(res,"&middot;",",",true);
res=string_replace(res,"&mdash;"," -- ",true);
res=string_replace(res,"&ndash;","-",true);
res=string_replace(res,"&#39;","'",true);
res=string_replace(res,"&quot;","\"",true);
while(string_contains(res,"\n\n\n",1)>=0)res=string_replace(res,"\n\n\n","\n\n",true);
return res.trim_whitespace();
}
void show_readme()
{
string path=SCRIPT_MAIN_PATH+"/readme.html";
if(!file_exists(path)){dlg("The manual, readme.html, is missing from the game folder.");return;}
if(system_is_windows)
{
string[] args={"explorer.exe",string_replace(path,"/","\\",true)};
process@ viewer=run(args,PROCESS_BACKGROUND,SCRIPT_MAIN_PATH);
if(@viewer!=null and viewer.valid){speak("The manual is opening in your web browser.");return;}
}
file rf;
string text="";
if(rf.open(path,"rb")){text=html_to_text(rf.read());rf.close();}
nv_form f;
f.create_window("Manual", false, true);
nv_form_input@ body=f.add_input("Manual","manual",text,"",0,true,true);
nv_form_button@ close=f.add_button("Close","close",true,true);
f.focus_control(body);
while(true)
{
wait(5);
f.monitor();
if(connected)netloop();
if(f.is_pressed(close))return;
}
}
// Every sound worth knowing before it matters, one list with the category in
// each name. Enter plays the sound you are on; moving through the list is
// quiet, so you can hunt for a particular sound without hearing every one on
// the way.
void learn_game_sounds()
{
string[] labels,files;
labels.insert_last("Movement: Falling");files.insert_last("fall.ogg");
labels.insert_last("Movement: Climbing a ladder");files.insert_last("ladderstep1.ogg");
labels.insert_last("Movement: Blocked, or the edge of the map");files.insert_last(ui_sound("edge"));
labels.insert_last("Movement: Camera hazard");files.insert_last("camerahazard.ogg");
labels.insert_last("Finding your way: Tracked player, on your level");files.insert_last("trackingbeep.ogg");
labels.insert_last("Finding your way: Tracked player, above you");files.insert_last("trackingabove.ogg");
labels.insert_last("Finding your way: Tracked player, below you");files.insert_last("trackingbelow.ogg");
labels.insert_last("Finding your way: Started tracking");files.insert_last("executioners_rage/track.wav");
labels.insert_last("Finding your way: Guidance beacon on a place");files.insert_last("executioners_rage/ui/beacon.wav");
labels.insert_last("Finding your way: Arrived at a place");files.insert_last("executioners_rage/ui/beacon_dest.wav");
