// Programmable Redspot charges use server-owned codes and timers. The client
// supplies only a requested code or duration; it cannot choose coordinates.
// A minute is as long as a fuse is worth, which is the source's own
// TIMEBOMB_MAX_SECONDS. Anything beyond that and the bomb is forgotten
// about long before it goes off.
const int TIMEBOMB_MAX_SECONDS=60;
bool redspot_launch_code(string code)
{
if(code.length()==0 or code.length()>8)return false;string digits="0123456789";for(uint i=0;i<code.length();i++)if(digits.find(code.substr(i,1))<0)return false;return true;
}
bool redspot_explosive_request(uint peer,const string[] &in f)
{
if(f.length()==0 or f[0]!="redspot_explosive")return false;
int pi=get_player_index(peer);if(pi<0 or f.length()!=3)return true;player@ p=players[pi];if(p.death or p.arena_role=="spectator")return true;
if(f[1]=="sat_fire"){
if(physical_count(p,"satellite_bomb_remote")<=0 or !redspot_launch_code(f[2])){send_reliable(peer,"A satellite remote and numeric code of up to eight digits are required.",2);return true;}
play("sat_bomb_remote",p.x,p.y,p.z,p.map);
// Gather the matching charges before any blast can affect the collection.
deployable_explosive@[] charges;for(uint i=0;i<deployable_explosives.length();i++)if(deployable_explosives[i].kind=="satellite_bomb" and deployable_explosives[i].launch_code==f[2] and deployable_explosives[i].map==p.map)charges.insert_last(deployable_explosives[i]);
int fired=0;for(uint c=0;c<charges.length();c++){int found=-1;for(uint i=0;i<deployable_explosives.length();i++)if(deployable_explosives[i] is charges[c]){found=int(i);break;}if(found<0)continue;detonate_deployable(found);fired++;}
send_reliable(peer,fired>0?fired+" satellite bombs fired.":"Nothing on the map answers to that code.",2);return true;
}
if(f[1]=="sat_program"){
if(!redspot_launch_code(f[2])){send_reliable(peer,"A launch code has to be a number of up to eight digits.",2);return true;}
if(physical_count(p,"satellite_bomb")<=0){send_reliable(peer,"You do not carry an unprogrammed satellite bomb.",2);return true;}
send_reliable(peer,"give satellite_bomb -1",0);send_reliable(peer,"give satellite_bomb__code__"+f[2]+" 1",0);play("sat_bomb_set",p.x,p.y,p.z,p.map);send_reliable(peer,"Programmed. You now have a satellite bomb "+f[2]+".",2);return true;
}
string item=f[1]=="sat_place"?"satellite_bomb":(f[1]=="timer_place"?"programmable_timebomb":"");if(item=="")return true;
string owned_item=item=="satellite_bomb"?"satellite_bomb__code__"+f[2]:item;
if(physical_count(p,owned_item)<=0){send_reliable(peer,"You do not carry that charge.",2);return true;}
int owned=0;for(uint i=0;i<deployable_explosives.length();i++)if(deployable_explosives[i].owner==p.name)owned++;if(owned>=8){send_reliable(peer,"You may have no more than eight armed placed explosives.",2);return true;}
if(item=="satellite_bomb" and !redspot_launch_code(f[2])){send_reliable(peer,"Enter a numeric code of up to eight digits for the satellite bomb.",2);return true;}
int seconds=0;if(item=="programmable_timebomb"){seconds=int(string_to_number(f[2]));if(seconds<5 or seconds>TIMEBOMB_MAX_SECONDS or f[2]!=seconds+""){send_reliable(peer,"Pick something between 5 and "+TIMEBOMB_MAX_SECONDS+" seconds.",2);return true;}}
spawn_deployable_explosive(p.x,p.y,p.z,p.facing,p.map,p.name,item);deployable_explosive@ charge=deployable_explosives[deployable_explosives.length()-1];if(item=="satellite_bomb")charge.launch_code=f[2];else charge.detonate_ms_override=seconds*1000;
send_reliable(peer,"give "+owned_item+" -1",0);send_reliable(peer,item=="satellite_bomb"?"Satellite bomb placed with launch code "+f[2]+".":"Timebomb set for "+seconds+" seconds.",2);return true;
}
