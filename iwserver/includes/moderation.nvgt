class moderation_record{string type,account,computer,issuer,reason;bool active=true;moderation_record(string t="",string a="",string c="",string i="",string r=""){type=t;account=a;computer=c;issuer=i;reason=r;}}
moderation_record@[] moderation_records;
dictionary staff_roles;
string normalize_staff_role(string role){role=string_to_lower_case(role.trim_whitespace());if(role=="administrator" or role=="moderator" or role=="support" or role=="builder")return role;return "player";}
string staff_role_for(string account){string role;if(staff_roles.get(string_to_lower_case(account),role))return role;return "player";}
bool staff_can(string account,string permission,bool developer=false,bool legacy_admin=false){if(developer)return true;string role=staff_role_for(account);if(legacy_admin or role=="administrator")return true;if(permission=="staff" or permission=="accounts")return role=="moderator" or role=="support" or role=="builder";if(permission=="moderate")return role=="moderator";if(permission=="support")return role=="support" or role=="moderator";if(permission=="build")return role=="builder";return false;}
void save_staff_roles(){file f;if(!f.open("administration/staff_roles.svr","wb"))return;string[] keys=staff_roles.get_keys();for(uint i=0;i<keys.length();i++){string role;staff_roles.get(keys[i],role);if(role!="player")f.write(moderation_safe(keys[i])+"|"+role+"\n");}f.close();}
void load_staff_roles(){staff_roles.delete_all();if(!file_exists("administration/staff_roles.svr"))return;string[] lines=string_split(file_get_contents("administration/staff_roles.svr"),"\n",false);for(uint i=0;i<lines.length();i++){string[] fields=string_split(lines[i],"|",false);if(fields.length()<2)continue;string role=normalize_staff_role(fields[1]);if(role!="player")staff_roles.set(string_to_lower_case(fields[0]),role);}}
void apply_online_staff_role(string account,string role){for(uint i=0;i<players.length();i++)if(string_to_lower_case(players[i].name)==string_to_lower_case(account)){players[i].admin=role=="administrator" or string_contains(adminlist,players[i].comp,1)>-1;send_reliable(players[i].peer_id,"staff_access "+(players[i].dev?"developer":(players[i].admin?"administrator":role)),0);}for(uint i=0;i<lobby_clients.length();i++)if(string_to_lower_case(lobby_clients[i].name)==string_to_lower_case(account)){lobby_clients[i].admin=role=="administrator" or string_contains(adminlist,lobby_clients[i].comp,1)>-1;send_reliable(lobby_clients[i].peer_id,"staff_access "+(lobby_clients[i].dev?"developer":(lobby_clients[i].admin?"administrator":role)),0);}}
bool set_staff_role(string account,string role,string issuer){role=normalize_staff_role(role);string path="accounts/"+string_to_lower_case(account)+".dat";if(!file_exists(path))return false;string key=string_to_lower_case(account);if(role=="player")staff_roles.delete(key);else staff_roles.set(key,role);save_staff_roles();apply_online_staff_role(account,role);moderation_records.insert_last(moderation_record("staff_role",account,"",issuer,role));save_moderation();return true;}
string staff_role_list(){string[] keys=staff_roles.get_keys();string result="";for(uint i=0;i<keys.length();i++){string role;staff_roles.get(keys[i],role);if(result!="")result+=", ";result+=keys[i]+" ("+role+")";}return result==""?"No persistent staff roles are assigned.":"Assigned staff: "+result;}
bool handle_staff_command(int actor_index,string raw){if(actor_index<0)return false;string[] p=string_split(raw," ",true);if(p.length()==0)return false;string command=string_to_lower_case(p[0]);if(command!="/staff" and command!="/staffrole" and command!="/unstaff")return false;player@ actor=players[actor_index];if(command=="/staff"){if(!staff_can(actor.name,"staff",actor.dev,actor.admin)){send_reliable(actor.peer_id,"Staff access is required.",2);return true;}send_reliable(actor.peer_id,staff_role_list(),2);return true;}if(!actor.dev){send_reliable(actor.peer_id,"Only a developer can assign or remove persistent staff roles.",2);return true;}if(p.length()<2){send_reliable(actor.peer_id,"Usage: /staffrole account administrator, moderator, support, or builder; /unstaff account.",2);return true;}string role=command=="/unstaff"?"player":(p.length()>2?p[2]:"");if((command!="/unstaff" and normalize_staff_role(role)=="player")){send_reliable(actor.peer_id,"Valid roles are administrator, moderator, support, and builder.",2);return true;}role=normalize_staff_role(role);if(!set_staff_role(p[1],role,actor.name)){send_reliable(actor.peer_id,"That account does not exist.",2);return true;}send_reliable(0,"Staff role updated: "+p[1]+" is now "+(role=="player"?"a player":role)+".",2);return true;}
string moderation_safe(string value){value=string_replace(value,"|","/",true);return string_replace(value,"\n"," ",true);}
void save_moderation(){file f;if(!f.open("administration/moderation.svr","wb"))return;for(uint i=0;i<moderation_records.length();i++)f.write(moderation_records[i].type+"|"+moderation_safe(moderation_records[i].account)+"|"+moderation_safe(moderation_records[i].computer)+"|"+moderation_safe(moderation_records[i].issuer)+"|"+(moderation_records[i].active?"1":"0")+"|"+moderation_safe(moderation_records[i].reason)+"\n");f.close();}
void load_moderation(){moderation_records.resize(0);if(!file_exists("administration/moderation.svr"))return;string[] lines=string_split(file_get_contents("administration/moderation.svr"),"\n",false);for(uint i=0;i<lines.length();i++){string[] p=string_split(lines[i],"|",false);if(p.length()<6)continue;moderation_record r(p[0],p[1],p[2],p[3],p[5]);r.active=p[4]=="1";moderation_records.insert_last(r);}}
int active_ban_for(string account,string computer){for(int i=int(moderation_records.length())-1;i>=0;i--)if(moderation_records[i].type=="ban" and moderation_records[i].active and (string_to_lower_case(moderation_records[i].account)==string_to_lower_case(account) or (computer!="" and moderation_records[i].computer==computer)))return i;return -1;}
string moderation_ban_reason(string account,string computer){int i=active_ban_for(account,computer);return i>=0?moderation_records[i].reason:"";}
string moderation_account_list(){string[] files=find_files("accounts/*.dat");string result="";for(uint i=0;i<files.length();i++){savedata account("accounts/"+files[i],ACCOUNT_SECRET);account.load();string username=account.read("username");if(username=="")username=files[i];if(result!="")result+=", ";result+=username+(active_ban_for(username,"")>=0?" (banned)":"");}return result==""?"No accounts exist.":files.length()+" accounts: "+result;}
string moderation_account_names()
{
string[] files=find_files("accounts/*.dat");string result="";for(uint i=0;i<files.length();i++){savedata account("accounts/"+files[i],ACCOUNT_SECRET);account.load();string username=account.read("username");if(username=="")username=string_replace(files[i],".dat","",true);if(result!="")result+="|";result+=username;}return result;
}
string moderation_account_detail(string requested)
{
string path="accounts/"+string_to_lower_case(requested)+".dat";if(!file_exists(path))return "Account not found.";savedata account(path,ACCOUNT_SECRET);account.load();string username=account.read("username");if(username=="")username=requested;string email=account.read("email");bool authenticated=!account.d.exists("authenticated") or account.readn("authenticated")>=1;int credits=load_player_credits(requested);string status="Offline",role=staff_role_for(username);if(role=="player")role="Player";
for(uint i=0;i<lobby_clients.length();i++)if(string_to_lower_case(lobby_clients[i].name)==string_to_lower_case(username)){status="Online in lobby";role=lobby_clients[i].dev?"Developer":(lobby_clients[i].admin?"Administrator":staff_role_for(username));break;}
for(uint i=0;i<players.length();i++)if(string_to_lower_case(players[i].name)==string_to_lower_case(username)){status="Playing "+string_replace(players[i].map,"_"," ",true);role=players[i].dev?"Developer":(players[i].admin?"Administrator":staff_role_for(username));break;}
int warnings=0;for(uint i=0;i<moderation_records.length();i++)if(moderation_records[i].type=="warning" and string_to_lower_case(moderation_records[i].account)==string_to_lower_case(username))warnings++;
int ban=active_ban_for(username,"");string detail="Username: "+username+"<<NL>>Email: "+(email==""?"Not recorded":email)+"<<NL>>Authorization: "+(authenticated?"Authorized":"Pending authorization")+"<<NL>>Role: "+role+"<<NL>>Status: "+status+"<<NL>>Credits: "+credits+"<<NL>>Warnings: "+warnings+"<<NL>>Ban status: "+(ban>=0?"Banned":"Not banned");if(ban>=0)detail+="<<NL>>Ban issuer: "+moderation_records[ban].issuer+"<<NL>>Ban reason: "+moderation_records[ban].reason;return detail;
}
void send_moderation_account_list(uint peer){if(!service_requester_staff(peer)){send_reliable(peer,"accounts_error Developer or administrator access is required.",0);return;}send_reliable(peer,"accounts_list_response "+moderation_account_names(),0);}
void send_moderation_account_detail(uint peer,string username){if(!service_requester_staff(peer)){send_reliable(peer,"accounts_error Developer or administrator access is required.",0);return;}send_reliable(peer,"account_detail_response "+moderation_account_detail(username),0);}
bool handle_moderation_command(int actor_index,string raw){if(actor_index<0)return false;string[] p=string_split(raw," ",true);if(p.length()==0)return false;string command=string_to_lower_case(p[0]);if(command!="/accounts" and command!="/warn" and command!="/warnings" and command!="/ban" and command!="/unban" and command!="/bans")return false;bool dev=players[actor_index].dev;bool staff=command=="/accounts"?staff_can(players[actor_index].name,"accounts",dev,players[actor_index].admin):staff_can(players[actor_index].name,"moderate",dev,players[actor_index].admin);if(!staff){send_reliable(players[actor_index].peer_id,"Your staff role does not permit that moderation action.",2);return true;}if(command=="/accounts"){send_moderation_account_list(players[actor_index].peer_id);return true;}if(command=="/bans"){string result="Active bans: ";int count=0;for(uint i=0;i<moderation_records.length();i++)if(moderation_records[i].type=="ban" and moderation_records[i].active){if(count++>0)result+=", ";result+=moderation_records[i].account+" by "+moderation_records[i].issuer+"; "+moderation_records[i].reason;}send_reliable(players[actor_index].peer_id,count==0?"There are no active bans.":result,2);return true;}if(p.length()<2){send_reliable(players[actor_index].peer_id,"A target account is required.",2);return true;}string target=p[1];if(command=="/warnings"){string result="Warnings for "+target+": ";int count=0;for(uint i=0;i<moderation_records.length();i++)if(moderation_records[i].type=="warning" and string_to_lower_case(moderation_records[i].account)==string_to_lower_case(target)){if(count++>0)result+="; ";result+=moderation_records[i].issuer+": "+moderation_records[i].reason;}send_reliable(players[actor_index].peer_id,count==0?target+" has no warnings.":result,2);return true;}if(command=="/unban"){int changed=0;for(uint i=0;i<moderation_records.length();i++)if(moderation_records[i].type=="ban" and moderation_records[i].active and string_to_lower_case(moderation_records[i].account)==string_to_lower_case(target)){moderation_records[i].active=false;changed++;}save_moderation();send_reliable(players[actor_index].peer_id,changed>0?target+" was unbanned.":"No active ban was found for "+target+".",2);return true;}string prefix=command+" "+target+" ";string reason=string_replace(raw,prefix,"",false).trim_whitespace();if(reason=="")reason=command=="/warn"?"No reason supplied":"Banned by staff";int ti=get_player_index_from(target);string computer=ti>=0?players[ti].comp:"";if(command=="/warn"){moderation_records.insert_last(moderation_record("warning",target,computer,players[actor_index].name,reason));save_moderation();if(ti>=0)send_reliable(players[ti].peer_id,"Official warning from "+players[actor_index].name+": "+reason,2);send_reliable(players[actor_index].peer_id,"Warning recorded for "+target+".",2);return true;}if(ti>=0 and players[ti].dev and ti!=actor_index){send_reliable(players[actor_index].peer_id,"Developers cannot be banned by another player.",2);return true;}moderation_records.insert_last(moderation_record("ban",target,computer,players[actor_index].name,reason));save_moderation();if(ti>=0){send_reliable(players[ti].peer_id,"banned "+reason,0);send_reliable(0,"offline "+players[ti].x+" "+players[ti].y+" "+players[ti].z+" "+players[ti].name+" "+players[ti].map,0);players.remove_at(ti);}send_reliable(0,"play_s ban.ogg",0);send_reliable(players[actor_index].peer_id,target+" was banned. Reason: "+reason,2);return true;}
