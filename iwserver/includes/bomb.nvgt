string impact_sound="120mm_mortarhit";
mortarbomb(int bx,int by,int bz,string bmap,string bowner,string bpayload="standard_ammunition",int authored_radius=0,int authored_damage=0,string authored_label="",string authored_explosion="",string authored_distant="",string authored_impact="")
{
