// HyperComp catalogue and shared cash-machine/banking services.
class terminal_app_def {string id,name,systems,feature,handler;int size,price;bool builtin=false;}
terminal_app_def@[] terminal_apps_catalogue;
bool terminal_handler_supported(string handler){string[] handlers={"market","bank","bunkers","c4","maps","scanner","medical","armoury","team","groups","companions","weather","notes","calculator","translator","radio","camera","diagnostics","files","appstore","wallet","marketwatch","repair","vehicles","survival","news","messenger","tracker","developer","games"};return handlers.find(handler)>=0;}
bool terminal_app_text_valid(string text){item_data@ data=parse_item_file("validation",text);string handler,size,price,systems;data.props.get("handler",handler);data.props.get("size",size);data.props.get("price",price);data.props.get("systems",systems);double bytes=string_to_number(size),cost=string_to_number(price);return terminal_handler_supported(handler) and bytes>=1 and bytes<=65536 and bytes==floor(bytes) and cost>=0 and cost<=2000000000 and cost==floor(cost) and systems!="";}
void init_terminal_apps(){
 if(terminal_apps_catalogue.length()>0)return;
 string root=directory_exists("content/terminal_apps")?"content/terminal_apps":"iwserver/content/terminal_apps";
 string[] dirs=find_directories(root+"/*");dirs.insert_at(0,"");
 for(uint d=0;d<dirs.length();d++){string folder=dirs[d]==""?root:root+"/"+dirs[d];string[] files=find_files(folder+"/*.app");
  for(uint i=0;i<files.length();i++){file f;if(!f.open(folder+"/"+files[i],"rb"))continue;string text=f.read();f.close();if(!terminal_app_text_valid(text))continue;item_data@ data=parse_item_file(files[i].substr(0,files[i].length()-4),text);
   terminal_app_def a;a.id=data.id;a.name=data.name;string value;data.props.get("systems",a.systems);data.props.get("feature",a.feature);data.props.get("handler",a.handler);
   data.props.get("size",value);a.size=int(string_to_number(value));data.props.get("price",value);a.price=int(string_to_number(value));data.props.get("builtin",value);a.builtin=value=="true";
   terminal_apps_catalogue.insert_last(a);
  }
 }
}
int terminal_app_index(string id){init_terminal_apps();for(uint i=0;i<terminal_apps_catalogue.length();i++)if(terminal_apps_catalogue[i].id==id)return int(i);return -1;}
bool terminal_os_supports(string os,string systems){return systems=="all" or string_contains(","+systems+",",","+os+",",1)>=0;}
bool terminal_has_app(player@ p,string id){int i=terminal_app_index(id);return i>=0 and terminal_os_supports(p.terminal_os,terminal_apps_catalogue[i].systems) and (terminal_apps_catalogue[i].builtin or p.terminal_apps.find(id)>=0);}
int terminal_used(player@ p){init_terminal_apps();int used=0;for(uint i=0;i<terminal_apps_catalogue.length();i++)if(terminal_apps_catalogue[i].builtin or p.terminal_apps.find(terminal_apps_catalogue[i].id)>=0)used+=terminal_apps_catalogue[i].size;return used;}
string terminal_catalogue_packet(player@ p){
 string packet="terminal_catalog ";for(uint i=0;i<terminal_apps_catalogue.length();i++){terminal_app_def@ a=terminal_apps_catalogue[i];if(i>0)packet+=";";bool installed=a.builtin or p.terminal_apps.find(a.id)>=0;
 packet+=a.id+"~"+string_replace(a.name," ","_",true)+"~"+a.size+"~"+a.price+"~"+a.systems+"~"+string_replace(a.feature," ","_",true)+"~"+(installed?"1":"0")+"~"+(terminal_os_supports(p.terminal_os,a.systems)?"1":"0")+"~"+(a.builtin?"1":"0")+"~"+a.handler;}return packet;
}
string bank_path(string name){return wallet_accounts_directory+"/"+string_to_lower_case(name)+".bank";}
string bank_number(){string n="77";for(int i=0;i<10;i++)n+=random(0,9);return n;}
bool bank_record_valid(savedata@ bank){
 if(!bank.d.exists("number") or bank.read("pin")=="")return false;string[] fields={"checking","savings","debt"};
 for(uint i=0;i<fields.length();i++){double n=bank.readn(fields[i]);if(n<0 or n>2000000000 or n!=floor(n))return false;}return true;
}
void load_bank(savedata@ bank){
 savedata a(bank.fn+"0",bank.key),b(bank.fn+"1",bank.key);try{a.load();}catch{a.d.delete_all();}try{b.load();}catch{b.d.delete_all();}bool av=bank_record_valid(a) and a.readn("revision")>=1,bv=bank_record_valid(b) and b.readn("revision")>=1;
 if(av or bv){bank.d=av and (!bv or a.readn("revision")>=b.readn("revision"))?a.d:b.d;return;}try{bank.load();}catch{bank.d.delete_all();}
}
bool save_bank(savedata@ bank){
try{
 if(!bank_record_valid(bank))return false;savedata a(bank.fn+"0",bank.key),b(bank.fn+"1",bank.key);a.load();b.load();bool av=bank_record_valid(a),bv=bank_record_valid(b);
 int slot=av and (!bv or a.readn("revision")>=b.readn("revision"))?1:0;double revision=bank.readn("revision")+1;
 savedata next(bank.fn+slot,bank.key);next.d=bank.d;next.add("revision",revision);next.save();savedata check(next.fn,bank.key);check.load();
 if(!bank_record_valid(check) or check.readn("revision")!=revision or check.read("number")!=bank.read("number") or check.read("pin")!=bank.read("pin") or check.readn("checking")!=bank.readn("checking") or check.readn("savings")!=bank.readn("savings") or check.readn("debt")!=bank.readn("debt") or check.read("cards")!=bank.read("cards"))return false;
 bank.d=check.d;return true;
}catch{return false;}
}
bool bank_pin_valid(string pin){if(pin.length()<4 or pin.length()>12)return false;for(uint i=0;i<pin.length();i++)if(pin.substr(i,1)<"0" or pin.substr(i,1)>"9")return false;return true;}
bool recover_bank_transfer(player@ p){
try{
 savedata journal(bank_path(p.name)+".transfer",ACCOUNT_SECRET+"_bank");journal.load();if(journal.readn("pending")!=1)return true;
 savedata bank(bank_path(p.name),ACCOUNT_SECRET+"_bank");load_bank(bank);double before=journal.readn("wallet_before"),after=journal.readn("wallet_after"),checking=bank.readn("checking");int wallet=load_player_credits(p.name);
if(!bank_record_valid(bank) or !journal.d.exists("wallet_before") or !journal.d.exists("wallet_after") or !journal.d.exists("checking_before") or !journal.d.exists("checking_after") or before<0 or after<0 or before>2000000000 or after>2000000000 or journal.readn("checking_before")<0 or journal.readn("checking_after")<0 or journal.readn("checking_before")>2000000000 or journal.readn("checking_after")>2000000000 or before==after or before+ journal.readn("checking_before")!=after+journal.readn("checking_after"))return false;
 if(wallet==after and checking==journal.readn("checking_before")){bank.add("checking",journal.readn("checking_after"));if(!save_bank(bank))return false;}
 else if(!((wallet==before and checking==journal.readn("checking_before")) or (wallet==after and checking==journal.readn("checking_after"))))return false;
 p.credits=wallet;journal.add("pending",double(0));journal.save();savedata verify(journal.fn,journal.key);verify.load();return verify.readn("pending")==0;
}catch{return false;}
}
void bank_handle(player@ p,const string[] &in parsed){
uint peer=p.peer_id;string cmd=parsed[0];if(p.arena_return_map!="" or !physical_bank_access(p)){send_reliable(peer,"bank_error Leave your arena and stay beside a cash machine or carry a BankLink Banking PDA.",0);return;}
 savedata bank(bank_path(p.name),ACCOUNT_SECRET+"_bank");load_bank(bank);
 if(!bank_record_valid(bank) and (file_exists(bank.fn) or file_exists(bank.fn+"0") or file_exists(bank.fn+"1"))){send_reliable(peer,"bank_error Bank records cannot be read. Contact staff; no balance was changed.",0);return;}
 if(cmd=="bank_exists"){send_reliable(peer,"bank_status "+(bank.d.exists("number")?"exists":"none"),0);return;}
 if(cmd=="bank_create"){
  if(bank.d.exists("number")){send_reliable(peer,"bank_error You already have an account.",0);return;}
  if(parsed.length()!=2 or !bank_pin_valid(parsed[1])){send_reliable(peer,"bank_error Choose a numeric PIN of four to twelve digits.",0);return;}
  bank.add("number",bank_number());bank.add("pin",string_encrypt(parsed[1],ACCOUNT_SECRET+"_pin"));bank.add("checking",double(0));bank.add("savings",double(0));bank.add("debt",double(0));bank.add("cards","");
  send_reliable(peer,save_bank(bank)?"bank_ok Account created. Number "+bank.read("number")+".":"bank_error Account could not be saved.",0);return;
 }
 if(!bank.d.exists("number")){send_reliable(peer,"bank_error Create an account first.",0);return;}
 if(cmd=="bank_logout"){p.bank_authorized_until=0;send_reliable(peer,"bank_ok Signed out; bank-linked credsticks are locked.",0);return;}
if(p.bank_pin_blocked_until>double(uptimer.elapsed)){send_reliable(peer,"bank_error Too many incorrect PIN attempts. Try again in thirty seconds.",0);return;}
if(parsed.length()<2 or bank.read("pin")!=string_encrypt(parsed[1],ACCOUNT_SECRET+"_pin")){p.bank_authorized_until=0;p.bank_pin_failures++;if(p.bank_pin_failures>=5){p.bank_pin_failures=0;p.bank_pin_blocked_until=double(uptimer.elapsed)+30000;}send_reliable(peer,"bank_error Incorrect PIN.",0);return;}p.bank_pin_failures=0;p.bank_authorized_until=double(uptimer.elapsed)+300000;
 if(cmd=="bank_status"){send_reliable(peer,"bank_status "+bank.read("number")+"|"+int(bank.readn("checking"))+"|"+int(bank.readn("savings"))+"|"+int(bank.readn("debt"))+"|"+bank.read("cards"),0);return;}
if(cmd=="bank_repay" and parsed.length()==3){double amount=string_to_number(parsed[2]);if(amount<=0 or amount!=floor(amount) or amount>bank.readn("debt") or amount>bank.readn("checking")){send_reliable(peer,"bank_error Choose a whole-credit repayment within your debt and checking balance.",0);return;}bank.add("checking",bank.readn("checking")-amount);bank.add("debt",bank.readn("debt")-amount);send_reliable(peer,save_bank(bank)?"bank_ok Credit-line repayment complete.":"bank_error Repayment could not be saved.",0);return;}
if(cmd=="bank_cash" and parsed.length()==4){string item=parsed[2];double count=string_to_number(parsed[3]);int value=physical_item_value(item);double amount=count*value;if(!is_credit_chip(item) or value<=0 or count<1 or count>100000 or count!=floor(count) or amount>bank.readn("checking")){send_reliable(peer,"bank_error Choose a valid denomination and quantity within your checking balance.",0);return;}bank.add("checking",bank.readn("checking")-amount);if(!save_bank(bank)){send_reliable(peer,"bank_error Cash withdrawal could not be saved.",0);return;}send_reliable(peer,"give "+item+" "+int(count),0);send_reliable(peer,"bank_ok Withdrew "+int(amount)+" credits as physical chips.",0);return;}
 if((cmd=="bank_deposit" or cmd=="bank_withdraw" or cmd=="bank_save" or cmd=="bank_unsave") and parsed.length()==3){
  double amount=string_to_number(parsed[2]);if(amount<=0 or amount>2000000000 or amount!=floor(amount)){send_reliable(peer,"bank_error Enter a positive whole-credit amount.",0);return;}double checking=bank.readn("checking"),savings=bank.readn("savings");
  if(cmd=="bank_save" or cmd=="bank_unsave"){
   if((cmd=="bank_save" and checking<amount) or (cmd=="bank_unsave" and savings<amount)){send_reliable(peer,"bank_error Insufficient funds.",0);return;}
   bank.add("checking",checking+(cmd=="bank_save"?-amount:amount));bank.add("savings",savings+(cmd=="bank_save"?amount:-amount));send_reliable(peer,save_bank(bank)?"bank_ok Transfer complete.":"bank_error Transfer could not be saved.",0);return;
  }
  if((cmd=="bank_deposit" and p.credits<amount) or (cmd=="bank_withdraw" and checking<amount) or (cmd=="bank_withdraw" and int64(p.credits)+int64(amount)>2000000000) or (cmd=="bank_deposit" and checking+amount>2000000000)){send_reliable(peer,"bank_error Insufficient funds or balance limit exceeded.",0);return;}
  savedata journal(bank.fn+".transfer",bank.key);journal.add("checking_before",checking);journal.add("checking_after",checking+(cmd=="bank_deposit"?amount:-amount));journal.add("wallet_before",double(p.credits));journal.add("wallet_after",double(p.credits)+(cmd=="bank_deposit"?-amount:amount));journal.add("pending",double(1));journal.save();
  savedata verify(journal.fn,journal.key);verify.load();if(verify.readn("pending")!=1 or verify.readn("wallet_before")!=journal.readn("wallet_before") or verify.readn("wallet_after")!=journal.readn("wallet_after") or verify.readn("checking_before")!=checking or verify.readn("checking_after")!=journal.readn("checking_after")){send_reliable(peer,"bank_error Transfer journal could not be saved.",0);return;}
  p.bank_transfer_writing=true;bool paid=change_player_credits(p,cmd=="bank_deposit"?-int(amount):int(amount));p.bank_transfer_writing=false;
  if(!paid){journal.add("pending",double(0));journal.save();send_reliable(peer,"bank_error Wallet update failed.",0);return;}
  bank.add("checking",journal.readn("checking_after"));if(!save_bank(bank)){send_reliable(peer,"bank_error Transfer is pending recovery. Reopen banking before making another payment.",0);return;}
  journal.add("pending",double(0));journal.save();send_reliable(peer,"bank_ok Transaction complete.",0);return;
 }
 if(cmd=="bank_card" and parsed.length()==3){
  string type=parsed[2];if(type!="debit" and type!="credit" and type!="prepaid" and type!="virtual"){send_reliable(peer,"bank_error Unknown card type.",0);return;}
  string cards=bank.read("cards");if(cards.length()>2000){send_reliable(peer,"bank_error Card limit reached.",0);return;}
  string item=type=="credit"?"credstick_credit":type=="prepaid"?"credstick_disposable":type=="virtual"?"credstick_bank_plus":"credstick_bank";
  int cost=item_prop_int(item,"card_issue_price",item_prop_int(item,"market_price",50));if(cost<0 or bank.readn("checking")<cost){send_reliable(peer,"bank_error Insufficient checking funds for issuance: "+cost+" credits.",0);return;}
  if(cards!="")cards+=",";cards+=type+"-"+random(1000,9999);bank.add("cards",cards);bank.add("checking",bank.readn("checking")-cost);
  if(!save_bank(bank)){send_reliable(peer,"bank_error Card could not be saved. Nothing was issued.",0);return;}
  send_reliable(peer,"give "+item+" 1",0);send_reliable(peer,"bank_ok Issued "+type+" card and its physical payment credstick; charged "+cost+" credits.",0);return;
 }
 send_reliable(peer,"bank_error Unknown bank operation.",0);
}
void terminal_handle(uint peer,string raw,const string[] &in parsed){
 int i=get_player_index(peer);if(i<0 or parsed.length()==0)return;player@ p=players[i];string cmd=parsed[0];
 if(cmd.find("bank_")==0){if(!recover_bank_transfer(p)){send_reliable(peer,"bank_error A pending transfer cannot be recovered. Contact staff; banking is locked.",0);return;}bank_handle(p,parsed);return;}
 if(!p.has_hypercomp or p.death){send_reliable(peer,"terminal_error You need a working HyperComp Smart Terminal.",0);return;}init_terminal_apps();
 if(cmd=="terminal_state"){send_reliable(peer,"terminal_state "+p.terminal_os+"|"+p.terminal_storage+"|"+terminal_used(p)+"|"+join(p.terminal_apps,","),0);return;}
 if(cmd=="terminal_catalog"){send_reliable(peer,terminal_catalogue_packet(p),0);return;}
 if(cmd=="terminal_os" and parsed.length()==2){
  string os=parsed[1];if(os!="frontier_os" and os!="aegis_os" and os!="openwave" and os!="minimal_recovery"){send_reliable(peer,"terminal_error Unknown operating system.",0);return;}
  p.terminal_os=os;p.bank_authorized_until=0;send_reliable(peer,"terminal_ok Operating system installed. Incompatible apps remain stored but cannot run until a compatible OS is installed.",0);return;
 }
 if(cmd=="terminal_install" and parsed.length()==2){
  int ai=terminal_app_index(parsed[1]);if(ai<0){send_reliable(peer,"terminal_error Application not found.",0);return;}terminal_app_def@ a=terminal_apps_catalogue[ai];
  if(a.builtin or p.terminal_apps.find(a.id)>=0){send_reliable(peer,"terminal_error Already installed.",0);return;}
  if(!terminal_os_supports(p.terminal_os,a.systems)){send_reliable(peer,"terminal_error Incompatible operating system.",0);return;}
  if(terminal_used(p)+a.size>p.terminal_storage){send_reliable(peer,"terminal_error Insufficient storage.",0);return;}
  if(!change_player_credits(p,-a.price)){send_reliable(peer,"terminal_error Payment failed.",0);return;}p.terminal_apps.insert_last(a.id);send_reliable(peer,"terminal_ok Installed "+a.name+".",0);return;
 }
 if(cmd=="terminal_uninstall" and parsed.length()==2){
  int at=p.terminal_apps.find(parsed[1]);if(at<0){send_reliable(peer,"terminal_error Built-in apps cannot be removed; other apps must be installed first.",0);return;}
  p.terminal_apps.remove_at(at);if(parsed[1]=="bank")p.bank_authorized_until=0;send_reliable(peer,"terminal_ok Application removed. Storage reclaimed.",0);return;
 }
 if(cmd=="terminal_notes" and terminal_has_app(p,"notes")){p.terminal_notes=raw.length()>15?raw.substr(15):"";if(p.terminal_notes.length()>4096)p.terminal_notes=p.terminal_notes.substr(0,4096);send_reliable(peer,"terminal_ok Session note saved.",0);return;}
 if(cmd=="terminal_run" and parsed.length()==2){
  int ai=terminal_app_index(parsed[1]);if(ai<0 or !terminal_has_app(p,parsed[1])){send_reliable(peer,"terminal_error That application is not installed or cannot run on this OS.",0);return;}string app=terminal_apps_catalogue[ai].handler,report="";
  if(app=="maps" or app=="weather")report="Map "+map_display_title(p.map)+", zone "+p.zone+". Coordinates "+p.x+", "+p.y+", "+p.z+".";
  else if(app=="medical")report="Health "+p.health+" of 1000. "+(p.bleeding?"Active bleeding. ":"No bleeding. ")+"Medication toxicity "+p.medication_toxicity+" percent; remaining treatment "+p.medication_heal_remaining+".";
  else if(app=="armoury")report="Weapon "+p.current_weapon+". Equipped armour mass "+p.equipped_armor_weight+".";
  else if(app=="diagnostics" or app=="files")report="OS "+p.terminal_os+". Storage "+terminal_used(p)+" of "+p.terminal_storage+" GB. "+p.terminal_apps.length()+" downloaded applications. Network connected.";
  else if(app=="wallet")report="Wallet "+p.credits+" credits. Physical chips are separate from wallet and checking.";
  else if(app=="notes")report=p.terminal_notes;
  else if(app=="scanner" or app=="tracker"){
   int contacts=0;for(uint q=0;q<players.length();q++){player@ other=players[q];if(other.map!=p.map or other.name==p.name or other.death or get_3d_distance(p.x,p.y,p.z,other.x,other.y,other.z)>40)continue;string state=contact_state(p,other,true);if(state=="")continue;contacts++;report+=other.name+": "+relative_position(p,other.x,other.y,other.z)+", "+state+". ";}
   if(contacts==0)report="No detectable contacts within forty tiles.";
  }
  else if(app=="developer"){if(!p.admin and !p.dev){send_reliable(peer,"terminal_error Staff permission required.",0);return;}report=players.length()+" active players; "+maps.length()+" loaded maps; "+terminal_apps_catalogue.length()+" terminal applications.";}
  else if(app=="repair")report="Carry matching armour patches, vehicle supplies or a weapon repair kit. Use the corresponding equipment or vehicle workshop repair action; supplies are consumed only by that action.";
  else if(app=="survival")report="Carry medicine, reserve ammunition and repair supplies. Treatments accumulate toxicity. Deposit valuable physical currency before risking it in combat.";
  else if(app=="translator")report="Language channels determine global-chat routing. Change your language in game options; private and group conversations have their own recipients.";
  else{send_reliable(peer,"terminal_ok Application authorized.",0);return;}send_reliable(peer,"terminal_output "+report,0);return;
 }
 send_reliable(peer,"terminal_error Unknown terminal operation.",0);
}
