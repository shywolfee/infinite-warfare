// Persistent match dashboard and the shared shell appended to every form
// opened from it. Reserved ids keep shell controls separate from a screen's
// own controls and retained reading position.
nv_form game_dashboard_form;
nv_form_list_box@ game_dashboard_options;
bool game_dashboard_ready=false;
bool game_dashboard_tab_mode=true;
string game_dashboard_draft="";
nv_form@ game_dashboard_active_form=null;
timer game_dashboard_refresh_timer;
timer game_dashboard_player_timer;
string[] game_dashboard_players;
bool game_dashboard_player_list_ready=false;
bool game_dashboard_nested_gameplay=false;
bool game_dashboard_nested_exit=false;
nv_form@ game_dashboard_nested_form=null;
string game_dashboard_option_state="";

nv_form_keyboard_area@ dashboard_keyboard(nv_form@ f){return cast<nv_form_keyboard_area@>(f.get_control_by_id("__dash_keyboard"));}
nv_form_list_box@ dashboard_players(nv_form@ f){return cast<nv_form_list_box@>(f.get_control_by_id("__dash_players"));}
nv_form_list_box@ dashboard_transcript(nv_form@ f){return cast<nv_form_list_box@>(f.get_control_by_id("__dash_transcript"));}
nv_form_list_box@ dashboard_conversations(nv_form@ f){return cast<nv_form_list_box@>(f.get_control_by_id("__dash_conversations"));}
nv_form_input@ dashboard_message(nv_form@ f){return cast<nv_form_input@>(f.get_control_by_id("__dash_message"));}
nv_form_button@ dashboard_send(nv_form@ f){return cast<nv_form_button@>(f.get_control_by_id("__dash_send"));}
nv_form_list_box@ dashboard_open_screen(nv_form@ f){return cast<nv_form_list_box@>(f.get_control_by_id("__dash_open_screen"));}

void game_dashboard_attach_shell(nv_form@ f)
{
if(!client_match_active or !game_dashboard_ready or !game_dashboard_tab_mode or f.get_control_by_id("__dash_keyboard") !is null)return;
nv_form_list_box@ open_screen=f.add_list("Open dashboard screen","__dash_open_screen");open_screen.hidden=true;@open_screen.shortcut=nv_shortcut(KEY_V,alt=true);
nv_form_list_box@ players=f.add_list("Players currently in the war; press Enter to view the selected profile","__dash_players");@players.shortcut=nv_shortcut(KEY_P,alt=true);
nv_form_list_box@ transcript=f.add_list("Messages in the selected conversation; this list updates live","__dash_transcript");@transcript.shortcut=nv_shortcut(KEY_R,alt=true);
nv_form_list_box@ conversations=f.add_list("Conversations and chat channels; select one to read or answer","__dash_conversations");@conversations.shortcut=nv_shortcut(KEY_C,alt=true);
nv_form_input@ message=f.add_input("Write a message to the selected conversation; your draft is retained","__dash_message",game_dashboard_draft,"",1024);@message.shortcut=nv_shortcut(KEY_M,alt=true);
nv_form_button@ send=f.add_button("Send the written message to the selected conversation","__dash_send");@send.shortcut=nv_shortcut(KEY_S,alt=true);
nv_form_keyboard_area@ keyboard=f.add_keyboard_area("Game keyboard area (Alt+G)","__dash_keyboard");@keyboard.shortcut=nv_shortcut(KEY_G,alt=true);
keyboard.custom_type=" ";
game_dashboard_refresh_shell(f,true);
}

void game_dashboard_add_conversation(nv_form_list_box@ list,const string &in label,const string &in id)
{
for(uint i=0;i<list.items.length();i++)if(list.items[i].id==id)return;
list.add(label,id);
}

string game_dashboard_conversation_buffer(const string &in id)
{
if(id=="global")
{
for(int i=int(buffers.length())-1;i>=0;i--)if(string_contains(buffers[i].name,"language: ",1)==0)return buffers[i].name;
return "chats";
}
if(id=="map")return "map chat";
if(id=="team")return "team chat";
if(string_contains(id,"group:",1)==0)return "group: "+id.substr(6);
if(string_contains(id,"private:",1)==0)return "private: "+id.substr(8);
return "";
}

void game_dashboard_refresh_conversations(nv_form@ f)
{
nv_form_list_box@ list=dashboard_conversations(f);if(@list==null)return;
string selected=@list.focused_item!=null?list.focused_item.id:"global";list.items.resize(0);
game_dashboard_add_conversation(list,"Global chat; messages in your selected language channel","global");
if(mapname!="main")game_dashboard_add_conversation(list,"Current map chat; messages for everyone on this map","map");
game_dashboard_add_conversation(list,"Team chat; private coordination with your current team","team");
for(uint i=0;i<my_groups.length();i++)game_dashboard_add_conversation(list,"Group conversation with "+my_groups[i].name,"group:"+my_groups[i].name);
for(uint i=0;i<buffers.length();i++)
{
string n=buffers[i].name;
if(string_contains(n,"private: ",1)==0)game_dashboard_add_conversation(list,"Private conversation with "+n.substr(9),"private:"+n.substr(9));
else if(string_contains(n,"group: ",1)==0)game_dashboard_add_conversation(list,"Group conversation with "+n.substr(7),"group:"+n.substr(7));
}
for(uint i=0;i<list.items.length();i++)if(list.items[i].id==selected){list.set_pos(i,false);return;}
if(list.items.length()>0)list.set_pos(0,false);
}

void game_dashboard_refresh_transcript(nv_form@ f)
{
nv_form_list_box@ conversations=dashboard_conversations(f);nv_form_list_box@ transcript=dashboard_transcript(f);
if(@conversations==null or @transcript==null or @conversations.focused_item==null)return;
string buffer_name=game_dashboard_conversation_buffer(conversations.focused_item.id);
int old=transcript.list_position;bool follow=old<0 or old>=int(transcript.items.length())-1;transcript.items.resize(0);
int bi=-1;for(uint i=0;i<buffers.length();i++)if(buffers[i].name==buffer_name){bi=int(i);break;}
if(bi>=0)for(uint i=0;i<buffers[bi].items.length();i++)transcript.add(buffers[bi].items[i],""+i);
if(transcript.items.length()==0)transcript.add("No messages have arrived in this conversation yet.","empty");
if(follow)old=int(transcript.items.length())-1;if(old>=int(transcript.items.length()))old=int(transcript.items.length())-1;
transcript.set_pos(old<0?0:old,false);
}

void game_dashboard_refresh_players(nv_form@ f)
{
nv_form_list_box@ list=dashboard_players(f);if(@list==null)return;
string selected=@list.focused_item!=null?list.focused_item.id:"";list.items.resize(0);
for(uint i=0;i<game_dashboard_players.length();i++)list.add(game_dashboard_players[i],player_name_from_list_label(game_dashboard_players[i]));
if(list.items.length()==0)list.add("Waiting for the live player list.","");
for(uint i=0;i<list.items.length();i++)if(list.items[i].id==selected){list.set_pos(i,false);return;}list.set_pos(0,false);
}

void game_dashboard_refresh_shell(nv_form@ f,bool force=false)
{
if(@f==null or f.get_control_by_id("__dash_keyboard") is null)return;
game_dashboard_refresh_conversations(f);game_dashboard_refresh_transcript(f);game_dashboard_refresh_players(f);
if(force){nv_form_input@ input=dashboard_message(f);if(@input!=null)input.text=game_dashboard_draft;}
}

void game_dashboard_receive_player_list(const string &in message)
{
game_dashboard_players.resize(0);string data=string_replace(message,"lobby_plist ","",false);string[] entries=string_split(data,",",false);
for(uint i=0;i<entries.length();i++)
{
string[] parts=string_split(entries[i],"|",false);if(parts.length()<3)continue;string label=parts[0];
if(string_contains(parts[1],"d",1)>-1)label+=" (dev)";if(string_contains(parts[1],"a",1)>-1)label+=" (admin)";
label+=" - "+map_display_name(parts[2]);game_dashboard_players.insert_last(label);
}
game_dashboard_player_list_ready=true;
}

void game_dashboard_init()
{
game_dashboard_ready=true;game_dashboard_tab_mode=true;game_dashboard_draft="";@game_dashboard_active_form=null;
game_dashboard_form.reset();game_dashboard_form.create_window("Infinite Warfare dashboard",false,false);
@game_dashboard_options=game_dashboard_form.add_list("Game options and actions; press its shortcut or Enter to open the selected choice","options");@game_dashboard_options.shortcut=nv_shortcut(KEY_L,alt=true);
string[] shortcut_ids={"stats","equipment","team","inventory","spend","groups","companions","arenas","options","help","changes","announcements","rules","account","developers","staff"};
int[] shortcut_keys={KEY_S,KEY_E,KEY_T,KEY_I,KEY_X,KEY_B,KEY_C,KEY_K,KEY_O,KEY_H,KEY_W,KEY_N,KEY_R,KEY_A,KEY_D,KEY_M};
for(uint i=0;i<shortcut_ids.length();i++){nv_form_button@ shortcut=game_dashboard_form.add_button("", "__dash_option_"+shortcut_ids[i]);shortcut.hidden=true;@shortcut.shortcut=nv_shortcut(shortcut_keys[i],alt=true);}
game_dashboard_option_state="";game_dashboard_refresh_timer.restart();game_dashboard_player_timer.restart();
game_dashboard_form.monitor();game_dashboard_form.focus_control(dashboard_keyboard(game_dashboard_form),true,false);
}

void game_dashboard_touch_open()
{
if(!game_dashboard_ready){speak("The dashboard is not available yet.");return;}
game_dashboard_tab_mode=true;
nv_form@ f=game_dashboard_nested_gameplay?game_dashboard_nested_form:game_dashboard_form;
if(@f==null)return;
if(f.get_control_by_id("__dash_keyboard") is null){f.shell_attached=false;game_dashboard_attach_shell(f);}
if(@f==@game_dashboard_form)f.focus_control(game_dashboard_options);else for(uint i=0;i<f.controls.length();i++)if(!f.controls[i].hidden and f.controls[i].enabled and f.controls[i].type!=nv_form_ct_keyboard_area){f.focus_control(f.controls[i]);break;}
speak("Dashboard mode.");
}

string game_dashboard_current_option_state()
{
return (companion_piloting?"pilot:"+piloted_companion_id:"body")+"|"+(count_total_items()>0?"inventory":"empty")+"|"+(client_market_device_available()?"terminal":"offline")+"|"+client_arena_id+"|"+client_arena_state+"|"+((staff_panel_available or dev_unlocked or !SCRIPT_COMPILED)?"staff":"player");
}

void game_dashboard_rebuild_options(bool force)
{
if(@game_dashboard_options==null)return;string state=game_dashboard_current_option_state();if(!force and state==game_dashboard_option_state)return;
string selected=@game_dashboard_options.focused_item!=null?game_dashboard_options.focused_item.id:"stats";game_dashboard_option_state=state;game_dashboard_options.items.resize(0);
if(companion_piloting)
{
game_dashboard_options.add("Review companion telemetry: Read the controlled actor's health, coordinates, heading and orders. Alt+S.","stats");
game_dashboard_options.add("Return to your body: End direct control without moving your body. Alt+E.","equipment");
game_dashboard_options.add("Use companion attack: Fire once at a valid nearby hostile when recharged. Alt+X.","spend");
game_dashboard_options.add("Open companion command center: Manage this actor and the rest of your fleet. Alt+C.","companions");
game_dashboard_options.add("Manage your groups: Keep communicating while controlling your companion. Alt+B.","groups");
game_dashboard_options.add("Configure the game: Adjust accessibility and controls. Alt+O.","options");
game_dashboard_options.add("Read companion help: Browse controls and mechanics. Alt+H.","help");
for(uint i=0;i<game_dashboard_options.items.length();i++)if(game_dashboard_options.items[i].id==selected){game_dashboard_options.set_pos(i,false);return;}
game_dashboard_options.set_pos(0,false);return;
}
game_dashboard_options.add("Review your current status: Display your weapon, location, stamina, effects, inventory total, map, player name and game version. Alt+S.","stats");
game_dashboard_options.add("Manage your equipment: Review and change armour, holsters and other currently equipped gear. Alt+E.","equipment");
game_dashboard_options.add("Manage your team: Control membership, roles, shared resources, team chat and team actions. Alt+T.","team");
if(count_total_items()>0)game_dashboard_options.add("Open your complete inventory: Browse, inspect, configure, use, give or drop the items you carry. Alt+I.","inventory");
if(client_market_device_available())game_dashboard_options.add("Spend credits: Open the marketplace through your SupplyLink ordering device. Alt+X.","spend");
game_dashboard_options.add("Manage your groups: Review group conversations, invitations, membership and quick-chat selection. Alt+B.","groups");
game_dashboard_options.add("Control deployed companions: View, command, recall or directly pilot every drone and chimp you own. Alt+C.","companions");
game_dashboard_options.add("Enter automatic PK arenas: Create, join, spectate and manage public arena instances. Alt+K.","arenas");
game_dashboard_options.add("Configure Infinite Warfare: Change audio, accessibility, controls, interface, network and gameplay preferences. Alt+O.","options");
game_dashboard_options.add("Browse game help: Read controls, mechanics and other reference topics. Alt+H.","help");
game_dashboard_options.add("View game changes: Display the latest changes and release notes. Alt+W.","changes");
game_dashboard_options.add("View latest announcements: Read persistent news posted by the Infinite Warfare staff. Alt+N.","announcements");
game_dashboard_options.add("Read the game rules: Review the standards that apply while playing online. Alt+R.","rules");
game_dashboard_options.add("Review your account: Display your player name, registration and saved email status. Alt+A.","account");
game_dashboard_options.add("View the developers and credits: Read who created and contributed to Infinite Warfare. Alt+D.","developers");
if(staff_panel_available or dev_unlocked or !SCRIPT_COMPILED)game_dashboard_options.add("Open staff administration: Access moderation, world-building, account and server tools. Alt+M.","staff");
for(uint i=0;i<game_dashboard_options.items.length();i++)if(game_dashboard_options.items[i].id==selected){game_dashboard_options.set_pos(i,false);return;}
if(game_dashboard_options.items.length()>0)game_dashboard_options.set_pos(0,false);
}

bool game_dashboard_keyboard_active()
{
if(game_dashboard_nested_gameplay and @game_dashboard_nested_form!=null)return !game_dashboard_nested_exit and @game_dashboard_nested_form.current_control==@dashboard_keyboard(game_dashboard_nested_form);
return !game_dashboard_ready or @game_dashboard_form.current_control==@dashboard_keyboard(game_dashboard_form);
}
void game_dashboard_focus_game(){if(game_dashboard_ready)game_dashboard_form.focus_control(dashboard_keyboard(game_dashboard_form));}

void game_dashboard_begin_nested_gameplay(nv_form@ f)
{
if(@f==null or @f==@game_dashboard_form or game_dashboard_nested_gameplay)return;
game_dashboard_nested_gameplay=true;game_dashboard_nested_exit=false;@game_dashboard_nested_form=f;
game(-1);
game_dashboard_nested_gameplay=false;game_dashboard_nested_exit=false;@game_dashboard_nested_form=null;
}

void game_dashboard_show_account()
{
string[] lines;lines.insert_last("Name: "+name);
if(account_exists(name)){savedata acct(get_account_path(name),ACCOUNT_SECRET);acct.load();string em=acct.read("email");lines.insert_last("Registered account"+(em!=""?", email "+em:", no email on file"));}
else lines.insert_last("No registered account for this name.");show_info_list("Your account",lines);
}

bool announcements_received=false;
string announcements_text="";
bool announcement_body_received=false;
string announcement_body_id="",announcement_body_text="";
void show_staff_announcements()
{
announcements_received=false;announcements_text="";send_reliable(0,"announcements_get",0);timer timeout;
while(connected and !announcements_received and timeout.elapsed<4000){wait(5);netloop(false);}
if(!announcements_received){speak("The announcements request timed out.");return;}
string[] rows=string_split(announcements_text,";",true);nv_form f;f.create_window("Staff announcements",false,true);nv_form_list_box@ titles=f.add_list("Announcements; move through titles, then Tab to read the selected body","announcement_titles");for(uint i=0;i<rows.length();i++){string[] fields=string_split(rows[i],"~",false);if(fields.length()>=2)titles.add(fields[1],fields[0]);}if(titles.items.length()==0)titles.add("No staff announcements have been posted.","none");nv_form_markdown@ body=f.add_markdown("Selected announcement body","announcement_body","Select an announcement title.");@body.on_link=iw_document_link;nv_form_button@ close=f.add_button("Close announcements","close",false,true);f.focus_control(titles);int previous=-1;while(true){wait(5);f.monitor();if(connected)netloop(false);if(f.is_pressed(close))return;if(titles.list_position!=previous and @titles.focused_item!=null){previous=titles.list_position;if(titles.focused_item.id=="none"){body.set_markdown("There are no announcements to read.");continue;}announcement_body_received=false;announcement_body_id="";announcement_body_text="";send_reliable(0,"announcement_get "+titles.focused_item.id,0);timer timeout;while(connected and !announcement_body_received and timeout.elapsed<3000){wait(5);f.monitor();netloop(false);}body.set_markdown(announcement_body_received and announcement_body_id==titles.focused_item.id?announcement_body_text:"The selected announcement could not be loaded.");}}
}

void game_dashboard_open_action_id(const string &in chosen)
{
if(companion_piloting){if(chosen=="stats"){speak(companion_telemetry(companion_view()));return;}if(chosen=="equipment"){stop_companion_pilot();return;}if(chosen=="spend"){send_reliable(0,"companion fire "+piloted_companion_id+" now",0);return;}}
if(chosen=="stats")show_info_list("Status",ingame_stats_lines());else if(chosen=="equipment")equipment_menu();else if(chosen=="team")team_menu();
else if(chosen=="spend"){if(!client_market_device_available())speak("Spend credits requires a SupplyLink ordering device in your inventory.");else online_supply_shop();}
else if(chosen=="inventory")inventory_menu();else if(chosen=="groups")groups_menu();else if(chosen=="companions")companion_remote_menu();
else if(chosen=="arenas")arena_manager();
else if(chosen=="options")optionsmenu();else if(chosen=="help")show_help_list();else if(chosen=="changes")show_changelog_form();
else if(chosen=="announcements")show_staff_announcements();
else if(chosen=="rules")dlg(read_text_file_or("rules.txt","The rules file is missing."));else if(chosen=="account")game_dashboard_show_account();
else if(chosen=="developers")dlg(read_text_file_or("developers.txt","The developers file is missing."));else if(chosen=="staff")ingame_adminpanel();
}

void game_dashboard_open_action(){if(@game_dashboard_options.focused_item!=null)game_dashboard_open_action_id(game_dashboard_options.focused_item.id);}

bool game_dashboard_option_shortcut(nv_form@ f)
{
if(@game_dashboard_options==null)return false;for(uint i=0;i<game_dashboard_options.items.length();i++)
{
nv_form_button@ shortcut=cast<nv_form_button@>(f.get_control_by_id("__dash_option_"+game_dashboard_options.items[i].id));
if(@shortcut!=null and shortcut.check_shortcut()){f.shortcut.consume();game_dashboard_options.set_pos(i,false);game_dashboard_open_action_id(game_dashboard_options.items[i].id);return true;}
}
return false;
}

void game_dashboard_show_player_profile(nv_form@ f,const string &in selected_name)
{
if(selected_name=="")return;player_profile_received=false;player_profile_text="";send_reliable(0,"player_profile "+selected_name,0);timer timeout;
nv_form waiting;waiting.create_window("Loading "+selected_name+" profile",false,true);waiting.add_input("Profile status","status","Waiting for the selected player's live profile.","",0,true,true);nv_form_button@ cancel=waiting.add_button("Cancel profile request","cancel",false,true);waiting.focus_control(cancel);
while(!player_profile_received and timeout.elapsed<3500){wait(5);waiting.monitor();if(waiting.is_pressed(cancel))return;netloop(false);}if(!player_profile_received){speak("The player profile request timed out.");return;}
nv_form_list_box@ panel=dashboard_open_screen(f);if(@panel==null)return;panel.items.resize(0);string[] lines=string_split(player_profile_text,"\n",true);
for(uint i=0;i<lines.length();i++)panel.add(lines[i],""+i);if(panel.items.length()==0)panel.add("No profile details were returned.","empty");
panel.caption=selected_name+" profile; this screen remains open inside the dashboard";panel.hidden=false;panel.set_pos(0,false);f.focus_control(panel);
}

void game_dashboard_send_message(nv_form@ f)
{
nv_form_input@ input=dashboard_message(f);nv_form_list_box@ conversations=dashboard_conversations(f);if(@input==null or @conversations==null)return;
game_dashboard_draft=input.text;string text=game_dashboard_draft.trim_whitespace();if(text==""){speak("Enter a message first.");return;}
if(@conversations.focused_item==null){speak("Select a conversation first.");return;}string target=conversations.focused_item.id;
if(target=="global")send_reliable(0,text,1);else if(target=="map")send_reliable(0,text,6);else if(target=="team")send_team_command("chat "+text);
else if(string_contains(target,"group:",1)==0){group_request("say",target.substr(6),text);p.play_stationary("group/send.ogg",false);}
else if(string_contains(target,"private:",1)==0)send_reliable(0,"/pm "+target.substr(8)+" "+text,1);
game_dashboard_draft="";input.text="";f.focus_control(input);
}

void game_dashboard_toggle_tab_mode(nv_form@ f)
{
nv_form_input@ input=dashboard_message(f);if(@input!=null)game_dashboard_draft=input.text;game_dashboard_tab_mode=!game_dashboard_tab_mode;
if(game_dashboard_draft.trim_whitespace()!="")speak("Your unsent conversation text is still waiting and will be here when you return to the dashboard.");
if(@f!=@game_dashboard_form and @f.cancel_control!=null){f.cancel_control.fire();if(game_dashboard_nested_gameplay)game_dashboard_nested_exit=true;}else f.focus_control(dashboard_keyboard(f));
speak(game_dashboard_tab_mode?"Dashboard mode. Tab and Shift Tab now move through the dashboard.":"Inventory mode. Tab and Shift Tab now cycle your inventory.");
}

bool game_dashboard_shell_pre_monitor(nv_form@ f)
{
if(!client_match_active or !game_dashboard_ready)return false;
if(f.get_control_by_id("__dash_keyboard") is null)
{
if((key_down(KEY_LMENU) or key_down(KEY_RMENU)) and key_pressed(KEY_F)){game_dashboard_tab_mode=true;f.shell_attached=false;speak("Dashboard mode. This screen will now connect to the dashboard.");return true;}
return false;
}
if(@game_dashboard_active_form!=@f){@game_dashboard_active_form=f;nv_form_input@ incoming=dashboard_message(f);if(@incoming!=null)incoming.text=game_dashboard_draft;}
nv_form_input@ input=dashboard_message(f);if(@input!=null and @f.current_control==@input)game_dashboard_draft=input.text;
if((key_down(KEY_LMENU) or key_down(KEY_RMENU)) and key_pressed(KEY_F)){game_dashboard_toggle_tab_mode(f);return true;}
if(!game_dashboard_tab_mode and @f!=@game_dashboard_form){if(@f.cancel_control!=null)f.cancel_control.fire();return true;}
nv_form_keyboard_area@ keyboard=dashboard_keyboard(f);
// Alt+G is a dashboard-only chord and must match exactly.  In particular,
// Alt+Shift+G belongs to the manual-ammunition eject action.
if(game_dashboard_tab_mode and (key_down(KEY_LMENU) or key_down(KEY_RMENU)) and !shift_is_down() and key_pressed(KEY_G)){f.focus_control(keyboard);if(@f!=@game_dashboard_form and !game_dashboard_nested_gameplay)game_dashboard_begin_nested_gameplay(f);return true;}
if(@f.current_control==@keyboard and @f!=@game_dashboard_form and !game_dashboard_nested_gameplay){game_dashboard_begin_nested_gameplay(f);return true;}
// Nested screens own Escape: their cancel control returns to the previous
// dashboard menu. Only the dashboard root uses Escape to resume the game.
nv_form_markdown@ open_document=cast<nv_form_markdown@>(f.current_control);
if(@f.current_control!=@keyboard and !(@open_document!=null and open_document.elements) and key_pressed(KEY_ESCAPE)){
if(@f!=@game_dashboard_form and @f.cancel_control!=null){f.cancel_control.fire();return true;}
f.focus_control(keyboard);return true;}
if(game_dashboard_refresh_timer.elapsed>300){game_dashboard_rebuild_options(false);game_dashboard_refresh_shell(f);game_dashboard_refresh_timer.restart();}
if(game_dashboard_player_timer.elapsed>5000){send_reliable(0,"lobby_playerlist",0);game_dashboard_player_timer.restart();}
if(!game_dashboard_tab_mode and @f.current_control==@keyboard and key_pressed(KEY_TAB)){if(companion_piloting)companion_remote_menu();else{if(shift_is_down())cycle_inv(0);else cycle_inv(1);p.play_stationary("invmove.ogg",false);}return true;}
if(@f.current_control==@game_dashboard_options and game_dashboard_option_shortcut(f))return true;
if(@f.current_control!=@keyboard)
{
// An open screen owns its announced shortcuts before shared shell controls.
// Otherwise Alt+S starts sending chat instead of starting an arena, for example.
if(@f!=@game_dashboard_form)for(uint i=0;i<f.controls.length();i++){nv_form_control@ c=f.controls[i];if(c.id.substr(0,7)=="__dash_" or c.hidden or !c.enabled)continue;if(c.check_shortcut()){c.shortcut_focus();f.shortcut.consume();return true;}}
nv_form_control@[] shell_controls={game_dashboard_options,dashboard_open_screen(f),dashboard_players(f),dashboard_transcript(f),dashboard_conversations(f),dashboard_message(f),dashboard_send(f)};
for(uint i=0;i<shell_controls.length();i++)if(@shell_controls[i]!=null and @shell_controls[i]!=@game_dashboard_options and shell_controls[i].check_shortcut()){shell_controls[i].shortcut_focus();f.shortcut.consume();if(@shell_controls[i]==@dashboard_send(f)){f.is_pressed(dashboard_send(f));game_dashboard_send_message(f);}return true;}
}
if(@f.current_control!=@game_dashboard_options and @f.current_control!=@keyboard)
{
for(uint i=0;i<game_dashboard_options.items.length();i++){nv_form_button@ option_shortcut=cast<nv_form_button@>(f.get_control_by_id("__dash_option_"+game_dashboard_options.items[i].id));if(@option_shortcut!=null and option_shortcut.check_shortcut()){if(@f.current_control!=@keyboard){f.shortcut.consume();return true;}}}
}
bool activate=false;
if(@f.current_control==@game_dashboard_options or @f.current_control==@dashboard_players(f) or @f.current_control==@input or @f.current_control==@dashboard_send(f))activate=key_pressed(KEY_RETURN) or key_pressed(KEY_NUMPAD_ENTER);
if(activate and @f.current_control==@game_dashboard_options){game_dashboard_open_action();return true;}
nv_form_list_box@ players=dashboard_players(f);if(activate and @f.current_control==@players and @players.focused_item!=null and players.focused_item.id!=""){game_dashboard_show_player_profile(f,players.focused_item.id);return true;}
if((activate and (@f.current_control==@input or @f.current_control==@dashboard_send(f))) or f.is_pressed(dashboard_send(f))){game_dashboard_send_message(f);return true;}return false;
}

void game_dashboard_tick()
{
if(!game_dashboard_ready)return;game_dashboard_rebuild_options(false);form_net_depth++;
if(game_dashboard_nested_gameplay and @game_dashboard_nested_form!=null)game_dashboard_nested_form.monitor();else game_dashboard_form.monitor();
form_net_depth--;
}
