string terminal_request(string command,string prefix,int timeout=3500){send_reliable(0,command,0);string response;if(!wait_for_service_response(prefix,response,timeout)){speak("The terminal service did not answer.");return "";}return response;}
void terminal_bank_menu()
{
string pin=af_input("Bank PIN","",true);if(pin=="")return;string status=terminal_request("bank_status "+pin,"bank_",3500);
if(string_contains(status,"bank_error Create",1)==0){string create_pin=af_input("Create bank account: choose PIN",pin,true);if(create_pin!="")speak(string_replace(terminal_request("bank_create "+create_pin,"bank_",3500),"bank_ok ","",false));return;}
if(string_contains(status,"bank_status ",1)!=0){speak(string_replace(status,"bank_error ","",false));return;}
while(true){string detail=string_replace(status,"bank_status ","",false);string[] fields=string_split(detail,"|",false);nv_form f;f.create_window("Secure Banking",false,true);f.add_input("Account summary","summary",fields.length()>=4?"Account "+fields[0]+". Checking "+fields[1]+" credits. Savings "+fields[2]+". Credit debt "+fields[3]+"."+(fields.length()>4 and fields[4]!=""?" Cards: "+fields[4]+".":""):detail,"",0,true,true);nv_form_button@ deposit=f.add_button("Deposit wallet credits into checking","deposit",true);nv_form_button@ withdraw=f.add_button("Withdraw checking credits to wallet","withdraw");nv_form_button@ debit=f.add_button("Issue a debit card","debit");nv_form_button@ credit=f.add_button("Issue a credit card","credit");nv_form_button@ prepaid=f.add_button("Issue a prepaid card","prepaid");nv_form_button@ virtual_card=f.add_button("Issue a virtual card","virtual");nv_form_button@ close=f.add_button("Close banking","close",false,true);f.focus_control(deposit);while(true){wait(5);f.monitor();if(connected)netloop(false);if(f.is_pressed(close))return;string command="";if(f.is_pressed(deposit))command="bank_deposit "+pin+" "+af_input("Deposit amount","",true);else if(f.is_pressed(withdraw))command="bank_withdraw "+pin+" "+af_input("Withdrawal amount","",true);else if(f.is_pressed(debit))command="bank_card "+pin+" debit";else if(f.is_pressed(credit))command="bank_card "+pin+" credit";else if(f.is_pressed(prepaid))command="bank_card "+pin+" prepaid";else if(f.is_pressed(virtual_card))command="bank_card "+pin+" virtual";if(command!=""){string reply=terminal_request(command,"bank_",3500);speak(string_replace(string_replace(reply,"bank_ok ","",false),"bank_error ","",false));status=terminal_request("bank_status "+pin,"bank_",3500);break;}}}
}
void smart_terminal_app_store()
{
string response=terminal_request("terminal_catalog","terminal_catalog ",3500);if(response=="")return;string[] entries=string_split(string_replace(response,"terminal_catalog ","",false),";",true);nv_form f;f.create_window("HyperComp App Store",false,true);nv_form_list_box@ list=f.add_list("Applications","apps");for(uint i=0;i<entries.length();i++){string[] a=string_split(entries[i],"~",false);if(a.length()<7)continue;list.add(string_replace(a[1],"_"," ",true)+"; "+a[2]+" GB; "+a[3]+" credits; systems "+string_replace(a[4],",",", ",true)+". "+string_replace(a[5],"_"," ",true)+(a[6]=="1"?" Installed.":""),a[0]);}nv_form_button@ install=f.add_button("Install selected application","install",true);nv_form_button@ remove=f.add_button("Uninstall selected application","remove");nv_form_button@ close=f.add_button("Close app store","close",false,true);f.focus_control(list);while(true){wait(5);f.monitor();if(connected)netloop(false);if(f.is_pressed(close))return;if(@list.focused_item==null)continue;string reply="";if(f.is_pressed(install))reply=terminal_request("terminal_install "+list.focused_item.id,"terminal_",3500);else if(f.is_pressed(remove))reply=terminal_request("terminal_uninstall "+list.focused_item.id,"terminal_",3500);if(reply!=""){speak(string_replace(string_replace(reply,"terminal_ok ","",false),"terminal_error ","",false));return;}}
}
void smart_terminal_launcher()
{
string response=terminal_request("terminal_catalog","terminal_catalog ",3500);if(response=="")return;string[] entries=string_split(string_replace(response,"terminal_catalog ","",false),";",true);nv_form f;f.create_window("Installed terminal applications",false,true);nv_form_list_box@ list=f.add_list("Applications","installed_apps");for(uint i=0;i<entries.length();i++){string[] a=string_split(entries[i],"~",false);if(a.length()>=7 and a[6]=="1")list.add(string_replace(a[1],"_"," ",true)+": "+string_replace(a[5],"_"," ",true),a[0]);}nv_form_button@ launch=f.add_button("Launch selected application","launch",true);nv_form_button@ close=f.add_button("Close launcher","close",false,true);f.focus_control(list);while(true){wait(5);f.monitor();if(connected)netloop(false);if(f.is_pressed(close))return;if(f.is_pressed(launch) and @list.focused_item!=null){string app=list.focused_item.id;if(app=="market")online_supply_shop();else if(app=="bank")terminal_bank_menu();else if(app=="bunkers")hypercomp_legacy_menu();else if(app=="appstore")smart_terminal_app_store();else{string result=terminal_request("terminal_run "+app,"terminal_output ",3500);speak(string_replace(result,"terminal_output ","",false));}return;}}
}
void smart_terminal_menu()
{
if(get_item_count("hypercomp")<=0){speak("You need a HyperComp Smart Terminal to use terminal applications.");return;}send_reliable(0,"use hypercomp 1",0);string response=terminal_request("terminal_state","terminal_state ",3500);if(response=="")return;
while(true)
{
string[] state=string_split(string_replace(response,"terminal_state ","",false),"|",false);string os=state.length()>0?state[0]:"frontier_os",capacity=state.length()>1?state[1]:"64",used=state.length()>2?state[2]:"28";nv_form f;f.create_window("HyperComp Smart Terminal",false,true);f.add_input("System status","status",string_replace(os,"_"," ",true)+". Storage "+used+" of "+capacity+" GB used. Installed applications are erased when this terminal is lost on death.","",0,true,true);nv_form_button@ launch=f.add_button("Applications: Open installed terminal software","launch",true);nv_form_button@ market=f.add_button("Marketplace: Spend credits on field supplies","market");nv_form_button@ apps=f.add_button("App Store: Buy and install compatible software","apps");nv_form_button@ bank=f.add_button("Secure Banking: Manage accounts, balances and cards","bank");nv_form_button@ bunker=f.add_button("Bunker Control: Sensors, alarms and demolition","bunker");nv_form_button@ os_button=f.add_button("Operating Systems: Replace the terminal OS","os");nv_form_button@ close=f.add_button("Shut down terminal","close",false,true);f.focus_control(launch);
while(true){wait(5);f.monitor();if(connected)netloop(false);if(f.is_pressed(close))return;if(f.is_pressed(launch)){smart_terminal_launcher();break;}if(f.is_pressed(market)){online_supply_shop();break;}if(f.is_pressed(apps)){smart_terminal_app_store();break;}if(f.is_pressed(bank)){terminal_bank_menu();break;}if(f.is_pressed(bunker)){hypercomp_legacy_menu();break;}if(f.is_pressed(os_button)){string[] choices={"Frontier OS: broad field compatibility","Aegis OS: security and combat applications","OpenWave: communications and civilian software","Minimal Recovery: core applications only"};int choice=android_select("Install operating system",choices);if(choice>=0){string[] ids={"frontier_os","aegis_os","openwave","minimal_recovery"};string reply=terminal_request("terminal_os "+ids[choice],"terminal_",3500);speak(string_replace(string_replace(reply,"terminal_ok ","",false),"terminal_error ","",false));}break;}}
response=terminal_request("terminal_state","terminal_state ",3500);if(response=="")return;
}
}
