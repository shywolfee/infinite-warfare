sd.add("notification_volume",notification_volume);
sd.add("world_volume",world_volume);
sd.add("keymap_profile",kb_active_profile);
sd.add("voice_enabled",voice_enabled?1:0);
sd.add("voice_toggle_mode",voice_toggle_mode?1:0);
sd.add("voice_input_device",voice_input_device);
sd.add("voice_output_device",voice_output_device);
sd.add("voice_quality",voice_quality);
sd.add("voice_input_test_playback",voice_input_test_playback?1:0);
sd.add("voice_hear_self",voice_hear_self?1:0);
sd.add("auto_bind_starting_loadout",auto_bind_starting_loadout?1:0);
sd.add("replace_occupied_attachments",replace_occupied_attachments?1:0);
