class terminal_app_def{string id,name,systems,feature;int size,price;terminal_app_def(string i,string n,int s,int p,string o,string f){id=i;name=n;size=s;price=p;systems=o;feature=f;}}
terminal_app_def@[] terminal_apps_catalogue;
void init_terminal_apps()
{
if(terminal_apps_catalogue.length()>0)return;
string[] rows={
"market|Marketplace|6|0|all|Buy field supplies from the complete item catalogue","bank|Secure Banking|12|35|frontier_os,aegis_os,openwave|Create and manage bank accounts and cards","bunkers|Bunker Control|8|0|all|Monitor owned bunkers, alarms and sensors","c4|Demolition Console|5|0|frontier_os,aegis_os|Manage placed C4 charges","maps|Tactical Maps|10|18|all|Read coordinates, zones and authored landmarks","scanner|Signal Scanner|9|22|frontier_os,openwave|Survey nearby players and electronic signals","medical|Field Medical|7|20|all|Review health and active treatment effects","armoury|Armoury Ledger|11|25|frontier_os,aegis_os|Inspect weapons, ammunition and maintenance","team|TeamLink|8|15|all|Review team membership and resources","groups|GroupWire|7|12|all|Open persistent social groups","companions|Companion Control|14|30|frontier_os,aegis_os|Command deployed drones and chimps","weather|Atmospherics|5|8|all|Read local environmental conditions","notes|Encrypted Notes|4|5|all|Keep temporary session notes","calculator|Ballistics Calculator|3|4|all|Calculate range and trajectory references","translator|Universal Translator|18|28|openwave,frontier_os|Reference language-channel routing","radio|Spectrum Radio|8|16|all|Inspect voice and radio status","camera|Recon Camera|16|32|aegis_os,frontier_os|Operate compatible security cameras","diagnostics|System Diagnostics|6|10|all|Report storage, OS and network state","files|File Manager|4|0|all|Manage installed applications and storage","appstore|App Store|5|0|all|Purchase and install compatible applications","wallet|Credit Wallet|4|0|all|Read carried and saved credits","marketwatch|Market Watch|7|14|openwave,frontier_os|Compare supply categories and prices","repair|Repair Assistant|9|18|frontier_os|Explain maintenance components and procedures","vehicles|Vehicle Workshop|13|26|frontier_os,aegis_os|Inspect nearby vehicle service requirements","survival|Survival Guide|6|9|all|Read field survival references","news|Staff News|5|0|all|Read current staff announcements","messenger|Secure Messenger|10|12|all|Open conversations and private messages","tracker|Motion Tracker|15|35|aegis_os,frontier_os|Report nearby movement contacts","developer|Developer Console|20|100|aegis_os|Expose authorized diagnostics","games|Terminal Arcade|24|20|openwave|Run lightweight recreational software"};
for(uint i=0;i<rows.length();i++){string[] f=string_split(rows[i],"|",false);terminal_apps_catalogue.insert_last(terminal_app_def(f[0],f[1],string_to_number(f[2]),string_to_number(f[3]),f[4],f[5]));}
}
int terminal_app_index(string id){init_terminal_apps();for(uint i=0;i<terminal_apps_catalogue.length();i++)if(terminal_apps_catalogue[i].id==id)return int(i);return -1;}
bool terminal_has_app(player@ p,string id){if(id=="market" or id=="bunkers" or id=="files" or id=="appstore" or id=="wallet")return true;return p.terminal_apps.find(id)>=0;}
int terminal_used(player@ p){int used=28;for(uint i=0;i<p.terminal_apps.length();i++){int a=terminal_app_index(p.terminal_apps[i]);if(a>=0)used+=terminal_apps_catalogue[a].size;}return used;}
bool terminal_os_supports(string os,string systems){return systems=="all" or string_contains(","+systems+",",","+os+",",1)>=0;}
string terminal_catalogue_packet(player@ p){init_terminal_apps();string packet="terminal_catalog ";for(uint i=0;i<terminal_apps_catalogue.length();i++){terminal_app_def@ a=terminal_apps_catalogue[i];if(i>0)packet+=";";packet+=a.id+"~"+string_replace(a.name," ","_",true)+"~"+a.size+"~"+a.price+"~"+a.systems+"~"+string_replace(a.feature," ","_",true)+"~"+(terminal_has_app(p,a.id)?"1":"0");}return packet;}
string bank_path(string name){return "accounts/"+string_to_lower_case(name)+".bank";}
string bank_number(){string n="77";for(int i=0;i<10;i++)n+=random(0,9);return n;}
void terminal_handle(uint peer,string raw,const string[] &in parsed)
{
int i=get_player_index(peer);if(i<0)return;player@ p=players[i];if(!p.has_hypercomp){send_reliable(peer,"terminal_error You need a HyperComp Smart Terminal.",0);return;}init_terminal_apps();string cmd=parsed[0];
if(cmd=="terminal_state"){send_reliable(peer,"terminal_state "+p.terminal_os+"|"+p.terminal_storage+"|"+terminal_used(p)+"|"+join(p.terminal_apps,","),0);return;}
if(cmd=="terminal_catalog"){send_reliable(peer,terminal_catalogue_packet(p),0);return;}
if(cmd=="terminal_run" and parsed.length()>1){int ai=terminal_app_index(parsed[1]);if(ai<0 or !terminal_has_app(p,parsed[1])){send_reliable(peer,"terminal_error That application is not installed.",0);return;}string report=terminal_apps_catalogue[ai].feature+". ";string app=parsed[1];if(app=="maps")report+="Current position "+p.x+", "+p.y+", "+p.z+" on "+map_display_title(p.map)+", zone "+p.zone+".";else if(app=="medical")report+="Health "+p.health+" of 1000, "+(p.bleeding?"bleeding active":"no active bleeding")+", toxicity "+p.medication_toxicity+".";else if(app=="armoury")report+="Current weapon "+p.current_weapon+"; equipped armour mass "+p.equipped_armor_weight+".";else if(app=="diagnostics")report+="OS "+p.terminal_os+", storage "+terminal_used(p)+" of "+p.terminal_storage+" GB, network connected.";else if(app=="wallet")report+="Saved wallet balance "+p.credits+" credits.";else if(app=="scanner" or app=="tracker"){int contacts=0;for(uint q=0;q<players.length();q++)if(players[q].map==p.map and players[q].name!=p.name and !players[q].death and get_3d_distance(p.x,p.y,p.z,players[q].x,players[q].y,players[q].z)<=40)contacts++;report+="Detected "+contacts+" nearby movement contact"+(contacts==1?".":"s.");}else report+="Application service is ready for this terminal session.";send_reliable(peer,"terminal_output "+report,0);return;}
if(cmd=="terminal_os" and parsed.length()>1){string os=parsed[1];if(os!="frontier_os" and os!="aegis_os" and os!="openwave" and os!="minimal_recovery"){send_reliable(peer,"terminal_error Unknown operating system.",0);return;}p.terminal_os=os;for(int a=int(p.terminal_apps.length())-1;a>=0;a--){int ai=terminal_app_index(p.terminal_apps[a]);if(ai>=0 and !terminal_os_supports(os,terminal_apps_catalogue[ai].systems))p.terminal_apps.remove_at(a);}send_reliable(peer,"terminal_ok Operating system installed. Incompatible applications were removed.",0);return;}
if(cmd=="terminal_install" and parsed.length()>1){int ai=terminal_app_index(parsed[1]);if(ai<0){send_reliable(peer,"terminal_error Application not found.",0);return;}terminal_app_def@ a=terminal_apps_catalogue[ai];if(terminal_has_app(p,a.id)){send_reliable(peer,"terminal_error That application is already installed.",0);return;}if(!terminal_os_supports(p.terminal_os,a.systems)){send_reliable(peer,"terminal_error That application is incompatible with the installed operating system.",0);return;}if(terminal_used(p)+a.size>p.terminal_storage){send_reliable(peer,"terminal_error Not enough terminal storage.",0);return;}if(!change_player_credits(p,-a.price)){send_reliable(peer,"terminal_error Payment failed.",0);return;}p.terminal_apps.insert_last(a.id);send_reliable(peer,"terminal_ok Installed "+a.name+". Balance "+p.credits+" credits.",0);return;}
if(cmd=="terminal_uninstall" and parsed.length()>1){int at=p.terminal_apps.find(parsed[1]);if(at<0)send_reliable(peer,"terminal_error That application is not installed.",0);else{p.terminal_apps.remove_at(at);send_reliable(peer,"terminal_ok Application removed.",0);}return;}
if(string_contains(cmd,"bank_",1)==0){if(!terminal_has_app(p,"bank")){send_reliable(peer,"terminal_error Install Secure Banking first.",0);return;}savedata bank(bank_path(p.name),ACCOUNT_SECRET+"_bank");bank.load();
if(cmd=="bank_exists"){send_reliable(peer,"bank_status "+(bank.d.exists("number")?"exists":"none"),0);return;}
if(cmd=="bank_create"){if(bank.d.exists("number")){send_reliable(peer,"bank_error You already have a bank account.",0);return;}if(parsed.length()<2 or parsed[1].length()<4){send_reliable(peer,"bank_error Choose a PIN of at least four characters.",0);return;}bank.add("number",bank_number());bank.add("pin",string_encrypt(parsed[1],ACCOUNT_SECRET+"_pin"));bank.add("checking",double(0));bank.add("savings",double(0));bank.add("debt",double(0));bank.add("cards","");bank.save();send_reliable(peer,"bank_ok Account created. Account number "+bank.read("number")+".",0);return;}
if(!bank.d.exists("number")){send_reliable(peer,"bank_error Create a bank account first.",0);return;}if(parsed.length()<2 or bank.read("pin")!=string_encrypt(parsed[1],ACCOUNT_SECRET+"_pin")){send_reliable(peer,"bank_error Incorrect PIN.",0);return;}
if(cmd=="bank_status"){send_reliable(peer,"bank_status "+bank.read("number")+"|"+int(bank.readn("checking"))+"|"+int(bank.readn("savings"))+"|"+int(bank.readn("debt"))+"|"+bank.read("cards"),0);return;}
if((cmd=="bank_deposit" or cmd=="bank_withdraw") and parsed.length()>2){int amount=string_to_number(parsed[2]);if(amount<=0){send_reliable(peer,"bank_error Enter a positive amount.",0);return;}int checking=bank.readn("checking");if(cmd=="bank_deposit"){if(p.credits<amount or !change_player_credits(p,-amount)){send_reliable(peer,"bank_error Insufficient wallet credits.",0);return;}checking+=amount;}else{if(checking<amount){send_reliable(peer,"bank_error Insufficient checking balance.",0);return;}checking-=amount;if(!change_player_credits(p,amount)){send_reliable(peer,"bank_error Wallet update failed.",0);return;}}bank.add("checking",double(checking));bank.save();send_reliable(peer,"bank_ok Transaction complete. Checking "+checking+", wallet "+p.credits+".",0);return;}
if(cmd=="bank_card" and parsed.length()>2){string type=parsed[2];string cards=bank.read("cards");if(cards!="")cards+=",";cards+=type+"-"+random(1000,9999);bank.add("cards",cards);bank.save();send_reliable(peer,"bank_ok Issued "+string_replace(type,"_"," ",true)+" card.",0);return;}
}
}
