// Runs the real client functions without opening a game session or changing settings.
#include "acoustic_regression.nvgt"
string client_test_results;int client_test_failures=0;
string client_test_directory;
void client_checkpoint(string stage){file report;report.open(client_test_directory+"/results.txt","wb");report.write(client_test_results+"Stage: "+stage+"\n");report.close();}
void client_check(bool value,string label){client_test_results+=(value?"PASS ":"FAIL ")+label+"\n";if(!value)client_test_failures++;}
void run_client_regression()
{
#if IW_ACOUSTIC_REGRESSION
run_acoustic_regression();return;
#endif
client_test_directory=DIRECTORY_LOCAL_APPDATA+"/Temp/IW-client-regression-"+random(100000,999999999);directory_create(client_test_directory);client_checkpoint("building inventory");
inv.delete_all();inventory_order.resize(0);partial_items.resize(0);invalidate_inventory_keys();inv_category_index=0;
for(int i=0;i<10000;i++){string id="test_item"+i;content_register(id,"Test item "+i,"Utility","Regression fixture",1);give(id,1);}
client_check(get_filtered_keys().length()==10000,"ten-thousand-item inventory index");
client_checkpoint("selection timing");
invpos=5000;string chosen=get_selected_item();timer performance;
for(int i=0;i<1000;i++){string selection=get_selected_item();}
client_test_results+="1000 cached selections, 10000 items: "+performance.elapsed+" ms\n";client_checkpoint("label timing");
performance.restart();for(int i=0;i<1000;i++){string label=inv_menu_label(get_filtered_keys(),5000);}
client_test_results+="1000 spoken-label constructions, 10000 items: "+performance.elapsed+" ms\n";client_checkpoint("mutation and acoustic checks");
client_check(inventory_reorder(chosen,-100000) and get_filtered_keys()[0]==chosen,"reorder invalidates cached presentation");
give(chosen,-1);client_check(get_filtered_keys().length()==9999 and get_filtered_keys().find(chosen)<0,"removing an entry invalidates cache");
give("test_item0",2);client_check(get_item_count("test_item0")==3,"live quantities survive caching");
inv_category_index=inv_categories.find("Ammo");client_check(get_filtered_keys().length()==0,"empty category does not reuse All cache");
partial_items.insert_last(partial_ammo_item("test_magazine",3,10));client_check(get_filtered_keys().length()==1 and get_filtered_keys()[0]=="__partial__0","partial-container additions invalidate cache");
partial_items.resize(0);client_check(get_filtered_keys().length()==0,"partial-container removal invalidates cache");
inv.delete_all();invalidate_inventory_keys();inv_category_index=0;client_check(get_filtered_keys().length()==0,"session reset clears selection cache");
client_check(!acoustic_local_world_source("menumove.ogg") and !acoustic_local_world_source("chat.ogg") and acoustic_local_world_source("grass3step1.ogg"),"dry interface versus physical local movement");
register_gun("test_weapon","test","magazine",10,"test_standard","magazines",true,2,1000);
string[] supported={"test_weapon"};register_ammunition_load("test_load","Test alternative","test_alt","Test","",supported,2);
client_check(is_ammo_reserve_item("test_standard") and is_ammo_reserve_item("test_alt"),"base and alternative ammunition share classification");
client_checkpoint("awareness and screens");
client_check(clock_direction(0)=="straight ahead" and clock_direction(90)=="to your right" and clock_direction(180)=="behind you" and clock_direction(270)=="to your left" and clock_direction(60)=="at 2 o'clock" and clock_direction(-30)=="at 11 o'clock" and clock_direction(359)=="straight ahead","clock-face bearings");
me.x=100;me.y=100;me.z=10;facing=0;
client_check(describe_offset(100,110,10)=="10 tiles straight ahead","offset straight ahead");
client_check(describe_offset(110,100,16)=="10 tiles to your right, 6 above","offset to the right and above");
client_check(describe_offset(100,100,7)=="straight down, 3 below","offset directly below");
changelog_release@[] rel=parse_changelog("New in 2.0, build 9 (x)\r\nFirst.\n\nSecond.\nNew in 1.0, build 1 (y)\nOld.");
client_check(rel.length()==2 and rel[0].heading=="2.0, build 9 (x)" and rel[0].entries.length()==2 and rel[1].entries[0]=="Old.","changelog splits by release");
client_check(html_to_text("<style>p{x:1}</style><h1>Title</h1><p>A &amp; B</p>")=="Title\n\nA & B","manual text skips styles and decodes entities");
team_state_members="Ana (owner), Bo Ren (manager), Cy (member)";string[] tn,tr;team_member_list(tn,tr);
client_check(tn.length()==3 and tn[1]=="Bo Ren" and tr[1]=="manager" and tr[0]=="owner","team members parse with spaces in names");
client_checkpoint("item data");
int loaded=load_item_catalogue(SCRIPT_MAIN_PATH+"/../../iwserver/content/items");
client_check(loaded>=200,"item files load ("+loaded+")");
client_check(armour_slot("carrier_missile")=="" and item_is_launched_explosive("carrier_missile"),"carrier missile is a launched explosive and not armour");
client_check(armour_slot("plate_carrier")=="torso" and armour_rating("plate_carrier")==40 and armour_durability("plate_carrier")==1250,"plate carrier stats come from its file");
client_check(armour_slot("bomb_vest")=="","bomb vest is body equipment, not torso armour");
client_check(patch_repairs("aramid_repair_tape","tactical_greaves") and !patch_repairs("aramid_repair_tape","heavy_plate_carrier"),"patches repair what they list");
string[] visible={"Ammo","Armour","Armour Repair","Containers","Electronics","Equipment","Explosives","Healing","Team","Tools","Utility","Vehicle Supplies"};bool categories_ok=true;
for(uint i=0;i<item_catalogue.length();i++)if(visible.find(item_catalogue[i].category)<0){categories_ok=false;client_test_results+="  unknown category "+item_catalogue[i].category+" for "+item_catalogue[i].id+"\n";}
client_check(categories_ok,"every item file names a known category");
vehicle_type@[] saved_vehicle_types=vehicle_types;load_vehicle_content_blob("test_scout\x1fname=Test Scout\nhealth=777\narmour=55\nseats=2\nwindows=true,false\ntop_speed=12.5\nacceleration=3.5\nbraking=6\nfuel_type=diesel\nfuel_capacity=88\nfuel_per_tile=0.2");
client_check(vehicle_types.length()==1 and vehicle_types[0].name=="Test Scout" and vehicle_types[0].max_health==777 and vehicle_types[0].seat_has_window[0] and !vehicle_types[0].seat_has_window[1] and vehicle_types[0].fuel_capacity==88,"vehicle gameplay values load from synchronized content");vehicle_types=saved_vehicle_types;
client_check(kb_action_category("move_forward")=="Movement and aiming" and kb_action_category("voice_room")=="Communication" and kb_action_category("packet_viewer")=="Developer and testing","keybind manager categories cover gameplay, communication and tooling");
int moving_zone=dynamic_map_create("vehicle","Regression Rover",999,100,100,0,0);dynamic_map_elements[moving_zone].add_tile(2,4,-1,1,0,2,"","in front of the hood",false);client_check(get_dynamic_or_static_zone_at(100,103,1)=="Regression Rover, in front of the hood","vehicle sub-zone resolves in local moving coordinates");dynamic_map_move(moving_zone,200,200,0,90);client_check(get_dynamic_or_static_zone_at(203,200,1)=="Regression Rover, in front of the hood","vehicle sub-zone translates and rotates with its owner");dynamic_map_destroy(moving_zone);
client_checkpoint("item stats");
{
string[] med=item_stats_lines("trauma_repair_serum_bottle"),boom=item_stats_lines("carrier_missile"),plate=item_stats_lines("plate_carrier"),tape=item_stats_lines("aramid_repair_tape"),pill=item_stats_lines("loose_pain_blocker_capsule");
string all=join(med," / ")+" | "+join(boom," / ")+" | "+join(plate," / ")+" | "+join(tape," / ")+" | "+join(pill," / ");
client_test_results+="  sample: "+all+"\n";
client_check(join(med," ").find("heals 210 at once and 90 more over 8 seconds")>=0,"medication stats come from the item file");
client_check(join(boom," ").find("Launched. Blast radius 20 tiles, 720 damage")>=0,"explosive stats come from the item file");
client_check(item_is_thrown_explosive("frag_grenade") and !item_is_thrown_explosive("carrier_missile") and explosive_fuse_ms("frag_grenade")==2200,"thrown explosives and fuses come from the item files");
client_check(item_is_pill_bottle("regenex_tablet_bottle") and item_is_loose_pill("loose_regenex_tablet") and medication_pill_dose("pain_blocker_capsule_bottle",1)==2,"medication forms and doses come from the item files");
}
client_check(gesture_signature_words("top:2:double_hold")=="Two finger double tap and hold" and gesture_signature_words("middle:1:swipe:left")=="One finger swipe left","gesture reference wording");
client_check(gesture_signature_rank("top:1:tap")<gesture_signature_rank("top:1:hold") and gesture_signature_rank("top:1:hold")<gesture_signature_rank("top:1:swipe:up") and gesture_signature_rank("top:1:swipe:up")<gesture_signature_rank("top:2:tap"),"gesture reference ordering");
client_checkpoint("keyboard practice");
// The regression entry point deliberately runs before normal client startup,
// including kb_init. Seed only the catalogue entries this test needs, then
// restore every array; never load or change the player's AppData keymaps.
uint old_key_names=_kb_key_names.length(),old_key_codes=_kb_key_codes.length(),old_key_labels=_kb_key_labels.length();
uint old_action_names=_kb_act_names.length(),old_action_labels=_kb_act_labels.length(),old_action_defaults=_kb_act_defaults.length(),old_action_binds=_kb_act_binds.length(),old_action_modifiers=_kb_act_modifiers.length();
_kb_reg_key("print_screen",KEY_PRINTSCREEN,"Print Screen");_kb_reg_key("applications",KEY_APPS,"Applications");_kb_reg_key("numpad_enter",KEY_NUMPAD_ENTER,"Numpad Enter");_kb_reg_key("b",KEY_B,"B");_kb_reg_key("f1",KEY_F1,"F1");
_kb_reg_action("buffer_manager","Open buffer manager",KEY_B,KEYMOD_ALT|KEYMOD_SHIFT);_kb_reg_action("key_practice","Open key practice",KEY_F1,KEYMOD_SHIFT);
client_check(kb_practice_description(KEY_A,KEYMOD_SHIFT).find("fire mode")>=0 and kb_practice_description(KEY_R,KEYMOD_ALT).find("ammunition type")>=0,"practice describes modifier-dependent weapon controls");
client_check(kb_key_label(KEY_PRINTSCREEN)=="Print Screen" and kb_key_label(KEY_APPS)=="Applications" and kb_key_label(KEY_NUMPAD_ENTER)=="Numpad Enter","practice names formerly missing keys");
client_check(kb_practice_description(kb("buffer_manager"),KEYMOD_ALT|KEYMOD_SHIFT).find("Open buffer manager")>=0,"practice follows the active rebindable chord");
int[] practice_keys=kb_practice_keys();client_check(practice_keys.find(KEY_PRINTSCREEN)>=0 and practice_keys.find(KEY_APPS)>=0 and practice_keys.find(kb("key_practice"))>=0,"practice scans named and currently bound keys");
_kb_key_names.resize(old_key_names);_kb_key_codes.resize(old_key_codes);_kb_key_labels.resize(old_key_labels);_kb_act_names.resize(old_action_names);_kb_act_labels.resize(old_action_labels);_kb_act_defaults.resize(old_action_defaults);_kb_act_binds.resize(old_action_binds);_kb_act_modifiers.resize(old_action_modifiers);
client_checkpoint("visual presentation");
client_check(visual_icon_for("checkbox")=="CHECK" and visual_icon_for("text input")=="TEXT" and visual_icon_for("list box")=="LIST","visual controls receive distinct icons");
int projected_x,projected_y;visual_project(12,18,10,20,5,100,200,400,300,projected_x,projected_y);
client_check(projected_x==310 and projected_y==360,"top-down projection preserves map direction and scale");
visual_form_frame visual_test;visual_test.title="Options";visual_test.tabs={"Accessibility","Audio"};visual_test.selected_tab=0;visual_test.rows.insert_last(visual_ui_row("Visual subtitles","On","checkbox",true,true));
client_check(visual_test.rows.length()==1 and visual_test.rows[0].focused and visual_test.tabs[visual_test.selected_tab]=="Accessibility","visual form snapshots retain tabs, focus and values");
client_checkpoint("world editor builders");
{
// Every builder, run with its defaults on a blank 300 by 300 map, one place
// apart, written out as a map for the line validator and the Python raster
// validator (tools/tests/world_editor_regression.py) to check.
we_surface_names.resize(0);we_surface_families.resize(0);we_ambience_names.resize(0);we_ambience_files.resize(0);
we_editor_dir_override=SCRIPT_MAIN_PATH+"/../../iwserver/content/editor";
we_load_palette();
client_check(we_surface_names.length()>100 and we_ambience_names.length()>50,"the editor palette loads ("+we_surface_names.length()+" surfaces, "+we_ambience_names.length()+" ambience beds)");
string[] header={"mapname:editor_test","title:Editor Test","maxx:300","maxy:300","maxz:80","listed:false","fixtures:authored","surface:grass:grass","tile:0:300:0:300:0:0:grass","zone:0:300:0:300:0:8:Editor Test","openspace:0:300:0:300:0:8:Editor Test:grass:open","spawn:150:150:0"};
we_lines=header;we_map_maxx=300;we_map_maxy=300;we_map_maxz=80;
we_selection_set=false;
string[] all=header;
string[] builders={"street","building","district","square","park","water","stairs","ramp","ladder","bridge","wall","fence","doorway","zone","spawns"};
int[] xs={20,70,150,20,70,20,110,130,150,170,200,220,240,260,280};
int[] ys={20,20,140,120,120,200,262,262,262,262,262,262,262,262,262};
int failures_before=client_test_failures;
for(uint i=0;i<builders.length();i++)
{
string id=builders[i];
me.x=xs[i];me.y=ys[i];me.z=0;mr.x=me.x;mr.y=me.y;facing=0;
we_params@ p;we_builder_fn@ fn;
if(id=="street"){@p=we_street_params();@fn=build_street;p.set("name","Test Street");}
else if(id=="building"){@p=we_building_params();@fn=build_building;p.set("name","Test House");p.set("floors","3");}
else if(id=="district"){@p=we_district_params();@fn=build_district;p.set("name","Test District");p.set("length","100");p.set("width","100");p.set("max_floors","2");}
else if(id=="square"){@p=we_area_params("paving slabs","square","city day");@fn=build_area;p.set("name","Test Square");}
else if(id=="park"){@p=we_area_params("grass","open","park");@fn=build_area;p.set("name","Test Park");}
else if(id=="water"){@p=we_water_params();@fn=build_water;p.set("name","Test Pond");}
else if(id=="stairs"){@p=we_stairs_params("concrete stairs");@fn=build_stairs;p.set("name","Test Stairs");}
else if(id=="ramp"){@p=we_stairs_params("ramp surface");@fn=build_stairs;p.set("name","Test Ramp");}
else if(id=="ladder"){@p=we_ladder_params();@fn=build_ladder;p.set("name","Test Ladder");}
else if(id=="bridge"){@p=we_bridge_params();@fn=build_bridge;p.set("name","Test Bridge");}
else if(id=="wall"){@p=we_wall_params("brick wall");@fn=build_wall;}
else if(id=="fence"){@p=we_wall_params("chainlink wall");@fn=build_wall;}
else if(id=="doorway"){@p=we_doorway_params();@fn=build_doorway;p.set("name","Test Doorway");}
else if(id=="zone"){@p=we_zone_params();@fn=build_zone_only;p.set("name","Test Zone");}
else{@p=we_spawn_params();@fn=build_spawns;}
we_batch b;fn(p,b);
client_check(b.lines.length()>0,"builder "+id+" produces lines ("+b.lines.length()+")");
for(uint l=0;l<b.lines.length();l++){all.insert_last(b.lines[l]);if(b.lines[l].substr(0,8)=="surface:")we_lines.insert_last(b.lines[l]);}
// A spawn beside each thing, so the raster validator checks it is all
// reachable from everywhere else.
all.insert_last("spawn:"+xs[i]+":"+(ys[i]-(id=="bridge"?12:2))+":0");
// And where each thing should take you: every floor of the building, the
// top of the stairs, the bridge deck. The raster validator fails if any of
// these cannot be walked to from the ground.
if(id=="building"){all.insert_last("spawn:72:30:4");all.insert_last("spawn:72:30:8");}
if(id=="stairs")all.insert_last("spawn:110:269:4");
if(id=="bridge")all.insert_last("spawn:170:280:6");
}
// The describe parser should pick the builder and read the numbers.
{
string lower=" a three storey brick building 20 by 12 called harbour flats to my left ";
client_check(we_word_number("three")==3 and we_word_number("12")==12,"describe reads numbers in words and digits");
}
file map_out;
// Outside the game's maps folder, so the server never loads it as a map.
string dir=DIRECTORY_LOCAL_APPDATA+"/Temp/IW-editor-test";
directory_create(dir);
map_out.open(dir+"/editor_test.map","wb");map_out.write(join(all,"\n")+"\n");map_out.close();
client_test_results+="  wrote "+all.length()+" lines to "+dir+"/editor_test.map"+"\n";
}
client_checkpoint("dialogs while connected");
client_checkpoint("in-game form modes");
{
bool old_match=client_match_active,old_ready=game_dashboard_ready,old_mode=game_dashboard_tab_mode;
client_match_active=true;game_dashboard_ready=true;game_dashboard_tab_mode=true;
nv_form dashboard_test;dashboard_test.create_window("Dashboard mode test",false,false,true);dashboard_test.add_button("Action","action");game_dashboard_attach_shell(dashboard_test);
client_check(dashboard_test.get_control_by_id("__dash_keyboard") !is null and dashboard_test.get_control_by_id("__dash_conversations") !is null,"dashboard mode connects in-game NV Forms to the shared shell");
game_dashboard_tab_mode=false;nv_form inventory_mode_test;inventory_mode_test.create_window("Inventory mode test",false,false,true);nv_form_button@ ordinary=inventory_mode_test.add_button("Action","action");game_dashboard_attach_shell(inventory_mode_test);
client_check(inventory_mode_test.get_control_by_id("__dash_keyboard") is null,"inventory mode leaves in-game NV Forms standalone");
client_check(ordinary.autoactivate,"actionable NV Form shortcuts auto-activate");
client_match_active=old_match;game_dashboard_ready=old_ready;game_dashboard_tab_mode=old_mode;
}
// A dialog in the lobby while connected. The network pump and the helper
// service used to call each other forever here, hanging the game on entering
// the lobby; this returns only if they no longer do.
{
bool was_connected=connected,was_match=client_match_active;string was_map=mapname;
@default_nv_form_network_pump=@pump_network_for_form;
// A retained non-lobby map name must not switch a lobby form to the match
// parser. This is the exact state reached by opening the Armoury after a
// match.
connected=true;client_match_active=false;mapname="battlegrounds";last_server_msg.restart();lobby_keepalive_timer.restart();
nv_form lf;lf.create_window("Regression lobby",false,true);nv_form_list_box@ ll=lf.add_list("Entries","entries");ll.add("One","one");
timer lt;int frames=0;while(lt.elapsed<300){lf.monitor();frames++;wait(5);}
client_check(frames>10 and !pumping_network_for_form and form_net_depth==0,"dialogs keep running while connected in the lobby ("+frames+" frames)");
connected=was_connected;client_match_active=was_match;mapname=was_map;
}
client_test_results+="Failures: "+client_test_failures+"\n";
client_checkpoint("finished");
}
