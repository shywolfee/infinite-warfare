// Support ticket system for Infinite Warfare
// Tickets are stored on the server in iwserver/tickets/
// Each ticket is a file named <id>.dat containing encrypted ticket data.

// The support screens are one stack: the support list opens a ticket list,
// which opens a ticket, which opens a reply, and each returns to the one
// beneath it. They used to reopen each other from scratch -- the ticket
// screen's Back opened a new support menu, whose list opened a new ticket
// screen -- so every visit added a screen that never went away.

// Text typed into a form, made safe for the ticket protocol, which separates
// fields with | and ~ and cannot carry a line break.
string support_encode(string text)
{
text=string_replace(text,"|","/",true);
text=string_replace(text,"~","-",true);
text=string_replace(text,"\r","",true);
return string_replace(text,"\n","<<NL>>",true);
}
string support_decode(const string &in text){return string_replace(text,"<<NL>>","\n",true);}

// Support: opened with Alt+S. Staff also see every open ticket.
void support_menu()
{
send_reliable(0,"ticket_check_role",0);
bool is_staff=false;
string role_response;if(wait_for_service_response("ticket_role_",role_response,2000))is_staff=role_response=="ticket_role_staff";
while(true)
{
string[] labels={"Open a new ticket","Your open tickets","Your closed tickets"};
string[] ids={"new","open","closed"};
if(is_staff){labels.insert_last("Every open ticket (staff)");ids.insert_last("all");}
string chosen=pick_from_list("Support",labels,ids);
if(chosen=="")return;
if(chosen=="new")support_open_ticket();
else if(chosen=="open" or chosen=="closed")support_view_my_tickets(chosen);
else if(chosen=="all")support_view_all_tickets();
}
}

void support_open_ticket()
{
nv_form f;
f.create_window("Open a support ticket",false,true);
nv_form_input@ subject=f.add_input("Subject","subject");
nv_form_input@ body=f.add_input("What happened","body","","",0,false,true);
nv_form_button@ submit=f.add_button("Submit ticket","submit",true);
nv_form_button@ cancel=f.add_button("Cancel","cancel",false,true);
f.focus_control(subject);
while(true)
{
wait(5);
f.monitor();
if(connected==true) netloop();
if(f.is_pressed(cancel))return;
if(!f.is_pressed(submit))continue;
string subj=subject.text.trim_whitespace();
string text=body.text.trim_whitespace();
if(subj==""){speak("The ticket needs a subject.");f.focus_control(subject);continue;}
if(text==""){speak("Say what happened in the description.");f.focus_control(body);continue;}
subj=string_replace(support_encode(subj),"<<NL>>"," ",true);
subj=string_replace(subj,",",";",true);
send_reliable(0,"ticket_create "+name+"|"+subj+"|"+support_encode(text),0);
string result="";
if(wait_for_service_response("ticket_created",result,3000))
{
p.play_stationary("ticket_open.ogg",false);
dlg("Ticket "+string_replace(result,"ticket_created ","",false)+" is open, and staff have been told.");
}
else dlg("The server did not confirm the ticket, so it may not have been submitted. Try again in a moment.");
return;
}
}

// Ticket rows arrive as id~subject~status (or id~owner~subject~status for
// staff), separated by commas; the server turns commas in subjects into
// semicolons so the rows split cleanly.
void support_ticket_list(const string &in title,const string &in data,bool with_owner,bool is_staff)
{
string[] labels,ids;
if(data!="" and data!="none")
{
string[] entries=string_split(data,",",false);
for(uint i=0;i<entries.length();i++)
{
string[] parts=string_split(entries[i],"~",false);
if(with_owner)
{
if(parts.length()<4)continue;
labels.insert_last("Ticket "+parts[0]+" from "+parts[1]+": "+parts[2]+", "+parts[3]);
}
else
{
if(parts.length()<3)continue;
labels.insert_last("Ticket "+parts[0]+": "+parts[1]+", "+parts[2]);
}
ids.insert_last(parts[0]);
}
}
if(labels.length()==0){speak("There are no tickets to show.");return;}
while(true)
{
string id=pick_from_list(title+", "+labels.length()+(labels.length()==1?" ticket":" tickets"),labels,ids);
if(id=="")return;
support_view_ticket(id,is_staff);
}
}

void support_view_my_tickets(string filter)
{
speak("Loading your tickets.");
send_reliable(0,"ticket_list_my "+name+"|"+filter,0);
string response;
if(!wait_for_service_response("ticket_mylist ",response,3000)){speak("The server did not send your tickets.");return;}
support_ticket_list(filter=="open"?"Your open tickets":"Your closed tickets",string_replace(response,"ticket_mylist ","",false),false,false);
}

void support_view_all_tickets()
{
speak("Loading every open ticket.");
send_reliable(0,"ticket_list_all",0);
string response;
if(!wait_for_service_response("ticket_alllist ",response,3000)){speak("The server did not send the tickets.");return;}
support_ticket_list("Every open ticket",string_replace(response,"ticket_alllist ","",false),true,true);
}

// One ticket: its details and every reply as a list to arrow through, then
// what you can do with it. It was a column of read-only edit boxes.
void support_view_ticket(string ticket_id, bool is_staff)
{
while(true)
{
speak("Loading ticket "+ticket_id+".");
send_reliable(0,"ticket_get "+ticket_id,0);
string response;
if(!wait_for_service_response("ticket_data ",response,3000)){speak("The server did not send the ticket.");return;}
string data=string_replace(response,"ticket_data ","",false);
if(data=="" or data=="not_found"){dlg("That ticket no longer exists.");return;}
// Format: id~owner~subject~status~close_reason~body~reply1~reply2~...
string[] parts=string_split(data,"~",false);
if(parts.length()<6){dlg("The server sent a ticket the game could not read.");return;}
string t_status=parts[3];
bool is_owner=(string_to_lower_case(parts[1])==string_to_lower_case(name));
nv_form f;
f.create_window("Ticket "+parts[0]+": "+parts[2],false,true);
nv_form_list_box@ list=f.add_list("Ticket "+parts[0],"ticket");
list.add("Subject: "+parts[2],"subject");
list.add("From "+parts[1]+", "+t_status,"status");
if(parts[4]!="" and parts[4]!="none")list.add("Closed because: "+support_decode(parts[4]),"reason");
list.add("Description: "+support_decode(parts[5]),"body");
for(uint i=6;i<parts.length();i++)list.add("Reply "+(i-5)+", "+support_decode(parts[i]),"reply"+(i-5));
nv_form_button@ reply=null;
nv_form_button@ close_ticket=null;
if(t_status=="open")
{
@reply=f.add_button("Reply","reply");
if(is_owner or is_staff)@close_ticket=f.add_button("Close this ticket","close_ticket");
}
nv_form_button@ back=f.add_button("Back","back",false,true);
f.focus_control(list);
string action="";
while(action=="")
{
wait(5);
f.monitor();
if(connected==true) netloop();
if(f.is_pressed(back))return;
if(@reply!=null and f.is_pressed(reply))action="reply";
else if(@close_ticket!=null and f.is_pressed(close_ticket))action="close";
}
if(action=="reply")support_reply_ticket(ticket_id,is_staff);
else if(action=="close")
{
if(is_staff and !is_owner){if(support_close_ticket_staff(ticket_id,is_staff))return;}
else if(yesno("Close ticket "+ticket_id+"?")==1)
{
send_reliable(0,"ticket_close "+ticket_id+"|"+name+"|none",0);
string close_response;bool closed=wait_for_service_response("ticket_closed",close_response,3000);
if(closed){p.play_stationary("ticketclose.ogg",false);speak("Ticket closed.");return;}
dlg("The ticket was not closed. It may have changed, or you may no longer be allowed to close it.");
}
}
}
}

void support_reply_ticket(string ticket_id, bool is_staff)
{
nv_form f;
f.create_window("Reply to ticket "+ticket_id,false,true);
nv_form_input@ message=f.add_input("Your reply","reply","","",0,false,true);
nv_form_button@ send=f.add_button("Send reply","send",true);
nv_form_button@ cancel=f.add_button("Cancel","cancel",false,true);
f.focus_control(message);
while(true)
{
wait(5);
f.monitor();
if(connected==true) netloop();
if(f.is_pressed(cancel))return;
if(!f.is_pressed(send))continue;
string text=message.text.trim_whitespace();
if(text==""){speak("The reply is empty.");continue;}
send_reliable(0,"ticket_reply "+ticket_id+"|"+name+"|"+support_encode(text),0);
string reply_response;
if(wait_for_service_response("ticket_replied",reply_response,3000))speak("Reply sent.");
else dlg("The server did not accept the reply.");
return;
}
}

// Staff closing someone else's ticket must say why. True if it was closed.
bool support_close_ticket_staff(string ticket_id, bool is_staff)
{
nv_form f;
f.create_window("Close ticket "+ticket_id,false,true);
nv_form_input@ reason=f.add_input("Reason for closing, which the player will see","reason","","",0,false,true);
nv_form_button@ close_button=f.add_button("Close ticket","close",true);
nv_form_button@ cancel=f.add_button("Cancel","cancel",false,true);
f.focus_control(reason);
while(true)
{
wait(5);
f.monitor();
if(connected==true) netloop();
if(f.is_pressed(cancel))return false;
if(!f.is_pressed(close_button))continue;
string text=reason.text.trim_whitespace();
if(text==""){speak("Give a reason for closing the ticket.");continue;}
send_reliable(0,"ticket_close "+ticket_id+"|"+name+"|"+support_encode(text),0);
string staff_close_response;
if(wait_for_service_response("ticket_closed",staff_close_response,3000)){p.play_stationary("ticketclose.ogg",false);speak("Ticket closed.");return true;}
dlg("The ticket was not closed.");
return false;
}
return false;
}

// ---------------------------------------------------------------------------
// Admin panel ticket management — works without being logged into a character.
// Uses a dedicated network connection like the other admin panel features.
// ---------------------------------------------------------------------------
void admin_support_tickets(network@ an, string comp_id)
{
// Fetch all open tickets via the admin connection.
string msg_str="ticket_admin_list_all "+comp_id;
if(SCRIPT_COMPILED==false)
msg_str+=" dev";
string msg=string_encrypt(msg_str, "_';'_clickclick!");
an.send_reliable(0, msg, 0);
string data="";
timer wt;
while(wt.elapsed<3000)
{
wait(5);
network_event ev=an.request();
if(ev.type==event_receive)
{
string r=ev.message;
if(r!="") r=string_decrypt(r, "masonandsamare2bitches");
if(string_contains(r, "ticket_admin_alllist ", 1)==0)
{
data=string_replace(r, "ticket_admin_alllist ", "", false);
break;
}
}
}
iw_form f;
f.create_window("Support Tickets (Admin Panel)", false, true);
int f_list=f.create_list("Open Tickets", 0, false);
string[] ticket_ids;
if(data=="" or data=="none")
{
f.add_list_item(f_list, "No open tickets found.");
}
else
{
string[] entries=string_split(data, ",", false);
for(uint i=0; i<entries.length(); i++)
{
string[] parts=string_split(entries[i], "~", false);
if(parts.length()<4) continue;
ticket_ids.insert_last(parts[0]);
f.add_list_item(f_list, "#"+parts[0]+" by "+parts[1]+": "+parts[2]+" ["+parts[3]+"]");
}
}
int f_view=f.create_button("&View selected ticket");
int f_back=f.create_button("Go &back", false, true);
f.focus(f_list);
while(true)
{
wait(5);
f.monitor();
if(f.is_pressed(f_view))
{
int sel=f.get_list_position(f_list);
if(sel>=0 and sel<int(ticket_ids.length()))
{
admin_view_ticket(an, comp_id, ticket_ids[sel]);
return;
}
}
else if(f.is_pressed(f_back))
return;
}
}

// ---------------------------------------------------------------------------
// Admin panel — view a single ticket.
// ---------------------------------------------------------------------------
void admin_view_ticket(network@ an, string comp_id, string ticket_id)
{
string msg_str="ticket_admin_get "+comp_id+" "+ticket_id;
if(SCRIPT_COMPILED==false)
msg_str+=" dev";
string msg=string_encrypt(msg_str, "_';'_clickclick!");
an.send_reliable(0, msg, 0);
string data="";
timer wt;
while(wt.elapsed<3000)
{
wait(5);
network_event ev=an.request();
if(ev.type==event_receive)
{
string r=ev.message;
if(r!="") r=string_decrypt(r, "masonandsamare2bitches");
if(string_contains(r, "ticket_admin_data ", 1)==0)
{
data=string_replace(r, "ticket_admin_data ", "", false);
break;
}
}
}
if(data=="" or data=="not_found")
{
dlg("Ticket not found.");
return;
}
string[] parts=string_split(data, "~", false);
if(parts.length()<6) return;
string t_id=parts[0];
string t_owner=parts[1];
string t_subject=parts[2];
string t_status=parts[3];
string t_close_reason=parts[4];
string t_body=string_replace(parts[5], "<<NL>>", "\n", true);
iw_form f;
f.create_window("Ticket #"+t_id+": "+t_subject, false, true);
f.create_input_box("Ticket ID", t_id, "", 0, false, true, false);
f.create_input_box("Submitted by", t_owner, "", 0, false, true, false);
f.create_input_box("Status", t_status, "", 0, false, true, false);
if(t_close_reason!="" and t_close_reason!="none")
f.create_input_box("Close reason", string_replace(t_close_reason, "<<NL>>", "\n", true), "", 0, false, true, false);
f.create_input_box("Description", t_body, "", 0, false, true, true);
if(parts.length()>6)
{
for(uint i=6; i<parts.length(); i++)
{
string reply_text=string_replace(parts[i], "<<NL>>", "\n", true);
f.create_input_box("Reply "+(i-5), reply_text, "", 0, false, true, true);
}
}
int f_reply=f.create_button("&Reply to this ticket");
int f_closeticket=-1;
if(t_status=="open")
f_closeticket=f.create_button("&Close this ticket");
int f_back=f.create_button("Go &back", false, true);
f.focus(0);
while(true)
{
wait(5);
f.monitor();
if(f.is_pressed(f_reply))
{
if(t_status!="open")
{
dlg("This ticket is closed.");
continue;
}
admin_reply_ticket(an, comp_id, ticket_id);
return;
}
else if(f_closeticket>-1 and f.is_pressed(f_closeticket))
{
admin_close_ticket(an, comp_id, ticket_id);
return;
}
else if(f.is_pressed(f_back))
{
admin_support_tickets(an, comp_id);
return;
}
}
}

// ---------------------------------------------------------------------------
// Admin panel — reply to ticket.
// ---------------------------------------------------------------------------
void admin_reply_ticket(network@ an, string comp_id, string ticket_id)
{
iw_form f;
f.create_window("Reply to Ticket #"+ticket_id, false, true);
int f_msg=f.create_input_box("Your reply", "", "", 0, false, false, true);
int f_send=f.create_button("&Send reply", true);
int f_cancel=f.create_button("&Cancel", false, true);
f.focus(f_msg);
while(true)
{
wait(5);
f.monitor();
if(f.is_pressed(f_send))
{
string reply=f.get_text(f_msg);
if(reply=="")
{
dlg("Please enter a reply.");
continue;
}
reply=string_replace(reply, "|", "/", true);
reply=string_replace(reply, "~", "-", true);
reply=string_replace(reply, "\n", "<<NL>>", true);
string msg_str="ticket_admin_reply "+comp_id+" "+ticket_id+"|admin|"+reply;
if(SCRIPT_COMPILED==false)
msg_str=string_replace(msg_str, comp_id+" ", comp_id+" dev ", false);
string msg=string_encrypt(msg_str, "_';'_clickclick!");
an.send_reliable(0, msg, 0);
timer wt;
while(wt.elapsed<3000)
{
wait(5);
network_event ev=an.request();
if(ev.type==event_receive)
{
string r=ev.message;
if(r!="") r=string_decrypt(r, "masonandsamare2bitches");
if(r=="ticket_replied") break;
}
}
dlg("Reply sent.");
admin_view_ticket(an, comp_id, ticket_id);
return;
}
else if(f.is_pressed(f_cancel))
{
admin_view_ticket(an, comp_id, ticket_id);
return;
}
}
}

// ---------------------------------------------------------------------------
// Admin panel — close ticket with required reason.
// ---------------------------------------------------------------------------
void admin_close_ticket(network@ an, string comp_id, string ticket_id)
{
iw_form f;
f.create_window("Close Ticket #"+ticket_id, false, true);
int f_reason=f.create_input_box("Reason for closing", "", "", 0, false, false, true);
int f_close=f.create_button("&Close ticket", true);
int f_cancel=f.create_button("&Cancel", false, true);
f.focus(f_reason);
while(true)
{
wait(5);
f.monitor();
if(f.is_pressed(f_close))
{
string reason=f.get_text(f_reason);
if(reason=="")
{
dlg("You must provide a reason for closing this ticket.");
continue;
}
reason=string_replace(reason, "|", "/", true);
reason=string_replace(reason, "~", "-", true);
reason=string_replace(reason, "\n", "<<NL>>", true);
string msg_str="ticket_admin_close "+comp_id+" "+ticket_id+"|admin|"+reason;
if(SCRIPT_COMPILED==false)
msg_str=string_replace(msg_str, comp_id+" ", comp_id+" dev ", false);
string msg=string_encrypt(msg_str, "_';'_clickclick!");
an.send_reliable(0, msg, 0);
timer wt;
while(wt.elapsed<3000)
{
wait(5);
network_event ev=an.request();
if(ev.type==event_receive)
{
string r=ev.message;
if(r!="") r=string_decrypt(r, "masonandsamare2bitches");
if(r=="ticket_closed"){p.play_stationary("ticketclose.ogg",false);break;}
}
}
dlg("Ticket closed.");
admin_support_tickets(an, comp_id);
return;
}
else if(f.is_pressed(f_cancel))
{
admin_view_ticket(an, comp_id, ticket_id);
return;
}
}
}
