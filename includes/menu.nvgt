labels.insert_last("Groups: You were removed from a group");files.insert_last("group/kicked.ogg");
labels.insert_last("Groups: A group was disbanded");files.insert_last("group/disband.ogg");
labels.insert_last("Groups: You created a group");files.insert_last("group/create.ogg");
labels.insert_last("Groups: Someone was promoted, or a group was renamed");files.insert_last("group/promote.ogg");
labels.insert_last("Menus: Error");files.insert_last(ui_sound("error"));
labels.insert_last("Menus: Voice command listening");files.insert_last(ui_sound("listen"));
labels.insert_last("Menus: Voice command heard");files.insert_last(ui_sound("listen_end"));
nv_form f;
// Moving through the list and pressing Enter are silent here, so the only
// thing you hear is the sound you are learning.
string[] quiet={"item","edge","wrap","move","activate"};
muted_ui_cues=quiet;
f.create_window("Learn the game's sounds", false, true);
nv_form_list_box@ list=f.add_list("Sounds. Enter plays the one you are on.","sounds");
for(uint i=0;i<labels.length();i++)list.add(labels[i],""+i);
nv_form_button@ again=f.add_button("Play","play",true);
again.hidden=true;
nv_form_button@ close=f.add_button("Close","close",false,true);
f.focus_control(list);
sound preview;
while(true)
{
wait(5);
f.monitor();
if(connected)netloop();
int now=list.list_position;
if(f.is_pressed(again) and now>=0 and now<int(files.length()))
{
preview.close();
preview.load(files[now]);
preview.play();
}
if(f.is_pressed(close)){preview.close();muted_ui_cues.resize(0);return;}
}
}
void setupmenu(bool music=false, bool main=false)
{
m.reset(true);
if (music==true)
m.add_music("menumus.ogg");
if(main==true)
m.set_callback(main_events, "");
else
m.set_callback(cme, "");
// The list menus use the same cue set as the forms, so a menu and a dialog
// sound like parts of one game.
m.click_sound=ui_sound("item");
m.enter_sound=ui_sound("activate");
m.wrap=menu_wrap_enabled;
m.enable_home_and_end=true;
m.enable_up_and_down=true;
m.enable_first_letter_navigation=true;
m.open_sound=ui_sound("open");
m.wrap_sound=ui_sound("wrap");
m.edge_sound=ui_sound("edge");
m.enable_side_scrolling=false;
m.enable_left_and_right=false;
}
// ---------------------------------------------------------------------------
// Options use NV_form property pages. The focused tab strip is deliberately
// first: Left and Right select a category, then Tab enters that page.
// ---------------------------------------------------------------------------
// Options.
//
// Six categories, each named for what a player is looking for when they open
// it: how the game plays, how it sounds, how you control it, touch, things
// that make it usable, and being online. It used to be eleven tabs, several
// of them holding a single checkbox, with voice commands and voice chat on
// the same page because both had "voice" in the name. Nothing has been taken
// away; everything has been put where you would look for it.
//
// Volumes and sensitivities are sliders rather than boxes you type a number
// into, and the volume sliders take effect while you move them, with a sound
// on the channel you are adjusting, so you set a level by hearing it. Cancel
// puts them back.
void options_label_percent(nv_form_slider@ s,int low,int high,int step)
{
for(int v=low;v<=high;v+=step)s.set_text(v,v+" percent");
}
nv_form_slider@ options_volume_slider(nv_form_tab_page@ page,const string &in caption,const string &in id,int db)
{
nv_form_slider@ s=page.add_slider(caption,id,0,100,5,volume_db_to_percent(db),20);
options_label_percent(s,0,100,5);
return s;
}
// A short sound on the mixer being adjusted, so the level can be judged.
void options_preview_channel(int channel)
{
if(channel==0 or channel==3)spool.play_stationary(ui_sound("item"),false);
else if(channel==1)p.play_stationary("ak47fire1.ogg",false);
else if(channel==2)ambpool.play_stationary("executioners_rage/environment/ambiance/fountain.wav",false);
else if(channel==4)bufferpool.play_stationary(ui_sound("notify"),false);
}
void options_apply_volume(int channel,int percent)
{
int db=volume_percent_to_db(percent);
if(channel==0)set_sound_master_volume(db);
else if(channel==1)gameplay_mixer.volume=db;
else if(channel==2)world_mixer.volume=db;
else if(channel==3)interface_mixer.volume=db;
else if(channel==4)notification_mixer.volume=db;
}

void optionsmenu()
{
nv_form f;
f.create_window("Options", false, true);
nv_form_tab_control@ tabs=nv_form_tab_control(@f, "Category", "categories", true);
f.add_control(tabs);
nv_form_tab_page@ gameplay=tabs.add_tab_page("Gameplay");
nv_form_tab_page@ sound_page=tabs.add_tab_page("Sound");
nv_form_tab_page@ controls=tabs.add_tab_page("Controls");
nv_form_tab_page@ touch=tabs.add_tab_page("Touch");
nv_form_tab_page@ access=tabs.add_tab_page("Accessibility");
nv_form_tab_page@ online=tabs.add_tab_page("Online");

// Gameplay: what you are told during a fight, and how equipment behaves.
nv_form_checkbox@ f_target_hp=gameplay.add_checkbox("Say the target's remaining health when you hit them", "target_hp", show_target_hp);
nv_form_checkbox@ f_damage_readout=gameplay.add_checkbox("Say how much damage each hit did", "damage", show_damage_readout);
nv_form_checkbox@ f_own_projectiles=gameplay.add_checkbox("Hear your own bullets and projectiles in flight", "own_projectiles", hear_own_projectile_audio);
nv_form_checkbox@ f_auto_quickbar=gameplay.add_checkbox("Put your starting weapons and items on the quickbar automatically", "auto_quickbar", auto_bind_starting_loadout);
nv_form_checkbox@ f_replace_attachments=gameplay.add_checkbox("Swap out an attachment when its slot is already taken", "replace_attachments", replace_occupied_attachments);

// Sound: every level in one place, heard while you set it.
nv_form_slider@[] volume;
volume.insert_last(options_volume_slider(sound_page,"Master volume","volume",mastervol));
volume.insert_last(options_volume_slider(sound_page,"Weapons, players and effects","gameplay_volume",gameplay_volume));
volume.insert_last(options_volume_slider(sound_page,"Map ambience and distant combat","world_volume",world_volume));
volume.insert_last(options_volume_slider(sound_page,"Menus and interface","interface_volume",interface_volume));
volume.insert_last(options_volume_slider(sound_page,"Messages and notifications","notification_volume",notification_volume));
int[] volume_before;for(uint i=0;i<volume.length();i++)volume_before.insert_last(int(volume[i].value));
int[] volume_last=volume_before;
nv_form_checkbox@ f_occlusion=sound_page.add_checkbox("Muffle sounds heard through walls and closed doors", "occlusion", acoustic_occlusion_enabled);
nv_form_checkbox@ f_form_sounds=sound_page.add_checkbox("Play sounds when moving through menus and dialogs", "form_sounds", audio_form_sound_feedback);
nv_form_slider@ f_system_volume=sound_page.add_slider("Game volume in the Windows mixer","system_volume",0,100,5,round(app_volume_percent()/5,0)*5,20);
options_label_percent(f_system_volume,0,100,5);
nv_form_button@ f_toggle_system_mute=sound_page.add_button("Mute or unmute the game in the Windows mixer", "system_mute");

// Controls: keyboard and mouse.
nv_form_button@ f_keybinds=controls.add_button("Edit key bindings", "keybinds");
nv_form_checkbox@ f_rctrl=controls.add_checkbox("Treat Right Control as a separate key", "rctrl", rctrl==1);
nv_form_slider@ f_mouse_turn=controls.add_slider("Mouse turning sensitivity","mouse_turn",10,300,10,helper_mouse_turn_sensitivity,50);
options_label_percent(f_mouse_turn,10,300,10);
nv_form_slider@ f_mouse_aim=controls.add_slider("Mouse aiming sensitivity","mouse_aim",10,300,10,helper_mouse_aim_sensitivity,50);
options_label_percent(f_mouse_aim,10,300,10);
nv_form_checkbox@ f_mouse_invert=controls.add_checkbox("Invert vertical mouse aiming", "mouse_invert", helper_mouse_invert_vertical);
nv_form_checkbox@ f_mouse_wheel=controls.add_checkbox("Mouse wheel cycles through your inventory", "mouse_wheel", helper_mouse_wheel_inventory);
nv_form_checkbox@ f_helper_mouse=controls.add_checkbox("Mouse back and forward buttons change message buffer", "helper_mouse", helper_mouse_shortcuts);
nv_form_checkbox@ f_helper_confine=controls.add_checkbox("Keep the mouse pointer inside the game window", "helper_confine", helper_mouse_confined);

// Touch: Android, and Windows touchscreens.
nv_form_checkbox@ f_touch_keyboard=touch.add_checkbox("Use the game's own touch keyboard instead of the system one", "touch_keyboard", touch_keyboard_enabled);
nv_form_checkbox@ f_analogue_keyboard=touch.add_checkbox("Type on a grid by position instead of by exploring", "analogue_keyboard", touch_keyboard_analogue);
nv_form_checkbox@ f_touch_explore=touch.add_checkbox("Explore menus by holding and dragging a finger over them", "touch_explore", touch_menu_explore_enabled);
nv_form_checkbox@ f_touch_portrait=touch.add_checkbox("Portrait orientation: gesture bands run left to right", "touch_portrait", touch_portrait_mode);
nv_form_checkbox@ f_pc_touch_bands=touch.add_checkbox("Spread the gesture bands across a whole laptop touchscreen; turns on touch mode and full screen", "pc_touch_bands", touch_pc_fullscreen_bands);
nv_form_checkbox@ f_touch=touch.add_checkbox("Simulate Android touch mode, for testing gestures on a computer", "touch", touch_force_enabled);
nv_form_checkbox@ f_practice_band=touch.add_checkbox("Say which screen band you are in during gesture practice", "practice_band", gesture_practice_speak_band);
nv_form_button@ f_gestures=touch.add_button("List the touch gestures", "gestures");
nv_form_button@ f_gesture_bindings=touch.add_button("Change or reset gesture bindings", "gesture_bindings");

// Accessibility: seeing it, finding your way round it, and talking to it.
nv_form_checkbox@ f_helper_hud=access.add_checkbox("Low-vision display: show what the game says in large, high-contrast text", "helper_hud", helper_visual_hud);
nv_form_checkbox@ f_fullscreen=access.add_checkbox("Full screen", "fullscreen", fullscreen_enabled);
nv_form_checkbox@ f_wrap=access.add_checkbox("Menus wrap from the last item back to the first", "wrap", menu_wrap_enabled);
nv_form_checkbox@ f_classic_menu=access.add_checkbox("Show the main menu as a column of buttons instead of a list", "classic_menu", classic_main_menu);
nv_form_checkbox@ f_helper_voice=access.add_checkbox("Windows voice commands", "helper_voice", helper_voice_commands);
nv_form_input@ f_voice_wake=access.add_input("Phrase that starts a voice command", "voice_wake", helper_voice_wake_phrase);
nv_form_button@ f_rerun_setup=access.add_button("Run the first-time setup again", "rerun_setup");

// Online: your account, the server, chat, and hearing about things while the
// game is in the background.
nv_form_checkbox@ f_remember=online.add_checkbox("Remember my account on this computer", "remember", remember_me);
nv_form_input@ f_server_address=online.add_input("Server address", "server_address", netaddress);
nv_form_input@ f_server_port=online.add_input("Server port", "server_port", ""+netport);
nv_form_button@ f_server_manager=null;if(!SCRIPT_COMPILED or dev_unlocked)@f_server_manager=online.add_button("Saved servers", "server_manager");
nv_form_button@ f_voice=online.add_button("Voice chat and microphone", "voice_settings");
nv_form_checkbox@ f_chat_timestamps=online.add_checkbox("Say the time at the end of each chat message", "chat_timestamps", show_chat_timestamps);
nv_form_checkbox@ f_autolog=online.add_checkbox("Save message buffers to a file when you quit", "autolog", auto_log_buffers);
nv_form_checkbox@ f_helper_notifications=online.add_checkbox("Windows notifications for private messages, ticket replies, your name in chat and server problems, while the game is in the background", "helper_notifications", helper_desktop_notifications);
nv_form_checkbox@ f_helper_tray=online.add_checkbox("Tray icon with show, hide and mute", "helper_tray", helper_tray_controls);
nv_form_button@ f_test_notification=online.add_button("Send a test notification", "test_notification");

nv_form_button@ f_save=f.add_button("Save", "save", true);
nv_form_button@ f_close=f.add_button("Cancel", "cancel", false, true);
tabs.focus();
while (true)
{
wait(5);
f.monitor();
if (connected==true)
netloop();
// Volume sliders take effect as they move.
for(uint i=0;i<volume.length();i++)
{
int now=int(volume[i].value);
if(now==volume_last[i])continue;
volume_last[i]=now;
options_apply_volume(i,now);
options_preview_channel(i);
}
// The linked screens return here with everything on this one as it was.
// Rebuilding the whole form after them, as this used to, silently threw
// away every change not yet saved.
if (controls.is_pressed(f_keybinds)){options_keybinds();speak("Options.");continue;}
if (touch.is_pressed(f_gestures)){show_android_gestures();continue;}
if (touch.is_pressed(f_gesture_bindings)){gesture_bindings_menu();continue;}
if (online.is_pressed(f_voice)){voice_settings_menu();continue;}
if(@f_server_manager!=null and online.is_pressed(f_server_manager)){server_manager();f_server_address.text=netaddress;f_server_port.text=""+netport;continue;}
if(online.is_pressed(f_test_notification)){bool was=helper_desktop_notifications;helper_desktop_notifications=true;helper_test_notification();helper_desktop_notifications=was;continue;}
if(sound_page.is_pressed(f_toggle_system_mute)){helper_toggle_app_mute();continue;}
// Setup replaces these settings wholesale, so this screen reopens with its
// answers rather than saving stale values over them.
if(access.is_pressed(f_rerun_setup)){first_boot_setup_wizard();reconfigure_nvgt_helpers();optionsmenu();return;}
if (f.is_pressed(f_save))
{
remember_me=f_remember.state;
show_target_hp=f_target_hp.state;
show_damage_readout=f_damage_readout.state;
auto_bind_starting_loadout=f_auto_quickbar.state;
replace_occupied_attachments=f_replace_attachments.state;
hear_own_projectile_audio=f_own_projectiles.state;
audio_form_sound_feedback=f_form_sounds.state;
acoustic_occlusion_enabled=f_occlusion.state;
rctrl=(f_rctrl.state ? 1 : 0);
menu_wrap_enabled=f_wrap.state;
auto_log_buffers=f_autolog.state;
classic_main_menu=f_classic_menu.state;
touch_force_enabled=f_touch.state;
gesture_practice_speak_band=f_practice_band.state;
bool requested_fullscreen=f_fullscreen.state;
if(requested_fullscreen!=fullscreen_enabled)set_fullscreen_mode(requested_fullscreen,true);
touch_keyboard_enabled=f_touch_keyboard.state;
touch_keyboard_analogue=f_analogue_keyboard.state;
touch_pc_fullscreen_bands=f_pc_touch_bands.state;
touch_menu_explore_enabled=f_touch_explore.state;
if(touch_portrait_mode!=f_touch_portrait.state){touch_portrait_mode=f_touch_portrait.state;apply_touch_orientation();}
bool hud_was=helper_visual_hud;
helper_visual_hud=f_helper_hud.state;
helper_desktop_notifications=f_helper_notifications.state;
helper_tray_controls=f_helper_tray.state;
helper_voice_commands=f_helper_voice.state;
helper_voice_wake_phrase=f_voice_wake.text.trim_whitespace();if(helper_voice_wake_phrase=="")helper_voice_wake_phrase="infinite warfare";
helper_mouse_shortcuts=f_helper_mouse.state;
helper_mouse_confined=f_helper_confine.state;
helper_mouse_wheel_inventory=f_mouse_wheel.state;
helper_mouse_invert_vertical=f_mouse_invert.state;
helper_mouse_turn_sensitivity=int(f_mouse_turn.value);
helper_mouse_aim_sensitivity=int(f_mouse_aim.value);
set_app_volume_percent(f_system_volume.value);
show_chat_timestamps=f_chat_timestamps.state;
// Turning the display on offers full screen the once; it no longer forces
// it back on every time options are saved.
if(helper_visual_hud and !hud_was and !fullscreen_enabled)set_fullscreen_mode(true,true);
if(touch_pc_fullscreen_bands and !system_is_mobile){touch_force_enabled=true;if(!fullscreen_enabled)set_fullscreen_mode(true,true);}
string requested_address=f_server_address.text.trim_whitespace();int requested_port=string_to_number(f_server_port.text);if(requested_address!="")netaddress=requested_address;if(requested_port>0 and requested_port<=65535)netport=requested_port;else speak("That port is not valid, so the port stays "+netport+".");
mastervol=volume_percent_to_db(int(volume[0].value));
gameplay_volume=volume_percent_to_db(int(volume[1].value));
world_volume=volume_percent_to_db(int(volume[2].value));
interface_volume=volume_percent_to_db(int(volume[3].value));
notification_volume=volume_percent_to_db(int(volume[4].value));
set_sound_master_volume(mastervol);
gameplay_mixer.volume=gameplay_volume;
world_mixer.volume=world_volume;
interface_mixer.volume=interface_volume;
notification_mixer.volume=notification_volume;
reconfigure_nvgt_helpers();
writeprefs();
play_ui_cue("apply");
speak("Options saved.");
break;
}
else if (f.is_pressed(f_close))
{
for(uint i=0;i<volume.length();i++)options_apply_volume(i,volume_before[i]);
break;
}
}
}
// ---------------------------------------------------------------------------
// Administrator Panel (only available when running from source)
// Connects to the server to verify admin/dev status, then provides
// authorization mode toggle, unauthenticated player list, and
// password reset request viewer.
// ---------------------------------------------------------------------------
void adminpanel()
{
p.play_stationary("executioners_rage/ui/admin.wav",false);
if(name=="" or !account_exists(name))
{
dlg("You must be logged into an account to access the admin panel.");
mainmenu();
return;
}
speak("Connecting to server to verify administrator access, please wait.");
network an;
an.setup_client(1, 100);
an.connect(netaddress, netport);
bool verified=false;
bool current_authmode=false;
timer ct;
while(ct.elapsed<5000)
{
wait(5);
network_event ev=an.request();
if(ev.type==event_connect)
{
string msg_str="admin_panel "+comp+" "+name;
string msg=string_encrypt(msg_str, "_';'_clickclick!");
an.send_reliable(0, msg, 0);
timer rt;
while(rt.elapsed<3000)
{
wait(5);
ev=an.request();
if(ev.type==event_receive)
{
string r=ev.message;
if(r!="") r=string_decrypt(r, "masonandsamare2bitches");
if(string_contains(r, "admin_panel_ok ", 1)==0)
{
verified=true;
current_authmode=(string_replace(r, "admin_panel_ok ", "", false)=="1");
break;
}
else if(r=="admin_panel_denied")
{
dlg("Access denied. You are not an administrator.");
mainmenu();
return;
}
}
}
break;
}
if(ev.type==event_disconnect)
break;
}
if(!verified)
{
dlg("Could not verify administrator access. The server may be offline.");
mainmenu();
return;
}
// Categorized NV_form property sheet.
nv_form f;
f.create_window("Administrator Panel", false, true);
nv_form_tab_control@ tabs=nv_form_tab_control(@f, "Categories", "admin_categories", true);
f.add_control(tabs);
nv_form_tab_page@ accounts=tabs.add_tab_page("Accounts and authorization");
nv_form_tab_page@ services=tabs.add_tab_page("Player services");
nv_form_tab_page@ developer=tabs.add_tab_page("Developer access");
nv_form_checkbox@ f_authmode=accounts.add_checkbox("Authorization mode; new accounts require approval", "authmode", current_authmode);
nv_form_button@ f_save_auth=accounts.add_button("Save authorization mode", "save_auth");
nv_form_button@ f_viewunauth=accounts.add_button("View unauthenticated players", "unauth");
nv_form_button@ f_viewresets=accounts.add_button("View password reset requests", "resets");
nv_form_button@ f_tickets=services.add_button("Manage support tickets", "tickets");
nv_form_button@ f_devkey=developer.add_button("Enter developer unlock key", "devkey");
nv_form_button@ f_release=null;
if(!SCRIPT_COMPILED)@f_release=developer.add_button("Compress a release build", "release_build");
nv_form_button@ f_close=f.add_button("Close", "close", false, true);
tabs.focus();
while(true)
{
wait(5);
f.monitor();
if(@f_release!=null and developer.is_pressed(f_release)){compress_release_build();return;}
if (accounts.is_pressed(f_save_auth))
{
string val=(f_authmode.state ? "1" : "0");
string msg_str="admin_set_authmode "+val+" "+comp+" "+name;
string msg=string_encrypt(msg_str, "_';'_clickclick!");
an.send_reliable(0, msg, 0);
timer rt;
bool saved=false;
while(rt.elapsed<3000)
{
wait(5);
network_event ev=an.request();
if(ev.type==event_receive)
{
string r=ev.message;
if(r!="") r=string_decrypt(r, "masonandsamare2bitches");
if(r=="admin_authmode_saved")
{
saved=true;
break;
}
}
}
if(saved)
speak("Authorization mode "+(f_authmode.state ? "enabled" : "disabled")+" and saved.");
else
dlg("Failed to save setting. Server may not have responded.");
}
else if (accounts.is_pressed(f_viewunauth))
{
string msg_str="admin_get_unauth "+comp+" "+name;
string msg=string_encrypt(msg_str, "_';'_clickclick!");
an.send_reliable(0, msg, 0);
string data="";
timer rt;
while(rt.elapsed<3000)
{
wait(5);
network_event ev=an.request();
if(ev.type==event_receive)
{
string r=ev.message;
if(r!="") r=string_decrypt(r, "masonandsamare2bitches");
if(string_contains(r, "admin_unauth_list ", 1)==0)
{
data=string_replace(r, "admin_unauth_list ", "", false);
break;
}
}
}
// Show unauthenticated players in a sub-form
iw_form uf;
uf.create_window("Unauthenticated Players", false, true);
if(data=="")
{
uf.create_input_box("Info", "No unauthenticated players found.", "", 0, false, true, false);
}
else
{
string[] entries=string_split(data, ",", false);
for(uint i=0; i<entries.length(); i++)
{
string[] parts=string_split(entries[i], "|", false);
if(parts.length()<2) continue;
uf.create_input_box(parts[0], "Code: "+parts[1], "", 0, false, true, false);
}
}
int uf_close=uf.create_button("&Close", true, true);
uf.focus(0);
while(true)
{
wait(5);
uf.monitor();
if(uf.is_pressed(uf_close))
break;
}
}
else if (accounts.is_pressed(f_viewresets))
{
string msg_str="admin_get_resets "+comp+" "+name;
string msg=string_encrypt(msg_str, "_';'_clickclick!");
an.send_reliable(0, msg, 0);
string data="";
timer rt;
while(rt.elapsed<3000)
{
wait(5);
network_event ev=an.request();
if(ev.type==event_receive)
{
string r=ev.message;
if(r!="") r=string_decrypt(r, "masonandsamare2bitches");
if(string_contains(r, "admin_reset_list ", 1)==0)
{
data=string_replace(r, "admin_reset_list ", "", false);
break;
}
}
}
// Show password reset requests in a sub-form
iw_form rf;
rf.create_window("Password Reset Requests", false, true);
if(data=="")
{
rf.create_input_box("Info", "No pending password reset requests.", "", 0, false, true, false);
}
else
{
string[] entries=string_split(data, ",", false);
for(uint i=0; i<entries.length(); i++)
{
string[] parts=string_split(entries[i], "|", false);
if(parts.length()<2) continue;
rf.create_input_box(parts[0], "Reset code: "+parts[1], "", 0, false, true, false);
}
}
int rf_close=rf.create_button("&Close", true, true);
rf.focus(0);
while(true)
{
wait(5);
rf.monitor();
if(rf.is_pressed(rf_close))
break;
}
}
else if (services.is_pressed(f_tickets))
{
admin_support_tickets(an, comp);
}
else if(developer.is_pressed(f_devkey))
{
string key=af_input("Enter developer unlock key");
if(key!="")
{
if(key!=CLIENT_DEV_KEY)
{
dlg("Incorrect key.");
}
else
{
string msg_str="dev_validate_key "+key+" "+name;
string msg=string_encrypt(msg_str, "_';'_clickclick!");
an.send_reliable(0, msg, 0);
timer kt;
bool got_response=false;
while(kt.elapsed<3000)
{
wait(5);
network_event ev=an.request();
if(ev.type==event_receive)
{
string r=ev.message;
if(r!="") r=string_decrypt(r, "masonandsamare2bitches");
if(r=="dev_key_ok")
{
dev_unlocked=true;
dlg("Developer access unlocked. You may now connect with any account.");
got_response=true;
break;
}
else if(r=="dev_key_denied")
{
dlg("Key validation failed.");
got_response=true;
break;
}
}
}
if(!got_response)
dlg("Server did not respond to key validation.");
}
}
}
else if (f.is_pressed(f_close))
{
break;
}
}
mainmenu();
}
void ingame_adminpanel()
{
speak("Verifying administrator access, please wait.");
send_reliable(0, "admin_panel "+comp+" "+name, 0);
bool verified=false;
bool current_authmode=false;
timer ct;
while(ct.elapsed<3000)
{
wait(5);
e=n.request();
if(e.type==event_receive)
{
string msg=get_event_message();
if(string_contains(msg, "admin_panel_ok ", 1)==0)
{
verified=true;
current_authmode=(string_replace(msg, "admin_panel_ok ", "", false)=="1");
break;
}
else if(msg=="admin_panel_denied")
{
dlg("Access denied. You are not an administrator.");
return;
}
}
if(server_event_disconnect(e))
{
speak("Disconnected from server.");
return;
}
}
if(!verified)
{
dlg("Could not verify administrator access. The server may not have responded.");
return;
}
nv_form f;
f.create_window("Administrator Panel", false, true);
nv_form_tab_control@ tabs=nv_form_tab_control(@f, "Categories", "admin_categories", true);
f.add_control(tabs);
nv_form_tab_page@ accounts=tabs.add_tab_page("Accounts and authorization");
nv_form_tab_page@ services=tabs.add_tab_page("Player services");
nv_form_tab_page@ staff=tabs.add_tab_page("Staff roles");
nv_form_tab_page@ moderation=tabs.add_tab_page("Moderation");
nv_form_tab_page@ communication=tabs.add_tab_page("Communication");
nv_form_tab_page@ world=tabs.add_tab_page("World tools");
nv_form_tab_page@ server=tabs.add_tab_page("Server control");
nv_form_tab_page@ developer=tabs.add_tab_page("Developer access");
nv_form_checkbox@ f_authmode=accounts.add_checkbox("Authorization mode; new accounts require approval", "authmode", current_authmode);
nv_form_button@ f_save_auth=accounts.add_button("Save authorization mode", "save_auth");
nv_form_button@ f_viewunauth=accounts.add_button("View unauthenticated players", "unauth");
nv_form_button@ f_viewresets=accounts.add_button("View password reset requests", "resets");
nv_form_button@ f_tickets=services.add_button("Manage support tickets", "tickets");
nv_form_button@ f_accounts=services.add_button("Browse account profiles", "account_profiles");
nv_form_button@ f_staff_list=staff.add_button("List assigned staff and roles", "staff_list");
nv_form_button@ f_staff_assign=staff.add_button("Assign or change a staff role", "staff_assign");
nv_form_button@ f_staff_remove=staff.add_button("Remove a staff role", "staff_remove");
nv_form_button@ f_warn=moderation.add_button("Issue an official warning", "warn");
nv_form_button@ f_warnings=moderation.add_button("Review an account's warnings", "warnings");
nv_form_button@ f_kick=moderation.add_button("Kick an online player", "kick");
nv_form_button@ f_ban=moderation.add_button("Ban an account", "ban");
nv_form_button@ f_unban=moderation.add_button("Unban an account", "unban");
nv_form_button@ f_bans=moderation.add_button("List active bans", "bans");
nv_form_button@ f_player_report=moderation.add_button("File a report against a player", "player_report");
nv_form_button@ f_player_reports=moderation.add_button("List filed player reports", "player_reports");
nv_form_button@ f_admin_log=moderation.add_button("Read the administration log", "admin_log");
nv_form_button@ f_notify=communication.add_button("Broadcast a server notification", "notify");
nv_form_button@ f_motd=communication.add_button("Replace the message of the day", "motd");
nv_form_button@ f_builder=world.add_button("Open the live map builder", "builder");
nv_form_button@ f_teleport=world.add_button("Teleport to coordinates", "teleport");
nv_form_button@ f_give=world.add_button("Give an item to a player", "give");
nv_form_button@ f_physics=server.add_button("Read physics backend status", "physics");
nv_form_button@ f_reboot=server.add_button("Schedule a server reboot", "reboot");
nv_form_button@ f_cancel_reboot=server.add_button("Cancel a scheduled reboot", "cancel_reboot");
nv_form_button@ f_server_gc=server.add_button("Run server garbage collection and stale-state cleanup", "server_gc");
nv_form_button@ f_devkey=developer.add_button("Enter developer unlock key", "devkey");
nv_form_button@ f_close=f.add_button("Close", "close", false, true);
tabs.focus();
while(true)
{
wait(5);
f.monitor();
if(connected==true) netloop();
if(accounts.is_pressed(f_save_auth))
{
string val=(f_authmode.state ? "1" : "0");
send_reliable(0, "admin_set_authmode "+val+" "+comp+" "+name, 0);
timer rt;
bool saved=false;
while(rt.elapsed<3000)
{
wait(5);
e=n.request();
if(e.type==event_receive)
{
string msg=get_event_message();
if(msg=="admin_authmode_saved")
{
saved=true;
break;
}
}
}
if(saved)
speak("Authorization mode "+(f_authmode.state ? "enabled" : "disabled")+" and saved.");
else
dlg("Failed to save setting. Server may not have responded.");
}
else if(accounts.is_pressed(f_viewunauth))
{
send_reliable(0, "admin_get_unauth "+comp+" "+name, 0);
string data="";
timer rt;
while(rt.elapsed<3000)
{
wait(5);
e=n.request();
if(e.type==event_receive)
{
string msg=get_event_message();
if(string_contains(msg, "admin_unauth_list ", 1)==0)
{
data=string_replace(msg, "admin_unauth_list ", "", false);
break;
}
}
}
iw_form uf;
uf.create_window("Unauthenticated Players", false, true);
if(data=="")
{
uf.create_input_box("Info", "No unauthenticated players found.", "", 0, false, true, false);
}
else
{
string[] entries=string_split(data, ",", false);
for(uint i=0; i<entries.length(); i++)
{
string[] parts=string_split(entries[i], "|", false);
if(parts.length()<2) continue;
uf.create_input_box(parts[0], "Code: "+parts[1], "", 0, false, true, false);
}
}
int uf_close=uf.create_button("&Close", true, true);
uf.focus(0);
while(true)
{
wait(5);
uf.monitor();
if(connected==true) netloop();
if(uf.is_pressed(uf_close))
break;
}
}
else if(accounts.is_pressed(f_viewresets))
{
send_reliable(0, "admin_get_resets "+comp+" "+name, 0);
string data="";
timer rt;
while(rt.elapsed<3000)
{
wait(5);
e=n.request();
if(e.type==event_receive)
{
string msg=get_event_message();
if(string_contains(msg, "admin_reset_list ", 1)==0)
{
data=string_replace(msg, "admin_reset_list ", "", false);
break;
}
