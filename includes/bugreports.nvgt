// Bug reports. Built like support tickets and feedback: each screen returns
// to the one it came from, and a report is a list you arrow through. Viewing
// a report used to reopen the whole list from scratch on the way back, and
// staff flagging reopened it again, stacking a screen per visit.

void bug_submit()
{
nv_form f;
f.create_window("Report a bug",false,true);
nv_form_input@ title=f.add_input("What went wrong, in a few words","title");
nv_form_input@ body=f.add_input("What you did, what happened, and what you expected","body","","",0,false,true);
nv_form_button@ submit=f.add_button("Send report","send",true);
nv_form_button@ cancel=f.add_button("Cancel","cancel",false,true);
f.focus_control(title);
while(true)
{
wait(5);
f.monitor();
if(connected==true) netloop();
if(f.is_pressed(cancel))return;
if(!f.is_pressed(submit))continue;
string t=title.text.trim_whitespace();
string b=body.text.trim_whitespace();
if(t==""){speak("The report needs a title.");f.focus_control(title);continue;}
if(b==""){speak("Describe the bug first.");f.focus_control(body);continue;}
t=string_replace(string_replace(support_encode(t),"<<NL>>"," ",true),",",";",true);
send_reliable(0,"bug_create "+name+"|"+t+"|"+support_encode(b),0);
string result="";
if(wait_for_service_response("bug_created",result,3000))dlg("Thank you. The report has been sent and the developers have been told.");
else dlg("The server did not confirm the report, so it may not have been sent. Try again in a moment.");
return;
}
}

string bug_flag_label(const string &in flag){return (flag=="" or flag=="none")?"not yet looked at":string_to_lower_case(flag);}

void bugs_menu()
{
send_reliable(0,"bug_check_role",0);
bool is_staff=false;
string role_response;if(wait_for_service_response("bug_role_",role_response,2000))is_staff=role_response=="bug_role_staff";
speak(is_staff?"Loading every bug report.":"Loading your bug reports.");
send_reliable(0,is_staff?"bug_list_all":"bug_list_my "+name,0);
string response;
string prefix=is_staff?"bug_alllist ":"bug_mylist ";
if(!wait_for_service_response(prefix,response,3000)){speak("The server did not send the reports.");return;}
string data=string_replace(response,prefix,"",false);
string[] labels,ids;
if(data!="" and data!="none")
{
string[] entries=string_split(data,",",false);
for(uint i=0;i<entries.length();i++)
{
string[] parts=string_split(entries[i],"~",false);
if(is_staff)
{
if(parts.length()<4)continue;
labels.insert_last("Report "+parts[0]+" from "+parts[1]+": "+parts[2]+", "+bug_flag_label(parts[3]));
}
else
{
if(parts.length()<3)continue;
labels.insert_last("Report "+parts[0]+": "+parts[1]+", "+bug_flag_label(parts[2]));
}
ids.insert_last(parts[0]);
}
}
if(labels.length()==0){speak(is_staff?"There are no bug reports.":"You have not sent any bug reports.");return;}
while(true)
{
string id=pick_from_list((is_staff?"All bug reports, ":"Your bug reports, ")+labels.length(),labels,ids);
if(id=="")return;
bug_view(id,is_staff);
}
}

void bug_view(string bug_id,bool is_staff)
{
while(true)
{
speak("Loading report "+bug_id+".");
send_reliable(0,"bug_get "+bug_id,0);
string response;
if(!wait_for_service_response("bug_data ",response,3000)){speak("The server did not send the report.");return;}
string data=string_replace(response,"bug_data ","",false);
if(data=="" or data=="not_found"){dlg("That report no longer exists.");return;}
// Format: id~owner~title~flag~comment~body
string[] parts=string_split(data,"~",false);
if(parts.length()<6){dlg("The server sent a report the game could not read.");return;}
nv_form f;
f.create_window("Bug report "+parts[0]+": "+parts[2],false,true);
nv_form_list_box@ list=f.add_list("Bug report "+parts[0],"report");
list.add("Title: "+parts[2],"title");
if(is_staff)list.add("From "+parts[1],"owner");
list.add("Status: "+bug_flag_label(parts[3]),"flag");
list.add("Description: "+support_decode(parts[5]),"body");
if(parts[4]!="" and parts[4]!="none")list.add("Developer's comment: "+support_decode(parts[4]),"comment");
nv_form_button@ flag=null;
if(is_staff)@flag=f.add_button("Set its status","flag");
nv_form_button@ back=f.add_button("Back","back",false,true);
f.focus_control(list);
bool flagging=false;
while(!flagging)
{
wait(5);
f.monitor();
if(connected==true) netloop();
if(f.is_pressed(back))return;
if(@flag!=null and f.is_pressed(flag))flagging=true;
}
bug_flag_menu(bug_id);
}
}

// Staff: set a report's status, with a comment the reporter will see.
void bug_flag_menu(string bug_id)
{
string[] labels={"Pending: seen, and being worked on","Erroneous: not a real bug, or spam","Known: already on the list","Closed: fixed or resolved"};
string[] ids={"Pending","Erroneous","Known","Closed"};
string flag_value=pick_from_list("Status for report "+bug_id,labels,ids);
if(flag_value=="")return;
string comment=af_input("Comment for the reporter","",true).trim_whitespace();
if(comment==""){speak("A status needs a comment, so nothing was changed.");return;}
send_reliable(0,"bug_flag "+bug_id+"|"+flag_value+"|"+support_encode(comment),0);
string flag_response;
if(wait_for_service_response("bug_flagged",flag_response,3000))speak("Report "+bug_id+" is now "+string_to_lower_case(flag_value)+".");
else dlg("The server did not accept the new status.");
}
