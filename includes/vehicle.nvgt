// ---------------------------------------------------------------------------
// Vehicle system.
// ---------------------------------------------------------------------------

const int MAX_MAP_VEHICLES = 10;

// Vehicle type definitions.
class vehicle_type
{
string name;
int max_health;
int armor;
int max_passengers; // includes driver
double top_speed; // tiles per second
double acceleration; // tiles per second squared
double braking; // tiles per second squared
bool[] seat_has_window; // per seat (index 0 = driver)
string fuel_type;
double fuel_capacity;
double fuel_per_tile;
string vehicle_class="ground";
string travel_domain="land";
double body_length=6,body_width=4,body_height=3;
string cargo_kind="none";
int cargo_capacity=0;
string[] seat_roles;
string[] seat_weapons;
// Drivetrain: a manual gearbox has `gears` forward gears changed by the
// driver; an automatic chooses for itself. Turning follows the turning
// circle; pivot_turn lets tracked vehicles and hovering helicopters turn on
// the spot. A reverse_speed of zero means it cannot reverse under its own power.
string transmission="automatic";
int gears=0;
double turning_radius=0,reverse_speed=0;
bool pivot_turn=false;
vehicle_type() {}
vehicle_type(string n, int hp, int ar, int mp, double maximum_speed, double accel, double brake, bool[] windows)
{
name = n;
max_health = hp;
armor = ar;
max_passengers = mp;
top_speed = maximum_speed;
acceleration = accel;
braking = brake;
seat_has_window = windows;
fuel_type=(n=="Duo Plane"?"aviation fuel":(n=="Humvee" or n=="APC" or n=="Tank" or n=="Van"?"diesel":"gasoline"));
fuel_capacity=n=="Tank"?500:(n=="APC"?260:(n=="Duo Plane"?220:(n=="Humvee"?120:(n=="Van"?100:70))));
fuel_per_tile=n=="Tank"?.42:(n=="APC"?.30:(n=="Duo Plane"?.24:(n=="Humvee"?.18:(n=="Van"?.15:.11))));
seat_roles.resize(mp);seat_weapons.resize(mp);for(int i=0;i<mp;i++){seat_roles[i]=i==0?"driver":"passenger";seat_weapons[i]="";}
}
}

vehicle_type@[] vehicle_types;

void init_vehicle_types()
{
vehicle_types.resize(0);

bool[] jeep_win = {true, true, false};
vehicle_types.insert_last(vehicle_type("Jeep",800,0,3,11.1,3.0,5.5,jeep_win));

bool[] humvee_win = {true, true, true, false};
vehicle_types.insert_last(vehicle_type("Humvee",1200,400,4,9.1,2.2,4.8,humvee_win));

bool[] pickup_win = {true, true};
vehicle_types.insert_last(vehicle_type("Pickup Truck",700,0,2,10.0,2.7,5.0,pickup_win));

bool[] apc_win = {true, false, false, false, false, false};
vehicle_types.insert_last(vehicle_type("APC",2500,1000,6,6.25,1.4,3.2,apc_win));

bool[] buggy_win = {true, true};
vehicle_types.insert_last(vehicle_type("Buggy",400,0,2,15.4,4.8,7.0,buggy_win));

bool[] sedan_win = {true, true, true, false};
vehicle_types.insert_last(vehicle_type("Sedan",600,0,4,11.8,3.2,5.8,sedan_win));

bool[] tank_win = {true, false};
vehicle_types.insert_last(vehicle_type("Tank",4000,2000,2,5.0,0.9,2.8,tank_win));

bool[] van_win = {true, true, false, false, false};
vehicle_types.insert_last(vehicle_type("Van",900,0,5,7.7,1.8,4.0,van_win));

bool[] bike_win = {false};
vehicle_types.insert_last(vehicle_type("Motorbike",520,0,1,17.5,5.4,7.5,bike_win));

bool[] plane_win = {true, true, true, true};
vehicle_types.insert_last(vehicle_type("Duo Plane",5000,500,4,13.3,3.5,4.5,plane_win));
}

string vehicle_setting(const string &in text,const string &in key,const string &in fallback="")
{string[] lines=string_split(string_replace(text,"\r","",true),"\n",false);for(uint i=0;i<lines.length();i++){int eq=lines[i].find("=");if(eq>0 and lines[i].substr(0,eq).trim_whitespace()==key)return lines[i].substr(eq+1).trim_whitespace();}return fallback;}
void load_vehicle_content_blob(const string &in blob)
{
string[] records=string_split(blob,"\x1e",false);if(records.length()==0)return;vehicle_type@[] loaded;int[] loaded_order;
for(uint i=0;i<records.length();i++)
{
int sep=records[i].find("\x1f");if(sep<=0)continue;string text=records[i].substr(sep+1),display=vehicle_setting(text,"name");int seats=int(string_to_number(vehicle_setting(text,"seats","1")));if(display=="" or seats<1 or seats>32)continue;
string[] window_values=string_split(vehicle_setting(text,"windows","false"),",",false);bool[] windows;for(int s=0;s<seats;s++)windows.insert_last(s<int(window_values.length()) and window_values[s].trim_whitespace().lower()=="true");
vehicle_type@ v=vehicle_type(display,int(string_to_number(vehicle_setting(text,"health","500"))),int(string_to_number(vehicle_setting(text,"armour","0"))),seats,string_to_number(vehicle_setting(text,"top_speed","8")),string_to_number(vehicle_setting(text,"acceleration","2")),string_to_number(vehicle_setting(text,"braking","4")),windows);
v.fuel_type=vehicle_setting(text,"fuel_type",v.fuel_type);v.fuel_capacity=string_to_number(vehicle_setting(text,"fuel_capacity","70"));v.fuel_per_tile=string_to_number(vehicle_setting(text,"fuel_per_tile","0.11"));
v.vehicle_class=vehicle_setting(text,"class","ground");v.travel_domain=vehicle_setting(text,"travel_domain",v.vehicle_class=="water"?"water":(v.vehicle_class=="amphibious"?"amphibious":"land"));v.body_length=string_to_number(vehicle_setting(text,"length","6"));v.body_width=string_to_number(vehicle_setting(text,"width","4"));v.body_height=string_to_number(vehicle_setting(text,"height","3"));v.cargo_kind=vehicle_setting(text,"cargo_kind","none");v.cargo_capacity=int(string_to_number(vehicle_setting(text,"cargo_capacity","0")));
v.transmission=vehicle_setting(text,"transmission","automatic");v.gears=int(string_to_number(vehicle_setting(text,"gears","0")));v.turning_radius=string_to_number(vehicle_setting(text,"turning_radius","0"));v.reverse_speed=string_to_number(vehicle_setting(text,"reverse_speed",v.vehicle_class=="fixed_wing"?"0":"2.5"));v.pivot_turn=vehicle_setting(text,"pivot_turn","false")=="true";
string[] roles=string_split(vehicle_setting(text,"seat_roles",""),",",false),guns=string_split(vehicle_setting(text,"seat_weapons",""),",",false);for(int s=0;s<seats;s++){v.seat_roles[s]=s<int(roles.length()) and roles[s].trim_whitespace()!=""?roles[s].trim_whitespace():(s==0?"driver":"passenger");v.seat_weapons[s]=s<int(guns.length())?guns[s].trim_whitespace():"";}
int order=int(string_to_number(vehicle_setting(text,"order","999"))),at=int(loaded_order.length());for(uint oi=0;oi<loaded_order.length();oi++)if(order<loaded_order[oi]){at=int(oi);break;}loaded.insert_at(at,v);loaded_order.insert_at(at,order);
}
if(loaded.length()>0)vehicle_types=loaded;
}

// A vehicle instance on the map.
class vehicle
{
int id=-1;               // the server's id for it on this map
int map_element_id=-1;
int type_index;
int x;
int y;
int z;
int health;
int armor;
double facing; // direction vehicle faces
bool door_open;
bool destroyed;
double observed_velocity;
double px=0,py=0; // exact position; x and y are the tile it occupies
string[] passengers; // player names in seats, "" = empty
bool[] window_down; // per seat
string[] cargo_items;
int[] cargo_counts;
timer idle_timer; // for cleanup
timer emp_timer;int emp_ms=0;
double fuel;
int engine_condition=100,transmission_condition=100,tire_condition=100,cooling_condition=100,fuel_contamination=0;
bool performance_tune=false,offroad_tires=false,reinforced_suspension=false,auxiliary_armor=false,turbocharger=false,extended_tank=false;
vehicle() {}
vehicle(int ti,double ax,double ay,int az,double heading)
{
type_index=ti;
place(ax,ay,az,heading);
health=vehicle_types[ti].max_health;
armor=vehicle_types[ti].armor;
door_open=vehicle_types[ti].name=="Motorbike";
destroyed=false;
observed_velocity=0;
fuel=vehicle_types[ti].fuel_capacity*.65;
passengers.resize(vehicle_types[ti].max_passengers);
window_down.resize(vehicle_types[ti].max_passengers);
for(int i=0;i<vehicle_types[ti].max_passengers;i++){passengers[i]="";window_down[i]=false;}
}
void place(double ax,double ay,int az,double heading){px=ax;py=ay;x=int(round(ax,0));y=int(round(ay,0));z=az;facing=heading;}
bool emp_active(){return emp_ms>0 and emp_timer.elapsed<uint(emp_ms);}
double vehicle_effective_top_speed(vehicle@ v){double value=v.get_top_speed();value*=.55+.45*double(v.engine_condition)/100.0;value*=.7+.3*double(v.transmission_condition)/100.0;if(v.performance_tune)value*=1.08;if(v.turbocharger)value*=1.12;if(v.auxiliary_armor)value*=.92;if(v.fuel_contamination>0)value*=1.0-double(v.fuel_contamination)/180.0;return value;}
double vehicle_effective_capacity(vehicle@ v){return vehicle_types[v.type_index].fuel_capacity*(v.extended_tank?1.35:1.0);}
string vehicle_condition_report(vehicle@ v){vehicle_type@ t=vehicle_types[v.type_index];return v.get_name()+". Health "+v.health+" of "+t.max_health+", armour "+v.armor+" of "+t.armor+". Fuel "+round(v.fuel,1)+" of "+round(vehicle_effective_capacity(v),1)+" litres of "+t.fuel_type+". Engine "+v.engine_condition+" percent, transmission "+v.transmission_condition+" percent, tyres "+v.tire_condition+" percent, cooling system "+v.cooling_condition+" percent, fuel contamination "+v.fuel_contamination+" percent. Effective top speed "+round(vehicle_effective_top_speed(v),1)+". Modifications: "+(v.performance_tune?"performance tune, ":"")+(v.offroad_tires?"off-road tyres, ":"")+(v.reinforced_suspension?"reinforced suspension, ":"")+(v.auxiliary_armor?"auxiliary armour, ":"")+(v.turbocharger?"turbocharger, ":"")+(v.extended_tank?"extended fuel tank.":"standard configuration.");}
int vehicle_cargo_used(vehicle@ v){int used=0;for(uint i=0;i<v.cargo_counts.length();i++)used+=v.cargo_counts[i];return used;}
string vehicle_cargo_item_name(string id){for(uint i=0;i<item_catalogue.length();i++)if(item_catalogue[i].id==id)return item_catalogue[i].name;return string_replace(id,"_"," ",true);}
void vehicle_cargo_panel(vehicle@ v)
{
vehicle_type@ t=vehicle_types[v.type_index];if(t.cargo_capacity<=0){speak("This vehicle has no usable cargo storage.");return;}while(true){nv_form f;f.create_window(v.get_name()+" "+t.cargo_kind,false,true);nv_form_input@ status=f.add_input("Storage usage","status",vehicle_cargo_used(v)+" of "+t.cargo_capacity+" item units used.","",0,true,true);nv_form_list_box@ stored=f.add_list("Stored items","stored");for(uint i=0;i<v.cargo_items.length();i++)stored.add(vehicle_cargo_item_name(v.cargo_items[i])+", "+v.cargo_counts[i],v.cargo_items[i]);if(v.cargo_items.length()==0)stored.add("Storage is empty","");nv_form_list_box@ carried=f.add_list("Items you can store","carried");for(uint i=0;i<item_catalogue.length();i++){string id=item_catalogue[i].id;int count=get_item_count(id);if(count>0)carried.add(item_catalogue[i].name+", "+count,id);}if(carried.items.length()==0)carried.add("You are carrying nothing eligible","");nv_form_button@ store=f.add_button("Store one selected carried item","store",true);nv_form_button@ take=f.add_button("Take one selected stored item","take");nv_form_button@ close=f.add_button("Close cargo storage","close",false,true);f.focus_control(stored);while(true){wait(5);f.monitor();if(connected)netloop();if(f.is_pressed(close))return;if(f.is_pressed(store)){string id=carried.focused_item_id;if(id=="")continue;if(vehicle_cargo_used(v)>=t.cargo_capacity){speak("The "+t.cargo_kind+" is full.");continue;}give(id,-1);int at=v.cargo_items.find(id);if(at<0){v.cargo_items.insert_last(id);v.cargo_counts.insert_last(1);}else v.cargo_counts[at]++;p.play_stationary("executioners_rage/collectable/drop_item.wav",false);break;}if(f.is_pressed(take)){string id=stored.focused_item_id;if(id=="")continue;int at=v.cargo_items.find(id);if(at<0)continue;give(id,1);v.cargo_counts[at]--;if(v.cargo_counts[at]<=0){v.cargo_items.remove_at(at);v.cargo_counts.remove_at(at);}p.play_stationary("executioners_rage/collectable/pickup_misc.wav",false);break;}}
}}
string vehicle_supply_sound(string item){if(item=="gasoline_can" or item=="diesel_can" or item=="aviation_fuel_can")return "watertankactivate.ogg";if(item=="engine_oil" or item=="transmission_fluid" or item=="engine_coolant" or item=="fuel_system_flush")return "watertankfill.ogg";if(item=="tire_patch_kit")return "armor_repair.ogg";if(item=="vehicle_performance_ecu")return "attachment_laser_aiming_module_attach.ogg";if(item=="offroad_tire_set")return "attachment_drum_magazine_attach.ogg";if(item=="reinforced_suspension_kit")return "attachment_heavy_barrel_attach.ogg";if(item=="vehicle_auxiliary_armor")return "attachment_precision_stock_attach.ogg";if(item=="vehicle_turbocharger")return "attachment_compensator_attach.ogg";if(item=="extended_fuel_tank")return "attachment_extended_magazine_attach.ogg";return "nanomatic_multitooluse.ogg";}
void vehicle_consume_item(string item){give(item,-1);p.play_stationary(vehicle_supply_sound(item),false);}
void vehicle_service_panel(int px,int py,int pz)
{
int vi=in_vehicle?player_vehicle_index:find_nearest_vehicle(px,py,pz,5);if(vi<0){speak("No vehicle is close enough to inspect.");return;}vehicle@ v=map_vehicles[vi];
while(true){nv_form f;f.create_window("Vehicle Workshop: "+v.get_name(),false,true);nv_form_input@ status=f.add_input("Live vehicle statistics","status",vehicle_condition_report(v),"",0,true,true);nv_form_list_box@ actions=f.add_list("Available service and customization operations","actions");string[] ids;
string[] labels={"Open "+vehicle_types[v.type_index].cargo_kind+" storage","Refuel with gasoline","Refuel with diesel","Refuel with aviation fuel","Siphon ten litres of fuel","Change oil and service engine","Service transmission","Patch tyres","Service cooling system","Drain and flush contaminated fuel","Install performance tune","Install off-road tyre set","Install reinforced suspension","Install auxiliary armour kit","Install turbocharger","Install extended fuel tank"};string[] allids={"cargo","gasoline","diesel","aviation","siphon","engine","transmission","tires","cooling","flush","tune","offroad","suspension","armor","turbo","tank"};for(uint i=0;i<labels.length();i++){if(allids[i]=="cargo" and vehicle_types[v.type_index].cargo_capacity<=0)continue;actions.add(labels[i],allids[i]);ids.insert_last(allids[i]);}nv_form_button@ perform=f.add_button("Perform selected operation","perform",true);nv_form_button@ close=f.add_button("Close","close",false,true);f.focus_control(actions);bool refresh=false;while(true){wait(5);f.monitor();if(connected)netloop();if(f.is_pressed(close))return;if(!f.is_pressed(perform))continue;int pos=actions.list_position;if(pos<0)continue;string op=ids[pos],needed="";int duration=6000;if(op=="cargo"){vehicle_cargo_panel(v);refresh=true;break;}
if(op=="gasoline" or op=="diesel" or op=="aviation"){needed=op=="gasoline"?"gasoline_can":(op=="diesel"?"diesel_can":"aviation_fuel_can");if(get_item_count(needed)<=0){speak("You need a "+string_replace(needed,"_"," ",true)+".");continue;}string supplied=op=="aviation"?"aviation fuel":op;if(supplied!=vehicle_types[v.type_index].fuel_type){v.fuel_contamination+=35;if(v.fuel_contamination>100)v.fuel_contamination=100;v.engine_condition-=random(8,20);if(v.engine_condition<0)v.engine_condition=0;speak("That is the wrong fuel. The engine runs roughly and the fuel system is now contaminated.");}v.fuel+=20;if(v.fuel>vehicle_effective_capacity(v))v.fuel=vehicle_effective_capacity(v);vehicle_consume_item(needed);refresh=true;break;}
if(op=="siphon"){if(get_item_count("vehicle_siphon_hose")<=0 or get_item_count("empty_fuel_can")<=0 or v.fuel<10){speak("Siphoning requires a siphon hose, an empty fuel can, and at least ten litres in the vehicle.");continue;}v.fuel-=10;give("empty_fuel_can",-1);give(vehicle_types[v.type_index].fuel_type=="gasoline"?"gasoline_can":(vehicle_types[v.type_index].fuel_type=="diesel"?"diesel_can":"aviation_fuel_can"),1);p.play_stationary("watertankfill.ogg",false);refresh=true;break;}
if(op=="engine"){needed="vehicle_engine_service_kit";if(get_item_count(needed)<=0 or get_item_count("engine_oil")<=0 or get_item_count("vehicle_oil_filter")<=0){speak("Engine service requires an engine service kit, engine oil, and an oil filter.");continue;}vehicle_consume_item("engine_oil");vehicle_consume_item("vehicle_oil_filter");v.engine_condition+=18;if(v.engine_condition>100)v.engine_condition=100;duration=12000;}
else if(op=="transmission"){needed="vehicle_transmission_tool";if(get_item_count(needed)<=0 or get_item_count("transmission_fluid")<=0){speak("Transmission service requires the transmission tool and fluid.");continue;}vehicle_consume_item("transmission_fluid");v.transmission_condition+=15;if(v.transmission_condition>100)v.transmission_condition=100;duration=14000;}
else if(op=="tires"){needed="vehicle_jack";if(get_item_count(needed)<=0 or get_item_count("tire_patch_kit")<=0){speak("Tyre work requires a vehicle jack and tyre patch kit.");continue;}vehicle_consume_item("tire_patch_kit");v.tire_condition+=12;if(v.tire_condition>85)v.tire_condition=85;}
else if(op=="cooling"){needed="cooling_system_tester";if(get_item_count(needed)<=0 or get_item_count("engine_coolant")<=0){speak("Cooling service requires a tester and engine coolant.");continue;}vehicle_consume_item("engine_coolant");v.cooling_condition+=18;if(v.cooling_condition>100)v.cooling_condition=100;}
else if(op=="flush"){needed="fuel_drain_pan";if(get_item_count(needed)<=0 or get_item_count("fuel_system_flush")<=0){speak("A drain pan and fuel-system flush are required.");continue;}vehicle_consume_item("fuel_system_flush");v.fuel=0;v.fuel_contamination-=60;if(v.fuel_contamination<0)v.fuel_contamination=0;duration=16000;}
else {string mod=op=="tune"?"vehicle_performance_ecu":op=="offroad"?"offroad_tire_set":op=="suspension"?"reinforced_suspension_kit":op=="armor"?"vehicle_auxiliary_armor":op=="turbo"?"vehicle_turbocharger":"extended_fuel_tank";if(get_item_count(mod)<=0){speak("You need "+string_replace(mod,"_"," ",true)+".");continue;}vehicle_consume_item(mod);if(op=="tune")v.performance_tune=true;else if(op=="offroad")v.offroad_tires=true;else if(op=="suspension")v.reinforced_suspension=true;else if(op=="armor"){v.auxiliary_armor=true;v.armor+=250;}else if(op=="turbo")v.turbocharger=true;else v.extended_tank=true;duration=18000;}
bool oldmove=can_move;can_move=false;p.play_stationary("nanomatic_multitooluse.ogg",false);speak("Beginning vehicle work. "+duration/1000+" seconds.");timer work;while(work.elapsed<duration){wait(5);if(connected)netloop();}can_move=oldmove;p.play_stationary("attachment_recoil_buffer_stock_attach.ogg",false);speak("Vehicle operation complete.");refresh=true;break;}if(!refresh)return;}
}
string get_name()
{
return vehicle_types[type_index].name;
}
double get_top_speed()
{
return vehicle_types[type_index].top_speed;
}
int get_max_passengers()
{
return vehicle_types[type_index].max_passengers;
}
bool has_seat_window(int seat)
{
if (seat < 0 or seat >= int(vehicle_types[type_index].seat_has_window.length()))
return false;
return vehicle_types[type_index].seat_has_window[seat];
}
int count_occupants()
{
int c = 0;
for (int i = 0; i < int(passengers.length()); i++)
{
if (passengers[i] != "") c++;
}
return c;
}
bool is_full()
{
return count_occupants() >= get_max_passengers();
}
int find_empty_seat()
{
for (int i = 0; i < int(passengers.length()); i++)
{
if (passengers[i] == "") return i;
}
return -1;
}
int find_player_seat(string pname)
{
for (int i = 0; i < int(passengers.length()); i++)
{
if (passengers[i] == pname) return i;
}
return -1;
}
string seat_label(int seat)
{
string gun=seat>=0 and seat<int(vehicle_types[type_index].seat_weapons.length())?vehicle_types[type_index].seat_weapons[seat]:"";
if(gun!="" and seat<int(vehicle_types[type_index].seat_roles.length()))return vehicle_types[type_index].seat_roles[seat]+" seat, operating the "+get_weapon_display_name(gun)+"; Control fires it";
if(seat>=0 and seat<int(vehicle_types[type_index].seat_roles.length()))return vehicle_types[type_index].seat_roles[seat]+" seat";
return seat==0?"driver's seat":"passenger seat "+seat;
}
}

vehicle@[] map_vehicles;
int player_vehicle_index = -1; // index into map_vehicles, -1 = not in vehicle
int player_seat = -1;
bool in_vehicle = false;
string last_vehicle_zone="";
timer vehicle_move_timer;
timer vehicle_stamina_timer;
double vehicle_current_velocity=0; // tiles per second
double vehicle_target_velocity=0; // driver-selected cruise target
timer vehicle_accel_timer;
timer vehicle_decel_timer;
bool vehicle_decelerating = false;
int vehicle_roof_index = -1;
double vehicle_roof_last_x = 0;
double vehicle_roof_last_y = 0;
int vehicle_roof_last_z = 0;
double vehicle_roof_local_forward=0,vehicle_roof_local_side=0;

void vehicle_dimensions(vehicle@ v,double &out length,double &out width,double &out height)
{
vehicle_type@ t=vehicle_types[v.type_index];length=t.body_length;width=t.body_width;height=t.body_height;
}
// A point in the vehicle's own frame: forward along its facing, side to its right.
void vehicle_local_position(vehicle@ v,double wx,double wy,double &out forward,double &out side){double rad=v.facing*3.14159265358979323846/180.0,dx=wx-v.px,dy=wy-v.py;forward=dx*sine(rad)+dy*cosine(rad);side=dx*cosine(rad)-dy*sine(rad);}
void vehicle_world_position(vehicle@ v,double forward,double side,double &out wx,double &out wy){double rad=v.facing*3.14159265358979323846/180.0;wx=v.px+sine(rad)*forward+cosine(rad)*side;wy=v.py+cosine(rad)*forward-sine(rad)*side;}
bool vehicle_contains_position(vehicle@ v,double wx,double wy,double wz,double margin=0){double length,width,height,forward,side;vehicle_dimensions(v,length,width,height);vehicle_local_position(v,wx,wy,forward,side);return absolute(forward)<=length*.5+margin and absolute(side)<=width*.5+margin and wz>=v.z and wz<=v.z+height;}
// Distance from a point to the hull on the ground plane: zero on or inside it.
double vehicle_hull_distance(vehicle@ v,double wx,double wy){double length,width,height,forward,side;vehicle_dimensions(v,length,width,height);vehicle_local_position(v,wx,wy,forward,side);double ox=absolute(forward)-length*.5,oy=absolute(side)-width*.5;if(ox<0)ox=0;if(oy<0)oy=0;return sqrt(ox*ox+oy*oy);}
// Whether a vehicle has a cabin you sit inside, rather than on.
bool vehicle_open_seated(vehicle@ v){string c=vehicle_types[v.type_index].vehicle_class;return c=="motorcycle" or c=="atv" or v.get_name()=="Personal Watercraft";}
// Inside a closed cabin, for acoustics: the hull with its doors shut.
bool vehicle_cabin_contains_position(vehicle@ v,double wx,double wy,double wz,double margin=0){return !vehicle_open_seated(v) and !v.door_open and vehicle_contains_position(v,wx,wy,wz,-margin);}
bool vehicle_is_roof_position(vehicle@ v,double wx,double wy,double wz){double length,width,height,forward,side;vehicle_dimensions(v,length,width,height);vehicle_local_position(v,wx,wy,forward,side);return absolute(forward)<=length*.5 and absolute(side)<=width*.5 and wz>=v.z+height-.25 and wz<=v.z+height+.65;}
string vehicle_zone_at(vehicle@ v,double wx,double wy,double wz){double length,width,height,forward,side;vehicle_dimensions(v,length,width,height);vehicle_local_position(v,wx,wy,forward,side);if(vehicle_is_roof_position(v,wx,wy,wz))return "on the roof";if(absolute(forward)<=length*.5 and absolute(side)<=width*.5)return "under the vehicle";if(forward>length*.5 and absolute(side)<=width*.75)return "in front of the engine";if(forward<length*-.5 and absolute(side)<=width*.75)return "behind the vehicle";return side<0?"along the left side":"along the right side";}
void vehicle_seat_local_position(vehicle@ v,int seat,double &out forward,double &out side,double &out height){double length,width,h;vehicle_dimensions(v,length,width,h);int row=seat/2;forward=length*.27-double(row)*1.35;if(forward<-length*.45)forward=-length*.45;side=(seat%2==0?-.22:.22)*width;height=.5;}
void vehicle_seat_world_position(vehicle@ v,int seat,double &out sx,double &out sy,double &out sz){double lf,ls,lz;vehicle_seat_local_position(v,seat,lf,ls,lz);vehicle_world_position(v,lf,ls,sx,sy);sz=v.z+lz;}

void ensure_vehicle_map_element(vehicle@ v,int owner)
{
if(v.map_element_id>=0 and v.map_element_id<int(dynamic_map_elements.length()) and dynamic_map_elements[v.map_element_id].active){dynamic_map_move(v.map_element_id,v.px,v.py,v.z,v.facing);return;}
v.map_element_id=dynamic_map_create("vehicle",v.get_name(),owner,v.px,v.py,v.z,v.facing);
dynamic_map_element@ e=dynamic_map_elements[v.map_element_id];double length,width,height;vehicle_dimensions(v,length,width,height);
if(vehicle_open_seated(v)){e.add_tile(-length*.5,length*.5,-width*.42,width*.42,-.12,.14,"metal5","chassis",false);e.add_tile(-.35,.35,-.42,.42,.05,.82,"carpet1","at the saddle",false);e.add_tile(length*.5,length*.5+1,-.8,.8,-.2,1.2,"","in front of the handlebars",false);e.add_tile(-length*.5-1,-length*.5,-.8,.8,-.2,1.2,"","behind the rear wheel",false);e.add_tile(-length*.5,length*.5,-1.1,-width*.42,-.2,1.2,"","along the left side",false);e.add_tile(-length*.5,length*.5,width*.42,1.1,-.2,1.2,"","along the right side",false);return;}
e.add_tile(-length*.5,length*.5,-width*.5,width*.5,-.12,.18,"metal5",v.get_name()+" chassis",false);
e.add_tile(-length*.48,length*.48,-width*.48,width*.48,.18,height-.2,"wallmetal",v.get_name()+" body",true);
e.add_tile(-length*.42,length*.42,-width*.36,width*.36,height-.2,height,"metal4","roof of "+v.get_name(),true);
// Non-solid local zones move and rotate with the vehicle. They sit after the
// collision geometry so zone lookup sees the specific region while tile and
// solidity lookup still use the physical hull underneath.
e.add_tile(length*.5,length*.5+1.25,-width*.65,width*.65,-.2,height*.75,"","in front of the hood",false);
e.add_tile(-length*.5-1.25,-length*.5,-width*.65,width*.65,-.2,height*.75,"","behind the rear",false);
e.add_tile(-length*.5,length*.5,-width*.5-1.25,-width*.5,-.2,height*.8,"","along the left side",false);
e.add_tile(-length*.5,length*.5,width*.5,width*.5+1.25,-.2,height*.8,"","along the right side",false);
e.add_tile(length*.08,length*.48,-width*.38,width*.38,height*.55,height-.21,"","on the hood",false);
e.add_tile(-length*.42,length*.42,-width*.36,width*.36,height-.2,height+.7,"","on the roof",false);
}

// Whether the vehicle's hull fits at a position and facing: every half metre
// of its footprint is on ground, out of walls and map objects, and clear of
// the other vehicles.
bool vehicle_footprint_clear(vehicle@ v,double cx,double cy,int cz,double heading)
{
double length,width,height,rad=heading*3.14159265358979323846/180.0;vehicle_dimensions(v,length,width,height);
for(double forward=-length*.45;forward<=length*.45+.01;forward+=.5)for(double side=-width*.45;side<=width*.45+.01;side+=.5)
{
double wx=cx+sine(rad)*forward+cosine(rad)*side,wy=cy+cosine(rad)*forward-sine(rad)*side;
if(wx<0 or wy<0 or wx>max.x or wy>max.y)return false;
string ground=get_static_tile_at(round(wx,0),round(wy,0),cz);if(ground=="" or ground=="blank" or string_contains(ground,"wall",1)>-1)return false;
if(client_dobjects.solid_at(wx,wy,cz+.5))return false;
for(uint i=0;i<map_vehicles.length();i++){vehicle@ o=map_vehicles[i];if(o is v or o.destroyed or absolute(o.z-cz)>1)continue;if(vehicle_contains_position(o,wx,wy,o.z+.5))return false;}
}
return true;
}

string vehicle_audio_id_from_name(string vehicle_name)
{
string n=string_to_lower_case(vehicle_name);
if(n=="pickup truck") return "pickup";
return string_replace(n," ","",true);
}

string vehicle_audio_id(vehicle@ v)
{
return vehicle_audio_id_from_name(v.get_name());
}

void play_vehicle_audio(vehicle@ v, string action)
{
if(v.get_name()=="Motorbike")
{
string cue="";if(action=="enter")cue="pickup";else if(action=="exit" or action=="stop")cue="stopend";else if(action=="start")cue="stopstart";else if(action=="engine")cue="loop";else if(action=="accelerate")cue=vehicle_target_velocity>v.vehicle_effective_top_speed(v)*.7?"highspeed":"accel";else if(action=="decelerate")cue="decel";else if(action=="turn")cue=vehicle_target_velocity<=.05?"stoploop":"loop";else if(action=="horn")cue="horn";else if(action=="crash" or action=="destroy")cue=vehicle_current_velocity>v.vehicle_effective_top_speed(v)*.45?"crash_heavy":"crash_lite";if(cue!="")p.play_stationary("executioners_rage/vehicles/bike/"+cue+".wav",false);return;
}
if (v.get_name()=="Duo Plane")
{
string cue="";
if (action=="enter" or action=="door_open" or action=="start") cue="duoplanein.ogg";
else if (action=="exit" or action=="door_close" or action=="stop") cue="duoplaneout.ogg";
else if (action=="crash" or action=="destroy") cue="duoplanecrash.ogg";
else if(action=="turn")cue="vehicle_apc_turn.ogg";
else if(action=="accelerate")cue="modeenter.ogg";
else if(action=="decelerate")cue="modeleave.ogg";
if(cue!="")p.play_stationary(cue, false);
return;
}
p.play_stationary("vehicle_"+vehicle_audio_id(v)+"_"+action+".ogg", false);
}
// The same cue, but placed where the vehicle is, for people outside it.
void play_vehicle_audio_at(vehicle@ v,string action)
{
if(in_vehicle and player_vehicle_index>=0 and map_vehicles[player_vehicle_index] is v){play_vehicle_audio(v,action);return;}
if(v.get_name()=="Motorbike" or v.get_name()=="Duo Plane")return;
p.play_3d("vehicle_"+vehicle_audio_id(v)+"_"+action+".ogg",me.x,me.y,me.z,v.px,v.py,v.z,calculate_theta(facing),false);
}

// Leaving a map: forget its vehicles and their collision, but nothing else on
// the dynamic map (the old version emptied every dynamic element, map
// objects included).
void reset_vehicles()
{
map_vehicles.resize(0);
dynamic_map_destroy_kind("vehicle");
player_vehicle_index = -1;
player_seat = -1;
in_vehicle = false;
vehicle_current_velocity=0;
vehicle_target_velocity=0;
vehicle_decelerating = false;
vehicle_roof_index = -1;
}

int vehicle_index_by_id(int id){for(uint i=0;i<map_vehicles.length();i++)if(map_vehicles[i].id==id)return int(i);return -1;}
int vehicle_type_by_key(string key){if(vehicle_types.length()==0)init_vehicle_types();for(uint i=0;i<vehicle_types.length();i++)if(vehicle_audio_id_from_name(vehicle_types[i].name)==key)return int(i);return -1;}
vehicle@ my_vehicle(){return in_vehicle and player_vehicle_index>=0 and player_vehicle_index<int(map_vehicles.length())?map_vehicles[player_vehicle_index]:null;}
string vehicle_decode(string value){return string_replace(value,"%20"," ",true);}

// Keeps you in your seat as the vehicle you are in moves.
void vehicle_follow_seat(vehicle@ v)
{
double sx,sy,sz;vehicle_seat_world_position(v,player_seat,sx,sy,sz);
me.x=sx;me.y=sy;me.z=sz;mr.x=round(me.x,0);mr.y=round(me.y,0);
}
void vehicle_take_seat(vehicle@ v,int seat)
{
bool was_empty=v.count_occupants()==0;
player_vehicle_index=vehicle_index_by_id(v.id);player_seat=seat;in_vehicle=true;
vehicle_current_velocity=0;vehicle_target_velocity=0;vehicle_decelerating=false;
vehicle_move_timer.restart();vehicle_stamina_timer.restart();vehicle_accel_timer.restart();vehicle_net_timer.restart();
vehicle_gear=1;vehicle_throttle=false;vehicle_brake=false;vehicle_prev_throttle=false;vehicle_prev_brake=false;vehicle_steer=0;vehicle_reverse_hold=false;driver_distracted=false;
vehicle_sent_facing=v.facing;vehicle_roof_index=-1;
for(uint s=0;s<v.passengers.length();s++)if(v.passengers[s]==name)v.passengers[s]="";
v.passengers[seat]=name;
vehicle_follow_seat(v);send_reliable(1,"move_to "+mr.x+" "+mr.y+" "+me.z,0);
if(!vehicle_open_seated(v)){play_vehicle_audio(v,"door_open");play_vehicle_audio(v,"door_close");}
play_vehicle_audio(v,"enter");
if(was_empty)play_vehicle_audio(v,"start");
speak("In the "+v.get_name()+", "+v.seat_label(seat)+"."+(seat==0?" "+vehicle_driving_hint(v):""));
}
void vehicle_let_go(bool announce)
{
vehicle@ v=my_vehicle();
if(v !is null){int seat=v.find_player_seat(name);if(seat>=0){v.passengers[seat]="";v.window_down[seat]=false;}}
player_vehicle_index=-1;player_seat=-1;in_vehicle=false;
vehicle_current_velocity=0;vehicle_target_velocity=0;vehicle_decelerating=false;
}

// What the server says about vehicles. Returns false for other packets.
bool handle_vehicle_packet(const string[] &in parsed)
{
if(parsed.length()==0 or parsed[0].find("veh_")!=0)return false;
string kind=parsed[0];
if(kind=="veh_state" and parsed.length()>12)
{
if(vehicle_decode(parsed[1])!=mapname)return true;
int id=int(string_to_number(parsed[2])),ti=vehicle_type_by_key(parsed[3]);if(ti<0)return true;
int vi=vehicle_index_by_id(id);
double x=string_to_number(parsed[4]),y=string_to_number(parsed[5]),heading=string_to_number(parsed[7]);int z=int(string_to_number(parsed[6]));
if(vi<0){map_vehicles.insert_last(vehicle(ti,x,y,z,heading));vi=int(map_vehicles.length())-1;map_vehicles[vi].id=id;}
vehicle@ v=map_vehicles[vi];
bool mine=in_vehicle and player_vehicle_index==vi and player_seat==0;
// The server only sends a driver their own state to put them back.
if(mine){vehicle_current_velocity=0;}
v.place(x,y,z,heading);
v.health=int(string_to_number(parsed[8]));v.armor=int(string_to_number(parsed[9]));v.door_open=parsed[10]=="1";
int flags=int(string_to_number(parsed[11]));v.destroyed=(flags&1)!=0;
string[] seats=string_split(parsed[12],",",false);
for(uint s=0;s<v.passengers.length();s++)v.passengers[s]=s<seats.length() and seats[s]!="-"?seats[s]:"";
if(v.destroyed)dynamic_map_destroy(v.map_element_id);else ensure_vehicle_map_element(v,vi);
if(in_vehicle and player_vehicle_index==vi)vehicle_follow_seat(v);
return true;
}
if(kind=="veh_sync" and parsed.length()>7)
{
if(vehicle_decode(parsed[1])!=mapname)return true;
int vi=vehicle_index_by_id(int(string_to_number(parsed[2])));if(vi<0)return true;
vehicle@ v=map_vehicles[vi];
if(in_vehicle and player_vehicle_index==vi and player_seat==0)return true;
v.place(string_to_number(parsed[3]),string_to_number(parsed[4]),int(string_to_number(parsed[5])),string_to_number(parsed[6]));
v.observed_velocity=string_to_number(parsed[7]);
ensure_vehicle_map_element(v,vi);
if(in_vehicle and player_vehicle_index==vi)vehicle_follow_seat(v);
return true;
}
if(kind=="veh_remove" and parsed.length()>2)
{
if(vehicle_decode(parsed[1])!=mapname)return true;
int vi=vehicle_index_by_id(int(string_to_number(parsed[2])));if(vi<0)return true;
if(in_vehicle and player_vehicle_index==vi)vehicle_let_go(false);
dynamic_map_destroy(map_vehicles[vi].map_element_id);map_vehicles.remove_at(vi);
// Indices after it have moved down.
if(in_vehicle and player_vehicle_index>vi)player_vehicle_index--;
if(vehicle_roof_index==vi)vehicle_roof_index=-1;else if(vehicle_roof_index>vi)vehicle_roof_index--;
return true;
}
if(kind=="veh_occupant" and parsed.length()>4)
{
if(vehicle_decode(parsed[1])!=mapname)return true;
int vi=vehicle_index_by_id(int(string_to_number(parsed[2])));if(vi<0)return true;
vehicle@ v=map_vehicles[vi];int seat=int(string_to_number(parsed[3]));if(seat<0 or seat>=int(v.passengers.length()))return true;
string who=parsed[4]=="-"?"":parsed[4];
// The server took your seat away (you were thrown out, or it was wrecked).
if(who=="" and in_vehicle and player_vehicle_index==vi and player_seat==seat and v.passengers[seat]==name){v.passengers[seat]="";vehicle_let_go(false);return true;}
v.passengers[seat]=who;
return true;
}
if(kind=="veh_entered" and parsed.length()>3)
{
if(vehicle_decode(parsed[1])!=mapname)return true;
int vi=vehicle_index_by_id(int(string_to_number(parsed[2])));if(vi<0)return true;
vehicle@ v=map_vehicles[vi];int seat=int(string_to_number(parsed[3]));
if(in_vehicle and player_vehicle_index==vi)
{
// A change of seat.
int old=v.find_player_seat(name);if(old>=0){if(v.window_down[old])play_vehicle_audio(v,"window_close");v.window_down[old]=false;v.passengers[old]="";}
v.passengers[seat]=name;player_seat=seat;vehicle_follow_seat(v);play_vehicle_audio(v,"seat_switch");speak(v.seat_label(seat)+".");
}
else vehicle_take_seat(v,seat);
return true;
}
if(kind=="veh_refused" and parsed.length()>1)
{
string message=parsed[1];for(uint i=2;i<parsed.length();i++)message+=" "+parsed[i];
speak(message);return true;
}
if(kind=="veh_door_sync" and parsed.length()>3)
{
int vi=vehicle_index_by_id(int(string_to_number(parsed[1])));if(parsed[3]!=mapname or vi<0)return true;
vehicle@ v=map_vehicles[vi];bool open=parsed[2]=="1";if(v.door_open!=open){v.door_open=open;play_vehicle_audio_at(v,open?"door_open":"door_close");}
return true;
}
if(kind=="veh_damage" and parsed.length()>5)
{
int vi=vehicle_index_by_id(int(string_to_number(parsed[1])));if(parsed[3]!=mapname or vi<0)return true;
vehicle@ v=map_vehicles[vi];v.health=int(string_to_number(parsed[4]));v.armor=int(string_to_number(parsed[5]));
if(in_vehicle and player_vehicle_index==vi and string_to_number(parsed[2])>0)speak("Vehicle hit! "+v.health+" health left.");
return true;
}
if(kind=="veh_destroyed" and parsed.length()>2)
{
int vi=vehicle_index_by_id(int(string_to_number(parsed[1])));if(parsed[2]!=mapname or vi<0)return true;
if(!map_vehicles[vi].destroyed){map_vehicles[vi].destroyed=true;map_vehicles[vi].health=0;vehicle_on_destroy(vi);}
return true;
}
if(kind=="veh_emp" and parsed.length()>3)
{
int vi=vehicle_index_by_id(int(string_to_number(parsed[1])));if(parsed[3]!=mapname or vi<0)return true;
vehicle@ v=map_vehicles[vi];v.emp_ms=int(string_to_number(parsed[2]));v.emp_timer.restart();
if(in_vehicle and player_vehicle_index==vi){vehicle_current_velocity=0;p.play_stationary("executioners_rage/environment/objects/tv/off.wav",false);speak("An electromagnetic pulse kills the "+v.get_name()+"'s engine and electrics for "+(v.emp_ms/1000)+" seconds.");}
return true;
}
return false;
}

bool current_vehicle_can_fly()
{
return in_vehicle and player_vehicle_index>=0 and player_vehicle_index<int(map_vehicles.length()) and vehicle_types[map_vehicles[player_vehicle_index].type_index].travel_domain=="air";
}

void vehicle_change_altitude(int direction)
{
if (!current_vehicle_can_fly()) return;
if (player_seat!=0) { speak("Only the pilot controls altitude."); return; }
vehicle@ v=map_vehicles[player_vehicle_index];
vehicle_type@ t=vehicle_types[v.type_index];
if(direction>0 and t.vehicle_class=="fixed_wing" and v.z==0 and vehicle_current_velocity<5){speak("Build at least five tiles per second of takeoff speed first.");return;}
if(direction<0 and t.vehicle_class=="fixed_wing" and v.z==1 and vehicle_current_velocity>4){speak("Slow below five tiles per second before touching down.");return;}
int next=v.z+direction;
if (next<0) next=0;
if (next>int(max.z)) next=int(max.z);
if (next==v.z) { speak(direction>0 ? "Maximum altitude." : "On the ground."); return; }
v.z=next;
me.z=v.z;
speak("Altitude "+v.z+".");
send_reliable(1, "move_to "+mr.x+" "+mr.y+" "+me.z, 0);
send_reliable(0,"veh_move "+v.id+" "+round(v.px,2)+" "+round(v.py,2)+" "+v.z+" "+round(v.facing,1)+" "+round(vehicle_current_velocity,2),0);
}

// The nearest intact vehicle whose hull is within range of a point.
int find_nearest_vehicle(double px,double py,double pz,double range)
{
int best=-1;double best_dist=999999;
for(uint i=0;i<map_vehicles.length();i++)
{
if(map_vehicles[i].destroyed)continue;
double flat=vehicle_hull_distance(map_vehicles[i],px,py),dz=absolute(double(map_vehicles[i].z)-pz);
double dist=sqrt(flat*flat+dz*dz);
if(dist<=range and dist<best_dist){best_dist=dist;best=int(i);}
}
return best;
}
// You can get into a vehicle from anywhere close to its hull: the front, the
// back or either side. Its doors open for you.
const double VEHICLE_BOARDING_REACH=1.5;
int find_boardable_vehicle(){return find_nearest_vehicle(me.x,me.y,me.z,VEHICLE_BOARDING_REACH);}

// Opens or closes the door of the vehicle you are in, or the nearest one.
void vehicle_toggle_door(int px, int py, int pz)
{
int vi=in_vehicle?player_vehicle_index:find_boardable_vehicle();
if(vi<0){speak("No vehicle close enough.");return;}
vehicle@ v=map_vehicles[vi];
if(vehicle_open_seated(v)){speak("The "+v.get_name()+" has no doors.");return;}
if(in_vehicle and player_seat>1){speak("This seat cannot reach the door controls.");return;}
send_reliable(0,"veh_door "+v.id+" "+(v.door_open?0:1),0);
}

// Asks the server for a seat in the nearest vehicle. The server answers with
// veh_entered (see handle_vehicle_packet) or with the reason it cannot.
void vehicle_enter(string pname, int px, int py, int pz)
{
if(in_vehicle){speak("You are already in a vehicle.");return;}
int vi=find_boardable_vehicle();
if(vi<0)
{
int near=find_nearest_vehicle(me.x,me.y,me.z,6);
speak(near<0?"No vehicle close enough.":"Move closer to the "+map_vehicles[near].get_name()+": you are "+int(ceil(vehicle_hull_distance(map_vehicles[near],me.x,me.y)))+" tiles from it.");
return;
}
vehicle@ v=map_vehicles[vi];
if(v.is_full()){speak("The "+v.get_name()+" is full.");return;}
send_reliable(0,"veh_enter "+v.id,0);
}

// A clear place to stand beside a vehicle: by the driver's door, then the
// other side, then behind and in front.
bool vehicle_exit_spot(vehicle@ v,double &out sx,double &out sy)
{
double length,width,height;vehicle_dimensions(v,length,width,height);
double[] forwards={length*.165,length*.165,-length*.5-1,length*.5+1,0,0},sides={-(width*.5+1),width*.5+1,0,0,-(width*.5+2),width*.5+2};
for(uint i=0;i<forwards.length();i++)
{
double wx,wy;vehicle_world_position(v,forwards[i],sides[i],wx,wy);
if(wx<0 or wy<0 or wx>max.x or wy>max.y)continue;
string tile=get_tile_at(round(wx,0),round(wy,0),v.z);
if(tile=="" or string_contains(tile,"wall",1)>=0 or dynamic_map_solid_at(wx,wy,v.z+.5))continue;
sx=wx;sy=wy;return true;
}
return false;
}
void vehicle_exit(string pname)
{
vehicle@ v=my_vehicle();
if(v is null){speak("You are not in a vehicle.");return;}
if(absolute(vehicle_current_velocity)>.3 or (player_seat!=0 and absolute(v.observed_velocity)>.3)){speak("Stop the vehicle first.");return;}
double sx,sy;
if(!vehicle_exit_spot(v,sx,sy)){speak("There is nowhere clear to get out of the "+v.get_name()+".");return;}
int seat=player_seat;
send_reliable(0,"veh_exit "+v.id,0);
if(!vehicle_open_seated(v)){play_vehicle_audio(v,"door_open");play_vehicle_audio(v,"door_close");}
play_vehicle_audio(v,"exit");
speak("Out of the "+v.get_name()+".");
vehicle_let_go(false);
me.x=sx;me.y=sy;me.z=v.z;mr.x=round(me.x,0);mr.y=round(me.y,0);
send_reliable(1,"move_to "+mr.x+" "+mr.y+" "+me.z,0);
}

// Moves to the next free seat in the given direction (Alt+Left and Right).
void vehicle_switch_seat(string pname, int direction)
{
vehicle@ v=my_vehicle();if(v is null)return;
int cur=v.find_player_seat(pname);if(cur<0)return;
int max_s=v.get_max_passengers();
for(int step=1;step<max_s;step++)
{
int next_seat=((cur+direction*step)%max_s+max_s)%max_s;
if(v.passengers[next_seat]==""){send_reliable(0,"veh_seat "+v.id+" "+next_seat,0);return;}
}
speak("No other seats are free.");
}

// Toggle window at current seat.
void vehicle_toggle_window()
{
if (!in_vehicle or player_vehicle_index < 0) return;
vehicle@ v = map_vehicles[player_vehicle_index];
if (!v.has_seat_window(player_seat))
{
speak("No window at this seat.");
return;
}
v.window_down[player_seat] = !v.window_down[player_seat];
if (v.window_down[player_seat])
{
play_vehicle_audio(v, "window_open");
speak("Window down.");
}
else
{
play_vehicle_audio(v, "window_close");
speak("Window up.");
}
}

// ---------------------------------------------------------------------------
// Weapons in vehicles. A weapon's file can say how it behaves inside one
// (vehicle_use): forbidden weapons cannot be brought to bear from a seat at
// all; a mortar fired inside detonates against the roof (cabin_detonation);
// a rocket's backblast fills the cabin (backblast); a flamethrower sets the
// cabin alight (cabin_fire). Melee weapons and powered tools have no room.
// Everything else needs your window down, and the server makes it far less
// accurate, especially from the driver's seat and at speed.
// ---------------------------------------------------------------------------
string weapon_vehicle_use(string weapon){for(uint i=0;i<wpn_cache.length();i++)if(wpn_cache[i].id==weapon)return wpn_cache[i].vehicle_use;return "";}
string vehicle_weapon_refusal(string weapon)
{
string c=get_weapon_class(weapon),name=get_weapon_display_name(weapon);
if(string_contains(c,"melee",1)==0)return "There is no room to swing a "+name+" inside a vehicle.";
if(c=="tool")return "There is no room to run a "+name+" inside a vehicle.";
if(weapon_vehicle_use(weapon)=="forbidden")return "The "+name+" is too big and heavy to bring to bear from a vehicle seat.";
return "";
}
// Why the current weapon cannot fire from this seat right now; empty if it can.
string vehicle_fire_block_reason(string weapon)
{
if(!in_vehicle or player_vehicle_index<0)return "";
string refusal=vehicle_weapon_refusal(weapon);if(refusal!="")return refusal;
string use=weapon_vehicle_use(weapon);if(use=="cabin_detonation" or use=="backblast" or use=="cabin_fire")return "";
vehicle@ v=map_vehicles[player_vehicle_index];
if(!v.has_seat_window(player_seat))return "This seat has no window to fire from.";
if(!v.window_down[player_seat])return "Roll your window down first.";
return "";
}
bool vehicle_can_fire(){return vehicle_fire_block_reason(weapons[w])=="";}
// Mounted weapons. Control fires the gun on your seat, if it has one, at
// the rate in that gun's own weapon file; the server holds the same limit.
// Returns true while you sit at a mounted gun, so the trigger never also
// fires whatever you are holding.
timer vehicle_mounted_fire_timer;
bool vehicle_has_mounted_weapon()
{
if(!in_vehicle or player_vehicle_index<0 or player_seat<0)return false;vehicle_type@ t=vehicle_types[map_vehicles[player_vehicle_index].type_index];return player_seat<int(t.seat_weapons.length()) and t.seat_weapons[player_seat]!="";
}
int vehicle_mounted_interval(string gun){for(uint i=0;i<wpn_cache.length();i++)if(wpn_cache[i].id==gun)return wpn_cache[i].firetime>0?wpn_cache[i].firetime:500;return 500;}
bool vehicle_fire_mounted_weapon(bool trigger)
{
if(!vehicle_has_mounted_weapon())return false;if(!trigger)return true;
vehicle_type@ t=vehicle_types[map_vehicles[player_vehicle_index].type_index];string gun=t.seat_weapons[player_seat];
if(vehicle_mounted_fire_timer.elapsed<vehicle_mounted_interval(gun))return true;vehicle_mounted_fire_timer.restart();
send_reliable(0,"veh_fire "+player_vehicle_index+" "+player_seat+" "+gun,0);return true;
}

// ---------------------------------------------------------------------------
// Driving. Hold Up to accelerate and Down to brake; let go of both and the
// vehicle coasts down. Steering turns it at a rate set by its speed and
// turning circle, so a parked car cannot turn and steering reverses when you
// back up; tracked vehicles and hovering helicopters can also turn on the
// spot. Manual gearboxes change gear on Shift+Up and Shift+Down, through
// neutral to reverse; automatics engage reverse when Down is held at a stop.
//
// This replaced a cruise control in which Up and Down set a target speed in
// ten percent steps and Left and Right snapped the vehicle round 45 degrees
// even when it was standing still.
// ---------------------------------------------------------------------------
int vehicle_gear=1; // -1 reverse, 0 neutral, 1 and up forward gears
bool vehicle_throttle=false,vehicle_brake=false,vehicle_prev_throttle=false,vehicle_prev_brake=false;int vehicle_steer=0;
bool vehicle_reverse_hold=false;timer vehicle_reverse_hold_timer;
timer vehicle_net_timer,vehicle_turn_cue_timer,vehicle_gear_warning_timer,vehicle_still_turn_timer;
double vehicle_sent_facing=-1000;
// Firing a weapon from the driver's seat takes your eyes off the road for a
// moment; see vehicle_drive_step.
timer driver_distraction_timer;bool driver_distracted=false;
void distract_driver(){if(in_vehicle and player_seat==0){driver_distracted=true;driver_distraction_timer.restart();}}

bool vehicle_manual(vehicle@ v){vehicle_type@ t=vehicle_types[v.type_index];return t.transmission=="manual" and t.gears>0;}
int vehicle_gear_count(vehicle@ v){vehicle_type@ t=vehicle_types[v.type_index];return t.gears>0?t.gears:4;}
double vehicle_reverse_top(vehicle@ v){return vehicle_types[v.type_index].reverse_speed;}
double vehicle_turning_radius(vehicle@ v){vehicle_type@ t=vehicle_types[v.type_index];return t.turning_radius>0?t.turning_radius:t.body_length*1.6;}
// Forward gear n of N tops out at n/N of the vehicle's top speed, and low gears pull hardest.
double vehicle_gear_top(vehicle@ v,int gear){if(gear<=0)return 0;return v.vehicle_effective_top_speed(v)*double(gear)/double(vehicle_gear_count(v));}
double vehicle_gear_pull(vehicle@ v,int gear){int n=vehicle_gear_count(v);if(n<=1)return 1.0;return 1.5-.8*double(gear-1)/double(n-1);}
int vehicle_auto_gear(vehicle@ v,double speed){int n=vehicle_gear_count(v);for(int g=1;g<=n;g++)if(absolute(speed)<=vehicle_gear_top(v,g)*.92)return g;return n;}
string vehicle_gear_name(int gear){if(gear<0)return "reverse";if(gear==0)return "neutral";return "gear "+gear;}
string vehicle_driving_hint(vehicle@ v){return vehicle_manual(v)?"Manual gearbox, "+vehicle_gear_count(v)+" gears, in first. Shift with Shift Up and Shift Down.":"Automatic gearbox."+(vehicle_reverse_top(v)>0?" Hold Down at a stop to reverse.":"");}
bool vehicle_is_driver(){return in_vehicle and player_vehicle_index>=0 and player_seat==0;}

// Pedal and steering state for this frame, read from held keys.
void vehicle_drive_input(bool throttle,bool brake,int steer)
{
if(!vehicle_is_driver()){vehicle_throttle=false;vehicle_brake=false;vehicle_steer=0;return;}
vehicle_throttle=throttle;vehicle_brake=brake;vehicle_steer=steer;
}

void vehicle_shift(int direction)
{
if(!in_vehicle or player_vehicle_index<0)return;
if(player_seat!=0){speak("Only the driver can change gear.");return;}
vehicle@ v=map_vehicles[player_vehicle_index];
if(!vehicle_manual(v)){speak(v.get_name()+" has an automatic transmission."+(vehicle_reverse_top(v)>0?" Hold Down at a standstill to reverse.":""));return;}
int next=vehicle_gear+direction;
if(next>vehicle_gear_count(v)){speak("Already in top gear.");return;}
if(next<-1 or (next==-1 and vehicle_reverse_top(v)<=0)){speak(next<-1?"Already in reverse.":"The "+v.get_name()+" has no reverse gear.");return;}
// Reverse is selected at a standstill; doing it while rolling grinds the gearbox.
if(next==-1 and vehicle_current_velocity>.6){p.play_stationary("ammo_cycle.ogg",false);speak("The gearbox grinds. Stop before selecting reverse.");return;}
vehicle_gear=next;p.play_stationary(direction>0?"modeenter.ogg":"modeleave.ogg",false);speak(vehicle_gear_name(vehicle_gear)+".");
}

void vehicle_horn()
{
if(!in_vehicle or player_vehicle_index<0)return;if(player_seat!=0){speak("Only the driver can use the horn.");return;}play_vehicle_audio(map_vehicles[player_vehicle_index],"horn");
}

// One step of the drive model for the driver's vehicle.
void vehicle_drive_step(vehicle@ v)
{
double dt=double(vehicle_accel_timer.elapsed)/1000.0;if(dt<.02)return;if(dt>.1)dt=.1;vehicle_accel_timer.restart();
vehicle_type@ t=vehicle_types[v.type_index];bool manual=vehicle_manual(v);
bool throttle=vehicle_throttle,brake=vehicle_brake;int steer=vehicle_steer;
if(driver_distracted and driver_distraction_timer.elapsed>1500)driver_distracted=false;
// A distracted driver's feet and hands are not doing what they should.
if(driver_distracted){if(random(1,100)<=35)throttle=!throttle;if(random(1,100)<=25)steer=random(-1,1);}
double speed=vehicle_current_velocity,top=v.vehicle_effective_top_speed(v),reverse_top=vehicle_reverse_top(v);
if(!manual)
{
if(vehicle_gear>=0 and brake and absolute(speed)<.15 and reverse_top>0)
{
if(!vehicle_reverse_hold){vehicle_reverse_hold=true;vehicle_reverse_hold_timer.restart();}
else if(vehicle_reverse_hold_timer.elapsed>=500){vehicle_gear=-1;vehicle_reverse_hold=false;speak("Reverse.");}
}
else if(vehicle_gear<0 and throttle and absolute(speed)<.15){vehicle_gear=1;speak("Drive.");}
else if(!brake)vehicle_reverse_hold=false;
// In reverse, Down drives backwards and Up brakes.
if(vehicle_gear<0){bool swap=brake;brake=throttle;throttle=swap;}
}
int gear=manual?vehicle_gear:(vehicle_gear<0?-1:vehicle_auto_gear(v,speed));
bool can_drive=v.fuel>0 and v.engine_condition>0 and v.transmission_condition>0 and !v.emp_active();
double accel=0;
if(throttle and can_drive and gear!=0)
{
if(gear<0)accel=speed>-reverse_top?-t.acceleration*.7:0;
else
{
double gear_top=vehicle_gear_top(v,gear),lug=gear>1?vehicle_gear_top(v,gear-1)*.45:0,pull=vehicle_gear_pull(v,gear);
if(speed<lug){pull*=.3;if(manual and vehicle_gear_warning_timer.elapsed>2500){vehicle_gear_warning_timer.restart();speak("The engine labours. Shift down.");}}
accel=speed<gear_top?t.acceleration*pull:0;
}
}
if(throttle and !can_drive and !vehicle_prev_throttle)speak(v.emp_active()?"The engine is dead after the electromagnetic pulse.":v.fuel<=0?"The vehicle is out of "+t.fuel_type+".":(v.engine_condition<=0?"The engine is mechanically disabled.":"The transmission can no longer transfer power."));
double before=speed;
if(brake and absolute(speed)>.01)accel-=(speed>0?1.0:-1.0)*t.braking;
speed+=accel*dt;
// Brakes stop a vehicle; they do not drive it the other way.
if(brake and ((before>0 and speed<0) or (before<0 and speed>0)))speed=0;
// Rolling resistance and engine braking slow a coasting vehicle.
if(!throttle or gear==0 or !can_drive){double coast=(.6+absolute(speed)*.05)*dt;if(absolute(speed)<=coast)speed=0;else speed-=(speed>0?1.0:-1.0)*coast;}
// A gear held past its limit over-revs and holds the vehicle back.
if(gear>0){double gear_top=vehicle_gear_top(v,gear);if(speed>gear_top+.3){speed-=((speed-gear_top)*.9+.8)*dt;if(manual and vehicle_gear_warning_timer.elapsed>2500){vehicle_gear_warning_timer.restart();speak("The engine is over-revving. Shift up.");}}}
if(speed>top)speed=top;if(speed<-reverse_top)speed=-reverse_top;
// Cues on pedal changes rather than continuously.
if(throttle and !vehicle_prev_throttle and can_drive)play_vehicle_audio(v,"accelerate");
if(brake and !vehicle_prev_brake and absolute(speed)>1)play_vehicle_audio(v,"decelerate");
if(absolute(before)>.3 and speed==0){play_vehicle_audio(v,"stop");speak("Stopped.");}
vehicle_prev_throttle=throttle;vehicle_prev_brake=brake;
// Steering.
bool flying=t.travel_domain=="air" and v.z>0;double yaw=0;
if(steer!=0)
{
if(t.pivot_turn and absolute(speed)<1.0 and (t.vehicle_class!="rotary_wing" or flying))yaw=(t.vehicle_class=="rotary_wing"?45.0:22.0)*double(steer);
else{yaw=speed/vehicle_turning_radius(v)*57.2958*double(steer);if(yaw>110)yaw=110;if(yaw<-110)yaw=-110;}
if(yaw==0 and vehicle_still_turn_timer.elapsed>3000){vehicle_still_turn_timer.restart();speak("The wheels turn, but the vehicle has to be moving to change direction.");}
else if(yaw!=0 and vehicle_turn_cue_timer.elapsed>1500){vehicle_turn_cue_timer.restart();play_vehicle_audio(v,"turn");}
}
if(driver_distracted and absolute(speed)>1)yaw+=double(random(-25,25))*absolute(speed)/top;
if(yaw!=0){v.facing+=yaw*dt;while(v.facing<0)v.facing+=360;while(v.facing>=360)v.facing-=360;facing=v.facing;}
double turned=absolute(v.facing-vehicle_sent_facing);if(turned>180)turned=360-turned;
if(turned>=2 and vehicle_net_timer.elapsed>=100){vehicle_sent_facing=v.facing;vehicle_send_move(v,speed);send_reliable(0,"turn "+facing,0);}
if(speed==0 and yaw!=0)ensure_vehicle_map_element(v,player_vehicle_index);
vehicle_current_velocity=speed;
if(speed==0)return;
// Movement. The exact position moves continuously; the tile it occupies is
// checked whenever it changes.
double rad=v.facing*3.14159265358979323846/180.0,nx=v.px+sine(rad)*speed*dt,ny=v.py+cosine(rad)*speed*dt;
int inx=int(round(nx,0)),iny=int(round(ny,0));
if(nx<0 or nx>max.x or ny<0 or ny>max.y){vehicle_current_velocity=0;speak("Edge of map. Stopped.");return;}
if(inx!=v.x or iny!=v.y)
{
string terrain=string_to_lower_case(get_tile_at(inx,iny,v.z));bool water_terrain=string_contains(terrain,"water",1)>=0 or string_contains(terrain,"sea",1)>=0 or string_contains(terrain,"river",1)>=0 or string_contains(terrain,"lake",1)>=0 or string_contains(terrain,"ocean",1)>=0;
if(!flying and t.travel_domain=="water" and !water_terrain){vehicle_current_velocity=0;speak("This watercraft cannot travel onto land.");return;}
if(!flying and t.travel_domain=="land" and water_terrain){vehicle_current_velocity=0;speak("This land vehicle cannot enter navigable water.");return;}
double fuel_use=t.fuel_per_tile*(1.0+double(100-v.engine_condition)/180.0+double(v.fuel_contamination)/100.0);if(v.performance_tune)fuel_use*=1.12;if(v.turbocharger)fuel_use*=1.18;if(v.auxiliary_armor)fuel_use*=1.1;v.fuel-=fuel_use;if(v.fuel<0)v.fuel=0;
if(random(1,700)==1)v.transmission_condition--;if(random(1,v.offroad_tires?1400:850)==1)v.tire_condition--;if(random(1,1100)==1)v.cooling_condition--;if(v.transmission_condition<0)v.transmission_condition=0;if(v.tire_condition<0)v.tire_condition=0;if(v.cooling_condition<0)v.cooling_condition=0;
}
// The whole hull is checked at the exact new position, so a vehicle stops at
// a wall, a parked car or a map object instead of sliding into it until its
// centre reaches the next tile.
if(!flying and !vehicle_footprint_clear(v,nx,ny,v.z,v.facing))
{
// The server decides what the crash costs from the speed it last saw.
if(absolute(speed)>1.5){send_reliable(0,"veh_crash "+v.id,0);speak("Crashed! Stopped.");play_vehicle_audio(v,"crash");}
else speak("Blocked.");
vehicle_current_velocity=0;return;
}
bool moved_tile=inx!=v.x or iny!=v.y;
v.place(nx,ny,v.z,v.facing);
dynamic_map_move(v.map_element_id,v.px,v.py,v.z,v.facing);
vehicle_follow_seat(v);
if(moved_tile or vehicle_net_timer.elapsed>=100)
{
send_reliable(1,"move_to "+mr.x+" "+mr.y+" "+me.z,0);
vehicle_send_move(v,speed);
if(moved_tile)checkzone();
}
}
// The driver's exact position, facing and speed, ten times a second at most.
void vehicle_send_move(vehicle@ v,double speed)
{
vehicle_net_timer.restart();
send_reliable(0,"veh_move "+v.id+" "+round(v.px,2)+" "+round(v.py,2)+" "+v.z+" "+round(v.facing,1)+" "+round(speed,2),0);
}

// Apply damage to a vehicle. Returns true if destroyed.
bool vehicle_take_damage(int vi, int damage)
{
if (vi < 0 or vi >= int(map_vehicles.length())) return false;
vehicle@ v = map_vehicles[vi];
if (v.destroyed) return false;

if (v.armor > 0)
{
// Armor absorbs full damage, then 1/4 of health is also taken.
v.armor -= damage;
if (v.armor < 0) v.armor = 0;
v.health -= damage / 4;
}
else
{
v.health -= damage;
}

if (v.health <= 0)
{
v.health = 0;
v.destroyed = true;
return true;
}
return false;
}

// Called when vehicle is destroyed - kicks all players, deals 1/4 health damage.
void vehicle_on_destroy(int vi)
{
if (vi < 0 or vi >= int(map_vehicles.length())) return;
vehicle@ v = map_vehicles[vi];
dynamic_map_destroy(v.map_element_id);
play_vehicle_audio(v, "destroy");
speak(v.get_name() + " destroyed!");
// Kick all players.
for (int i = 0; i < int(v.passengers.length()); i++)
{
v.passengers[i] = "";
v.window_down[i] = false;
}
if(player_vehicle_index==vi)vehicle_let_go(false); // the server hurts the occupants
}

// Get vehicle health/armor status string.
string get_vehicle_status()
{
if (!in_vehicle or player_vehicle_index < 0) return "";
vehicle@ v = map_vehicles[player_vehicle_index];
string s = v.get_name() + ": ";
s += "Health " + v.health + " of " + vehicle_types[v.type_index].max_health + ".";
if (vehicle_types[v.type_index].armor > 0)
s += " Armor " + v.armor + " of " + vehicle_types[v.type_index].armor + ".";
s += " Speed "+round(absolute(vehicle_current_velocity),1)+(vehicle_current_velocity<0?" in reverse":"")+" of "+round(v.vehicle_effective_top_speed(v),1)+" tiles per second, "+(vehicle_manual(v)?vehicle_gear_name(vehicle_gear):(vehicle_gear<0?"reverse":"drive"))+". Fuel "+round(v.fuel,1)+" of "+round(v.vehicle_effective_capacity(v),1)+" litres of "+vehicle_types[v.type_index].fuel_type+".";
s += " " + v.seat_label(player_seat) + ".";
if (v.has_seat_window(player_seat))
{
if (v.window_down[player_seat])
s += " Window down.";
else
s += " Window up.";
}
return s;
}

// Vehicle movement loop - called each frame from mainloop.
void vehicle_loop()
{
for(uint dynamic_vehicle=0;dynamic_vehicle<map_vehicles.length();dynamic_vehicle++)if(!map_vehicles[dynamic_vehicle].destroyed)ensure_vehicle_map_element(map_vehicles[dynamic_vehicle],int(dynamic_vehicle));
if(vehicle_roof_index>=0)
{
if(vehicle_roof_index>=int(map_vehicles.length()) or map_vehicles[vehicle_roof_index].destroyed) vehicle_roof_index=-1;
else
{
vehicle@ roof=map_vehicles[vehicle_roof_index];
bool aircraft_launch=roof.get_name()=="Duo Plane" and roof.z>vehicle_roof_last_z;
if(aircraft_launch or roof.observed_velocity>5.5)
{
vehicle_roof_index=-1;
me.z=double(roof.z)+1;
falling=true;
p.play_stationary("vehicle_"+vehicle_audio_id(roof)+"_crash.ogg",false);
speak(aircraft_launch?"Thrown from the aircraft as it launched.":"Thrown from the moving vehicle.");
}
else
{
double roof_length,roof_width,roof_height;vehicle_dimensions(roof,roof_length,roof_width,roof_height);double rx,ry;vehicle_world_position(roof,vehicle_roof_local_forward,vehicle_roof_local_side,rx,ry);me.x=rx;me.y=ry;me.z=roof.z+roof_height;mr.x=round(me.x,0);mr.y=round(me.y,0);
if(roof.px!=vehicle_roof_last_x or roof.py!=vehicle_roof_last_y or roof.z!=vehicle_roof_last_z)
send_reliable(1,"move_to "+mr.x+" "+mr.y+" "+me.z,0);
}
vehicle_roof_last_x=roof.px;vehicle_roof_last_y=roof.py;vehicle_roof_last_z=roof.z;
}
}
if (!in_vehicle or player_vehicle_index < 0) return;
vehicle@ v = map_vehicles[player_vehicle_index];
if (v.destroyed)
{
vehicle_on_destroy(player_vehicle_index);
return;
}

if(player_seat==0)vehicle_drive_step(v);
else
{
// A passenger rides where the driver takes them; the server hears where
// they are as they go, for bullets, explosions and who is nearby.
int old_x=int(mr.x),old_y=int(mr.y);vehicle_follow_seat(v);
if((int(mr.x)!=old_x or int(mr.y)!=old_y) and vehicle_net_timer.elapsed>=150){vehicle_net_timer.restart();send_reliable(1,"move_to "+mr.x+" "+mr.y+" "+me.z,0);}
}

// Stamina restoration while in vehicle - every 15 seconds.
if (vehicle_stamina_timer.elapsed >= 15000)
{
vehicle_stamina_timer.restart();
restore_stamina(5);
}
}

string pending_vehicle_nearby="";
string get_nearby_vehicles_string(int px, int py, int pz)
{
string result="";
for(uint i=0;i<map_vehicles.length();i++)
{
vehicle@ v=map_vehicles[i];
double flat=vehicle_hull_distance(v,me.x,me.y),dz=double(v.z)-me.z,dist=sqrt(flat*flat+dz*dz);
if(dist>30)continue;
string info=v.get_name()+(v.destroyed?", wrecked":"");
if(!v.destroyed)
{
if(!vehicle_open_seated(v))info+=v.door_open?", doors open":", doors closed";
int riders=v.count_occupants();if(riders>0)info+=", "+riders+(riders==1?" person":" people")+" aboard";
if(absolute(v.observed_velocity)>.3)info+=", moving";
info+=", health "+v.health+" of "+vehicle_types[v.type_index].max_health;
if(vehicle_types[v.type_index].armor>0)info+=", armour "+v.armor+" of "+vehicle_types[v.type_index].armor;
if(v.emp_active())info+=", disabled by a pulse";
}
if(flat<.01)info+=", here.";
else
{
if(dz>=1)info+=", above";else if(dz<=-1)info+=", below";
info+=", "+(flat<=VEHICLE_BOARDING_REACH?"close enough to board, ":"")+clock_direction(calculate_x_y_angle(me.x,me.y,v.px,v.py,facing))+", "+int(ceil(flat))+" tiles away.";
}
if(result!="")result+=" ";
result+=info;
}
return result;
}
void announce_nearby_vehicles_tracked(int px, int py, int pz)
{
string info=get_nearby_vehicles_string(px, py, pz);
if(info!="") speak(info);
}

// Vehicle damage from explosions and bullets is decided by the server and
// arrives as veh_damage. Each client used to roll its own random damage for
// every explosion it heard, so one vehicle had a different health on every
// screen and could be destroyed on yours while intact on everyone else's.
void check_vehicle_damage_from_explosion(int ex, int ey, int ez, int blast_radius, int min_dmg, int max_dmg){}

void check_vehicle_damage_from_bullet(int bx, int by, int bz, int spread, int min_dmg, int max_dmg){}
