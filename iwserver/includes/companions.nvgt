// Persistent, server-authoritative drones and bioengineered chimps.
class companion_actor
{
int id;string owner,item,kind,map,mode="follow",sound;double x,y,z,guard_x,guard_y,guard_z;int facing=0,health,speed,follow_distance,attack_range,damage_min,damage_max,attack_cooldown;timer move_timer,attack_timer,sync_timer,sound_timer;
bool piloted=false;int owner_peer=-1,input_forward=0,input_side=0,input_vertical=0,input_turn=0;timer input_timer;
}
companion_actor@[] companions;
int next_companion_id=1;
double actor_distance(double x,double y,double z,double tx,double ty,double tz){double dx=x-tx,dy=y-ty,dz=z-tz;return sqrt(dx*dx+dy*dy+dz*dz);}
int companion_index(int id){for(uint i=0;i<companions.length();i++)if(companions[i].id==id)return int(i);return -1;}
bool companion_owned(companion_actor@ c,player@ p){return c !is null and p !is null and c.owner==p.name and (c.owner_peer<0 or c.owner_peer==p.peer_id);}
string companion_label(companion_actor@ c){item_data@ d=item_info(c.item);return (d is null?string_replace(c.item,"_"," ",true):d.name)+" number "+c.id;}
void companion_sync(companion_actor@ c,bool reliable=false)
{
int recharge=c.attack_cooldown-int(c.attack_timer.elapsed);if(recharge<0)recharge=0;
string packet="companion_sync "+c.id+" "+c.kind+" "+c.x+" "+c.y+" "+c.z+" "+c.facing+" "+c.health+" "+c.map+" "+c.owner+" "+c.mode+" "+c.item+" "+recharge;
if(reliable)send_reliable_map(c.map,packet,0);else send_unreliable_map(c.map,packet,0);
}
void deploy_companion(int player_index,string item)
{
if(player_index<0 or item_prop(item,"use_kind")!="companion")return;player@ owner=players[player_index];if(owner.death or owner.arena_role=="spectator")return;int owned=0;for(uint i=0;i<companions.length();i++)if(companions[i].owner==owner.name)owned++;if(owned>=8){send_reliable(owner.peer_id,"You may control no more than eight companions at once.",2);return;}
companion_actor@ c=companion_actor();c.id=next_companion_id++;c.owner=owner.name;c.owner_peer=owner.peer_id;c.item=item;c.kind=item_prop(item,"companion_kind","drone");c.map=owner.map;c.x=owner.x;c.y=owner.y;c.z=owner.z+(c.kind=="drone"?1.5:0);c.facing=owner.facing;c.health=item_prop_int(item,"companion_health",500);c.speed=item_prop_int(item,"companion_speed",7);c.follow_distance=item_prop_int(item,"companion_follow_distance",3);c.attack_range=item_prop_int(item,"companion_attack_range",20);c.damage_min=item_prop_int(item,"companion_damage_min",80);c.damage_max=item_prop_int(item,"companion_damage_max",120);c.attack_cooldown=item_prop_int(item,"companion_attack_cooldown_ms",2200);c.sound=item_prop(item,"companion_sound");companions.insert_last(c);
end_spawn_grace(owner);send_reliable(owner.peer_id,"give "+item+" -1",0);if(c.sound!="")world_sound_from(c.kind=="chimp"?"animals/chimpanzee/phrases/vocal"+random(1,4):c.sound+"/activate",owner);companion_sync(c,true);send_reliable(owner.peer_id,"Deployed "+companion_label(c)+". Use a Companion Command Remote to direct or pilot it.",2);
}
int companion_nearest_hostile(companion_actor@ c)
{
int owner=get_player_index_from(c.owner),found=-1;double nearest=999999;if(owner<0)return -1;for(uint i=0;i<players.length();i++){if(players[i].death or players[i].map!=c.map or players[i].name==c.owner or players[i].arena_role=="spectator" or same_team(c.owner,players[i].name) or !player_can_be_damaged_by(players[i],c.owner))continue;double d=actor_distance(c.x,c.y,c.z,players[i].x,players[i].y,players[i].z);double r=c.facing*3.14159265358979323846/180;if(c.piloted and d>.01 and ((players[i].x-c.x)*sine(r)+(players[i].y-c.y)*cosine(r))/d<.5)continue;if(d<=c.attack_range and d<nearest and !blast_line_blocked(c.x,c.y,c.z,players[i].x,players[i].y,players[i].z+1,c.map)){nearest=d;found=int(i);}}return found;
}
bool companion_fire_once(companion_actor@ c,player@ owner,bool report=true)
{
if(c.attack_timer.elapsed<c.attack_cooldown)
{
if(report)send_reliable(owner.peer_id,companion_label(c)+" can attack again in "+((c.attack_cooldown-c.attack_timer.elapsed+999)/1000)+" seconds.",2);return false;
}
int target=companion_nearest_hostile(c);
if(target<0){if(report)send_reliable(owner.peer_id,"No unobstructed hostile is in the companion's acquisition range.",2);return false;}
double d=actor_distance(c.x,c.y,c.z,players[target].x,players[target].y,players[target].z);
if(d>item_prop_number(c.item,"companion_weapon_range",c.kind=="chimp"?1.8:8))
{if(report)send_reliable(owner.peer_id,"The companion must approach before its weapon can reach that target.",2);return false;}
end_spawn_grace(owner);c.attack_timer.restart();
int damage=apply_player_damage(players[target],random(c.damage_min,c.damage_max),c.owner+"'s "+c.item);
if(c.kind=="chimp")
{
world_sound_at("animals/chimpanzee/phrases/attack"+random(1,5),c.x,c.y,c.z,c.map);
world_sound_at("animals/chimpanzee/combat/impact"+random(1,3),players[target].x,players[target].y,players[target].z,c.map);
}
else world_sound_at(c.sound+"/impact"+random(1,3),players[target].x,players[target].y,players[target].z,c.map);
if(report)send_reliable(owner.peer_id,companion_label(c)+" dealt "+damage+" damage to "+players[target].name+".",2);
return true;
}
bool companion_body_controlled(string owner)
{
for(uint i=0;i<companions.length();i++)if(companions[i].owner==owner and companions[i].piloted)return true;return false;
}
bool companion_damage_allowed(companion_actor@ c,string attacker)
{
int oi=get_player_index_from(c.owner);return oi>=0 and !player_has_spawn_grace(players[oi]) and player_can_be_damaged_by(players[oi],attacker) and (attacker==c.owner or !same_team(attacker,c.owner));
}
bool projectile_hit_companion(weapon@ w)
{
for(uint i=0;i<companions.length();i++)
{
companion_actor@ c=companions[i];if(c.map!=w.map or c.owner==w.cn or c.health<=0 or !companion_damage_allowed(c,w.cn))continue;
double dz=w.z-c.z;if(dz<-.4 or dz>(c.kind=="chimp"?1.6:.6) or actor_distance(w.x,w.y,0,c.x,c.y,0)>w.collision_radius+.35)continue;
c.health-=projectile_damage(w,"torso");companion_sync(c,true);play(w.sound_profile+"hit1",int(c.x),int(c.y),int(c.z),c.map);return true;
}
return false;
}
void companion_blast_damage(double x,double y,double z,string map,blast_profile@ b)
{
for(uint i=0;i<companions.length();i++)
{
companion_actor@ c=companions[i];if(c.map!=map or c.health<=0 or !companion_damage_allowed(c,b.owner))continue;
double d=actor_distance(x,y,z,c.x,c.y,c.z),pressure=blast_overpressure(d,b.radius);if(pressure<=0)continue;
bool covered=blast_line_blocked(x,y,z+.4,c.x,c.y,c.z+.4,map);int damage=int(b.damage*pressure*(covered?.25:1));
if(!covered)damage+=blast_fragment_damage(b,d,blast_fragment_hits(b,d));c.health-=damage;companion_sync(c,true);
}
}
void companion_end_pilot(companion_actor@ c)
{
if(!c.piloted)return;c.piloted=false;c.input_forward=0;c.input_side=0;c.input_vertical=0;c.input_turn=0;
int oi=get_player_index_from(c.owner);if(oi>=0 and companion_owned(c,players[oi]))send_reliable(players[oi].peer_id,"companion_pilot_end",0);
}
bool companion_position_clear(companion_actor@ c,double x,double y,double z)
{
int mi=get_map_index(c.map);if(mi<0)return false;
if(x<0 or y<0 or z<0 or x>maps[mi].size_x or y>maps[mi].size_y or z>maps[mi].size_z+20)return false;
return !blast_tile_solid(get_tile_at(int(round(x,0)),int(round(y,0)),int(floor(z+.5)),c.map));
}
void companion_move_step(companion_actor@ c,double dx,double dy,double dz)
{
double length=sqrt(dx*dx+dy*dy+dz*dz);int steps=int(ceil(length/.15));if(steps<1)steps=1;if(steps>32)steps=32;
for(int i=0;i<steps;i++)
{
double nx=c.x+dx/steps,ny=c.y+dy/steps,nz=c.z+dz/steps;
if(c.kind=="chimp"){double h=projectile_surface_height(nx,ny,c.z+.7,c.map);if(h<-9000 or absolute(h-.18-c.z)>1.05)break;nz=h-.18;}
if(!companion_position_clear(c,nx,ny,nz))break;c.x=nx;c.y=ny;c.z=nz;
}
}
void companion_step_toward(companion_actor@ c,double tx,double ty,double tz,double dt)
{
double dx=tx-c.x,dy=ty-c.y,dz=c.kind=="chimp"?0:tz-c.z,d=sqrt(dx*dx+dy*dy+dz*dz);if(d<.05)return;
double step=c.speed*dt;if(step>d)step=d;companion_move_step(c,dx/d*step,dy/d*step,dz/d*step);
c.facing=(int(atan2(dx,dy)*180/3.14159265358979323846)+360)%360;
}
int companion_clamp_input(string value){double n=string_to_number(value);return n>0?1:(n<0?-1:0);}
void companion_pilot_step(companion_actor@ c,double dt)
{
if(c.input_timer.elapsed>250)return;
c.facing=(c.facing+int(c.input_turn*120*dt)+360)%360;
double r=c.facing*3.14159265358979323846/180;
double dx=sine(r)*c.input_forward+cosine(r)*c.input_side,dy=cosine(r)*c.input_forward-sine(r)*c.input_side;
double dz=c.kind=="drone"?c.input_vertical:0,n=sqrt(dx*dx+dy*dy+dz*dz);if(n<.01)return;
companion_move_step(c,dx/n*c.speed*dt,dy/n*c.speed*dt,dz/n*c.speed*dt);
}
void companion_loop()
{
for(int i=int(companions.length())-1;i>=0;i--)
{
companion_actor@ c=companions[i];int oi=get_player_index_from(c.owner);
if(oi<0 or (c.owner_peer>=0 and players[oi].peer_id!=c.owner_peer) or players[oi].death or players[oi].map!=c.map or c.health<=0){companion_end_pilot(c);send_reliable_map(c.map,"companion_remove "+c.id,0);companions.remove_at(i);continue;}
player@ owner=players[oi];
if(c.mode=="recall")
{
companion_end_pilot(c);
if(actor_distance(c.x,c.y,c.z,owner.x,owner.y,owner.z)<=3){send_reliable(owner.peer_id,"give "+c.item+" 1",0);send_reliable_map(c.map,"companion_remove "+c.id,0);companions.remove_at(i);continue;}
}
double dt=double(c.move_timer.elapsed)/1000;if(dt<.02)continue;if(dt>.1)dt=.1;c.move_timer.restart();
if(c.piloted)companion_pilot_step(c,dt);
else
{
int target=(c.mode=="attack" or c.mode=="guard")?companion_nearest_hostile(c):-1;
if(target>=0 and c.mode=="guard" and actor_distance(c.guard_x,c.guard_y,c.guard_z,players[target].x,players[target].y,players[target].z)>c.attack_range)target=-1;
if(target>=0){double d=actor_distance(c.x,c.y,c.z,players[target].x,players[target].y,players[target].z);if(d>item_prop_number(c.item,"companion_weapon_range",c.kind=="chimp"?1.8:8))companion_step_toward(c,players[target].x,players[target].y,players[target].z+(c.kind=="drone"?1:0),dt);else if(c.attack_timer.elapsed>=c.attack_cooldown)companion_fire_once(c,owner,false);}
else if(c.mode=="follow" or c.mode=="recall"){if(actor_distance(c.x,c.y,c.z,owner.x,owner.y,owner.z)>c.follow_distance or c.mode=="recall")companion_step_toward(c,owner.x,owner.y,owner.z+(c.kind=="drone"?1.5:0),dt);if(c.mode=="follow" and companion_nearest_hostile(c)>=0 and c.attack_timer.elapsed>=c.attack_cooldown)companion_fire_once(c,owner,false);}
else if(c.mode=="guard")companion_step_toward(c,c.guard_x,c.guard_y,c.guard_z,dt);
}
if(c.sound_timer.elapsed>=2200){c.sound_timer.restart();if(c.kind=="chimp")world_sound_at("animals/chimpanzee/phrases/vocal"+random(1,4),c.x,c.y,c.z,c.map);else world_sound_at(c.sound+"/fly",c.x,c.y,c.z,c.map);}
if(c.sync_timer.elapsed>=100){c.sync_timer.restart();companion_sync(c);}
}
}
void companion_send_list(player@ p)
{
string data;for(uint i=0;i<companions.length();i++)if(companions[i].owner==p.name){companion_actor@ c=companions[i];companion_sync(c,true);if(data!="")data+=";";data+=c.id+","+c.item+","+c.kind+","+c.mode+","+c.health+","+c.x+","+c.y+","+c.z+","+c.map;}send_reliable(p.peer_id,"companion_list "+data,0);
}
bool handle_companion_command(uint peer,const string &in message)
{
if(message.substr(0,10)!="companion ")return false;int pi=get_player_index(peer);if(pi<0)return true;
string[] f=string_split(message," ",true);if(f.length()<2)return true;player@ p=players[pi];
if(f[1]=="list"){companion_send_list(p);return true;}
if(f[1]=="stop"){for(uint i=0;i<companions.length();i++)if(companion_owned(companions[i],p))companion_end_pilot(companions[i]);return true;}
if(f.length()<4 or p.death or p.arena_role=="spectator")return true;
int ci=companion_index(int(string_to_number(f[2])));
if(ci<0 or !companion_owned(companions[ci],p)){send_reliable(peer,"That companion is no longer available.",2);return true;}
companion_actor@ c=companions[ci];if(c.map!=p.map)return true;
if(f[1]=="mode" and (f[3]=="follow" or f[3]=="stay" or f[3]=="guard" or f[3]=="attack" or f[3]=="recall"))
{companion_end_pilot(c);c.mode=f[3];c.guard_x=c.x;c.guard_y=c.y;c.guard_z=c.z;companion_sync(c,true);send_reliable(peer,companion_label(c)+" set to "+c.mode+".",2);}
else if(f[1]=="fire")companion_fire_once(c,p);
else if(f[1]=="pilot")
{for(uint i=0;i<companions.length();i++)if(companion_owned(companions[i],p))companion_end_pilot(companions[i]);c.piloted=true;c.mode="stay";c.input_timer.restart();companion_sync(c,true);send_reliable(peer,"companion_pilot "+c.id+" "+c.x+" "+c.y+" "+c.z+" "+c.facing+" "+c.map,0);}
else if(f[1]=="input" and f.length()>=7 and c.piloted)
{c.input_forward=companion_clamp_input(f[3]);c.input_side=companion_clamp_input(f[4]);c.input_vertical=companion_clamp_input(f[5]);c.input_turn=companion_clamp_input(f[6]);c.input_timer.restart();}
else if(f[1]=="status")send_reliable(peer,companion_label(c)+": "+c.health+" health, "+(c.piloted?"direct control":c.mode)+", at "+round(c.x,1)+", "+round(c.y,1)+", "+round(c.z,1)+", facing "+c.facing+" degrees on "+c.map+".",2);
return true;
}
