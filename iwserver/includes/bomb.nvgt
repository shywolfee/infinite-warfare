else if(payload=="50mm_ap"){blast_radius=6;blast_damage=360;}
else if(payload=="75mm_ap"){blast_radius=8;blast_damage=440;}
else if(payload=="throwing_blade_explosive"){blast_radius=6;blast_damage=260;}
}
}
