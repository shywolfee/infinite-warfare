int client_arena_id=0;string client_arena_role="none",client_arena_state="none";
string arena_saved_inventory="";
string[] arena_saved_order,arena_saved_quickbar,arena_saved_weapons;
int arena_saved_weapon_index=0;
bool arena_inventory_saved=false;
string arena_client_map(string type){if(type=="sidearms")return "arena_sidearms";if(type=="melee")return "arena_melee";if(type=="explosives")return "arena_explosives";return "arena_open";}
void restore_arena_inventory()
{
if(!arena_inventory_saved)return;
inv=deserialize(arena_saved_inventory);
inventory_order=arena_saved_order;quickbar=arena_saved_quickbar;weapons=arena_saved_weapons;
w=arena_saved_weapon_index;arena_inventory_saved=false;
invalidate_inventory_keys();
}
bool handle_arena_packet(const string &in message)
{
string[] f=string_split(message," ",true);if(f.length()==0)return false;
if(f[0]=="arena_transfer" and f.length()>4){we_map_transfer_active=true;me.x=string_to_number(f[2]);me.y=string_to_number(f[3]);me.z=string_to_number(f[4]);mr.x=me.x;mr.y=me.y;movement_momentum=0;momentum_direction="";destroy_all_sources();distpool.destroy_all();ambpool.destroy_all();speak("Entering arena on "+string_replace(f[1],"_"," ",true)+".");return true;}
if(f[0]=="arena_begin" and f.length()>4){client_arena_id=string_to_number(f[1]);client_arena_role=f[2];client_arena_state="active";string expected=arena_client_map(f[3]);if(mapname!=expected){send_reliable(0,"arena_resync "+client_arena_id,0);speak("The arena map did not finish loading. Requesting it again.");return true;}if(!arena_inventory_saved){arena_saved_inventory=serialize(inv);arena_saved_order=inventory_order;arena_saved_quickbar=quickbar;arena_saved_weapons=weapons;arena_saved_weapon_index=w;arena_inventory_saved=true;}inv.delete_all();inventory_order.resize(0);quickbar.resize(0);weapons.resize(0);invalidate_inventory_keys();string[] loadout=string_split(f[4],",",true);for(uint i=0;i<loadout.length();i++)give(loadout[i],1);if(client_arena_role=="spectator"){can_move=true;speak("Arena started. You are spectating and cannot deal or receive damage.");}else{speak("Arena started. Last combatant standing wins. Your arena loadout is temporary; your ordinary inventory will return after the match.");}return true;}
if(f[0]=="arena_eliminated"){client_arena_role="spectator";client_arena_state="active";can_move=true;speak("You have been eliminated. You are now an invulnerable spectator until the arena finishes.");return true;}
if(f[0]=="arena_finished"){client_arena_id=0;client_arena_role="none";client_arena_state="finished";can_move=true;restore_arena_inventory();string winner=f.length()>2?f[2]:"";speak(winner==""?"The arena finished without a winner.":winner+" won the arena. Your ordinary inventory has been restored.");return true;}
return false;
}
string arena_request(string command,string prefix="arena_",int timeout=3500){send_reliable(0,command,0);string response;if(!wait_for_service_response(prefix,response,timeout)){speak("The arena service did not answer.");return "";}return response;}
string arena_result_text(string response){return string_replace(string_replace(response,"arena_ok ","",false),"arena_error ","",false);}
bool arena_create_dialog()
{
string[] labels={"Open Arsenal: balanced rifle, sidearm, medical and explosive loadout","Sidearm Showdown: pistols, ammunition and compact medical supplies","Close Quarters: melee weapons and compact medical supplies only","Demolition Ring: grenades, defensive equipment and a combat knife"};
string[] ids={"open","sidearms","melee","explosives"};
nv_form f;f.create_window("Create an automatic arena",false,true);nv_form_list_box@ type=f.add_list("Rules and starting loadout","type");for(uint i=0;i<labels.length();i++)type.add(labels[i],ids[i]);type.set_pos(0,false);nv_form_list_box@ role=f.add_list("Your role when the arena begins","role");role.add("Combatant: enter the match with its temporary loadout","combatant");role.add("Spectator: observe without dealing or receiving damage","spectator");role.set_pos(0,false);nv_form_button@ create=f.add_button("Create this public arena; Alt+C","create",true);@create.shortcut=nv_shortcut(KEY_C,alt=true);nv_form_button@ back=f.add_button("Back to public arenas; Alt+B","back",false,true);@back.shortcut=nv_shortcut(KEY_B,alt=true);f.focus_control(type);
while(true){wait(5);f.monitor();if(connected)netloop(false);if(f.is_pressed(back))return false;if(f.is_pressed(create)){string result=arena_request("arena_create "+type.focused_item.id+" "+role.focused_item.id);if(result!="")speak(arena_result_text(result));return string_contains(result,"arena_ok ",1)==0;}}
return false;
}
void arena_manager()
{
while(true)
{
string response=arena_request("arena_list","arena_list ");if(response=="")return;
string overview=arena_request("arena_overview","arena_overview ");if(overview=="")return;
string[] mine=string_split(string_replace(overview,"arena_overview ","",false),"~",false);bool member=mine.length()>=9 and mine[0]!="none";bool host=member and string_to_lower_case(mine[3])==string_to_lower_case(name);bool waiting=member and mine[1]=="waiting";int combatants=member?string_to_number(mine[6]):0;
string my_text="You are not registered in an arena. Create one or select a waiting public arena below.";if(member)my_text="Arena "+mine[0]+", "+mine[4]+". "+mine[1]+". You are a "+mine[2]+". Hosted by "+mine[3]+" on "+mine[5]+". "+mine[6]+" combatants and "+mine[7]+" spectators. Rules: "+mine[8];
string[] entries=string_split(string_replace(response,"arena_list ","",false),";",true);string[][] fields;
nv_form f;f.create_window("Automatic PK Arenas",false,true);nv_form_input@ current=f.add_input("My arena status","my_arena",my_text,"",0,true,true);current.hidden=!member;nv_form_list_box@ list=f.add_list(member?"Other public arena instances":"Public arena instances","arenas");for(uint i=0;i<entries.length();i++){string[] a=string_split(entries[i],"~",false);if(a.length()<7)continue;if(member and a[0]==mine[0])continue;fields.insert_last(a);list.add("Arena "+a[0]+": "+a[1]+", hosted by "+a[2]+", "+a[3]+", "+a[4]+" members",a[0]);}if(list.items.length()==0)list.add(member?"There are no other public arenas.":"No public arenas are currently available.","none");else list.set_pos(0,false);nv_form_input@ detail=f.add_input("Selected arena details","details","Select an arena to read its map and rules.","",0,true,true);list.hidden=member;detail.hidden=member;
nv_form_button@ create=f.add_button("Create a new public arena; Alt+C","create",true);@create.shortcut=nv_shortcut(KEY_C,alt=true);create.enabled=!member;
nv_form_button@ join=f.add_button("Join the selected waiting arena as a combatant; Alt+J","join");@join.shortcut=nv_shortcut(KEY_J,alt=true);join.enabled=!member and fields.length()>0;
nv_form_button@ spectate=f.add_button("Watch the selected waiting arena as an invulnerable spectator; Alt+W","spectate");@spectate.shortcut=nv_shortcut(KEY_W,alt=true);spectate.enabled=!member and fields.length()>0;
nv_form_button@ start=f.add_button("Start my hosted arena when at least two combatants are ready; Alt+S","start");@start.shortcut=nv_shortcut(KEY_S,alt=true);start.enabled=host and waiting and combatants>=2;
nv_form_button@ leave=f.add_button(host?"Close my arena and return every participant; Alt+L":"Leave my arena and return to my previous location; Alt+L","leave");@leave.shortcut=nv_shortcut(KEY_L,alt=true);leave.enabled=member;
create.hidden=member;join.hidden=member;spectate.hidden=member;start.hidden=!(host and waiting);start.enabled=host and waiting;leave.hidden=!member;
nv_form_button@ refresh=f.add_button("Refresh all arena states and participants; Alt+R","refresh");@refresh.shortcut=nv_shortcut(KEY_R,alt=true);nv_form_button@ close=f.add_button("Close automatic arenas; Alt+X","close",false,true);@close.shortcut=nv_shortcut(KEY_X,alt=true);if(member)f.focus_control(current);else f.focus_control(list);int previous=-1;
while(true)
{
wait(5);f.monitor();if(connected)netloop(false);if(f.is_pressed(close))return;
if(list.list_position!=previous){previous=list.list_position;if(previous>=0 and previous<int(fields.length())){string[] a=fields[previous];detail.text="Arena "+a[0]+" uses "+a[5]+". State: "+a[3]+". Host: "+a[2]+". Population: "+a[4]+". Rules: "+a[6];bool selected_waiting=a[3]=="waiting";join.enabled=!member and selected_waiting;spectate.enabled=!member and selected_waiting;}else{detail.text="There is no arena selected.";join.enabled=false;spectate.enabled=false;}}
string command="";if(f.is_pressed(create)){if(arena_create_dialog())break;}else if(f.is_pressed(join) and @list.focused_item!=null and list.focused_item.id!="none")command="arena_join "+list.focused_item.id+" combatant";else if(f.is_pressed(spectate) and @list.focused_item!=null and list.focused_item.id!="none")command="arena_join "+list.focused_item.id+" spectator";else if(f.is_pressed(start))command="arena_start";else if(f.is_pressed(leave))command="arena_leave";else if(f.is_pressed(refresh))break;
if(command!=""){string result=arena_request(command);bool success=string_contains(result,"arena_ok ",1)==0;if(command=="arena_leave" and success)restore_arena_inventory();if(result!="")speak(arena_result_text(result));if(command=="arena_start" and success)return;break;}
}
}
}
