citem@[] citems(0);
class citem
{
int x;
int y;
int z;
string owner;
string name;
string map;
timer deltimer;
timer soundtimer;
citem(int px, int py, int pz, string imap, string pname)
{
map=imap;
x=px;
y=py;
z=pz;
name=pname;
}
}
void citemloop()
{
for(int i=int(citems.length())-1;i>=0;i--)
{
if(citems[i].deltimer.elapsed>180000){citems.remove_at(i);continue;}
if(citems[i].soundtimer.elapsed>2500){citems[i].soundtimer.restart();er_play_at("collectable/loop",citems[i].x,citems[i].y,citems[i].z,citems[i].map);}
for(uint x=0; x<players.length(); x++)
{
if (get_3d_distance(citems[i].x,citems[i].y,citems[i].z,players[x].x,players[x].y,players[x].z)<=2 and players[x].map==citems[i].map and players[x].death==false)
{
er_play_at(string_contains(citems[i].name,"corpse_",1)==0?"collectable/pickup_corpse":"collectable/pickerupper",citems[i].x,citems[i].y,citems[i].z,citems[i].map);
send_unreliable(players[x].peer_id,"give "+citems[i].name+" 1",0);
send_reliable(players[x].peer_id, string_replace(citems[i].name,"_"," ",true), 2);
citems.remove_at(i);
break;
}
}
}
}
void spawn_citem(int x, int y, int z, string map, string name)
{
citem i1(x,y,z,map, name);
citems.insert_last(i1);
}
