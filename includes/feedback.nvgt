// Feedback: suggestions and comments for the developers. Built the same way
// as support tickets -- each screen returns to the one it came from, and an
// item is a list you arrow through. These screens used to reopen each other
// from scratch, so every visit stacked another feedback menu.

void feedback_menu()
{
send_reliable(0, "feedback_check_role", 0);
bool is_staff=false;
string role_response;if(wait_for_service_response("feedback_role_",role_response,2000))is_staff=role_response=="feedback_role_staff";
while(true)
{
string[] labels={"Send new feedback","Your feedback"};
string[] ids={"new","mine"};
if(is_staff){labels.insert_last("All feedback (staff)");ids.insert_last("all");}
string chosen=pick_from_list("Feedback",labels,ids);
if(chosen=="")return;
if(chosen=="new")feedback_submit();
else if(chosen=="mine")feedback_view_my();
else if(chosen=="all")feedback_view_all();
}
}

void feedback_submit()
{
nv_form f;
f.create_window("Send feedback",false,true);
nv_form_input@ subject=f.add_input("Subject","subject");
nv_form_input@ body=f.add_input("Details","body","","",0,false,true);
nv_form_button@ submit=f.add_button("Send","send",true);
nv_form_button@ cancel=f.add_button("Cancel","cancel",false,true);
f.focus_control(subject);
while(true)
{
wait(5);
f.monitor();
if(connected==true) netloop();
if(f.is_pressed(cancel))return;
if(!f.is_pressed(submit))continue;
string subj=subject.text.trim_whitespace();
string text=body.text.trim_whitespace();
if(subj==""){speak("The feedback needs a subject.");f.focus_control(subject);continue;}
if(text==""){speak("Write the details first.");f.focus_control(body);continue;}
subj=string_replace(string_replace(support_encode(subj),"<<NL>>"," ",true),",",";",true);
send_reliable(0,"feedback_create "+name+"|"+subj+"|"+support_encode(text),0);
string result="";
if(wait_for_service_response("feedback_created",result,3000))dlg("Thank you. Your feedback has been sent.");
else dlg("The server did not confirm the feedback, so it may not have been sent. Try again in a moment.");
return;
}
}

void feedback_list(const string &in title,const string &in data,bool with_owner,bool is_staff)
{
string[] labels,ids;
if(data!="" and data!="none")
{
string[] entries=string_split(data,",",false);
for(uint i=0;i<entries.length();i++)
{
string[] parts=string_split(entries[i],"~",false);
if(with_owner)
{
if(parts.length()<4)continue;
labels.insert_last("Feedback "+parts[0]+" from "+parts[1]+": "+parts[2]+", "+parts[3]);
}
else
{
if(parts.length()<3)continue;
labels.insert_last("Feedback "+parts[0]+": "+parts[1]+", "+parts[2]);
}
ids.insert_last(parts[0]);
}
}
if(labels.length()==0){speak("There is no feedback to show.");return;}
while(true)
{
string id=pick_from_list(title+", "+labels.length()+" items",labels,ids);
if(id=="")return;
feedback_view_item(id,is_staff);
}
}

void feedback_view_my()
{
speak("Loading your feedback.");
send_reliable(0,"feedback_list_my "+name,0);
string response;
if(!wait_for_service_response("feedback_mylist ",response,3000)){speak("The server did not send your feedback.");return;}
feedback_list("Your feedback",string_replace(response,"feedback_mylist ","",false),false,false);
}

void feedback_view_all()
{
speak("Loading all feedback.");
send_reliable(0,"feedback_list_all",0);
string response;
if(!wait_for_service_response("feedback_alllist ",response,3000)){speak("The server did not send the feedback.");return;}
feedback_list("All feedback",string_replace(response,"feedback_alllist ","",false),true,true);
}

void feedback_view_item(string fb_id, bool is_staff)
{
while(true)
{
speak("Loading feedback "+fb_id+".");
send_reliable(0,"feedback_get_full "+fb_id,0);
string response;
if(!wait_for_service_response("feedback_data ",response,3000)){speak("The server did not send it.");return;}
string data=string_replace(response,"feedback_data ","",false);
if(data=="" or data=="not_found"){dlg("That feedback no longer exists.");return;}
// Format: id~owner~subject~status~body~reply1~reply2~...
string[] parts=string_split(data,"~",false);
if(parts.length()<5){dlg("The server sent feedback the game could not read.");return;}
string f_status=parts[3];
nv_form f;
f.create_window("Feedback "+parts[0]+": "+parts[2],false,true);
nv_form_list_box@ list=f.add_list("Feedback "+parts[0],"feedback");
list.add("Subject: "+parts[2],"subject");
list.add("From "+parts[1]+", "+f_status,"status");
list.add("Details: "+support_decode(parts[4]),"body");
for(uint i=5;i<parts.length();i++)list.add("Reply "+(i-4)+", "+support_decode(parts[i]),"reply"+(i-4));
nv_form_button@ reply=null;
nv_form_button@ close_item=null;
if(f_status=="open")
{
@reply=f.add_button("Reply","reply");
if(is_staff)@close_item=f.add_button("Close this feedback","close_item");
}
nv_form_button@ back=f.add_button("Back","back",false,true);
f.focus_control(list);
string action="";
while(action=="")
{
wait(5);
f.monitor();
if(connected==true) netloop();
if(f.is_pressed(back))return;
if(@reply!=null and f.is_pressed(reply))action="reply";
else if(@close_item!=null and f.is_pressed(close_item))action="close";
}
if(action=="reply")feedback_reply(fb_id,is_staff);
else if(action=="close" and feedback_close(fb_id,is_staff))return;
}
}

void feedback_reply(string fb_id, bool is_staff)
{
nv_form f;
f.create_window("Reply to feedback "+fb_id,false,true);
nv_form_input@ message=f.add_input("Your reply","reply","","",0,false,true);
nv_form_button@ send=f.add_button("Send reply","send",true);
nv_form_button@ cancel=f.add_button("Cancel","cancel",false,true);
f.focus_control(message);
while(true)
{
wait(5);
f.monitor();
if(connected==true) netloop();
if(f.is_pressed(cancel))return;
if(!f.is_pressed(send))continue;
string text=message.text.trim_whitespace();
if(text==""){speak("The reply is empty.");continue;}
send_reliable(0,"feedback_reply "+fb_id+"|"+name+"|"+support_encode(text),0);
string reply_response;
if(wait_for_service_response("feedback_replied",reply_response,3000))speak("Reply sent.");
else dlg("The server did not accept the reply.");
return;
}
}

// Staff only. True if it was closed.
bool feedback_close(string fb_id, bool is_staff)
{
nv_form f;
f.create_window("Close feedback "+fb_id,false,true);
nv_form_input@ reason=f.add_input("Reason for closing, which the sender will see","reason","","",0,false,true);
nv_form_button@ close_button=f.add_button("Close feedback","close",true);
nv_form_button@ cancel=f.add_button("Cancel","cancel",false,true);
f.focus_control(reason);
while(true)
{
wait(5);
f.monitor();
if(connected==true) netloop();
if(f.is_pressed(cancel))return false;
if(!f.is_pressed(close_button))continue;
string text=reason.text.trim_whitespace();
if(text==""){speak("Give a reason for closing it.");continue;}
send_reliable(0,"feedback_close "+fb_id+"|"+name+"|"+support_encode(text),0);
string close_response;
if(wait_for_service_response("feedback_closed",close_response,3000)){speak("Feedback closed.");return true;}
dlg("The feedback was not closed.");
return false;
}
return false;
}
