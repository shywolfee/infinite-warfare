int invpos;
dictionary inv;
// Stable client-side presentation order. NVGT dictionaries do not promise a
// reorderable key sequence, so inventory navigation keeps an explicit index.
string[] inventory_order;
string[] inventory_transfer_targets;
bool inventory_transfer_targets_received=false;

// Quickbar: 10 slots mapped to number keys 1 through 0.
string[] quickbar = {"", "", "", "", "", "", "", "", "", ""};

// Inventory category system.
string[] inv_categories = {"All", "Weapons", "Ammo", "Explosives", "Healing", "Armour", "Armour Repair", "Weapon Maintenance", "Vehicle Supplies", "Attachments", "Holsters", "Team", "Tools", "Electronics", "Containers", "Equipment"};
int inv_category_index = 0;

string get_item_category(string item)
{
int database_index=content_find(item);
if(database_index>=0)
{
string database_category=content_database[database_index].category;
string[] visible_categories={"Weapons","Ammo","Explosives","Healing","Armour","Armour Repair","Weapon Maintenance","Vehicle Supplies","Attachments","Holsters","Team","Tools","Electronics","Containers","Equipment"};
for(uint c=0;c<visible_categories.length();c++)if(database_category==visible_categories[c])return database_category;
return "Equipment";
}
if (is_weapon(item)) return "Weapons";
// Any registered weapon reserve item is ammunition, regardless of its name.
if (is_ammo_reserve_item(item)) return "Ammo";
if (string_contains(item, "ammo", 1)>-1 or string_contains(item, "magazine", 1)>-1 or string_contains(item, "shell_box", 1)>-1 or string_contains(item, "clip", 1)>-1 or string_contains(item, "mortar_shell", 1)>-1 or string_contains(item, "ammo_belt", 1)>-1 or string_contains(item, "bolt_quiver", 1)>-1 or string_contains(item, "energy_cell", 1)>-1 or string_contains(item, "fuel_canister", 1)>-1) return "Ammo";
if (item=="health_potion" or item=="ultra_health_potion" or item=="life_injection" or string_contains(item, "energetic_potion", 1)>-1 or item=="adrenaline_syringe") return "Healing";
if(item=="bomb_vest")return "Armour";
if(string_contains(item,"grenade",1)>=0 or string_contains(item,"bomb",1)>=0 or string_contains(item,"semtex",1)>=0 or item=="c4" or item=="claymore" or item=="proximity_mine" or item=="torpedo")return "Explosives";
if(string_contains(item,"armor",1)>=0 or string_contains(item,"armour",1)>=0 or string_contains(item,"helmet",1)>=0 or string_contains(item,"vest",1)>=0 or string_contains(item,"greaves",1)>=0)return "Armour";
if(find_attachment_def(item)>=0)return "Attachments";
if(string_contains(item,"team_",1)==0 or item=="duo_plane_kit")return "Team";
if(item=="nanomatic_multitool" or item=="nanomatic_components" or item=="translocator" or item=="binoculars" or item=="hypercomp")return "Utility";
return "Equipment";
}

// Category for a filtered key, resolving virtual partial-ammo keys (which are
// always ammunition) to a real category.
string get_key_category(string key)
{
if (string_contains(key, "__partial__", 1) == 0) return "Ammo";
return get_item_category(key);
}

// Get filtered inventory keys based on current category.
// Includes virtual keys for partial ammo items ("__partial__N").
string[] get_filtered_keys()
{
string[] dictionary_keys=inv.get_keys();
for(int stale=int(inventory_order.length())-1;stale>=0;stale--)if(!inv.exists(inventory_order[stale]))inventory_order.remove_at(stale);
for(uint missing=0;missing<dictionary_keys.length();missing++)if(inventory_order.find(dictionary_keys[missing])<0)inventory_order.insert_last(dictionary_keys[missing]);
string[] all_keys=inventory_order;
// Append virtual keys for each partial ammo item.
for (uint i = 0; i < partial_items.length(); i++)
all_keys.insert_last("__partial__" + i);
// Target category ("" means the All view, which shows everything).
string target = (inv_category_index == 0) ? "" : inv_categories[inv_category_index];
// Walk the one live category registry rather than maintaining a second list.
// Every category exposed by Left/Right navigation must also participate in
// the All view and its own filtered view.
string[] filtered;
if(target=="")
{
for(uint i=0;i<all_keys.length();i++)if(all_keys[i]!="waypoint_marker")filtered.insert_last(all_keys[i]);
return filtered;
}
for (uint c = 1; c < inv_categories.length(); c++)
{
if (target != "" and inv_categories[c] != target) continue;
for (uint i = 0; i < all_keys.length(); i++)
{
if(all_keys[i]=="waypoint_marker")continue;
if (get_key_category(all_keys[i]) == inv_categories[c])
filtered.insert_last(all_keys[i]);
}
}
return filtered;
}

bool inventory_category_has_items(int category_index)
{
if(category_index<0 or category_index>=int(inv_categories.length()))return false;
if(category_index==0)return inv.get_size()>0 or partial_items.length()>0;
string category=inv_categories[category_index];
if(category=="Ammo" and partial_items.length()>0)return true;
string[] keys=inv.get_keys();
for(uint i=0;i<keys.length();i++)if(keys[i]!="waypoint_marker" and get_key_category(keys[i])==category)return true;
return false;
}

void move_inventory_category(int dir)
{
if(!inventory_category_has_items(0)){inv_category_index=0;invpos=0;return;}
int step=dir==1?1:-1;
for(uint checked=0;checked<inv_categories.length();checked++)
{
inv_category_index+=step;
if(inv_category_index>=int(inv_categories.length()))inv_category_index=0;
else if(inv_category_index<0)inv_category_index=int(inv_categories.length())-1;
if(inventory_category_has_items(inv_category_index)){invpos=0;return;}
}
inv_category_index=0;invpos=0;
}

void cycle_category(int dir)
{
move_inventory_category(dir);
string[] filtered = get_filtered_keys();
speak(inv_categories[inv_category_index] + ". " + filtered.length() + " items.");
}

void give(string item, int amount)
{
if(item=="health_potion")item="nanocyte_solution_bottle";else if(item=="ultra_health_potion")item="trauma_repair_serum_bottle";
if(item=="waypoint_marker"){if(inv.exists(item))inv.delete(item);for(int q=0;q<10;q++)if(quickbar[q]==item)quickbar[q]="";return;}
content_ensure_item(item);
int a;
if (!inv.exists(item))
{
if (amount>0)
{inv.set(item,amount);if(inventory_order.find(item)<0)inventory_order.insert_last(item);}
}
else
{
inv.get(item,a);
if (a+amount<=0)
{inv.delete(item);int order_index=inventory_order.find(item);if(order_index>=0)inventory_order.remove_at(order_index);}
else
{
inv.set(item,a+amount);
}
}
}

bool inventory_reorder(string key,int destination)
{
if(string_contains(key,"__partial__",1)==0)return false;
get_filtered_keys();int current=inventory_order.find(key);if(current<0)return false;
string[] visible=get_filtered_keys();int visible_position=visible.find(key);if(visible_position<0)return false;
int target_position=visible_position+destination;
if(destination==-100000)target_position=0;else if(destination==100000)target_position=int(visible.length())-1;
if(target_position<0 or target_position>=int(visible.length()) or target_position==visible_position)return false;
string target_key=visible[target_position];if(string_contains(target_key,"__partial__",1)==0)return false;
int target=inventory_order.find(target_key);if(target<0)return false;
inventory_order[current]=target_key;inventory_order[target]=key;
return true;
}

void inventory_request_transfer_targets()
{
inventory_transfer_targets.resize(0);inventory_transfer_targets_received=false;send_reliable(0,"inventory_transfer_targets",0);timer request_timer;
while(connected and !inventory_transfer_targets_received and request_timer.elapsed<2500){wait(5);netloop();}
}

void inventory_give_to_nearby_player(string item)
{
if(string_contains(item,"__partial__",1)==0){speak("Partial ammunition containers cannot be transferred directly.");return;}
inventory_request_transfer_targets();if(!inventory_transfer_targets_received){speak("The server did not return nearby players.");return;}if(inventory_transfer_targets.length()==0){speak("There are no players within ten tiles.");return;}
nv_form f;f.create_window("Give "+string_replace(item,"_"," ",true),false,true);nv_form_list_box@ people=f.add_list("Players within ten tiles","players");for(uint i=0;i<inventory_transfer_targets.length();i++)people.add(inventory_transfer_targets[i],inventory_transfer_targets[i]);nv_form_button@ give_button=f.add_button("Give one item","give",true);nv_form_button@ cancel=f.add_button("Cancel","cancel",false,true);f.focus_control(people);
while(true){wait(5);f.monitor();if(connected)netloop();if(f.is_pressed(cancel))return;if(f.is_pressed(give_button)){int selected=people.list_position;if(selected<0 or selected>=int(inventory_transfer_targets.length())){speak("Select a player first.");continue;}send_reliable(0,"inventory_transfer "+inventory_transfer_targets[selected]+" "+item,0);return;}}
}
void cycle_inv(int dir)
{
string[] filtered = get_filtered_keys();
if (filtered.length() == 0)
{
if (inv_category_index == 0)
speak("No items");
else
speak("No items in " + inv_categories[inv_category_index]);
return;
}
if (dir==1)
invpos+=1;
else
invpos-=1;
if (invpos>=int(filtered.length()))
{
invpos=0;
}
else if (invpos<0)
{
invpos=int(filtered.length())-1;
}
string key = filtered[invpos];
if (string_contains(key, "__partial__", 1) == 0)
{
// Partial ammo item — magazines show capacity remaining, energy/fuel show percent.
int pidx = string_to_number(string_replace(key, "__partial__", "", false));
if (pidx >= 0 and pidx < int(partial_items.length()))
{
string base_name = string_replace(partial_items[pidx].base_item, "_", " ", true);
string amt = partial_amount_label(partial_items[pidx].base_item, partial_items[pidx].remaining, partial_items[pidx].max_capacity);
speak(base_name + " (" + amt + ", " + ammunition_display_name(partial_items[pidx].ammunition) + "). " + (invpos+1) + " of " + filtered.length());
}
}
else
{
int a;
inv.get(key, a);
string display_name;
if (is_weapon(key))
display_name = get_weapon_display_name(key);
else
{int content_index=content_find(key);display_name=content_index>=0?content_database[content_index].display_name:string_replace(key, "_", " ", true);}
if (is_ammo_container(key))
speak(display_name + " (" + a + "). " + (invpos+1) + " of " + filtered.length());
else if(a==1)
speak(display_name+". "+(invpos+1)+" of "+filtered.length());
else
speak(a+" "+display_name+"s. "+(invpos+1)+" of "+filtered.length());
}
}

// Get the currently selected item key (respecting category filter).
string get_selected_item()
{
string[] filtered = get_filtered_keys();
if (filtered.length() == 0) return "";
if (invpos >= int(filtered.length())) invpos = 0;
return filtered[invpos];
}

int count_total_items()
{
int amount=0;string[] keys=inv.get_keys();
for (uint i=0; i<keys.length(); i++)
{
int a;
inv.get(keys[i],a);
amount+=a;
}
amount += int(partial_items.length());
return amount;
}
int get_item_count(string item)
{
int amount=0;inv.get(item,amount);return amount;
}

// Returns true if the item is an ammo container that holds individual rounds
// (ammo belts, shell boxes, bolt quivers) rather than discrete units like magazines.
bool is_ammo_container(string item)
{
if (string_contains(item, "ammo_belt", 1)>-1) return true;
if (string_contains(item, "shell_box", 1)>-1) return true;
if (string_contains(item, "bolt_quiver", 1)>-1) return true;
return false;
}

// Returns true if the item is a drawable weapon (ranged or melee).
bool is_weapon(string item)
{
for(uint i=0;i<wpn_cache.length();i++) if(wpn_cache[i].id==item) return true;
return false;
}

// Bind the currently selected inventory item to a quickbar slot (0-9).
void bind_quickbar(int slot)
{
if (inv.get_size()==0)
{
speak("Inventory is empty.");
return;
}
string item = get_selected_item();
if (item == "")
{
speak("No item selected.");
return;
}
quickbar[slot]=item;
speak(string_replace(item, "_", " ", true)+" bound to slot "+(slot+1)+".");
}
