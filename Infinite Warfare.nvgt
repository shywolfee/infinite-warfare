if(sd.d.exists("voice_input_test_playback")) voice_input_test_playback=sd.readn("voice_input_test_playback")>=1;
if(sd.d.exists("voice_hear_self")) voice_hear_self=sd.readn("voice_hear_self")>=1;
if(sd.d.exists("auto_bind_starting_loadout")) auto_bind_starting_loadout=sd.readn("auto_bind_starting_loadout")>=1;
if(sd.d.exists("replace_occupied_attachments"))replace_occupied_attachments=sd.readn("replace_occupied_attachments")>=1;
if(sd.d.exists("hear_own_projectile_audio"))hear_own_projectile_audio=sd.readn("hear_own_projectile_audio")>=1;
if(sd.d.exists("audio_form_sound_feedback"))audio_form_sound_feedback=sd.readn("audio_form_sound_feedback")>=1;
if(sd.d.exists("acoustic_occlusion_enabled"))acoustic_occlusion_enabled=sd.readn("acoustic_occlusion_enabled")>=1;
if(sd.d.exists("configured_operating_system"))configured_operating_system=sd.read("configured_operating_system");else configured_operating_system=system_is_mobile?"Android":"Windows";
if(sd.d.exists("configured_touchscreen"))configured_touchscreen=sd.readn("configured_touchscreen")>=1;
if(sd.d.exists("helper_visual_hud"))helper_visual_hud=sd.readn("helper_visual_hud")>=1;
if(sd.d.exists("helper_desktop_notifications"))helper_desktop_notifications=sd.readn("helper_desktop_notifications")>=1;
if(sd.d.exists("helper_tray_controls"))helper_tray_controls=sd.readn("helper_tray_controls")>=1;
if(sd.d.exists("helper_voice_commands"))helper_voice_commands=sd.readn("helper_voice_commands")>=1;
if(sd.d.exists("helper_voice_wake_phrase"))helper_voice_wake_phrase=sd.read("helper_voice_wake_phrase");
if(sd.d.exists("helper_mouse_shortcuts"))helper_mouse_shortcuts=sd.readn("helper_mouse_shortcuts")>=1;
if(sd.d.exists("helper_mouse_confined"))helper_mouse_confined=sd.readn("helper_mouse_confined")>=1;
if(sd.d.exists("helper_mouse_wheel_inventory"))helper_mouse_wheel_inventory=sd.readn("helper_mouse_wheel_inventory")>=1;
if(sd.d.exists("helper_mouse_invert_vertical"))helper_mouse_invert_vertical=sd.readn("helper_mouse_invert_vertical")>=1;
if(sd.d.exists("helper_mouse_turn_sensitivity"))helper_mouse_turn_sensitivity=sd.readn("helper_mouse_turn_sensitivity");
if(sd.d.exists("helper_mouse_aim_sensitivity"))helper_mouse_aim_sensitivity=sd.readn("helper_mouse_aim_sensitivity");
if(helper_mouse_turn_sensitivity<10)helper_mouse_turn_sensitivity=10;if(helper_mouse_turn_sensitivity>300)helper_mouse_turn_sensitivity=300;
if(helper_mouse_aim_sensitivity<10)helper_mouse_aim_sensitivity=10;if(helper_mouse_aim_sensitivity>300)helper_mouse_aim_sensitivity=300;
if(sd.d.exists("netaddress"))netaddress=sd.read("netaddress");
if(sd.d.exists("netport")){int saved_port=sd.readn("netport");if(saved_port>0 and saved_port<=65535)netport=saved_port;}
}
