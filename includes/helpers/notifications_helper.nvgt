// Windows toast notifications and a tray icon, over the NVGT Helpers
// notifications plugin.
//
// The plugin's calls take strings, and a toast is only shown as coming from
// an application whose ID matches a Start menu shortcut carrying that same ID:
//   set_app_id(app_id)
//   install_shortcut(app_id, display_name)
// The upstream helper passed a number to the first and the two arguments of
// the second the wrong way round, which produced a shortcut called by the
// number and toasts sent under an ID nothing had registered.
#pragma plugin notifications
class notifications_helper
{
uint64 handle;
toast_notifier n;
tray_icon t;
string app_id;
string name;
string last_action;
bool clicked=false;
int selected_item=-1;
bool registered=false;
notifications_helper(const string &in app_id,const string &in name)
{
this.app_id=app_id;this.name=name;
handle=get_window_os_handle();
}
// Idempotent: reinstalling the shortcut also repairs one that was moved or
// deleted, and costs nothing when it is already right.
bool register()
{
n.set_app_id(app_id);
registered=n.install_shortcut(app_id,name);
return registered;
}
// Call every frame. The values are only good until the next call.
void update()
{
last_action=n.get_action();
clicked=t.is_clicked();
selected_item=t.get_menu_click();
}
bool show(const string &in title,const string &in body)
{
if(!registered)register();
return n.show(title,body);
}
bool show(const string &in title,const string &in body,const string &in buttons,const string &in actions)
{
if(!registered)register();
return n.show(title,body,buttons,actions);
}
bool add_to_tray(){return t.add(name);}
void remove_from_tray(){t.remove();}
void set_tray_name(const string &in tip){t.set_tooltip(tip);}
void set_tray_items(const string &in items){t.set_menu_items(items);}
void hide_window(){t.hide_window(handle);}
void show_window(){t.show_window(handle);}
string get_selected_action(){return last_action;}
int get_selected_item(){return selected_item;}
}
