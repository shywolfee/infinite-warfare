string[] suppressed_weapons;
bool ballista=false;
timer ballistatimer;
bool bunkerbomb;
timer bunkerbombtimer;
bool see=true;
bool semtex=false;
timer semtextimer;
timer smokebombtimer;
bool ultra_health_potion=false;
timer ultra_health_potiontimer;
bool kills2=false;
bool kills1=false;
bool kills3=false;
int kills=0;
int credits=0;
int bunkers_owned=0;
bool has_hypercomp=false;
bool[] bunker_monitor;
string mate="";
timer torpedotimer;
timer fraggrenadetimer;
timer fake_itemtimer;
timer bombvesttimer;
int bombvesttime=0;
timer usehealth_potiontimer;
bool usehealth_potion=false;
timer health_potiontimer;
bool bombveston;
string hitby="no one";
int health=1000;
int x;
int y;
int z;
double model_x,model_y,model_z,model_target_x,model_target_y,model_target_z;
double model_vx=0,model_vy=0,model_vz=0;
timer model_motion_timer;
string map;
string zone;
string name;
int peer_id;
bool dev;
bool admin=false;
int facing=0;
bool invisible=false;
timer invisibilitytimer;
timer sendtriptimer;
bool afk=false;
timer msg_timer;
int msg_count=0;
int last_x=0;
int last_y=0;
int last_z=0;
timer move_timer;
int teleport_warnings=0;
timer fire_timer;
int rapid_fire_warnings=0;
int consecutive_shots=0;
string current_weapon="";
int server_firetime=500;
int server_walktime=200;
string armor_head="",armor_torso="",armor_arms="",armor_legs="";
int armor_head_durability=0,armor_torso_durability=0,armor_arms_durability=0,armor_legs_durability=0;
int equipped_armor_weight=0;
bool burning=false;
timer burning_duration_timer;
timer burning_tick_timer;
string burning_owner="";
bool bleeding=false;
timer bleeding_duration_timer;
timer bleeding_tick_timer;
string bleeding_owner="";
player(int px, int py, int pz, string pmap, string pname, int ppeer_id)
{
map=pmap;
x=px;
y=py;
z=pz;
model_x=px;model_y=py;model_z=pz;
model_target_x=px;model_target_y=py;model_target_z=pz;
name=pname;
peer_id=ppeer_id;
}
}

string[] server_weapon_attachments(player@ p,string weapon_name){string[] result;string data;if(!p.weapon_attachment_state.get(weapon_name,data) or data=="")return result;return string_split(data,"|",true);}
bool server_weapon_has_attachment(player@ p,string weapon_name,string attachment){string[] items=server_weapon_attachments(p,weapon_name);for(uint i=0;i<items.length();i++)if(items[i]==attachment)return true;return false;}
void server_attach_weapon(player@ p,string weapon_name,string attachment){if(server_weapon_has_attachment(p,weapon_name,attachment))return;string data;p.weapon_attachment_state.get(weapon_name,data);if(data!="")data+="|";data+=attachment;p.weapon_attachment_state.set(weapon_name,data);}
void server_detach_weapon(player@ p,string weapon_name,string attachment){string[] items=server_weapon_attachments(p,weapon_name);string data="";for(uint i=0;i<items.length();i++)if(items[i]!=attachment){if(data!="")data+="|";data+=items[i];}p.weapon_attachment_state.set(weapon_name,data);}

string armor_region_for(string item){if(string_contains(item,"patch",1)>=0 or item=="aramid_repair_tape" or item=="ceramic_plate_epoxy" or item=="armor_rivet_pack")return "";if(string_contains(item,"helmet",1)>=0)return "head";if(string_contains(item,"vest",1)>=0 or string_contains(item,"carrier",1)>=0)return "torso";if(string_contains(item,"sleeves",1)>=0 or string_contains(item,"arm_guards",1)>=0)return "arm";if(string_contains(item,"greaves",1)>=0 or string_contains(item,"leg_",1)>=0)return "leg";return "";}
int armor_rating_for(string item){if(string_contains(item,"heavy",1)>=0)return 55;if(string_contains(item,"plate",1)>=0 or string_contains(item,"ballistic",1)>=0)return 40;return 25;}
int armor_durability_for(string item){if(string_contains(item,"heavy",1)>=0)return 1800;if(string_contains(item,"plate",1)>=0 or string_contains(item,"ballistic",1)>=0)return 1250;return 800;}
int armor_weight_for(string item){if(item=="")return 0;if(string_contains(item,"heavy",1)>=0)return 12;if(string_contains(item,"plate",1)>=0 or string_contains(item,"ballistic",1)>=0)return 7;return 3;}
void send_player_armor_state(player@ p){send_reliable(p.peer_id,"armor_state "+(p.armor_head==""?"none":p.armor_head)+" "+p.armor_head_durability+" "+(p.armor_torso==""?"none":p.armor_torso)+" "+p.armor_torso_durability+" "+(p.armor_arms==""?"none":p.armor_arms)+" "+p.armor_arms_durability+" "+(p.armor_legs==""?"none":p.armor_legs)+" "+p.armor_legs_durability+" "+p.equipped_armor_weight,0);}
void update_player_armor_weight(player@ p){p.equipped_armor_weight=armor_weight_for(p.armor_head)+armor_weight_for(p.armor_torso)+armor_weight_for(p.armor_arms)+armor_weight_for(p.armor_legs);send_player_armor_state(p);}
void equip_player_armor(player@ p,string item){string region=armor_region_for(item);if(region=="")return;string old="";if(region=="head")old=p.armor_head;else if(region=="torso")old=p.armor_torso;else if(region=="arm")old=p.armor_arms;else old=p.armor_legs;if(old==item){send_reliable(p.peer_id,"That armour is already equipped in the "+region+" slot.",2);return;}if(old!="")send_reliable(p.peer_id,"give "+old+" 1",0);int durability=armor_durability_for(item);if(region=="head"){p.armor_head=item;p.armor_head_durability=durability;}else if(region=="torso"){p.armor_torso=item;p.armor_torso_durability=durability;}else if(region=="arm"){p.armor_arms=item;p.armor_arms_durability=durability;}else{p.armor_legs=item;p.armor_legs_durability=durability;}send_reliable(p.peer_id,"give "+item+" -1",0);update_player_armor_weight(p);play("armor_equip",p.x,p.y,p.z,p.map);send_reliable(p.peer_id,"Armour equipped in the "+region+" slot. Durability "+durability+". Total armour weight "+p.equipped_armor_weight+".",2);}
void unequip_player_armor(player@ p,string region){string item="";if(region=="head"){item=p.armor_head;p.armor_head="";p.armor_head_durability=0;}else if(region=="torso"){item=p.armor_torso;p.armor_torso="";p.armor_torso_durability=0;}else if(region=="arm"){item=p.armor_arms;p.armor_arms="";p.armor_arms_durability=0;}else if(region=="leg"){item=p.armor_legs;p.armor_legs="";p.armor_legs_durability=0;}if(item==""){send_reliable(p.peer_id,"That armour slot is already empty.",2);return;}send_reliable(p.peer_id,"give "+item+" 1",0);update_player_armor_weight(p);play("armor_remove",p.x,p.y,p.z,p.map);send_reliable(p.peer_id,"Removed "+item+" from the "+region+" slot.",2);}
int mitigate_player_armor(player@ p,string region,int damage){string item="";int durability=0;if(region=="head"){item=p.armor_head;durability=p.armor_head_durability;}else if(region=="torso"){item=p.armor_torso;durability=p.armor_torso_durability;}else if(region=="arm"){item=p.armor_arms;durability=p.armor_arms_durability;}else if(region=="leg"){item=p.armor_legs;durability=p.armor_legs_durability;}if(item=="" or durability<=0)return damage;int absorbed=int(double(damage)*double(armor_rating_for(item))/100.0);if(absorbed>durability)absorbed=durability;durability-=absorbed;if(region=="head")p.armor_head_durability=durability;else if(region=="torso")p.armor_torso_durability=durability;else if(region=="arm")p.armor_arms_durability=durability;else p.armor_legs_durability=durability;play(durability<=0?"armor_break":"armor_impact"+random(1,3),p.x,p.y,p.z,p.map);if(durability<=0){if(region=="head")p.armor_head="";else if(region=="torso")p.armor_torso="";else if(region=="arm")p.armor_arms="";else p.armor_legs="";send_reliable(p.peer_id,"Your "+item+" broke.",2);update_player_armor_weight(p);}else send_player_armor_state(p);return damage-absorbed;}
bool apply_armor_patch(player@ p,string patch)
{
string region="",required="";if(string_contains(patch,"helmet",1)>=0)region="head";else if(string_contains(patch,"arm_",1)>=0 or string_contains(patch,"sleeve",1)>=0)region="arm";else if(string_contains(patch,"leg_",1)>=0 or patch=="greave_patch")region="leg";else region="torso";
string item="";int durability=0;if(region=="head"){item=p.armor_head;durability=p.armor_head_durability;}else if(region=="torso"){item=p.armor_torso;durability=p.armor_torso_durability;}else if(region=="arm"){item=p.armor_arms;durability=p.armor_arms_durability;}else{item=p.armor_legs;durability=p.armor_legs_durability;}if(item==""){send_reliable(p.peer_id,"No armour is equipped in the compatible "+region+" slot.",2);return false;}
bool compatible=patch=="aramid_repair_tape"?(string_contains(item,"light",1)>=0 or string_contains(item,"soft",1)>=0 or string_contains(item,"kevlar",1)>=0):patch=="ceramic_plate_epoxy"?(string_contains(item,"ballistic",1)>=0 or string_contains(item,"plate",1)>=0):patch=="armor_rivet_pack"?string_contains(item,"heavy",1)>=0:string_contains(patch,string_contains(item,"heavy",1)>=0?"heavy":(string_contains(item,"ballistic",1)>=0?"ballistic":"light"),1)>=0 or string_contains(patch,string_contains(item,"plate_carrier",1)>=0?"plate_carrier":(string_contains(item,"soft_armor",1)>=0?"soft_armor":(string_contains(item,"kevlar",1)>=0?"kevlar":(string_contains(item,"greaves",1)>=0?"greave":"none"))),1)>=0;
if(!compatible){send_reliable(p.peer_id,"That patch is not compatible with "+string_replace(item,"_"," ",true)+".",2);return false;}int maximum=armor_durability_for(item);int ceiling=int(maximum*.60);if(durability>=ceiling){send_reliable(p.peer_id,"Field patches cannot improve this armour beyond sixty percent durability.",2);return false;}int restored=int(maximum*.07);if(durability+restored>ceiling)restored=ceiling-durability;durability+=restored;if(region=="head")p.armor_head_durability=durability;else if(region=="torso")p.armor_torso_durability=durability;else if(region=="arm")p.armor_arms_durability=durability;else p.armor_legs_durability=durability;send_reliable(p.peer_id,"give "+patch+" -1",0);send_player_armor_state(p);play("armor_repair",p.x,p.y,p.z,p.map);send_reliable(p.peer_id,"Patched "+string_replace(item,"_"," ",true)+" for "+restored+" durability. Current durability "+durability+" of "+maximum+"; field patches cannot exceed sixty percent.",2);return true;
}
void set_player_model_target(player@ p,int nx,int ny,int nz)
{
double dx=double(nx)-p.model_x,dy=double(ny)-p.model_y,dz=double(nz)-p.model_z;
if(sqrt(dx*dx+dy*dy+dz*dz)>2.25){p.model_x=nx;p.model_y=ny;p.model_z=nz;p.model_vx=0;p.model_vy=0;p.model_vz=0;}
p.model_target_x=nx;p.model_target_y=ny;p.model_target_z=nz;
}
void update_player_physical_model(player@ p)
{
double dt=double(p.model_motion_timer.elapsed)/1000.0;if(dt<.005)return;if(dt>.08)dt=.08;p.model_motion_timer.restart();double dx=p.model_target_x-p.model_x,dy=p.model_target_y-p.model_y,dz=p.model_target_z-p.model_z;double distance=sqrt(dx*dx+dy*dy+dz*dz);if(distance<.002){p.model_x=p.model_target_x;p.model_y=p.model_target_y;p.model_z=p.model_target_z;p.model_vx=0;p.model_vy=0;p.model_vz=0;return;}double speed=1000.0/double(p.server_walktime>0?p.server_walktime:200);double desired_x=dx/distance*speed,desired_y=dy/distance*speed,desired_z=dz/distance*speed;double response=dt*18.0;if(response>1)response=1;p.model_vx+=(desired_x-p.model_vx)*response;p.model_vy+=(desired_y-p.model_vy)*response;p.model_vz+=(desired_z-p.model_vz)*response;double step=sqrt(p.model_vx*p.model_vx+p.model_vy*p.model_vy+p.model_vz*p.model_vz)*dt;if(step>=distance){p.model_x=p.model_target_x;p.model_y=p.model_target_y;p.model_z=p.model_target_z;p.model_vx=0;p.model_vy=0;p.model_vz=0;}else{p.model_x+=p.model_vx*dt;p.model_y+=p.model_vy*dt;p.model_z+=p.model_vz*dt;}
}
void playerloop()
{
for(uint i=0; i<players.length(); i++)
{
update_player_physical_model(players[i]);
if(players[i].burning)
{
if(players[i].burning_duration_timer.elapsed>=8000)players[i].burning=false;
else if(players[i].burning_tick_timer.elapsed>=1000){players[i].burning_tick_timer.restart();players[i].health-=35;players[i].hitby=players[i].burning_owner+"'s incendiary fire";play("incendiary_burn",players[i].x,players[i].y,players[i].z,players[i].map);}
}
if(players[i].bleeding)
{
if(players[i].bleeding_duration_timer.elapsed>=10000)players[i].bleeding=false;
else if(players[i].bleeding_tick_timer.elapsed>=2000){players[i].bleeding_tick_timer.restart();players[i].health-=18;players[i].hitby=players[i].bleeding_owner+"'s ballistic wound";send_reliable(players[i].peer_id,"play_s bleeding_tick"+random(1,3)+".ogg",0);}
}
if(players[i].health>=1001)
{
players[i].health=1000;
}
if(players[i].kills==3 and players[i].kills1==false)
{
players[i].kills1=true;
send_reliable(players[i].peer_id, "You've reached 3 kills! You receive 5 frag grenades.", 2);
send_reliable(players[i].peer_id, "play_s killachievement.ogg", 0);
send_reliable(players[i].peer_id, "give frag_grenade 5", 0);
}
if(players[i].kills==5 and players[i].kills2==false)
{
players[i].kills2=true;
players[i].credits+=40;
send_reliable(players[i].peer_id, "You've reached 5 kills! You receive an ultra health potion and 40 bonus credits! Total credits: "+players[i].credits, 2);
send_reliable(players[i].peer_id, "give ultra_health_potion 1", 0);
send_reliable(players[i].peer_id, "play_s killachievement.ogg", 0);
save_player_credits(players[i].name, players[i].credits);
}
if(players[i].kills==10 and players[i].kills3==false)
{
players[i].kills3=true;
players[i].credits+=75;
send_reliable(players[i].peer_id, "You've reached 10 kills! 75 bonus credits! Total credits: "+players[i].credits, 2);
send_reliable(players[i].peer_id, "play_s killachievement.ogg", 0);
save_player_credits(players[i].name, players[i].credits);
}
if(players[i].sendtriptimer.elapsed>1500)
{
players[i].sendtriptimer.restart();
send_reliable(players[i].peer_id, "csh "+n.get_peer_average_round_trip_time(players[i].peer_id), 4);
}
if(players[i].ballista==true and players[i].ballistatimer.elapsed>2350)
{
players[i].ballista=false;
play("ballistafire"+random(1,3), players[i].x, players[i].y, players[i].z, players[i].map, i);
send_reliable(0,"distsound ballistadist.ogg "+ballistas[i].x+" "+ballistas[i].y+" "+ballistas[i].z+" "+ballistas[i].map,0);
send_reliable(players[i].peer_id, "movestart", 0);
spawn_weapon(players[i].x,players[i].y,players[i].z,players[i].facing,players[i].turn,"ballista",players[i].name,players[i].map);
}
if(players[i].watertanktimer.elapsed>=7500 and players[i].use_watertank==true)
{
players[i].use_watertank=false;
send_reliable(0, "src 0 500 0 500 -50 -45 floodstart.ogg", 0);
send_reliable(0, "src 0 500 0 500 -30 10 flooddist.ogg 100", 0);
spawn_flood();
send_reliable(players[i].peer_id, "movestart", 0);
}
if(players[i].buckettimer.elapsed>=10000 and players[i].use_bucket==true)
{
players[i].use_bucket=false;
send_reliable(players[i].peer_id, "movestart", 0);
}
if(players[i].life_injectiontimer.elapsed>=6850 and players[i].life_injection==true)
{
players[i].life_injectiontimer.restart();
send_reliable(0, players[i].revive_target+" is revived.", 2);
players[i].life_injection=false;
send_reliable(players[i].peer_id, "movestart", 0);
int index2=get_player_index_from(players[i].revive_target);
if(index2>-1)
{
send_reliable(players[index2].peer_id, "revive", 0);
players[index2].death=false;
}
}
if(players[i].usehealth_potiontimer.elapsed>2000 and players[i].usehealth_potion==true)
{
players[i].usehealth_potion=false;
send_reliable(players[i].peer_id, "movestart", 0);
}
if(players[i].ultra_health_potiontimer.elapsed>4400 and players[i].ultra_health_potion==true)
{
players[i].ultra_health_potion=false;
send_reliable(players[i].peer_id, "movestart", 0);
}
if(players[i].bombvesttimer.elapsed>1500 and players[i].bombveston==true)
{
players[i].bombvesttimer.restart();
players[i].bombvesttime+=1;
play("bombvesttimer", players[i].x, players[i].y, players[i].z, players[i].map, i);
}
if(players[i].bombveston==true and players[i].bombvesttime>=20)
{
players[i].bombvesttime=0;
players[i].bombveston=false;
spawn_bomb(players[i].x,players[i].y,players[i].z,players[i].map,players[i].name);
//haha
}
if(players[i].invisibilitytimer.elapsed>15000 and players[i].invisible==true)
{
players[i].see=true;
players[i].invisible=false;
}
if(players[i].semtextimer.elapsed>4500 and players[i].semtex==true)
{
send_reliable(players[i].peer_id, "movestart", 0);
players[i].semtex=false;
}
if(players[i].bunkerbombtimer.elapsed>3200 and players[i].bunkerbomb==true)
{
play("bunkerbombwarn",players[i].x,players[i].y,players[i].z,players[i].map);
send_reliable(0,"distsound bunkerbombwarndist.ogg "+players[i].x+" "+players[i].y+" "+players[i].z+" "+players[i].map,0);
send_reliable(players[i].peer_id, "movestart", 0);
players[i].bunkerbomb=false;
} 

if(players[i].health<=0 and players[i].death==false)
{
string killer;
{
for(uint e=0; e<players.length(); e++)
{
if(string_contains(players[i].hitby,players[e].name,1)>-1)
{
killer=players[e].name;
}
}
int p=get_player_index_from(killer);
if(p>-1 and p!=int(i))
{
string grief_key=players[p].name+":"+players[i].name;
double gc=0;
double gw=0;
grief_counts.get(grief_key, gc);
grief_windows.get(grief_key, gw);
double now=uptimer.elapsed;
if(gc>=10 and (now-gw)<900000)
{
players[i].health=1000;
send_reliable(players[p].peer_id, "Kill denied. You have killed this player too many times recently.", 2);
continue;
}
if(gc==0 or (now-gw)>=900000)
{
grief_windows.set(grief_key, now);
gc=0;
}
gc+=1;
grief_counts.set(grief_key, gc);
players[p].kills+=1;
int kill_credits=random(10,20);
players[p].credits+=kill_credits;
add_team_points_for_player(players[p].name, kill_credits);
send_reliable(players[p].peer_id, "+" + kill_credits + " credits for the kill! Total: " + players[p].credits, 2);
save_player_credits(players[p].name, players[p].credits);
}
}

int dead_team=get_team_index_for_member(players[i].name);
if (dead_team>-1) team_notice(dead_team, players[i].name+" was downed. A nearby teammate can use a life injection or Team Revive Kit.");
send_reliable(0,killmsg(players[i].name,players[i].hitby,players[i].map,players[i].zone),2);
send_reliable(0, "play_s killalert.ogg", 0);
send_reliable(players[i].peer_id, "death", 0);
play("death",players[i].x, players[i].y, players[i].z, players[i].map, i);
spawn_corpse(players[i].x, players[i].y, players[i].z, players[i].map, players[i].inv, players[i].ammo);
spawn_bodyfall(players[i].x, players[i].y, players[i].z, players[i].map, 3000);
for(uint b=0; b<bunkers.length(); b++)
{
if(bunkers[b].owner==players[i].name)
{
bunkers[b].owner="";
send_reliable(0, bunkers[b].name+" has been released. Its owner, "+players[i].name+", has fallen.", 2);
}
}
players[i].bunkers_owned=0;
players[i].has_hypercomp=false;
players[i].death=true;
}
}
}
void save_player_credits(string pname, int amount)
{
string path="accounts/"+string_to_lower_case(pname)+".dat";
if(!file_exists(path)) return;
savedata acct(path, ACCOUNT_SECRET);
acct.load();
acct.add("credits", double(amount));
acct.save();
}
int load_player_credits(string pname)
{
string path="accounts/"+string_to_lower_case(pname)+".dat";
if(!file_exists(path)) return 0;
savedata acct(path, ACCOUNT_SECRET);
acct.load();
return int(acct.readn("credits"));
}
void spawn_player(int x, int y, int z, string map, string name,int pi)
{
player p1(x,y,z,map,name,pi);
p1.credits=load_player_credits(name);
p1.last_x=x;
p1.last_y=y;
p1.last_z=z;
players.insert_last(p1);
send_reliable(0, "online "+x+" "+y+" "+z+" "+name+" "+map, 0);
}
int get_nearest_player(int px, int py, int pz, string pmap, int pindex=-1)
{
int current_distance=-1;
int final_index=-1;
for(uint i=0; i<players.length(); i++)
{
if(players[i].map!=pmap or i==pindex or players[i].invisible or players[i].death==true)
{
continue;
}
int dist=get_3d_distance(px, py, pz, players[i].x, players[i].y, players[i].z);
if(current_distance==-1)
{
current_distance=dist;
final_index=i;
}
else
{
if(dist<current_distance)
{
current_distance=dist;
final_index=i;
}
}
}
return final_index;
}
