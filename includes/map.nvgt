// Player-facing display name for a map identifier. Map identifiers must stay
// single tokens (no spaces) because they travel inside space-delimited network
// messages such as spawn_player, so a friendly name with spaces is mapped here
// instead of being stored on the map itself.
string map_protocol_id(string name)
{
if (name=="Ghost Town" or name=="freeforall") return "freeforall";
if (name=="Coruscant" or name=="habitat_alpha") return "habitat_alpha";
if (name=="Shattersea" or name=="battlegrounds") return "battlegrounds";
if (name=="Freya's Ascent" or name=="freyas_ascent") return "freyas_ascent";
return string_replace(name, " ", "_", false);
}
string map_display_name(string id)
{
id=map_protocol_id(id);
if (id=="freeforall") return "Ghost Town";
if (id=="habitat_alpha") return "Coruscant";
if (id=="battlegrounds") return "Shattersea";
if (id=="freyas_ascent") return "Freya's Ascent";
return id;
}

string oldzone="";
void checkzone()
{
string newzone=get_dynamic_or_static_zone_at(me.x,me.y,me.z);
if (newzone!=oldzone)
{
if(newzone!="") speak(newzone);
oldzone=newzone;
}
}
string[] map;
string[] zones;
class map_region
{
int minx; int maxx; int miny; int maxy; int minz; int maxz;
string value;
map_region(int ax, int bx, int ay, int by, int az, int bz, string v)
{ minx=ax; maxx=bx; miny=ay; maxy=by; minz=az; maxz=bz; value=v; }
bool contains(int x, int y, int z)
{ return minx<=x and maxx>=x and miny<=y and maxy>=y and minz<=z and maxz>=z; }
}
map_region@[] tile_regions;
map_region@[] zone_regions;
map_region@[] acoustic_regions;
map_region@[] portal_regions;
map_region@[] landmark_regions;
// One grid per rectangle layer. These replace a linear scan over every
// rectangle on the map plus a coordinate-keyed dictionary that was never
// pruned: on a city-sized map the scan was tens of thousands of comparisons
// per footstep and the cache grew until it held an entry for every cubic
// metre the player had ever occupied.
region_grid tile_grid,zone_grid,acoustic_grid,portal_grid;
void rebuild_map_indexes()
{
tile_grid.build(@tile_regions);
zone_grid.build(@zone_regions);
acoustic_grid.build(@acoustic_regions);
portal_grid.build(@portal_regions);
}
// Point of Interest (POI) system.
class poi
{
int x;
int y;
int z;
string name;
poi(int px, int py, int pz, string pname)
{
x=px;
y=py;
z=pz;
name=pname;
}
}
poi@[] pois;
// Turbolift system. A turbolift has a panel zone; when the player stands in it
// and presses Shift+P a menu offers the levels the lift can reach. Selecting a
// level moves the player's Z to that level, announcing every served level it
// passes on the way and the level it arrives at.
class turbolift
{
int x1;
int x2;
int y1;
int y2;
int z1;
int z2;
string name;
string[] level_names;
int[] level_z;
bool contains(int x, int y, int z)
{
return x1<=x and x2>=x and y1<=y and y2>=y and z1<=z and z2>=z;
}
}
turbolift@[] turbolifts;
// Transition system. A transition is an interaction point (for example a ship's
// airlock): stand inside its zone and press Shift+L to travel to a fixed
// destination point elsewhere on the map (used to step between the ship interior
// and the planet surface, which sit at different Z).
class transition
{
int x1;
int x2;
int y1;
int y2;
int z1;
int z2;
int dx;
int dy;
int dz;
string label;
bool contains(int x, int y, int z)
{
return x1<=x and x2>=x and y1<=y and y2>=y and z1<=z and z2>=z;
}
}
transition@[] transitions;
double get_poi_distance(int px, int py, int pz)
{
double dx=double(px)-mr.x;
double dy=double(py)-mr.y;
double dz=double(pz)-me.z;
return square_root(dx*dx+dy*dy+dz*dz);
}
string get_tile_at(double x, double y, double z)
{
string runtime_tile=dynamic_map_tile_at(x,y,z);if(runtime_tile!="")return runtime_tile;
return get_static_tile_at(x,y,z);
}
string get_static_tile_at(double x,double y,double z)
{
return tile_grid.value_at(int(x),int(y),int(z));
}
string linear(string[] a)
{
string final;
for(uint i=0; i<a.length(); i++)
{
final+=(a[i]+"\r\n");
}
return final;
}
string[] delinear(string a)
{
a=string_replace(a,"\r\n","\n",false);
return string_split(a, "\n", false);
}
string get_zone_at(int x, int y, int z)
{
return zone_grid.value_at(x,y,z);
}
string get_acoustic_space_at(int x,int y,int z)
{return acoustic_grid.value_at(x,y,z);}
string get_dynamic_or_static_zone_at(double x,double y,double z)
{for(int i=int(dynamic_map_elements.length())-1;i>=0;i--){dynamic_map_element@ e=dynamic_map_elements[i];if(!e.active)continue;double lx,ly,lz;e.world_to_local(x,y,z,lx,ly,lz);string n=e.zone_at_local(lx,ly,lz);if(n!="")return n;}return get_zone_at(int(x),int(y),int(z));}
void load_map(string mdata)
{
p.destroy_all();
destroy_all_sources();
acoustics_reset();
dynamic_map_elements.resize(0);
clear_executioners_fixtures();
load_client_world_objects(mdata);
map.resize(0);
zones.resize(0);
tile_regions.resize(0);
zone_regions.resize(0);
acoustic_regions.resize(0);
portal_regions.resize(0);
landmark_regions.resize(0);
pois.resize(0);
turbolifts.resize(0);
transitions.resize(0);
surfaces_reset();
string[] ldata=delinear(mdata);
for(uint i=0; i<ldata.length(); i++)
{
string[] parsed=string_split(ldata[i], ":", true);
if(parsed[0]=="mapname")
{
// Never allow a friendly map title into the space-delimited network protocol.
// Among other things, it would shift the final words into the username field
// of spawn_player. Presentation code expands this stable identifier again.
mapname=map_protocol_id(string_replace(ldata[i], "mapname:", "", false));
}
else if(parsed[0]=="surface" and parsed.length()>2)
{
register_surface(parsed[1],parsed[2]);
}
else if(parsed[0]=="tile")
{
map.insert_last(ldata[i]);
if(parsed.length()>7)
tile_regions.insert_last(map_region(string_to_number(parsed[1]), string_to_number(parsed[2]), string_to_number(parsed[3]), string_to_number(parsed[4]), string_to_number(parsed[5]), string_to_number(parsed[6]), parsed[7]));
}
else if(parsed[0]=="zone")
{
string zone_data=string_replace(ldata[i], "zone:", "", false);
zones.insert_last(zone_data);
if(parsed.length()>7)
zone_regions.insert_last(map_region(string_to_number(parsed[1]), string_to_number(parsed[2]), string_to_number(parsed[3]), string_to_number(parsed[4]), string_to_number(parsed[5]), string_to_number(parsed[6]), parsed[7]));
}
else if((parsed[0]=="space" or parsed[0]=="openspace") and parsed.length()>7)
{
string description=parsed[7];if(parsed.length()>8)description+=" "+parsed[8];
acoustic_regions.insert_last(map_region(string_to_number(parsed[1]),string_to_number(parsed[2]),string_to_number(parsed[3]),string_to_number(parsed[4]),string_to_number(parsed[5]),string_to_number(parsed[6]),description));
string acoustic_label=parsed[7],acoustic_material=parsed.length()>8?parsed[8]:"concrete",acoustic_kind=parsed.length()>9?parsed[9]:"";
spawn_acoustic_space(string_to_number(parsed[1]),string_to_number(parsed[2]),string_to_number(parsed[3]),string_to_number(parsed[4]),string_to_number(parsed[5]),string_to_number(parsed[6]),acoustic_label,acoustic_material,parsed[0]=="space",acoustic_kind);
}
else if(parsed[0]=="portal" and parsed.length()>7)
portal_regions.insert_last(map_region(string_to_number(parsed[1]),string_to_number(parsed[2]),string_to_number(parsed[3]),string_to_number(parsed[4]),string_to_number(parsed[5]),string_to_number(parsed[6]),parsed[7]));
else if(parsed[0]=="poiregion" and parsed.length()>7)
{
landmark_regions.insert_last(map_region(string_to_number(parsed[1]),string_to_number(parsed[2]),string_to_number(parsed[3]),string_to_number(parsed[4]),string_to_number(parsed[5]),string_to_number(parsed[6]),parsed[7]));
pois.insert_last(poi((string_to_number(parsed[1])+string_to_number(parsed[2]))/2,(string_to_number(parsed[3])+string_to_number(parsed[4]))/2,(string_to_number(parsed[5])+string_to_number(parsed[6]))/2,parsed[7]));
}
else if(parsed[0]=="maxx")
{
max.x=string_to_number(parsed[1]);
}
else if(parsed[0]=="maxy")
{
max.y=string_to_number(parsed[1]);
}
else if(parsed[0]=="maxz")
{
max.z=string_to_number(parsed[1]);
}
else if(parsed[0]=="x")
{
me.x=string_to_number(parsed[1]);
}
else if(parsed[0]=="y")
{
me.y=string_to_number(parsed[1]);
}
else if(parsed[0]=="z")
{
me.z=string_to_number(parsed[1]);
}
else if(parsed[0]=="src" and parsed.length()>8)
{
int lx=string_to_number(parsed[1]);
int rx=string_to_number(parsed[2]);
int miny=string_to_number(parsed[3]);
int maxy=string_to_number(parsed[4]);
int minz=string_to_number(parsed[5]);
int maxz=string_to_number(parsed[6]);
int id=string_to_number(parsed[8]);
spawn_source(lx, rx, miny, maxy, minz, maxz, parsed[7],3, false, id);
}
else if(parsed[0]=="poi" and parsed.length()>3)
{
int px=string_to_number(parsed[1]);
int py=string_to_number(parsed[2]);
int pz=string_to_number(parsed[3]);
string pname="";
if(parsed.length()>4) pname=parsed[4];
pois.insert_last(poi(px, py, pz, pname));
}
else if(parsed[0]=="turbolift" and parsed.length()>8)
{
turbolift t;
t.x1=string_to_number(parsed[1]);
t.x2=string_to_number(parsed[2]);
t.y1=string_to_number(parsed[3]);
t.y2=string_to_number(parsed[4]);
t.z1=string_to_number(parsed[5]);
t.z2=string_to_number(parsed[6]);
t.name=parsed[7];
// Remaining fields are "level name,z" entries.
for(uint p=8; p<parsed.length(); p++)
{
int c=string_contains(parsed[p], ",", 1);
if(c<0) continue;
string lname=string_left(parsed[p], c);
int lz=string_to_number(string_mid(parsed[p], c+2, parsed[p].length()-c-1));
t.level_names.insert_last(lname);
t.level_z.insert_last(lz);
}
if(t.level_names.length()>0)
turbolifts.insert_last(t);
}
else if(parsed[0]=="transition" and parsed.length()>10)
{
transition t;
t.x1=string_to_number(parsed[1]);
t.x2=string_to_number(parsed[2]);
t.y1=string_to_number(parsed[3]);
t.y2=string_to_number(parsed[4]);
t.z1=string_to_number(parsed[5]);
t.z2=string_to_number(parsed[6]);
t.dx=string_to_number(parsed[7]);
t.dy=string_to_number(parsed[8]);
t.dz=string_to_number(parsed[9]);
// Join any remaining fields so the label may contain colons.
string lbl=parsed[10];
for(uint p=11; p<parsed.length(); p++)
lbl+=":"+parsed[p];
t.label=lbl;
transitions.insert_last(t);
}
}
// Indexes are built once, after every rectangle on the map is known.
rebuild_map_indexes();
}
dictionary terrain_step_sound_count_cache;
int available_terrain_step_sound_count(string terrain)
{
double cached=0;if(terrain_step_sound_count_cache.get(terrain,cached))return int(cached);int count=0;for(int i=1;i<=20;i++){if(fire_archive_index.file_exists(terrain+"step"+i+".ogg"))count=i;else if(i>count+2)break;}if(count<1)count=5;terrain_step_sound_count_cache.set(terrain,double(count));return count;
}
void playstep()
{
if(in_plane==false)
{
string terrain=surface_family(get_tile_at(mr.x,mr.y,me.z));if(terrain!="")p.play_stationary(terrain+"step"+random(1,available_terrain_step_sound_count(terrain))+".ogg", false);
for(int i=0; i<ladders.length(); i++)
{
if(me.x==ladders[i].x and me.y==ladders[i].y and me.z>=ladders[i].miniz and me.z<=ladders[i].maxz)
{
p.play_stationary("ladderstep"+random(1,5)+".ogg",false);
}
}
}
}
// The kerb rule. A rise or a drop of exactly one unit is taken in stride,
// which is what makes an authored stair or ramp -- a stack of one-unit
// surfaces -- something you walk up rather than something you operate. A
// bigger rise is a wall and a bigger drop is a fall, and both stay that way.
//
// Climbable surfaces are deliberately excluded here. A ladder is not a kerb;
// you do not wander up one sideways, you take the climb keys to it.
void follow_walkable_ramp(double ox,double oy)
{
int nx=int(round(me.x,0)),ny=int(round(me.y,0)),z=int(round(me.z,0));
string here=get_tile_at(nx,ny,z),above=get_tile_at(nx,ny,z+1),below=get_tile_at(nx,ny,z-1);
if(surface_is_climbable(here))return;
bool blocked_here=!surface_is_walkable(here);
if(blocked_here and surface_is_walkable(above) and !surface_is_climbable(above)){me.z=z+1;return;}
if(surface_is_air(here) and surface_is_walkable(below) and !surface_is_climbable(below))me.z=z-1;
}
// Announced once on arrival rather than on every step, so a long climb is not
// a sentence per rung.
string last_climb_surface="";
timer climb_refusal_timer;
void climb_refuse(string reason)
{
if(climb_refusal_timer.elapsed<700)return;
climb_refusal_timer.restart();
speak(reason);
}
void move(string dir)
{
if(dir==Up)
{
string above=get_tile_at(mr.x, mr.y, me.z+1),here=get_tile_at(mr.x, mr.y, me.z);
if(surface_is_wall(above))
{
p.play_stationary(surface_wall_sound(above),false);
climb_refuse("There is no way up from here.");
return;
}
if(surface_is_air(above))
{
climb_refuse(surface_is_climbable(here)?"The top of the climb. Step off to one side.":"Nothing here to climb.");
return;
}
me.z++;
if(surface_is_climbable(above) and last_climb_surface!=above){last_climb_surface=above;speak(above+".");}
checkup();
}
if(dir==Down)
{
string below=get_tile_at(mr.x, mr.y, me.z-1),here=get_tile_at(mr.x, mr.y, me.z);
if(surface_is_wall(below))
{
p.play_stationary(surface_wall_sound(below),false);
climb_refuse("Solid below you.");
return;
}
if(surface_is_air(below))
{
climb_refuse(surface_is_climbable(here)?"The bottom of the climb.":"Nothing below to climb down. Walk off the edge if you mean to drop.");
return;
}
me.z--;
if(surface_is_climbable(below) and last_climb_surface!=below){last_climb_surface=below;speak(below+".");}
checkdown();
}
if(dir!=Up and dir!=Down)last_climb_surface="";

if(dir==Forward)
{
double ox=me.x;
double oy=me.y;
me=move(me.x, me.y, me.z, facing, north);
follow_walkable_ramp(ox,oy);
if(round(me.x, 0)<0 or round(me.x, 0)>max.x or round(me.y, 0)<0 or round(me.y, 0)>max.y)
{
me.x=ox;
me.y=oy;
return;
}
checkaround(ox, oy);
}
if(dir==Backward)
{
double ox=me.x;
double oy=me.y;
me=move(me.x, me.y, me.z, facing, south);
follow_walkable_ramp(ox,oy);
if(round(me.x, 0)<0 or round(me.x, 0)>max.x or round(me.y, 0)<0 or round(me.y, 0)>max.y)
{
me.x=ox;
me.y=oy;
return;
}
checkaround(ox, oy);
}
if(dir==Left)
{
double ox=me.x;
double oy=me.y;
me=move(me.x, me.y, me.z, facing, west);
follow_walkable_ramp(ox,oy);
if(round(me.x, 0)<0 or round(me.x, 0)>max.x or round(me.y, 0)<0 or round(me.y, 0)>max.y)
{
me.x=ox;
me.y=oy;
return;
}
checkaround(ox, oy);
}
if(dir==Right)
{
double ox=me.x;
double oy=me.y;
me=move(me.x, me.y, me.z, facing, east);
follow_walkable_ramp(ox,oy);
if(round(me.x, 0)<0 or round(me.x, 0)>max.x or round(me.y, 0)<0 or round(me.y, 0)>max.y)
{
me.x=ox;
me.y=oy;
return;
}
checkaround(ox, oy);
}
}
void checkaround(double ox, double oy)
{
mr.x=round(me.x, 0);
mr.y=round(me.y, 0);
if(!in_vehicle)
{
for(uint vi=0;vi<map_vehicles.length();vi++)
{
vehicle@ obstacle=map_vehicles[vi];
if(obstacle.destroyed) continue;
double vehicle_length,vehicle_width,vehicle_height,local_forward,local_side;vehicle_dimensions(obstacle,vehicle_length,vehicle_width,vehicle_height);vehicle_local_position(obstacle,me.x,me.y,local_forward,local_side);
bool near_vehicle=absolute(local_forward)<=vehicle_length*.5+1.1 and absolute(local_side)<=vehicle_width*.5+1.1 and me.z>=obstacle.z-.2 and me.z<=obstacle.z+vehicle_height+.8;
if(near_vehicle){string zone=obstacle.get_name()+", "+vehicle_zone_at(obstacle,me.x,me.y,me.z);if(zone!=last_vehicle_zone){last_vehicle_zone=zone;speak(zone+".");}}
if(vehicle_is_roof_position(obstacle,me.x,me.y,me.z))
{
vehicle_roof_index=int(vi);vehicle_roof_last_x=obstacle.x;vehicle_roof_last_y=obstacle.y;vehicle_roof_last_z=obstacle.z;
vehicle_local_position(obstacle,me.x,me.y,vehicle_roof_local_forward,vehicle_roof_local_side);
break;
}
if(vehicle_contains_position(obstacle,me.x,me.y,me.z))
{
p.play_stationary("metalfall.ogg",false);
speak(obstacle.get_name()+" body blocking the way. Use the vehicle control beside its open door to enter.");
me.x=ox;me.y=oy;mr.x=round(me.x,0);mr.y=round(me.y,0);
return;
}
}
if(vehicle_roof_index>=0 and (vehicle_roof_index>=int(map_vehicles.length()) or !vehicle_is_roof_position(map_vehicles[vehicle_roof_index],me.x,me.y,me.z))) vehicle_roof_index=-1;
vehicle_interior_index=-1;
}
for(int i=0; i<walls.length(); i++)
{
if(mr.x==walls[i].x and mr.y==walls[i].y and me.z>=walls[i].miniz and me.z<=walls[i].maxz)
{
p.play_stationary(walls[i].type+".ogg",false);
me.x=ox;
me.y=oy;
}
}
if(string_contains(get_tile_at(mr.x, mr.y, me.z), "wall", 1)>-1)  
{
if(!executioners_fixture_collision_sound(me.x,me.y,me.z))p.play_stationary(surface_wall_sound(get_tile_at(mr.x, mr.y, me.z)), false);
send_reliable(0, "hitwall "+me.x+" "+me.y+" "+me.z, 0);
me.x=ox;
me.y=oy;
}
else
{
playstep();
send_reliable(1, "move_to "+mr.x+" "+mr.y+" "+me.z, 0);
checkzone();
string standing=get_tile_at(mr.x,mr.y,me.z);
if(surface_is_climbable(standing))
{
if(last_climb_surface!=standing){last_climb_surface=standing;speak(standing+". Press up to climb.");}
}
else last_climb_surface="";
}
}
void checkup()
{
if(string_contains(get_tile_at(mr.x, mr.y, me.z), "wall", 1)>-1)
{
p.play_stationary(surface_wall_sound(get_tile_at(mr.x, mr.y, me.z)), false);
send_reliable(0, "hitwall "+me.x+" "+me.y+" "+me.z, 0);
bounceback(Up);
}
else
{
send_reliable(0, "move_to "+mr.x+" "+mr.y+" "+me.z, 0);
playstep();
checkzone();
}
}
void checkdown()
{
if(string_contains(get_tile_at(mr.x, mr.y, me.z), "wall", 1)>-1)
{
p.play_stationary(surface_wall_sound(get_tile_at(mr.x, mr.y, me.z)), false);
send_reliable(1, "hitwall "+me.x+" "+me.y+" "+me.z, 0);
bounceback(Down);
}
else
{
playstep();
send_reliable(1, "move_to "+mr.x+" "+mr.y+" "+me.z, 0);
checkzone();
}
}
void bounceback(int d)
{
if(d==Up)
{
me.z--;
}
else if(d==Down)
{
me.z++;
}
}
void spawn_platform(int leftx, int rightx, int miny, int maxy, int z, string plattype)
{
map.insert_last("tile:"+leftx+":"+rightx+":"+miny+":"+maxy+":"+z+":"+z+":"+plattype);
tile_regions.insert_last(map_region(leftx,rightx,miny,maxy,z,z,plattype));
tile_grid.build(@tile_regions);
}
void spawn_tiles(int leftx, int rightx, int miny, int maxy, int minz, int maxz, string plattype)
{
map.insert_last("tile:"+leftx+":"+rightx+":"+miny+":"+maxy+":"+minz+":"+maxz+":"+plattype);
tile_regions.insert_last(map_region(leftx,rightx,miny,maxy,minz,maxz,plattype));
tile_grid.build(@tile_regions);
}
void spawn_zone(int leftx, int rightx, int miny, int maxy, int minz, int maxz, string zonetype)
{
zones.insert_last(leftx+":"+rightx+":"+miny+":"+maxy+":"+minz+":"+maxz+":"+zonetype);
zone_regions.insert_last(map_region(leftx,rightx,miny,maxy,minz,maxz,zonetype));
zone_grid.build(@zone_regions);
}
void spawn_tile(int x, int y, int z, string type)
{
map.insert_last("tile:"+x+":"+x+":"+y+":"+y+":"+z+":"+z+":"+type);
tile_regions.insert_last(map_region(x,x,y,y,z,z,type));
tile_grid.build(@tile_regions);
}
void spawn_tree(int x, int y)
{
int z=random(3, 10);
spawn_tiles(x, x, y, y, 0, z, "tree");
}
void spawn_glass(int x, int y)
{
spawn_tile(x, y, 0, "glass");
}
string gct()
{
return get_tile_at(camera.x, camera.y, camera.z);
}
