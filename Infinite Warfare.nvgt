go_reload=true;
bombloadtimer.restart();
p.play_stationary("planebombreload.ogg",false);
}
if(action_pressed("menu") and get_tile_at(me.x, me.y, me.z)!="" and get_tile_at(me.x, me.y, me.z)!="blank" or go_out==true) 
{
go_out=false;
send_reliable(0, "plane_stop", 0);
in_plane=false;
plane.stop();
resume_all_sources();
break;
}
if(action_pressed("jump") and bombloaded==true)
{
send_reliable(0, "spawn_planebomb", 0);
bombloaded=false;
}
if(bombloadtimer.elapsed>=3375 and bombloaded==false and go_reload==true)
{
bombloaded=true;
go_reload=false;
}
if (action_pressed("buffer_left"))
{
if (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT))
{
firstbuffer();
}
else
{
bufferleft();
}
}
if (action_pressed("buffer_right"))
{
if (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT))
{
lastbuffer();
}
else
{
bufferright();
}
}
if (key_pressed(KEY_COMMA))
{
prevbufferitem();
}
if (key_pressed(KEY_PERIOD))
{
nextbufferitem();
}
if(kb_action_pressed("buffer_manager"))
{
buffer_manage_menu();
}
if ((key_down(KEY_LMENU) or key_down(KEY_RMENU)) and (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT)) and key_pressed(KEY_C))
{
review_buffer_item();
}
chat_channel_shortcuts();
if (key_pressed(KEY_DELETE))
{
buffer_item_action_menu();
}
}
