// Interface cues live in sounds/ui and play on the interface pool, so the
// Interface volume actually governs them. They used to play on the gameplay
// pool, which meant the Interface slider did nothing to the menus and a busy
// firefight could steal a menu tick's slot.
// Which file a menu cue plays. The cues live in sounds/ui/, but a sounds.dat
// built before a cue existed does not contain it, and a missing file plays
// nothing at all -- which is how every menu went silent after 0.5.2 moved to
// the new set. Each cue therefore names an older menu sound that every pack
// has, and uses it until the pack is rebuilt.
dictionary ui_sound_cache;
string ui_sound(const string &in cue)
{
string found;
if(ui_sound_cache.get(cue,found))return found;
string primary="ui/"+cue+".ogg";
found=primary;
if(!fire_archive_index.file_exists(primary))
{
string legacy="menuclick.ogg";
if(cue=="move" or cue=="item" or cue=="slider" or cue=="tab" or cue=="type")legacy="menumove.ogg";
else if(cue=="edge")legacy="menuedge.ogg";
else if(cue=="wrap")legacy="menuwrap.ogg";
else if(cue=="activate" or cue=="close" or cue=="apply" or cue=="collapse")legacy="menuenter.ogg";
else if(cue=="open" or cue=="popup" or cue=="expand")legacy="menuopen.ogg";
else if(cue=="error")legacy="menufail.ogg";
else if(cue=="notify")legacy="notify.ogg";
else if(cue=="listen")legacy="modeenter.ogg";
else if(cue=="listen_end")legacy="modeleave.ogg";
if(fire_archive_index.file_exists(legacy))found=legacy;
}
ui_sound_cache.set(cue,found);
return found;
}
// Cues a screen has asked to keep quiet, such as Learn the game's sounds,
// where a list tick or a button click would play over the sound being learnt.
string[] muted_ui_cues;
void play_ui_cue(const string &in cue)
{
if(!audio_form_sound_feedback)return;
if(muted_ui_cues.find(cue)>=0)return;
spool.play_stationary(ui_sound(cue),false);
}

// Menu music volume: Page Up and Page Down in any menu while the music is
// playing, in steps of five percent, remembered between sessions. The old
// list menus had this built in but forgot it on exit, and the main menu lost
// it altogether when it became a form. On a slider or number field, Page Up
// and Page Down still move that control by a large step instead.
bool menu_music_dirty=false;
timer menu_music_save_timer;
void menu_music_keys()
{
if(menu_music_dirty and menu_music_save_timer.elapsed>1500){menu_music_dirty=false;writeprefs();}
if(!m.music.playing or nv_form_focus_uses_paging)return;
int direction=0;
if(key_repeating(KEY_PAGEUP))direction=1;
else if(key_repeating(KEY_PAGEDOWN))direction=-1;
if(direction==0)return;
int percent=volume_db_to_percent(menumusvolume);
int next=percent+direction*5;
if(next<0)next=0;
if(next>100)next=100;
if(next==percent){play_ui_cue("edge");speak("Menu music "+percent+" percent");return;}
menumusvolume=next==0?-100:volume_percent_to_db(next);
m.music.set_volume(menumusvolume);
play_ui_cue("slider");
speak(next==0?"Menu music off":"Menu music "+next+" percent");
menu_music_dirty=true;
menu_music_save_timer.restart();
}
