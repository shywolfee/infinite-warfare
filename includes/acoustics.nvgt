// Authored environmental occlusion. Spaces describe enclosing boundaries and
// portals punch audible openings through them; environmental reverb is absent.
class acoustic_space
{
int x1,x2,y1,y2,z1,z2;string label,material,kind;bool encloses;
bool contains(float x,float y,float z){return x>=x1 and x<=x2 and y>=y1 and y<=y2 and z>=z1 and z<=z2;}
}
acoustic_space@[] acoustic_spaces;
// Spaces are indexed on the same grid the tiles and zones use. The vehicle
// cabin preset is deliberately parked far off the map and is only ever reached
// through the explicit cabin test below, so it never lands in a real cell.
box_grid acoustic_space_grid;
int acoustic_vehicle_preset=-1;
bool acoustic_occlusion_enabled=true;
void acoustics_reset(){acoustic_spaces.resize(0);acoustic_space_grid.clear();acoustic_vehicle_preset=-1;}
void spawn_acoustic_space(int x1,int x2,int y1,int y2,int z1,int z2,string label,string material,bool encloses,string kind)
{acoustic_space@ s=acoustic_space();s.x1=x1;s.x2=x2;s.y1=y1;s.y2=y2;s.z1=z1;s.z2=z2;s.label=label;s.material=material;s.encloses=encloses;s.kind=kind;acoustic_spaces.insert_last(s);acoustic_space_grid.add(x1,x2,y1,y2,z1,z2);}
int acoustic_space_at(float x,float y,float z){return acoustic_space_grid.topmost(int(x),int(y),int(z));}
int acoustic_effective_space_at(float x,float y,float z)
{for(uint i=0;i<map_vehicles.length();i++)if(!map_vehicles[i].destroyed and vehicle_cabin_contains_position(map_vehicles[i],x,y,z,.1)){if(acoustic_vehicle_preset<0){spawn_acoustic_space(-100000,-100000,-100000,-100000,-100000,-99998,"vehicle cabin","fabric",true,"vehicle");acoustic_vehicle_preset=int(acoustic_spaces.length())-1;}return acoustic_vehicle_preset;}return acoustic_space_at(x,y,z);}
bool acoustic_in_portal(float x,float y,float z){return portal_grid.any(int(round(x,0)),int(round(y,0)),int(round(z,0)));}
int acoustic_candidate_space(float x,float y,float z)
{
for(uint i=0;i<map_vehicles.length();i++)if(!map_vehicles[i].destroyed and vehicle_cabin_contains_position(map_vehicles[i],x,y,z,.1))return acoustic_effective_space_at(x,y,z);
return acoustic_space_grid.topmost(int(x),int(y),int(z));
}
int acoustic_walls_between(float lx,float ly,float lz,float sx,float sy,float sz)
{
float distance=get_3d_distance(lx,ly,lz,sx,sy,sz);if(distance<1)return 0;int steps=int(distance);if(steps>160)steps=160;
// Every layer this ray consults is grid-indexed, so each sample is a handful
// of box tests inside one cell. The previous version rebuilt a candidate list
// by scanning every space, portal and tile rectangle on the map, once per ray.
int last=acoustic_candidate_space(lx,ly,lz),walls=0;bool last_encloses=last>=0 and acoustic_spaces[last].encloses,last_solid=false;
for(int i=1;i<=steps;i++)
{
float t=float(i)/steps,x=lx+(sx-lx)*t,y=ly+(sy-ly)*t,z=lz+(sz-lz)*t;
int here=acoustic_candidate_space(x,y,z);bool here_encloses=here>=0 and acoustic_spaces[here].encloses;
bool portal=portal_grid.any(int(round(x,0)),int(round(y,0)),int(round(z,0)));
string tile=tile_grid.value_at(int(x),int(y),int(z));
bool solid=(string_contains(tile,"wall",1)>=0 or dynamic_map_solid_at(x,y,z)) and !portal;
bool boundary=here!=last and (last_encloses or here_encloses) and !portal;
if(boundary or (solid and !last_solid)){walls++;if(walls>=3)return walls;}
last=here;last_encloses=here_encloses;last_solid=solid;
}
return walls;
}
audio_low_pass_filter@ acoustic_wall_filter(int walls){if(walls<=0)return null;return audio_low_pass_filter(walls==1?2800:(walls==2?1400:850),2);}
dictionary acoustic_local_source_cache;
bool acoustic_local_world_source(string filename)
{
bool result;if(acoustic_local_source_cache.get(filename,result))return result;
// Local footsteps and weapon foley are physical sources at the listener,
// unlike menu, inventory, chat, voice, and prerecorded ambience feedback.
result=string_contains(filename,"step",1)>=0 or string_contains(filename,"land.ogg",1)>=0;
for(uint i=0;i<gun_ammos.length() and !result;i++){string profile=weapon_sound_profile(gun_ammos[i].weapon_name);if(profile!="" and string_contains(filename,profile,1)==0)result=true;}
acoustic_local_source_cache.set(filename,result);return result;
}
void acoustics_process_pool(sound_pool@ pool,bool world)
{
for(uint i=0;i<=pool.highest_slot and i<pool.items.length();i++)
{
sound_pool_item@ item=pool.items[i];
if(@item.handle==null or !item.handle.active or item.extra_data=="acoustic")continue;
// Authored area ambience is already a mixed environmental bed, not a point
// emitter at the corner of its rectangle. Do not trace or reverberate it.
if(item.looping and (item.left_range>0 or item.right_range>0 or item.backward_range>0 or item.forward_range>0 or item.lower_range>0 or item.upper_range>0)){item.extra_data="acoustic";continue;}
if(acoustic_tasks_remaining<=0 or acoustic_work_timer.elapsed>=3)return;
acoustic_tasks_remaining--;
item.extra_data="acoustic";
// Identify genuinely local physical sounds rather than reverberating all UI.
if(item.stationary and !acoustic_local_world_source(item.filename))continue;
float sx=item.stationary?me.x:item.x,sy=item.stationary?me.y:item.y,sz=item.stationary?me.z:item.z;
int source_space=acoustic_effective_space_at(sx,sy,sz);
int walls=acoustic_occlusion_enabled and !item.stationary?acoustic_walls_between(me.x,me.y,me.z,sx,sy,sz):0;
// An unclassified outdoor source must not inherit the listener's indoor room.
if(walls>0){audio_low_pass_filter@ filter=acoustic_wall_filter(walls);item.handle.effects_chain.add_node(filter);item.start_volume-=3*walls;item.handle.set_volume(item.start_volume);}
}
}
timer acoustic_work_timer;int acoustic_tasks_remaining=0;bool acoustic_world_first=false;
void acoustics_loop(){if(!acoustic_occlusion_enabled)return;acoustic_work_timer.restart();acoustic_tasks_remaining=4;acoustic_world_first=!acoustic_world_first;if(acoustic_world_first){acoustics_process_pool(distpool,true);acoustics_process_pool(p,false);}else{acoustics_process_pool(p,false);acoustics_process_pool(distpool,true);}}
