// ---------------------------------------------------------------------------
// Vehicle system.
// ---------------------------------------------------------------------------

const int MAX_MAP_VEHICLES = 10;

// Vehicle type definitions.
class vehicle_type
{
string name;
int max_health;
int armor;
int max_passengers; // includes driver
double top_speed; // tiles per second
double acceleration; // tiles per second squared
double braking; // tiles per second squared
bool[] seat_has_window; // per seat (index 0 = driver)
string fuel_type;
double fuel_capacity;
double fuel_per_tile;
vehicle_type() {}
vehicle_type(string n, int hp, int ar, int mp, double maximum_speed, double accel, double brake, bool[] windows)
{
name = n;
max_health = hp;
armor = ar;
max_passengers = mp;
top_speed = maximum_speed;
acceleration = accel;
braking = brake;
seat_has_window = windows;
fuel_type=(n=="Duo Plane"?"aviation fuel":(n=="Humvee" or n=="APC" or n=="Tank" or n=="Van"?"diesel":"gasoline"));
fuel_capacity=n=="Tank"?500:(n=="APC"?260:(n=="Duo Plane"?220:(n=="Humvee"?120:(n=="Van"?100:70))));
fuel_per_tile=n=="Tank"?.42:(n=="APC"?.30:(n=="Duo Plane"?.24:(n=="Humvee"?.18:(n=="Van"?.15:.11))));
}
}

vehicle_type@[] vehicle_types;

void init_vehicle_types()
{
vehicle_types.resize(0);

bool[] jeep_win = {true, true, false};
vehicle_types.insert_last(vehicle_type("Jeep",800,0,3,11.1,3.0,5.5,jeep_win));

bool[] humvee_win = {true, true, true, false};
vehicle_types.insert_last(vehicle_type("Humvee",1200,400,4,9.1,2.2,4.8,humvee_win));

bool[] pickup_win = {true, true};
vehicle_types.insert_last(vehicle_type("Pickup Truck",700,0,2,10.0,2.7,5.0,pickup_win));

bool[] apc_win = {true, false, false, false, false, false};
vehicle_types.insert_last(vehicle_type("APC",2500,1000,6,6.25,1.4,3.2,apc_win));

bool[] buggy_win = {true, true};
vehicle_types.insert_last(vehicle_type("Buggy",400,0,2,15.4,4.8,7.0,buggy_win));

bool[] sedan_win = {true, true, true, false};
vehicle_types.insert_last(vehicle_type("Sedan",600,0,4,11.8,3.2,5.8,sedan_win));

bool[] tank_win = {true, false};
vehicle_types.insert_last(vehicle_type("Tank",4000,2000,2,5.0,0.9,2.8,tank_win));

bool[] van_win = {true, true, false, false, false};
vehicle_types.insert_last(vehicle_type("Van",900,0,5,7.7,1.8,4.0,van_win));

bool[] plane_win = {true, true, true, true};
vehicle_types.insert_last(vehicle_type("Duo Plane",5000,500,4,13.3,3.5,4.5,plane_win));
}

// A vehicle instance on the map.
class vehicle
{
int type_index;
int x;
int y;
int z;
int health;
int armor;
double facing; // direction vehicle faces
bool door_open;
bool destroyed;
double observed_velocity;
string[] passengers; // player names in seats, "" = empty
bool[] window_down; // per seat
timer idle_timer; // for cleanup
double fuel;
int engine_condition=100,transmission_condition=100,tire_condition=100,cooling_condition=100,fuel_contamination=0;
bool performance_tune=false,offroad_tires=false,reinforced_suspension=false,auxiliary_armor=false,turbocharger=false,extended_tank=false;
vehicle() {}
vehicle(int ti, int px, int py, int pz)
{
type_index = ti;
x = px;
y = py;
z = pz;
health = vehicle_types[ti].max_health;
armor = vehicle_types[ti].armor;
facing = double(random(0, 7) * 45);
door_open = false;
destroyed = false;
observed_velocity = 0;
fuel=vehicle_types[ti].fuel_capacity*.65;
passengers.resize(vehicle_types[ti].max_passengers);
window_down.resize(vehicle_types[ti].max_passengers);
for (int i = 0; i < vehicle_types[ti].max_passengers; i++)
{
passengers[i] = "";
window_down[i] = false;
}
}

double vehicle_effective_top_speed(vehicle@ v){double value=v.get_top_speed();value*=.55+.45*double(v.engine_condition)/100.0;value*=.7+.3*double(v.transmission_condition)/100.0;if(v.performance_tune)value*=1.08;if(v.turbocharger)value*=1.12;if(v.auxiliary_armor)value*=.92;if(v.fuel_contamination>0)value*=1.0-double(v.fuel_contamination)/180.0;return value;}
double vehicle_effective_capacity(vehicle@ v){return vehicle_types[v.type_index].fuel_capacity*(v.extended_tank?1.35:1.0);}
string vehicle_condition_report(vehicle@ v){vehicle_type@ t=vehicle_types[v.type_index];return v.get_name()+". Health "+v.health+" of "+t.max_health+", armour "+v.armor+" of "+t.armor+". Fuel "+round(v.fuel,1)+" of "+round(vehicle_effective_capacity(v),1)+" litres of "+t.fuel_type+". Engine "+v.engine_condition+" percent, transmission "+v.transmission_condition+" percent, tyres "+v.tire_condition+" percent, cooling system "+v.cooling_condition+" percent, fuel contamination "+v.fuel_contamination+" percent. Effective top speed "+round(vehicle_effective_top_speed(v),1)+". Modifications: "+(v.performance_tune?"performance tune, ":"")+(v.offroad_tires?"off-road tyres, ":"")+(v.reinforced_suspension?"reinforced suspension, ":"")+(v.auxiliary_armor?"auxiliary armour, ":"")+(v.turbocharger?"turbocharger, ":"")+(v.extended_tank?"extended fuel tank.":"standard configuration.");}
void vehicle_consume_item(string item){give(item,-1);string cue=(item=="gasoline_can" or item=="diesel_can" or item=="aviation_fuel_can")?"bucketempty.ogg":((item=="vehicle_performance_ecu" or item=="offroad_tire_set" or item=="reinforced_suspension_kit" or item=="vehicle_auxiliary_armor" or item=="vehicle_turbocharger" or item=="extended_fuel_tank")?"attachment_recoil_buffer_stock_attach.ogg":"nanomatic_multitooluse.ogg");p.play_stationary(cue,false);}
void vehicle_service_panel(int px,int py,int pz)
{
int vi=in_vehicle?player_vehicle_index:find_nearest_vehicle(px,py,pz,5);if(vi<0){speak("No vehicle is close enough to inspect.");return;}vehicle@ v=map_vehicles[vi];
while(true){nv_form f;f.create_window("Vehicle Workshop: "+v.get_name(),false,true);nv_form_input@ status=f.add_input("Live vehicle statistics","status",vehicle_condition_report(v),"",0,true,true);nv_form_list_box@ actions=f.add_list("Available service and customization operations","actions");string[] ids;
string[] labels={"Refuel with gasoline","Refuel with diesel","Refuel with aviation fuel","Siphon ten litres of fuel","Change oil and service engine","Service transmission","Patch tyres","Service cooling system","Drain and flush contaminated fuel","Install performance tune","Install off-road tyre set","Install reinforced suspension","Install auxiliary armour kit","Install turbocharger","Install extended fuel tank"};string[] allids={"gasoline","diesel","aviation","siphon","engine","transmission","tires","cooling","flush","tune","offroad","suspension","armor","turbo","tank"};for(uint i=0;i<labels.length();i++){actions.add(labels[i],allids[i]);ids.insert_last(allids[i]);}nv_form_button@ perform=f.add_button("Perform selected operation","perform",true);nv_form_button@ close=f.add_button("Close","close",false,true);f.focus_control(actions);bool refresh=false;while(true){wait(5);f.monitor();if(connected)netloop();if(f.is_pressed(close))return;if(!f.is_pressed(perform))continue;int pos=actions.list_position;if(pos<0)continue;string op=ids[pos],needed="";int duration=6000;
if(op=="gasoline" or op=="diesel" or op=="aviation"){needed=op=="gasoline"?"gasoline_can":(op=="diesel"?"diesel_can":"aviation_fuel_can");if(get_item_count(needed)<=0){speak("You need a "+string_replace(needed,"_"," ",true)+".");continue;}string supplied=op=="aviation"?"aviation fuel":op;if(supplied!=vehicle_types[v.type_index].fuel_type){v.fuel_contamination+=35;if(v.fuel_contamination>100)v.fuel_contamination=100;v.engine_condition-=random(8,20);if(v.engine_condition<0)v.engine_condition=0;speak("That is the wrong fuel. The engine runs roughly and the fuel system is now contaminated.");}v.fuel+=20;if(v.fuel>vehicle_effective_capacity(v))v.fuel=vehicle_effective_capacity(v);vehicle_consume_item(needed);refresh=true;break;}
if(op=="siphon"){if(get_item_count("vehicle_siphon_hose")<=0 or get_item_count("empty_fuel_can")<=0 or v.fuel<10){speak("Siphoning requires a siphon hose, an empty fuel can, and at least ten litres in the vehicle.");continue;}v.fuel-=10;give("empty_fuel_can",-1);give(vehicle_types[v.type_index].fuel_type=="gasoline"?"gasoline_can":(vehicle_types[v.type_index].fuel_type=="diesel"?"diesel_can":"aviation_fuel_can"),1);p.play_stationary("bucketfill.ogg",false);refresh=true;break;}
if(op=="engine"){needed="vehicle_engine_service_kit";if(get_item_count(needed)<=0 or get_item_count("engine_oil")<=0 or get_item_count("vehicle_oil_filter")<=0){speak("Engine service requires an engine service kit, engine oil, and an oil filter.");continue;}vehicle_consume_item("engine_oil");vehicle_consume_item("vehicle_oil_filter");v.engine_condition+=18;if(v.engine_condition>100)v.engine_condition=100;duration=12000;}
else if(op=="transmission"){needed="vehicle_transmission_tool";if(get_item_count(needed)<=0 or get_item_count("transmission_fluid")<=0){speak("Transmission service requires the transmission tool and fluid.");continue;}vehicle_consume_item("transmission_fluid");v.transmission_condition+=15;if(v.transmission_condition>100)v.transmission_condition=100;duration=14000;}
else if(op=="tires"){needed="vehicle_jack";if(get_item_count(needed)<=0 or get_item_count("tire_patch_kit")<=0){speak("Tyre work requires a vehicle jack and tyre patch kit.");continue;}vehicle_consume_item("tire_patch_kit");v.tire_condition+=12;if(v.tire_condition>85)v.tire_condition=85;}
else if(op=="cooling"){needed="cooling_system_tester";if(get_item_count(needed)<=0 or get_item_count("engine_coolant")<=0){speak("Cooling service requires a tester and engine coolant.");continue;}vehicle_consume_item("engine_coolant");v.cooling_condition+=18;if(v.cooling_condition>100)v.cooling_condition=100;}
else if(op=="flush"){needed="fuel_drain_pan";if(get_item_count(needed)<=0 or get_item_count("fuel_system_flush")<=0){speak("A drain pan and fuel-system flush are required.");continue;}vehicle_consume_item("fuel_system_flush");v.fuel=0;v.fuel_contamination-=60;if(v.fuel_contamination<0)v.fuel_contamination=0;duration=16000;}
else {string mod=op=="tune"?"vehicle_performance_ecu":op=="offroad"?"offroad_tire_set":op=="suspension"?"reinforced_suspension_kit":op=="armor"?"vehicle_auxiliary_armor":op=="turbo"?"vehicle_turbocharger":"extended_fuel_tank";if(get_item_count(mod)<=0){speak("You need "+string_replace(mod,"_"," ",true)+".");continue;}vehicle_consume_item(mod);if(op=="tune")v.performance_tune=true;else if(op=="offroad")v.offroad_tires=true;else if(op=="suspension")v.reinforced_suspension=true;else if(op=="armor"){v.auxiliary_armor=true;v.armor+=250;}else if(op=="turbo")v.turbocharger=true;else v.extended_tank=true;duration=18000;}
bool oldmove=can_move;can_move=false;speak("Beginning vehicle work. "+duration/1000+" seconds.");timer work;while(work.elapsed<duration){wait(5);if(connected)netloop();}can_move=oldmove;p.play_stationary("armor_repair.ogg",false);speak("Vehicle operation complete.");refresh=true;break;}if(!refresh)return;}
}
string get_name()
{
return vehicle_types[type_index].name;
}
double get_top_speed()
{
return vehicle_types[type_index].top_speed;
}
int get_max_passengers()
{
return vehicle_types[type_index].max_passengers;
}
bool has_seat_window(int seat)
{
if (seat < 0 or seat >= int(vehicle_types[type_index].seat_has_window.length()))
return false;
return vehicle_types[type_index].seat_has_window[seat];
}
int count_occupants()
{
int c = 0;
for (int i = 0; i < int(passengers.length()); i++)
{
if (passengers[i] != "") c++;
}
return c;
}
bool is_full()
{
return count_occupants() >= get_max_passengers();
}
int find_empty_seat()
{
for (int i = 0; i < int(passengers.length()); i++)
{
if (passengers[i] == "") return i;
}
return -1;
}
int find_player_seat(string pname)
{
for (int i = 0; i < int(passengers.length()); i++)
{
if (passengers[i] == pname) return i;
}
return -1;
}
string seat_label(int seat)
{
if (seat == 0) return "driver's seat";
return "passenger seat " + seat;
}
}

vehicle@[] map_vehicles;
int player_vehicle_index = -1; // index into map_vehicles, -1 = not in vehicle
int player_seat = -1;
bool in_vehicle = false;
timer vehicle_move_timer;
timer vehicle_stamina_timer;
double vehicle_current_velocity=0; // tiles per second
double vehicle_target_velocity=0; // driver-selected cruise target
timer vehicle_accel_timer;
timer vehicle_decel_timer;
bool vehicle_decelerating = false;
int vehicle_roof_index = -1;
int vehicle_roof_last_x = 0;
int vehicle_roof_last_y = 0;
int vehicle_roof_last_z = 0;

string vehicle_audio_id_from_name(string vehicle_name)
{
string n=string_to_lower_case(vehicle_name);
if(n=="pickup truck") return "pickup";
return string_replace(n," ","",true);
}

string vehicle_audio_id(vehicle@ v)
{
return vehicle_audio_id_from_name(v.get_name());
}

void play_vehicle_audio(vehicle@ v, string action)
{
if (v.get_name()=="Duo Plane")
{
string cue="duoplaneloop.ogg";
if (action=="enter" or action=="door_open" or action=="start") cue="duoplanein.ogg";
else if (action=="exit" or action=="door_close" or action=="stop") cue="duoplaneout.ogg";
else if (action=="crash" or action=="destroy") cue="duoplanecrash.ogg";
p.play_stationary(cue, false);
return;
}
p.play_stationary("vehicle_"+vehicle_audio_id(v)+"_"+action+".ogg", false);
}

void reset_vehicles()
{
map_vehicles.resize(0);
player_vehicle_index = -1;
player_seat = -1;
in_vehicle = false;
vehicle_current_velocity=0;
vehicle_target_velocity=0;
vehicle_decelerating = false;
vehicle_roof_index = -1;
}

void register_vehicle_with_server(int index)
{
if(!connected or index<0 or index>=int(map_vehicles.length())) return;
vehicle@ v=map_vehicles[index];
send_reliable(0,"veh_register "+index+" "+vehicle_audio_id(v)+" "+v.x+" "+v.y+" "+v.z+" "+v.health+" "+v.armor+" "+mapname,0);
}

void register_vehicles_with_server()
{
for(uint i=0;i<map_vehicles.length();i++) register_vehicle_with_server(int(i));
}

// Spawn vehicles at random valid positions on the map.
void spawn_vehicles_on_map()
{
if (vehicle_types.length() == 0) init_vehicle_types();
map_vehicles.resize(0);
int count = random(5, MAX_MAP_VEHICLES);
for (int i = 0; i < count; i++)
{
// Team planes are purchased and deployed; never place them as random traffic.
int ti = random(0, int(vehicle_types.length()) - 2);
int vx = random(5, int(max.x) - 5);
int vy = random(5, int(max.y) - 5);
int vz = 0;
// Make sure tile is valid.
if (get_tile_at(vx, vy, vz) != "" and get_tile_at(vx, vy, vz) != "blank" and string_contains(get_tile_at(vx, vy, vz), "wall", 1) < 0)
{
map_vehicles.insert_last(vehicle(ti, vx, vy, vz));
}
}
}

void spawn_team_plane_vehicle(int x, int y, int z)
{
if (vehicle_types.length()==0) init_vehicle_types();
int type_index=-1;
for (uint i=0; i<vehicle_types.length(); i++) if (vehicle_types[i].name=="Duo Plane") { type_index=i; break; }
if (type_index<0) return;
map_vehicles.insert_last(vehicle(type_index, x, y, z));
register_vehicle_with_server(int(map_vehicles.length())-1);
speak("Your team's Duo Plane has been deployed nearby. Open its door and enter it like any other vehicle.");
}

bool current_vehicle_can_fly()
{
return in_vehicle and player_vehicle_index>=0 and player_vehicle_index<int(map_vehicles.length()) and map_vehicles[player_vehicle_index].get_name()=="Duo Plane";
}

void vehicle_change_altitude(int direction)
{
if (!current_vehicle_can_fly()) return;
if (player_seat!=0) { speak("Only the pilot controls altitude."); return; }
vehicle@ v=map_vehicles[player_vehicle_index];
int next=v.z+direction;
if (next<0) next=0;
if (next>int(max.z)) next=int(max.z);
if (next==v.z) { speak(direction>0 ? "Maximum altitude." : "On the ground."); return; }
v.z=next;
me.z=v.z;
speak("Altitude "+v.z+".");
send_reliable(1, "move_to "+mr.x+" "+mr.y+" "+me.z, 0);
send_reliable(0, "veh_altitude "+player_vehicle_index+" "+v.z+" "+mapname, 0);
}

// Find the nearest vehicle within range tiles.
int find_nearest_vehicle(int px, int py, int pz, int range)
{
int best = -1;
double best_dist = 999999;
for (uint i = 0; i < map_vehicles.length(); i++)
{
if (map_vehicles[i].destroyed) continue;
double dx = double(map_vehicles[i].x - px);
double dy = double(map_vehicles[i].y - py);
double dz = double(map_vehicles[i].z - pz);
double dist = square_root(dx * dx + dy * dy + dz * dz);
if (dist <= range and dist < best_dist)
{
best_dist = dist;
best = int(i);
}
}
return best;
}

// Toggle door open/close for nearest vehicle.
void vehicle_toggle_door(int px, int py, int pz)
{
int vi = in_vehicle ? player_vehicle_index : find_nearest_vehicle(px, py, pz, 5);
if (vi < 0)
{
speak("No vehicle nearby.");
return;
}
map_vehicles[vi].door_open = !map_vehicles[vi].door_open;
if (map_vehicles[vi].door_open) play_vehicle_audio(map_vehicles[vi], "door_open");
else play_vehicle_audio(map_vehicles[vi], "door_close");
if (map_vehicles[vi].door_open)
{
speak(map_vehicles[vi].get_name() + " door opened.");
send_reliable(0, "veh_door " + vi + " 1", 0);
}
else
{
speak(map_vehicles[vi].get_name() + " door closed.");
send_reliable(0, "veh_door " + vi + " 0", 0);
}
}

// Enter the nearest vehicle.
void vehicle_enter(string pname, int px, int py, int pz)
{
if (in_vehicle)
{
speak("You are already in a vehicle.");
return;
}
int vi = find_nearest_vehicle(px, py, pz, 5);
if (vi < 0)
{
speak("No vehicle nearby.");
return;
}
if (map_vehicles[vi].destroyed)
{
speak("This vehicle is destroyed.");
return;
}
if (!map_vehicles[vi].door_open)
{
speak("The door is closed. Press O to open it first.");
return;
}
if (map_vehicles[vi].is_full())
{
speak("This vehicle is full.");
return;
}
bool vehicle_was_empty=true;
for(uint occupied=0; occupied<map_vehicles[vi].passengers.length(); occupied++)
if(map_vehicles[vi].passengers[occupied]!="") vehicle_was_empty=false;
int seat = map_vehicles[vi].find_empty_seat();
if (seat < 0)
{
speak("No empty seats.");
return;
}
map_vehicles[vi].passengers[seat] = pname;
player_vehicle_index = vi;
player_seat = seat;
in_vehicle = true;
vehicle_current_velocity=0;
vehicle_target_velocity=0;
vehicle_decelerating = false;
vehicle_move_timer.restart();
vehicle_stamina_timer.restart();
vehicle_accel_timer.restart();
play_vehicle_audio(map_vehicles[vi], "enter");
if(vehicle_was_empty) play_vehicle_audio(map_vehicles[vi], "start");
speak("Entered " + map_vehicles[vi].get_name() + ", " + map_vehicles[vi].seat_label(seat) + ".");
send_reliable(0, "veh_enter " + vi + " " + seat+" "+mapname, 0);
}

// Exit the current vehicle.
void vehicle_exit(string pname)
{
if (!in_vehicle or player_vehicle_index < 0)
{
speak("You are not in a vehicle.");
return;
}
if (vehicle_current_velocity > 0.05)
{
speak("Stop the vehicle first.");
return;
}
vehicle@ v = map_vehicles[player_vehicle_index];
if (!v.door_open)
{
speak("Open the door first. Press O.");
return;
}
int seat = v.find_player_seat(pname);
if (seat >= 0)
{
v.passengers[seat] = "";
v.window_down[seat] = false;
}
speak("Exited " + v.get_name() + ".");
play_vehicle_audio(v, "exit");
send_reliable(0, "veh_exit " + player_vehicle_index+" "+mapname, 0);
player_vehicle_index = -1;
player_seat = -1;
in_vehicle = false;
vehicle_current_velocity=0;
vehicle_target_velocity=0;
vehicle_decelerating = false;
}

// Switch seats with alt+left/right.
void vehicle_switch_seat(string pname, int direction)
{
if (!in_vehicle or player_vehicle_index < 0) return;
vehicle@ v = map_vehicles[player_vehicle_index];
int cur = v.find_player_seat(pname);
if (cur < 0) return;
int max_s = v.get_max_passengers();
int next_seat = cur + direction;
// Wrap around.
if (next_seat < 0) next_seat = max_s - 1;
if (next_seat >= max_s) next_seat = 0;
// Find next empty seat in the given direction.
int checked = 0;
while (checked < max_s)
{
if (v.passengers[next_seat] == "")
{
// Close window at old seat.
if(v.window_down[cur]) play_vehicle_audio(v, "window_close");
v.window_down[cur] = false;
v.passengers[cur] = "";
v.passengers[next_seat] = pname;
player_seat = next_seat;
play_vehicle_audio(v, "seat_switch");
speak(v.seat_label(next_seat) + ".");
send_reliable(0, "veh_seat " + player_vehicle_index + " " + next_seat, 0);
return;
}
next_seat += direction;
if (next_seat < 0) next_seat = max_s - 1;
if (next_seat >= max_s) next_seat = 0;
checked++;
}
speak("No other seats available.");
}

// Toggle window at current seat.
void vehicle_toggle_window()
{
if (!in_vehicle or player_vehicle_index < 0) return;
vehicle@ v = map_vehicles[player_vehicle_index];
if (!v.has_seat_window(player_seat))
{
speak("No window at this seat.");
return;
}
v.window_down[player_seat] = !v.window_down[player_seat];
if (v.window_down[player_seat])
{
play_vehicle_audio(v, "window_open");
speak("Window down.");
}
else
{
play_vehicle_audio(v, "window_close");
speak("Window up.");
}
}

// Check if the player can fire from a vehicle.
bool vehicle_can_fire()
{
if (!in_vehicle) return true; // not in vehicle, normal fire
if (player_vehicle_index < 0) return true;
vehicle@ v = map_vehicles[player_vehicle_index];
if (!v.has_seat_window(player_seat))
return false;
if (!v.window_down[player_seat])
return false;
return true;
}

// Check if weapon is melee (can't use from vehicle).
bool vehicle_blocks_melee()
{
return in_vehicle;
}

int vehicle_speed_percent(vehicle@ v)
{
if(v.vehicle_effective_top_speed(v)<=0) return 0;
return int(round((vehicle_target_velocity/v.vehicle_effective_top_speed(v))*100.0,0));
}

// Increase the cruise target. Actual speed approaches it using the vehicle's
// acceleration curve rather than snapping between interval presets.
void vehicle_speed_up()
{
if (!in_vehicle or player_vehicle_index < 0) return;
if (player_seat != 0)
{
speak("Only the driver can control the vehicle.");
return;
}
vehicle_decelerating = false;
vehicle@ v = map_vehicles[player_vehicle_index];
if(vehicle_target_velocity>=v.vehicle_effective_top_speed(v))
{
speak("Already at maximum speed.");
return;
}
vehicle_target_velocity+=v.vehicle_effective_top_speed(v)*0.1;
if(vehicle_target_velocity>v.vehicle_effective_top_speed(v)) vehicle_target_velocity=v.vehicle_effective_top_speed(v);
speak("Target speed "+vehicle_speed_percent(v)+" percent.");
play_vehicle_audio(v, "accelerate");
play_vehicle_audio(v, "engine");
}

// Decrease speed (DOWN arrow in vehicle).
void vehicle_speed_down()
{
if (!in_vehicle or player_vehicle_index < 0) return;
if (player_seat != 0)
{
speak("Only the driver can control the vehicle.");
return;
}
vehicle_decelerating = false;
vehicle@ v=map_vehicles[player_vehicle_index];
if(vehicle_target_velocity<=0)
{
speak("Already stopped.");
return;
}
vehicle_target_velocity-=v.vehicle_effective_top_speed(v)*0.1;
if(vehicle_target_velocity<=0)
{
vehicle_target_velocity=0;
speak("Target speed zero. Braking to a stop.");
play_vehicle_audio(v,"stop");
}
else
{
speak("Target speed "+vehicle_speed_percent(v)+" percent.");
play_vehicle_audio(v, "decelerate");
}
}

// Gradual deceleration (Shift+DOWN in vehicle).
void vehicle_decelerate_gradual()
{
if (!in_vehicle or player_vehicle_index < 0) return;
if (player_seat != 0)
{
speak("Only the driver can control the vehicle.");
return;
}
if (vehicle_current_velocity<=0 and vehicle_target_velocity<=0)
{
speak("Already stopped.");
return;
}
vehicle_decelerating = true;
vehicle_target_velocity=0;
vehicle_decel_timer.restart();
play_vehicle_audio(map_vehicles[player_vehicle_index], "decelerate");
speak("Decelerating.");
}

// Turn vehicle 90 degrees (LEFT/RIGHT arrow in vehicle).
void vehicle_turn(int dir)
{
if (!in_vehicle or player_vehicle_index < 0) return;
if (player_seat != 0)
{
speak("Only the driver can control the vehicle.");
return;
}
vehicle@ v = map_vehicles[player_vehicle_index];
if (dir < 0)
v.facing = snapleft(v.facing, int(getdir(v.facing)));
else
v.facing = snapright(v.facing, int(getdir(v.facing)));
facing = v.facing; // sync player facing
play_vehicle_audio(v, "turn");
speak(dir_to_string(int(getdir(v.facing))));
send_reliable(0, "veh_turn " + player_vehicle_index + " " + v.facing, 0);
send_reliable(0, "turn " + facing, 0);
}

// Turn vehicle 1 degree (Shift+LEFT/RIGHT in vehicle).
void vehicle_turn_fine(int dir)
{
if (!in_vehicle or player_vehicle_index < 0) return;
if (player_seat != 0)
{
speak("Only the driver can control the vehicle.");
return;
}
vehicle@ v = map_vehicles[player_vehicle_index];
if (dir < 0)
v.facing = turnleft(v.facing, 1);
else
v.facing = turnright(v.facing, 1);
facing = v.facing;
play_vehicle_audio(v, "turn");
speak(int(v.facing) + " degrees.");
send_reliable(0, "veh_turn " + player_vehicle_index + " " + v.facing, 0);
send_reliable(0, "turn " + facing, 0);
}

// Apply damage to a vehicle. Returns true if destroyed.
bool vehicle_take_damage(int vi, int damage)
{
if (vi < 0 or vi >= int(map_vehicles.length())) return false;
vehicle@ v = map_vehicles[vi];
if (v.destroyed) return false;

if (v.armor > 0)
{
// Armor absorbs full damage, then 1/4 of health is also taken.
v.armor -= damage;
if (v.armor < 0) v.armor = 0;
v.health -= damage / 4;
}
else
{
v.health -= damage;
}

if (v.health <= 0)
{
v.health = 0;
v.destroyed = true;
return true;
}
return false;
}

// Called when vehicle is destroyed - kicks all players, deals 1/4 health damage.
void vehicle_on_destroy(int vi)
{
if (vi < 0 or vi >= int(map_vehicles.length())) return;
vehicle@ v = map_vehicles[vi];
play_vehicle_audio(v, "destroy");
speak(v.get_name() + " destroyed!");
send_reliable(0, "veh_destroy " + vi, 0);
// Kick all players.
for (int i = 0; i < int(v.passengers.length()); i++)
{
v.passengers[i] = "";
v.window_down[i] = false;
}
if (player_vehicle_index == vi)
{
// Player takes 1/4 health damage.
send_reliable(0, "veh_explode_damage", 0);
player_vehicle_index = -1;
player_seat = -1;
in_vehicle = false;
vehicle_current_velocity=0;
vehicle_target_velocity=0;
vehicle_decelerating = false;
}
}

// Get vehicle health/armor status string.
string get_vehicle_status()
{
if (!in_vehicle or player_vehicle_index < 0) return "";
vehicle@ v = map_vehicles[player_vehicle_index];
string s = v.get_name() + ": ";
s += "Health " + v.health + " of " + vehicle_types[v.type_index].max_health + ".";
if (vehicle_types[v.type_index].armor > 0)
s += " Armor " + v.armor + " of " + vehicle_types[v.type_index].armor + ".";
s += " Current speed "+round(vehicle_current_velocity,1)+" of "+round(v.vehicle_effective_top_speed(v),1)+" tiles per second. Target "+vehicle_speed_percent(v)+" percent. Fuel "+round(v.fuel,1)+" of "+round(v.vehicle_effective_capacity(v),1)+" litres of "+vehicle_types[v.type_index].fuel_type+".";
s += " " + v.seat_label(player_seat) + ".";
if (v.has_seat_window(player_seat))
{
if (v.window_down[player_seat])
s += " Window down.";
else
s += " Window up.";
}
return s;
}

// Vehicle movement loop - called each frame from mainloop.
void vehicle_loop()
{
if(vehicle_roof_index>=0)
{
if(vehicle_roof_index>=int(map_vehicles.length()) or map_vehicles[vehicle_roof_index].destroyed) vehicle_roof_index=-1;
else
{
vehicle@ roof=map_vehicles[vehicle_roof_index];
bool aircraft_launch=roof.get_name()=="Duo Plane" and roof.z>vehicle_roof_last_z;
if(aircraft_launch or roof.observed_velocity>5.5)
{
vehicle_roof_index=-1;
me.z=double(roof.z)+1;
falling=true;
p.play_stationary("vehicle_"+vehicle_audio_id(roof)+"_crash.ogg",false);
speak(aircraft_launch?"Thrown from the aircraft as it launched.":"Thrown from the moving vehicle.");
}
else
{
me.x=roof.x;me.y=roof.y;me.z=roof.z+1;mr.x=roof.x;mr.y=roof.y;
if(roof.x!=vehicle_roof_last_x or roof.y!=vehicle_roof_last_y or roof.z!=vehicle_roof_last_z)
send_reliable(1,"move_to "+mr.x+" "+mr.y+" "+me.z,0);
}
vehicle_roof_last_x=roof.x;vehicle_roof_last_y=roof.y;vehicle_roof_last_z=roof.z;
}
}
if (!in_vehicle or player_vehicle_index < 0) return;
vehicle@ v = map_vehicles[player_vehicle_index];
if (v.destroyed)
{
vehicle_on_destroy(player_vehicle_index);
return;
}

// Integrate acceleration and braking continuously in real time.
if (vehicle_accel_timer.elapsed >= 50)
{
double dt=double(vehicle_accel_timer.elapsed)/1000.0;
vehicle_accel_timer.restart();
if(vehicle_current_velocity<vehicle_target_velocity)
{
vehicle_current_velocity+=vehicle_types[v.type_index].acceleration*dt;
if(vehicle_current_velocity>vehicle_target_velocity) vehicle_current_velocity=vehicle_target_velocity;
}
else if(vehicle_current_velocity>vehicle_target_velocity)
{
vehicle_current_velocity-=vehicle_types[v.type_index].braking*dt;
if(vehicle_current_velocity<vehicle_target_velocity) vehicle_current_velocity=vehicle_target_velocity;
}
if(vehicle_decelerating and vehicle_current_velocity<=0) { vehicle_current_velocity=0; vehicle_decelerating=false; speak("Stopped."); }
}

// Move vehicle if driving.
int tile_interval=vehicle_current_velocity>0 ? int(1000.0/vehicle_current_velocity) : 0;
if (player_seat == 0 and tile_interval>0 and vehicle_move_timer.elapsed >= tile_interval)
{
vehicle_move_timer.restart();
if(v.fuel<=0){vehicle_current_velocity=0;vehicle_target_velocity=0;speak("The vehicle is out of "+vehicle_types[v.type_index].fuel_type+".");play_vehicle_audio(v,"stop");return;}
if(v.engine_condition<=0 or v.transmission_condition<=0){vehicle_current_velocity=0;vehicle_target_velocity=0;speak(v.engine_condition<=0?"The engine is mechanically disabled.":"The transmission can no longer transfer power.");play_vehicle_audio(v,"stop");return;}
// Calculate next position based on vehicle facing.
double rad = v.facing * 3.1415926535897932 / 180.0;
double nx = double(v.x) + sine(rad);
double ny = double(v.y) + cosine(rad);
int inx = int(round(nx, 0));
int iny = int(round(ny, 0));
// Boundary check.
if (inx < 0 or inx > int(max.x) or iny < 0 or iny > int(max.y))
{
vehicle_current_velocity=0;
vehicle_target_velocity=0;
speak("Edge of map. Stopped.");
return;
}
// Wall check.
string tile = get_tile_at(inx, iny, v.z);
bool flying=(v.get_name()=="Duo Plane" and v.z>0);
if (!flying and (tile == "" or tile == "blank" or string_contains(tile, "wall", 1) > -1))
{
// Hit a wall - take some damage.
vehicle_take_damage(player_vehicle_index, 50);
vehicle_current_velocity=0;
vehicle_target_velocity=0;
speak("Crashed into a wall! Stopped.");
play_vehicle_audio(v, "crash");
if (v.health <= 0) vehicle_on_destroy(player_vehicle_index);
return;
}
// Move vehicle.
v.x = inx;
v.y = iny;
double fuel_use=vehicle_types[v.type_index].fuel_per_tile*(1.0+double(100-v.engine_condition)/180.0+double(v.fuel_contamination)/100.0);if(v.performance_tune)fuel_use*=1.12;if(v.turbocharger)fuel_use*=1.18;if(v.auxiliary_armor)fuel_use*=1.1;v.fuel-=fuel_use;if(v.fuel<0)v.fuel=0;if(random(1,400)<=v.fuel_contamination){v.engine_condition-=random(1,3);if(v.engine_condition<0)v.engine_condition=0;}if(random(1,900)>v.cooling_condition+800){v.engine_condition--;if(v.engine_condition<0)v.engine_condition=0;}
if(random(1,700)==1)v.transmission_condition--;if(random(1,v.offroad_tires?1400:850)==1)v.tire_condition--;if(random(1,1100)==1)v.cooling_condition--;if(v.transmission_condition<0)v.transmission_condition=0;if(v.tire_condition<0)v.tire_condition=0;if(v.cooling_condition<0)v.cooling_condition=0;
// Sync player position to vehicle.
me.x = double(v.x);
me.y = double(v.y);
me.z = double(v.z);
mr.x = round(me.x, 0);
mr.y = round(me.y, 0);
// Play driving sound.
if (flying) p.play_stationary("duoplaneinside.ogg", false);
else p.play_stationary(tile + "step1.ogg", false);
send_reliable(1, "move_to " + mr.x + " " + mr.y + " " + me.z, 0);
send_reliable(0, "veh_move " + player_vehicle_index + " " + v.x + " " + v.y+" "+v.z+" "+vehicle_current_velocity+" "+mapname, 0);
checkzone();
}

// Stamina restoration while in vehicle - every 15 seconds.
if (vehicle_stamina_timer.elapsed >= 15000)
{
vehicle_stamina_timer.restart();
restore_stamina(5);
}
}

string pending_vehicle_nearby="";
string get_nearby_vehicles_string(int px, int py, int pz)
{
string result="";
for (uint i = 0; i < map_vehicles.length(); i++)
{
if (map_vehicles[i].destroyed) continue;
double dx = double(map_vehicles[i].x - px);
double dy = double(map_vehicles[i].y - py);
double dz = double(map_vehicles[i].z - pz);
double dist = square_root(dx * dx + dy * dy + dz * dz);
if (dist <= 30)
{
string info = map_vehicles[i].get_name();
if (map_vehicles[i].door_open)
info += ", open";
else
info += ", closed";
if (map_vehicles[i].count_occupants() > 0)
info += ", moving";
info += ", health " + map_vehicles[i].health + " of " + vehicle_types[map_vehicles[i].type_index].max_health;
if (vehicle_types[map_vehicles[i].type_index].armor > 0)
info += ", armor " + map_vehicles[i].armor + " of " + vehicle_types[map_vehicles[i].type_index].armor;
double angle = calculate_x_y_angle(double(px), double(py), double(map_vehicles[i].x), double(map_vehicles[i].y), 0);
string dir_name = dir_to_string(int(getdir(angle)));
if (dist < 1)
info += ", here.";
else
{
int level = 1;
if (map_vehicles[i].z > pz) level = 2;
else if (map_vehicles[i].z < pz) level = 0;
if (level == 2) info += ", above";
else if (level == 0) info += ", below";
info += ", " + dir_name + ", " + int(dist) + " feet away.";
}
if(result!="") result+=" ";
result+=info;
}
}
return result;
}
void announce_nearby_vehicles_tracked(int px, int py, int pz)
{
string info=get_nearby_vehicles_string(px, py, pz);
if(info!="") speak(info);
}

void check_vehicle_damage_from_explosion(int ex, int ey, int ez, int blast_radius, int min_dmg, int max_dmg)
{
for (uint i = 0; i < map_vehicles.length(); i++)
{
if (map_vehicles[i].destroyed) continue;
double dist = square_root(double((map_vehicles[i].x - ex) * (map_vehicles[i].x - ex) + (map_vehicles[i].y - ey) * (map_vehicles[i].y - ey) + (map_vehicles[i].z - ez) * (map_vehicles[i].z - ez)));
if (dist <= blast_radius)
{
int dmg = random(min_dmg, max_dmg);
if (vehicle_take_damage(int(i), dmg))
vehicle_on_destroy(int(i));
}
}
}

void check_vehicle_damage_from_bullet(int bx, int by, int bz, int spread, int min_dmg, int max_dmg)
{
for (uint i = 0; i < map_vehicles.length(); i++)
{
if (map_vehicles[i].destroyed) continue;
double dist = square_root(double((map_vehicles[i].x - bx) * (map_vehicles[i].x - bx) + (map_vehicles[i].y - by) * (map_vehicles[i].y - by) + (map_vehicles[i].z - bz) * (map_vehicles[i].z - bz)));
if (dist <= spread + 2)
{
int dmg = random(min_dmg, max_dmg);
if (vehicle_take_damage(int(i), dmg))
vehicle_on_destroy(int(i));
}
}
}
