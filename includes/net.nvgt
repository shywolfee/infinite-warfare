string netaddress="localhost";
int netport=1316;
class saved_server{string name,address;int port;saved_server(string n,string a,int p){name=n;address=a;port=p;}}
saved_server@[] saved_servers;
string server_list_path(){return client_data_path("servers.json");}
void save_server_list(){string data="{\n  \"servers\": [\n";for(uint i=0;i<saved_servers.length();i++)data+="    \""+saved_servers[i].name+"|"+saved_servers[i].address+"|"+saved_servers[i].port+"\""+(i+1<saved_servers.length()?",":"")+"\n";data+="  ]\n}\n";file_put_contents(server_list_path(),data,false);}
void init_server_list(){saved_servers.resize(0);saved_servers.insert_last(saved_server("Localhost","localhost",1316));if(file_exists(server_list_path())){string[] lines=string_split(file_get_contents(server_list_path()),"\n",false);for(uint i=0;i<lines.length();i++){string[] q=string_split(lines[i],"\"",false);if(q.length()<2 or string_contains(q[1],"|",1)<0)continue;string[] p=string_split(q[1],"|",false);if(p.length()!=3 or string_to_lower_case(p[1])=="localhost")continue;int port=string_to_number(p[2]);if(port>0 and port<=65535)saved_servers.insert_last(saved_server(p[0],p[1],port));}}save_server_list();}
void server_manager(){if(SCRIPT_COMPILED and !dev_unlocked){speak("Developer access is required.");return;}while(true){nv_form f;f.create_window("Server Manager",false,true);nv_form_list_box@ list=f.add_list("Saved servers","servers");for(uint i=0;i<saved_servers.length();i++)list.add(saved_servers[i].name+": "+saved_servers[i].address+":"+saved_servers[i].port,""+i);nv_form_button@ use=f.add_button("Use selected server","use",true);nv_form_button@ add=f.add_button("Add server","add");nv_form_button@ remove=f.add_button("Remove selected server","remove");nv_form_button@ close=f.add_button("Close","close",false,true);f.focus_control(list);bool refresh=false;while(true){wait(5);f.monitor();if(f.is_pressed(close))return;if(f.is_pressed(use)){int pos=list.list_position;if(pos>=0 and pos<int(saved_servers.length())){netaddress=saved_servers[pos].address;netport=saved_servers[pos].port;writeprefs();speak("Selected "+saved_servers[pos].name+".");}return;}if(f.is_pressed(add)){string label=af_input("Server name","",false).trim_whitespace();string address=af_input("Server address","",false).trim_whitespace();int port=string_to_number(af_input("Server port","1316",false));if(label!="" and address!="" and port>0 and port<=65535 and string_contains(label,"|",1)<0 and string_contains(address,"|",1)<0){saved_servers.insert_last(saved_server(label,address,port));save_server_list();refresh=true;}else speak("The server name, address, or port is invalid.");break;}if(f.is_pressed(remove)){int pos=list.list_position;if(pos==0)speak("Localhost is permanent and cannot be removed.");else if(pos>0 and pos<int(saved_servers.length())){saved_servers.remove_at(pos);save_server_list();speak("Server removed.");refresh=true;}break;}}if(!refresh)return;}}
uint peer_id=0;
// A disconnect only means ours when it is the server's connection that went.
// Anything else -- a leftover connection request finally timing out -- is
// closed quietly instead of being reported as losing the server.
bool server_event_disconnect(network_event@ ev)
{
if(ev.type!=event_disconnect)return false;
return peer_id==0 or ev.peer_id==peer_id;
}
// Probe the server with a temporary connection and return true if it responds.
// Times out after 5 seconds. Uses its own local network object so it does not
// disturb the global n or connected state.
bool server_online()
{
network probe;
probe.setup_client(1, 100);
probe.connect(netaddress, netport);
timer pt;
while(pt.elapsed<5000)
{
wait(5);
network_event ev=probe.request();
if(ev.type==event_connect)
return true;
if(ev.type==event_disconnect)
return false;
}
return false;
}

// Always discard a failed or abandoned connection completely. A connection
// request that has not been answered stays alive inside the network host,
// and calling setup_client again does not cancel it: if the first attempt
// failed because the server was down or the network dropped out, that old
// request went through as soon as the server was reachable again, alongside
// the new one. The client then had two connections to the server. Messages
// sent to every peer arrived twice, messages sent to peer 1 could go to the
// connection that never logged in, and the server eventually dropped one or
// the other -- random disconnects that lasted until the game was restarted.
// Destroying the host is the only thing that cancels the old request.
void reset_connection_attempt()
{
n.destroy();
connected=false;
prevconnected=false;
staff_panel_available=false;
peer_id=0;
pinging=false;
e=network_event();
n.setup_client(20,500);
}
void send_login_handshake()
{
string message="connect_me "+name+" "+version+" "+comp;
if(SCRIPT_COMPILED==false and !dev_unlocked)message+=" from_source";
message+=" "+version_name;
send_reliable(0,message,0);
speak("signing in");
}
bool startup_queue_wait(string offer)
{
string status=offer;int split=string_contains(offer," ",1);if(split>=0)status=offer.substr(split+1);
if(yesno("The server is still starting: "+status+". Would you like to wait in the holding queue?")!=1){reset_connection_attempt();mainmenu();return false;}
send_reliable(0,"startup_join "+name,0);
speak("Waiting in the server startup queue. Press Space for progress, F1 for the queue, or Escape to leave.");
string position="Waiting for a queue position.";
while(true)
{
wait(5);e=n.request();
if(server_event_disconnect(e)){dlg("The server disconnected while you were waiting.");reset_connection_attempt();mainmenu();return false;}
if(e.type==event_receive)
{
string message=get_event_message();
if(message=="startup_admit"){speak("It is your turn. Entering the server.");return true;}
if(string_contains(message,"startup_status ",1)==0)status=message.substr(15);
else if(string_contains(message,"startup_queued ",1)==0){string[] fields=string_split(message," ",true);if(fields.length()>=3)position="Position "+fields[1]+" of "+fields[2]+" in the holding queue.";}
else if(string_contains(message,"startup_queue_list ",1)==0)speak("Holding queue: "+message.substr(19));
}
if(key_pressed(KEY_SPACE)){speak(position+" Server "+status);send_reliable(0,"startup_status_request",0);}
if(key_pressed(KEY_F1))send_reliable(0,"startup_queue_list",0);
if(key_pressed(KEY_ESCAPE)){send_reliable(0,"startup_leave",0);reset_connection_attempt();mainmenu();return false;}
}
return false;
}
void connect()
{
reset_connection_attempt();
timer connectiontimer;
timer reconnect_sound_timer;
if(lockout_active and lockout_timer.elapsed<900000)
{
int remaining=(900000-lockout_timer.elapsed)/1000;
dlg("You are locked out due to too many failed login attempts. Please wait "+remaining+" seconds before trying again.");
mainmenu();
return;
}
if(lockout_active and lockout_timer.elapsed>=900000)
{
lockout_active=false;
failed_login_attempts=0;
}
if(name=="" or !account_exists(name))
{
int reg_choice = yesno("You need an account to connect. Would you like to register one?");
if (reg_choice == 1)
{
registermenu();
return;
}
mainmenu();
return;
}
// Block unauthenticated accounts — offer to open the authorization screen.
if(!is_account_authenticated(name))
{
int auth_choice = yesno("Your account has not been authenticated yet. Would you like to enter your authorization code now?");
if (auth_choice == 1)
{
account_authorize_menu();
return;
}
mainmenu();
return;
}
if(connected==false and prevconnected==false)
{
n.connect(netaddress, netport);
speak("connecting to the server.");
}
connectiontimer.restart();
timer startup_hello_timer;bool login_handshake_sent=false;
while(true)
{
wait(5);
if(!connected and reconnect_sound_timer.elapsed>=3000){p.play_stationary("reconnecting.ogg",false);reconnect_sound_timer.restart();}
e=n.request();
if(connected and !login_handshake_sent and startup_hello_timer.elapsed>1500 and e.type!=event_receive){send_login_handshake();login_handshake_sent=true;}
if (key_pressed(KEY_ESCAPE))
{
reset_connection_attempt();
mainmenu();
return;
}
if(server_event_disconnect(e))
{
dlg("The server is currently down or under maintenance. Try connecting later.");
reset_connection_attempt();
mainmenu();
return;
}
if(connected==false and connectiontimer.elapsed>=5000)
{
iw_form cf;
cf.create_window("No answer from the server", false, true);
// Said aloud: this used to be a read-only box behind the focused button, so
// the explanation was only heard by tabbing back to it.
speak("The server has not answered for five seconds. It may be down, or your connection may be slow.");
int cf_wait=cf.create_button("&Keep waiting", true);
int cf_back=cf.create_button("&Back to main menu", false, true);
cf.focus(cf_wait);
bool resolved=false;
while(!resolved)
{
wait(5);
cf.monitor();
e=n.request();
if(e.type==event_connect)
{
resolved=true;
break;
}
if(server_event_disconnect(e))
{
dlg("The server is currently down or under maintenance. Try connecting later.");
reset_connection_attempt();
mainmenu();
return;
}
if(cf.is_pressed(cf_wait))
{
connectiontimer.restart();
resolved=true;
break;
}
if(cf.is_pressed(cf_back))
{
reset_connection_attempt();
mainmenu();
return;
}
}
if(e.type!=event_connect) continue;
}
if(e.type==event_connect and connected==false)
{
peer_id=e.peer_id;
connected=true;
last_server_msg.restart();
startup_hello_timer.restart();
send_reliable(0,"startup_hello "+name,0);
}
else if(e.type==event_receive and get_event_message()=="startup_ready"){if(!login_handshake_sent){send_login_handshake();login_handshake_sent=true;}}
else if(e.type==event_receive and string_contains(get_event_message(),"startup_offer ",1)==0)
{
if(startup_queue_wait(get_event_message())){send_login_handshake();login_handshake_sent=true;}
else return;
}
else if(e.type==event_receive and get_event_message()=="loggedin123")
{
// Stop map ambience that was loaded during login - it should not
// play until the player actually enters a game mode.
destroy_all_sources();
p.destroy_all();
if(connected==false) connected=true;
last_server_msg.restart();
p.play_stationary("executioners_rage/ui/connect.wav",false);
lobby();
}
else if(e.type==event_receive and string_contains(get_event_message(),"version_warning",1)==0)
{
// The server supports a newer version than this client, but it lets us in
// anyway. Say so and carry on; an open-source game must not disconnect people
// for running a different build.
dlg("This server is built for a newer version of Infinite Warfare ("+string_replace(get_event_message(),"version_warning ","",false)+"). You can still play; some newer features may be missing. Use Check for updates on the main menu to get the current version.");
}
else if(e.type==event_receive and get_event_message()=="ver")
{
dlg("This server only accepts its own version of Infinite Warfare. Return to the main menu and use Check for updates, or connect to a different server.");

reset_connection_attempt();
mainmenu();
}
else if(e.type==event_receive and get_event_message()=="dev_denied")
{
dlg("Access denied. Only authorized developers may connect when running from source. Use the administrator panel to enter a developer unlock key.");
reset_connection_attempt();
mainmenu();
}
else if(e.type==event_receive and get_event_message()=="alreadyin")
{
dlg("Sorry, this name is already in use.");
reset_connection_attempt();
mainmenu();
}
else if(e.type==event_receive and get_event_message()=="error")
{
dlg("An unknown error occurred.");
reset_connection_attempt();
mainmenu();
}
else if(e.type==event_receive and string_contains(get_event_message(),"banned",1)==0)
{
string ban_message=get_event_message();string reason=string_replace(ban_message,"banned","",false).trim_whitespace();dlg("You are banned from this server."+(reason!=""?" Reason: "+reason:""));
reset_connection_attempt();
mainmenu();
}
else if(e.type==event_receive)
{
if(string_contains(get_event_message(), "error:", 1)>-1)
dlg(get_event_message());
string[] parsed=string_split(get_event_message(), " ", false);
if(parsed[0]=="x")
{
me.x=string_to_number(parsed[1]);
}
else if(parsed[0]=="y")
{
me.y=string_to_number(parsed[1]);
}
else if(parsed[0]=="z")
{
me.z=string_to_number(parsed[1]);
}
else if(parsed[0]=="mapdata")
{
load_map(string_replace(get_event_message(), "mapdata ", "", false));
}
else if(parsed[0]=="facing")
{
facing=string_to_number(parsed[1]);
}
}
}
}
