// Infinite Warfare sound pack builder for NVGT 0.90.
// Builds to a temporary file, verifies the encrypted archive and a real audio
// decode, then replaces sounds.dat only after every check succeeds.

const string source_directory="sounds";
const string output_file="sounds.dat";
const string temporary_file="sounds.dat.new";
const string test_sound_file="sound_pack_test.ogg";
const string test_er_sound_file="sound_pack_test.wav";
const string pack_key="roflagerfkseuihfdruifysegyksGTRYHTTRGYJTHYT^$%%^#$%&^DTGRFGgdfygeyfgyjedfgydfgvGGBDGTRHR$#$5463r427547gERGRGHERsdfghjkl69";

string[] files_to_pack;
bool silent=false;

void fail(const string&in message)
{
file_delete(temporary_file);
file_delete(test_sound_file);
file_delete(test_er_sound_file);
if (!silent) alert("Sound pack build failed", message);
exit(1);
}

void collect_files(const string&in path)
{
string[] files=find_files(path+"/*.*");
for (uint i=0; i<files.length(); i++)
files_to_pack.insert_last(path+"/"+files[i]);

string[] directories=find_directories(path+"/*");
for (uint i=0; i<directories.length(); i++)
collect_files(path+"/"+directories[i]);
}

string archive_name(const string&in disk_path)
{
string prefix=source_directory+"/";
if (disk_path.length()>=prefix.length() and disk_path.substr(0, prefix.length())==prefix)
return disk_path.substr(prefix.length());
return disk_path;
}

void main()
{
silent=(COMMAND_LINE=="/s");
if (!directory_exists(source_directory))
fail("The sounds directory does not exist beside the builder.");

collect_files(source_directory);
if (files_to_pack.length()==0)
fail("The sounds directory is empty.");

file_delete(temporary_file);
pack_file writer;
if (!writer.create(temporary_file, pack_key))
fail("Could not create the temporary NVGT 0.90 archive.");

for (uint i=0; i<files_to_pack.length(); i++)
{
string internal_name=archive_name(files_to_pack[i]);
if (!writer.add_file(files_to_pack[i], internal_name))
{
writer.close();
fail("Could not add "+internal_name+" to the archive.");
}
wait(0);
}
if (!writer.close())
fail("Could not finalize the archive.");

pack_file verifier;
if (!verifier.open(temporary_file, pack_key))
fail("The completed archive could not be reopened with its encryption key.");
if (verifier.get_file_count()!=int64(files_to_pack.length()))
fail("Archive verification found the wrong number of files.");
if (!verifier.file_exists("logo.ogg"))
fail("Archive verification could not find logo.ogg.");
if(!verifier.file_exists("firefight_archive/weapons/ak47/fire.ogg"))
fail("Archive verification could not find the representative Firefight weapon recording.");
if(!verifier.file_exists("executioners_rage/environment/objects/coke_machine/dispense.wav"))
fail("Archive verification could not find the representative Executioner's Rage world recording.");
string[] required_regression_sounds={"ak47fire1.ogg","m1garantbattleriflefire1.ogg","benelli_m4_shotgunfire1.ogg","wirenetequip.ogg","executioners_rage/ui/bf.wav","executioners_rage/ui/bfn.wav"};
for(uint required_index=0;required_index<required_regression_sounds.length();required_index++)if(!verifier.file_exists(required_regression_sounds[required_index]))fail("Archive verification could not find required gameplay sound "+required_regression_sounds[required_index]+".");
if (!verifier.extract_file("logo.ogg", test_sound_file))
fail("Archive verification could not decrypt and extract logo.ogg.");

sound decode_test;
if (!decode_test.load(test_sound_file))
fail("NVGT 0.90 could not decode logo.ogg from the completed archive.");
decode_test.close();
file_delete(test_sound_file);
if(!verifier.extract_file("firefight_archive/weapons/ak47/fire.ogg",test_sound_file))fail("Could not decrypt the representative Firefight recording.");
if(!decode_test.load(test_sound_file))fail("NVGT 0.90 could not decode the representative Firefight recording.");
decode_test.close();file_delete(test_sound_file);
if(!verifier.extract_file("executioners_rage/environment/objects/coke_machine/dispense.wav",test_er_sound_file))fail("Could not decrypt the representative Executioner's Rage recording.");
if(!decode_test.load(test_er_sound_file))fail("NVGT 0.90 could not decode the representative Executioner's Rage recording.");
decode_test.close();file_delete(test_er_sound_file);
verifier.close();

if (!file_copy(temporary_file, output_file, true))
fail("The verified archive could not replace sounds.dat.");
file_delete(temporary_file);

if (!silent)
alert("Sound pack complete", "Built and verified "+files_to_pack.length()+" sounds in "+output_file+".");
}
