// Shared blast rules for launched and thrown explosives. Damage is full at the
// centre and falls to a quarter at the edge. A wall between the blast and its
// victim soaks three quarters of what is left, so cover works against
// explosives as it does against bullets. Launcher and mortar blasts used to
// deal their full damage everywhere inside the radius, through any wall.
// Blasts are worked out by detonate() in explosions.nvgt.
int blast_damage_to_player(double x,double y,double z,string map,double radius,int damage,player@ target)
{
double scale=blast_overpressure(get_3d_distance(x,y,z,target.x,target.y,target.z+1),radius);if(scale<=0)return 0;
if(blast_line_blocked(x,y,z+.5,target.x,target.y,target.z+1.0,map))scale*=.25;
int result=int(double(damage)*scale);return result<1?1:result;
}
