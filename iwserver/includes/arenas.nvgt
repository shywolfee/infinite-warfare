class arena_member{string name,role;bool alive=true;arena_member(string n,string r){name=n;role=r;alive=r=="combatant";}}
class arena_instance{int id;string host,type,map,state="waiting";arena_member@[] members;arena_instance(int i,string h,string t){id=i;host=h;type=t;map=arena_map(t);members.insert_last(arena_member(h,"combatant"));}}
arena_instance@[] arenas;int next_arena_id=1;
string arena_type_name(string t){if(t=="sidearms")return "Sidearm Showdown";if(t=="melee")return "Close Quarters";if(t=="explosives")return "Demolition Ring";return "Open Arsenal";}
string arena_map(string t){if(t=="sidearms")return "arena_sidearms";if(t=="melee")return "arena_melee";if(t=="explosives")return "arena_explosives";return "arena_open";}
string arena_rules(string t){if(t=="sidearms")return "Last combatant standing; sidearm and ammunition loadout.";if(t=="melee")return "Last combatant standing; melee weapons only.";if(t=="explosives")return "Last combatant standing; grenades and defensive equipment.";return "Last combatant standing with a balanced rifle, sidearm, medical and explosive loadout.";}
string arena_loadout(string t){if(t=="sidearms")return "glock17,9x19mm_17_round_magazine,9x19mm_17_round_magazine,er_mini_med_pack";if(t=="melee")return "combatknife,baseball_bat,er_mini_med_pack";if(t=="explosives")return "frag_grenade,frag_grenade,smoke_bomb,flashbang,combatknife";return "m4a1_carbine,5.56mm_stanag_magazine,5.56mm_stanag_magazine,glock17,9x19mm_17_round_magazine,frag_grenade,er_mini_med_pack";}
int arena_index(int id){for(uint i=0;i<arenas.length();i++)if(arenas[i].id==id)return int(i);return -1;}
int arena_member_index(arena_instance@ a,string name){for(uint i=0;i<a.members.length();i++)if(string_to_lower_case(a.members[i].name)==string_to_lower_case(name))return int(i);return -1;}
string arena_listing(){string result="arena_list ";for(uint i=0;i<arenas.length();i++){if(i>0)result+=";";result+=arenas[i].id+"~"+arena_type_name(arenas[i].type)+"~"+arenas[i].host+"~"+arenas[i].state+"~"+arenas[i].members.length()+"~"+map_display_title(arenas[i].map)+"~"+arena_rules(arenas[i].type);}return result;}
string arena_overview(player@ p)
{
int ai=arena_index(p.arena_id);if(ai<0)return "arena_overview none";arena_instance@ a=arenas[ai];int combatants=0,spectators=0;for(uint i=0;i<a.members.length();i++){if(a.members[i].role=="combatant")combatants++;else spectators++;}return "arena_overview "+a.id+"~"+a.state+"~"+p.arena_role+"~"+a.host+"~"+arena_type_name(a.type)+"~"+map_display_title(a.map)+"~"+combatants+"~"+spectators+"~"+arena_rules(a.type);
}
void arena_transfer_player(player@ p,string destination,int x,int y,int z)
{
string path=indexed_map_path(destination);if(path=="")return;string old=p.map;send_reliable(p.peer_id,"arena_transfer "+destination+" "+x+" "+y+" "+z,0);send_reliable(0,"offline "+p.x+" "+p.y+" "+p.z+" "+p.name+" "+old,0,get_player_index(p.peer_id));p.map=destination;p.x=x;p.y=y;p.z=z;p.last_x=x;p.last_y=y;p.last_z=z;set_player_model_target(p,x,y,z);server_physics_sync_players();send_reliable(p.peer_id,"mapdata "+read_whole_file(path),0);send_reliable(p.peer_id,"setcoords "+x+" "+y+" "+z,0);er_sync_fixtures_to(p.peer_id,destination);send_reliable(0,"online "+x+" "+y+" "+z+" "+p.name+" "+destination,0);
}
void arena_remember_return(player@ p){if(p.arena_return_map!="")return;p.arena_return_map=p.map;p.arena_return_x=p.x;p.arena_return_y=p.y;p.arena_return_z=p.z;}
void arena_return_player(player@ p){if(p.arena_return_map!=""){string destination=p.arena_return_map;int x=p.arena_return_x,y=p.arena_return_y,z=p.arena_return_z;p.arena_return_map="";arena_transfer_player(p,destination,x,y,z);}p.arena_id=0;p.arena_role="none";p.death=false;p.health=1000;p.hitby="no one";}
void arena_sync_member(arena_instance@ a,arena_member@ m){int pi=get_player_index_from(m.name);if(pi>=0){players[pi].arena_id=a.id;players[pi].arena_role=m.role;send_reliable(players[pi].peer_id,"arena_status "+a.id+"|"+a.state+"|"+m.role+"|"+arena_type_name(a.type)+"|"+arena_rules(a.type),0);}}
void arena_close(int ai,string winner=""){if(ai<0 or ai>=int(arenas.length()))return;arena_instance@ a=arenas[ai];for(uint i=0;i<a.members.length();i++){int pi=get_player_index_from(a.members[i].name);if(pi>=0){send_reliable(players[pi].peer_id,"arena_finished "+a.id+" "+winner,0);arena_return_player(players[pi]);}}arenas.remove_at(ai);}
void arena_start(arena_instance@ a)
{
int combatants=0;for(uint i=0;i<a.members.length();i++)if(a.members[i].role=="combatant")combatants++;if(combatants<2)return;int map_index=get_map_index(a.map);if(map_index<0){int host=get_player_index_from(a.host);if(host>=0)send_reliable(players[host].peer_id,"arena_error Arena map data is unavailable.",0);return;}a.state="active";for(uint i=0;i<a.members.length();i++){arena_member@ m=a.members[i];m.alive=m.role=="combatant";int pi=get_player_index_from(m.name);if(pi<0)continue;player@ p=players[pi];arena_remember_return(p);p.arena_id=a.id;p.arena_role=m.role;p.death=false;p.health=1000;p.hitby="no one";int sp=int(i)*3;if(sp+2>=int(maps[map_index].spawn_points.length()))sp=0;int sx=maps[map_index].spawn_points.length()>=3?maps[map_index].spawn_points[sp]:10,sy=maps[map_index].spawn_points.length()>=3?maps[map_index].spawn_points[sp+1]:10,sz=maps[map_index].spawn_points.length()>=3?maps[map_index].spawn_points[sp+2]:0;arena_transfer_player(p,a.map,sx,sy,sz);send_reliable(p.peer_id,"arena_begin "+a.id+" "+m.role+" "+a.type+" "+arena_loadout(a.type),0);}send_reliable(0,"Arena "+a.id+", "+arena_type_name(a.type)+", has begun with "+combatants+" combatants.",2);int host=get_player_index_from(a.host);if(host>=0)send_reliable(players[host].peer_id,"arena_ok Arena started.",0);
}
bool arena_on_death(player@ p)
{
if(p.arena_id<=0 or p.arena_role!="combatant")return false;int ai=arena_index(p.arena_id);if(ai<0)return false;arena_instance@ a=arenas[ai];int mi=arena_member_index(a,p.name);if(mi>=0){a.members[mi].alive=false;a.members[mi].role="spectator";}p.arena_role="spectator";p.health=1000;p.hitby="no one";int alive=0;string winner="";for(uint i=0;i<a.members.length();i++)if(a.members[i].role=="combatant" and a.members[i].alive){alive++;winner=a.members[i].name;}send_reliable(p.peer_id,"arena_eliminated "+a.id,0);if(alive<=1){send_reliable(0,alive==1?winner+" wins arena "+a.id+", "+arena_type_name(a.type)+"!":"Arena "+a.id+" ended with no surviving combatant.",2);arena_close(ai,winner);}return true;
}
void handle_arena_request(uint peer,const string &in raw,const string[] &in f)
{
int pi=get_player_index(peer);if(pi<0)return;player@ p=players[pi];string cmd=f[0];if(cmd=="arena_list"){send_reliable(peer,arena_listing(),0);return;}if(cmd=="arena_overview"){send_reliable(peer,arena_overview(p),0);return;}if(cmd=="arena_resync"){int ai=arena_index(p.arena_id);if(ai<0 or arenas[ai].state!="active"){send_reliable(peer,"arena_error No active arena is available to synchronize.",0);return;}int mi=arena_member_index(arenas[ai],p.name);if(mi<0)return;int map_index=get_map_index(arenas[ai].map),sp=mi*3;if(map_index<0)return;if(sp+2>=int(maps[map_index].spawn_points.length()))sp=0;int sx=maps[map_index].spawn_points.length()>=3?maps[map_index].spawn_points[sp]:10,sy=maps[map_index].spawn_points.length()>=3?maps[map_index].spawn_points[sp+1]:10,sz=maps[map_index].spawn_points.length()>=3?maps[map_index].spawn_points[sp+2]:0;arena_transfer_player(p,arenas[ai].map,sx,sy,sz);send_reliable(peer,"arena_begin "+arenas[ai].id+" "+arenas[ai].members[mi].role+" "+arenas[ai].type+" "+arena_loadout(arenas[ai].type),0);return;}if(cmd=="arena_create" and f.length()>2){if(p.arena_id>0){send_reliable(peer,"arena_error Leave your current arena first.",0);return;}string type=f[1],role=f[2];arena_instance a(next_arena_id++,p.name,type);if(role=="spectator"){a.members[0].role="spectator";a.members[0].alive=false;}arenas.insert_last(a);p.arena_id=a.id;p.arena_role=role;send_reliable(peer,"arena_ok Created arena "+a.id+" on "+map_display_title(a.map)+".",0);return;}if(cmd=="arena_join" and f.length()>2){int ai=arena_index(string_to_number(f[1]));if(ai<0 or arenas[ai].state!="waiting"){send_reliable(peer,"arena_error That arena is not accepting players.",0);return;}if(p.arena_id>0){send_reliable(peer,"arena_error Leave your current arena first.",0);return;}string role=f[2]=="spectator"?"spectator":"combatant";arenas[ai].members.insert_last(arena_member(p.name,role));p.arena_id=arenas[ai].id;p.arena_role=role;send_reliable(peer,"arena_ok Joined arena "+arenas[ai].id+" as "+role+". You will transfer when the host starts it.",0);return;}if(cmd=="arena_start"){int ai=arena_index(p.arena_id);if(ai<0 or arenas[ai].host!=p.name){send_reliable(peer,"arena_error Only the host can start this arena.",0);return;}int count=0;for(uint i=0;i<arenas[ai].members.length();i++)if(arenas[ai].members[i].role=="combatant")count++;if(count<2){send_reliable(peer,"arena_error At least two combatants are required.",0);return;}arena_start(arenas[ai]);return;}if(cmd=="arena_leave"){int ai=arena_index(p.arena_id);if(ai>=0 and arenas[ai].host==p.name){for(uint m=0;m<arenas[ai].members.length();m++){int member=get_player_index_from(arenas[ai].members[m].name);if(member>=0){send_reliable(players[member].peer_id,"arena_finished "+arenas[ai].id+" ",0);arena_return_player(players[member]);}}arenas.remove_at(ai);send_reliable(peer,"arena_ok Closed the hosted arena and returned all participants.",0);return;}if(ai>=0){int mi=arena_member_index(arenas[ai],p.name);if(mi>=0)arenas[ai].members.remove_at(mi);}arena_return_player(p);send_reliable(peer,"arena_ok Left the arena and returned to your previous position.",0);return;}if(cmd=="arena_status"){int ai=arena_index(p.arena_id);if(ai<0)send_reliable(peer,"arena_error You are not in an arena.",0);else{int mi=arena_member_index(arenas[ai],p.name);if(mi>=0)arena_sync_member(arenas[ai],arenas[ai].members[mi]);}}
}
