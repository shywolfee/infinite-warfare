string[] _kb_key_names;
int[] _kb_key_codes;
string[] _kb_key_labels;
string[] _kb_act_names;
string[] _kb_act_labels;
int[] _kb_act_defaults;
int[] _kb_act_binds;
int[] _kb_act_modifiers;
string kb_active_profile="Default";
const string KB_PROFILE_DIR=DIRECTORY_LOCAL_APPDATA+"/iw/keymaps";
const string KB_CONFIG_PATH=DIRECTORY_LOCAL_APPDATA+"/iw/keyconfig.json";

void _kb_reg_key(string name, int code, string label)
{
_kb_key_names.insert_last(name);
_kb_key_codes.insert_last(code);
_kb_key_labels.insert_last(label);
}

void _kb_reg_action(string name, string label, int default_key, int modifiers=0)
{
_kb_act_names.insert_last(name);
_kb_act_labels.insert_last(label);
_kb_act_defaults.insert_last(default_key);
_kb_act_binds.insert_last(default_key);
_kb_act_modifiers.insert_last(modifiers);
}

string kb_modifier_label(int modifiers)
{
string result="";
if ((modifiers&KEYMOD_CTRL)>0) result+="Control+";
if ((modifiers&KEYMOD_ALT)>0) result+="Alt+";
if ((modifiers&KEYMOD_SHIFT)>0) result+="Shift+";
return result;
}

string kb_binding_label(uint action_index)
{
return kb_modifier_label(_kb_act_modifiers[action_index])+kb_key_label(_kb_act_binds[action_index]);
}

string kb_binding_label(string action)
{
for(uint i=0;i<_kb_act_names.length();i++)if(_kb_act_names[i]==action)return kb_binding_label(i);
return "unbound";
}

int kb(string action)
{
for (uint i=0; i<_kb_act_names.length(); i++)
{
if (_kb_act_names[i]==action) return _kb_act_binds[i];
}
return -1;
}

int kb_current_modifiers()
{
int modifiers=0;
if(key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT))modifiers|=KEYMOD_SHIFT;
if(key_down(KEY_LMENU) or key_down(KEY_RMENU))modifiers|=KEYMOD_ALT;
if(key_down(KEY_LCONTROL) or key_down(KEY_RCONTROL))modifiers|=KEYMOD_CTRL;
return modifiers;
}

bool kb_action_pressed(string action)
{
for(uint i=0;i<_kb_act_names.length();i++)if(_kb_act_names[i]==action)return key_pressed(_kb_act_binds[i]) and kb_current_modifiers()==_kb_act_modifiers[i];
return false;
}

string kb_key_to_name(int code)
{
for (uint i=0; i<_kb_key_codes.length(); i++)
{
if (_kb_key_codes[i]==code) return _kb_key_names[i];
}
return "unknown";
}

int kb_name_to_key(string name)
{
for (uint i=0; i<_kb_key_names.length(); i++)
{
if (_kb_key_names[i]==name) return _kb_key_codes[i];
}
return -1;
}

string kb_key_label(int code)
{
for (uint i=0; i<_kb_key_codes.length(); i++)
{
if (_kb_key_codes[i]==code) return _kb_key_labels[i];
}
return "Unknown";
}

