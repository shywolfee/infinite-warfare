// Run by every dialog each frame, just before the helper service. It must not
// call the helper service itself: the helper service runs this pump for the
// older list menus, and the two calling each other froze the game solid the
// moment it was connected and showing a dialog -- that is, on entering the
// lobby.
bool pumping_network_for_form=false;
void pump_network_for_form()
{
if(pumping_network_for_form)return;
pumping_network_for_form=true;
process_fullscreen_shortcut();
process_screenshot_shortcut();
// In the lobby the lobby's handler reads the network; during a match the
// match's does. This used to run the match handler everywhere, so screens
// opened from the lobby -- the Armoury among them -- had lobby messages
// read as match messages, and the lobby's own keep-alive replies consumed
// by code that did not know what they were.
if(connected and nv_form_network_timer.elapsed>=10 and form_net_depth==0)
{
nv_form_network_timer.restart();
form_net_depth++;
if(mapname=="" or mapname=="main")lobby_form_netcheck();else netloop(false);
form_net_depth--;
}
pumping_network_for_form=false;
}
