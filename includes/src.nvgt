// Map sound sources: looping beds that fill a rectangle of the map.
//
// Each source plays on a pool chosen by its `dist` value:
//   1  the gameplay pool, for things that are part of the action
//   2  the distant pool, for far-off combat
//   3  the ambience pool, for the map's own sound -- rivers, streets, rooms
// Map `src` lines are ambience. They used to play on the gameplay pool, which
// meant the "World and positional ambience" volume did nothing to them and a
// firefight's worth of weapon sounds could crowd them out of slots.
source@[] sources(0);

sound_pool@ source_pool(int dist)
{
if(dist==2)return distpool;
if(dist==3)return ambpool;
return p;
}

class source
{
int source_sound;
int lx,rx,miny,maxy,minz,maxz;
int dist;
string soundfile;
bool paused=false;
int id=-1;
bool p2;
source(int source_lx,int source_rx,int source_miny,int source_maxy,int source_minz,int source_maxz,string file,int sdist,bool source_paused=false,int source_id=-1)
{
dist=sdist;
lx=source_lx;rx=source_rx;miny=source_miny;maxy=source_maxy;minz=source_minz;maxz=source_maxz;
soundfile=file;
id=source_id;
sound_pool@ pool=source_pool(dist);
source_sound=pool.play_3d(soundfile,me.x,me.y,me.z,lx,miny,minz,facing,true);
pool.update_sound_3d(source_sound,lx,miny,minz);
paused=source_paused;
if(paused)pool.pause_sound(source_sound);
p2=paused;
pool.update_sound_range_3d(source_sound,0,rx-lx,0,maxy-miny,0,maxz-minz);
}
}

void sourcecheckloop()
{
for(uint i=0;i<sources.length();i++)
{
source@ s=sources[i];
if(s.paused==s.p2)continue;
sound_pool@ pool=source_pool(s.dist);
if(s.paused)pool.pause_sound(s.source_sound);
else pool.resume_sound(s.source_sound);
s.p2=s.paused;
}
}
void destroy_all_sources()
{
for(uint i=0;i<sources.length();i++)source_pool(sources[i].dist).destroy_sound(sources[i].source_sound);
sources.resize(0);
}
void pause_all_sources()
{
for(uint i=0;i<sources.length();i++){source_pool(sources[i].dist).pause_sound(sources[i].source_sound);sources[i].paused=true;}
}
void resume_all_sources()
{
for(uint i=0;i<sources.length();i++){source_pool(sources[i].dist).resume_sound(sources[i].source_sound);sources[i].paused=false;}
}
void spawn_source(int source_lx,int source_rx,int source_miny,int source_maxy,int source_minz,int source_maxz,string soundfile,int dist,bool paused=false,int id=-1)
{
source source1(source_lx,source_rx,source_miny,source_maxy,source_minz,source_maxz,soundfile,dist,paused,id);
sources.insert_last(source1);
}
void destroy_source(int id)
{
for(uint i=0;i<sources.length();i++)
{
if(sources[i].id!=id or id<0)continue;
source_pool(sources[i].dist).destroy_sound(sources[i].source_sound);
sources.remove_at(i);
i--;
}
}
void move_src(int id,int newminix,int newmaxx,int newminiy,int newmaxy,int newminiz,int newmaxz)
{
for(uint i=0;i<sources.length();i++)
{
source@ s=sources[i];
if(s.id!=id)continue;
s.lx=newminix;s.miny=newminiy;s.minz=newminiz;s.rx=newmaxx;s.maxy=newmaxy;s.maxz=newmaxz;
sound_pool@ pool=source_pool(s.dist);
pool.update_sound_3d(s.source_sound,s.lx,s.miny,s.minz);
pool.update_sound_range_3d(s.source_sound,0,s.rx-s.lx,0,s.maxy-s.miny,0,s.maxz-s.minz);
}
}
