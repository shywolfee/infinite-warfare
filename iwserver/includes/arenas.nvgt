class arena_member{string name,role;bool alive=true;arena_member(string n,string r){name=n;role=r;alive=r=="combatant";}}
class arena_instance{int id;string host,type,map,state="waiting";arena_member@[] members;arena_instance(int i,string h,string t,string m){id=i;host=h;type=t;map=m;members.insert_last(arena_member(h,"combatant"));}}
arena_instance@[] arenas;int next_arena_id=1;
string arena_type_name(string t){if(t=="sidearms")return "Sidearm Showdown";if(t=="melee")return "Close Quarters";if(t=="explosives")return "Demolition Ring";return "Open Arsenal";}
string arena_rules(string t){if(t=="sidearms")return "Last combatant standing; sidearm and ammunition loadout.";if(t=="melee")return "Last combatant standing; melee weapons only.";if(t=="explosives")return "Last combatant standing; grenades and defensive equipment.";return "Last combatant standing with a balanced rifle, sidearm, medical and explosive loadout.";}
string arena_loadout(string t){if(t=="sidearms")return "glock_17_pistol,9x19mm_15_round_magazine,9x19mm_15_round_magazine,mini_med";if(t=="melee")return "combatknife,baseball_bat,mini_med";if(t=="explosives")return "frag_grenade,frag_grenade,smoke_bomb,flashbang,combatknife";return "m4a1_carbine,5.56mm_stanag_magazine,5.56mm_stanag_magazine,glock_17_pistol,9x19mm_15_round_magazine,frag_grenade,mini_med";}
int arena_index(int id){for(uint i=0;i<arenas.length();i++)if(arenas[i].id==id)return int(i);return -1;}
int arena_member_index(arena_instance@ a,string name){for(uint i=0;i<a.members.length();i++)if(string_to_lower_case(a.members[i].name)==string_to_lower_case(name))return int(i);return -1;}
string arena_listing(){string result="arena_list ";for(uint i=0;i<arenas.length();i++){if(i>0)result+=";";result+=arenas[i].id+"~"+arena_type_name(arenas[i].type)+"~"+arenas[i].host+"~"+arenas[i].state+"~"+arenas[i].members.length()+"~"+arenas[i].map+"~"+arena_rules(arenas[i].type);}return result;}
void arena_sync_member(arena_instance@ a,arena_member@ m){int pi=get_player_index_from(m.name);if(pi>=0){players[pi].arena_id=a.id;players[pi].arena_role=m.role;send_reliable(players[pi].peer_id,"arena_status "+a.id+"|"+a.state+"|"+m.role+"|"+arena_type_name(a.type)+"|"+arena_rules(a.type),0);}}
void arena_start(arena_instance@ a)
{
int combatants=0;for(uint i=0;i<a.members.length();i++)if(a.members[i].role=="combatant")combatants++;if(combatants<2)return;a.state="active";int spawn_offset=0;for(uint i=0;i<a.members.length();i++){arena_member@ m=a.members[i];m.alive=m.role=="combatant";int pi=get_player_index_from(m.name);if(pi<0)continue;player@ p=players[pi];p.arena_id=a.id;p.arena_role=m.role;p.death=false;p.health=1000;p.hitby="no one";int[] at=choose_safe_player_spawn(a.map,p.x+spawn_offset,p.y+spawn_offset,p.z);p.x=at[0];p.y=at[1];p.z=at[2];p.map=a.map;set_player_model_target(p,p.x,p.y,p.z);send_reliable(p.peer_id,"setcoords "+p.x+" "+p.y+" "+p.z,0);send_reliable(p.peer_id,"arena_begin "+a.id+" "+m.role+" "+a.type+" "+arena_loadout(a.type),0);spawn_offset+=3;}send_reliable(0,"Arena "+a.id+", "+arena_type_name(a.type)+", has begun with "+combatants+" combatants.",2);
int host=get_player_index_from(a.host);if(host>=0)send_reliable(players[host].peer_id,"arena_ok Arena started.",0);
}
bool arena_on_death(player@ p)
{
if(p.arena_id<=0 or p.arena_role!="combatant")return false;int ai=arena_index(p.arena_id);if(ai<0)return false;arena_instance@ a=arenas[ai];int mi=arena_member_index(a,p.name);if(mi>=0){a.members[mi].alive=false;a.members[mi].role="spectator";}p.arena_role="spectator";p.health=1000;p.hitby="no one";int alive=0;string winner="";for(uint i=0;i<a.members.length();i++)if(a.members[i].role=="combatant" and a.members[i].alive){alive++;winner=a.members[i].name;}send_reliable(p.peer_id,"arena_eliminated "+a.id,0);if(alive<=1){a.state="finished";send_reliable(0,alive==1?winner+" wins arena "+a.id+", "+arena_type_name(a.type)+"!":"Arena "+a.id+" ended with no surviving combatant.",2);for(uint i=0;i<a.members.length();i++){int pi=get_player_index_from(a.members[i].name);if(pi>=0)send_reliable(players[pi].peer_id,"arena_finished "+a.id+" "+winner,0);}}return true;
}
void handle_arena_request(uint peer,const string &in raw,const string[] &in f)
{
if(f.length()>1 and f[0]=="arena_join"){int joining_player=get_player_index(peer),joining_arena=arena_index(string_to_number(f[1]));if(joining_player>=0 and joining_arena>=0 and players[joining_player].map!=arenas[joining_arena].map){send_reliable(peer,"arena_error Travel to "+map_display_title(arenas[joining_arena].map)+" before joining this arena.",0);return;}}
int pi=get_player_index(peer);if(pi<0)return;player@ p=players[pi];string cmd=f[0];if(cmd=="arena_list"){send_reliable(peer,arena_listing(),0);return;}if(cmd=="arena_create" and f.length()>2){if(p.arena_id>0){send_reliable(peer,"arena_error Leave your current arena first.",0);return;}string type=f[1],role=f[2];arena_instance a(next_arena_id++,p.name,type,p.map);if(role=="spectator"){a.members[0].role="spectator";a.members[0].alive=false;}arenas.insert_last(a);p.arena_id=a.id;p.arena_role=role;send_reliable(peer,"arena_ok Created arena "+a.id+".",0);return;}if(cmd=="arena_join" and f.length()>2){int ai=arena_index(string_to_number(f[1]));if(ai<0 or arenas[ai].state!="waiting"){send_reliable(peer,"arena_error That arena is not accepting players.",0);return;}if(p.arena_id>0){send_reliable(peer,"arena_error Leave your current arena first.",0);return;}string role=f[2]=="spectator"?"spectator":"combatant";arenas[ai].members.insert_last(arena_member(p.name,role));p.arena_id=arenas[ai].id;p.arena_role=role;send_reliable(peer,"arena_ok Joined arena "+arenas[ai].id+" as "+role+".",0);return;}if(cmd=="arena_start"){int ai=arena_index(p.arena_id);if(ai<0 or arenas[ai].host!=p.name){send_reliable(peer,"arena_error Only the host can start this arena.",0);return;}int count=0;for(uint i=0;i<arenas[ai].members.length();i++)if(arenas[ai].members[i].role=="combatant")count++;if(count<2){send_reliable(peer,"arena_error At least two combatants are required.",0);return;}arena_start(arenas[ai]);return;}if(cmd=="arena_leave"){int ai=arena_index(p.arena_id);if(ai>=0){int mi=arena_member_index(arenas[ai],p.name);if(mi>=0)arenas[ai].members.remove_at(mi);if(arenas[ai].members.length()==0 or arenas[ai].host==p.name)arenas.remove_at(ai);}p.arena_id=0;p.arena_role="none";send_reliable(peer,"arena_ok Left the arena.",0);return;}if(cmd=="arena_status"){int ai=arena_index(p.arena_id);if(ai<0)send_reliable(peer,"arena_error You are not in an arena.",0);else arena_sync_member(arenas[ai],arenas[ai].members[arena_member_index(arenas[ai],p.name)]);}
}
