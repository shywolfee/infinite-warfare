string explosive_audio_prefix(string kind){if(kind=="er_directional_claymore")return "er_claymore";if(kind=="er_proximity_mine")return "er_mine";return kind;}
fraggrenade@[] fraggrenades(0);
class fraggrenade
{
double x;
double y;
double z;
double vx;
double vy;
double vz;
bool landed=false;
int bounces=0;
timer simulationtimer;
string map;
string owner;
timer explodetimer;
string kind="frag_grenade";
int fuse=2200;
int radius=16;
int damage=500;
int audio_id=-1;
timer audio_update_timer;
string stuck_to="";
int blast_dir=-1;
int inside_vehicle=-1; // id of the closed vehicle this explosive is loose inside
fraggrenade(double gx,double gy,int gz,double gdir,string gmap,string gowner,string gkind="frag_grenade",bool play_launch=true,int aim=90,int cooked_ms=0)
{
x=gx;
y=gy;
z=double(gz)+0.8;
double radians=gdir*3.14159265358979323846/180.0;
map=gmap;
owner=gowner;
kind=gkind;
// Fuse, blast and flight come from the explosive's item file.
fuse=item_prop_int(kind,"fuse_ms",fuse);radius=item_prop_int(kind,"blast_radius",radius);damage=item_prop_int(kind,"blast_damage",damage);
// A throw's speed is the item's authored launch speed (an ordinary arm
// throws at about fourteen tiles a second) and its angle follows the
// thrower's vertical aim: aiming level is a normal arcing throw of about
// thirty degrees, aiming up lobs it higher and further, aiming down drops or
// rolls it. Throws used to be one of three fixed presets.
double speed=14.0;if(item_prop(kind,"launch_speed")!=""){double h=item_prop_number(kind,"launch_speed"),v=item_prop_number(kind,"launch_rise",7.25);speed=sqrt(h*h+v*v);}
double elevation=30.0+(double(aim)-90.0)*.75;if(elevation<-20)elevation=-20;if(elevation>80)elevation=80;double er=elevation*3.14159265358979323846/180.0;
vx=sine(radians)*cosine(er)*speed;vy=cosine(radians)*cosine(er)*speed;vz=sine(er)*speed;
if(cooked_ms<0)cooked_ms=0;if(cooked_ms>fuse-1)cooked_ms=fuse-1;fuse-=cooked_ms;
if(play_launch){string launch=item_prop(kind,"throw_sound",kind=="frag_grenade"?"fraggrenadethrow":(kind=="er_bowling_bomb"?"er_bowling_bomb_start":kind+"_throw"));play(launch,x,y,z,map);}
simulationtimer.restart();
}
}
void fraggrenadeloop()
{
for (int i=int(fraggrenades.length())-1; i>=0; i--)
{
// Adhesive charges (sticky=true) stick to the first person or surface they
// touch, and ride along with a person until they go off. The Sticky Semtex
// Charge was described as adhesive but bounced like any other grenade.
bool sticky=item_flag(fraggrenades[i].kind,"sticky");
