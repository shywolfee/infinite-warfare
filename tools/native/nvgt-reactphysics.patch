+// Infinite Warfare modification: construct real derived joint descriptions.
+// The old base JointInfo factory leaves the solver reading past the object.
+bool joint_bodies_valid(PhysicsWorld* world, RigidBody* a, RigidBody* b) {
+	bool found_a = false, found_b = false;
+	for (uint32 i = 0; i < world->getNbRigidBodies(); ++i) {
+		auto* body = world->getRigidBody(i);
+		found_a |= body == a;
+		found_b |= body == b;
+	}
+	if (a != b && found_a && found_b) return true;
+	asGetActiveContext()->SetException("Joint requires two different live bodies in this world");
+	return false;
+}
+Joint* create_fixed_joint(PhysicsWorld* world, RigidBody* a, RigidBody* b, const Vector3& anchor, bool collision) {
+	if (!joint_bodies_valid(world, a, b)) return nullptr;
+	FixedJointInfo info(a, b, anchor); info.isCollisionEnabled = collision;
+	return world->createJoint(info);
+}
+Joint* create_ball_joint(PhysicsWorld* world, RigidBody* a, RigidBody* b, const Vector3& anchor, bool collision) {
+	if (!joint_bodies_valid(world, a, b)) return nullptr;
+	BallAndSocketJointInfo info(a, b, anchor); info.isCollisionEnabled = collision;
+	return world->createJoint(info);
+}
+Joint* create_hinge_joint(PhysicsWorld* world, RigidBody* a, RigidBody* b, const Vector3& anchor, const Vector3& axis, float lower, float upper, bool collision) {
+	if (!joint_bodies_valid(world, a, b)) return nullptr;
+	if (!(axis.lengthSquare() > 0) || !(lower <= 0 && lower >= -6.283185307f && upper >= 0 && upper <= 6.283185307f)) {
+		asGetActiveContext()->SetException("Invalid hinge axis or limits"); return nullptr;
+	}
+	HingeJointInfo info(a, b, anchor, axis.getUnit(), lower, upper); info.isCollisionEnabled = collision;
+	return world->createJoint(info);
+}
+Joint* create_slider_joint(PhysicsWorld* world, RigidBody* a, RigidBody* b, const Vector3& anchor, const Vector3& axis, float lower, float upper, bool collision) {
+	if (!joint_bodies_valid(world, a, b)) return nullptr;
+	if (!(axis.lengthSquare() > 0) || !(lower <= 0 && upper >= 0)) {
+		asGetActiveContext()->SetException("Invalid slider axis or limits"); return nullptr;
+	}
+	SliderJointInfo info(a, b, anchor, axis.getUnit(), lower, upper); info.isCollisionEnabled = collision;
+	return world->createJoint(info);
+}
+Joint* reject_base_joint(PhysicsWorld*, const JointInfo&) {
+	asGetActiveContext()->SetException("Use create_fixed_joint, create_ball_joint, create_hinge_joint or create_slider_joint; base joint descriptions are unsafe");
+	return nullptr;
+}
