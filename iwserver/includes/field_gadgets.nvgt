// Reusable and single-use gadgets a player carries. Each item names its
// behaviour with a "gadget" property, and tunes it with gadget_* properties:
//   gadget=overdrive   amplifies the user's projectiles for a while
//                      (gadget_duration_ms, gadget_damage_mult)
//   gadget=salvage     recovers a component from nearby wreckage, but only
//                      where there is some (gadget_cooldown_ms, gadget_loot)
//   gadget=receiver    reports how many friendly and hostile people are on
//                      the map (gadget_cooldown_ms, gadget_sound)
// Drones and the scout beacon are companions; see companions.nvgt.
dictionary gadget_cooldowns;

bool is_field_gadget(string item){return item_prop(item,"gadget")!="";}

bool gadget_ready(player@ user,string item)
{
int cooldown=item_prop_int(item,"gadget_cooldown_ms",0);if(cooldown<=0)return true;
string key=string_to_lower_case(user.name)+"|"+item;double now=double(uptimer.elapsed),last=-1e12;
gadget_cooldowns.get(key,last);
if(now-last<double(cooldown)){send_reliable(user.peer_id,"It is recalibrating: ready in "+int(ceil((double(cooldown)-(now-last))/1000.0))+" seconds.",2);return false;}
gadget_cooldowns.set(key,now);return true;
}

// The amplifier multiplies the damage of every projectile the player fires
// while it runs.
double overdrive_multiplier(player@ p){return p !is null and p.overdrive_active?p.overdrive_mult:1.0;}
void overdrive_loop(player@ p)
{
if(!p.overdrive_active or p.overdrive_timer.elapsed<p.overdrive_ms)return;
p.overdrive_active=false;send_reliable(p.peer_id,"overdrive_state off",0);world_sound_from("character/affects/quad_damage/powerdown",p);
send_reliable(p.peer_id,"The overdrive amplifier burns out.",2);
}

// Salvage only comes from wreckage: a destroyed or burnt-out object, or a
// wrecked vehicle, within eight tiles.
bool salvage_source_near(player@ user,string &out source)
{
dobject_set@ s=dobjects_on(user.map);
if(s !is null)for(uint i=0;i<s.list.length();i++)
{
dobject@ o=s.list[i];if(o.distance_to(user.x,user.y)>8 or absolute(o.z-user.z)>3)continue;
if(!o.active or o.burning or o.type_id!=o.origin_type or o.type.interaction=="search"){source=o.describe();return true;}
}
return false;
}

bool use_field_gadget(player@ user,string item)
{
string kind=item_prop(item,"gadget");if(kind=="" or user is null)return false;
if(user.death){send_reliable(user.peer_id,"You cannot use that while dead.",2);return true;}
if(kind=="overdrive")
{
if(user.overdrive_active){send_reliable(user.peer_id,"An overdrive amplifier is already running.",2);return true;}
user.overdrive_active=true;user.overdrive_timer.restart();user.overdrive_ms=item_prop_int(item,"gadget_duration_ms",20000);
user.overdrive_mult=item_prop_number(item,"gadget_damage_mult",1.75);
send_reliable(user.peer_id,"give "+item+" -1",0);send_reliable(user.peer_id,"overdrive_state on",0);
world_sound_from("character/affects/quad_damage/powerup",user);
send_reliable(user.peer_id,"Overdrive running: your shots hit "+int(round((user.overdrive_mult-1)*100,0))+" percent harder for "+(user.overdrive_ms/1000)+" seconds.",2);
return true;
}
if(kind=="salvage")
{
string source;
if(!salvage_source_near(user,source)){send_reliable(user.peer_id,"The scanner finds no wreckage within eight tiles. Try near a destroyed object or a searchable crate, dumpster or car.",2);return true;}
if(!gadget_ready(user,item))return true;
string[] loot=item_prop_list(item,"gadget_loot");if(loot.length()==0)loot.insert_last("repair_kit");
string found=loot[random(0,loot.length()-1)];
world_sound_from(random(0,1)==0?"environment/objects/crate/get_item":"environment/objects/wooden_planter/search"+random(1,3),user);
send_reliable(user.peer_id,"give "+found+" 1",0);
send_reliable(user.peer_id,"The scanner guides you through the "+source+" to a usable "+string_replace(found,"_"," ",true)+".",2);
return true;
}
if(kind=="receiver")
{
if(!gadget_ready(user,item))return true;
int hostile=0,friendly=0;
for(uint i=0;i<players.length();i++){if(players[i].death or players[i].map!=user.map or players[i].name==user.name)continue;if(same_team(user.name,players[i].name))friendly++;else hostile++;}
string effect=item_prop(item,"gadget_sound");if(effect!="")world_sound_from(effect,user);
send_reliable(user.peer_id,"The receiver picks up "+friendly+" friendly and "+hostile+" hostile people on this map.",2);
return true;
}
return false;
}
