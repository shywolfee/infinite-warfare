string[] wpn_class_folders = {"pistols", "revolvers", "assault_rifles", "battle_rifles", "sniper_rifles", "submachine_guns", "light_machine_guns", "explosives", "incendiary", "tools", "melee_blunt", "melee_long_blade", "melee_short_blade", "archery", "energy", "shotguns"};

void set_client_ballistics(wpn_stats@ s)
{
s.projectile_kind="bullet";s.muzzle_velocity=85;s.projectile_gravity=9.81;s.projectile_drag=.012;s.projectile_mass=8;s.projectile_diameter=9;s.projectile_dispersion=.45;s.damage_retention=.72;s.projectile_collision_radius=.48;s.projectile_explosive_radius=0;s.pellet_count=1;s.penetration=0;
if(s.wclass=="pistol"){s.muzzle_velocity=72;s.projectile_drag=.018;s.projectile_mass=8;s.projectile_dispersion=.65;}
else if(s.wclass=="revolver"){s.muzzle_velocity=82;s.projectile_drag=.015;s.projectile_mass=11;s.projectile_diameter=10.9;s.projectile_dispersion=.55;s.penetration=1;}
else if(s.wclass=="submachine_gun"){s.muzzle_velocity=76;s.projectile_drag=.02;s.projectile_mass=7.5;s.projectile_dispersion=.9;}
else if(s.wclass=="assault_rifle"){s.muzzle_velocity=112;s.projectile_drag=.009;s.projectile_mass=4.2;s.projectile_diameter=5.56;s.projectile_dispersion=.38;s.penetration=1;}
else if(s.wclass=="battle_rifle"){s.muzzle_velocity=125;s.projectile_drag=.007;s.projectile_mass=9.5;s.projectile_diameter=7.62;s.projectile_dispersion=.28;s.penetration=2;s.damage_retention=.84;}
else if(s.wclass=="sniper_rifle"){s.muzzle_velocity=150;s.projectile_drag=.0045;s.projectile_mass=11.3;s.projectile_diameter=7.62;s.projectile_dispersion=.08;s.penetration=3;s.damage_retention=.92;}
else if(s.wclass=="light_machine_gun"){s.muzzle_velocity=108;s.projectile_drag=.01;s.projectile_mass=8.4;s.projectile_diameter=7.62;s.projectile_dispersion=.75;s.penetration=2;}
else if(s.wclass=="shotgun"){s.projectile_kind="pellet";s.muzzle_velocity=68;s.projectile_drag=.035;s.projectile_mass=3.5;s.projectile_diameter=4.5;s.projectile_dispersion=3.8;s.damage_retention=.42;s.projectile_collision_radius=.38;s.pellet_count=9;}
else if(s.wclass=="archery"){s.projectile_kind="bolt";s.muzzle_velocity=36;s.projectile_drag=.025;s.projectile_mass=24;s.projectile_diameter=7;s.projectile_dispersion=.22;s.penetration=2;s.damage_retention=.8;}
else if(s.wclass=="energy"){s.projectile_kind="laser";s.muzzle_velocity=300;s.projectile_gravity=0;s.projectile_drag=0;s.projectile_mass=0;s.projectile_diameter=1;s.projectile_dispersion=.05;s.penetration=1;s.damage_retention=.96;s.projectile_collision_radius=.34;}
else if(s.wclass=="explosive"){s.projectile_kind="shell";s.muzzle_velocity=28;s.projectile_gravity=12;s.projectile_drag=.018;s.projectile_mass=14000;s.projectile_diameter=120;s.projectile_dispersion=1.2;s.damage_retention=.8;s.projectile_collision_radius=.55;s.projectile_explosive_radius=20;}
else if(s.wclass=="grenade_launcher"){s.projectile_kind="shell";s.muzzle_velocity=34;s.projectile_gravity=11;s.projectile_drag=.025;s.projectile_mass=230;s.projectile_diameter=40;s.projectile_dispersion=.8;s.damage_retention=.72;s.projectile_collision_radius=.5;s.projectile_explosive_radius=8;}
else if(s.wclass=="incendiary"){s.projectile_kind="flame particle";s.muzzle_velocity=18;s.projectile_gravity=-1.4;s.projectile_drag=.18;s.projectile_mass=.3;s.projectile_diameter=15;s.projectile_dispersion=4.5;s.damage_retention=.3;s.projectile_collision_radius=.8;s.pellet_count=5;}
else if(s.wclass=="melee_short_blade"){s.projectile_kind="short melee arc";s.muzzle_velocity=28;s.projectile_gravity=0;s.projectile_drag=0;s.projectile_mass=0;s.projectile_dispersion=4.5;s.damage_retention=1;s.projectile_collision_radius=.65;}
else if(s.wclass=="melee_long_blade"){s.projectile_kind="long melee arc";s.muzzle_velocity=24;s.projectile_gravity=0;s.projectile_drag=0;s.projectile_mass=0;s.projectile_dispersion=7;s.damage_retention=1;s.projectile_collision_radius=.9;s.penetration=1;}
else if(s.wclass=="melee_blunt"){s.projectile_kind="broad blunt arc";s.muzzle_velocity=18;s.projectile_gravity=0;s.projectile_drag=0;s.projectile_mass=0;s.projectile_dispersion=10;s.damage_retention=1;s.projectile_collision_radius=1.05;}
else if(s.wclass=="tool"){s.projectile_kind="powered tool arc";s.muzzle_velocity=22;s.projectile_gravity=0;s.projectile_drag=0;s.projectile_mass=0;s.projectile_dispersion=8;s.damage_retention=1;s.projectile_collision_radius=.95;}
double rf=s.range>0?sqrt(double(s.range)/30.0):1.0;if(rf<.7)rf=.7;if(rf>1.45)rf=1.45;if(s.projectile_kind!="laser" and string_contains(s.projectile_kind,"arc",1)<0)s.muzzle_velocity*=rf;if(s.spread>0)s.projectile_dispersion*=1.0+double(s.spread)*.12;
}

void load_weapon_file(string wpn_dir, string subdir, string fname)
{
string wid=string_left(fname, fname.length()-4);
string full_path=wpn_dir+"/"+fname;
if (subdir!="") full_path=wpn_dir+"/"+subdir+"/"+fname;
file f;
if (!f.open(full_path, "rb")) return;
string content=f.read();
f.close();
if (content=="") return;
content=string_replace(content, "\r\n", "\n", true);
string[] lines=string_split(content, "\n", true);
dictionary props;
for (uint j=0; j<lines.length(); j++)
{
int eq_pos=string_contains(lines[j], "=", 1);
if (eq_pos<0) continue;
string k=string_left(lines[j], eq_pos);
string val=string_replace(lines[j], k+"=", "", false);
props.set(k, val);
}
wpn_stats ws;
ws.id=wid;
string tmp;
if (props.get("name", tmp)) ws.name=tmp;
else ws.name=string_replace(wid, "_", " ", true);
if (props.get("wclass", tmp)) ws.wclass=tmp;
else ws.wclass="";
if (props.get("sound_profile", tmp)) ws.sound_profile=tmp;
else ws.sound_profile=wid;
if (props.get("fire_sound_variants", tmp)) ws.fire_sound_variants=tmp;
else ws.fire_sound_variants="";
if (props.get("firetime", tmp)) ws.firetime=string_to_number(tmp);
else ws.firetime=500;
if (props.get("walktime", tmp)) ws.walktime=string_to_number(tmp);
else ws.walktime=200;
if (props.get("range", tmp)) ws.range=string_to_number(tmp);
else ws.range=0;
if (props.get("min_damage", tmp)) ws.damage=string_to_number(tmp);
else ws.damage=0;
if (props.get("max_damage", tmp)) ws.max_damage=string_to_number(tmp);
else ws.max_damage=ws.damage;
if (props.get("spread", tmp)) ws.spread=string_to_number(tmp);
else ws.spread=0;
set_client_ballistics(ws);
if(props.get("projectile_kind",tmp))ws.projectile_kind=tmp;
if(props.get("muzzle_velocity",tmp))ws.muzzle_velocity=string_to_number(tmp);
if(props.get("gravity",tmp))ws.projectile_gravity=string_to_number(tmp);
if(props.get("drag",tmp))ws.projectile_drag=string_to_number(tmp);
if(props.get("mass_grams",tmp))ws.projectile_mass=string_to_number(tmp);
if(props.get("diameter_mm",tmp))ws.projectile_diameter=string_to_number(tmp);
if(props.get("dispersion_degrees",tmp))ws.projectile_dispersion=string_to_number(tmp);
if(props.get("collision_radius",tmp))ws.projectile_collision_radius=string_to_number(tmp);
if(props.get("pellet_count",tmp))ws.pellet_count=string_to_number(tmp);
if(props.get("penetration",tmp))ws.penetration=string_to_number(tmp);
if(props.get("damage_retention",tmp))ws.damage_retention=string_to_number(tmp);
if(props.get("explosive_radius",tmp))ws.projectile_explosive_radius=string_to_number(tmp);
string melee_str;
if (props.get("melee", melee_str) and melee_str=="true") ws.melee=true;
else ws.melee=false;
wpn_cache.insert_last(ws);
wpn_display_names.set(wid, ws.name);
string ammo_type, feed_device, capacity_str, reserve_item, reserve_label, is_mag_str, starting_reserve_str, reload_ms_str;
if (!ws.melee and props.get("ammo_type", ammo_type) and props.get("feed_device", feed_device) and props.get("capacity", capacity_str) and props.get("reserve_item", reserve_item) and props.get("reserve_label", reserve_label) and props.get("is_magazine", is_mag_str) and props.get("starting_reserve", starting_reserve_str) and props.get("reload_ms", reload_ms_str))
{
int capacity=string_to_number(capacity_str);
bool is_magazine=(is_mag_str=="true");
int starting_reserve=string_to_number(starting_reserve_str);
int reload_ms=string_to_number(reload_ms_str);
register_gun(wid, ammo_type, feed_device, capacity, reserve_item, reserve_label, is_magazine, starting_reserve, reload_ms);
string ammo_display;
if (props.get("ammo_display", ammo_display) and ammo_display!="rounds")
set_ammo_display(wid, ammo_display);
}
// Build fire modes from .wpn file, then add class-based modes
string fire_modes_str;
int[] modes(0);
if (props.get("fire_modes", fire_modes_str))
{
string[] mode_parts=string_split(fire_modes_str, ",", true);
for (uint m=0; m<mode_parts.length(); m++)
{
if (mode_parts[m]=="semi") modes.insert_last(FIREMODE_SEMI);
else if (mode_parts[m]=="burst") modes.insert_last(FIREMODE_BURST);
else if (mode_parts[m]=="auto") modes.insert_last(FIREMODE_AUTO);
else if (mode_parts[m]=="scattershot") modes.insert_last(FIREMODE_SCATTERSHOT);
else if (mode_parts[m]=="focused") modes.insert_last(FIREMODE_FOCUSED);
}
}
// Preserve fixed single modes too: an auto-only weapon must not fall through
// to get_fire_mode's semi-automatic fallback merely because it has no selector.
bool has_auto=false,has_scatter=false,has_focused=false;for(uint mi=0;mi<modes.length();mi++){if(modes[mi]==FIREMODE_AUTO)has_auto=true;else if(modes[mi]==FIREMODE_SCATTERSHOT)has_scatter=true;else if(modes[mi]==FIREMODE_FOCUSED)has_focused=true;}
if((ws.wclass=="light_machine_gun" or ws.wclass=="incendiary") and !has_auto)modes.insert_last(FIREMODE_AUTO);
if (ws.wclass=="shotgun" and !has_scatter) modes.insert_last(FIREMODE_SCATTERSHOT);
if (ws.wclass=="energy" and !has_focused) modes.insert_last(FIREMODE_FOCUSED);
if (modes.length()>0)
register_fire_modes(wid, modes);
}

void load_all_weapons()
{
string wpn_dir="iwserver/content/weapons";
if (!directory_exists(wpn_dir))
wpn_dir="content/weapons";
// Load .wpn files from root (backwards compatibility)
string[] root_files=find_files(wpn_dir+"/*.wpn");
for (uint i=0; i<root_files.length(); i++)
load_weapon_file(wpn_dir, "", root_files[i]);
// Load .wpn files from class subfolders
for (uint d=0; d<wpn_class_folders.length(); d++)
{
string subdir=wpn_class_folders[d];
if (!directory_exists(wpn_dir+"/"+subdir)) continue;
string[] sub_files=find_files(wpn_dir+"/"+subdir+"/*.wpn");
for (uint i=0; i<sub_files.length(); i++)
load_weapon_file(wpn_dir, subdir, sub_files[i]);
}
}

void application_main()
{
@default_nv_form_network_pump=@pump_network_for_form;
@default_nv_form_audio_feedback=@play_nv_form_audio_feedback;
@default_nv_form_ui_cue=@play_ui_cue;
set_sound_global_hrtf(true);

p.behind_pitch_decrease=6;
distpool.pan_step=0.2;
distpool.volume_step=0.1;
weapons.insert_last("empty");
// Weapon stats loaded from .wpn files
load_all_weapons();
// --- Attachment registrations ---
string[] compat_pistol_sup = {"glock17", "beretta92fs_pistol", "desert_eagle", "colt_m1911", "target_pistol_22", "select_fire_machine_pistol", "er_service_pistol"};
register_attachment("pistol_suppressor", "Compact Suppressor", "silenced", "muzzle", true, 1.1, 1.0, compat_pistol_sup);
string[] compat_smg_sup = {"mp5", "uzi", "mp7", "p90_mp", "m1921a1_thompson", "awds_uzi", "m17_viper_uzi", "mlk_tech9", "mpk20"};
register_attachment("smg_suppressor", "Tactical Suppressor", "silenced", "muzzle", true, 1.05, 1.0, compat_smg_sup);
string[] compat_rifle_sup = {"hk_g36", "AK47", "tar_21_assault_rifle", "famas_f1_assault_rifle", "m4a1_carbine", "scar_h_battle_rifle", "fn_fal_battle_rifle", "m16a4", "m8a7", "bullpup_marksman_rifle", "sks_carbine", "mg4_lmg", "mk48_lmg", "ak74m", "er_automatic_rifle", "mlk247_combat_rifle"};
register_attachment("rifle_suppressor", "Rifle Suppressor", "silenced", "muzzle", true, 1.1, 1.0, compat_rifle_sup);
string[] compat_sniper_sup = {"sg08_sniper_rifle", "awp_sniper_rifle", "dragunov_svd", "barrett_mrad", "dragunov_psl", "mosin_1891", "er_tactical_sniper"};
register_attachment("sniper_suppressor", "Precision Suppressor", "silenced", "muzzle", true, 1.15, 1.0, compat_sniper_sup);
register_expanded_combat_attachments();
initialize_ammunition_loads();
// --- Holster registrations ---
string[] h_pistol = {"glock17", "beretta92fs_pistol", "desert_eagle", "colt_m1911", "target_pistol_22", "select_fire_machine_pistol", "er_service_pistol"};
register_holster("pistol_holster", "Pistol Holster", h_pistol, false, 0, "");
string[] h_357 = {"taurus_model66_revolver"};
register_holster("gun_belt_357", ".357 Gun Belt", h_357, true, 24, ".357_magnum_ammo_belt");
string[] h_44 = {"magnum_revolver"};
register_holster("gun_belt_44", ".44 Gun Belt", h_44, true, 24, ".44_magnum_ammo_belt");
string[] h_smg = {"mp5", "uzi", "mp7", "p90_mp", "m1921a1_thompson", "awds_uzi", "m17_viper_uzi", "mlk_tech9", "mpk20"};
register_holster("smg_sling", "SMG Sling", h_smg, false, 0, "");
string[] h_rifle = {"hk_g36", "AK47", "tar_21_assault_rifle", "famas_f1_assault_rifle", "m4a1_carbine", "scar_h_battle_rifle", "fn_fal_battle_rifle", "m16a4", "m8a7", "bullpup_marksman_rifle", "sks_carbine", "mg4_lmg", "mk48_lmg", "dingo_lmg", "gorgon_lmg", "m2_browning", "ak74m", "er_automatic_rifle", "mlk247_combat_rifle", "m60_gpmg", "er_machine_gun"};
register_holster("rifle_strap", "Rifle Strap", h_rifle, false, 0, "");
string[] h_sniper = {"sg08_sniper_rifle", "awp_sniper_rifle", "dragunov_svd", "barrett_mrad", "dragunov_psl", "mosin_1891", "er_tactical_sniper"};
register_holster("sniper_carry_case", "Sniper Carry Case", h_sniper, false, 0, "");
string[] h_shotgun = {"benelli_m4_shotgun", "spas_12_shotgun", "mossberg_500", "double_barrel_shotgun", "mlk870_maverick", "sgx12", "sgx13", "er_pump_shotgun"};
register_holster("shotgun_bandoleer", "Shotgun Bandoleer", h_shotgun, true, 16, "12_gauge_shell_box");
string[] h_knife = {"combatknife", "tiger_claw_knife", "piranha_blade", "barracuda_blade", "glass_bottle"};
register_holster("knife_sheath", "Knife Sheath", h_knife, false, 0, "");
string[] h_sword = {"machete", "katana", "longsword", "combat_spear", "sword_thrower", "flaming_axe"};
register_holster("sword_scabbard", "Sword Scabbard", h_sword, false, 0, "");
string[] h_bat = {"baseball_bat", "metal_pole", "pool_cue", "stun_baton", "war_hammer"};
register_holster("bat_holster", "Bat Holster", h_bat, false, 0, "");
init_vehicle_types();
initialize_content_database();
// Starting loadout is given per-spawn in game() via give_starting_loadout().
create_buffer("all");
create_buffer("chats");
create_buffer("misc");
create_buffer("tickets");
bool is_first_run=false;
if (!directory_exists(prefsdir))
{
directory_create(prefsdir);
is_first_run=true;
}
else if (!file_exists(prefsdir+"/settings.dat"))
is_first_run=true;
accounts_dir="iwserver/accounts";
if (!directory_exists(accounts_dir))
directory_create(accounts_dir);
readprefs();
if(touch_pc_fullscreen_bands and !system_is_mobile){touch_force_enabled=true;fullscreen_enabled=true;}
kb_init();
init_gesture_bindings();
init_server_list();
kb_update_holds();
if (!file_exists("sounds.dat"))
{
if(!SCRIPT_COMPILED and directory_exists("sounds") and file_exists("pack_creator.nvgt"))
{
int build_answer=question("Missing sound archive","sounds.dat is missing, but the sounds source folder is available. Do you want to run pack_creator.nvgt, verify the archive, and restart the game?");
if(build_answer==1 and source_build_sound_pack())
{
alert("Sound archive complete","sounds.dat was created successfully. Infinite Warfare will now restart from source.");string[] restart_args={SCRIPT_EXECUTABLE,SCRIPT_MAIN_PATH+"/Infinite Warfare.nvgt"};run(restart_args,PROCESS_BACKGROUND,SCRIPT_MAIN_PATH);exit();
}
if(build_answer==1)alert("Sound archive unavailable","The sound pack was not created. Review the pack creator output and try again.");
else alert("Sound archive required","Infinite Warfare cannot start without sounds.dat.");
}
else alert("Missing sound archive", "Infinite Warfare cannot find sounds.dat. Reinstall or extract the complete game into one folder; the executable cannot play audio without this file.");
exit();
}
// NVGT 0.90 opens pack_file archives immediately. The decryption key must be
// supplied in this call; set_sound_decryption_key afterward does not reopen it.
if (!set_sound_storage("sounds.dat", sound_pack_key, true))
{
alert("Invalid sound archive", "Infinite Warfare could not open sounds.dat with NVGT 0.90. Rebuild the archive with pack_creator.exe or reinstall the complete game.");
exit();
}
fire_archive_index.open("sounds.dat",sound_pack_key);
@p.mixer=@gameplay_mixer;
@spool.mixer=@interface_mixer;
@bufferpool.mixer=@notification_mixer;
@distpool.mixer=@world_mixer;
@ambpool.mixer=@world_mixer;
gameplay_mixer.volume=gameplay_volume;
interface_mixer.volume=interface_volume;
notification_mixer.volume=notification_volume;
world_mixer.volume=world_volume;
voice_apply_devices();
if(file_exists("net.txt"))
{
netaddress="localhost";
}
game_window@ startup_window=show_window(game_window_title(),fullscreen_enabled?WINDOW_FLAG_FULLSCREEN:0);
if(@startup_window==null)show_game_window(game_window_title());
if (screen_reader_is_running(1))
install_keyhook();
//cfu("iw","iw.zip",true);
if (!sd.d.exists("first_run_done"))
{
first_run_welcome();
first_boot_setup_wizard();
}
if(fullscreen_enabled)set_fullscreen_mode(true,false);
initialize_nvgt_helpers();
dlgplay("logo.ogg", true, false, 15);
mainmenu();
}
void write_client_exception_log()
{
string folder=DIRECTORY_LOCAL_APPDATA+"/iw/crash_logs";directory_create(folder);string path=folder+"/client_exception_"+ticks()+".log";string report="Infinite Warfare client exception\nVersion: "+version_name+", build "+build_number+" ("+build_date+")\nCompiled: "+SCRIPT_COMPILED+"\nExecutable: "+SCRIPT_EXECUTABLE+"\nMain path: "+SCRIPT_MAIN_PATH+"\nException: "+get_exception_info()+"\nFunction: "+get_exception_function()+"\nFile: "+get_exception_file()+"\nLine: "+get_exception_line()+"\nLast engine error: "+get_last_error()+"\nCall stack:\n"+last_exception_call_stack+"\n";file_put_contents(path,report,false);alert("Infinite Warfare crashed","A diagnostic log was saved to "+path+". Please share that file with the developers.\n\n"+get_exception_info());
}
void write_recoverable_network_error(string context,string detail)
{
string folder=DIRECTORY_LOCAL_APPDATA+"/iw/crash_logs";directory_create(folder);file_put_contents(folder+"/client_network_errors.log","At "+ticks()+" ms, "+context+": "+detail+"\n",true);
}
void safe_server_ammo_grant(string weapon,string amount_text)
{
if(weapon=="" or weapon.length()>80 or string_contains(weapon,"/",1)>=0 or string_contains(weapon,"\\",1)>=0){write_recoverable_network_error("ammunition grant","rejected invalid weapon identifier "+weapon);return;}int amount=string_to_number(amount_text);if(amount<-100000 or amount>100000){write_recoverable_network_error("ammunition grant","rejected out-of-range quantity "+amount_text+" for "+weapon);return;}if(find_gun(weapon)<0){write_recoverable_network_error("ammunition grant","ignored unknown weapon "+weapon+" quantity "+amount);return;}try{ammo_give(weapon,amount);}catch{write_recoverable_network_error("ammunition grant",get_exception_info()+" in "+get_exception_function()+" at "+get_exception_file()+":"+get_exception_line()+"\n"+last_exception_call_stack);speak("An invalid ammunition update was rejected and logged.");}
}
void safe_server_item_grant(string item,string amount_text)
{
if(item=="" or item.length()>100 or string_contains(item,"/",1)>=0 or string_contains(item,"\\",1)>=0){write_recoverable_network_error("inventory grant","rejected invalid item identifier "+item);return;}int amount=string_to_number(amount_text);if(amount<-100000 or amount>100000){write_recoverable_network_error("inventory grant","rejected out-of-range quantity "+amount_text+" for "+item);return;}try{give(item,amount);}catch{write_recoverable_network_error("inventory grant",get_exception_info()+" in "+get_exception_function()+" at "+get_exception_file()+":"+get_exception_line()+"\n"+last_exception_call_stack);speak("An invalid inventory update was rejected and logged.");}
}
void main()
{
#if IW_CLIENT_REGRESSION
run_client_regression();
return;
#endif
string session_folder=DIRECTORY_LOCAL_APPDATA+"/iw/crash_logs";directory_create(session_folder);file_put_contents(session_folder+"/latest_client_session.log","Infinite Warfare session started. Version "+version_name+", build "+build_number+". Compiled: "+SCRIPT_COMPILED+". Executable: "+SCRIPT_EXECUTABLE+". Main path: "+SCRIPT_MAIN_PATH+".\nThis breadcrumb remains available if a native library or operating-system crash bypasses AngelScript exception handling.\n",false);
// Looping ambience beds are what make a map sound like a place, and a map can
// carry twenty of them. Without an earshot limit the pool keeps every one of
// them decoding for the whole match, whether you are standing in it or four
// hundred metres away, and a hundred slots do not go far. Both pools now drop
// what is out of earshot and reload it when you come back; a ranged source
// measures from the edge of its own rectangle, so standing inside a large one
// is always distance nought.
p.max_distance=260;
distpool.max_distance=1600;
ambpool.max_distance=140;
try{application_main();}catch{write_client_exception_log();}
}
// ---------------------------------------------------------------------------
// First-run welcome — shown the very first time the game is launched.
// Displays the preliminary notice, then shows the rules and requires
// agreement before proceeding.
// ---------------------------------------------------------------------------
void first_run_welcome()
{
string notice_text = "Notice: The present iteration of Infinite Warfare is developed agentically by Equinox_Equine using GPT-5.6 Sol, Claude 4.8 Opus, and Claude 5 Opus. It was forked from a leaked copy of Infinite Warfair 0.14, originally produced by Firegaming with Max Vrenken as developer and Djonan Smid as sound designer; these are historical credits, not the current development team. The game also incorporates source code originating in Redspot: Blood and Peril by Sam Tupy, who is credited for his original ideas. This game is in an extensive alpha stage. Many features lack sounds or are effectively unfinished. The current server is a test build designed to stress test new features and mechanics. Your data and progress will not persist upon final release of the game. I provide no guarantees of constant server uptime or stability. The game can and will be taken down for maintenance with little or no notice. There are guaranteed bugs and glitches. The goal of this test period is to iron them out. If you wish to play the game despite this, please check the following box to certify that you have read and understood this notice.";
// Load and show rules.
file rf;
string rules_text = "";
if (rf.open("rules.txt", "rb"))
{
rules_text = rf.read();
rf.close();
}
else
rules_text = "Rules file not found. Please check the game folder.";
nv_form f;f.create_window("Infinite Warfare agreements",false,true);
nv_form_input@ rules=f.add_input("Rules, read only","rules",rules_text,"",0,true,true);
nv_form_checkbox@ agree_rules=f.add_checkbox("I have read and agree to the rules","agree_rules",false);
nv_form_input@ notice=f.add_input("Beta and preliminary notice, read only","notice",notice_text,"",0,true,true);
nv_form_checkbox@ agree_notice=f.add_checkbox("I have read and understand the beta and preliminary notice","agree_notice",false);
nv_form_button@ continue_button=f.add_button("Continue","continue",true);
f.focus_control(rules);
while(true)
{
wait(5);
f.monitor();
if (f.is_pressed(continue_button))
{
if (!agree_rules.state or !agree_notice.state)
{
speak("Both agreements must be checked before continuing.");
continue;
}
break;
}
}
// Mark first run as done.
sd.add("first_run_done", 1);
sd.save();
}
string packet_safe_preview(string value)
{
value=string_replace(value,"\r"," ",true);value=string_replace(value,"\n"," ",true);value=string_replace(value,"\t"," ",true);if(value.length()>120)value=string_left(value,120)+"...";return value;
}
void record_diagnostic_packet(string direction,string transport,int peer,int channel,string payload)
{
// Channel 19 contains internal connection-health traffic.  It is intentionally
// excluded even from developer packet previews so transport details cannot
// leak into ordinary lobby output or drown useful diagnostics.
if(channel==19)return;
if(!(SCRIPT_COMPILED==false or dev_unlocked) or (!packet_monitor_enabled and !packet_viewer_active))return;diagnostic_packet@ r=diagnostic_packet();r.sequence=++packet_sequence;r.direction=direction;r.transport=transport;r.peer=peer;r.channel=channel;r.size=payload.length();r.elapsed_ms=packet_session_clock.elapsed;r.payload=channel==7?"Opus voice payload":packet_safe_preview(payload);r.endpoint=direction=="sent"?name+" to server peer "+peer:"server peer "+peer+" to "+name;r.summary="#"+r.sequence+" "+direction+" "+transport+", "+r.endpoint+", channel "+channel+", "+r.size+" bytes: "+r.payload;diagnostic_packets.insert_last(r);if(diagnostic_packets.length()>500)diagnostic_packets.remove_at(0);if(packet_monitor_enabled)speak(r.summary);
}
int available_fire_sound_count(string weapon,string mode)
{
for(uint wi=0;wi<wpn_cache.length();wi++)if(wpn_cache[wi].id==weapon){weapon=wpn_cache[wi].sound_profile;break;}
if(mode=="normal" and string_contains(weapon,"laser_",1)==0)return 1;
string base=weapon+(mode=="scattershot" or mode=="focused"?mode:"")+"fire";int count=0;double cached=0;if(fire_sound_count_cache.get(base,cached))return int(cached);
for(int i=1;i<=20;i++){if(fire_archive_index.file_exists(base+i+".ogg") or fire_archive_index.file_exists(base+i+".flac"))count=i;else if(i>count+2)break;}
fire_sound_count_cache.set(base,double(count>0?count:1));
return count>0?count:1;
}
int choose_fire_sound_index(string weapon,string mode)
{
if(mode=="normal")for(uint wi=0;wi<wpn_cache.length();wi++)if(wpn_cache[wi].id==weapon and wpn_cache[wi].fire_sound_variants!="")
{
string[] variants=string_split(wpn_cache[wi].fire_sound_variants,",",true);
int[] valid;
for(uint vi=0;vi<variants.length();vi++){int number=string_to_number(variants[vi].trim_whitespace());if(number>0)valid.insert_last(number);}
if(valid.length()>0)return valid[random(0,int(valid.length())-1)];
}
return random(1,available_fire_sound_count(weapon,mode));
}
void remember_pm_sender(string message)
{
if(string_contains(string_to_lower_case(message),"pm from ",1)!=0)return;int colon=string_contains(message,":",1);if(colon<8)return;string sender=string_mid(message,8,colon-8).trim_whitespace();for(int i=int(recent_pm_senders.length())-1;i>=0;i--)if(string_to_lower_case(recent_pm_senders[i])==string_to_lower_case(sender))recent_pm_senders.remove_at(i);recent_pm_senders.insert_at(0,sender);if(recent_pm_senders.length()>30)recent_pm_senders.remove_last();
}
void recent_pm_form()
{
if(recent_pm_senders.length()==0){speak("Nobody has sent you a private message this session.");return;}nv_form f;f.create_window("Recent private message senders",false,true);nv_form_list_box@ people=f.add_list("People who most recently sent you a private message","people");for(uint i=0;i<recent_pm_senders.length();i++)people.add(recent_pm_senders[i],recent_pm_senders[i]);nv_form_input@ message=f.add_input("Private message. Tab here after selecting a player","message");nv_form_button@ send=f.add_button("Send private message","send",true);nv_form_button@ cancel=f.add_button("Cancel","cancel",false,true);f.focus_control(people);while(true){wait(5);f.monitor();if(connected)netloop();if(f.is_pressed(cancel))return;if(f.is_pressed(send)){int pos=people.list_position;if(pos<0 or pos>=int(recent_pm_senders.length())){speak("Select a player first.");continue;}string body=message.text.trim_whitespace();if(body==""){speak("Enter a message first.");continue;}send_reliable(0,"/pm "+recent_pm_senders[pos]+" "+body,1);return;}}
}
void chat_channel_shortcuts()
{
if(kb_action_pressed("recent_private_messages")){recent_pm_form();return;}if(kb_action_pressed("group_menu")){groups_menu();return;}if(kb_action_pressed("group_chat")){group_chat_key();return;}if(kb_action_pressed("team_chat")){string text=af_input("Team chat","",true).trim_whitespace();if(text!="")send_team_command("chat "+text);return;}if(kb_action_pressed("map_chat")){if(mapname=="main"){speak("Map chat is available after entering a game mode.");return;}string text=af_input("Current map chat","",true).trim_whitespace();if(text!="")send_reliable(0,text,6);}
}
void packet_diagnostics_viewer()
{
if(!(SCRIPT_COMPILED==false or dev_unlocked)){speak("Developer access is required.");return;}packet_viewer_active=true;nv_form f;f.create_window("Live Packet Diagnostics",false,true);nv_form_list_box@ list=f.add_list("Packets, newest entries appear automatically","packets");nv_form_input@ details=f.add_input("Selected packet details","details","","",0,true,true);nv_form_button@ close=f.add_button("Close","close",true,true);f.focus_control(list);uint64 last_sequence=0;int last_position=-1;
while(true){wait(5);f.monitor();if(connected)netloop();uint64 newest=diagnostic_packets.length()>0?diagnostic_packets[diagnostic_packets.length()-1].sequence:0;if(newest!=last_sequence){int preserve=list.list_position;list.list_position=-1;list.items.resize(0);for(uint i=0;i<diagnostic_packets.length();i++)list.add(diagnostic_packets[i].summary,""+diagnostic_packets[i].sequence);if(list.items.length()>0){if(preserve<0)preserve=int(list.items.length())-1;if(preserve>=int(list.items.length()))preserve=int(list.items.length())-1;list.set_pos(preserve,false);}last_sequence=newest;last_position=-1;}if(list.list_position!=last_position and list.list_position>=0 and list.list_position<int(diagnostic_packets.length())){last_position=list.list_position;diagnostic_packet@ r=diagnostic_packets[last_position];details.default_text="Sequence "+r.sequence+"\nDirection: "+r.direction+"\nTransport: "+r.transport+"\nPeer: "+r.peer+"\nChannel: "+r.channel+"\nSize: "+r.size+" bytes\nSession time: "+r.elapsed_ms+" milliseconds\nPayload preview: "+r.payload;}if(f.is_pressed(close)){packet_viewer_active=false;return;}}
}
// ---------------------------------------------------------------------------
// Developer Suite (Shift+D) — only available in dev builds.
// ---------------------------------------------------------------------------
void dev_suite()
{
iw_form f;
f.create_window("Developer Suite", false, true);
int f_giveall=f.create_button("Give &all items");
int f_giveitem=f.create_button("Give item from &database");
int f_spawnveh=f.create_button("&Spawn vehicle");
int f_close=f.create_button("&Close", false, true);
f.focus(f_giveall);
while(true)
{
wait(5);
f.monitor();
if (connected==true)
netloop();
if (f.is_pressed(f_giveall))
{
give_all();
}
else if (f.is_pressed(f_spawnveh))
{
dev_spawn_vehicle();
}
else if(f.is_pressed(f_giveitem)) dev_database_give();
else if (f.is_pressed(f_close))
{
break;
}
}
}

// Developer item grant: one screen that follows what you do. Type in the
// search box and the list narrows as you type; pick a category and it
// narrows to that; move through the items and the details, the quantity and
// the Give button all change to match the one you are on. It used to be a
// category screen, then an item screen, then a separate quantity prompt,
// and back to the start for every item.
void dev_database_give()
{
refresh_content_database();
string[] categories={"All categories"};
for(uint i=0;i<content_database.length();i++)
{
string c=content_database[i].category;
if(c=="Vehicles" or categories.find(c)>=0)continue;
categories.insert_last(c);
}
nv_form f;
f.create_window("Give items",false,true);
nv_form_input@ search=f.add_input("Search by name","search");
nv_form_list_box@ category_list=f.add_list("Category","category");
for(uint i=0;i<categories.length();i++)category_list.add(categories[i],categories[i]);
category_list.set_pos(0,false);
nv_form_list_box@ items=f.add_list("Items","items");
nv_form_input@ about=f.add_input("About the selected item","about","","",0,true,true);
nv_form_spin@ quantity=f.add_spin("Quantity","quantity","1",1,10000,false,1,10);
nv_form_button@ give_button=f.add_button("Give","give",true);
nv_form_button@ close=f.add_button("Close","close",false,true);
f.focus_control(search);
string last_search="\x01",last_category="\x01",last_item="\x01";
while(true)
{
wait(5);
f.monitor();
if(f.is_pressed(close))return;
string category=category_list.focused_item_id;
string wanted=search.text.trim_whitespace().lower();
// Rebuild the item list when the filter changes, keeping the selection
// when the item is still in it.
if(wanted!=last_search or category!=last_category)
{
last_search=wanted;last_category=category;
string keep=items.focused_item_id;
items.list_position=-1;items.items.resize(0);
for(uint i=0;i<content_database.length();i++)
{
content_record@ r=content_database[i];
if(r.category=="Vehicles")continue;
if(category!="All categories" and r.category!=category)continue;
if(wanted!="" and r.display_name.lower().find(wanted)<0 and r.id.find(wanted)<0)continue;
items.add(r.display_name+(category=="All categories"?", "+r.category:""),r.id);
}
if(items.items.length()==0)items.add("Nothing matches"+(wanted==""?"":" \""+wanted+"\""),"");
int keep_at=0;
for(uint i=0;i<items.items.length();i++)if(items.items[i].id==keep){keep_at=i;break;}
items.set_pos(keep_at,false);
last_item="\x01";
}
string id=items.focused_item_id;
if(id!=last_item)
{
last_item=id;
if(id=="")
{
about.default_text="";give_button.caption="Give";
}
else
{
int ci=content_find(id);
string[] lines;
if(ci>=0)lines.insert_last(content_database[ci].summary);
string[] stats=item_stats_lines(id);
for(uint s=0;s<stats.length();s++)lines.insert_last(stats[s]);
int held=get_item_count(id);
lines.insert_last(held>0?"You have "+held+".":"You have none.");
if(id=="er_small_credit_chip" or id=="er_large_credit_chip")lines.insert_last("Credit chips are granted by the server and need administrator or developer permission.");
about.default_text=join(lines," ");
item_data@ d=item_info(id);
int amount=(d is null or d.give_amount<1)?1:d.give_amount;
quantity.text=""+amount;
}
}
if(id!="")
{
int count=int(quantity.output);
int ci=content_find(id);
string name=ci>=0?content_database[ci].display_name:string_replace(id,"_"," ",true);
string caption="Give "+count+" "+name;
if(give_button.caption!=caption)give_button.caption=caption;
}
if(f.is_pressed(give_button))
{
if(id==""){speak("Choose an item first.");continue;}
int count=int(quantity.output);
if(count<1)count=1;
give_developer_item(id,count);
if(id!="er_small_credit_chip" and id!="er_large_credit_chip")
{
int ci=content_find(id);
speak("Gave "+count+" "+(ci>=0?content_database[ci].display_name:id)+". You now have "+get_item_count(id)+".");
}
last_item="\x01";
}
}
}


void dev_teleport_to_poi()
{
if(!(SCRIPT_COMPILED==false or dev_unlocked)){speak("Developer access is required.");return;}
if(pois.length()==0){speak("No points of interest exist on this map.");return;}
int[] sorted=get_sorted_poi_indices();iw_form f;f.create_window("Developer POI Teleport",false,true);int list=f.create_list("Point of interest",0,false);for(uint i=0;i<sorted.length();i++)f.add_list_item(list,string_replace(pois[sorted[i]].name,"_"," ",true));int go=f.create_button("Teleport",true),cancel=f.create_button("Cancel",false,true);f.focus(list);
while(true){wait(5);f.monitor();if(connected)netloop();if(f.is_pressed(cancel))return;if(f.is_pressed(go)){int pos=f.get_list_position(list);if(pos<0 or pos>=int(sorted.length()))return;int pi=sorted[pos];me.x=pois[pi].x;me.y=pois[pi].y;me.z=pois[pi].z;mr.x=round(me.x,0);mr.y=round(me.y,0);send_reliable(1,"move_to "+mr.x+" "+mr.y+" "+me.z,0);speak("Teleported to "+string_replace(pois[pi].name,"_"," ",true)+".");return;}}
}
void dev_spawn_vehicle()
{
if (vehicle_types.length() == 0) init_vehicle_types();
iw_form f;
f.create_window("Spawn Vehicle", false, true);
int f_list = f.create_list("Select a vehicle type", 0, false);
for (uint i = 0; i < vehicle_types.length(); i++)
{
f.add_list_item(f_list, vehicle_types[i].name);
}
int f_spawn = f.create_button("S&pawn", true);
int f_cancel = f.create_button("&Cancel", false, true);
f.focus(f_list);
while(true)
{
wait(5);
f.monitor();
if (connected==true)
netloop();
if (f.is_pressed(f_spawn))
{
int sel = f.get_list_position(f_list);
if (sel >= 0 and sel < int(vehicle_types.length()))
{
double rad = facing * 3.1415926535897932 / 180.0;
int vx = int(round(mr.x + sine(rad) * 2, 0));
int vy = int(round(mr.y + cosine(rad) * 2, 0));
int vz = int(me.z);
map_vehicles.insert_last(vehicle(sel, vx, vy, vz));
speak(vehicle_types[sel].name + " spawned.");
}
break;
}
else if (f.is_pressed(f_cancel))
{
break;
}
}
}

// ---------------------------------------------------------------------------
// Builder menu (Alt+Shift+P) — dev only. Edits map files on the server.
// ---------------------------------------------------------------------------
string[] builder_tile_types = {"shallow", "sand", "dirt", "forest", "snow", "concrete2", "concrete3", "concrete5", "concrete10", "concrete12", "hardwood", "hardwood2", "carpet1", "tile1", "tile2", "grass", "grass2", "grass3", "gravel1", "rocks1", "stone", "cement", "metal2", "metal4", "metal5", "tunnel", "bridge", "plank", "ladder1", "blank", "water", "water1", "wallbrick", "wallstone", "wallwood", "wallmetal", "wallfence", "wallrock", "glass", "tree"};
bool builder_map_response_received=false;
string builder_map_response_id="";
string builder_map_response_data="";
string builder_map_response_error="";

void receive_builder_map_response(string message)
{
builder_map_response_received=true;
builder_map_response_error="";
builder_map_response_id="";
builder_map_response_data="";
if(string_contains(message,"builder_error ",1)==0)
{
builder_map_response_error=string_replace(message,"builder_error ","",false);
return;
}
string payload=string_replace(message,"builder_data ","",false);
int separator=string_contains(payload," ",1);
if(separator<1){builder_map_response_error="The server returned malformed map data.";return;}
builder_map_response_id=string_left(payload,separator);
builder_map_response_data=string_mid(payload,separator+1,payload.length()-separator-1);
}

bool builder_fetch_map_data(string &out map_id,string &out map_data)
{
builder_map_response_received=false;builder_map_response_id="";builder_map_response_data="";builder_map_response_error="";
send_reliable(0, "builder_read_current", 0);
timer ct;
while(connected and !builder_map_response_received and ct.elapsed<5000)
{
wait(5);
netloop(false);
}
if(!builder_map_response_received){speak("The map builder request timed out.");return false;}
if(builder_map_response_error!=""){speak(builder_map_response_error);return false;}
map_id=builder_map_response_id;map_data=builder_map_response_data;return map_id!="";
}

bool builder_valid_integer(string value)
{
value=value.trim_whitespace();if(value=="")return false;uint start=0;if(string_left(value,1)=="-"){if(value.length()==1)return false;start=1;}
for(uint i=start;i<value.length();i++){string ch=string_mid(value,i,1);if(ch<"0" or ch>"9")return false;}return true;
}

bool builder_validate_coordinates(string value,bool ranged)
{
string[] fields=string_split(value,":",false);int required=ranged?6:3;if(int(fields.length())!=required)return false;
for(int i=0;i<required;i++)if(!builder_valid_integer(fields[i]))return false;
if(ranged and (string_to_number(fields[0])>string_to_number(fields[1]) or string_to_number(fields[2])>string_to_number(fields[3]) or string_to_number(fields[4])>string_to_number(fields[5])))return false;
return true;
}

bool builder_valid_text_field(string value)
{
return value.trim_whitespace()!="" and string_contains(value,":",1)<0 and string_contains(value,"\r",1)<0 and string_contains(value,"\n",1)<0;
}

string builder_coord_form(string title, bool need_range, bool need_extra, string extra_label)
{
iw_form f;
f.create_window(title, false, true);
string result="";
if(need_range)
{
f.create_input_box("Min X");
f.create_input_box("Max X");
f.create_input_box("Min Y");
f.create_input_box("Max Y");
f.create_input_box("Min Z");
f.create_input_box("Max Z");
}
else
{
f.create_input_box("X");
f.create_input_box("Y");
f.create_input_box("Z");
}
int extra_ctrl=-1;
if(need_extra)
extra_ctrl=f.create_input_box(extra_label);
int ok_btn=f.create_button("OK", true);
int cancel_btn=f.create_button("Cancel", false, true);
f.focus(0);
while(true)
{
wait(5);
f.monitor();
if(f.is_pressed(cancel_btn)) return "";
if(f.is_pressed(ok_btn))
{
if(need_range)
{
result=f.get_text(0).trim_whitespace()+":"+f.get_text(1).trim_whitespace()+":"+f.get_text(2).trim_whitespace()+":"+f.get_text(3).trim_whitespace()+":"+f.get_text(4).trim_whitespace()+":"+f.get_text(5).trim_whitespace();
if(need_extra) result+=":"+f.get_text(6);
}
else
{
result=f.get_text(0).trim_whitespace()+":"+f.get_text(1).trim_whitespace()+":"+f.get_text(2).trim_whitespace();
if(need_extra) result+=":"+f.get_text(3);
}
if(!builder_validate_coordinates(result,need_range)){speak(need_range?"Every coordinate must be a whole number and each minimum must not exceed its maximum.":"Every coordinate must be a whole number.");continue;}
return result;
}
}
return "";
}

string builder_pick_tile()
{
iw_form f;
f.create_window("Select Tile Type", false, true);
int f_list=f.create_list("Tile types", 0, false);
for(uint i=0; i<builder_tile_types.length(); i++)
f.add_list_item(f_list, builder_tile_types[i]);
int preview_btn=f.create_button("&Preview sound");
int ok_btn=f.create_button("OK", true);
int cancel_btn=f.create_button("Cancel", false, true);
f.focus(f_list);
while(true)
{
wait(5);
f.monitor();
if(f.is_pressed(cancel_btn)) return "";
if(f.is_pressed(preview_btn))
{
int sel=f.get_list_position(f_list);
if(sel>=0 and sel<int(builder_tile_types.length()))
{
string sfile=builder_tile_types[sel]+"step1.ogg";
p.play_stationary(sfile, false);
}
}
if(f.is_pressed(ok_btn))
{
int sel=f.get_list_position(f_list);
if(sel>=0 and sel<int(builder_tile_types.length()))
return builder_tile_types[sel];
}
}
return "";
}

void builder_add_element()
{
iw_form f;
f.create_window("Add Map Element", false, true);
int f_list=f.create_list("Element type", 0, false);
f.add_list_item(f_list, "Tile");
f.add_list_item(f_list, "Zone");
f.add_list_item(f_list, "Ambient Sound Source");
f.add_list_item(f_list, "Point of Interest");
f.add_list_item(f_list, "Item Spawn");
f.add_list_item(f_list, "Bunker");
f.add_list_item(f_list, "Map Max X");
f.add_list_item(f_list, "Map Max Y");
f.add_list_item(f_list, "Map Max Z");
int ok_btn=f.create_button("OK", true);
int cancel_btn=f.create_button("Cancel", false, true);
f.focus(f_list);
while(true)
{
wait(5);
f.monitor();
if(f.is_pressed(cancel_btn)) return;
if(f.is_pressed(ok_btn))
{
int sel=f.get_list_position(f_list);
string line="";
if(sel==0)
{
string coords=builder_coord_form("Tile Coordinates", true, false, "");
if(coords=="") return;
string tile=builder_pick_tile();
if(tile=="") return;
line="tile:"+coords+":"+tile;
}
else if(sel==1)
{
string coords=builder_coord_form("Zone Coordinates", true, false, "");
if(coords=="") return;
iw_form zf;
zf.create_window("Zone Name", false, true);
zf.create_input_box("Zone name");
int zok=zf.create_button("OK", true);
int zcancel=zf.create_button("Cancel", false, true);
zf.focus(0);
string zname="";
while(true)
{
wait(5);
zf.monitor();
if(zf.is_pressed(zcancel)) return;
if(zf.is_pressed(zok)){zname=zf.get_text(0);break;}
}
zname=zname.trim_whitespace();if(!builder_valid_text_field(zname)){speak("Zone names cannot be empty or contain colons or line breaks.");return;}
line="zone:"+coords+":"+zname;
}
else if(sel==2)
{
string coords=builder_coord_form("Source Coordinates", true, false, "");
if(coords=="") return;
iw_form sf;
sf.create_window("Sound Source", false, true);
sf.create_input_box("Sound file (e.g. ocean1.ogg)");
sf.create_input_box("Volume in dB (e.g. -8)");
int sok=sf.create_button("OK", true);
int scancel=sf.create_button("Cancel", false, true);
sf.focus(0);
string sfile="";
string svol="";
while(true)
{
wait(5);
sf.monitor();
if(sf.is_pressed(scancel)) return;
if(sf.is_pressed(sok)){sfile=sf.get_text(0);svol=sf.get_text(1);break;}
}
if(!builder_valid_text_field(sfile) or !builder_valid_integer(svol)){speak("Enter a sound filename without colons and a whole-number decibel volume.");return;}
line="src:"+coords+":"+sfile+":"+svol;
}
else if(sel==3)
{
string coords=builder_coord_form("POI Coordinates", false, false, "");
if(coords=="") return;
iw_form pf;
pf.create_window("Point of Interest", false, true);
pf.create_input_box("POI name");
int pok=pf.create_button("OK", true);
int pcancel=pf.create_button("Cancel", false, true);
pf.focus(0);
string pname="";
while(true)
{
wait(5);
pf.monitor();
if(pf.is_pressed(pcancel)) return;
if(pf.is_pressed(pok)){pname=pf.get_text(0);break;}
}
pname=pname.trim_whitespace();if(!builder_valid_text_field(pname)){speak("Point-of-interest names cannot be empty or contain colons or line breaks.");return;}
line="poi:"+coords+":"+pname;
}
else if(sel==4)
{
string coords=builder_coord_form("Item Spawn Coordinates", true, false, "");
if(coords=="") return;
iw_form isf;
isf.create_window("Item Spawn", false, true);
isf.create_input_box("Respawn time (ms)");
isf.create_input_box("Max items in area");
isf.create_input_box("Items (comma separated, e.g. frag_grenade,smoke_bomb)");
int isok=isf.create_button("OK", true);
int iscancel=isf.create_button("Cancel", false, true);
isf.focus(0);
string istime="";
string ismax="";
string isitems="";
while(true)
{
wait(5);
isf.monitor();
if(isf.is_pressed(iscancel)) return;
if(isf.is_pressed(isok)){istime=isf.get_text(0);ismax=isf.get_text(1);isitems=isf.get_text(2);break;}
}
if(!builder_valid_integer(istime) or !builder_valid_integer(ismax) or string_to_number(istime)<1 or string_to_number(ismax)<1 or !builder_valid_text_field(isitems)){speak("Respawn time and maximum items must be positive whole numbers, and the item list cannot contain colons or line breaks.");return;}
string items_colon=string_replace(isitems, ",", ":", true);
line="ispawn:"+coords+":"+istime+":"+ismax+":"+items_colon;
}
else if(sel==5)
{
// Bunker control point: a single coordinate plus a name, written as a
// bunker line the server reads as the source of truth for /bunkers.
string coords=builder_coord_form("Bunker Coordinates", false, false, "");
if(coords=="") return;
iw_form bf;
bf.create_window("Bunker Name", false, true);
bf.create_input_box("Bunker name");
int bok=bf.create_button("OK", true);
int bcancel=bf.create_button("Cancel", false, true);
bf.focus(0);
string bname="";
while(true)
{
wait(5);
bf.monitor();
if(bf.is_pressed(bcancel)) return;
if(bf.is_pressed(bok)){bname=bf.get_text(0);break;}
}
bname=bname.trim_whitespace();if(!builder_valid_text_field(bname)){speak("Bunker names cannot be empty or contain colons or line breaks.");return;}
line="bunker:"+coords+":"+bname;
}
else if(sel==6)
{
iw_form vf;
vf.create_window("Map Max X", false, true);
vf.create_input_box("Max X value");
int vok=vf.create_button("OK", true);
int vcancel=vf.create_button("Cancel", false, true);
vf.focus(0);
while(true)
{
wait(5);
vf.monitor();
if(vf.is_pressed(vcancel)) return;
if(vf.is_pressed(vok)){string value=vf.get_text(0).trim_whitespace();if(!builder_valid_integer(value) or string_to_number(value)<1){speak("Maximum X must be a positive whole number.");continue;}line="maxx:"+value;break;}
}
}
else if(sel==7)
{
iw_form vf;
vf.create_window("Map Max Y", false, true);
vf.create_input_box("Max Y value");
int vok=vf.create_button("OK", true);
int vcancel=vf.create_button("Cancel", false, true);
vf.focus(0);
while(true)
{
wait(5);
vf.monitor();
if(vf.is_pressed(vcancel)) return;
if(vf.is_pressed(vok)){string value=vf.get_text(0).trim_whitespace();if(!builder_valid_integer(value) or string_to_number(value)<1){speak("Maximum Y must be a positive whole number.");continue;}line="maxy:"+value;break;}
}
}
else if(sel==8)
{
iw_form vf;
vf.create_window("Map Max Z", false, true);
vf.create_input_box("Max Z value");
int vok=vf.create_button("OK", true);
int vcancel=vf.create_button("Cancel", false, true);
vf.focus(0);
while(true)
{
wait(5);
vf.monitor();
if(vf.is_pressed(vcancel)) return;
if(vf.is_pressed(vok)){string value=vf.get_text(0).trim_whitespace();if(!builder_valid_integer(value) or string_to_number(value)<0){speak("Maximum Z must be a nonnegative whole number.");continue;}line="maxz:"+value;break;}
}
}
if(line!="")
{
string current_id,current_data;if(!builder_fetch_map_data(current_id,current_data))return;
send_reliable(0, "builder_append "+current_id+" "+line, 0);
speak("Element submitted for validation and reload.");
}
return;
}
}
}

void builder_delete_line_menu()
{
string found_file="";
string mdata="";
if(!builder_fetch_map_data(found_file,mdata))return;
string[] lines=delinear(mdata);
int[] line_indices;
iw_form f;
f.create_window("Delete Line", false, true);
int f_list=f.create_list("Map lines", 0, false);
for(uint i=0; i<lines.length(); i++)
{
if(lines[i]!="")
{
f.add_list_item(f_list, (i+1)+": "+lines[i]);
line_indices.insert_last(i);
}
}
int del_btn=f.create_button("&Delete selected", true);
int cancel_btn=f.create_button("Cancel", false, true);
f.focus(f_list);
while(true)
{
wait(5);
f.monitor();
if(f.is_pressed(cancel_btn)) return;
if(f.is_pressed(del_btn))
{
int sel=f.get_list_position(f_list);
if(sel>=0 and sel<int(line_indices.length()))
{
send_reliable(0, "builder_delete_line "+found_file+" "+line_indices[sel], 0);
speak("Line deleted.");
return;
}
}
}
}

void builder_edit_line_menu()
{
string found_file="";
string mdata="";
if(!builder_fetch_map_data(found_file,mdata))return;
string[] lines=delinear(mdata);
int[] line_indices;
iw_form f;
f.create_window("Edit Line", false, true);
int f_list=f.create_list("Map lines", 0, false);
for(uint i=0; i<lines.length(); i++)
{
if(lines[i]!="")
{
f.add_list_item(f_list, (i+1)+": "+lines[i]);
line_indices.insert_last(i);
}
}
int edit_btn=f.create_button("&Edit selected", true);
int cancel_btn=f.create_button("Cancel", false, true);
f.focus(f_list);
while(true)
{
wait(5);
f.monitor();
if(f.is_pressed(cancel_btn)) return;
if(f.is_pressed(edit_btn))
{
int sel=f.get_list_position(f_list);
if(sel>=0 and sel<int(line_indices.length()))
{
int line_idx=line_indices[sel];
string old_line=lines[line_idx];
iw_form ef;
ef.create_window("Edit Line "+(line_idx+1), false, true);
ef.create_input_box("Line content", old_line);
int save_btn=ef.create_button("&Save", true);
int ecancel=ef.create_button("Cancel", false, true);
ef.focus(0);
while(true)
{
wait(5);
ef.monitor();
if(ef.is_pressed(ecancel)) return;
if(ef.is_pressed(save_btn))
{
string new_line=ef.get_text(0);
if(new_line.trim_whitespace()=="" or string_contains(new_line,"\r",1)>=0 or string_contains(new_line,"\n",1)>=0){speak("A map line cannot be empty or contain a line break.");continue;}
send_reliable(0, "builder_edit_line "+found_file+" "+line_idx+" "+new_line, 0);
speak("Line edited.");
return;
}
}
}
}
}
}

void builder_edit_map()
{
string found_file="";
string mdata="";
if(!builder_fetch_map_data(found_file,mdata))return;
iw_form f;
f.create_window("Edit Map: "+mapname, false, true);
f.create_input_box("Map data", mdata, "", 0, false, false, true);
int save_btn=f.create_button("&Save", true);
int cancel_btn=f.create_button("Cancel", false, true);
f.focus(0);
while(true)
{
wait(5);
f.monitor();
if(f.is_pressed(cancel_btn)) return;
if(f.is_pressed(save_btn))
{
string new_data=f.get_text(0);
if(new_data.trim_whitespace()=="" or string_contains(new_data,"mapname:",1)<0){speak("A complete map must contain nonempty data and a mapname line.");continue;}
send_reliable(0, "builder_write_map "+found_file+" "+new_data, 0);
speak("Map saved.");
return;
}
}
}

void builder_delete_map()
{
string found_file="";
string current_data;if(!builder_fetch_map_data(found_file,current_data))return;
if(yesno("Delete the current map file? This cannot be undone.")!=1){speak("Map deletion cancelled.");return;}
send_reliable(0, "builder_delete_map "+found_file, 0);
speak("Map deleted.");
}

void builder_append_current(string line,string label)
{string current_id,current_data;if(!builder_fetch_map_data(current_id,current_data))return;send_reliable(0,"builder_append "+current_id+" "+line,0);speak(label+" submitted for validation and live reload.");}

void builder_add_spawn_here(){builder_append_current("spawn:"+int(mr.x)+":"+int(mr.y)+":"+int(round(me.z,0)),"Player spawn at your current position");}

void builder_add_fixture_here()
{
string[] types={"atm","vending_machine","coke_machine","kiosk","hospital_bed","hospital_coagulator","hospital_defibolator","hospital_ventilator","instrument_prep","table","computer1","crate","dumpster","fridge","sink1","sink2","security_radio1","tv","street_light","tree1","tree2","tree3","parked_car1","door_wood","door_metal"};
nv_form f;f.create_window("Add fixture here",false,true);nv_form_list_box@ list=f.add_list("Fixture preset","fixture");for(uint i=0;i<types.length();i++)list.add(string_replace(types[i],"_"," ",true),types[i]);nv_form_input@ label=f.add_input("Landmark label","label",get_location());nv_form_button@ add=f.add_button("Add at current position","add",true);nv_form_button@ cancel=f.add_button("Cancel","cancel",false,true);f.focus_control(list);
while(true){wait(5);f.monitor();if(connected)netloop();if(f.is_pressed(cancel))return;if(f.is_pressed(add)){int selected=list.list_position;if(selected<0 or selected>=int(types.length())){speak("Select a fixture preset.");continue;}string landmark=label.text.trim_whitespace();if(!builder_valid_text_field(landmark)){speak("Enter a landmark label without colons or line breaks.");continue;}builder_append_current("fixture:"+types[selected]+":"+int(mr.x)+":"+int(mr.y)+":"+int(round(me.z,0))+":"+landmark,"Fixture");return;}}
}

void builder_add_navigation_region()
{
string[] kinds={"space","openspace","portal","poiregion"};string[] labels={"Occluding room","Open acoustic region","Doorway or acoustic portal","Point-of-interest region"};
nv_form pick;pick.create_window("Add navigation or occlusion region",false,true);nv_form_list_box@ list=pick.add_list("Region type","type");for(uint i=0;i<labels.length();i++)list.add(labels[i],kinds[i]);nv_form_button@ next=pick.add_button("Next","next",true);nv_form_button@ cancel=pick.add_button("Cancel","cancel",false,true);pick.focus_control(list);int selected=-1;while(true){wait(5);pick.monitor();if(connected)netloop();if(pick.is_pressed(cancel))return;if(pick.is_pressed(next)){selected=list.list_position;if(selected>=0)break;speak("Select a region type.");}}
string coords=builder_coord_form(labels[selected]+" coordinates",true,false,"");if(coords=="")return;string label=af_input("Region name","",true).trim_whitespace();if(!builder_valid_text_field(label)){speak("Region names cannot be empty or contain colons.");return;}string line=kinds[selected]+":"+coords+":"+label;if(selected<2)line+=":"+af_input("Boundary material","brick",true).trim_whitespace()+":"+(selected==0?"room":"open");else if(selected==2)line+=":opening";builder_append_current(line,labels[selected]);
}

void builder_add_destructible_box()
{
string map_id,data;if(!builder_fetch_map_data(map_id,data))return;int next_id=1;string[] lines=delinear(data);for(uint i=0;i<lines.length();i++){string[] fields=string_split(lines[i],":",false);if(fields.length()>1 and fields[0]=="object"){int id=string_to_number(fields[1]);if(id>=next_id)next_id=id+1;}}
string coords=builder_coord_form("Destructible object bounds",true,false,"");if(coords=="")return;string name=af_input("Object name","Builder object",true).trim_whitespace();string material=af_input("Material and collision sound prefix","wallwood",true).trim_whitespace();string health=af_input("Durability points","300",true).trim_whitespace();string destroy_sound=af_input("Destruction sound path","executioners_rage/environment/objects/table/dest.wav",true).trim_whitespace();if(!builder_valid_text_field(name) or !builder_valid_text_field(material) or !builder_valid_text_field(destroy_sound) or !builder_valid_integer(health) or string_to_number(health)<1){speak("The object properties are invalid.");return;}
string[] c=string_split(coords,":",false);string header="object:"+next_id+":"+health+":1:1:"+material+":"+destroy_sound+":"+name;string part="objectpart:"+next_id+":"+c[0]+":"+c[1]+":"+c[2]+":"+c[3]+":"+c[4]+":"+c[5]+":"+material+":1";if(data!="" and string_right(data,1)!="\n")data+="\r\n";data+=header+"\r\n"+part;send_reliable(0,"builder_write_map "+map_id+" "+data,0);speak("Destructible object "+next_id+" submitted as one validated atomic map update.");
}

void builder_map_summary()
{
string map_id,data;if(!builder_fetch_map_data(map_id,data))return;dictionary counts;string[] lines=delinear(data);for(uint i=0;i<lines.length();i++){string[] fields=string_split(lines[i],":",false);if(fields.length()==0)continue;int count=0;counts.get(fields[0],count);counts.set(fields[0],count+1);}string[] keys=counts.get_keys();string report=map_display_name(map_id)+" contains "+lines.length()+" source lines.\n";for(uint i=0;i<keys.length();i++){int count=0;counts.get(keys[i],count);report+=keys[i]+": "+count+"\n";}show_readonly_audio_form("Map structure summary",report);
}

void builder_export_snapshot()
{
string map_id,data;if(!builder_fetch_map_data(map_id,data))return;string folder=DIRECTORY_LOCAL_APPDATA+"/iw/builder_exports";directory_create(DIRECTORY_LOCAL_APPDATA+"/iw");directory_create(folder);string path=folder+"/"+map_id+"_"+ticks()+".map";file_put_contents(path,data,false);speak("Exported the current authoritative map source to "+path+".");
}

void builder_teleport_tool()
{
string coords=builder_coord_form("Builder teleport",false,false,"");if(coords=="")return;string[] fields=string_split(coords,":",false);me.x=string_to_number(fields[0]);me.y=string_to_number(fields[1]);me.z=string_to_number(fields[2]);mr.x=round(me.x,0);mr.y=round(me.y,0);send_reliable(0,"/go "+fields[0]+" "+fields[1]+" "+fields[2],1);speak("Builder teleport requested.");
}

// The builder key opens the world editor (includes/world_editor.nvgt).
void builder_menu(){world_editor_menu();}

void command_menu()
{
iw_form f;
f.create_window("Commands", false, true);
int f_list=f.create_list("Select a command", 0, false);
// Player commands
f.add_list_item(f_list, "/bunkers - Show bunker locations");
f.add_list_item(f_list, "/team info - Show your team, roles, and point pool");
f.add_list_item(f_list, "/team shop - Show team-shop items and prices");
f.add_list_item(f_list, "/pm [name] [message] - Private message a player");
f.add_list_item(f_list, "/bug - Submit a bug report");
f.add_list_item(f_list, "/bugs - View bug reports");
f.add_list_item(f_list, "/chestfind - View chest locations");
f.add_list_item(f_list, "/afk - Toggle AFK mode");
f.add_list_item(f_list, "/start_admin - Activate admin (if authorized)");
f.add_list_item(f_list, "/accounts - Browse registered accounts (administrator or developer)");
if (SCRIPT_COMPILED==false)
{
f.add_list_item(f_list, "/reboot - Reboot the server (dev)");
f.add_list_item(f_list, "/kick [name] - Kick a player (dev/admin)");
f.add_list_item(f_list, "/go [x y z] - Teleport to coordinates (dev/admin)");
f.add_list_item(f_list, "/ban [name] - Ban a player (dev/admin)");
f.add_list_item(f_list, "/newadmin [name] - Add an admin (dev)");
f.add_list_item(f_list, "/notify [message] - Broadcast a message (dev/admin)");
f.add_list_item(f_list, "/motd [message] - Set message of the day (dev/admin)");
f.add_list_item(f_list, "/give [name item amount] - Give items (dev/admin)");
f.add_list_item(f_list, "/givemyself [item amount] - Give items to self (admin)");
f.add_list_item(f_list, "/getmyshit - Get all world items (dev)");
f.add_list_item(f_list, "/removeitems - Remove all world items (dev)");
}
int f_run=f.create_button("&Run", true);
int f_close=f.create_button("&Close", false, true);
f.focus(f_list);
while(true)
{
wait(5);
f.monitor();
if (connected==true)
netloop();
if (f.is_pressed(f_run))
{
int sel=f.get_list_position(f_list);
string item=f.get_list_item(f_list, sel);
// Extract the command part (before " - ")
string cmd=item;
int dash=string_contains(cmd, " - ", 1);
if (dash>-1) cmd=string_mid(cmd, 0, dash);
if (cmd=="/afk")
{
toggle_afk();
break;
}
if (cmd=="/bug")
{
bug_submit();
break;
}
if (cmd=="/bugs")
{
bugs_menu();
break;
}
// If command has parameters (brackets), prompt the user for input
if (string_contains(cmd, "[", 1)>-1)
{
// Extract the base command (before first bracket)
int bracket=string_contains(cmd, " [", 1);
string base=cmd;
if (bracket>-1) base=string_mid(cmd, 0, bracket);
string args=af_input("Enter arguments for "+base, "", true);
if (args!="")
{
send_reliable(0, base+" "+args, 1);
speak("Command sent.");
}
}
else
{
send_global_chat_or_command(cmd);
speak("Command sent.");
}
break;
}
else if (f.is_pressed(f_close))
{
break;
}
}
}

// ---------------------------------------------------------------------------
// Documentation / Help system.
// Reads .txt files from iwserver/docs/.
// ---------------------------------------------------------------------------
string[] help_categories;
string[][] help_category_entries;
void build_help_data(bool include_dev=false)
{
help_categories.resize(0);
help_category_entries.resize(0);
string docs_dir = "iwserver/docs";
if (!directory_exists(docs_dir))
docs_dir = "docs";
string[] cat_names = {
"Gameplay Fundamentals",
"Game Modes and Maps",
"Game Systems"
};
string[][] cat_docs = {
{"getting_started", "controls", "turning_and_aiming", "weapon_handling", "fire_modes", "stamina", "commands"},
{"modes", "shattersea_map", "coruscant_map", "freyas_ascent_map", "turbolifts"},
{"inventory_system", "item_mechanics", "ammo_system", "equipment", "buffs_debuffs", "teams", "bunkers", "rewards", "credits", "holsters", "attachments", "support_tickets", "vehicles"}
};
for (uint c = 0; c < cat_names.length(); c++)
{
string[] valid;
for (uint i = 0; i < cat_docs[c].length(); i++)
{
string path = docs_dir + "/" + cat_docs[c][i] + ".txt";
if (file_exists(path))
valid.insert_last(cat_docs[c][i]);
}
if (valid.length() > 0)
{
help_categories.insert_last(cat_names[c]);
help_category_entries.insert_last(valid);
}
}
// Content help is generated from the same runtime records used by inventory,
// the armoury, grants, attachments, and ammunition compatibility.
string[] database_categories;
for(uint i=0;i<content_database.length();i++)
{
string category=content_database[i].category;bool seen=false;
for(uint c=0;c<database_categories.length();c++)if(database_categories[c]==category)seen=true;
if(!seen)database_categories.insert_last(category);
}
for(uint c=0;c<database_categories.length();c++)
{
string[] entries;
for(uint i=0;i<content_database.length();i++)if(content_database[i].category==database_categories[c])entries.insert_last(content_database[i].id);
if(entries.length()>0){help_categories.insert_last(database_categories[c]);help_category_entries.insert_last(entries);}
}
if (include_dev)
{
string[] dev_docs = {"dev_commands", "dev_admin_system", "dev_network_architecture", "dev_map_format"};
string[] valid;
for (uint i = 0; i < dev_docs.length(); i++)
{
string path = docs_dir + "/" + dev_docs[i] + ".txt";
if (file_exists(path))
valid.insert_last(dev_docs[i]);
}
if (valid.length() > 0)
{
help_categories.insert_last("Developer Reference");
help_category_entries.insert_last(valid);
}
}
}

string read_help_file(string entry_name)
{
int ci=content_find(entry_name);
if(ci>=0)
{
content_record@ record=content_database[ci];
string result=record.display_name+"\n\nCategory: "+record.category+".\n";
if(record.category=="Weapons")return result+content_weapon_details(entry_name);
result+=record.summary;
string[] stats=item_stats_lines(entry_name);
for(uint si=0;si<stats.length();si++)result+="\n"+stats[si];
if(record.category=="Ammo")
{
string[] fed_weapons;
for(uint i=0;i<gun_ammos.length();i++)if(gun_ammos[i].reserve_item==entry_name)fed_weapons.insert_last(get_weapon_display_name(gun_ammos[i].weapon_name));
for(uint i=0;i<ammunition_loads.length();i++)if(ammunition_loads[i].reserve_item==entry_name){for(uint w=0;w<ammunition_loads[i].weapons.length();w++)fed_weapons.insert_last(get_weapon_display_name(ammunition_loads[i].weapons[w]));result+="\nAmmunition behavior: "+ammunition_loads[i].description;}
result+="\nCompatible weapons: "+content_join(fed_weapons)+". Use Alt+R with a weapon drawn to select a compatible load for its next reload.";
}
else if(record.category=="Attachments")result+="\nMechanical effect: "+attachment_effect_description(entry_name);
return result;
}
string docs_dir = "iwserver/docs";
if (!directory_exists(docs_dir))
docs_dir = "docs";
string path = docs_dir + "/" + entry_name + ".txt";
if (!file_exists(path))
return "No help available for " + string_replace(entry_name, "_", " ", true) + ".";
file f;
if (!f.open(path, "rb"))
return "Could not open help file.";
string content = f.read();
f.close();
return content;
}

void show_help_entry(string entry_name)
{
string content = read_help_file(entry_name);
int ci=content_find(entry_name);string title=ci>=0?content_database[ci].display_name:string_replace(entry_name, "_", " ", true);
nv_form f;f.create_window("Help: "+title,false,true);
nv_form_input@ help_content=f.add_input("Read-only help content","help_content",content,"",0,true,true);
nv_form_button@ close=f.add_button("Close","close",true,true);
f.focus_control(help_content);
while(true)
{
wait(5);
f.monitor();
if(connected)netloop();
if(f.is_pressed(close))return;
}
}

void show_help_list(){show_help_browser_form();}

void show_item_help(string item)
{
if(string_contains(item,"__partial__",1)==0){int pidx=string_to_number(string_replace(item,"__partial__","",false));if(pidx>=0 and pidx<int(partial_items.length()))item=partial_items[pidx].base_item;}
string content = read_help_file(item);
if (string_contains(content, "No help available", 1) == 0)
{
speak("No help entry for " + string_replace(item, "_", " ", true) + ".");
return;
}
show_help_entry(item);
}

void show_help_browser_form()
{
build_help_data(SCRIPT_COMPILED==false);
if(help_categories.length()==0) { speak("No help entries found."); return; }
nv_form f; f.create_window("Help Topics",false,true);
nv_form_list_box@ categories=f.add_list("Categories","help_categories",false,{},0,-1,true);
for(uint i=0;i<help_categories.length();i++) categories.add(help_categories[i],""+i);
nv_form_list_box@ topics=f.add_list("Topics for selected category","help_topics",false,{},0,-1,true);
nv_form_input@ content=f.add_input("Selected topic content","help_content","","",0,true,true);
nv_form_button@ close=f.add_button("Close","close",false,true);
categories.set_pos(0,false);
int previous_category=-1, previous_topic=-1;
f.focus_control(categories);
while(true)
{
wait(5); f.monitor(); if(connected) netloop();
if(f.is_pressed(close)) return;
int category=categories.list_position;
if(category!=previous_category and category>=0 and category<int(help_categories.length()))
{
previous_category=category; previous_topic=-1;
topics.items.resize(0); topics.list_position=-1;
for(uint i=0;i<help_category_entries[category].length();i++)
{int ci=content_find(help_category_entries[category][i]);topics.add(ci>=0?content_database[ci].display_name:string_replace(help_category_entries[category][i],"_"," ",true),help_category_entries[category][i]);}
if(topics.items.length()>0) topics.set_pos(0,false);
content.text="Choose a topic, then press Tab again to read it."; content.cursor=0;
}
int topic=topics.list_position;
if(category>=0 and category<int(help_categories.length()) and topic!=previous_topic and topic>=0 and topic<int(help_category_entries[category].length()))
{
previous_topic=topic;
content.text=read_help_file(help_category_entries[category][topic]);
content.cursor=0;
}
}
}

// ---------------------------------------------------------------------------
// Quickbar weapons view (Shift+I).
// ---------------------------------------------------------------------------
string quickbar_display_name(string item)
{
if(is_weapon(item))return get_weapon_display_name(item);int ci=content_find(item);if(ci>=0)return content_database[ci].display_name;return string_replace(item,"_"," ",true);
}

int quickbar_weapon_score(string item)
{
for(uint i=0;i<wpn_cache.length();i++)if(wpn_cache[i].id==item){int interval=wpn_cache[i].firetime>0?wpn_cache[i].firetime:500;int average=(wpn_cache[i].damage+wpn_cache[i].max_damage)/2;return average*1000/interval+wpn_cache[i].range*4-wpn_cache[i].spread*2+(wpn_cache[i].penetration*30);}
return 0;
}

string quickbar_weapon_role(string item)
{
for(uint i=0;i<wpn_cache.length();i++)if(wpn_cache[i].id==item){if(wpn_cache[i].melee)return "melee";if(wpn_cache[i].wclass=="pistol" or wpn_cache[i].wclass=="revolver")return "sidearm";return "primary";}return "";
}

string quickbar_best_weapon(string role,string[] excluded)
{
string best="";int best_score=-2147483647;string[] keys=inv.get_keys();for(uint i=0;i<keys.length();i++){int amount=0;inv.get(keys[i],amount);if(amount<1 or !is_weapon(keys[i]) or excluded.find(keys[i])>=0 or quickbar_weapon_role(keys[i])!=role)continue;int score=quickbar_weapon_score(keys[i]);if(score>best_score){best_score=score;best=keys[i];}}return best;
}

int quickbar_item_score(string item)
{
int amount=0;inv.get(item,amount);int score=amount;
if(item=="time_bomb")score+=1100;else if(item=="c4")score+=1050;else if(item=="frag_grenade")score+=1000;else if(item=="impact_grenade")score+=980;else if(item=="incendiary_grenade")score+=950;else if(item=="gas_grenade")score+=920;else if(item=="proximity_mine" or item=="claymore")score+=880;else if(item=="concussion_grenade" or item=="flashbang")score+=820;
else if(item=="trauma_repair_serum_bottle")score+=1000;else if(item=="nanocyte_solution_bottle")score+=970;else if(item=="medigel_tonic_bottle")score+=940;else if(item=="coagulant_serum_bottle")score+=920;else if(item=="regenex_tablet_bottle")score+=900;else if(item=="life_injection")score+=850;else if(item=="adrenaline_syringe")score+=800;
else if(item=="translocator")score+=1000;else if(item=="biomonitor_bracelet" or item=="wirenet")score+=950;else if(item=="hypercomp")score+=900;else if(item=="binoculars")score+=850;else if(item=="nanomatic_multitool")score+=800;else if(string_contains(item,"team_",1)==0)score+=700;else score+=100;
return score;
}

bool quickbar_item_group_matches(string item,string group)
{
string category=get_item_category(item);if(group=="explosive")return category=="Explosives";if(group=="healing")return category=="Healing";if(group=="utility")return category=="Equipment" or category=="Tools" or category=="Electronics" or category=="Team";return false;
}

string quickbar_best_item(string group,string[] excluded)
{
string best="";int best_score=-2147483647;string[] keys=inv.get_keys();for(uint i=0;i<keys.length();i++){int amount=0;inv.get(keys[i],amount);if(amount<1 or is_weapon(keys[i]) or excluded.find(keys[i])>=0 or !quickbar_item_group_matches(keys[i],group))continue;int score=quickbar_item_score(keys[i]);if(score>best_score){best_score=score;best=keys[i];}}return best;
}

void quickbar_add_choice(string item,string reason,string[] &inout choices,string[] &inout reasons)
{if(item=="" or choices.find(item)>=0 or choices.length()>=10)return;choices.insert_last(item);reasons.insert_last(reason);}

void intelligently_bind_quickbar()
{
string[] choices,reasons;string selected;
selected=quickbar_best_weapon("melee",choices);quickbar_add_choice(selected,"the strongest available close-combat option, kept first for immediate access",choices,reasons);
selected=quickbar_best_weapon("sidearm",choices);quickbar_add_choice(selected,"the best available compact sidearm, kept beside the melee slot",choices,reasons);
selected=quickbar_best_weapon("primary",choices);quickbar_add_choice(selected,"the highest-rated primary by damage output, range, accuracy, penetration and firing interval",choices,reasons);
selected=quickbar_best_weapon("primary",choices);quickbar_add_choice(selected,"the next-best distinct primary weapon for a fast tactical alternative",choices,reasons);
for(int i=0;i<2;i++){selected=quickbar_best_item("explosive",choices);quickbar_add_choice(selected,i==0?"the highest-priority available explosive":"the best remaining distinct explosive",choices,reasons);}
for(int i=0;i<2;i++){selected=quickbar_best_item("healing",choices);quickbar_add_choice(selected,i==0?"the strongest practical recovery option":"the best remaining recovery or stamina option",choices,reasons);}
for(int i=0;i<2;i++){selected=quickbar_best_item("utility",choices);quickbar_add_choice(selected,i==0?"the most broadly useful available equipment":"the best remaining practical utility item",choices,reasons);}
for(int i=0;i<10;i++)quickbar[i]="";for(uint i=0;i<choices.length() and i<10;i++)quickbar[i]=choices[i];
if(choices.length()==0){speak("No suitable weapons or usable items are available to bind.");return;}string report="The quickbar was rebuilt for this session.\n\n";for(uint i=0;i<choices.length();i++)report+="Slot "+(i+1)+": "+quickbar_display_name(choices[i])+" — "+reasons[i]+".\n";if(choices.length()<10)report+="\nThe remaining "+(10-choices.length())+" slots were left empty because there were no additional high-value items in the required roles.";show_readonly_audio_form("Automatic quickbar layout",report);
}

void clear_session_quickbar()
{for(int i=0;i<10;i++)quickbar[i]="";speak("All quickbar slots were cleared for this session.");}

void show_quickbar_weapons()
{
iw_form f;
f.create_window("Quickbar and equipment abilities", false, true);
int f_list = f.create_list("Quickbar slots", 0, false);
for (int i = 0; i < 10; i++)
{
string entry=quickbar[i];
string label="Slot "+(i+1)+": ";
if(entry=="")label+="empty";
else if(is_equipment_ability(entry))
{
label+=equipment_ability_name(entry)+". From "+equipment_ability_source(entry)+". "+equipment_ability_description(entry);
int remaining=equipment_ability_cooldown_remaining(entry);
if(entry=="ability_biomonitor_scan")label+=" Cooldown 15 seconds; "+(remaining>0?remaining+" seconds remaining":"ready")+".";
else if(entry=="ability_wirenet_toggle")label+=" No cooldown; "+wirenet_charges+" charges; "+(wirenet_active?"active":"inactive")+".";
}
else if(is_weapon(entry))
{
label += get_weapon_display_name(entry);
int ammo = ammo_check(entry);
if (ammo >= 0)
{
int qgi = find_gun(entry);
if (qgi >= 0 and gun_ammos[qgi].ammo_display == "charge")
label += " (" + get_ammo_percentage(ammo, gun_ammos[qgi].mag_capacity) + "% charge)";
else if (qgi >= 0 and gun_ammos[qgi].ammo_display == "fuel")
label += " (" + get_ammo_percentage(ammo, gun_ammos[qgi].mag_capacity) + "% fuel)";
else
label += " (" + ammo + " loaded)";
}
}
else label+=quickbar_display_name(entry);
f.add_list_item(f_list,label);
}
int f_move=f.create_button("&Move selected slot");
int f_auto=f.create_button("&Automatically bind best loadout");
int f_clear=f.create_button("&Clear quickbar for this session");
int f_close = f.create_button("&Close", true, true);
f.focus(f_list);
while(true)
{
wait(5);
f.monitor();
if (connected==true)
netloop();
if(f.is_pressed(f_move))
{
int source=f.get_list_position(f_list);
if(source<0 or source>9)continue;
iw_form destination;
destination.create_window("Move quickbar entry",false,true);
int dl=destination.create_list("Destination slot",0,false);
for(int d=0;d<10;d++)destination.add_list_item(dl,"Slot "+(d+1)+(quickbar[d]==""?": empty":": "+(is_equipment_ability(quickbar[d])?equipment_ability_name(quickbar[d]):quickbar_display_name(quickbar[d]))));
int dm=destination.create_button("&Move",true);
int dc=destination.create_button("&Cancel",false,true);
destination.focus(dl);
while(true){wait(5);destination.monitor();if(connected)netloop();if(destination.is_pressed(dc))break;if(destination.is_pressed(dm)){int target=destination.get_list_position(dl);if(target>=0 and target<10){string held=quickbar[target];quickbar[target]=quickbar[source];quickbar[source]=held;speak("Moved to slot "+(target+1)+".");}break;}}
break;
}
if(f.is_pressed(f_auto)){intelligently_bind_quickbar();return;}
if(f.is_pressed(f_clear)){clear_session_quickbar();return;}
if (f.is_pressed(f_close))
break;
}
}

// ---------------------------------------------------------------------------
// Inventory menu (I key).
// A self-voicing menu for browsing the inventory. Up and down arrows scroll
// between items; Enter closes and moves the cycle inventory (Tab/Shift+Tab) to
// the focused item; Shift+Enter closes and uses the focused item; Alt+Enter
// opens the help entry for the focused item.
// ---------------------------------------------------------------------------

// Human-readable label for the inventory entry at the given filtered position,
// mirroring the wording used by cycle_inv.
string inv_menu_label(const string[] &in keys, int pos)
{
	int total = int(keys.length());
	if(pos<0 or pos>=total)return "No item selected.";
	string key = keys[pos];
	if (string_contains(key, "__partial__", 1) == 0)
	{
		int pidx = string_to_number(string_replace(key, "__partial__", "", false));
		if (pidx >= 0 and pidx < int(partial_items.length()))
		{
			string base_name = string_replace(partial_items[pidx].base_item, "_", " ", true);
			string amt = partial_amount_label(partial_items[pidx].base_item, partial_items[pidx].remaining, partial_items[pidx].max_capacity)+", "+ammunition_display_name(partial_items[pidx].ammunition);
			return base_name + " (" + amt + "). " + (pos+1) + " of " + total;
		}
		return "unknown item. " + (pos+1) + " of " + total;
	}
	int a;
	inv.get(key, a);
	string display_name;
	if (is_weapon(key))
		display_name = get_weapon_display_name(key);
	else
	{int content_index=content_find(key);display_name=content_index>=0?content_database[content_index].display_name:string_replace(key, "_", " ", true);}
	if (is_ammo_container(key))
		return display_name + " (" + a + "). " + (pos+1) + " of " + total;
	else if(item_is_liquid_medication(key))
		return display_name+" ("+round(medication_amount_remaining(key),2)+" fluid ounces left)"+(a>1?", "+a+" bottles":"")+". "+(pos+1)+" of "+total;
	else if(item_is_pill_bottle(key))
		return display_name+" ("+int(medication_amount_remaining(key))+" pills left)"+(a>1?", "+a+" bottles":"")+". "+(pos+1)+" of "+total;
	else if (a == 1)
		return display_name + ". " + (pos+1) + " of " + total;
	else
		return a + " " + display_name + "s. " + (pos+1) + " of " + total;
}

// The underlying item id for a filtered key (resolving partial ammo entries to
// their base item), used for help lookups and using items.
string inv_menu_item_id(string key)
{
	if (string_contains(key, "__partial__", 1) == 0)
	{
		int pidx = string_to_number(string_replace(key, "__partial__", "", false));
		if (pidx >= 0 and pidx < int(partial_items.length()))
			return partial_items[pidx].base_item;
		return "";
	}
	return key;
}

// Use the focused inventory item, matching the behavior of the in-game use key.
void inv_menu_use(string key)
{
	if (string_contains(key, "__partial__", 1) == 0)
	{
		use_ammo_item(inv_menu_item_id(key));
		return;
	}
	usetimer.restart();
	if (is_weapon(key))
		draw_weapon(key);
	else
	{
		on_item_used(key);
		if (!executioners_handles_item(key) and key != "bomb_vest" and key != "translocator" and key != "translocator_cell" and key != "adrenaline_syringe" and key != "biomonitor_bracelet" and key != "wirenet" and key != "c4" and key != "hypercomp" and key != "nanomatic_multitool" and key != "nanomatic_components" and !is_attachment_item(key) and !is_holster_item(key) and !is_ammo_reserve_item(key))
			send_reliable(0,item_use_command(key),0);
	}
}

// A discoverable alternative to memorizing modifier shortcuts. The compact
// action sheet retains the live inventory underneath and only exposes actions
// that make sense for the focused entry.
void inventory_item_action_menu(string key)
{
	string item_id=inv_menu_item_id(key);if(item_id=="")return;
	string title=is_weapon(item_id)?get_weapon_display_name(item_id):string_replace(item_id,"_"," ",true);
	nv_form f;f.create_window(title+" actions",false,true);
	nv_form_input@ summary=f.add_input("Item information","summary",inv_menu_label(get_filtered_keys(),get_filtered_keys().find(key))+"\n"+item_mechanic_description(item_id),"",0,true,true);
	nv_form_button@ use=null;if(string_contains(key,"__partial__",1)!=0 and !item_is_thrown_explosive(item_id))@use=f.add_button(is_weapon(item_id)?"Equip weapon":"Use item","use",true);
	nv_form_button@ help=f.add_button("Open detailed help","help");
	nv_form_button@ give=null;nv_form_button@ drop=null;if(string_contains(key,"__partial__",1)!=0){@give=f.add_button("Give one to a nearby player","give");@drop=f.add_button("Drop one seven tiles ahead","drop");}
	nv_form_button@ close=f.add_button("Return to inventory","close",false,true);f.focus_control(@use!=null?use:help);
	while(true){wait(5);f.monitor();if(connected)netloop();grenade_cook_loop();if(f.is_pressed(close))return;if(@use!=null and f.is_pressed(use)){inv_menu_use(key);return;}if(f.is_pressed(help)){show_item_help(item_id);continue;}if(@give!=null and f.is_pressed(give)){inventory_give_to_nearby_player(key);return;}if(@drop!=null and f.is_pressed(drop)){send_reliable(0,"inventory_drop "+key,0);return;}}
}

void inventory_menu()
{
	if(!inventory_category_has_items(inv_category_index) and inventory_category_has_items(0))move_inventory_category(1);
	string[] keys = get_filtered_keys();
	if (keys.length() == 0)
	{
		speak("Your inventory is empty.");
		return;
	}
	int pos = invpos;
	if (pos < 0 or pos >= int(keys.length())) pos = 0;
	speak("Inventory, " + inv_categories[inv_category_index] + ", "+keys.length()+" items. " + inv_menu_label(keys, pos) + ". Up and down browse, Tab or left and right change category, Home and End jump, typing searches, Applications opens item actions, F1 reads controls, and Escape closes.");
	// Wait for the opening key to release so it is not read immediately.
	int open_key = kb("inventory");
	while (key_down(open_key) or key_down(KEY_RETURN)) { wait(5); if (connected == true) netloop(); }
	get_characters();string inventory_prefix="";timer inventory_prefix_timer;
	while (true)
	{
		wait(5);
		if (connected == true) netloop();
		bool grenade_was_cooking=cooked_grenade!="";grenade_cook_loop();if(grenade_was_cooking and cooked_grenade=="")return;
		if(inventory_prefix_timer.elapsed>1000)inventory_prefix="";string typed=get_characters().lower();if(typed!="" and !string_is_digits(typed)){inventory_prefix_timer.restart();inventory_prefix+=typed;int match=-1;for(uint candidate=0;candidate<keys.length();candidate++){string candidate_name=string_replace(inv_menu_item_id(keys[candidate]),"_"," ",true).lower();if(candidate_name.length()>=inventory_prefix.length() and string_left(candidate_name,inventory_prefix.length())==inventory_prefix){match=int(candidate);break;}}if(match<0 and inventory_prefix!=typed){inventory_prefix=typed;for(uint candidate=0;candidate<keys.length();candidate++){string candidate_name=string_replace(inv_menu_item_id(keys[candidate]),"_"," ",true).lower();if(candidate_name.length()>=inventory_prefix.length() and string_left(candidate_name,inventory_prefix.length())==inventory_prefix){match=int(candidate);break;}}}if(match>=0){pos=match;p.play_stationary("invmove.ogg",false);speak(inv_menu_label(keys,pos));}else {p.play_stationary(ui_sound("wrap"),false);inventory_prefix="";}continue;}
		if (key_pressed(KEY_ESCAPE))
		{
			speak("Closed inventory.");
			return;
		}
		if(key_pressed(KEY_F1)){speak("Inventory controls. Up and down browse. Page Up and Page Down move ten items. Home and End jump to the first and last item. Left and right, or Tab and Shift Tab, change between nonempty categories. Type several letters to find an item. Applications opens actions for the focused item. Enter selects it. Shift Enter uses it. Alt Enter opens help. Alt Up or Down reorders it, Alt Home moves it first, and Alt End moves it last. Space gives one to a nearby player. Backspace drops one seven tiles ahead. Escape closes.");continue;}
		// Read each arrow exactly once: key_pressed is edge-triggered and clears
		// the press when read, so reading KEY_RIGHT a second time would always
		// come back false and make both arrows cycle the same direction.
		bool alt_down=MENU_is_down();
		bool reorder_up=alt_down and key_pressed(KEY_UP),reorder_down=alt_down and key_pressed(KEY_DOWN),reorder_top=alt_down and key_pressed(KEY_HOME),reorder_bottom=alt_down and key_pressed(KEY_END);
		if(reorder_up or reorder_down or reorder_top or reorder_bottom)
		{
			if(keys.length()==0)continue;string moving=keys[pos];int direction=reorder_up?-1:reorder_down?1:reorder_top?-100000:100000;
			if(inventory_reorder(moving,direction)){keys=get_filtered_keys();pos=keys.find(moving);invpos=pos;p.play_stationary("invmove.ogg",false);speak(inv_menu_label(keys,pos)+". Moved.");}else speak("That item cannot move farther in this category.");
			continue;
		}
		if(key_pressed(KEY_SPACE))
		{
			if(keys.length()>0)inventory_give_to_nearby_player(keys[pos]);keys=get_filtered_keys();if(pos>=int(keys.length()))pos=int(keys.length())-1;if(pos<0)pos=0;continue;
		}
		if(key_pressed(KEY_BACK))
		{
			if(keys.length()>0 and string_contains(keys[pos],"__partial__",1)!=0){send_reliable(0,"inventory_drop "+keys[pos],0);return;}speak("Partial ammunition containers cannot be dropped directly.");continue;
		}
		if(key_pressed(KEY_APPS)){if(keys.length()>0)inventory_item_action_menu(keys[pos]);keys=get_filtered_keys();if(keys.length()==0){speak("This category is now empty.");move_inventory_category(1);keys=get_filtered_keys();pos=0;}else if(pos>=int(keys.length()))pos=int(keys.length())-1;continue;}
		bool tab_category=key_pressed(KEY_TAB);bool cat_prev = key_pressed(KEY_LEFT) or (tab_category and shift_is_down());
		bool cat_next = key_pressed(KEY_RIGHT) or (tab_category and !shift_is_down());
		if (cat_prev or cat_next)
		{
			// Left/right arrows cycle inventory categories. The filtered list is
			// rebuilt for the new category and browsing restarts at the top. The
			// shared category/position state is updated so Tab cycling stays in
			// sync after the menu closes.
			move_inventory_category(cat_next?1:0);
			keys = get_filtered_keys();
			pos = 0;
			p.play_stationary("invmove.ogg", false);
			// Single announcement: category name, then the first item (or empty).
			if (keys.length() > 0)
				speak(inv_categories[inv_category_index] + ". " + inv_menu_label(keys, pos));
			else
				speak(inv_categories[inv_category_index] + ". No items.");
		}
		else if(key_pressed(KEY_HOME)){if(keys.length()>0){pos=0;p.play_stationary("invmove.ogg",false);speak(inv_menu_label(keys,pos));}}
		else if(key_pressed(KEY_END)){if(keys.length()>0){pos=int(keys.length())-1;p.play_stationary("invmove.ogg",false);speak(inv_menu_label(keys,pos));}}
		else if(key_pressed(KEY_PRIOR)){if(keys.length()>0){pos-=10;if(pos<0)pos=0;p.play_stationary("invmove.ogg",false);speak(inv_menu_label(keys,pos));}}
		else if(key_pressed(KEY_NEXT)){if(keys.length()>0){pos+=10;if(pos>=int(keys.length()))pos=int(keys.length())-1;p.play_stationary("invmove.ogg",false);speak(inv_menu_label(keys,pos));}}
		else if (key_pressed(KEY_UP))
		{
			if (keys.length() == 0) continue;
			pos--;
			if (pos < 0) pos = int(keys.length()) - 1;
			p.play_stationary("invmove.ogg", false);
			speak(inv_menu_label(keys, pos));
		}
		else if (key_pressed(KEY_DOWN))
		{
			if (keys.length() == 0) continue;
			pos++;
			if (pos >= int(keys.length())) pos = 0;
			p.play_stationary("invmove.ogg", false);
			speak(inv_menu_label(keys, pos));
		}
		else if (key_pressed(KEY_RETURN))
		{
			if (keys.length() == 0) continue;
			string key = keys[pos];
			if(!MENU_is_down() and !shift_is_down() and grenade_pin_or_throw(inv_menu_item_id(key))){if(cooked_grenade=="")return;while(key_down(KEY_RETURN)){wait(5);if(connected)netloop();grenade_cook_loop();}continue;}
			if (MENU_is_down())
			{
				// Alt+Enter: open the help entry, keeping the menu open.
				string item_id = inv_menu_item_id(key);
				if (item_id != "")
					show_item_help(item_id);
				else
					speak("No help available.");
				while (key_down(KEY_RETURN)) { wait(5); if (connected == true) netloop(); }
			}
			else if (shift_is_down())
			{
				// Shift+Enter: close and use the item.
				inv_menu_use(key);
				return;
			}
			else
			{
				// Enter: close and move the cycle inventory to this item.
				invpos = pos;
				string item_id = inv_menu_item_id(key);
				string display_name;
				if (item_id != "" and is_weapon(item_id))
					display_name = get_weapon_display_name(item_id);
				else if (item_id != "")
					display_name = string_replace(item_id, "_", " ", true);
				else
					display_name = "item";
				speak(display_name + " selected.");
				return;
			}
		}
	}
}

// ---------------------------------------------------------------------------
// Item use side effects — apply buffs/effects on the client when items are used.
// Called from use_quickbar_slot and Enter key use path.
// ---------------------------------------------------------------------------
void on_item_used(string item)
{
if (item == "bomb_vest")
{
equip_item("bomb_vest", "body");
speak("Bomb vest equipped.");
}
else if (item == "translocator")
{
show_translocator_interface();
return;
}
else if (item == "translocator_cell")
{
use_translocator_cell();
return;
}
else if (item == "adrenaline_syringe")
{
apply_adrenaline_rush();
give("adrenaline_syringe", -1);
speak("Adrenaline rush! Movement speed doubled for 30 seconds.");
return;
}
else if (item == "nanomatic_multitool")
{
use_nanomatic_multitool();
return;
}
else if (item == "nanomatic_components")
{
use_nanomatic_components();
return;
}
else if (item == "biomonitor_bracelet")
{
if (equip_bracelet != "")
{
speak("You already have a bracelet equipped. Remove it first.");
return;
}
equip_item("biomonitor_bracelet", "bracelet");
give("biomonitor_bracelet", -1);
speak("Biomonitor bracelet equipped. Its scan ability was assigned to an available quickbar slot.");
return;
}
else if (item == "wirenet")
{
if (equip_medical != "")
{
speak("You already have medical equipment equipped. Remove it first.");
return;
}
equip_item("wirenet", "medical");
give("wirenet", -1);
speak("WireNet equipped with 3 charges. Its auto-heal toggle was assigned to an available quickbar slot.");
return;
}
else if (item == "c4")
{
send_reliable(0, "use_c4", 0);
return;
}
else if (item == "hypercomp")
{
hypercomp_menu();
return;
}
else if(item=="portable_auction_terminal")
{
online_supply_shop();
return;
}
else if(executioners_item_use(item))return;
else if(item=="hightech_grapple" or item=="anti_personnel_security_camera" or item=="neural_intrusion_device" or item=="field_restraints" or item=="reconnaissance_ring" or item=="carrier_missile" or item=="conventional_guided_missile" or item=="cannon_ball")
{
send_reliable(0,item_use_command(item),0);
return;
}
else if (is_attachment_item(item))
{
use_attachment_item(item);
return;
}
else if (is_holster_item(item))
{
equip_holster_item(item);
return;
}
else if (is_ammo_reserve_item(item))
{
use_ammo_item(item);
return;
}
}

// ---------------------------------------------------------------------------
// Using an ammunition item.
// Container-style ammo (ammo belts, shell boxes, loose shells, bolt quivers)
// loads a chosen number of rounds into the drawn weapon. Fuel canisters fill
// the drawn fuel weapon to a chosen percentage. Anything else (magazines,
// clips, energy cells, or ammo with no matching weapon drawn) explains itself.
// ---------------------------------------------------------------------------

// Prompt for how many rounds to load into an individual-reload weapon.
void ammo_prompt_rounds(string wname)
{
int gi=find_gun(wname);
if (gi<0) return;
gun_ammo@ g=gun_ammos[gi];
if (g.reloading) { speak("Already reloading."); return; }
int need=g.mag_capacity-g.mag_loaded;
if (need<=0) { speak(g.feed_device+" is already full."); return; }
int have=get_item_count(g.reserve_item);
if (have<=0) { speak("No spare "+g.reserve_label+" remaining."); return; }
int maxload=need;
if (maxload>have) maxload=have;
int count=maxload;
if (maxload>1)
{
string resp=af_input("Load how many rounds into the "+g.feed_device+"? (1 to "+maxload+")", ""+maxload, true);
if (resp=="") return;
count=string_to_number(resp);
if (count<1) count=1;
if (count>maxload) count=maxload;
}
start_reload_rounds(wname, count);
}

// Prompt for a fuel percentage to fill a drawn fuel weapon to.
void ammo_prompt_fuel(string wname)
{
int gi=find_gun(wname);
if (gi<0) return;
gun_ammo@ g=gun_ammos[gi];
if (g.reloading) { speak("Already reloading."); return; }
if (g.mag_loaded>=g.mag_capacity) { speak("Fuel tank is already full."); return; }
if (fuel_available(g.reserve_item)<=0) { speak("No fuel remaining in your "+g.reserve_label+"s."); return; }
int cur=get_ammo_percentage(g.mag_loaded, g.mag_capacity);
string resp=af_input("Fill fuel to what percent? (currently "+cur+"%, up to 100)", "100", true);
if (resp=="") return;
int pct=string_to_number(resp);
if (pct<0) pct=0;
if (pct>100) pct=100;
start_reload_fuel_to(wname, pct);
}

void use_attachment_item(string item)
{
string current_weapon=weapons[w];
if(current_weapon=="" or current_weapon=="empty")
{
speak("Draw a weapon first.");
return;
}
if(!can_attach_to(item, current_weapon))
{
speak("This attachment is not compatible with the "+get_weapon_display_name(current_weapon)+". It is designed for "+attachment_compatible_class_description(item)+" weapons.");
return;
}
int def_idx=find_attachment_def(item);
if(def_idx<0) return;
if(weapon_has_attachment_in_slot(current_weapon, attachment_defs[def_idx].slot))
{
if(!replace_occupied_attachments){speak("This weapon already has an attachment in the "+attachment_defs[def_idx].slot+" slot.");return;}
string[] installed=get_weapon_attachments(current_weapon);string displaced="";for(uint ia=0;ia<installed.length();ia++){int idi=find_attachment_def(installed[ia]);if(idi>=0 and attachment_defs[idi].slot==attachment_defs[def_idx].slot){displaced=installed[ia];break;}}
if(displaced=="" or !detach_from_weapon(displaced,current_weapon))return;give(displaced,1);p.play_stationary("attachment_"+displaced+"_remove.ogg",false);send_reliable(0,"detach "+displaced+" "+current_weapon,0);speak("Replaced "+string_replace(displaced,"_"," ",true)+".");
}
if(attach_to_weapon(item, current_weapon))
{
give(item, -1);
apply_weapon_stats(current_weapon);
p.play_stationary("attachment_" + item + "_attach.ogg", false);
speak(attachment_defs[def_idx].display_name+" attached to "+get_weapon_display_name(current_weapon)+".");
send_reliable(0, "attach "+item+" "+current_weapon, 0);
if(attachment_defs[def_idx].slot=="ammunition")speak(ammunition_display_name(item)+" selected. Existing loaded rounds remain unchanged; the new type is loaded on the next reload.");
else if(attachment_defs[def_idx].slot=="magazine")speak("New capacity: "+effective_magazine_capacity(current_weapon)+" rounds.");
}
}
void equip_holster_item(string item)
{
if(equip_holster1!="" and equip_holster2!="")
{
speak("Both holster slots are full. Remove one first.");
return;
}
int slot=0;
if(equip_holster1=="" and equip_holster2=="")
{
slot=1;
}
else if(equip_holster1=="")
slot=1;
else
slot=2;
// The free slot is the only possible answer, so it is not asked for; this
// used to open a list of both slots and refuse the full one.
give(item, -1);
if(slot==1) equip_holster1=item;
else equip_holster2=item;
p.play_stationary("holster_"+item+"_equip.ogg", false);
int idx=find_holster_def(item);
string dn=(idx>=0)?holster_defs[idx].display_name:string_replace(item,"_"," ",true);
speak(dn+" equipped in holster "+slot+".");
}
void holster_current_weapon()
{
string wname=weapons[w];
if(wname=="" or wname=="empty")
{
draw_from_holster();
return;
}
int[] valid_slots;
for(int s=1; s<=2; s++)
{
string hid=(s==1)?equip_holster1:equip_holster2;
if(hid=="") continue;
string hw=(s==1)?holster1_weapon:holster2_weapon;
if(hw!="") continue;
if(holster_supports_weapon(hid, wname))
valid_slots.insert_last(s);
}
if(valid_slots.length()==0)
{
speak("No empty compatible holster equipped.");
return;
}
int slot=valid_slots[0];
if(valid_slots.length()>1 and is_android())
{
string[] hopts;
for(uint i=0; i<valid_slots.length(); i++)
{
string hid=(valid_slots[i]==1)?equip_holster1:equip_holster2;
int idx=find_holster_def(hid);
string dn=(idx>=0)?holster_defs[idx].display_name:hid;
hopts.insert_last("Holster "+valid_slots[i]+": "+dn);
}
int hs=android_select("Select Holster", hopts);
if(hs<0) return;
slot=valid_slots[hs];
}
else if(valid_slots.length()>1)
{
iw_form sf;
sf.create_window("Select Holster", false, true);
int sl=sf.create_list("Holster", 0, false);
for(uint i=0; i<valid_slots.length(); i++)
{
string hid=(valid_slots[i]==1)?equip_holster1:equip_holster2;
int idx=find_holster_def(hid);
string dn=(idx>=0)?holster_defs[idx].display_name:hid;
sf.add_list_item(sl, "Holster "+valid_slots[i]+": "+dn);
}
int ok=sf.create_button("OK", true);
int cancel=sf.create_button("Cancel", false, true);
sf.focus(sl);
while(true)
{
wait(5);
sf.monitor();
if(sf.is_pressed(cancel)) return;
if(sf.is_pressed(ok))
{
int s=sf.get_list_position(sl);
if(s>=0 and s<int(valid_slots.length()))
{slot=valid_slots[s];break;}
}
}
}
int ammo=ammo_check(wname);
if(ammo<0) ammo=0;
if(slot==1){holster1_weapon=wname;holster1_weapon_ammo=ammo;}
else{holster2_weapon=wname;holster2_weapon_ammo=ammo;}
give(wname, -1);
weapons[w]="empty";
melee=false;
firetime=500;
walktime=200;
string hid=(slot==1)?equip_holster1:equip_holster2;
int idx=find_holster_def(hid);
string dn=(idx>=0)?holster_defs[idx].display_name:hid;
p.play_stationary(wname+"holster.ogg", false);
p.play_stationary("holster_"+hid+"_store.ogg", false);
speak(get_weapon_display_name(wname)+" holstered in "+dn+".");
}
void draw_from_holster()
{
bool h1_has=(holster1_weapon!="");
bool h2_has=(holster2_weapon!="");
if(!h1_has and !h2_has)
{
speak("No weapons holstered.");
return;
}
int slot=0;
if(h1_has and !h2_has) slot=1;
else if(!h1_has and h2_has) slot=2;
else
{
iw_form sf;
sf.create_window("Draw Weapon", false, true);
int sl=sf.create_list("Holstered weapons", 0, false);
string h1_label=holster1_weapon;
int idx1=find_holster_def(equip_holster1);
string dn1=(idx1>=0)?holster_defs[idx1].display_name:equip_holster1;
string label1=dn1+": "+get_weapon_display_name(holster1_weapon)+" ("+holster1_weapon_ammo+" loaded)";
sf.add_list_item(sl, label1);
int idx2=find_holster_def(equip_holster2);
string dn2=(idx2>=0)?holster_defs[idx2].display_name:equip_holster2;
string label2=dn2+": "+get_weapon_display_name(holster2_weapon)+" ("+holster2_weapon_ammo+" loaded)";
sf.add_list_item(sl, label2);
int ok=sf.create_button("OK", true);
int cancel=sf.create_button("Cancel", false, true);
sf.focus(sl);
while(true)
{
wait(5);
sf.monitor();
if(sf.is_pressed(cancel)) return;
if(sf.is_pressed(ok))
{
int s=sf.get_list_position(sl);
if(s==0) slot=1;
else slot=2;
break;
}
}
}
string wname=(slot==1)?holster1_weapon:holster2_weapon;
int ammo=(slot==1)?holster1_weapon_ammo:holster2_weapon_ammo;
int belt_ammo=(slot==1)?holster1_belt_ammo:holster2_belt_ammo;
string hid=(slot==1)?equip_holster1:equip_holster2;
give(wname, 1);
int gi=find_gun(wname);
if(gi>=0) gun_ammos[gi].mag_loaded=ammo;
int idx=find_holster_def(hid);
if(idx>=0 and holster_defs[idx].has_ammo_storage and belt_ammo>0 and gi>=0)
{
int need=gun_ammos[gi].mag_capacity-gun_ammos[gi].mag_loaded;
if(need>0)
{
int reload_amt=(belt_ammo<need)?belt_ammo:need;
gun_ammos[gi].mag_loaded+=reload_amt;
if(slot==1) holster1_belt_ammo-=reload_amt;
else holster2_belt_ammo-=reload_amt;
p.play_stationary("holster_"+hid+"_autoload.ogg", false);
speak(reload_amt+" rounds auto-loaded from belt.");
}
}
if(slot==1){holster1_weapon="";holster1_weapon_ammo=0;}
else{holster2_weapon="";holster2_weapon_ammo=0;}
p.play_stationary("holster_"+hid+"_weapon_remove.ogg", false);
draw_weapon(wname);
}
void show_weapon_info(string wname){show_weapon_info_form(wname);}
string live_weapon_statistics(string wname)
{
wpn_stats@ base=null;
for(uint i=0;i<wpn_cache.length();i++)if(wpn_cache[i].id==wname){@base=wpn_cache[i];break;}
if(@base==null)return "No weapon statistics are registered.";
double min_damage=base.damage,max_damage=base.max_damage,range=base.range,spread=base.projectile_dispersion,velocity=base.muzzle_velocity,drag=base.projectile_drag,retention=base.damage_retention;
int penetration=base.penetration,pellets=base.pellet_count;
string[] attached=get_weapon_attachments(wname);double accuracy=1.0;
for(uint i=0;i<attached.length();i++)
{
string a=attached[i];
if(a=="long_barrel")velocity*=1.12;else if(a=="short_barrel")velocity*=.9;else if(a=="match_grade_barrel")velocity*=1.05;else if(a=="heavy_barrel")velocity*=1.04;else if(string_contains(a,"suppressor",1)>=0){velocity*=.94;drag*=1.03;retention*=.97;}
if(a=="red_dot_sight")accuracy*=.92;else if(a=="holographic_sight")accuracy*=.9;else if(a=="two_power_optic")accuracy*=.86;else if(a=="four_power_optic")accuracy*=.75;else if(a=="eight_power_scope")accuracy*=.62;else if(a=="thermal_scope")accuracy*=.72;else if(a=="vertical_grip")accuracy*=.88;else if(a=="angled_grip")accuracy*=.82;else if(a=="bipod")accuracy*=.65;else if(a=="laser_aiming_module")accuracy*=.9;else if(a=="weapon_light")accuracy*=.96;else if(a=="lightweight_stock")accuracy*=1.08;else if(a=="precision_stock")accuracy*=.78;else if(a=="recoil_buffer_stock")accuracy*=.86;else if(a=="muzzle_brake")accuracy*=.9;else if(a=="compensator")accuracy*=.86;else if(a=="choke_full")accuracy*=.92;else if(a=="choke_improved")accuracy*=.96;
}
int gi=find_gun(wname);string loaded=gi>=0?gun_ammos[gi].loaded_ammunition:"standard_ammunition";
string active_mode=has_fire_modes(wname)?fire_mode_name(get_fire_mode(wname)):"fixed";
if(active_mode=="scattershot"){pellets=base.wclass=="shotgun"?base.pellet_count+4:5;spread*=1.65;}
else if(active_mode=="focused"){pellets=1;spread*=.25;}
if(string_contains(loaded,"plus_p",1)>=0){velocity*=1.1;min_damage*=1.08;max_damage*=1.08;}
if(string_contains(loaded,"subsonic",1)>=0){velocity*=.76;drag*=1.18;min_damage*=.9;max_damage*=.9;}
if(string_contains(loaded,"match",1)>=0){velocity*=1.06;retention*=1.08;accuracy*=.7;}
if(string_contains(loaded,"_ap",1)>=0 or string_contains(loaded,"m855a1",1)>=0 or string_contains(loaded,"bodkin",1)>=0 or string_contains(loaded,"barrikada",1)>=0 or string_contains(loaded,"flechette",1)>=0 or string_contains(loaded,"_ion",1)>=0){velocity*=1.04;penetration+=2;min_damage*=.94;max_damage*=.94;}
if(string_contains(loaded,"jhp",1)>=0 or string_contains(loaded,"expanding",1)>=0 or string_contains(loaded,"softpoint",1)>=0 or string_contains(loaded,"broadhead",1)>=0){min_damage*=1.2;max_damage*=1.2;penetration=0;retention*=.84;}
if(string_contains(loaded,"hardcast",1)>=0){penetration+=2;retention*=1.12;}
if(string_contains(loaded,"frangible",1)>=0 or string_contains(loaded,"wadcutter",1)>=0){min_damage*=1.12;max_damage*=1.12;penetration=0;drag*=1.25;}
if(string_contains(loaded,"breaching",1)>=0){min_damage*=1.3;max_damage*=1.3;range*=.55;drag*=1.4;}
if(string_contains(loaded,"overcharge",1)>=0){velocity*=1.22;min_damage*=1.28;max_damage*=1.28;}
if(loaded=="12g_slug" or loaded=="23mm_barrikada"){pellets=1;accuracy*=.24;penetration+=2;}else if(loaded=="12g_number4_buck"){pellets=18;accuracy*=1.3;}else if(loaded=="12g_flechette"){pellets=12;accuracy*=.72;}else if(string_contains(loaded,"shotshell",1)>=0){pellets=7;spread=5.2;}else if(string_contains(loaded,"_scatter",1)>=0){pellets=5;spread=2.4;}
if(active_mode=="focused"){min_damage*=1.5;max_damage*=1.5;range*=1.3;velocity*=1.15;}
weapon_handling_state@ live_handling=handling_state(wname);string live_class=get_weapon_class(wname);
double condition_output=(.65+.35*double(live_handling.mechanical_condition)/100.0)*(1.0-double(live_handling.permanent_damage)/180.0);min_damage*=condition_output;max_damage*=condition_output;velocity*=.75+.25*double(live_handling.mechanical_condition)/100.0;spread*=1.0+double(100-live_handling.alignment+live_handling.permanent_damage)/100.0;range*=.8+.2*double(live_handling.alignment)/100.0;
if(live_handling.configuration==1 and (live_class=="submachine_gun" or live_class=="battle_rifle" or live_class=="sniper_rifle" or live_class=="light_machine_gun" or live_class=="archery"))accuracy*=.62;
if(live_class=="light_machine_gun" and live_handling.configuration==2 and live_handling.wall_braced)accuracy*=.68;
if(live_class=="assault_rifle"){if(live_handling.configuration==1)accuracy*=1.12;else if(live_handling.configuration==2)accuracy*=.82;}
if((live_class=="melee_short_blade" or live_class=="melee_long_blade" or live_class=="melee_blunt") and live_handling.configuration==1){min_damage*=1.42;max_damage*=1.42;}else if((live_class=="melee_short_blade" or live_class=="melee_long_blade" or live_class=="melee_blunt") and live_handling.configuration==2){min_damage*=.76;max_damage*=.76;penetration++;}
spread*=accuracy;
int attached_fire_interval=int(double(base.firetime)*get_attachment_firetime_mult(wname));
string report="Live loaded configuration\nFire mode: "+active_mode+"\nAmmunition: "+ammunition_display_name(loaded)+"\nDamage: "+int(min_damage)+(int(min_damage)!=int(max_damage)?" to "+int(max_damage):"")+"\nRange: "+int(range)+" tiles\nDispersion: "+round(spread,2)+" degrees\nMuzzle velocity: "+round(velocity,2)+" tiles per second\nDrag: "+round(drag,4)+"\nDamage retention: "+int(retention*100)+" percent\nPenetration: "+penetration+"\nProjectiles per shot: "+pellets+"\nFire interval: "+handling_fire_interval(wname,attached_fire_interval)+" milliseconds\nMovement interval: "+int(double(base.walktime)*get_attachment_walktime_mult(wname)*handling_movement_penalty(wname))+" milliseconds\nHandling: "+weapon_handling_status(wname);
if(gi>=0)report+="\nLoaded: "+gun_ammos[gi].mag_loaded+" of "+gun_ammos[gi].mag_capacity+"\nSelected for next reload: "+ammunition_display_name(selected_ammunition_for_weapon(wname));
return report;
}

void show_weapon_info_form(string wname)
{
int gi=find_gun(wname);string stats=live_weapon_statistics(wname);
if(is_energy_weapon(wname)) stats+="\nDurability: "+get_durability(wname)+"%";
stats+="\n\nBase weapon reference:\n"+content_weapon_details(wname);
string[] attached=get_weapon_attachments(wname);
nv_form f; f.create_window(get_weapon_display_name(wname)+" Weapon Panel",false,true);
nv_form_input@ stats_control=f.add_input("Weapon statistics","weapon_stats",stats,"",0,true,true);
nv_form_list_box@ attachments_control=null;
nv_form_button@ remove_control=null;
if(attached.length()>0)
{
@attachments_control=f.add_list("Installed attachments","attachments",false,{},0,-1,true);
for(uint i=0;i<attached.length();i++)
{
int di=find_attachment_def(attached[i]);
if(di<0) continue;
string label=attachment_defs[di].display_name+" ("+attachment_defs[di].slot+")";
if(!attachment_defs[di].removable) label+=" [permanent]";
attachments_control.add(label,attached[i]);
}
@remove_control=f.add_button("Remove selected attachment","remove");
}
nv_form_button@ close=f.add_button("Close","close",false,true); f.focus_control(stats_control);
while(true)
{
wait(5); f.monitor(); if(connected) netloop();
if(f.is_pressed(close)) return;
if(@remove_control!=null and f.is_pressed(remove_control) and @attachments_control!=null)
{
int sel=attachments_control.list_position;
if(sel<0 or sel>=int(attachments_control.items.length())) continue;
string attachment_id=attachments_control.items[sel].id;
int di=find_attachment_def(attachment_id);
if(di<0) continue;
if(!attachment_defs[di].removable) speak("This attachment cannot be removed.");
else if(detach_from_weapon(attachment_id,wname))
{
give(attachment_id,1); apply_weapon_stats(wname);
p.play_stationary("attachment_"+attachment_id+"_remove.ogg",false);
send_reliable(0,"detach "+attachment_id+" "+wname,0);
speak(attachment_defs[di].display_name+" removed and returned to inventory.");
return;
}
}
}
}

string[] hypercomp_fetch_bunkers()
{
string[] result;
send_reliable(0, "hypercomp query_bunkers", 0);
timer ct;
while(ct.elapsed<3000)
{
wait(5);
e=n.request();
if(e.type==event_receive)
{
string msg=get_event_message();
if(string_contains(msg, "hypercomp_bunkers ", 1)==0)
{
string data=string_replace(msg, "hypercomp_bunkers ", "", false);
if(data!="none")
result=string_split(data, ",", false);
break;
}
}
}
return result;
}
void hypercomp_menu()
{
p.play_stationary("hypercomp_activate.ogg", false);
iw_form f;
f.create_window("HyperComp", false, true);
int f_status=f.create_button("View &bunker status");
int f_monitor=f.create_button("Toggle &monitor mode");
int f_c4=f.create_button("&C4 management");
int f_alarm=f.create_button("Toggle bunker &alarm");
int f_close=f.create_button("Cl&ose", true, true);
f.focus(f_status);
while(true)
{
wait(5);
f.monitor();
if(connected==true) netloop();
if(f.is_pressed(f_status))
{
p.play_stationary("hypercomp_status.ogg", false);
send_reliable(0, "hypercomp bunker_status", 0);
}
else if(f.is_pressed(f_monitor))
{
p.play_stationary("hypercomp_monitor.ogg", false);
hypercomp_monitor_menu();
}
else if(f.is_pressed(f_c4))
{
p.play_stationary("hypercomp_c4.ogg", false);
hypercomp_c4_menu();
}
else if(f.is_pressed(f_alarm))
{
p.play_stationary("hypercomp_alarm.ogg", false);
hypercomp_alarm_menu();
}
else if(f.is_pressed(f_close))
return;
}
}
void hypercomp_c4_menu()
{
send_reliable(0, "hypercomp c4_count", 0);
speak("Checking C4 charges, please wait.");
int c4count=-1;
timer ct;
while(ct.elapsed<3000)
{
wait(5);
e=n.request();
if(e.type==event_receive)
{
string msg=get_event_message();
if(string_contains(msg, "hypercomp_c4 ", 1)==0)
{
c4count=string_to_number(string_replace(msg, "hypercomp_c4 ", "", false));
break;
}
}
}
if(c4count<0)
{
speak("Could not retrieve C4 data.");
return;
}
iw_form f;
f.create_window("C4 Management", false, true);
f.create_input_box("Active C4 charges", ""+c4count, "", 0, false, true, false);
int f_det=f.create_button("&Detonate");
int f_close=f.create_button("&Close", true, true);
f.focus(f_det);
while(true)
{
wait(5);
f.monitor();
if(connected==true) netloop();
if(f.is_pressed(f_det))
{
if(c4count<=0)
{
speak("No C4 charges placed.");
continue;
}
iw_form d;
d.create_window("Detonate C4", false, true);
int d_count=d.create_input_box("How many to detonate (max "+c4count+")", ""+c4count, "", 0, false, false, false);
int d_go=d.create_button("&Detonate", true);
int d_cancel=d.create_button("&Cancel", false, true);
d.focus(d_count);
while(true)
{
wait(5);
d.monitor();
if(connected==true) netloop();
if(d.is_pressed(d_go))
{
string val=d.get_text(d_count);
int num=string_to_number(val);
if(num<1) num=1;
if(num>c4count) num=c4count;
send_reliable(0, "hypercomp detonate_c4 "+num, 0);
break;
}
if(d.is_pressed(d_cancel))
break;
}
return;
}
if(f.is_pressed(f_close))
return;
}
}
void hypercomp_monitor_menu()
{
speak("Fetching bunker data, please wait.");
string[] bdata=hypercomp_fetch_bunkers();
if(bdata.length()==0)
{
speak("You don't own any bunkers.");
return;
}
iw_form f;
f.create_window("Bunker Monitor", false, true);
int f_list=f.create_list("Select a bunker to toggle monitor mode", 0, false);
string[] bunker_ids;
for(uint i=0; i<bdata.length(); i++)
{
string[] parts=string_split(bdata[i], "|", false);
if(parts.length()<7) continue;
string bname=parts[1];
string mon_status=(parts[5]=="1" ? "ON" : "OFF");
f.add_list_item(f_list, bname+" at "+parts[2]+", "+parts[3]+", "+parts[4]+" - Monitor: "+mon_status);
bunker_ids.insert_last(parts[0]);
}
int f_toggle=f.create_button("&Toggle monitor");
int f_close=f.create_button("&Close", true, true);
f.focus(f_list);
while(true)
{
wait(5);
f.monitor();
if(connected==true) netloop();
if(f.is_pressed(f_toggle))
{
int sel=f.get_list_position(f_list);
if(sel>=0 and sel<int(bunker_ids.length()))
{
send_reliable(0, "hypercomp toggle_monitor "+bunker_ids[sel], 0);
return;
}
}
if(f.is_pressed(f_close))
return;
}
}
