// A corpse holds whatever its owner carried when they fell. The client reports
// its inventory and worn equipment as it dies (corpse_inventory) and the
// server adds the armour it already tracks. Walking over the body picks up its
// corpse token; using the token searches the body and takes everything.
//
// Corpses used to be built from a server-side inventory that nothing ever
// filled, so every body in the game was empty, and only four deaths in five
// left one at all.
corpse@[] corpses(0);
const int corpse_lifetime_ms=1800000;
const int corpse_entry_limit=400;
class corpse
{
string id,owner,map;
dictionary inv;
int entries=0;
int x,y,z;
timer age;
}
string generate_corpse_id(){string result="c";for(int i=0;i<10;i++)result+=random(0,9);return result;}
int find_corpse(string id){for(uint i=0;i<corpses.length();i++)if(corpses[i].id==id)return int(i);return -1;}
void corpse_add(corpse@ c,string item,int amount)
{
if(amount<=0 or item=="" or item=="none" or c.entries>=corpse_entry_limit)return;
int have=0;if(!c.inv.get(item,have))c.entries++;c.inv.set(item,have+amount);
}
// Every body is a corpse now. Worn armour goes in straight away; the client's
// own report follows within a moment.
string spawn_corpse(player@ p)
{
corpse c;c.id=generate_corpse_id();c.owner=p.name;c.x=p.x;c.y=p.y;c.z=p.z;c.map=p.map;
corpse_add(c,p.armor_head,1);corpse_add(c,p.armor_torso,1);corpse_add(c,p.armor_arms,1);corpse_add(c,p.armor_legs,1);
string[] physical=p.physical_items.get_keys();for(uint i=0;i<physical.length();i++)corpse_add(c,physical[i],physical_count(p,physical[i]));corpse_add(c,"credit_chip_small",p.er_small_chips);corpse_add(c,"credit_chip_large",p.er_large_chips);
corpses.insert_last(c);spawn_citem(p.x,p.y,p.z,p.map,"corpse_"+c.id);return c.id;
}
// A corpse_inventory packet is "item:count|item:count|..." and may arrive in
// several parts. Only the player whose body it is, and only while that body is
// still waiting for them, can add to it.
void fill_corpse(player@ p,string data)
{
if(p.pending_corpse=="")return;int ci=find_corpse(p.pending_corpse);if(ci<0){p.pending_corpse="";return;}
string[] entries=string_split(data,"|",true);
for(uint e=0;e<entries.length();e++)
{
string[] part=string_split(entries[e],":",false);if(part.length()!=2)continue;
string item=part[0];int amount=string_to_number(part[1]);
if(amount<=0 or amount>100000 or item.length()>80 or string_contains(item,"__partial__",1)>=0 or string_contains(item,"corpse_",1)==0 or physical_tracked(item))continue;
corpse_add(corpses[ci],item,amount);
}
}
void remove_corpse_token(string id){for(int i=int(citems.length())-1;i>=0;i--)if(citems[i].name=="corpse_"+id)citems.remove_at(i);}
// A revived player did not die: their body, and everything copied into it,
// disappears again.
void withdraw_corpse(player@ p)
{
if(p.pending_corpse=="")return;int ci=find_corpse(p.pending_corpse);if(ci>=0){remove_corpse_token(corpses[ci].id);corpses.remove_at(ci);}p.pending_corpse="";
}
void corpse_expiry_loop(){for(int i=int(corpses.length())-1;i>=0;i--)if(corpses[i].age.elapsed>=corpse_lifetime_ms){remove_corpse_token(corpses[i].id);corpses.remove_at(i);}}
void open_corpse(string id,int index)
{
int ci=find_corpse(id);
if(ci<0){send_reliable(players[index].peer_id,"give corpse_"+id+" -1",0);send_reliable(players[index].peer_id,"That body has already been searched or has decayed.",2);return;}
corpse@ c=corpses[ci];
// While its owner lies downed they can still be revived, and a revive takes
// the body back. Searching it now would duplicate everything they carry.
int owner=get_player_index_from(c.owner);
if(owner>=0 and players[owner].death and players[owner].pending_corpse==c.id){send_reliable(players[index].peer_id,c.owner+" is down but can still be revived. Search the body once they are gone.",2);return;}
world_sound_at("collectable/loot_corpse",c.x,c.y,c.z,c.map);
string[] keys=c.inv.get_keys();string listing="";
for(uint k=0;k<keys.length();k++){int amount=0;c.inv.get(keys[k],amount);if(amount<=0)continue;send_reliable(players[index].peer_id,"give "+keys[k]+" "+amount,0);if(listing!="")listing+=", ";listing+=amount+" "+string_replace(keys[k],"_"," ",true);}
send_reliable(players[index].peer_id,"give corpse_"+id+" -1",0);
send_reliable(players[index].peer_id,listing==""?"You search "+c.owner+"'s body and find nothing.":"You search "+c.owner+"'s body and take "+listing+".",2);
corpses.remove_at(ci);
}
