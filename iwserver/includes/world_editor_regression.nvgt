// World editor server regression. Drives the real request handler with a
// developer player and checks what reaches the disk: a new map, batched
// edits, undo and redo, map properties, lobby listing, content files and
// reloading. Run with iwserver/world_editor_regression_runner.nvgt from the
// iwserver folder; results go to administration/world_editor_regression.txt.
// Everything it makes is removed again at the end.
string wer_results;int wer_failures=0;
void wer_check(bool ok,const string &in label){wer_results+=(ok?"PASS ":"FAIL ")+label+"\n";if(!ok)wer_failures++;}
void run_world_editor_regression()
{
load_wpn_stats();
init_mapsystem();
load_item_catalogue();
wer_check(indexed_map_path("battlegrounds")!="","Shattersea is found by its id, not only by its file name");
wer_check(indexed_map_path("freeforall")!="" and map_listed("freeforall") and map_title("battlegrounds")=="Shattersea","the original maps are indexed, listed and titled");
player tester(50,50,0,"freeforall","wer_tester",1);
tester.dev=true;
players.insert_last(tester);
int idx=int(players.length())-1;
// Arena lifecycle. This exercises the same authoritative transfer routine
// used by the Start button and confirms that its return snapshot survives.
player arena_guest(55,55,0,"freeforall","arena_guest",2);players.insert_last(arena_guest);int guest_idx=int(players.length())-1;
players[idx].health=700;players[idx].armor_torso="plate_carrier";players[idx].armor_torso_durability=600;players[idx].weapon_attachment_state.set("ak47","suppressor");players[idx].suppressed_weapons.insert_last("ak47");
arena_instance arena_test(9000,players[idx].name,"open");arena_test.members.insert_last(arena_member(players[guest_idx].name,"combatant"));arenas.insert_last(arena_test);players[idx].arena_id=9000;players[idx].arena_role="combatant";players[guest_idx].arena_id=9000;players[guest_idx].arena_role="combatant";
arena_start(arenas[arenas.length()-1]);
wer_check(arenas[arenas.length()-1].state=="active" and players[idx].map=="arena_open_instance_9000" and players[guest_idx].map=="arena_open_instance_9000","arena start transfers every combatant to its instanced map");
wer_check(get_map_index("arena_open_instance_9000")>=0 and maps[get_map_index("arena_open_instance_9000")].rawdata.find("mapname:arena_open_instance_9000")>=0,"arena instance has loadable geometry and the correct client map identity");
wer_check(players[idx].health==1000 and players[idx].armor_torso=="" and players[idx].weapon_attachment_state.get_size()==0 and players[idx].suppressed_weapons.length()==0,"arena loadout clears ordinary health, armour and attachment advantages");
arena_instance concurrent(9002,"absent_host","open");arenas.insert_last(concurrent);arena_start(arenas[arenas.length()-1]);
wer_check(get_map_index("arena_open_instance_9002")>=0 and players[idx].map!="arena_open_instance_9002","simultaneous arenas of the same type occupy separate maps");
arena_close(arena_index(9002));wer_check(get_map_index("arena_open_instance_9002")<0 and get_map_index("arena_open_instance_9000")>=0,"closing one instance does not remove another match's map");
wer_check(players[idx].arena_return_map=="freeforall" and players[guest_idx].arena_return_map=="freeforall","arena start remembers both return locations");
wer_check(arena_overview(players[idx]).find("arena_overview 9000~active~combatant~wer_tester")==0,"arena overview reports live role, state and host");
arena_return_player(players[idx]);arena_return_player(players[guest_idx]);
wer_check(players[idx].map=="freeforall" and int(players[idx].x)==50 and players[guest_idx].map=="freeforall" and int(players[guest_idx].x)==55,"arena exit restores exact maps and coordinates");
wer_check(players[idx].health==700 and players[idx].armor_torso=="plate_carrier" and players[idx].armor_torso_durability==600 and server_weapon_has_attachment(players[idx],"ak47","suppressor") and players[idx].suppressed_weapons.length()==1,"arena exit restores original health, armour durability and suppressor state");
arena_close(arena_index(9000));wer_check(get_map_index("arena_open_instance_9000")<0,"arena close releases its temporary map");players.remove_at(guest_idx);
arena_instance solo(9001,players[idx].name,"melee");arenas.insert_last(solo);players[idx].arena_id=9001;players[idx].arena_role="combatant";arena_start(arenas[arenas.length()-1]);
wer_check(arenas[arenas.length()-1].state=="active" and arenas[arenas.length()-1].practice and players[idx].map=="arena_melee_instance_9001","a lone combatant can start an arena to practise");
wer_check(arena_on_death(players[idx]) and arenas[arenas.length()-1].state=="active" and players[idx].arena_role=="combatant" and !players[idx].death,"a practice death respawns the combatant instead of ending the arena");
arena_player_gone(players[idx]);wer_check(arena_index(9001)<0 and players[idx].arena_id==0,"the host leaving closes their arena");arena_return_player(players[idx]);
// A new map.
if(indexed_map_path("wer_test")!=""){file_delete(indexed_map_path("wer_test"));index_map_files();}
handle_world_editor_request(1,"we_create|wer_test|Regression Town|80|60|20|grass|grass");
string path=indexed_map_path("wer_test");
wer_check(path!="" and file_exists(path),"we_create writes a new map file");
wer_check(get_map_index("wer_test")>=0,"the new map is loaded without a restart");
wer_check(!map_listed("wer_test"),"a new map starts unlisted");
wer_check(lobby_map_list(false).find("wer_test")<0 and lobby_map_list(true).find("wer_test")>=0,"unlisted maps show in the lobby only for builders");
// Travel there, then edit.
handle_world_editor_request(1,"we_travel|wer_test|10|10|0");
wer_check(players[idx].map=="wer_test" and int(players[idx].x)==10,"we_travel moves the player to the other map");
string before=read_whole_file(path);
handle_world_editor_request(1,"we_append|built a test street|tile:5:20:5:12:0:0:asphalt\nzone:5:20:5:12:0:8:Test Street");
string after=read_whole_file(path);
wer_check(after.find("zone:5:20:5:12:0:8:Test Street")>=0,"we_append writes a batch of lines");
handle_world_editor_request(1,"we_append|a bad line|tile:5:4:5:12:0:0:asphalt");
wer_check(read_whole_file(path)==after,"an invalid line is refused and nothing is written");
handle_world_editor_request(1,"we_undo");
wer_check(read_whole_file(path)==before,"undo restores the map before the street");
handle_world_editor_request(1,"we_redo");
wer_check(read_whole_file(path)==after,"redo puts the street back");
// Replace and delete by line number.
string[] lines=delinear(read_whole_file(path));
int zone_row=-1;for(uint i=0;i<lines.length();i++)if(lines[i]=="zone:5:20:5:12:0:8:Test Street")zone_row=i;
handle_world_editor_request(1,"we_replace|renamed it|"+zone_row+"|zone:5:20:5:12:0:8:Renamed Street");
wer_check(read_whole_file(path).find("Renamed Street")>=0,"we_replace edits one line");
lines=delinear(read_whole_file(path));
for(uint i=0;i<lines.length();i++)if(lines[i].find("Renamed Street")>=0)zone_row=i;
handle_world_editor_request(1,"we_delete|deleted it|"+zone_row);
wer_check(read_whole_file(path).find("Renamed Street")<0,"we_delete removes lines by number");
// Properties.
handle_world_editor_request(1,"we_meta|title|Regression City");
handle_world_editor_request(1,"we_meta|listed|true");
handle_world_editor_request(1,"we_meta|summary|a map made by the regression test");
wer_check(map_title("wer_test")=="Regression City" and map_listed("wer_test"),"we_meta sets the title and lobby listing");
wer_check(lobby_map_list(false).find("a map made by the regression test")>=0,"a listed map shows in everyone's lobby with its description");
wer_check(builder_map_valid(read_whole_file(path),"wer_test"),"the edited map is still valid");
// Content files.
handle_world_editor_request(1,"we_content_write|items|utility|wer_test_item|name=Regression Widget\ncategory=Utility\nsummary=A test.\ngive_amount=3");
wer_check(item_info("wer_test_item") !is null and item_info("wer_test_item").give_amount==3,"we_content_write writes an item and the server reloads it");
handle_world_editor_request(1,"we_content_write|items|utility|wer_test_bad|no equals sign here");
wer_check(content_path("items","wer_test_bad")=="","a malformed content file is refused");
handle_world_editor_request(1,"we_content_delete|items|wer_test_item");
wer_check(item_info("wer_test_item") is null and content_path("items","wer_test_item")=="","we_content_delete removes it and reloads");
wer_check(item_sync_blob().find("plate_carrier")>=0,"the item sync carries every item file");
handle_world_editor_request(1,"we_content_write|vehicles|test|wer_test_vehicle|name=Regression Rover\nhealth=900\narmour=100\nseats=2\nwindows=true,false\ntop_speed=10\nacceleration=3\nbraking=5\nfuel_type=diesel\nfuel_capacity=90\nfuel_per_tile=0.15");
wer_check(content_path("vehicles","wer_test_vehicle")!="" and vehicle_sync_blob().find("Regression Rover")>=0,"vehicle content is editable and included in live synchronization");
handle_world_editor_request(1,"we_content_delete|vehicles|wer_test_vehicle");
wer_check(content_path("vehicles","wer_test_vehicle")=="","vehicle content deletion removes the authoritative file");
// Permission.
players[idx].dev=false;players[idx].admin=false;
string title_before=map_title("wer_test");
handle_world_editor_request(1,"we_meta|title|Should Not Change");
wer_check(map_title("wer_test")==title_before,"requests without building permission are refused");
// Clean up.
players.remove_at(idx);
string dir="content/maps/wer_test";
file_delete(path);directory_delete(dir);
index_map_files();
for(int i=int(maps.length())-1;i>=0;i--)if(maps[i].name=="wer_test")maps.remove_at(i);
wer_check(indexed_map_path("wer_test")=="","the test map is removed");
wer_results+="Failures: "+wer_failures+"\n";
directory_create("administration");
file f;f.open("administration/world_editor_regression.txt","wb");f.write(wer_results);f.close();
}
