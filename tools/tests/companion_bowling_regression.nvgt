string motion_results;int motion_failures=0;
void motion_check(bool ok,string label){motion_results+=(ok?"PASS ":"FAIL ")+label+"\n";if(!ok)motion_failures++;}
void motion_tile(mapdata@ m,int x1,int x2,int y1,int y2,int z1,int z2,string material="concrete")
{
maptile t;t.minx=x1;t.maxx=x2;t.miny=y1;t.maxy=y2;t.minz=z1;t.maxz=z2;t.type=material;
m.maptiles.insert_last(t);m.tile_grid.add(x1,x2,y1,y2,z1,z2);
}
mapdata@ motion_map(string id)
{
mapdata@ m=mapdata("freeforall");m.name=id;m.size_x=400;m.size_y=400;m.size_z=100;m.maptiles.resize(0);m.tile_grid.clear();m.objects.list.resize(0);m.objects.index();maps.insert_last(m);return m;
}
void run_companion_bowling_regression()
{
string dir=DIRECTORY_LOCAL_APPDATA+"/Temp/IW-motion-regression-"+random(100000,999999999);directory_create(dir);
try
{
load_item_catalogue();load_dobject_types(dobject_data_directory());init_mapsystem();load_wpn_stats();
mapdata@ flat=motion_map("motion_flat");motion_tile(flat,0,400,0,400,0,0);
mapdata@ ramp=motion_map("motion_ramp");for(int x=0;x<=60;x++)motion_tile(ramp,x,x,0,100,x,x);
mapdata@ ledge=motion_map("motion_ledge");motion_tile(ledge,0,20,0,100,5,5);motion_tile(ledge,21,400,0,100,0,0);
player body(200,200,0,"motion_flat","motion_owner",1);players.insert_last(body);player@ owner=players[0];
deploy_companion(0,"auto_hover_drone");motion_check(companions.length()==1,"deployment creates an owned persistent actor");
companion_actor@ c=companions[0];c.x=20;c.y=20;c.z=2;c.facing=0;
handle_companion_command(1,"companion pilot "+c.id+" now");motion_check(c.piloted and companion_body_controlled(owner.name),"piloting is tracked by the server");
handle_companion_command(1,"companion input "+c.id+" 100 100 100 100");motion_check(c.input_forward==1 and c.input_side==1 and c.input_vertical==1 and c.input_turn==1,"pilot inputs are clamped rather than accepting coordinates");
double bx=owner.x,by=owner.y,bz=owner.z;companion_pilot_step(c,.1);
motion_check(owner.x==bx and owner.y==by and owner.z==bz,"piloting never changes body coordinates");
motion_check(sqrt((c.x-20)*(c.x-20)+(c.y-20)*(c.y-20)+(c.z-2)*(c.z-2))<=c.speed*.1+.001,"diagonal pilot movement respects authored speed");
double cx=c.x;handle_companion_command(1,"companion move "+c.id+" 300 300 90 0");motion_check(c.x==cx,"legacy absolute-coordinate teleport requests are ignored");
handle_companion_command(1,"companion stop");motion_check(!c.piloted and !companion_body_controlled(owner.name),"return-to-body ends server control");
handle_companion_command(1,"companion mode "+c.id+" guard");motion_check(c.mode=="guard" and c.guard_x==c.x and c.guard_y==c.y,"guard orders capture an anchor");
player intruder(25,25,0,"motion_flat","motion_intruder",2);players.insert_last(intruder);
handle_companion_command(2,"companion pilot "+c.id+" now");motion_check(!c.piloted,"another player cannot pilot an owned actor");
handle_companion_command(1,"companion pilot "+c.id+" now");c.input_forward=1;c.input_timer.restart();wait(260);cx=c.x;double cy=c.y;companion_pilot_step(c,.1);motion_check(c.x==cx and c.y==cy,"stale input stops movement when a form opens or packets stop");
handle_companion_command(1,"companion stop");
c.kind="chimp";c.x=10;c.y=10;c.z=0;companion_move_step(c,1,0,20);motion_check(c.z==0,"chimps remain grounded even when vertical movement is requested");
motion_tile(flat,12,12,0,400,1,10,"concretewall");c.x=10;c.y=10;c.z=1;c.kind="drone";companion_move_step(c,5,0,0);motion_check(c.x<12,"swept companion movement does not pass through a wall");
flat.maptiles.resize(0);flat.tile_grid.clear();motion_tile(flat,0,400,0,400,0,0);
end_spawn_grace(owner);end_spawn_grace(players[1]);
int health=c.health;weapon round_hit(c.x,c.y,c.z-.8,0,90,"glock17",players[1].name,"motion_flat");
motion_check(projectile_hit_companion(round_hit) and c.health<health,"hostile projectiles damage actors through the real weapon collision path");
health=c.health;blast_profile@ blast=blast_profile_for("frag_grenade",players[1].name);companion_blast_damage(c.x,c.y,c.z,c.map,blast);
motion_check(c.health<health,"explosions damage companions");
players[1].arena_role="spectator";motion_check(!companion_damage_allowed(c,players[1].name),"spectators cannot damage actors");players[1].arena_role="";
c.health=0;companion_loop();motion_check(companions.length()==0,"destroyed actors are removed and cannot retain a pilot");
fraggrenade bomb(20,20,0,90,"motion_flat",owner.name,"bowling_bomb",false,90);bomb.z=.28;bomb.vx=5;bomb.vy=0;bomb.vz=0;bomb.rolling_grounded=true;
motion_check(bomb.momentum_rolling and bomb.rolling_range>=90 and bomb.rolling_range<=120,"bowling bomb uses authored range physics");
double speed=bomb.vx;bowling_bomb_step(bomb,.05);motion_check(bomb.vx>speed,"level-ground rolling gains momentum");
double initial_power=bowling_bomb_power(bomb);bomb.rolling_distance=80;bomb.vx=20;motion_check(bowling_bomb_power(bomb)>initial_power,"travel distance and impact speed increase blast damage");
bomb.rolling_distance=0;bomb.rolling_range=90;
for(int i=0;i<10000 and !bomb.rolling_detonate;i++)bowling_bomb_step(bomb,.005);
motion_check(bomb.rolling_detonate and bomb.rolling_distance>=90 and bomb.rolling_distance<90.2,"bomb detonates at its path-length budget without waiting for a fuse");
fraggrenade uphill(5,20,5,90,"motion_ramp",owner.name,"bowling_bomb",false);uphill.z=5.28;uphill.vx=3;uphill.vy=0;uphill.vz=0;uphill.rolling_grounded=true;
for(int i=0;i<160;i++)bowling_bomb_step(uphill,.005);
motion_check(!uphill.rolling_detonate and uphill.vx<0 and uphill.x<5.5,"a bomb thrown uphill reverses and rolls downhill");
fraggrenade falling(19,20,5,90,"motion_ledge",owner.name,"bowling_bomb",false);falling.z=5.28;falling.vx=8;falling.vy=0;falling.vz=0;falling.rolling_grounded=true;
bool airborne=false,landed=false;double before_landing=0,after_landing=0;
for(int i=0;i<1000 and !falling.rolling_detonate;i++){bool old_ground=falling.rolling_grounded;double old_speed=falling.vx;bowling_bomb_step(falling,.005);if(!falling.rolling_grounded and falling.vz<0)airborne=true;if(!old_ground and falling.rolling_grounded){landed=true;before_landing=old_speed;after_landing=falling.vx;break;}}
motion_check(airborne and landed and falling.bounces==1,"ledge departures arc downward and produce one landing event");
motion_check(after_landing<before_landing,"landing reduces momentum");
speed=falling.vx;for(int i=0;i<40;i++)bowling_bomb_step(falling,.005);motion_check(falling.vx>speed,"a landed bomb resumes gaining speed");
owner.x=40;owner.y=20;owner.z=0;fraggrenade returning(42,20,0,270,"motion_flat",owner.name,"bowling_bomb",false);returning.z=.28;returning.vx=-8;returning.vy=0;returning.vz=0;returning.rolling_grounded=true;returning.owner_cleared=true;
for(int i=0;i<200 and !returning.rolling_detonate;i++)bowling_bomb_step(returning,.005);
motion_check(returning.rolling_detonate and returning.rolling_distance<3,"a returning bomb collides with its thrower");
owner.x=200;owner.y=200;fraggrenade dodge(42,20,0,270,"motion_flat",owner.name,"bowling_bomb",false);dodge.z=.28;dodge.vx=-8;dodge.vy=0;dodge.vz=0;dodge.rolling_grounded=true;dodge.owner_cleared=true;
for(int i=0;i<80;i++)bowling_bomb_step(dodge,.005);motion_check(!dodge.rolling_detonate and dodge.x<40,"dodging permits the bomb to pass and continue in reverse");
motion_tile(flat,45,45,0,400,1,5,"concretewall");fraggrenade impact(44,20,1,90,"motion_flat",owner.name,"bowling_bomb",false);impact.z=1;impact.vx=10;impact.vy=0;impact.vz=0;
for(int i=0;i<80 and !impact.rolling_detonate;i++)bowling_bomb_step(impact,.005);motion_check(impact.rolling_detonate,"wall impact detonates instead of bouncing");
fraggrenades.resize(0);pin_grenade(1,"bowling_bomb");motion_check(fraggrenades.length()==0,"rolling bombs cannot accidentally arm an ordinary grenade fuse");
players.remove_at(1);deploy_companion(0,"auto_hover_drone");owner.death=true;companion_loop();motion_check(companions.length()==0,"body death removes companions and ends control");owner.death=false;
dobject@ obstacle=new_dobject(100001,"coke_machine",55,20,0,0,"motion_flat","Test vending machine");
if(obstacle !is null){flat.objects.list.insert_last(obstacle);flat.objects.index();fraggrenade object_hit(52,20,0,90,"motion_flat",owner.name,"bowling_bomb",false);object_hit.z=.28;object_hit.vx=10;object_hit.vy=0;object_hit.vz=0;object_hit.rolling_grounded=true;
for(int i=0;i<120 and !object_hit.rolling_detonate;i++)bowling_bomb_step(object_hit,.005);motion_check(object_hit.rolling_detonate,"fixture impact detonates the bomb");}else motion_check(false,"fixture test has a valid object definition");
fraggrenades.resize(0);
fraggrenade chain_a(70,20,0,90,"motion_flat",owner.name,"bowling_bomb",false);chain_a.z=.28;chain_a.landed=true;chain_a.rolling_detonate=true;
fraggrenade chain_b(70.5,20,0,90,"motion_flat",owner.name,"bowling_bomb",false);chain_b.z=.28;chain_b.landed=true;
fraggrenade chain_c(71,20,0,90,"motion_flat",owner.name,"bowling_bomb",false);chain_c.z=.28;chain_c.landed=true;
fraggrenades.insert_last(chain_a);fraggrenades.insert_last(chain_b);fraggrenades.insert_last(chain_c);
fraggrenadeloop();motion_check(fraggrenades.length()==0,"touching rolling bombs chain-detonate in one simulation tick");
owner.x=200;owner.y=200;owner.z=0;owner.dev=true;
owner.physical_items.set("guided_missile_controller",1);owner.physical_items.set("piloted_guided_missile",1);
string[] launch={"missile","launch"};handle_guided_missile_request(1,launch);
motion_check(weapons.length()>0 and weapons[weapons.length()-1].guided and weapons[weapons.length()-1].pilot_peer==1,"guided missile launch uses a server-owned projectile");
if(weapons.length()>0){weapon@ missile=weapons[weapons.length()-1];int id=missile.audio_id;double old_vz=missile.vz;guided_missile_steer(missile,.02);projectile_step(missile,.02);motion_check(missile.vz<old_vz+2,"guided missile still responds to gravity during piloting");string[] leave={"missile","return",""+id};handle_guided_missile_request(1,leave);motion_check(missile.pilot_peer==-1 and weapons.length()>0 and sqrt(missile.vx*missile.vx+missile.vy*missile.vy)>0,"returning to body leaves the missile moving");}
turret_spawn(owner,"laser");motion_check(turrets.length()==1 and find_dobject("motion_flat",turrets[0].object_id)!is null,"developer-spawned turret is a map object");
owner.x=202;owner.physical_items.set("turret_laser_cell",1);string[] load={"turret","load","turret_laser_cell"};handle_turret_request(1,load);
motion_check(turrets[0].rounds==50,"matching physical turret ammunition loads only beside the object");
string[] pilot={"turret","toggle"};handle_turret_request(1,pilot);motion_check(turrets[0].peer==1,"nearby operator takes control of the turret");
string[] aim={"turret","aim",""+turrets[0].id,"1","1"};handle_turret_request(1,aim);motion_check(turrets[0].heading!=0 and turrets[0].elevation!=90,"swiveling turret accepts bounded horizontal and vertical aim");
wait(180);uint before_shot=weapons.length();string[] fire={"turret","fire",""+turrets[0].id};handle_turret_request(1,fire);motion_check(weapons.length()==before_shot+1 and turrets[0].rounds==49,"turret firing creates a standard ballistic projectile and spends one round");
handle_turret_request(1,pilot);motion_check(turrets[0].peer<0,"operator can return to their body");
turret_spawn(owner,"base_machinegun");owner.physical_items.set("base_machinegun_ammo_drum",1);string[] drum={"turret","load","base_machinegun_ammo_drum"};handle_turret_request(1,drum);motion_check(turrets.length()==2 and turrets[1].rounds==225 and turrets[1].weapon=="browning_m2_heavy_50_cal_machinegun","Redspot base machinegun is a physical turret loaded by its own drum");
player marked(90,90,0,"motion_flat","marked_target",7);players.insert_last(marked);player@ victim=players[players.length()-1];owner.health=500;
weapon venom(90,89,1,0,90,"bloodline_injector_carbine",owner.name,"motion_flat");projectile_content_effect(venom,victim,100);
motion_check(victim.poisoned and owner.health>500,"poison and lifesteal effects apply together on a ballistic hit");
weapon tracker(90,89,1,0,90,"recon_dart_projector",owner.name,"motion_flat");projectile_content_effect(tracker,victim,10);
motion_check(victim.tagged_by==owner.name,"tracking darts tag their target for the firing player");
weapon blade(90,89,1,0,90,"red_horizon_katana",owner.name,"motion_flat");projectile_content_effect(blade,victim,100);
motion_check(victim.bleeding and server_weapon_has_effect(blade.type,"lifesteal"),"bloodletting and lifesteal coexist on a weapon");
shipment_store_directory=dir+"/shipments";market_offer parcel_offer;parcel_offer.item="parachute";parcel_offer.quantity=1;market_offer@[] basket;basket.insert_last(parcel_offer);int[] order_counts={2};
int parcel_id=queue_market_shipment(owner,basket,order_counts);shipment_record@ parcel=shipment_find(parcel_id);
motion_check(parcel !is null and parcel.x==owner.x and parcel.y==owner.y and parcel.amounts[0]==2,"marketplace seals an order for its original coordinates");
parcel.state=2;parcel.carrier=owner.name;save_shipments();owner.physical_items.set(shipment_name(parcel_id),1);
motion_check(shipment_open(owner,shipment_name(parcel_id)) and parcel.state==3,"carried shipment opens exactly once into its server-recorded contents");
load_shipments();motion_check(shipment_find(parcel_id)!is null and shipment_find(parcel_id).state==3,"opened shipment state survives server reload");
redspot_base_store_directory=dir+"/bases";owner.x=240;owner.y=240;owner.z=0;owner.facing=0;owner.physical_items.set("wood",100);
build_redspot_base(owner);motion_check(redspot_bases.length()==1 and find_dobject("motion_flat",redspot_bases[0].id)!is null,"wood builds a persistent base computer as a map object");
if(redspot_bases.length()>0){redspot_base@ home=redspot_bases[0];motion_check(redspot_base_access(owner,home) and !redspot_base_access(victim,home),"base ownership gates computer access");market_offer@[] base_basket;market_offer base_offer;base_offer.item="spring_coil";base_offer.quantity=2;base_basket.insert_last(base_offer);int[] base_counts={1};int base_parcel=queue_market_shipment(owner,base_basket,base_counts);motion_check(shipment_find(base_parcel).base_id==home.id,"orders made at a powered base route to its secure storage");
owner.physical_items.set("empty_pack",1);owner.physical_items.set("spring_coil",4);string[] fill={"pack","fill","spring_coil","3"};pack_handle_request(1,fill);string packed="pack_containing_3_spring_coil";motion_check(physical_count(owner,packed)==1 and physical_count(owner,"spring_coil")==1,"pack creation consumes exact physical contents and wrapping");motion_check(pack_open(owner,packed) and physical_count(owner,"spring_coil")==4,"unpacking returns contents and empty wrapping");
victim.x=240;victim.y=241;victim.z=0;victim.physical_items.set("lockpick",1);string[] start_pick={"base","pick","start"};redspot_base_request(victim.peer_id,start_pick);for(int stage=0;stage<5;stage++){home.click_sent=true;home.pick_target_ms=0;home.pick_timer.restart();string[] click={"base","pick","click",""+home.id};redspot_base_request(victim.peer_id,click);}motion_check(redspot_base_access(victim,home),"five timed lock clicks grant temporary base access");
save_redspot_bases();load_redspot_bases();motion_check(redspot_bases.length()==1 and redspot_bases[0].owner==owner.name,"base ownership survives server reload");}
owner.physical_items.set("gas_can",1);int fuel_before=redspot_bases[0].fuel_seconds;redspot_use_item(owner,"gas_can");motion_check(redspot_bases[0].fuel_seconds==fuel_before+300 and physical_count(owner,"empty_gas_can")==1,"gas can fuels a persistent base generator and returns the empty can");
owner.physical_items.set("base_lock_booster",1);redspot_use_item(owner,"base_lock_booster");motion_check(redspot_bases[0].lock_boosters==1 and physical_count(owner,"base_lock_booster")==0,"lock booster increases the number of timed door pins");
owner.physical_items.set("medal",1);dobject@ base_computer=find_dobject(owner.map,redspot_bases[0].id);int original_max=base_computer.max_health;redspot_use_item(owner,"medal");motion_check(base_computer.max_health==original_max+100,"metal permanently reinforces a base computer");
owner.physical_items.set("sandbag",1);owner.facing=90;uint old_walls=walls.length();redspot_use_item(owner,"sandbag");motion_check(walls.length()==old_walls+1 and walls[walls.length()-1].maxz-walls[walls.length()-1].miniz==15,"sandbags build a fifteen-tile server-owned barrier");
owner.health=500;owner.physical_items.set("poison_drink",1);owner.poisoned=true;
motion_check(redspot_use_item(owner,"poison_drink") and !owner.poisoned and owner.health>500 and physical_count(owner,"poison_drink")==0,"poison drink cures poison and consumes only the owned dose");
owner.physical_items.set("shield",1);redspot_use_item(owner,"shield");int shield_before=owner.redspot_shield,health_before=owner.health;
apply_player_damage(owner,150,"marked_target's punch");motion_check(owner.redspot_shield==shield_before-1 and owner.health==health_before,"Redspot shield absorbs an ordinary hit and spends a charge");
owner.physical_items.set("wood_pack",1);int wood_before=physical_count(owner,"wood");redspot_use_item(owner,"wood_pack");motion_check(physical_count(owner,"wood")==wood_before+15 and physical_count(owner,"wood_pack")==0,"Redspot pack yields its declared physical contents exactly once");
init_redspot_combos();motion_check(redspot_combos.length()==30 and redspot_combo_match("123","fists") !is null,"all thirty Redspot combo definitions are registered");
victim.x=owner.x;victim.y=owner.y+1;victim.z=owner.z;victim.map=owner.map;victim.health=1000;end_spawn_grace(victim);owner.current_weapon="fists";
string[] first_move={"combat_move","1"};string[] second_move={"combat_move","2"};string[] third_move={"combat_move","3"};
redspot_combo_request(owner.peer_id,first_move);wait(350);redspot_combo_request(owner.peer_id,second_move);wait(500);redspot_combo_request(owner.peer_id,third_move);
motion_check(owner.combo_sequence=="" and victim.health<1000,"a timed punch sequence lands its server-authoritative combo on a nearby opponent (sequence="+owner.combo_sequence+", health="+victim.health+", target="+redspot_hand_target(owner)+")");
owner.physical_items.set("poisoned_small_projectile",1);uint thrown_before=weapons.length();redspot_use_item(owner,"poisoned_small_projectile");
motion_check(weapons.length()==thrown_before+1 and weapons[weapons.length()-1].auto_homing and physical_count(owner,"poisoned_small_projectile")==0,"Redspot homing projectile launches a ballistic object and consumes its own item");
if(weapons.length()>thrown_before){weapon@ homing=weapons[weapons.length()-1];double old_x=homing.vx,old_y=homing.vy;guided_missile_steer(homing,.1);motion_check(homing.vx!=old_x or homing.vy!=old_y,"Redspot small projectile steers toward its tracked enemy");}
fraggrenades.resize(0);pin_grenade(owner.peer_id,"fire_bomb");motion_check(fraggrenades.length()==0,"a Redspot explosive cannot be armed without server-owned stock");
owner.physical_items.set("fire_bomb",1);pin_grenade(owner.peer_id,"fire_bomb");motion_check(fraggrenades.length()==1 and fraggrenades[0].kind=="fire_bomb","a carried Redspot fire bomb arms with its own incendiary profile");
blast_profile@ oxygen=blast_profile_for("oxygen_canister",owner.name);motion_check(oxygen.payload=="oxygen" and oxygen.damage==0,"oxygen canister uses a nonlethal air-restoring blast profile");
blast_profile@ barricade=blast_profile_for("barricade_bomb",owner.name);motion_check(barricade.damage==4000 and item_prop_int("barricade_bomb","trigger_delay_ms")==3000,"barricade bomb retains its Redspot damage and delayed sensor");
owner.health=500;owner.physical_items.set("empty_health_pod",1);redspot_use_item(owner,"empty_health_pod");motion_check(owner.health==300 and physical_count(owner,"health_pod__value__200")==1,"empty health pod stores two hundred points of the owner's health");
redspot_use_item(owner,"health_pod__value__200");motion_check(owner.health==500 and physical_count(owner,"health_pod__value__200")==0 and physical_count(owner,"empty_health_pod")==1,"filled health pod restores its recorded dose and returns its shell");
owner.physical_items.set("robot",1);deploy_companion(0,"robot");motion_check(companions.length()>0 and companions[companions.length()-1].kind=="robot" and companions[companions.length()-1].mode=="attack" and physical_count(owner,"robot")==0,"Redspot robot deploys as a five-minute attacking physical companion");
victim.physical_items.set("frequency_scrambler",1);redspot_use_item(victim,"frequency_scrambler");motion_check(victim.redspot_scrambled and companion_nearest_hostile(companions[companions.length()-1])<0,"frequency scrambler hides its user from Redspot robot targeting");
spawn_deployable_explosive(owner.x+2,owner.y,owner.z,owner.facing,owner.map,victim.name,"mine");owner.physical_items.set("bomb_defuser",1);uint mines_before=deployable_explosives.length();redspot_use_item(owner,"bomb_defuser");motion_check(deployable_explosives.length()<mines_before and physical_count(owner,"bomb_defuser")==0,"bomb defuser consumes its charge and removes nearby mines");
owner.physical_items.set("matchbox",1);int matches_before=physical_count(owner,"match");redspot_use_item(owner,"matchbox");motion_check(physical_count(owner,"match")==matches_before+15 and physical_count(owner,"matchbox")==0,"Redspot matchbox unwraps into fifteen usable matches");
wallet_accounts_directory=dir+"/accounts";directory_create(wallet_accounts_directory);savedata wallet(wallet_accounts_directory+"/"+owner.name+".dat",ACCOUNT_SECRET);wallet.add("credits",double(owner.credits));wallet.save();
owner.physical_items.set("bitcoin",1);int credits_before=owner.credits;redspot_use_item(owner,"bitcoin");motion_check(owner.credits>=credits_before+250 and owner.credits<=credits_before+350 and physical_count(owner,"bitcoin")==0,"bitcoin scan at a powered base credits its variable market value");
spawn_citem(owner.x+10,owner.y,owner.z,owner.map,"food");owner.physical_items.set("item_grabber",1);redspot_use_item(owner,"item_grabber");motion_check(redspot_grabber_locked(owner.peer_id),"item grabber stuns its owner during pressurization");wait(3100);redspot_item_loop();motion_check(!redspot_grabber_locked(owner.peer_id) and citems[citems.length()-1].x==owner.x,"item grabber pulls nearby loose items to its user after the delay");
owner.physical_items.set("stp429_mini_missile",1);uint missiles_before=weapons.length();redspot_use_item(owner,"stp429_mini_missile");motion_check(weapons.length()==missiles_before+1 and weapons[weapons.length()-1].explosive_radius==8 and physical_count(owner,"stp429_mini_missile")==0,"STP429 item launches a fast ballistic mini missile");
owner.physical_items.set("rocket_battery",1);uint battery_before=weapons.length();redspot_use_item(owner,"rocket_battery");motion_check(redspot_action_locked(owner.peer_id),"rocket battery holds the operator during its power-up");wait(3100);redspot_item_loop();motion_check(weapons.length()==battery_before+5 and !redspot_action_locked(owner.peer_id),"rocket battery releases five ballistic rockets in distinct directions");
owner.physical_items.set("corpse_bomb",1);redspot_use_item(owner,"corpse_bomb");motion_check(owner.redspot_corpse_bomb_worn and physical_count(owner,"corpse_bomb")==1,"corpse bomb can be strapped on without spending it before death");redspot_use_item(owner,"corpse_bomb");motion_check(!owner.redspot_corpse_bomb_worn,"corpse bomb can be removed safely");
owner.physical_items.set("satellite_bomb",1);owner.physical_items.set("satellite_bomb_remote",1);owner.x=300;owner.y=300;string[] sat_place={"redspot_explosive","sat_place","0123"};redspot_explosive_request(owner.peer_id,sat_place);motion_check(deployable_explosives.length()>0 and deployable_explosives[deployable_explosives.length()-1].launch_code=="0123" and physical_count(owner,"satellite_bomb")==0,"satellite bomb stores its validated four-digit code server-side");owner.x=240;owner.y=240;string[] sat_fire={"redspot_explosive","sat_fire","0123"};redspot_explosive_request(owner.peer_id,sat_fire);bool satellite_remains=false;for(uint si=0;si<deployable_explosives.length();si++)if(deployable_explosives[si].kind=="satellite_bomb")satellite_remains=true;motion_check(!satellite_remains,"matching satellite code detonates the armed bomb from a remote location");
owner.physical_items.set("programmable_timebomb",1);string[] timer_place={"redspot_explosive","timer_place","33"};redspot_explosive_request(owner.peer_id,timer_place);motion_check(deployable_explosives.length()>0 and deployable_explosives[deployable_explosives.length()-1].detonate_ms_override==33000,"programmable timebomb keeps its validated custom fuse");deployable_explosives.remove_at(deployable_explosives.length()-1);
spawn_deployable_explosive(320,320,0,0,owner.map,owner.name,"bullet_bomb");spawn_deployable_explosive(321,320,0,0,owner.map,owner.name,"bullet_bomb");uint chain_before=deployable_explosives.length();weapon rifle(320,320,-.3,0,90,"barrett_m82_sniper_rifle",owner.name,owner.map);motion_check(projectile_hit_deployable(rifle) and deployable_explosives.length()<=chain_before-2,"shooting a bullet bomb detonates linked bombs in the same chain");
spawn_deployable_explosive(330,330,0,0,owner.map,owner.name,"sm2_missile");spawn_deployable_explosive(332,330,0,0,owner.map,owner.name,"sm2_missile_plate");int plate_index=int(deployable_explosives.length())-1;detonate_deployable(plate_index);bool sm2_left=false;for(uint si=0;si<deployable_explosives.length();si++)if(deployable_explosives[si].kind=="sm2_missile")sm2_left=true;motion_check(!sm2_left,"SM2 pressure plate activates its owner's placed missile");
spawn_deployable_explosive(340,340,0,0,owner.map,owner.name,"redspot_claymore");owner.physical_items.set("claymore_remote",1);redspot_use_item(owner,"claymore_remote");bool claymore_left=false;for(uint si=0;si<deployable_explosives.length();si++)if(deployable_explosives[si].kind=="redspot_claymore")claymore_left=true;motion_check(!claymore_left,"claymore remote detonates the oldest owned Redspot claymore");
victim.x=360;victim.y=360;victim.z=0;blast_profile@ concussive=blast_profile_for("concussive_grenade",owner.name);detonate(360,360,0,owner.map,concussive);motion_check(victim.z>0,"Redspot concussive grenade launches its target upward for normal fall physics");
blast_profile@ sound_blast=blast_profile_for("sound_grenade",owner.name);motion_check(sound_blast.payload=="deafen" and sound_blast.effect_ms==10000,"sound grenade has a ten-second nonlethal hearing effect");
owner.physical_items.set("item_carying_projectile",2);owner.physical_items.set("poison_dart",1);string[] cargo_launch={"cargo","launch","poison_dart","240","245","0","0"};redspot_cargo_request(owner.peer_id,cargo_launch);motion_check(redspot_cargoes.length()==1 and physical_count(owner,"poison_dart")==0 and physical_count(owner,"item_carying_projectile")==1,"item carrying projectile seals and spends an owned payload at launch");
if(redspot_cargoes.length()>0){double cargo_y=redspot_cargoes[0].y;wait(60);redspot_cargo_loop();motion_check(redspot_cargoes.length()>0 and redspot_cargoes[0].y>cargo_y,"item carrier advances with velocity under active steering and gravity");if(redspot_cargoes.length()>0){weapon interceptor(redspot_cargoes[0].x,redspot_cargoes[0].y,redspot_cargoes[0].z-.8,0,90,"barrett_m82_sniper_rifle",victim.name,owner.map);motion_check(projectile_hit_redspot_cargo(interceptor) and redspot_cargoes.length()==0 and citems[citems.length()-1].name=="poison_dart","shooting down item carrier drops the sealed payload for pickup");}}
owner.physical_items.set("cyanide_canister",1);string[] cargo_active={"cargo","launch","cyanide_canister","240","250","0","1"};redspot_cargo_request(owner.peer_id,cargo_active);uint old_grenades=fraggrenades.length();if(redspot_cargoes.length()>0)redspot_cargo_finish(0,true);motion_check(redspot_cargoes.length()==0 and fraggrenades.length()==old_grenades+1 and fraggrenades[fraggrenades.length()-1].kind=="cyanide_canister","activated cargo deploys its explosive payload at the destination");
}
catch{motion_check(false,"Exception: "+get_exception_info()+" at "+get_exception_file()+":"+get_exception_line());}
motion_results+="Failures: "+motion_failures+"\n";file report;report.open(dir+"/results.txt","wb");report.write(motion_results);report.close();exit(motion_failures);
}
