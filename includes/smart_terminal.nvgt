// Shared, error-aware service transport. All forms retain their parent screen.
string terminal_request(string command,string prefix,int timeout=5000){
 if(!connected){speak("This service needs a server connection.");return "";}
 return identified_service_request(command,timeout);
}
bool terminal_reply_ok(string response){return response.find("terminal_ok ")==0 or response.find("bank_ok ")==0 or response.find("terminal_output ")==0 or response.find("device_ok ")==0 or response.find("device_output ")==0;}
void terminal_speak_reply(string response){
 string[] prefixes={"terminal_ok ","terminal_error ","terminal_output ","bank_ok ","bank_error ","device_ok ","device_error ","device_output "};
 for(uint i=0;i<prefixes.length();i++)if(response.find(prefixes[i])==0){speak(response.substr(prefixes[i].length()));return;}if(response!="")speak(response);
}
string bank_pin_input(string title){
 nv_form f;f.create_window(title,false,true);nv_form_input@ pin=f.add_input("Protected bank PIN","pin","","*",12);nv_form_button@ submit=f.add_button("Submit PIN","submit",true),cancel=f.add_button("Cancel","cancel",false,true);f.focus_control(pin);
 while(connected){wait(5);f.monitor();netloop(false);if(f.is_pressed(cancel))return "";if(f.is_pressed(submit))return pin.text;}return "";
}
string bank_sign_in(){
 string exists=terminal_request("bank_exists","bank_");if(exists=="")return "";
 if(exists=="bank_status none"){
  if(yesno("Create a bank account? Cash machines and BankLink use the same checking and savings balances.")!=1)return "";
  string pin=bank_pin_input("Choose a numeric PIN, four to twelve digits");if(pin=="")return "";
  if(bank_pin_input("Confirm your bank PIN")!=pin){speak("PINs did not match.");return "";}
  string created=terminal_request("bank_create "+pin,"bank_");terminal_speak_reply(created);if(!terminal_reply_ok(created))return "";
 }else if(exists!="bank_status exists"){terminal_speak_reply(exists);return "";}
 string pin=bank_pin_input("Sign in to your bank account with your PIN");if(pin=="")return "";
 string status=terminal_request("bank_status "+pin,"bank_");if(status.find("bank_status ")!=0){terminal_speak_reply(status);return "";}
 return pin;
}
void deposit_owned_chips(string item){
 if(bank_sign_in()=="")return;string count=af_input("Number of "+physical_item_name(item)+" chips to deposit; "+get_item_count(item)+" carried","1",true);if(count!="")terminal_speak_reply(terminal_request("physical_deposit "+item+" "+count,"bank_"));
}
void terminal_bank_menu(){
 string pin=bank_sign_in();if(pin=="")return;
string selected_operation="";
 while(connected){
  string status=terminal_request("bank_status "+pin,"bank_");if(status.find("bank_status ")!=0){terminal_speak_reply(status);return;}
  string[] fields=string_split(status.substr(12),"|",false);if(fields.length()<4)return;
  nv_form f;f.create_window("Bank account "+fields[0],false,true);
  f.add_input("Account summary","summary","Checking "+fields[1]+" credits. Savings "+fields[2]+". Credit debt "+fields[3]+". Wallet is separate. Sign-in authorizes your bank credsticks for five minutes.","",0,true,true);
  nv_form_list_box@ actions=f.add_list("Banking operations","operations");
  actions.add("Deposit wallet credits: Transfer your saved wallet balance to checking.","deposit");actions.add("Withdraw to wallet: Transfer checking credits to your saved wallet.","withdraw");
  actions.add("Move funds to savings: Transfer from checking.","save");actions.add("Move funds to checking: Transfer from savings.","unsave");
if(string_to_number(fields[3])>0)actions.add("Repay your credit line: Transfer checking funds to reduce debt.","repay");
actions.add("Withdraw physical credit chips: Choose a denomination and quantity from checking.","cash");
  if(physical_owned_selection_available("chip"))actions.add("Deposit physical credit chips: Choose a stack and quantity to transfer into checking.","chip");
  if(physical_owned_selection_available("refill"))actions.add("Reload a credstick: Pay from checking, including its refill surcharge.","refill");
  actions.add("View issued cards: Read the cards attached to this bank account.","cards");
actions.add("Issue a debit card and bank credstick: "+item_prop_int("credstick_bank","market_price",50)+" credits from checking; three percent payment fee.","card:debit");actions.add("Issue a credit-line card and credstick: "+item_prop_int("credstick_credit","card_issue_price",75)+" credits; five percent payment fee and a 2000-credit limit.","card:credit");actions.add("Issue a prepaid card and sealed credstick: "+item_prop_int("credstick_disposable","market_price",260)+" credits; 250 credits loaded.","card:prepaid");actions.add("Issue a premium bank credstick: "+item_prop_int("credstick_bank_plus","market_price",150)+" credits; one percent payment fee.","card:virtual");
nv_form_button@ perform=f.add_button("Perform selected operation","perform",true);nv_form_button@ logout=f.add_button("Sign out: Lock bank-linked credsticks","logout");nv_form_button@ close=f.add_button("Back: Keep the five-minute bank authorization","close",false,true);for(uint i=0;i<actions.items.length();i++)if(actions.items[i].id==selected_operation)actions.set_pos(int(i),false);f.focus_control(actions);
  bool refresh=false;while(connected){
   wait(5);f.monitor();netloop(false);if(f.is_pressed(close))return;if(f.is_pressed(logout)){terminal_speak_reply(terminal_request("bank_logout","bank_"));return;}
if(!f.is_pressed(perform) or actions.focused_item_id=="")continue;string op=actions.focused_item_id,command="";selected_operation=op;
   if(op=="cards"){show_readonly_audio_form("Registered bank cards",fields.length()>4 and fields[4]!=""?string_replace(fields[4],",","\n",true):"No cards have been issued.");continue;}
   if(op=="chip"){string item=physical_pick_owned("chip","Choose a credit chip to deposit");if(item!=""){string count=af_input("Number of chips to deposit; "+get_item_count(item)+" carried","1",true);if(count!="")command="physical_deposit "+item+" "+count;}}
else if(op=="cash"){string[] labels,ids;for(uint i=0;i<item_catalogue.length();i++)if(item_prop(item_catalogue[i].id,"currency_kind")=="chip"){labels.insert_last(item_catalogue[i].name+"; "+physical_item_value(item_catalogue[i].id)+" credits each");ids.insert_last(item_catalogue[i].id);}int choice=android_select("Choose cash denomination",labels);if(choice>=0){string count=af_input("Number of chips to withdraw","1",true);if(count!="")command="bank_cash "+pin+" "+ids[choice]+" "+count;}}
   else if(op=="refill"){string item=physical_pick_owned("refill","Choose a credstick to reload");if(item!=""){string amount=af_input("Credits to add; surcharge "+item_prop_int(item,"currency_fee_percent",5)+" percent","",true);if(amount!="")command="physical_refill "+item+" "+amount;}}
   else if(op.find("card:")==0)command="bank_card "+pin+" "+op.substr(5);
   else{string amount=af_input("Whole credits to transfer","",true);if(amount!="")command="bank_"+op+" "+pin+" "+amount;}
   if(command!=""){terminal_speak_reply(terminal_request(command,"bank_"));refresh=true;break;}
  }if(!refresh)return;
 }
}
void smart_terminal_launcher(){device_menu("hypercomp");}
void smart_terminal_menu(){device_menu("hypercomp");}
