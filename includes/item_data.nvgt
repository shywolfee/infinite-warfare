// The item catalogue, read from data files the way weapons are.
//
// Every item that is not a weapon lives in its own file under content/items,
// in a folder for its category, as plain key=value lines:
//
//   name=Plate Carrier
//   category=Armour
//   summary=Medium torso protection using ballistic plates.
//   give_amount=1
//   armour_slot=torso
//   armour_rating=40
//   armour_durability=1250
//   armour_weight=7
//
// Any other key is kept and can be read with item_prop(). Adding an item, or
// changing what one does, is a matter of editing a file: nothing about an item
// is worked out from the words in its name any more. That guessing is how a
// Carrier-Breaker missile came to be equipped as a plate carrier -- its id
// contained "carrier" -- and it decided every armour piece's slot, protection,
// durability and weight, and which patches fitted it.
//
// Both the client and the server include this file, so they read the same
// data and cannot disagree about an item.

class item_data
{
string id,name,category,summary;
int give_amount=1;
dictionary props;
}
item_data@[] item_catalogue;
dictionary item_catalogue_index;

string item_data_directory()
{
if(directory_exists("iwserver/content/items"))return "iwserver/content/items";
if(directory_exists("content/items"))return "content/items";
return "";
}

item_data@ parse_item_file(const string &in id,const string &in text)
{
item_data d;
d.id=id;
string[] lines=string_split(text,"\n",false);
for(uint i=0;i<lines.length();i++)
{
string line=lines[i];
if(line.length()>0 and line.substr(line.length()-1)=="\r")line=line.substr(0,line.length()-1);
if(line=="" or line.substr(0,1)=="#")continue;
int eq=line.find("=");
if(eq<=0)continue;
string key=line.substr(0,eq).trim_whitespace(),value=line.substr(eq+1).trim_whitespace();
if(key=="name")d.name=value;
else if(key=="category")d.category=value;
else if(key=="summary")d.summary=value;
else if(key=="give_amount")d.give_amount=int(string_to_number(value));
else d.props.set(key,value);
}
if(d.name=="")d.name=string_replace(id,"_"," ",true);
return d;
}

// Returns how many items were loaded.
int load_item_catalogue(const string &in from="")
{
item_catalogue.resize(0);
item_catalogue_index.delete_all();
string root=from!=""?from:item_data_directory();
if(root=="")return 0;
string[] folders=find_directories(root+"/*");
folders.insert_at(0,"");
for(uint f=0;f<folders.length();f++)
{
string dir=folders[f]==""?root:root+"/"+folders[f];
string[] files=find_files(dir+"/*.item");
for(uint i=0;i<files.length();i++)
{
file fh;
if(!fh.open(dir+"/"+files[i],"rb"))continue;
string text=fh.read();
fh.close();
string id=files[i].substr(0,files[i].length()-5);
if(item_catalogue_index.exists(id))continue;
item_catalogue_index.set(id,int(item_catalogue.length()));
item_catalogue.insert_last(parse_item_file(id,text));
}
}
return item_catalogue.length();
}

item_data@ item_info(const string &in id)
{
int index=-1;
if(!item_catalogue_index.get(id,index) or index<0 or index>=int(item_catalogue.length()))return null;
return item_catalogue[index];
}
string item_prop(const string &in id,const string &in key,const string &in fallback="")
{
item_data@ d=item_info(id);
if(d is null)return fallback;
string value;
if(!d.props.get(key,value))return fallback;
return value;
}
int item_prop_int(const string &in id,const string &in key,int fallback=0)
{
string value=item_prop(id,key);
return value==""?fallback:int(string_to_number(value));
}
double item_prop_number(const string &in id,const string &in key,double fallback=0)
{
string value=item_prop(id,key);
return value==""?fallback:string_to_number(value);
}
bool item_flag(const string &in id,const string &in key){return item_prop(id,key)=="true";}
string[] item_prop_list(const string &in id,const string &in key)
{
string[] result;
string value=item_prop(id,key);
if(value=="")return result;
string[] parts=string_split(value,",",false);
for(uint i=0;i<parts.length();i++){string p=parts[i].trim_whitespace();if(p!="")result.insert_last(p);}
return result;
}

// Armour. An item is armour when its file names the body slot it covers.
string armour_slot(const string &in id){return item_prop(id,"armour_slot");}
int armour_rating(const string &in id){return item_prop_int(id,"armour_rating");}
int armour_durability(const string &in id){return item_prop_int(id,"armour_durability");}
int armour_weight(const string &in id){return item_prop_int(id,"armour_weight");}
// A patch lists the armour it repairs.
bool is_armour_patch(const string &in id){return item_prop(id,"repairs")!="";}
bool patch_repairs(const string &in patch,const string &in armour){return armour!="" and item_prop_list(patch,"repairs").find(armour)>=0;}
// Guided missiles and cannon balls are fired rather than thrown.
bool item_is_launched_explosive(const string &in id){return item_flag(id,"launched");}

// Medication: medication_form is liquid, pills or loose_pill; capacity is
// fluid ounces or pills; each dose (an ounce or a pill) heals dose_heal at
// once and dose_heal_over_time over heal_seconds, adds dose_toxicity percent
// toxicity, and may stop bleeding, restore stamina or clear toxicity.
string medication_form(const string &in id){return item_prop(id,"medication_form");}
double medication_capacity(const string &in id){return item_prop_number(id,"capacity",1);}
double medication_recommended(const string &in id){return item_prop_number(id,"recommended_dose",1);}
// Explosives: thrown ones have a fuse you can cook; launched ones fly faster
// and flatter. fuse_ms, blast_radius and blast_damage apply to both.
bool item_is_thrown_explosive(const string &in id){return item_flag(id,"thrown");}
int explosive_fuse_ms(const string &in id){return item_prop_int(id,"fuse_ms",2000);}

string item_number_text(double value)
{
string s=""+round(value,2);
return s;
}
// What an item actually does, in numbers, from its file. Empty when the item
// has nothing more to say than its summary.
string[] item_stats_lines(const string &in id)
{
string[] l;
item_data@ d=item_info(id);
if(d is null)return l;
string form=medication_form(id);
if(form!="")
{
bool liquid=form=="liquid";
string unit=liquid?"fluid ounce":"pill";
if(form!="loose_pill")l.insert_last((liquid?"Holds "+item_number_text(medication_capacity(id))+" fluid ounces":"Holds "+int(medication_capacity(id))+" pills")+"; recommended dose "+item_number_text(medication_recommended(id))+" "+unit+(medication_recommended(id)==1?"":"s")+".");
string effect;
double now=item_prop_number(id,"dose_heal"),later=item_prop_number(id,"dose_heal_over_time");
if(now>0)effect+="heals "+int(now)+" at once";
if(later>0)effect+=(effect==""?"":" and ")+int(later)+" more over "+item_prop_int(id,"heal_seconds")+" seconds";
if(item_flag(id,"stops_bleeding"))effect+=(effect==""?"":", ")+"stops bleeding";
if(item_prop_number(id,"dose_stamina")>0)effect+=(effect==""?"":", ")+"restores "+int(item_prop_number(id,"dose_stamina"))+" stamina";
if(item_prop_number(id,"dose_detox")>0)effect+=(effect==""?"":", ")+"clears "+int(item_prop_number(id,"dose_detox"))+" percent of your toxicity";
if(item_prop_number(id,"dose_toxicity")>0)effect+=(effect==""?"":", ")+"adds "+int(item_prop_number(id,"dose_toxicity"))+" percent toxicity";
if(effect!="")l.insert_last("Each "+unit+" "+effect+". Toxicity above 70 percent is dangerous and above 100 harms you.");
}
if(item_prop(id,"blast_radius")!="")
{
string how=item_is_thrown_explosive(id)?"Thrown":(item_is_launched_explosive(id)?"Launched":"Placed");
int damage=item_prop_int(id,"blast_damage");
l.insert_last(how+". Blast radius "+item_prop_int(id,"blast_radius")+" tiles, "+(damage>0?damage+" damage at the centre":"no blast damage")+", fuse "+item_number_text(explosive_fuse_ms(id)/1000.0)+" seconds"+(item_is_thrown_explosive(id)?"; the fuse starts when you pull the pin, so it can be cooked":"")+".");
if(item_prop(id,"launch_speed")!="")l.insert_last("Flies at "+item_number_text(item_prop_number(id,"launch_speed"))+" tiles a second, rising "+item_number_text(item_prop_number(id,"launch_rise"))+".");
}
if(armour_slot(id)!="")
{
string slot=armour_slot(id);
l.insert_last("Covers the "+(slot=="arm"?"arms":(slot=="leg"?"legs":slot))+". Stops "+armour_rating(id)+" percent of each hit there, absorbs "+armour_durability(id)+" damage before it is spent, and weighs "+armour_weight(id)+".");
}
string[] fits=item_prop_list(id,"repairs");
if(fits.length()>0)
{
string[] names;for(uint i=0;i<fits.length();i++){item_data@ f=item_info(fits[i]);names.insert_last(f is null?fits[i]:f.name);}
string joined;for(uint i=0;i<names.length();i++){if(i>0)joined+=i==names.length()-1?" and ":", ";joined+=names[i];}
l.insert_last("Repairs "+joined+". Restores 7 percent of the armour's durability, and cannot raise it above 60 percent.");
}
if(d.give_amount>1)l.insert_last("Comes "+d.give_amount+" at a time.");
return l;
}
