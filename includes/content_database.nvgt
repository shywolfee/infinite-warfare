// Unified runtime catalogue for weapons, ammunition, equipment, consumables,
// attachments, holsters, and vehicles. Weapon/ammunition/compatibility data is
// derived from the registries that actually drive gameplay.
class content_record
{
string id, display_name, category, summary;
int give_amount;
content_record(string i, string n, string c, string s, int a=1)
{ id=i; display_name=n; category=c; summary=s; give_amount=a; }
}

content_record@[] content_database;
dictionary content_database_index;

int content_find(string id)
{
int index=-1;if(content_database_index.get(id,index) and index>=0 and index<int(content_database.length()) and content_database[index].id==id)return index;return -1;
}

// For things that turn up at run time without a data file -- an item granted
// by an older server, say. These still have their category guessed, because
// there is nothing else to go on; anything with a file uses the file.
void content_register(string id, string name, string category, string summary, int give_amount=1)
{
if(id=="" or content_find(id)>=0) return;
// Normalize broad legacy groups into the focused live-inventory categories.
if(category=="Consumables")
category=(string_contains(id,"potion",1)>=0 or string_contains(id,"syringe",1)>=0 or id=="life_injection")?"Healing":"Utility";
if(category=="Equipment")
{
if(id=="bomb_vest")category="Armour";
else if(string_contains(id,"grenade",1)>=0 or string_contains(id,"bomb",1)>=0 or string_contains(id,"semtex",1)>=0 or id=="c4" or id=="claymore" or id=="proximity_mine" or id=="torpedo")category="Explosives";
else if(string_contains(id,"team_",1)==0 or id=="duo_plane_kit")category="Team";
else if(id=="translocator" or id=="nanomatic_multitool" or id=="nanomatic_components" or id=="binoculars" or id=="hypercomp" or id=="wirenet" or id=="biomonitor_bracelet")category="Utility";
}
if(item_is_weapon_maintenance(id))category="Weapon Maintenance";
if(string_contains(id,"armor_patch",1)>=0 or string_contains(id,"armour_patch",1)>=0 or string_contains(id,"plate_patch",1)>=0 or string_contains(id,"helmet_patch",1)>=0)category="Armour Repair";
if(!item_is_weapon_maintenance(id) and (string_contains(id,"vehicle_",1)==0 or string_contains(id,"fuel_",1)==0 or id=="diesel_can" or id=="gasoline_can" or id=="aviation_fuel_can"))category="Vehicle Supplies";
if(id=="nanomatic_multitool" or id=="binoculars")category="Tools";else if(id=="hypercomp" or id=="wirenet" or id=="biomonitor_bracelet")category="Electronics";else if(id=="bucket" or id=="empty_bucket")category="Containers";
content_database.insert_last(content_record(id,name,category,summary,give_amount));content_database_index.set(id,int(content_database.length())-1);
}

void content_ensure_item(string id)
{
if(id=="" or id=="waypoint_marker" or string_contains(id,"er_fixture_kit_",1)==0 or id=="field_atm_terminal" or id=="beverage_vending_access" or id=="snack_vending_access" or id=="field_medical_console" or id=="supply_kiosk_access" or content_find(id)>=0) return;
string category="Equipment";
if(is_weapon(id)) category="Weapons";
else if(is_ammo_reserve_item(id) or string_contains(id,"ammo",1)>=0 or string_contains(id,"magazine",1)>=0 or string_contains(id,"shell",1)>=0) category="Ammo";
else if(string_contains(id,"potion",1)>=0 or string_contains(id,"syringe",1)>=0 or id=="life_injection") category="Healing";
content_register(id,string_replace(id,"_"," ",true),category,"Runtime-discovered "+category.lower()+" registered automatically when introduced by gameplay.",1);
}

string content_join(string[] values)
{
if(values.length()==0) return "None";
string result="";
for(uint i=0;i<values.length();i++)
{
if(i>0) result+=i==values.length()-1 ? " and " : ", ";
result+=values[i];
}
return result;
}

// Everything that is not a weapon comes from content/items (see
// includes/item_data.nvgt), exactly as written there. It used to be two
// hundred content_register calls in this file, each category then re-guessed
// from the item's id.
void content_add_record(const string &in id,const string &in name,const string &in category,const string &in summary,int give_amount)
{
if(id=="" or content_find(id)>=0)return;
content_database.insert_last(content_record(id,name,category,summary,give_amount));
content_database_index.set(id,int(content_database.length())-1);
}
void content_register_standard_items()
{
if(item_catalogue.length()==0)load_item_catalogue();
for(uint i=0;i<item_catalogue.length();i++)
{
item_data@ d=item_catalogue[i];
content_add_record(d.id,d.name,d.category,d.summary,d.give_amount);
}
}

void initialize_content_database()
{
content_database.resize(0);
content_database_index.delete_all();
for(uint i=0;i<wpn_cache.length();i++)
{
wpn_stats@ w=wpn_cache[i];
string kind=w.melee ? "Melee weapon" : "Weapon";
string damage_text=w.damage==w.max_damage ? ""+w.damage : w.damage+" to "+w.max_damage;
string stats=kind+". Class "+w.wclass+". Damage "+damage_text+". Range "+w.range+". Fire interval "+w.firetime+" milliseconds. Movement interval "+w.walktime+" milliseconds. Spread "+w.spread+". Handling: "+weapon_handling_description(w.id);
stats+=" Projectile model: "+w.projectile_kind+". Muzzle velocity "+round(w.muzzle_velocity,2)+" tiles per second. Gravity "+w.projectile_gravity+". Drag "+w.projectile_drag+". Mass "+w.projectile_mass+" grams. Diameter "+w.projectile_diameter+" millimeters. Dispersion "+round(w.projectile_dispersion,2)+" degrees. Damage retained at maximum range "+int(w.damage_retention*100)+" percent. Penetration capacity "+w.penetration+".";
stats+=" Collision radius "+w.projectile_collision_radius+" tiles.";
if(w.projectile_explosive_radius>0)stats+=" Detonation radius "+w.projectile_explosive_radius+" tiles.";
double ideal_flight=w.muzzle_velocity>0?double(w.range)/w.muzzle_velocity:0;
double ideal_drop=.5*w.projectile_gravity*ideal_flight*ideal_flight;
stats+=" Ideal muzzle-speed flight time to maximum range "+round(ideal_flight,3)+" seconds; gravity-only vertical change over that interval "+round(ideal_drop,2)+" tiles downward. Actual server flight also includes drag, aim angle, impacts, and retained velocity.";
if(w.pellet_count>1) stats+=" Projectiles per shot "+w.pellet_count+"; each pellet or particle has an independent trajectory and collision test.";
content_register(w.id,w.name,"Weapons",stats,1);
}
for(uint i=0;i<gun_ammos.length();i++)
{
gun_ammo@ g=gun_ammos[i];
string detail=g.reserve_label+" for "+get_weapon_display_name(g.weapon_name)+". Capacity "+g.mag_capacity+"; starting reserve "+g.starting_reserve+".";
content_register(g.reserve_item,string_replace(g.reserve_item,"_"," ",true),"Ammo",detail,g.starting_reserve);
}
for(uint i=0;i<attachment_defs.length();i++)
content_register(attachment_defs[i].id,attachment_defs[i].display_name,"Attachments",attachment_defs[i].slot+" attachment compatible with "+attachment_defs[i].compatible_weapons.length()+" weapons. "+attachment_effect_description(attachment_defs[i].id),1);
for(uint i=0;i<ammunition_loads.length();i++)
{
string reserve_name=ammunition_loads[i].display_name+" Reserve";
if(string_contains(ammunition_loads[i].reserve_item,"_box",1)>=0)reserve_name="Box of "+ammunition_loads[i].display_name;
else if(string_contains(ammunition_loads[i].reserve_item,"_quiver",1)>=0)reserve_name=ammunition_loads[i].display_name+" Quiver";
content_register(ammunition_loads[i].reserve_item,reserve_name,"Ammo",ammunition_loads[i].description+" Compatible with "+ammunition_loads[i].weapons.length()+" registered weapons.",ammunition_loads[i].give_amount);
}
for(uint i=0;i<holster_defs.length();i++)
content_register(holster_defs[i].id,holster_defs[i].display_name,"Holsters","Supports "+holster_defs[i].compatible_weapons.length()+" weapons"+(holster_defs[i].has_ammo_storage ? " and stores "+holster_defs[i].ammo_capacity+" rounds." : "."),1);
if(vehicle_types.length()==0)init_vehicle_types();
for(uint i=0;i<vehicle_types.length();i++)
{
vehicle_type@ v=vehicle_types[i];int window_seats=0;
for(uint s=0;s<v.seat_has_window.length();s++)if(v.seat_has_window[s])window_seats++;
string vid=vehicle_audio_id_from_name(v.name);
string detail="Physical vehicle. Health "+v.max_health+"; armour "+v.armor+"; seats "+v.max_passengers+", with windows at "+window_seats+" seats. Top speed "+round(v.top_speed,2)+" tiles per second; acceleration "+round(v.acceleration,2)+" and braking "+round(v.braking,2)+" tiles per second squared. Fuel: "+v.fuel_type+", "+v.fuel_capacity+" litre standard capacity, consuming approximately "+v.fuel_per_tile+" litres per tile before condition and modification effects. Supports physical collision, occupant seating, doors, per-seat windows, roof riding, projectile damage, fuel contamination, component wear, siphoning, timed servicing, refits and type-specific positional audio.";
content_register(vid,v.name,"Vehicles",detail,1);
}
content_register_standard_items();
for(uint i=0;i<content_database.length();i++)if(content_database[i].category!="Weapons" and content_database[i].category!="Vehicles")content_database[i].summary+=" Mechanics: "+item_mechanic_description(content_database[i].id);
}

void refresh_content_database()
{
content_record@[] previous;
for(uint i=0;i<content_database.length();i++) previous.insert_last(content_database[i]);
initialize_content_database();
for(uint i=0;i<previous.length();i++)
if(content_find(previous[i].id)<0) content_register(previous[i].id,previous[i].display_name,previous[i].category,previous[i].summary,previous[i].give_amount);
// Anything introduced dynamically through gameplay is retained in the same
// catalogue. This closes the gap where an item could exist in inventory but be
// absent from the armoury and developer item picker until a restart.
string[] inventory_items=inv.get_keys();
for(uint i=0;i<inventory_items.length();i++) content_ensure_item(inventory_items[i]);
}

string content_weapon_details(string id)
{
int ci=content_find(id); string result=ci>=0 ? content_database[ci].summary : id;
int gi=find_gun(id);
if(gi>=0)
result+="\nAmmunition: "+gun_ammos[gi].ammo_type+"; "+gun_ammos[gi].feed_device+"; capacity "+gun_ammos[gi].mag_capacity+"; reload "+gun_ammos[gi].reload_ms+" milliseconds.";
string[] compatible=get_compatible_attachments(id), attachment_names;
for(uint i=0;i<compatible.length();i++){int ai=find_attachment_def(compatible[i]); if(ai>=0) attachment_names.insert_last(attachment_defs[ai].display_name);}
result+="\nCompatible attachments: "+content_join(attachment_names)+".";
string[] holster_names;
for(uint i=0;i<holster_defs.length();i++) if(holster_supports_weapon(holster_defs[i].id,id)) holster_names.insert_last(holster_defs[i].display_name);
result+="\nCompatible holsters: "+content_join(holster_names)+".";
string[] load_ids=compatible_ammunition_for_weapon(id),load_names;for(uint li=0;li<load_ids.length();li++)load_names.insert_last(ammunition_display_name(load_ids[li]));result+="\nCompatible ammunition loads: "+content_join(load_names)+".";
return result;
}

string[] content_sound_files(string category, string id)
{
string[] result;
if(category=="Weapons")
{
string audio_id=weapon_sound_profile(id);
for(int i=1;i<=3;i++) result.insert_last(audio_id+"fire"+i+".ogg");
bool supports_suppressor=false; string[] compatible_sounds=get_compatible_attachments(id);
for(uint a=0;a<compatible_sounds.length();a++) if(string_contains(compatible_sounds[a],"suppressor",1)>=0) supports_suppressor=true;
if(supports_suppressor) for(int i=1;i<=3;i++) result.insert_last(audio_id+"supressedfire"+i+".ogg");
result.insert_last(audio_id+"draw.ogg"); result.insert_last(audio_id+"holster.ogg");
if(find_gun(id)>=0)
{
result.insert_last(audio_id+"reload.ogg"); result.insert_last(audio_id+"reload_open.ogg"); result.insert_last(audio_id+"reload_insert.ogg"); result.insert_last(audio_id+"reload_close.ogg"); result.insert_last(audio_id+"reload_cycle.ogg"); result.insert_last(audio_id+"reloadend.ogg"); result.insert_last(audio_id+"unload.ogg");
}
for(uint fi=0;fi<fire_modes.length();fi++) if(fire_modes[fi].weapon_name==id) for(uint m=0;m<fire_modes[fi].modes.length();m++) result.insert_last(audio_id+"mode_"+fire_mode_name(fire_modes[fi].modes[m])+".ogg");
}
else if(category=="Vehicles")
{
if(id=="duoplane") { string[] plane={"duoplanein.ogg","duoplaneout.ogg","duoplaneloop.ogg","duoplaneinside.ogg","duoplanedist.ogg","duoplanecrash.ogg","duoplanecrashdist.ogg"}; for(uint pidx=0;pidx<plane.length();pidx++) result.insert_last(plane[pidx]); return result; }
string base="vehicle_"+id+"_"; string[] actions={"start","engine","accelerate","decelerate","stop","door_open","door_close","window_open","window_close","seat_switch","enter","exit","turn","crash","destroy"};
for(uint i=0;i<actions.length();i++) result.insert_last(base+actions[i]+".ogg");
}
else
{
result.insert_last(id+"use.ogg"); result.insert_last(id+"equip.ogg"); result.insert_last(id+"open.ogg"); result.insert_last(id+"close.ogg");
if(category=="Attachments") { result.insert_last("attachment_"+id+"_attach.ogg"); result.insert_last("attachment_"+id+"_remove.ogg"); }
if(category=="Holsters") { result.insert_last("holster_"+id+"_equip.ogg"); result.insert_last("holster_"+id+"_store.ogg"); result.insert_last("holster_"+id+"_weapon_remove.ogg"); }
}
return result;
}

void armoury_database()
{
refresh_content_database();
if(vehicle_types.length()==0) init_vehicle_types();
nv_form f; f.create_window("Infinite Warfare Armoury",false,true);
nv_form_list_box@ categories=f.add_list("Database category","category");
string[] armoury_categories={"Weapons","Ammo","Explosives","Healing","Armour","Armour Repair","Weapon Maintenance","Vehicle Supplies","Attachments","Holsters","Team","Tools","Utility","Electronics","Containers","Equipment","Vehicles"};for(uint ac=0;ac<armoury_categories.length();ac++)categories.add(armoury_categories[ac],armoury_categories[ac]);categories.set_pos(0,false);
nv_form_list_box@ entries=f.add_list("Entries","entries");
nv_form_input@ details=f.add_input("Statistics and compatibility","details","","",0,true,true);
nv_form_list_box@ sounds=f.add_list("Available sound previews; hit and impact sounds are excluded","sounds");
nv_form_button@ play=f.add_button("Preview selected sound","play",true); nv_form_button@ close=f.add_button("Close","close",false,true); f.focus_control(categories);
int last_category=-1,last_entry=-1,last_sound=-1;
int preview_slot=-1;
bool preview_paused=false;
string preview_file="";
while(true)
{
wait(5); f.monitor(); lobby_form_netcheck();
if(preview_slot>=0 and !preview_paused and !p.sound_is_active(preview_slot))
{
preview_slot=-1; preview_paused=false; preview_file=""; play.caption="Preview selected sound";
}
if(categories.list_position!=last_category)
{
if(categories.list_position<0 or categories.list_position>=int(categories.items.length())) continue;
last_category=categories.list_position; last_entry=-1;
// NV_form intentionally preserves selection while items change. Clear the
// positions first so a former long-list index cannot address the new list.
entries.list_position=-1; entries.items.resize(0);
sounds.list_position=-1; sounds.items.resize(0); details.default_text="";
last_sound=-1;
if(preview_slot>=0) p.destroy_sound(preview_slot);
preview_slot=-1; preview_paused=false; preview_file=""; play.caption="Preview selected sound";
string selected_category=armoury_categories[last_category];for(uint i=0;i<content_database.length();i++)if(content_database[i].category==selected_category)entries.add(content_database[i].display_name,content_database[i].id);
if(entries.items.length()>0) entries.set_pos(0,false);
}
if(entries.list_position>=int(entries.items.length()))
{
entries.list_position=-1; last_entry=-1;
if(entries.items.length()>0) entries.set_pos(0,false);
}
if(entries.list_position!=last_entry and entries.list_position>=0 and entries.list_position<int(entries.items.length()))
{
last_entry=entries.list_position; last_sound=-1; sounds.list_position=-1; sounds.items.resize(0);
if(preview_slot>=0) p.destroy_sound(preview_slot);
preview_slot=-1; preview_paused=false; preview_file=""; play.caption="Preview selected sound";
string id=entries.items[last_entry].id;string category=armoury_categories[last_category];int ci=content_find(id);if(category=="Weapons")details.default_text=content_weapon_details(id);else details.default_text=ci>=0?content_database[ci].display_name+". "+content_database[ci].category+". "+content_database[ci].summary:id;
string[] previews=content_sound_files(category,id);
for(uint i=0;i<previews.length();i++)
{
// Looked up in the pack's index. Loading each preview to see whether it
// existed stalled the game for as long as the loads took, long enough on a
// weapon with dozens of recordings for the lobby to decide the server had
// gone quiet and drop the connection.
if(fire_archive_index.file_exists(previews[i])) sounds.add(string_replace(previews[i],"_"," ",true),previews[i]);
}
if(sounds.items.length()>0) sounds.set_pos(0,false); else sounds.add("No authored preview sounds are present in the current sound pack","");
}
if(sounds.list_position!=last_sound)
{
last_sound=sounds.list_position;
if(preview_slot>=0) p.destroy_sound(preview_slot);
preview_slot=-1; preview_paused=false; preview_file=""; play.caption="Preview selected sound";
}
if(f.is_pressed(play) and sounds.list_position>=0 and sounds.list_position<int(sounds.items.length()))
{
string filename=sounds.items[sounds.list_position].id;
if(filename=="") speak("No authored preview sounds are present for this entry.");
else if(preview_slot>=0 and preview_file==filename)
{
if(preview_paused)
{
p.resume_sound(preview_slot); preview_paused=false; play.caption="Pause selected sound"; speak("Resumed.");
}
else
{
p.pause_sound(preview_slot); preview_paused=true; play.caption="Resume selected sound"; speak("Paused.");
}
}
else
{
if(preview_slot>=0) p.destroy_sound(preview_slot);
preview_slot=p.play_stationary(filename,false); preview_file=filename; preview_paused=false;
if(preview_slot>=0) play.caption="Pause selected sound";
else { preview_file=""; speak("That sound could not be played."); }
}
}
if(f.is_pressed(close)) { if(preview_slot>=0) p.destroy_sound(preview_slot); return; }
}
}
