// Sound files are named after an explosive's sound_prefix (its own id unless
// its item file says otherwise).
string explosive_audio_prefix(string kind){return item_prop(kind,"sound_prefix",kind);}
fraggrenade@[] fraggrenades(0);
string grenade_audio_start(fraggrenade@ g){
return "projectile_audio_start "+g.audio_id+" "+item_prop(g.kind,"flight_loop",explosive_audio_prefix(g.kind)+"_flight_loop.ogg")+" "+g.x+" "+g.y+" "+g.z+" "+g.map+" "+g.owner+" "+(item_flag(g.kind,"flight_mandatory")?"world":"optional")+" "+item_prop_number(g.kind,"flight_volume_db",0);
}
void sync_grenade_audio(uint peer,string map){for(uint i=0;i<fraggrenades.length();i++)if(fraggrenades[i].map==map and fraggrenades[i].audio_id>=0)send_reliable(peer,grenade_audio_start(fraggrenades[i]),0);}
// A thrown or launched explosive in flight. Since 0.6 flight is a proper
// little simulation, run in small steps so nothing tunnels through a wall:
//
// - Gravity, and air drag that depends on the object's mass and size (a
//   400 g grenade barely slows; a light smoke canister drifts) acting against
//   the moving air, so wind carries it.
// - A throw keeps the thrower's own movement, and a throw from a vehicle the
//   vehicle's.
// - It bounces off walls and ceilings according to what they are made of:
//   concrete and steel throw it back, timber less, a fence hardly at all.
// - It lands according to the ground: it skips across concrete, thuds into
//   grass and earth, buries itself in sand or snow, and rolls downhill until
//   friction stops it.
// - It hits what is in the way: a vehicle's hull, solid objects, and people,
//   dropping at the feet of anyone it strikes.
// - In water it splashes, sinks and slows; a charge that goes off in water
//   is much worse for swimmers and much milder for everyone else.
//
// The fuse burns from the moment the pin is pulled (cooking), and every fuse
// varies a little, as real ones do.
class fraggrenade
{
double x,y,z,vx,vy,vz;
bool landed=false,in_water=false,splashed=false;
int bounces=0;
timer explodetimer,simulationtimer,audio_update_timer,flight_time;
string map,owner,kind="frag_grenade";
int held_peer=-1; // A pinned grenade follows its holder until released.
int fuse=4500;
int audio_id=-1;
string stuck_to="";
int blast_dir=-1;
int inside_vehicle=-1; // id of the closed vehicle this explosive is loose inside
double drag=0;         // per-metre quadratic drag coefficient
string last_struck="";
bool momentum_rolling=false,rolling_grounded=false,rolling_detonate=false,owner_cleared=false;
double rolling_distance=0,rolling_range=120;
fraggrenade(double gx,double gy,int gz,double gdir,string gmap,string gowner,string gkind="frag_grenade",bool play_launch=true,int aim=90,int cooked_ms=0)
{
x=gx;y=gy;z=double(gz)+1.4;map=gmap;owner=gowner;kind=gkind;
double radians=gdir*3.14159265358979323846/180.0;
fuse=item_prop_int(kind,"fuse_ms",fuse);
int variance=item_prop_int(kind,"fuse_variance_ms",fuse/10);if(variance>0)fuse+=random(-variance,variance);
// Drag: 0.5 x air density x drag coefficient x cross-section / mass.
double mass=item_prop_number(kind,"mass_g",400)/1000.0,diameter=item_prop_number(kind,"diameter_mm",62)/1000.0;if(mass<.02)mass=.02;
drag=.5*1.2*item_prop_number(kind,"drag_coefficient",.5)*3.14159265358979323846*diameter*diameter/4.0/mass;
// A throw's speed is the item's authored launch speed (an ordinary arm
// throws at about fourteen metres a second) and its angle follows the
// thrower's vertical aim: level is a normal arcing throw of about thirty
// degrees, aiming up lobs it, aiming down drops or rolls it.
double speed=14.0;if(item_prop(kind,"launch_speed")!=""){double h=item_prop_number(kind,"launch_speed"),v=item_prop_number(kind,"launch_rise",7.25);speed=sqrt(h*h+v*v);}
double elevation=30.0+(double(aim)-90.0)*.75;if(elevation<-20)elevation=-20;if(elevation>80)elevation=80;double er=elevation*3.14159265358979323846/180.0;
vx=sine(radians)*cosine(er)*speed;vy=cosine(radians)*cosine(er)*speed;vz=sine(er)*speed;
momentum_rolling=item_flag(kind,"momentum_rolling");
if(momentum_rolling)
{
elevation=atan2(item_prop_number(kind,"launch_rise",2.1),item_prop_number(kind,"launch_speed",9.5))*180/3.14159265358979323846+(double(aim)-90)*.65;
if(elevation<-25)elevation=-25;if(elevation>75)elevation=75;er=elevation*3.14159265358979323846/180;
vx=sine(radians)*cosine(er)*speed;vy=cosine(radians)*cosine(er)*speed;vz=sine(er)*speed;
double low=item_prop_number(kind,"rolling_range_min",90),high=item_prop_number(kind,"rolling_range_max",120);
rolling_range=low+(high-low)*cosine(er);
}
// The thrower's own movement is part of the throw.
int thrower=get_player_index_from(owner);if(thrower>=0 and !item_flag(kind,"launched")){vx+=players[thrower].model_vx;vy+=players[thrower].model_vy;}
if(cooked_ms<0)cooked_ms=0;if(cooked_ms>fuse-1)cooked_ms=fuse-1;fuse-=cooked_ms;
if(play_launch)play(item_prop(kind,"throw_sound",explosive_audio_prefix(kind)+"_throw"),int(x),int(y),int(z),map);
simulationtimer.restart();
}
}

int held_grenade_index(int peer)
{
int pi=get_player_index(peer);if(pi<0)return -1;
for(uint i=0;i<fraggrenades.length();i++)if(fraggrenades[i].held_peer==peer and fraggrenades[i].owner==players[pi].name)return int(i);
return -1;
}
void pin_grenade(int peer,string kind)
{
int pi=get_player_index(peer);if(pi<0)return;
if(!item_is_thrown_explosive(kind) or item_flag(kind,"momentum_rolling") or players[pi].death or players[pi].arena_role=="spectator"){send_reliable(peer,"grenade_finished "+kind+" rejected",0);return;}
int held=held_grenade_index(peer);
if(held>=0){if(fraggrenades[held].kind!=kind)send_reliable(peer,"grenade_finished "+kind+" rejected",0);return;}
// Pinning arms the grenade, not the old launcher mechanism. Once live it
// cannot be cancelled by a throw cooldown or by closing an inventory menu.
player@ holder=players[pi];end_spawn_grace(holder);
fraggrenade g(holder.x,holder.y,holder.z,holder.facing,holder.map,holder.name,kind,false);
g.held_peer=peer;g.landed=true;g.vx=0;g.vy=0;g.vz=0;g.explodetimer.restart();
fraggrenades.insert_last(g);
send_reliable(peer,"grenade_armed "+kind+" "+g.fuse,0);
}
void update_held_grenade(fraggrenade@ g)
{
int pi=get_player_index(g.held_peer);if(pi<0 or players[pi].name!=g.owner){g.held_peer=-1;return;}
player@ holder=players[pi];g.x=holder.x;g.y=holder.y;g.z=holder.z+1.0;g.map=holder.map;
int seat=-1,vi=occupied_vehicle_index(holder.name,holder.map,seat);
g.inside_vehicle=vi<0?-1:authoritative_vehicles[vi].id;
}
void release_grenade(int peer,string kind,int aim,string cabin)
{
int gi=held_grenade_index(peer),pi=get_player_index(peer);
if(gi<0 or pi<0){send_reliable(peer,"grenade_finished "+kind+" rejected",0);return;}
fraggrenade@ held=fraggrenades[gi];if(held.kind!=kind)return;
// An expired fuse must detonate at the holder, never be clamped to a new
// one-millisecond projectile or have its expiry postponed by a late throw.
if(int(held.explodetimer.elapsed)>=held.fuse or players[pi].death)return;
int remaining=held.fuse-int(held.explodetimer.elapsed);
player@ holder=players[pi];fraggrenades.remove_at(gi);
spawn_fraggrenade(holder.x,holder.y,holder.z,holder.facing,holder.map,holder.name,kind,aim,0,cabin);
fraggrenade@ thrown=fraggrenades[fraggrenades.length()-1];thrown.fuse=remaining;thrown.explodetimer.restart();
send_reliable(peer,"give "+kind+" -1",0);holder.fraggrenadetimer.restart();
send_reliable(peer,"grenade_finished "+kind+" released",0);
}

string grenade_sound(fraggrenade@ g,string key,string fallback){return item_prop(g.kind,key,fallback);}
string grenade_landing_sound(fraggrenade@ g){return grenade_sound(g,"landing_sound",explosive_audio_prefix(g.kind)+"_bounce");}
string grenade_bounce_sound(fraggrenade@ g){return grenade_sound(g,"bounce_sound",explosive_audio_prefix(g.kind)+"_bounce");}

// One flight step of dt seconds. Returns false once it has come to rest.
bool grenade_step(fraggrenade@ g,double dt)
{
if(g.momentum_rolling)return bowling_bomb_step(g,dt);
map_wind@ air=wind_for(g.map);
// Water slows everything enormously and lets it sink slowly.
if(g.in_water){g.vx*=1.0-3.5*dt;g.vy*=1.0-3.5*dt;g.vz=-.6;}
else
{
g.vz-=9.81*dt;
double rx=g.vx-air.x,ry=g.vy-air.y,rz=g.vz,rs=sqrt(rx*rx+ry*ry+rz*rz);
g.vx-=g.drag*rs*rx*dt;g.vy-=g.drag*rs*ry*dt;g.vz-=g.drag*rs*rz*dt;
}
double nx=g.x+g.vx*dt,ny=g.y+g.vy*dt,nz=g.z+g.vz*dt;
// Walls and anything else solid, one axis at a time so it reflects off the
// face it actually hit.
string next=get_tile_at(int(round(nx,0)),int(round(ny,0)),int(floor(nz)),g.map);
if(blast_tile_solid(next))
{
surface_physics@ wall=surface_of(next);
bool hit_x=blast_tile_solid(get_tile_at(int(round(nx,0)),int(round(g.y,0)),int(floor(g.z)),g.map));
bool hit_y=blast_tile_solid(get_tile_at(int(round(g.x,0)),int(round(ny,0)),int(floor(g.z)),g.map));
bool hit_z=!hit_x and !hit_y;
if(hit_x)g.vx*=-wall.restitution;
if(hit_y)g.vy*=-wall.restitution;
if(hit_z){if(g.vz>0)g.vz*=-wall.restitution;else{g.vx*=-wall.restitution;g.vy*=-wall.restitution;}}
g.vx*=1.0-wall.friction*.3;g.vy*=1.0-wall.friction*.3;g.bounces++;
play(grenade_bounce_sound(g),int(g.x),int(g.y),int(g.z),g.map);
return true;
}
// A ceiling stops an upward throw.
if(g.vz>0 and int(floor(nz))>int(floor(g.z))){string above=get_tile_at(int(round(nx,0)),int(round(ny,0)),int(floor(nz))+1,g.map);if(above!="" and above!="blank" and blast_tile_solid(above)==false and surface_of(above).water==false and nz-floor(nz)>.85){g.vz*=-.3;g.bounces++;play(grenade_bounce_sound(g),int(g.x),int(g.y),int(g.z),g.map);return true;}}
// Vehicle hulls.
for(uint vi=0;vi<authoritative_vehicles.length();vi++)
{
authoritative_vehicle@ v=authoritative_vehicles[vi];if(v.map!=g.map or v.health<=0 or v.id==g.inside_vehicle)continue;update_authoritative_vehicle_model(v);
double rad=v.facing*3.14159265358979323846/180.0,dx=nx-v.model_x,dy=ny-v.model_y,forward=dx*sine(rad)+dy*cosine(rad),side=dx*cosine(rad)-dy*sine(rad),rz=nz-v.model_z;
if(absolute(forward)>v.body_length*.5 or absolute(side)>v.body_width*.5 or rz<0 or rz>v.body_height)continue;
// Reflect off whichever face is nearest, in the vehicle's own frame.
double from_end=v.body_length*.5-absolute(forward),from_side=v.body_width*.5-absolute(side),from_top=v.body_height-rz;
if(from_top<from_end and from_top<from_side){g.vz=absolute(g.vz)*.4;g.z=v.model_z+v.body_height+.05;}
else
{
double lf=g.vx*sine(rad)+g.vy*cosine(rad),ls=g.vx*cosine(rad)-g.vy*sine(rad);
if(from_end<from_side)lf=-lf*.45;else ls=-ls*.45;
g.vx=sine(rad)*lf+cosine(rad)*ls;g.vy=cosine(rad)*lf-sine(rad)*ls;
}
g.bounces++;play("metalfall",int(g.x),int(g.y),int(g.z),g.map);return true;
}
// People: early in flight the thrower cannot hit themself.
for(uint pi=0;pi<players.length();pi++)
{
player@ t=players[pi];if(t.map!=g.map or t.death or t.in_plane)continue;if(t.name==g.owner and g.flight_time.elapsed<400)continue;
double dz=nz-double(t.z);if(dz<0 or dz>1.9)continue;
if(get_3d_distance(nx,ny,0,t.x,t.y,0)>.42)continue;
if(g.last_struck==t.name)continue;g.last_struck=t.name;
if(item_flag(g.kind,"sticky")){g.stuck_to=t.name;g.landed=true;g.vx=0;g.vy=0;g.vz=0;send_reliable(t.peer_id,"Something sticks to you!",2);return false;}
g.vx*=-.15;g.vy*=-.15;g.vz=0;g.bounces++;play("bodyfall",int(t.x),int(t.y),int(t.z),t.map);
send_reliable(t.peer_id,"Something hits you and drops at your feet.",2);
return true;
}
g.x=nx;g.y=ny;
// Water.
string here=get_tile_at(int(round(g.x,0)),int(round(g.y,0)),int(floor(nz)),g.map);
if(blast_tile_water(here) and !g.in_water){g.in_water=true;g.splashed=true;g.vx*=.3;g.vy*=.3;play("waterland",int(g.x),int(g.y),int(g.z),g.map);}
// The ground.
double surface=projectile_surface_height(g.x,g.y,nz,g.map);
if(nz<=0 or (g.vz<=0 and surface>-9000 and nz<=surface+.12))
{
string ground=get_tile_at(int(round(g.x,0)),int(round(g.y,0)),int(floor(surface<-9000?0:surface)),g.map);
surface_physics@ s=surface_of(ground);
g.z=nz<0?0:surface+.1;
if(s.water or g.in_water){g.landed=true;g.vx=0;g.vy=0;g.vz=0;return false;}
double impact=-g.vz;
// Bounce up if it hit hard enough; otherwise it is rolling.
if(impact>1.2){g.vz=impact*s.restitution;g.bounces++;play(grenade_landing_sound(g),int(g.x),int(g.y),int(g.z),g.map);}else g.vz=0;
// Friction: a share of the speed on impact, then rolling resistance.
double speed=sqrt(g.vx*g.vx+g.vy*g.vy);
double loss=s.friction*9.81*dt*2.5+(impact>1.2?impact*s.friction*.25:0);
if(speed<=loss){g.vx=0;g.vy=0;}else{g.vx*=(speed-loss)/speed;g.vy*=(speed-loss)/speed;}
// Slopes pull it downhill.
double slope_x=0,slope_y=0;projectile_surface_gradient(g.x,g.y,g.z,g.map,slope_x,slope_y);g.vx-=slope_x*9.81*dt;g.vy-=slope_y*9.81*dt;
if(item_flag(g.kind,"sticky") and impact>.5){g.landed=true;g.vx=0;g.vy=0;g.vz=0;return false;}
if(g.vz==0 and absolute(g.vx)+absolute(g.vy)<.05 and absolute(slope_x)+absolute(slope_y)<.08){g.landed=true;g.vx=0;g.vy=0;return false;}
}
else g.z=nz;
return true;
}

void fraggrenadeloop()
{
for(int i=int(fraggrenades.length())-1;i>=0;i--)
{
fraggrenade@ g=fraggrenades[i];
if(g.held_peer>=0)update_held_grenade(g);
// An explosive loose inside a vehicle rides along with it.
if(g.held_peer<0 and g.inside_vehicle>=0){int iv=find_authoritative_vehicle(g.inside_vehicle,g.map);if(iv>=0){authoritative_vehicle@ cv=authoritative_vehicles[iv];update_authoritative_vehicle_model(cv);g.x=cv.model_x;g.y=cv.model_y;g.z=cv.model_z+.6;}}
// Something stuck to a person goes where they go.
if(g.stuck_to!=""){int carrier=get_player_index_from(g.stuck_to);if(carrier>=0 and players[carrier].map==g.map and !players[carrier].death){g.x=players[carrier].x;g.y=players[carrier].y;g.z=players[carrier].z+1.0;}}
if(!g.landed and g.simulationtimer.elapsed>0)
{
double elapsed=double(g.simulationtimer.elapsed)/1000.0;g.simulationtimer.restart();if(elapsed>.05)elapsed=.05;
int steps=8;if(g.momentum_rolling){steps=int(ceil(sqrt(g.vx*g.vx+g.vy*g.vy+g.vz*g.vz)*elapsed/.15));if(steps<8)steps=8;if(steps>256)steps=256;}double dt=elapsed/double(steps);
for(int step=0;step<steps;step++)if(!grenade_step(g,dt))break;
if(g.audio_id>=0 and g.audio_update_timer.elapsed>=50){g.audio_update_timer.restart();send_unreliable_map(g.map,"projectile_audio_move "+g.audio_id+" "+g.x+" "+g.y+" "+g.z+" "+g.map,0);}
}
if(g.landed and g.audio_id>=0){send_reliable_map(g.map,"projectile_audio_stop "+g.audio_id,0);g.audio_id=-1;}
bool impact_fuse=item_flag(g.kind,"impact_fuse") or g.kind=="impact_grenade";
if(g.momentum_rolling){if(!g.rolling_detonate and g.explodetimer.elapsed<120000)continue;}
else if(int(g.explodetimer.elapsed)<g.fuse and !(impact_fuse and g.bounces>0))continue;
if(g.audio_id>=0)send_reliable_map(g.map,"projectile_audio_stop "+g.audio_id,0);
blast_profile@ b=blast_profile_for(g.kind,g.owner);b.inside_vehicle=g.inside_vehicle;b.blast_dir=g.blast_dir;
if(g.momentum_rolling){double power=bowling_bomb_power(g);b.damage=int(b.damage*power);b.fragment_damage=int(b.fragment_damage*power);}
if(g.held_peer>=0){int holder=get_player_index(g.held_peer);if(holder>=0){send_reliable(g.held_peer,"give "+g.kind+" -1",0);players[holder].fraggrenadetimer.restart();send_reliable(g.held_peer,"grenade_finished "+g.kind+" detonated",0);}}
fraggrenades.remove_at(i);
detonate(g.x,g.y,g.z,g.map,b);
}
}
// Wind. Each map has a breeze that wanders slowly in strength and direction
// and carries anything thrown while it is in the air.
class map_wind{string map;double x=0,y=0;timer changed;}
map_wind@[] map_winds;
map_wind@ wind_for(string map)
{
for(uint i=0;i<map_winds.length();i++)if(map_winds[i].map==map)
{
map_wind@ w=map_winds[i];if(w.changed.elapsed>=20000){w.changed.restart();w.x+=double(random(-15,15))/10.0;w.y+=double(random(-15,15))/10.0;double strength=sqrt(w.x*w.x+w.y*w.y);if(strength>7){w.x*=7/strength;w.y*=7/strength;}}
return w;
}
map_wind w;w.map=map;double heading=double(random(0,359))*3.14159265358979323846/180.0,strength=double(random(0,40))/10.0;w.x=sine(heading)*strength;w.y=cosine(heading)*strength;map_winds.insert_last(w);return map_winds[map_winds.length()-1];
}
string wind_report(string map)
{
map_wind@ w=wind_for(map);double strength=sqrt(w.x*w.x+w.y*w.y);if(strength<1.5)return "";
double heading=atan2(w.x,w.y)*180.0/3.14159265358979323846;if(heading<0)heading+=360;string[] names={"north","north-east","east","south-east","south","south-west","west","north-west"};
return "Wind "+int(round(strength,0))+" tiles a second toward the "+names[int(round(heading/45.0,0))%8]+".";
}
// The vehicle a player is sitting in, and their seat; -1 when on foot.
int occupied_vehicle_index(string name,string map,int &out seat)
{
for(uint i=0;i<authoritative_vehicles.length();i++){if(authoritative_vehicles[i].map!=map or authoritative_vehicles[i].health<=0)continue;for(uint s=0;s<authoritative_vehicles[i].occupants.length();s++)if(authoritative_vehicles[i].occupants[s]==name){seat=int(s);return int(i);}}
seat=-1;return -1;
}
// A blast inside a closed vehicle: everyone aboard takes all of it, the hull
// takes twice it, and everyone outside is shielded from half of it.
void cabin_blast(authoritative_vehicle@ v,string owner,string label,int radius,int damage,string sound,string distant)
{
blast_profile@ b=blast_profile_simple(owner,owner+"'s "+label,damage,radius,300,sound,distant,"fraggrenadehit");b.inside_vehicle=v.id;
detonate(v.model_x,v.model_y,v.model_z+.6,v.map,b);
}
// What happens when a hand weapon is fired from inside a vehicle, by the
// weapon's vehicle_use. Returns true when the shot never leaves the vehicle.
bool vehicle_weapon_mishap(int index,string wname)
{
player@ p=players[index];int seat=-1,vi=occupied_vehicle_index(p.name,p.map,seat);if(vi<0)return false;
int si=find_wpn_stats(wname);if(si<0)return false;wpn_server_stats@ st=wpn_stats_cache[si];
authoritative_vehicle@ v=authoritative_vehicles[vi];update_authoritative_vehicle_model(v);string name=st.name!=""?st.name:wname;
if(string_contains(st.wclass,"melee",1)==0 or st.wclass=="tool" or st.vehicle_use=="forbidden"){send_reliable(p.peer_id,"The "+name+" cannot be used from a vehicle seat.",2);return true;}
if(st.vehicle_use=="cabin_detonation")
{
// The bomb leaves the tube and meets the roof.
for(uint s=0;s<v.occupants.length();s++){int occupant=get_player_index_from(v.occupants[s]);if(occupant>=0)send_reliable(players[occupant].peer_id,"The "+name+" round strikes the roof of the "+v.type+".",2);}
cabin_blast(v,p.name,name+", fired inside a "+v.type,st.explosive_radius>0?int(st.explosive_radius):12,st.blast_damage>0?st.blast_damage:st.maxdammage,st.explosion_sound!=""?st.explosion_sound:"120mm_mortarexplode",st.explosion_distant!=""?st.explosion_distant:"120mm_mortarexplodedist.ogg");
return true;
}
if(st.vehicle_use=="backblast")
{
// The rocket leaves; its backblast stays in the cabin with everyone in it.
for(uint s=0;s<v.occupants.length();s++){int occupant=get_player_index_from(v.occupants[s]);if(occupant<0)continue;send_reliable(players[occupant].peer_id,"The backblast of the "+name+" fills the cabin.",2);apply_player_damage(players[occupant],320,p.name+"'s "+name+" backblast");}
damage_authoritative_vehicle(v,200,index,"the backblast of a "+name);
return false;
}
if(st.vehicle_use=="cabin_fire")
{
// Flame in a closed space sets the cabin, and everyone in it, alight.
for(uint s=0;s<v.occupants.length();s++){int occupant=get_player_index_from(v.occupants[s]);if(occupant<0)continue;players[occupant].burning=true;players[occupant].burning_owner=p.name;players[occupant].burning_duration_timer.restart();players[occupant].burning_tick_timer.restart();send_reliable(players[occupant].peer_id,"The cabin of the "+v.type+" catches fire!",2);}
damage_authoritative_vehicle(v,40,index,"set alight by a "+name);
return false;
}
return false;
}
// cabin is "foot", "window" (thrown out of an open window) or "cabin" (let go
// of inside a closed vehicle). A throw from a window starts just outside it
// and keeps the vehicle's speed and direction on top of the throw. An
// explosive let go of in a closed cabin stays in there with the occupants.
void spawn_fraggrenade(double x,double y,int z,double dir,string map,string owner,string kind="frag_grenade",int aim=90,int cooked_ms=0,string cabin="foot")
{
fraggrenade e1(x,y,z,dir,map,owner,kind,true,aim,cooked_ms);
int seat=-1,vi=occupied_vehicle_index(owner,map,seat);int pi=get_player_index_from(owner);
if(vi>=0)
{
authoritative_vehicle@ v=authoritative_vehicles[vi];update_authoritative_vehicle_model(v);double rad=v.facing*3.14159265358979323846/180.0;
if(cabin=="window")
{
double forward=v.body_length*.27-double(seat/2)*1.35,side=(seat%2==0?-1.0:1.0)*(v.body_width*.5+.5);
e1.x=v.model_x+sine(rad)*forward+cosine(rad)*side;e1.y=v.model_y+cosine(rad)*forward-sine(rad)*side;e1.z=v.model_z+1.2;
e1.vx+=sine(rad)*v.velocity;e1.vy+=cosine(rad)*v.velocity;
}
else
{
e1.inside_vehicle=v.id;e1.landed=true;e1.vx=0;e1.vy=0;e1.vz=0;e1.x=v.model_x;e1.y=v.model_y;e1.z=v.model_z+.6;
if(e1.momentum_rolling)e1.rolling_detonate=true;
for(uint s=0;s<v.occupants.length();s++){int occupant=get_player_index_from(v.occupants[s]);if(occupant>=0)send_reliable(players[occupant].peer_id,"A live "+string_replace(kind,"_"," ",true)+" is loose inside the "+v.type+"!",2);}
}
}
if(pi>=0 and e1.inside_vehicle<0){string wind=wind_report(map);if(wind!="")send_reliable(players[pi].peer_id,wind,2);}
e1.audio_id=next_projectile_audio_id++;if(next_projectile_audio_id>900000)next_projectile_audio_id=500000;e1.audio_update_timer.restart();string loop=item_prop(kind,"flight_loop",explosive_audio_prefix(kind)+"_flight_loop.ogg");send_reliable_map(e1.map,"projectile_audio_start "+e1.audio_id+" "+loop+" "+e1.x+" "+e1.y+" "+e1.z+" "+e1.map+" "+e1.owner+" "+(item_flag(kind,"flight_mandatory")?"world":"optional")+" "+item_prop_number(kind,"flight_volume_db",0),0);
fraggrenades.insert_last(e1);
}

deployable_explosive@[] deployable_explosives;
class deployable_explosive
{
int x,y,z,dir,arming_ms=1200;double sensor_mult=1;string map,owner,kind;timer armed_timer;timer life_timer;timer trigger_timer;bool triggered=false;
int vehicle_id=-1; // a charge placed inside a vehicle travels with it
deployable_explosive(int px,int py,int pz,int pdir,string pmap,string powner,string pkind){x=px;y=py;z=pz;dir=pdir;map=pmap;owner=powner;kind=pkind;arming_ms=item_prop_int(kind,"arming_ms",1200);play(item_prop(kind,"place_sound",explosive_audio_prefix(kind)+"_place"),x,y,z,map);string countdown=item_prop(kind,"countdown_sound");if(countdown!="")play(countdown,x,y,z,map);}
}
void detonate_deployable(int index)
{
deployable_explosive@ d=deployable_explosives[index];deployable_explosives.remove_at(index);
blast_profile@ b=blast_profile_for(d.kind,d.owner);b.inside_vehicle=d.vehicle_id;
if(item_prop(d.kind,"sensor_kind")=="directional")b.blast_dir=d.dir;
detonate(d.x,d.y,double(d.z)+.3,d.map,b);
}
void deployable_explosive_loop()
{
for(int i=int(deployable_explosives.length())-1;i>=0;i--)
{
deployable_explosive@ d=deployable_explosives[i];if(d.vehicle_id>=0){int dv=find_authoritative_vehicle(d.vehicle_id,d.map);if(dv>=0){authoritative_vehicle@ carrier=authoritative_vehicles[dv];update_authoritative_vehicle_model(carrier);d.x=int(round(carrier.model_x,0));d.y=int(round(carrier.model_y,0));d.z=int(round(carrier.model_z,0));}}int timed=item_prop_int(d.kind,"detonate_ms");if(timed>0 and d.life_timer.elapsed>=timed){detonate_deployable(i);continue;}int trigger_delay=item_prop_int(d.kind,"trigger_delay_ms");if(d.triggered and trigger_delay>0 and d.trigger_timer.elapsed>=trigger_delay){detonate_deployable(i);continue;}if(d.armed_timer.elapsed<d.arming_ms)continue;
int owner_index=get_player_index_from(d.owner);bool triggered=false;
double sensor=item_prop_number(d.kind,"sensor_radius",3.2)*d.sensor_mult;string sensor_kind=item_prop(d.kind,"sensor_kind","proximity");
if(sensor_kind=="timer")continue;
// Anti-vehicle mines (vehicle_only=true) ignore people on foot.
bool vehicle_only=item_flag(d.kind,"vehicle_only");
for(uint pidx=0;pidx<players.length() and !vehicle_only;pidx++)
{
// The owner is not immune to a live proximity device.  Team protection still
// applies to other teammates, but walking back into your own armed mine or
// claymore must trigger the same blast that can already damage its owner.
// Sensors are three-dimensional: someone on another floor, or flying
// overhead, no longer sets off a mine below them, and arena spectators can
// no longer trigger devices they are immune to.
player@ target=players[pidx];if(target.death or target.in_plane or target.map!=d.map or absolute(double(target.z-d.z))>2.0 or !player_can_be_damaged_by(target,d.owner) or (target.name!=d.owner and owner_index>=0 and same_team(players[owner_index].name,target.name)))continue;double dx=double(target.x-d.x),dy=double(target.y-d.y),distance=sqrt(dx*dx+dy*dy);
if(sensor_kind=="directional"){if(distance<=sensor){double radians=double(d.dir)*3.14159265358979323846/180.0,dot=dx*sine(radians)+dy*cosine(radians);if(dot>distance*item_prop_number(d.kind,"sensor_cone",.55))triggered=true;}}
else if(distance<=sensor)triggered=true;
if(triggered)break;
}
// Vehicles set off proximity mines when their body passes over the sensor.
// Previously nothing a vehicle did could trigger any mine, including the
// Heavy Anti-vehicle Mine.
if(!triggered and sensor_kind!="directional")for(uint vi=0;vi<authoritative_vehicles.length();vi++){authoritative_vehicle@ v=authoritative_vehicles[vi];if(v.map!=d.map or v.health<=0 or absolute(v.model_z-double(d.z))>2.0)continue;double reach=sensor+v.body_width*.5;if(get_3d_distance(v.model_x,v.model_y,0,d.x,d.y,0)<=reach){triggered=true;break;}}
if(triggered)
{
// trigger_delay_ms is honoured by every sensor kind. It used to apply only
// to countdown charges, so the authored delays on other mines did nothing.
int delay=item_prop_int(d.kind,"trigger_delay_ms");
if(delay>0 and !d.triggered){d.triggered=true;d.trigger_timer.restart();if(sensor_kind=="delayed" or item_prop(d.kind,"trigger_sound")!="")play(item_prop(d.kind,"trigger_sound","er_motion_bomb_countdown"),d.x,d.y,d.z,d.map);}
else if(delay<=0){string trigger=item_prop(d.kind,"detonate_sound");if(trigger!="")play(trigger,d.x,d.y,d.z,d.map);detonate_deployable(i);}
}
}
}
void spawn_deployable_explosive(int x,int y,int z,int dir,string map,string owner,string kind){deployable_explosive d(x,y,z,dir,map,owner,kind);int seat=-1,vi=occupied_vehicle_index(owner,map,seat);if(vi>=0){d.vehicle_id=authoritative_vehicles[vi].id;for(uint s=0;s<authoritative_vehicles[vi].occupants.length();s++){int occupant=get_player_index_from(authoritative_vehicles[vi].occupants[s]);if(occupant>=0)send_reliable(players[occupant].peer_id,"A "+string_replace(kind,"_"," ",true)+" has been armed inside the vehicle.",2);}}deployable_explosives.insert_last(d);}
