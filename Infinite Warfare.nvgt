{
int damage=string_to_number(parsed[1]),distance=string_to_number(parsed[2]);double speed=string_to_number(parsed[3]);
if(damage>0)speak("Fall impact: "+distance+" vertical units at "+round(speed,1)+" meters per second; "+damage+" damage.");
}
else if(parsed[0]=="land")
{
int x=string_to_number(parsed[2]);
int y=string_to_number(parsed[3]);
int z=string_to_number(parsed[4]);
string map=parsed[5];
if(parsed[1]!=name and map==mapname)
{
p.play_3d(surface_land_sound(get_tile_at(x, y, z)), me.x, me.y, me.z, x, y, z, calculate_theta(facing), false);
}
