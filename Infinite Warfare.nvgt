bool capture_service_response(string message)
{
string[] prefixes={"ticket_role_","ticket_created","ticket_mylist ","ticket_alllist ","ticket_data ","ticket_closed","ticket_replied","feedback_role_","feedback_created","feedback_mylist ","feedback_alllist ","feedback_data ","feedback_closed","feedback_replied","bug_role_","bug_created","bug_mylist ","bug_alllist ","bug_data ","bug_flagged","market_balance ","market_purchase_","er_purchase_","er_credit_"};for(uint i=0;i<prefixes.length();i++)if(string_contains(message,prefixes[i],1)==0){service_response_queue.insert_last(message);if(service_response_queue.length()>64)service_response_queue.remove_at(0);return true;}return false;
}
bool wait_for_service_response(string prefix,string &out response,int timeout_ms=3000)
{
timer timeout;while(connected and timeout.elapsed<timeout_ms){for(uint i=0;i<service_response_queue.length();i++)if(string_contains(service_response_queue[i],prefix,1)==0){response=service_response_queue[i];service_response_queue.remove_at(i);return true;}wait(5);netloop(false);}return false;
}
string af_input(string title, string text="", bool online=false)
{
// NV_form now owns text entry on every platform, including Android. This keeps
// gesture navigation and the network/game pump alive while the field is open.
iw_form af;
af.create_window(title, false, true);
int af_n=af.create_input_box(title, text, "", 0, false, false, false);
int af_ok=af.create_button("&OK", true);
int af_cancel=af.create_button("&Cancel", false, true);
af.focus(af_n);
while(true)
{
wait(5);
af.monitor();
if(online==true)
{
mainloop();
netloop();
update_all_listeners();
}
if(af.is_pressed(af_cancel))
return "";
if(af.is_pressed(af_ok))
return af.get_text(af_n);
}
return "";
}
string webdir;
string gamename="Infinite Warfare";
string game_window_title(){return gamename+"!, version "+version_name+", build "+build_number+" ("+build_date+")";}
bool set_fullscreen_mode(bool enabled,bool announce=true)
{
uint flags=enabled?WINDOW_FLAG_FULLSCREEN:0;
game_window@ changed_window=show_window(game_window_title(),flags);
if(@changed_window==null){if(announce)speak("Unable to change the game window mode.");return false;}
set_window_fullscreen(enabled);
fullscreen_enabled=enabled;focus_window();
if(@iw_mouse!=null)iw_mouse.full_screen(fullscreen_enabled or helper_mouse_confined);
if(announce)speak(fullscreen_enabled?"Full screen enabled.":"Full screen disabled. Windowed mode enabled.");
return true;
}
void toggle_fullscreen_mode(){if(set_fullscreen_mode(!fullscreen_enabled,true))writeprefs();}
void process_fullscreen_shortcut()
{
bool ctrl=key_down(KEY_LCONTROL) or key_down(KEY_RCONTROL),shift=key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT);
if(ctrl and shift and key_up(KEY_LMENU) and key_up(KEY_RMENU) and action_pressed("fullscreen_toggle"))toggle_fullscreen_mode();
}
process@ screenshot_process;
bool screenshot_pending=false;
string screenshot_path="",screenshot_status_path="";
timer screenshot_timeout;
void poll_game_screenshot()
{
if(!screenshot_pending)return;
if(file_exists(screenshot_status_path))
{
file status;string result="error";if(status.open(screenshot_status_path,"rb")){result=status.read().trim_whitespace();status.close();}file_delete(screenshot_status_path);bool success=result=="ok" and file_exists(screenshot_path);screenshot_pending=false;@screenshot_process=null;speak(success?"Screenshot saved to the screenshots folder.":"The screenshot could not be saved.");return;
}
if(screenshot_timeout.elapsed>15000){screenshot_pending=false;@screenshot_process=null;speak("The screenshot operation timed out without pausing the game.");}
}
void take_game_screenshot()
{
if(screenshot_pending){speak("A screenshot is already being saved.");return;}string folder=SCRIPT_MAIN_PATH+"/screenshots";if(!directory_exists(folder) and !directory_create(folder)){speak("The screenshots folder could not be created.");return;}screenshot_path=folder+"/infinite_warfare_"+ticks()+".png";screenshot_status_path=screenshot_path+".status";file_delete(screenshot_status_path);
if(system_is_mobile){string safe_path=string_replace(screenshot_path,"'","'\\''",true),safe_status=string_replace(screenshot_status_path,"'","'\\''",true);string shell_command="/system/bin/screencap -p '"+safe_path+"' && echo ok > '"+safe_status+"' || echo error > '"+safe_status+"'";string[] args={"/system/bin/sh","-c",shell_command};@screenshot_process=run(args,PROCESS_BACKGROUND,SCRIPT_MAIN_PATH);}
else if(system_is_windows){string safe=string_replace(screenshot_path,"'","''",true),safe_status=string_replace(screenshot_status_path,"'","''",true);string command="try { Add-Type -AssemblyName System.Windows.Forms; Add-Type -AssemblyName System.Drawing; $bounds=[System.Windows.Forms.Screen]::PrimaryScreen.Bounds; $bitmap=New-Object System.Drawing.Bitmap $bounds.Width,$bounds.Height; $graphics=[System.Drawing.Graphics]::FromImage($bitmap); $graphics.CopyFromScreen($bounds.Location,[System.Drawing.Point]::Empty,$bounds.Size); $bitmap.Save('"+safe+"',[System.Drawing.Imaging.ImageFormat]::Png); $graphics.Dispose(); $bitmap.Dispose(); [IO.File]::WriteAllText('"+safe_status+"','ok') } catch { [IO.File]::WriteAllText('"+safe_status+"','error') }";string[] args={"powershell.exe","-NoProfile","-NonInteractive","-WindowStyle","Hidden","-Command",command};@screenshot_process=run(args,PROCESS_BACKGROUND,SCRIPT_MAIN_PATH);}
else{speak("Screenshots are not supported on this operating system.");return;}
if(@screenshot_process==null or !screenshot_process.valid){@screenshot_process=null;speak("The screenshot process could not be started.");return;}screenshot_pending=true;screenshot_timeout.restart();speak("Saving screenshot in the background.");
}
void process_screenshot_shortcut(){poll_game_screenshot();if(action_pressed("screenshot"))take_game_screenshot();}
