// Items have no operating "modes" any more. 0.5.7 removed the generic
// three-way configuration (Alt+Shift+M) that every explosive, medicine, decoy
// and smoke bomb shared: for healing items the top setting was simply better,
// for decoys and smoke it did nothing at all, and a throw's strength belongs
// to how you aim it. Throws now follow your vertical aim, and medication
// takes its recommended dose.
dictionary client_medication_remaining;
string cooked_grenade="";timer cooked_grenade_timer;int cooked_grenade_warning_stage=0;
int cooked_grenade_fuse=0;bool cooked_grenade_releasing=false;
// item_is_thrown_explosive() reads the item's "thrown" flag (item_data.nvgt).
string armour_names_list(string[]@ ids)
{
string[] names;
for(uint k=0;k<ids.length();k++){item_data@ d=item_info(ids[k]);names.insert_last(d is null?string_replace(ids[k],"_"," ",true):d.name);}
return content_join(names);
}
// item_is_launched_explosive() now reads the item's "launched" flag (item_data.nvgt).
int grenade_fuse_ms(string i){return explosive_fuse_ms(i);}
string grenade_pin_audio(string item){string audio_name=item_prop(item,"pin_sound","ammo_cycle");if(!audio_name.ends_with(".ogg") and !audio_name.ends_with(".wav"))audio_name+=".ogg";return audio_name;}
bool grenade_pin_or_throw(string item)
{
if(!item_is_thrown_explosive(item))return false;
if(item_flag(item,"momentum_rolling")){if(cooked_grenade!=""){speak("Throw the grenade you are holding first.");return true;}send_reliable(0,explosive_use_command(item),0);return true;}
if(cooked_grenade==""){cooked_grenade=item;cooked_grenade_warning_stage=0;cooked_grenade_fuse=grenade_fuse_ms(item);cooked_grenade_releasing=false;cooked_grenade_timer.restart();send_reliable(0,"grenade_pin "+item,0);p.play_stationary(grenade_pin_audio(item),false);speak("Pin pulled from "+string_replace(item,"_"," ",true)+". Press enter again to throw. The fuse is running.");return true;}
if(cooked_grenade!=item){speak("You are already cooking a "+string_replace(cooked_grenade,"_"," ",true)+". Return to it before selecting another grenade.");return true;}
if(!cooked_grenade_releasing){cooked_grenade_releasing=true;send_reliable(0,"grenade_release "+item+" "+turn+" "+explosive_throw_cabin(),0);}return true;
}
// The server owns the fuse, including expiry while a dialog is open. Never
// turn a held expiry into a new throw or discard an unacknowledged grenade.
void grenade_cook_loop(){if(cooked_grenade=="" or cooked_grenade_releasing)return;int remaining=cooked_grenade_fuse-int(cooked_grenade_timer.elapsed);if(remaining<=1000 and cooked_grenade_warning_stage<1){cooked_grenade_warning_stage=1;p.play_stationary("clock1.ogg",false);}if(remaining<=500 and cooked_grenade_warning_stage<2){cooked_grenade_warning_stage=2;p.play_stationary("clock2.ogg",false);}}
bool handle_grenade_packet(string message)
{
string[] parts=string_split(message," ",false);
if(parts.length()<2)return false;
if(parts[0]=="grenade_armed"){if(parts.length()>2 and cooked_grenade==parts[1]){cooked_grenade_fuse=int(string_to_number(parts[2]));cooked_grenade_timer.restart();}return true;}
if(parts[0]!="grenade_finished")return false;
if(cooked_grenade==parts[1]){if(parts.length()>2 and parts[2]=="detonated")speak("The grenade detonates in your hand!");else if(parts.length()>2 and parts[2]=="released")speak(explosive_release_report(cooked_grenade,int(cooked_grenade_timer.elapsed)));cooked_grenade="";cooked_grenade_releasing=false;cooked_grenade_warning_stage=0;}
return true;
}
bool item_is_liquid_medication(string i){return medication_form(i)=="liquid";}
bool item_is_pill_bottle(string i){return medication_form(i)=="pills";}
bool item_is_loose_pill(string i){return medication_form(i)=="loose_pill";}
bool item_is_medication(string i){return item_is_liquid_medication(i) or item_is_pill_bottle(i) or item_is_loose_pill(i);}
double medication_container_capacity(string i){return medication_capacity(i);}
double medication_amount_remaining(string i){double amount;if(client_medication_remaining.get(i,amount))return amount;return medication_container_capacity(i);}
bool item_is_medical(string i){return item_is_medication(i) or i=="life_injection" or i=="adrenaline_syringe";}
string medication_recommended_dose(string i){if(item_is_liquid_medication(i))return "Recommended dose: "+medication_recommended(i)+" fluid ounces";if(item_is_pill_bottle(i) or item_is_loose_pill(i)){int n=int(medication_recommended(i));return "Recommended dose: "+n+" pill"+(n==1?"":"s");}return "";}
bool item_category_is(string i,string category){item_data@ d=item_info(i);return d !is null and string_to_lower_case(d.category)==string_to_lower_case(category);}
bool item_is_vehicle_supply(string i){return item_category_is(i,"Vehicle Supplies");}
string item_mechanic_description(string i)
{
string detail="";
if(item_flag(i,"momentum_rolling"))detail="Throw immediately with Enter. A level throw travels furthest, about 120 tiles; steeper throws approach 90 tiles. Gains rolling speed and damage with travel, falls off ledges, slows on landing, and reverses downhill on ramps. Collisions detonate it, including hitting you on the return trip. It has no cookable fuse.";
else if(item_is_thrown_explosive(i))detail="Uses continuous three-dimensional throw physics, bounce, drag, gravity, a payload-specific fuse and distance-scaled effects. Aim level for an ordinary arcing throw, up to lob it high and far, or down to drop or roll it short.";
else if(item_is_launched_explosive(i))detail="Uses a dedicated heavy three-dimensional flight profile with continuous positional loop audio, physical bounce, drag and gravity. The launch angle follows your vertical aim; payload size determines fuse, blast radius and damage.";
else if(item_is_deployable_explosive(i))detail="Placement retains facing, owner and team safety. It arms after its authored delay and watches its authored sensor area.";
else if(i=="c4")detail="Places a persistent owner-tracked remote charge; the controller reports active charges and detonates them as a group.";
else if(i=="semtex" or i=="semtex_pack" or i=="semtex_controller")detail="Forms part of the adhesive-charge workflow: components are placed, tracked and remotely controlled rather than behaving like an ordinary grenade.";
else if(i=="torpedo")detail="Uses a dedicated anti-vehicle delivery and damage role rather than a general fragmentation blast.";
else if(i=="smoke_bomb")detail="Creates a timed concealment screen that hides the people inside it.";
else if(i=="bunker_bomb")detail="A restricted demolition payload whose use is tied to bunker structures and access rules.";
else if(i=="rock")detail="A reusable low-mass thrown distraction. It goes where you aim it.";
else if(i=="bomb_vest")detail="Occupies the body slot, contributes twelve units of equipment weight and mitigates explosive damage while equipped.";
else if(item_is_vehicle_supply(i))detail="Belongs to the physical vehicle workshop system. Fuels retain their type and volume; service tools are reusable; fluids, filters, repair parts and flushes are consumed by their matching timed operation; refit packages alter the installed vehicle's live condition, capacity, protection, mass, traction or performance.";
else if(is_armour_patch(i))detail="Repairs "+armour_names_list(item_prop_list(i,"repairs"))+". A consumable field patch for a compatible equipped armour construction. It restores only a small amount and cannot raise damaged armour above sixty percent durability; proper replacement remains necessary.";
else if(armour_slot(i)!="")detail="Covers the "+(armour_slot(i)=="arm"?"arms":(armour_slot(i)=="leg"?"legs":armour_slot(i)))+": stops "+armour_rating(i)+" percent of each hit there, with "+armour_durability(i)+" durability and "+armour_weight(i)+" units of weight. Occupies its anatomical armour slot. Only hits to that body region consume its durability and receive protection; mass affects movement and jumping.";
else if(item_is_medication(i))detail=(item_is_liquid_medication(i)?"A multi-dose medication bottle. Each use drinks the recommended dose, or what is left; the bottle stays until it is empty.":(item_is_pill_bottle(i)?"A multi-dose pill bottle. Each use swallows the recommended number of pills; use "+kb_binding_label("extract_pill")+" to take a single pill out of the bottle.":"A single pill, taken by itself."))+" "+medication_recommended_dose(i)+". Repeated doses build toxicity.";
else if(i=="life_injection")detail="Requires a downed teammate within four tiles, locks the administration sequence, and revives them with half of their health.";
else if(i=="adrenaline_syringe")detail="Starts a short emergency movement and stamina state rather than applying ordinary healing.";
else if(i=="bucket" or i=="empty_bucket" or i=="water_tank")detail="Participates in a physical water-transfer loop: fill an empty bucket while standing in water, carry it, and empty it into a colocated tank over time.";
else if(i=="translocator")detail="Consumes stored cell charge to move to a selected valid point of interest through its dedicated interface.";
else if(i=="translocator_cell")detail="Adds finite charge to the translocator rather than acting as generic ammunition.";
else if(i=="repair_kit")detail="Patches the hull of the vehicle you are sitting in or standing beside, restoring up to 150 health. It cannot rebuild a destroyed vehicle.";
else if(i=="biomonitor_bracelet")detail="Occupies the bracelet slot and supplies a movable quickbar scan ability with a server-validated radius and cooldown.";
else if(i=="wirenet")detail="Occupies the medical slot and supplies a movable quickbar ability controlling three automatic emergency-heal charges.";
else if(i=="hypercomp")detail="A session-bound smart terminal with finite storage, replaceable operating systems, downloadable applications, marketplace access, secure banking and its original bunker controls. Installed software and storage expansions belong to this physical terminal and are lost with it on death.";
else if(i=="binoculars")detail="Provides non-consuming reconnaissance of zones and points of interest.";
else if(i=="hightech_grapple")detail="A reusable traversal tool that searches ten tiles forward for a solid anchor, attaches to the first valid wall, verifies every traversed tile and pulls the user to the last safe tile. It has an eight-second mechanical recovery.";
else if(i=="grapple_line_cartridge")detail="A replacement high-tensile spool retained as service stock for the grapple instead of being used as a generic consumable.";
else if(i=="anti_personnel_security_camera")detail="A reusable sixty-tile hostile-motion scan. It reports the closest contact and count, plays an alarm only when a target is acquired and observes a thirty-second sensor cooldown.";
else if(i=="neural_intrusion_device")detail="A consumable close-range electronic weapon. It acquires the nearest hostile within twelve tiles and disrupts motor control for ten seconds; a failed acquisition does not consume it.";
else if(i=="field_restraints")detail="Electronic restraints can be fitted only to a hostile within two tiles whose health is critically low. A successful fitting consumes the restraint and imposes a twenty-second movement disruption.";
else if(i=="reconnaissance_ring")detail="A reusable wearable transponder that reports nearby friendly and hostile signatures after a short ten-second recovery.";
else if(i=="portable_auction_terminal")detail="Legacy commerce hardware. Using it permanently upgrades it into the unified HyperComp Smart Terminal; Marketplace, App Store, Secure Banking and market tools now run as terminal applications instead of requiring a second device.";
else if(i=="salvage_scanner")detail="Reusable twenty-five-second salvage scanner that recovers a vehicle component or repair kit from surrounding debris.";
else if(i=="security_radio_receiver" or i=="field_television_receiver")detail="Reusable tactical receiver that reports friendly and hostile activity on the current map.";
else if(i=="overdrive_amplifier")detail="Single-use twenty-second ballistic overdrive. It amplifies outgoing projectile energy, announces depletion, and remains subject to the global no-one-shot damage cap.";
else if(item_prop(i,"use_kind")=="companion")detail="Deploys a persistent server-authoritative "+item_prop(i,"companion_kind")+" with "+item_prop_int(i,"companion_health")+" health. It physically travels, follows you and attacks using the range, damage, speed, cooldown and sounds defined in this item's data file. A Companion Command Remote can set follow, stay, guard, seek-and-attack or recall modes, report telemetry, or let you pilot it directly.";
else if(i=="companion_command_remote")detail="Reusable controller for every deployed drone and bioengineered chimp. It reports each companion's health, mode, map and coordinates, issues autonomous commands, recalls units, and supports direct piloting with perception, facing, coordinates and the sound listener transferred to the companion until Escape returns you to your body.";
else if(string_contains(i,"er_",1)==0)detail="Executioner's Rage field content with a dedicated server-authoritative consumption, recovery, credit, or combat effect and purpose-specific authored audio.";
else if(i=="locker_access_module")detail="A persistent encrypted access credential checked by compatible secured lockers; it is never consumed as a generic item.";
else if(i=="bunker_key")detail="A persistent access credential checked by bunker interactions rather than consumed as a generic item.";
else if(i=="fake_item")detail="Places a cooldown-limited owner decoy.";
else if(string_contains(i,"team_",1)==0 or i=="duo_plane_kit")detail="Requires team membership and invokes its team-authoritative shared deployment, distribution or reconnaissance function.";
else if(is_attachment_item(i))detail="Installs only in its declared weapon slot and changes live weapon statistics; occupied-slot replacement follows the saved attachment option.";
else if(is_holster_item(i))detail="Occupies one of two equipment slots and provides weapon-specific storage, draw and ammunition handling with physical weight.";
else if(is_ammo_reserve_item(i))detail="Represents a real compatible feed device or loose reserve. Loading preserves partial contents and weapon capacity.";
else detail="Uses its registered contextual server action; it is not treated as a generic interchangeable consumable.";
return detail;
}
string item_use_command(string item){return "use "+item;}
// How a throw leaves the player: "foot" on foot, "window" from a vehicle seat
// whose window is open, "cabin" inside a closed vehicle.
string explosive_throw_cabin()
{
if(!in_vehicle or player_vehicle_index<0)return "foot";
vehicle@ v=map_vehicles[player_vehicle_index];
return v.has_seat_window(player_seat) and v.window_down[player_seat]?"window":"cabin";
}
// use <item> <vertical aim> <cooked ms> <cabin>. The vertical aim is the same
// angle used for weapons: 90 is level, lower is down, higher is up.
string explosive_use_command(string item,int cooked=0){return "use "+item+" "+turn+" "+cooked+" "+explosive_throw_cabin();}
string explosive_release_report(string item,int cooked)
{
string cabin=explosive_throw_cabin();string held=cooked>0?" after "+round(double(cooked)/1000.0,2)+" seconds of cooking":"";
if(cabin=="cabin")return "You let go of it inside the closed vehicle"+held+".";
if(cabin=="window")return "Thrown out of the window"+held+".";
return "Thrown"+held+".";
}
// Explosives get one deliberate warning before they are set loose inside a
// vehicle. Using the same one again within three seconds goes ahead.
string pending_vehicle_explosive="";timer pending_vehicle_explosive_timer;
bool confirm_explosive_in_vehicle(string item,bool placed)
{
if(!in_vehicle)return true;
if(!placed and explosive_throw_cabin()=="window")return true;
if(pending_vehicle_explosive==item and pending_vehicle_explosive_timer.elapsed<=3000){pending_vehicle_explosive="";return true;}
pending_vehicle_explosive=item;pending_vehicle_explosive_timer.restart();p.play_stationary("alarm2.ogg",false);
string name=string_replace(item,"_"," ",true);
speak(placed?"Placing the "+name+" inside the vehicle would be a very bad idea: it arms right here in the cabin with you. Press Enter again within three seconds if you are sure.":"The window is closed. Setting off the "+name+" in here will go off inside the vehicle with you. Press Enter again within three seconds if you are sure, or open the window first.");
return false;
}

class online_shop_offer
{
string key,label,category,description,item;
int quantity,price;
online_shop_offer(string k,string l,string c,string d,string i,int q,int p)
{key=k;label=l;category=c;description=d;item=i;quantity=q;price=p;}
}

void online_supply_shop()
{
 if(!connected){speak("Supply ordering needs a server connection.");return;}
 string response=terminal_request("market_catalog","market_");if(response.find("market_catalog ")!=0){terminal_speak_reply(response);return;}
 online_shop_offer@[] offers;string[] categories={"All categories"},entries=string_split(response.substr(15),";",true);int[] limits;
 for(uint i=0;i<entries.length();i++){string[] q=string_split(entries[i],"~",false);if(q.length()<7)continue;offers.insert_last(online_shop_offer(q[0],q[1],q[2],q[3],q[0],int(string_to_number(q[4])),int(string_to_number(q[5]))));limits.insert_last(int(string_to_number(q[6])));if(categories.find(q[2])<0)categories.insert_last(q[2]);}
 if(offers.length()==0){speak("No supply offers are currently available.");return;}
 nv_form f;f.create_window("SupplyLink marketplace",false,true);
 nv_form_input@ balance=f.add_input("Wallet balance and payment","balance",ask_balance()+" wallet credits. Physical cash and bank-linked credsticks can be selected at checkout.","",0,true,true);
 nv_form_list_box@ category=f.add_list("Catalogue category","category");for(uint i=0;i<categories.length();i++)category.add(categories[i],categories[i]);
 nv_form_input@ search=f.add_input("Search names and descriptions","search");nv_form_list_box@ listings=f.add_list("Matching offers","offers");
 nv_form_input@ details=f.add_input("Selected offer and order limit","details","","",0,true,true),quantity=f.add_input("Number of offer packs to add","quantity","1");
 nv_form_button@ add=f.add_button("Add selected offer to cart","add",true);
 nv_form_list_box@ cart=f.add_list("Shopping cart: Select an entry to remove","cart");nv_form_input@ total_view=f.add_input("Order total","total","Cart empty.","",0,true,true);
 nv_form_button@ remove=f.add_button("Remove selected cart entry","remove"),checkout=f.add_button("Checkout: Confirm total and choose payment","checkout"),refresh=f.add_button("Refresh wallet balance","refresh"),close=f.add_button("Close store without purchasing","close",false,true);
 int[] counts(offers.length());string previous="\x01",last_detail="";f.focus_control(category);
 while(connected){
  string filter=category.focused_item_id+"|"+search.text.lower();
  if(filter!=previous){string selected=listings.focused_item_id;listings.items.resize(0);listings.list_position=-1;for(uint i=0;i<offers.length();i++){online_shop_offer@ a=offers[i];if(category.focused_item_id!="All categories" and a.category!=category.focused_item_id)continue;if(search.text!="" and (a.label+" "+a.description).lower().find(search.text.lower())<0)continue;listings.add(a.label+"; "+a.quantity+" per pack; "+a.price+" credits",a.key);}for(uint i=0;i<listings.items.length();i++)if(listings.items[i].id==selected)listings.set_pos(int(i),false);if(listings.items.length()>0 and listings.list_position<0)listings.set_pos(0,false);previous=filter;last_detail="";}
  int selected=-1;for(uint i=0;i<offers.length();i++)if(offers[i].key==listings.focused_item_id){selected=int(i);break;}
  if(listings.focused_item_id!=last_detail){details.text=selected>=0?offers[selected].description+" Pack contains "+offers[selected].quantity+". Price "+offers[selected].price+" credits per pack. Maximum "+limits[selected]+" packs per checkout.": "No matching offer.";last_detail=listings.focused_item_id;}
  add.enabled=selected>=0;remove.enabled=cart.items.length()>0;checkout.enabled=cart.items.length()>0;
  wait(5);f.monitor();netloop(false);if(f.is_pressed(close))return;
  if(f.is_pressed(refresh))balance.text=ask_balance()+" wallet credits. Other payment balances are separate.";
  bool changed=false;
  if(f.is_pressed(add) and selected>=0){int n=int(string_to_number(quantity.text));if(n<1 or quantity.text!=n+"" or n+counts[selected]>limits[selected]){speak("Choose a positive whole number within this offer's remaining order limit.");continue;}counts[selected]+=n;changed=true;speak("Added "+n+" packs of "+offers[selected].label+" to the cart.");}
  if(f.is_pressed(remove)){for(uint i=0;i<offers.length();i++)if(offers[i].key==cart.focused_item_id){counts[i]=0;changed=true;break;}}
  if(f.is_pressed(checkout)){
   string packet="";int64 cost=0;int distinct=0;for(uint i=0;i<offers.length();i++)if(counts[i]>0){if(packet!="")packet+=";";packet+=offers[i].key+","+counts[i];cost+=int64(counts[i])*offers[i].price;distinct++;}
   if(distinct>32){speak("Checkout supports at most thirty-two distinct listings.");continue;}
   string payment=physical_choose_payment();if(payment=="")continue;
   string kind=item_prop(payment,"currency_kind");if((kind=="bank" or kind=="credit") and bank_sign_in()=="")continue;
   int fee=(kind=="bank" or kind=="credit")?int(ceil(double(cost)*item_prop_int(payment,"currency_fee_percent")/100)):0;
   if(yesno("Buy "+distinct+" listings for "+cost+" credits"+(fee>0?" plus "+fee+" credits in payment fees":"")+" using "+physical_item_name(payment)+"?")==1){
    string result=terminal_request("market_checkout "+payment+" "+packet,"market_");
    if(result.find("market_purchase_ok ")==0){speak(result.substr(19));for(uint i=0;i<counts.length();i++)counts[i]=0;changed=true;balance.text=ask_balance()+" wallet credits.";}
    else if(result!="")speak(string_replace(result,"market_purchase_error ","Purchase declined: ",false));
   }
  }
  if(changed){cart.items.resize(0);cart.list_position=-1;int64 total=0;for(uint i=0;i<offers.length();i++)if(counts[i]>0){int cost=counts[i]*offers[i].price;total+=cost;cart.add(offers[i].label+"; "+counts[i]+" packs, "+(counts[i]*offers[i].quantity)+" inventory units; "+cost+" credits",offers[i].key);}if(cart.items.length()>0)cart.set_pos(0,false);total_view.text=total+" credits before bank-credstick fees.";}
 }
}
